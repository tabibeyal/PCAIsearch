{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(PYTHONPATH=. python3 -m pytest *)",
      "Bash(PYTHONPATH=. python3 *)",
      "Bash(uvicorn *)",
      "Bash(pip install *)",
      "Bash(pip show *)",
      "Bash(cd frontend && npm run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "skillOverrides": {
    "design-motion-principles": "off",
    "diagnose": "off",
    "dotfiles": "off",
    "find-skills": "off",
    "lean-claudemd": "off",
    "llm-council": "off",
    "mutmut-iterate": "off",
    "tdd": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh",
            "timeout": 5000,
            "statusMessage": "Checking file protections..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/warn-large-files.sh",
            "timeout": 5000,
            "statusMessage": "Checking for build artifacts..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.sh",
            "timeout": 5000,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.sh",
            "timeout": 5000,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.sh",
            "timeout": 15000,
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if ! command -v jq >/dev/null 2>&1 || ! command -v gh >/dev/null 2>&1; then\n  exit 0\nfi\n\nINPUT=$(cat)\nCOMMAND=$(printf '%s' \"$INPUT\" | jq -r '.tool_input.command // empty' 2>/dev/null)\nprintf '%s' \"$COMMAND\" | grep -qE '(^|[;&|[:space:]])gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)' || exit 0\n\nBRANCH=$(git branch --show-current 2>/dev/null)\nif [ -z \"$BRANCH\" ] || [ \"$BRANCH\" = \"master\" ]; then\n  exit 0\nfi\n\nSTATE=$(gh pr view \"$BRANCH\" --json state -q .state 2>/dev/null)\nif [ \"$STATE\" != \"MERGED\" ]; then\n  exit 0\nfi\n\nif git checkout master >/dev/null 2>&1 && git pull >/dev/null 2>&1 && git branch -D \"$BRANCH\" >/dev/null 2>&1; then\n  printf '{\"systemMessage\": \"Merged PR detected - switched to master, pulled, and deleted local branch %s.\"}\\n' \"$BRANCH\"\nfi\n\nexit 0\n",
            "timeout": 10000,
            "statusMessage": "Checking for merged PR..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0\ncommand -v gh >/dev/null 2>&1 || exit 0\n\nBRANCH=$(git branch --show-current 2>/dev/null)\nif [ -z \"$BRANCH\" ] || [ \"$BRANCH\" = \"master\" ]; then\n  exit 0\nfi\n\nSTATE=$(gh pr view \"$BRANCH\" --json state -q .state 2>/dev/null)\nif [ \"$STATE\" != \"MERGED\" ]; then\n  exit 0\nfi\n\nif git checkout master >/dev/null 2>&1 && git pull >/dev/null 2>&1 && git branch -D \"$BRANCH\" >/dev/null 2>&1; then\n  echo \"Note: '$BRANCH' was already merged on GitHub - switched to master, pulled, and deleted the stale local branch.\"\nfi\n\nexit 0\n",
            "timeout": 10000,
            "statusMessage": "Checking for stale merged branch..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 5000,
            "statusMessage": "Loading project context..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-memory.sh",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "which osascript >/dev/null 2>&1 && osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"' || which notify-send >/dev/null 2>&1 && notify-send 'Claude Code' 'Claude Code needs your attention' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-memory.sh",
            "timeout": 120000,
            "statusMessage": "Updating project memory..."
          }
        ]
      }
    ]
  }
}