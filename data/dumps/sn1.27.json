    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Sarasutta ",
      "english": "Streams "
    },
    {
      "number": 4,
      "pali": "“Kuto sarā nivattanti, ",
      "english": "“From where do streams recoil? "
    },
    {
      "number": 5,
      "pali": "kattha vaṭṭaṁ na vattati; ",
      "english": "Where does the cycle spin no more? "
    },
    {
      "number": 6,
      "pali": "Kattha nāmañca rūpañca, ",
      "english": "Where does name and form "
    },
    {
      "number": 7,
      "pali": "asesaṁ uparujjhatī”ti. ",
      "english": "cease with no residue left behind?” "
    },
    {
      "number": 8,
      "pali": "“Yattha āpo ca pathavī, ",
      "english": "“Where water and earth, "
    },
    {
      "number": 9,
      "pali": "tejo vāyo na gādhati; ",
      "english": "fire and air have no footing—"
    },
    {
      "number": 10,
      "pali": "Ato sarā nivattanti, ",
      "english": "from here the streams recoil; "
    },
    {
      "number": 11,
      "pali": "ettha vaṭṭaṁ na vattati; ",
      "english": "in reference to this, the cycle spins no more; "
    },
    {
      "number": 12,
      "pali": "Ettha nāmañca rūpañca, ",
      "english": "in reference to this, name and form "
    },
    {
      "number": 13,
      "pali": "asesaṁ uparujjhatī”ti. ",
      "english": "ceases with no residue left behind.” "
    }
  ]
}