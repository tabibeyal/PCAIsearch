{
  "sutta_id": "DHP120",
  "verses": [
    {
      "number": 1,
      "pali": "Bhadropi passati pāpaṁ, ",
      "english": "Even the good see wicked things, "
    },
    {
      "number": 2,
      "pali": "Yāva bhadraṁ na paccati; ",
      "english": "so long as their goodness has not ripened. "
    },
    {
      "number": 3,
      "pali": "Yadā ca paccati bhadraṁ, ",
      "english": "But as soon as that goodness ripens, "
    },
    {
      "number": 4,
      "pali": "Atha bhadro bhadrāni passati. ",
      "english": "then the good see good things. "
    }
  ]
}