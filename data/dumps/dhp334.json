    {
      "number": 3,
      "pali": "Taṇhāvagga ",
      "english": "24. Craving "
    },
    {
      "number": 4,
      "pali": "Kapilamacchavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Manujassa pamattacārino, ",
      "english": "When a man lives heedlessly, "
    },
    {
      "number": 6,
      "pali": "Taṇhā vaḍḍhati māluvā viya; ",
      "english": "craving grows in them like a camel’s foot creeper. "
    },
    {
      "number": 7,
      "pali": "So plavatī hurā huraṁ, ",
      "english": "They jump from one thing to the next, like a langur "
    },
    {
      "number": 8,
      "pali": "Phalamicchaṁva vanasmi vānaro. ",
      "english": "greedy for fruit in a forest grove. "
    }
  ]
}