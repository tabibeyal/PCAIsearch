{
  "sutta_id": "DHP18",
  "verses": [
    {
      "number": 1,
      "pali": "Sumanadevīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idha nandati pecca nandati, ",
      "english": "Here they delight, hereafter they delight, "
    },
    {
      "number": 3,
      "pali": "Katapuñño ubhayattha nandati; ",
      "english": "one who does good delights in both places. "
    },
    {
      "number": 4,
      "pali": "“Puññaṁ me katan”ti nandati, ",
      "english": "They delight thinking of good things they’ve done; "
    },
    {
      "number": 5,
      "pali": "Bhiyyo nandati suggatiṁ gato. ",
      "english": "when gone to a good place, they delight all the more. "
    }
  ]
}