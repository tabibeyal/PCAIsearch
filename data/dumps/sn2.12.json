{
  "sutta_id": "SN2.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.12 ",
      "english": "Linked Discourses 2.12 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Veṇḍusutta ",
      "english": "With Vishnu "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho veṇḍu devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Vishnu spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 5,
      "pali": "“Sukhitāva te manujā, ",
      "english": "“Happy are the men "
    },
    {
      "number": 6,
      "pali": "sugataṁ payirupāsiya; ",
      "english": "who pay homage to the Holy One! "
    },
    {
      "number": 7,
      "pali": "Yuñjaṁ gotamasāsane, ",
      "english": "They apply themselves to Gotama’s instructions, "
    },
    {
      "number": 8,
      "pali": "appamattā nu sikkhare”ti. ",
      "english": "diligently training.” "
    },
    {
      "number": 9,
      "pali": "“Ye me pavutte siṭṭhipade, ",
      "english": "“Those who practice absorption <j>in accord with the training”, "
    },
    {
      "number": 10,
      "pali": "(veṇḍūti bhagavā) ",
      "english": "said the Buddha to Vishnu, "
    },
    {
      "number": 11,
      "pali": "Anusikkhanti jhāyino; ",
      "english": "“in the way of teaching I’ve proclaimed, "
    },
    {
      "number": 12,
      "pali": "Kāle te appamajjantā, ",
      "english": "diligent while there is still time; "
    },
    {
      "number": 13,
      "pali": "Na maccuvasagā siyun”ti. ",
      "english": "they won’t fall under the sway of Death.” "
    }
  ]
}