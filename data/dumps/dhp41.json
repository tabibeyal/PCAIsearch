{
  "sutta_id": "DHP41",
  "verses": [
    {
      "number": 1,
      "pali": "Pūtigattatissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Aciraṁ vatayaṁ kāyo, ",
      "english": "All too soon this body "
    },
    {
      "number": 3,
      "pali": "pathaviṁ adhisessati; ",
      "english": "will lie upon the earth, "
    },
    {
      "number": 4,
      "pali": "Chuddho apetaviññāṇo, ",
      "english": "bereft of consciousness, "
    },
    {
      "number": 5,
      "pali": "niratthaṁva kaliṅgaraṁ. ",
      "english": "tossed aside like a worthless log. "
    }
  ]
}