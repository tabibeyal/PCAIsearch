{
  "sutta_id": "DHP171",
  "verses": [
    {
      "number": 1,
      "pali": "Abhayarājakumāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Etha passathimaṁ lokaṁ, ",
      "english": "Come, see this world decked out "
    },
    {
      "number": 3,
      "pali": "cittaṁ rājarathūpamaṁ; ",
      "english": "like a fancy royal chariot. "
    },
    {
      "number": 4,
      "pali": "Yattha bālā visīdanti, ",
      "english": "Here fools founder, "
    },
    {
      "number": 5,
      "pali": "natthi saṅgo vijānataṁ. ",
      "english": "but the discerning are not chained. "
    }
  ]
}