{
  "sutta_id": "DHP237",
  "verses": [
    {
      "number": 1,
      "pali": "Upanītavayo ca dānisi, ",
      "english": "You’ve journeyed the stages of life, "
    },
    {
      "number": 2,
      "pali": "Sampayātosi yamassa santikaṁ; ",
      "english": "and now you set out to meet Yama. "
    },
    {
      "number": 3,
      "pali": "Vāso te natthi antarā, ",
      "english": "Along the way there’s nowhere to stay, "
    },
    {
      "number": 4,
      "pali": "Pātheyyampi ca te na vijjati. ",
      "english": "yet you have no supplies for the road. "
    }
  ]
}