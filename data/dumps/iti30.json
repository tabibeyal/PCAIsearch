{
  "sutta_id": "ITI30",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 30 ",
      "english": "So It Was Said 30 "
    },
    {
      "number": 2,
      "pali": "Dukanipāta ",
      "english": "The Book of the Twos "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Tapanīyasutta ",
      "english": "Mortifying "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Dveme, bhikkhave, dhammā tapanīyā. ",
      "english": "“These two things, mendicants, are mortifying. "
    },
    {
      "number": 7,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 8,
      "pali": "Idha, bhikkhave, ekacco akatakalyāṇo hoti, akatakusalo, akatabhīruttāṇo, katapāpo, kataluddo, katakibbiso. ",
      "english": "It’s when someone hasn’t done good and skillful things that keep them safe, but has done bad things, violence and sin. "
    },
    {
      "number": 9,
      "pali": "So ‘akataṁ me kalyāṇan’tipi tappati, ‘kataṁ me pāpan’tipi tappati. ",
      "english": "Thinking, ‘I haven’t done good things’, they’re mortified. Thinking, ‘I have done bad things’, they’re mortified. "
    },
    {
      "number": 10,
      "pali": "Ime kho, bhikkhave, dve dhammā tapanīyā”ti. ",
      "english": "These are the two things that are mortifying.” "
    },
    {
      "number": 11,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 12,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 13,
      "pali": "“Kāyaduccaritaṁ katvā, ",
      "english": "“Having done bad things "
    },
    {
      "number": 14,
      "pali": "vacīduccaritāni ca; ",
      "english": "by way of body, "
    },
    {
      "number": 15,
      "pali": "Manoduccaritaṁ katvā, ",
      "english": "speech, and mind, "
    },
    {
      "number": 16,
      "pali": "yañcaññaṁ dosasañhitaṁ. ",
      "english": "and whatever else is corrupt; "
    },
    {
      "number": 17,
      "pali": "Akatvā kusalaṁ kammaṁ, ",
      "english": "not having done good deeds, "
    },
    {
      "number": 18,
      "pali": "katvānākusalaṁ bahuṁ; ",
      "english": "and having done many bad, "
    },
    {
      "number": 19,
      "pali": "Kāyassa bhedā duppañño, ",
      "english": "when their body breaks up, that witless person "
    },
    {
      "number": 20,
      "pali": "nirayaṁ sopapajjatī”ti. ",
      "english": "is reborn in hell.” "
    },
    {
      "number": 21,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 22,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}