  "sutta_id": "AN4.152",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.152 ",
      "english": "Numbered Discourses 4.152 "
    },
    {
      "number": 2,
      "pali": "16. Indriyavagga ",
      "english": "16. Faculties "
    },
    {
      "number": 3,
      "pali": "Saddhābalasutta ",
      "english": "The Power of Faith "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these four powers. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Saddhābalaṁ, vīriyabalaṁ, satibalaṁ, samādhibalaṁ—",
      "english": "The powers of faith, energy, mindfulness, and immersion. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri balānī”ti. ",
      "english": "These are the four powers.” "
    },
    {
      "number": 8,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}