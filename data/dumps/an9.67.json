{
  "sutta_id": "AN9.67",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 9.67 ",
      "english": "Numbered Discourses 9.67 "
    },
    {
      "number": 2,
      "pali": "7. Satipaṭṭhānavagga ",
      "english": "7. Mindfulness Meditation "
    },
    {
      "number": 3,
      "pali": "Orambhāgiyasutta ",
      "english": "Lower Fetters "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, orambhāgiyāni saṁyojanāni. ",
      "english": "“Mendicants, there are five lower fetters. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Sakkāyadiṭṭhi, vicikicchā, sīlabbataparāmāso, kāmacchando, byāpādo—",
      "english": "Substantialist view, doubt, misapprehension of precepts and observances, sensual desire, and ill will. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañcorambhāgiyāni saṁyojanāni. ",
      "english": "These are the five lower fetters. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbā”ti. ",
      "english": "To give up these five lower fetters you should develop the four kinds of mindfulness meditation. …” "
    },
    {
      "number": 9,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}