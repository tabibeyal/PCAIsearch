{
  "sutta_id": "SN1.57",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.57",
      "english": "Linked Discourses 1.57"
    },
    {
      "number": 2,
      "pali": "Jana Sutta",
      "english": "Engendered (3)"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“What engenders a person?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "What does one have that runs around?"
    },
    {
      "number": 5,
      "pali": "",
      "english": "What rushes toward the wandering-on?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "What does one have"
    },
    {
      "number": 7,
      "pali": "",
      "english": "as one’s support?”"
    },
    {
      "number": 8,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 9,
      "pali": "",
      "english": "“Craving engenders a person."
    },
    {
      "number": 10,
      "pali": "",
      "english": "One’s mind is what runs around."
    },
    {
      "number": 11,
      "pali": "",
      "english": "A being rushes toward the wandering-on."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Action is one’s support.”"
    }
  ]
}