  "verses": [
    {
      "number": 1,
      "pali": "29 ",
      "english": "29 "
    },
    {
      "number": 2,
      "pali": "“Dussīlassa, bhikkhave, dve paṭiggāhā—",
      "english": "“There are two places waiting to receive an unethical person: "
    },
    {
      "number": 3,
      "pali": "nirayo vā tiracchānayoni vā. ",
      "english": "hell and the animal realm. "
    },
    {
      "number": 4,
      "pali": "Sīlavato, bhikkhave, dve paṭiggāhā—",
      "english": "There are two places waiting to receive an ethical person: "
    },
    {
      "number": 5,
      "pali": "devā vā manussā vā”ti. ",
      "english": "the realms of gods and humans.” "
    }
  ]
}