{
  "sutta_id": "SN23.22",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 23.22 ",
      "english": "Linked Discourses 23.22 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyamāravagga ",
      "english": "2. About Māra (2nd) "
    },
    {
      "number": 3,
      "pali": "Nirodhadhammasutta ",
      "english": "Liable To Cease "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ nisinno kho āyasmā rādho bhagavantaṁ etadavoca: ",
      "english": "Seated to one side, Venerable Rādha said to the Buddha: "
    },
    {
      "number": 6,
      "pali": "“‘nirodhadhammo, nirodhadhammo’ti, bhante, vuccati. ",
      "english": "“Sir, they speak of a ‘liability to cease’. "
    },
    {
      "number": 7,
      "pali": "Katamo nu kho, bhante, nirodhadhammo”ti? ",
      "english": "What has a liability to cease?” "
    },
    {
      "number": 8,
      "pali": "“Rūpaṁ kho, rādha, nirodhadhammo, vedanā nirodhadhammo, saññā nirodhadhammo, saṅkhārā nirodhadhammo, viññāṇaṁ nirodhadhammo. ",
      "english": "“Rādha, form, feeling, perception, choices, and consciousness have a liability to cease. "
    },
    {
      "number": 9,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 10,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 11,
      "pali": "Dvādasamaṁ. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Dutiyamāravaggo. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Māro ca māradhammo ca, ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Aniccena apare duve; ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Dukkhena ca duve vuttā, ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Anattena tatheva ca; ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Khayavayasamudayaṁ, ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Nirodhadhammena dvādasāti. ",
      "english": ""
    }
  ]
}