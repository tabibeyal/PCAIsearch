{
  "sutta_id": "AN10.118",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.118 ",
      "english": "Numbered Discourses 10.118 "
    },
    {
      "number": 2,
      "pali": "12. Paccorohaṇivagga ",
      "english": "12. The Ceremony of Descent "
    },
    {
      "number": 3,
      "pali": "Orimatīrasutta ",
      "english": "The Near Shore "
    },
    {
      "number": 4,
      "pali": "“Orimañca, bhikkhave, tīraṁ desessāmi pārimañca tīraṁ. ",
      "english": "“Mendicants, I will teach you the near shore and the far shore. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha, sādhukaṁ manasi karotha, bhāsissāmī”ti. ",
      "english": "Listen and apply your mind well, I will speak.” "
    },
    {
      "number": 6,
      "pali": "“Evaṁ, bhante”ti kho te bhikkhū bhagavato paccassosuṁ. ",
      "english": "“Yes, sir,” they replied. "
    },
    {
      "number": 7,
      "pali": "Bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 8,
      "pali": "“Katamañca, bhikkhave, orimaṁ tīraṁ, katamañca pārimaṁ tīraṁ? ",
      "english": "“And what, mendicants, is the near shore? What is the far shore? "
    },
    {
      "number": 9,
      "pali": "Micchādiṭṭhi orimaṁ tīraṁ, sammādiṭṭhi pārimaṁ tīraṁ …pe… ",
      "english": "Wrong view is the near shore, and right view is the far shore. … "
    },
    {
      "number": 10,
      "pali": "micchāvimutti orimaṁ tīraṁ, sammāvimutti pārimaṁ tīraṁ. ",
      "english": "Wrong freedom is the near shore, and right freedom is the far shore. "
    },
    {
      "number": 11,
      "pali": "Idaṁ kho, bhikkhave, orimaṁ tīraṁ, idaṁ pārimaṁ tīranti. ",
      "english": "This is the near shore, and this is the far shore. "
    },
    {
      "number": 12,
      "pali": "Appakā te manussesu, ",
      "english": "Few are those among humans "
    },
    {
      "number": 13,
      "pali": "ye janā pāragāmino; ",
      "english": "who cross to the far shore. "
    },
    {
      "number": 14,
      "pali": "Athāyaṁ itarā pajā, ",
      "english": "The rest just run "
    },
    {
      "number": 15,
      "pali": "tīramevānudhāvati. ",
      "english": "around on the near shore. "
    },
    {
      "number": 16,
      "pali": "Ye ca kho sammadakkhāte, ",
      "english": "When the teaching is well explained, "
    },
    {
      "number": 17,
      "pali": "dhamme dhammānuvattino; ",
      "english": "those who practice accordingly "
    },
    {
      "number": 18,
      "pali": "Te janā pāramessanti, ",
      "english": "are the ones who will cross over "
    },
    {
      "number": 19,
      "pali": "maccudheyyaṁ suduttaraṁ. ",
      "english": "Death’s dominion so hard to pass. "
    },
    {
      "number": 20,
      "pali": "Kaṇhaṁ dhammaṁ vippahāya, ",
      "english": "Rid of dark qualities, "
    },
    {
      "number": 21,
      "pali": "sukkaṁ bhāvetha paṇḍito; ",
      "english": "an astute person should develop the bright. "
    },
    {
      "number": 22,
      "pali": "Okā anokamāgamma, ",
      "english": "Leaving home behind "
    },
    {
      "number": 23,
      "pali": "viveke yattha dūramaṁ. ",
      "english": "for the seclusion so hard to enjoy, "
    },
    {
      "number": 24,
      "pali": "Tatrābhiratimiccheyya, ",
      "english": "try to find satisfaction there, "
    },
    {
      "number": 25,
      "pali": "hitvā kāme akiñcano; ",
      "english": "having left behind sensual pleasures. "
    },
    {
      "number": 26,
      "pali": "Pariyodapeyya attānaṁ, ",
      "english": "With no possessions, an astute person "
    },
    {
      "number": 27,
      "pali": "cittaklesehi paṇḍito. ",
      "english": "should cleanse themselves of mental corruptions. "
    },
    {
      "number": 28,
      "pali": "Yesaṁ sambodhiyaṅgesu, ",
      "english": "And those whose minds are rightly developed "
    },
    {
      "number": 29,
      "pali": "sammā cittaṁ subhāvitaṁ; ",
      "english": "in the awakening factors; "
    },
    {
      "number": 30,
      "pali": "Ādānapaṭinissagge, ",
      "english": "letting go of attachments, "
    },
    {
      "number": 31,
      "pali": "anupādāya ye ratā; ",
      "english": "they delight in not grasping. "
    },
    {
      "number": 32,
      "pali": "Khīṇāsavā jutimanto, ",
      "english": "With defilements ended, brilliant, "
    },
    {
      "number": 33,
      "pali": "te loke parinibbutā”ti. ",
      "english": "they are quenched in this world.” "
    },
    {
      "number": 34,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}