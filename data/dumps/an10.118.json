{
  "sutta_id": "AN10.118",
  "verses": [
    {
      "number": 1,
      "pali": "Numerical Discourses 10.118",
      "english": "Numerical Discourses 10.118"
    },
    {
      "number": 2,
      "pali": "Orima Sutta",
      "english": "The Near Shore"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“Monks, I will teach you the near shore & the far shore. Listen & pay close attention. I will speak.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“As you say, lord,” the monks responded to the Blessed One."
    },
    {
      "number": 5,
      "pali": "",
      "english": "The Blessed One said, “And which is the near shore? And which is the far shore?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "“Wrong view is the near shore; right view, the far shore."
    },
    {
      "number": 7,
      "pali": "",
      "english": "“Wrong resolve is the near shore; right resolve, the far shore."
    },
    {
      "number": 8,
      "pali": "",
      "english": "“Wrong speech is the near shore; right speech, the far shore."
    },
    {
      "number": 9,
      "pali": "",
      "english": "“Wrong action is the near shore; right action, the far shore."
    },
    {
      "number": 10,
      "pali": "",
      "english": "“Wrong livelihood is the near shore; right livelihood, the far shore."
    },
    {
      "number": 11,
      "pali": "",
      "english": "“Wrong effort is the near shore; right effort, the far shore."
    },
    {
      "number": 12,
      "pali": "",
      "english": "“Wrong mindfulness is the near shore; right mindfulness, the far shore."
    },
    {
      "number": 13,
      "pali": "",
      "english": "“Wrong concentration is the near shore; right concentration, the far shore."
    },
    {
      "number": 14,
      "pali": "",
      "english": "“Wrong knowledge is the near shore; right knowledge, the far shore."
    },
    {
      "number": 15,
      "pali": "",
      "english": "“Wrong release is the near shore; right release, the far shore."
    },
    {
      "number": 16,
      "pali": "",
      "english": "“This, monks, is the near shore; this, the far shore.”"
    },
    {
      "number": 17,
      "pali": "",
      "english": "Few are the people"
    },
    {
      "number": 18,
      "pali": "",
      "english": "who reach the far shore."
    },
    {
      "number": 19,
      "pali": "",
      "english": "These others"
    },
    {
      "number": 20,
      "pali": "",
      "english": "simply scurry along"
    },
    {
      "number": 21,
      "pali": "",
      "english": "this shore."
    },
    {
      "number": 22,
      "pali": "",
      "english": "But those who practice Dhamma"
    },
    {
      "number": 23,
      "pali": "",
      "english": "in line with the well-taught Dhamma,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "will cross over the realm of Death"
    },
    {
      "number": 25,
      "pali": "",
      "english": "so hard to transcend."
    },
    {
      "number": 26,
      "pali": "",
      "english": "Forsaking dark practices,"
    },
    {
      "number": 27,
      "pali": "",
      "english": "the wise person"
    },
    {
      "number": 28,
      "pali": "",
      "english": "should develop the bright,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "having gone from home"
    },
    {
      "number": 30,
      "pali": "",
      "english": "to no-home"
    },
    {
      "number": 31,
      "pali": "",
      "english": "in seclusion, so hard to enjoy."
    },
    {
      "number": 32,
      "pali": "",
      "english": "There he should wish for delight,"
    },
    {
      "number": 33,
      "pali": "",
      "english": "discarding sensuality—"
    },
    {
      "number": 34,
      "pali": "",
      "english": "he who has nothing."
    },
    {
      "number": 35,
      "pali": "",
      "english": "He should cleanse himself—wise—"
    },
    {
      "number": 36,
      "pali": "",
      "english": "of what defiles the mind."
    },
    {
      "number": 37,
      "pali": "",
      "english": "Whose minds are well-developed"
    },
    {
      "number": 38,
      "pali": "",
      "english": "in the factors for self-awakening,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "who delight in non-clinging,"
    },
    {
      "number": 40,
      "pali": "",
      "english": "relinquishing grasping—"
    },
    {
      "number": 41,
      "pali": "",
      "english": "resplendent,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "their effluents ended:"
    },
    {
      "number": 43,
      "pali": "",
      "english": "They, in the world,"
    },
    {
      "number": 44,
      "pali": "",
      "english": "are unbound."
    }
  ]
}