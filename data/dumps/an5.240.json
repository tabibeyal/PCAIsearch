{
  "sutta_id": "AN5.240",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.240 ",
      "english": "Numbered Discourses 5.240 "
    },
    {
      "number": 2,
      "pali": "24. Āvāsikavagga ",
      "english": "24. A Resident Mendicant "
    },
    {
      "number": 3,
      "pali": "Dutiyamacchariyasutta ",
      "english": "Stinginess (2nd) "
    },
    {
      "number": 4,
      "pali": "“Pañcahi, bhikkhave, dhammehi samannāgato āvāsiko bhikkhu yathābhataṁ nikkhitto evaṁ niraye. ",
      "english": "“Mendicants, a resident mendicant with five qualities is placed in hell as if delivered there. "
    },
    {
      "number": 5,
      "pali": "Katamehi pañcahi? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Āvāsamaccharī hoti; ",
      "english": "They’re stingy regarding monasteries, "
    },
    {
      "number": 7,
      "pali": "kulamaccharī hoti; ",
      "english": "families, "
    },
    {
      "number": 8,
      "pali": "lābhamaccharī hoti; ",
      "english": "material things, "
    },
    {
      "number": 9,
      "pali": "vaṇṇamaccharī hoti; ",
      "english": "praise, "
    },
    {
      "number": 10,
      "pali": "dhammamaccharī hoti. ",
      "english": "and the teachings. "
    },
    {
      "number": 11,
      "pali": "Imehi kho, bhikkhave, pañcahi dhammehi samannāgato āvāsiko bhikkhu yathābhataṁ nikkhitto evaṁ niraye. ",
      "english": "A resident mendicant with these five qualities is placed in hell as if delivered there. "
    },
    {
      "number": 12,
      "pali": "Pañcahi, bhikkhave, dhammehi samannāgato āvāsiko bhikkhu yathābhataṁ nikkhitto evaṁ sagge. ",
      "english": "A resident mendicant with five qualities is placed in heaven as if delivered there. "
    },
    {
      "number": 13,
      "pali": "Katamehi pañcahi? ",
      "english": "What five? "
    },
    {
      "number": 14,
      "pali": "Na āvāsamaccharī hoti; ",
      "english": "They’re not stingy regarding monasteries, "
    },
    {
      "number": 15,
      "pali": "na kulamaccharī hoti; ",
      "english": "families, "
    },
    {
      "number": 16,
      "pali": "na lābhamaccharī hoti; ",
      "english": "material things, "
    },
    {
      "number": 17,
      "pali": "na vaṇṇamaccharī hoti; ",
      "english": "praise, "
    },
    {
      "number": 18,
      "pali": "na dhammamaccharī hoti. ",
      "english": "and the teachings. "
    },
    {
      "number": 19,
      "pali": "Imehi kho, bhikkhave, pañcahi dhammehi samannāgato āvāsiko bhikkhu yathābhataṁ nikkhitto evaṁ sagge”ti. ",
      "english": "A resident mendicant with these five qualities is placed in heaven as if delivered there.” "
    },
    {
      "number": 20,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Āvāsikavaggo catuttho. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Āvāsiko piyo ca sobhano, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Bahūpakāro anukampako ca; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Tayo avaṇṇārahā ceva, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "Macchariyā duvepi cāti. ",
      "english": ""
    }
  ]
}