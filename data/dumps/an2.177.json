  "sutta_id": "AN2.177",
  "verses": [
    {
      "number": 1,
      "pali": "177 ",
      "english": "177 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Asantuṭṭhitā ca kusalesu dhammesu, appaṭivānitā ca padhānasmiṁ. ",
      "english": "To never be content with skillful qualities, and to never stop trying. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”. ",
      "english": "These are the two things.” "
    }
  ]
}