    {
      "number": 2,
      "pali": "11. Āsāduppajahavagga ",
      "english": "The Chapter on Hopes That Are Hard to Give Up "
    },
    {
      "number": 3,
      "pali": "118 ",
      "english": "118 "
    },
    {
      "number": 4,
      "pali": "“Dvemā, bhikkhave, āsā duppajahā. ",
      "english": "“These two hopes are hard to give up. "
    },
    {
      "number": 5,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Lābhāsā ca jīvitāsā ca. ",
      "english": "The hope for wealth and the hope for long life. "
    },
    {
      "number": 7,
      "pali": "Imā kho, bhikkhave, dve āsā duppajahā”ti. ",
      "english": "These are two hopes that are hard to give up.” "
    }
  ]
}