  "verses": [
    {
      "number": 1,
      "pali": "Kokālikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo mukhasaṁyato bhikkhu, ",
      "english": "When a mendicant of restrained mouth, "
    },
    {
      "number": 3,
      "pali": "mantabhāṇī anuddhato; ",
      "english": "thoughtful in counsel, not restless, "
    },
    {
      "number": 4,
      "pali": "Atthaṁ dhammañca dīpeti, ",
      "english": "explains the text and its meaning, "
    },
    {
      "number": 5,
      "pali": "madhuraṁ tassa bhāsitaṁ. ",
      "english": "their words are sweet. "
    }
  ]
