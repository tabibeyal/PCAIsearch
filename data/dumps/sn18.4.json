      "number": 1,
      "pali": "Saṁyutta Nikāya 18.4 ",
      "english": "Linked Discourses 18.4 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Samphassasutta ",
      "english": "Contact "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "cakkhusamphasso nicco vā anicco vā”ti? ",
      "english": "Is eye contact permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Anicco, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“sotasamphasso …pe… ",
      "english": "“… ear contact … "
    },
    {
      "number": 9,
      "pali": "ghānasamphasso … ",
      "english": "nose contact … "
    },
    {
      "number": 10,
      "pali": "jivhāsamphasso … ",
      "english": "tongue contact … "
    },
    {
      "number": 11,
      "pali": "kāyasamphasso … ",
      "english": "body contact … "
    },
    {
      "number": 12,
      "pali": "manosamphasso nicco vā anicco vā”ti? ",
      "english": "Is mind contact permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Anicco, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako cakkhusamphassasmimpi nibbindati …pe… sotasamphassasmimpi nibbindati … ghānasamphassasmimpi nibbindati … jivhāsamphassasmimpi nibbindati … kāyasamphassasmimpi nibbindati … manosamphassasmimpi nibbindati; ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with eye contact, ear contact, nose contact, tongue contact, body contact, and mind contact. "
    },
    {
      "number": 15,
      "pali": "nibbindaṁ virajjati …pe… ",
      "english": "Being disillusioned, desire fades away. …” "
    },
    {
      "number": 16,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
