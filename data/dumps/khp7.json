{
  "sutta_id": "KHP7",
  "verses": [
    {
      "number": 1,
      "pali": "Khuddakapatha 7",
      "english": "Khuddakapatha 7"
    },
    {
      "number": 2,
      "pali": "Tirokuḍḍa Kaṇḍa",
      "english": "(Hungry Ghosts) Outside the Walls"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This passage is identical with Pv 1:5.",
      "section": "commentary"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Outside the walls they stand,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "& at crossroads."
    },
    {
      "number": 6,
      "pali": "",
      "english": "At doorposts they stand,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "returning to their old homes."
    },
    {
      "number": 8,
      "pali": "",
      "english": "But when a meal with plentiful food & drink is served,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "no one remembers them:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "Such is the kamma of living beings."
    },
    {
      "number": 11,
      "pali": "",
      "english": "So those who feel sympathy for their dead relatives"
    },
    {
      "number": 12,
      "pali": "",
      "english": "give timely donations of proper food & drink"
    },
    {
      "number": 13,
      "pali": "",
      "english": "—exquisite, clean—"
    },
    {
      "number": 14,
      "pali": "",
      "english": "[thinking:]"
    },
    {
      "number": 15,
      "pali": "",
      "english": "“May this be for our relatives."
    },
    {
      "number": 16,
      "pali": "",
      "english": "May our relatives be happy!”"
    },
    {
      "number": 17,
      "pali": "",
      "english": "And those who have gathered there,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "the assembled shades of the relatives,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "with appreciation, give their blessing"
    },
    {
      "number": 20,
      "pali": "",
      "english": "for the plentiful food & drink:"
    },
    {
      "number": 21,
      "pali": "",
      "english": "“May our relatives live long"
    },
    {
      "number": 22,
      "pali": "",
      "english": "because of whom we have gained [this gift]."
    },
    {
      "number": 23,
      "pali": "",
      "english": "We have been honored,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "and the donors are not without reward!”"
    },
    {
      "number": 25,
      "pali": "",
      "english": "For there [in their realm] there’s"
    },
    {
      "number": 26,
      "pali": "",
      "english": "no farming,"
    },
    {
      "number": 27,
      "pali": "",
      "english": "no herding of cattle,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "no commerce,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "no trading with money."
    },
    {
      "number": 30,
      "pali": "",
      "english": "They live on what is given here,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "hungry ghosts"
    },
    {
      "number": 32,
      "pali": "",
      "english": "whose time here is done."
    },
    {
      "number": 33,
      "pali": "",
      "english": "As water raining on a hill"
    },
    {
      "number": 34,
      "pali": "",
      "english": "flows down to the valley,"
    },
    {
      "number": 35,
      "pali": "",
      "english": "even so does what is given here"
    },
    {
      "number": 36,
      "pali": "",
      "english": "benefit the dead."
    },
    {
      "number": 37,
      "pali": "",
      "english": "As rivers full of water"
    },
    {
      "number": 38,
      "pali": "",
      "english": "fill the ocean full,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "even so does what is given here"
    },
    {
      "number": 40,
      "pali": "",
      "english": "benefit the dead."
    },
    {
      "number": 41,
      "pali": "",
      "english": "“He gave to me, she acted on my behalf,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "they were my relatives, companions, friends”:"
    },
    {
      "number": 43,
      "pali": "",
      "english": "Offerings should be given for the dead"
    },
    {
      "number": 44,
      "pali": "",
      "english": "when one reflects thus"
    },
    {
      "number": 45,
      "pali": "",
      "english": "on things done in the past."
    },
    {
      "number": 46,
      "pali": "",
      "english": "For"
    },
    {
      "number": 47,
      "pali": "",
      "english": "no weeping,"
    },
    {
      "number": 48,
      "pali": "",
      "english": "no sorrowing"
    },
    {
      "number": 49,
      "pali": "",
      "english": "no other lamentation"
    },
    {
      "number": 50,
      "pali": "",
      "english": "benefits the dead"
    },
    {
      "number": 51,
      "pali": "",
      "english": "whose relatives persist in that way."
    },
    {
      "number": 52,
      "pali": "",
      "english": "But when this offering is given,"
    },
    {
      "number": 53,
      "pali": "",
      "english": "well-placed in the Saṅgha,"
    },
    {
      "number": 54,
      "pali": "",
      "english": "it works for their long-term benefit"
    },
    {
      "number": 55,
      "pali": "",
      "english": "and they profit immediately."
    },
    {
      "number": 56,
      "pali": "",
      "english": "In this way"
    },
    {
      "number": 57,
      "pali": "",
      "english": "the proper duty to relatives has been shown,"
    },
    {
      "number": 58,
      "pali": "",
      "english": "great honor has been done to the dead,"
    },
    {
      "number": 59,
      "pali": "",
      "english": "and monks have been given strength:"
    },
    {
      "number": 60,
      "pali": "",
      "english": "The merit you’ve acquired"
    },
    {
      "number": 61,
      "pali": "",
      "english": "isn’t small."
    }
  ]
}