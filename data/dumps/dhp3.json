{
  "sutta_id": "DHP3",
  "verses": [
    {
      "number": 1,
      "pali": "Tissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akkocchi maṁ avadhi maṁ, ",
      "english": "“They abused me, they hit me! "
    },
    {
      "number": 3,
      "pali": "ajini maṁ ahāsi me; ",
      "english": "They beat me, they robbed me!” "
    },
    {
      "number": 4,
      "pali": "Ye ca taṁ upanayhanti, ",
      "english": "For those who bear such a grudge, "
    },
    {
      "number": 5,
      "pali": "veraṁ tesaṁ na sammati. ",
      "english": "hatred is never laid to rest. "
    }
  ]
}