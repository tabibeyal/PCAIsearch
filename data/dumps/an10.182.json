  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.182 ",
      "english": "Numbered Discourses 10.182 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Dhammasutta ",
      "english": "The Teaching "
    },
    {
      "number": 4,
      "pali": "“Dhammañca vo, bhikkhave, desessāmi adhammañca. ",
      "english": "“I will teach you what is the teaching and what is not the teaching. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, adhammo? ",
      "english": "And what is not the teaching? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, adhammo. ",
      "english": "This is called what is not the teaching. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, dhammo? ",
      "english": "And what is the teaching? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, dhammo”ti. ",
      "english": "This is called the teaching.” "
    },
    {
      "number": 14,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}