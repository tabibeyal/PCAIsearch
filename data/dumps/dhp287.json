{
  "sutta_id": "DHP287",
  "verses": [
    {
      "number": 1,
      "pali": "Kisāgotamīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Taṁ puttapasusammattaṁ, ",
      "english": "As a mighty flood sweeps away a sleeping village, "
    },
    {
      "number": 3,
      "pali": "byāsattamanasaṁ naraṁ; ",
      "english": "death steals away a man "
    },
    {
      "number": 4,
      "pali": "Suttaṁ gāmaṁ mahoghova, ",
      "english": "who dotes on children and cattle, "
    },
    {
      "number": 5,
      "pali": "maccu ādāya gacchati. ",
      "english": "his mind caught up in them. "
    }
  ]
}