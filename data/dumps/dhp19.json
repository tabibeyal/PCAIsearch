{
  "sutta_id": "DHP19",
  "verses": [
    {
      "number": 1,
      "pali": "Dvesahāyakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Bahumpi ce saṁhita bhāsamāno, ",
      "english": "Much though they may recite scripture, "
    },
    {
      "number": 3,
      "pali": "Na takkaro hoti naro pamatto; ",
      "english": "if a negligent person does not apply them, "
    },
    {
      "number": 4,
      "pali": "Gopova gāvo gaṇayaṁ paresaṁ, ",
      "english": "then, like a cowherd who counts the cattle of others, "
    },
    {
      "number": 5,
      "pali": "Na bhāgavā sāmaññassa hoti. ",
      "english": "they miss out on the blessings of the ascetic life. "
    }
  ]
}