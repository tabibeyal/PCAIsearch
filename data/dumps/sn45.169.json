  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.169 ",
      "english": "Linked Discourses 45.169 "
    },
    {
      "number": 2,
      "pali": "13. Esanāvagga ",
      "english": "13. Searches "
    },
    {
      "number": 3,
      "pali": "Vedanāsutta ",
      "english": "Feelings "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, vedanā. ",
      "english": "“Mendicants, there are these three feelings: "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—",
      "english": "Pleasant, painful, and neutral feeling. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso vedanā. ",
      "english": "These are the three feelings. "
    },
    {
      "number": 8,
      "pali": "Imāsaṁ kho, bhikkhave, tissannaṁ vedanānaṁ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṁ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti. ",
      "english": "The noble eightfold path should be developed for the direct knowledge, complete understanding, finishing, and giving up of these three feelings.” "
    },
    {
      "number": 9,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}