{
  "sutta_id": "DHP296",
  "verses": [
    {
      "number": 1,
      "pali": "Dārusākaṭikaputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Suppabuddhaṁ pabujjhanti, ",
      "english": "The disciples of Gotama "
    },
    {
      "number": 3,
      "pali": "sadā gotamasāvakā; ",
      "english": "always wake up refreshed, "
    },
    {
      "number": 4,
      "pali": "Yesaṁ divā ca ratto ca, ",
      "english": "who day and night "
    },
    {
      "number": 5,
      "pali": "niccaṁ buddhagatā sati. ",
      "english": "constantly recollect the Buddha. "
    }
  ]
}