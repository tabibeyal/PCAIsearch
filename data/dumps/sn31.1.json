{
  "sutta_id": "SN31.1",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 31.1 ",
      "english": "Linked Discourses 31.1 "
    },
    {
      "number": 2,
      "pali": "1. Gandhabbavagga ",
      "english": "1. Centaurs "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme …pe… ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. … "
    },
    {
      "number": 5,
      "pali": "bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 6,
      "pali": "“gandhabbakāyike vo, bhikkhave, deve desessāmi. ",
      "english": "“Mendicants, I will teach you about the gods of the centaur realm. "
    },
    {
      "number": 7,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 8,
      "pali": "Katamā ca, bhikkhave, gandhabbakāyikā devā? ",
      "english": "And what are the gods of the centaur realm? "
    },
    {
      "number": 9,
      "pali": "Santi, bhikkhave, mūlagandhe adhivatthā devā. ",
      "english": "There are gods who live in fragrant roots, "
    },
    {
      "number": 10,
      "pali": "Santi, bhikkhave, sāragandhe adhivatthā devā. ",
      "english": "fragrant heartwood, "
    },
    {
      "number": 11,
      "pali": "Santi, bhikkhave, pheggugandhe adhivatthā devā. ",
      "english": "fragrant softwood, "
    },
    {
      "number": 12,
      "pali": "Santi, bhikkhave, tacagandhe adhivatthā devā. ",
      "english": "fragrant bark, "
    },
    {
      "number": 13,
      "pali": "Santi, bhikkhave, papaṭikagandhe adhivatthā devā. ",
      "english": "fragrant shoots, "
    },
    {
      "number": 14,
      "pali": "Santi, bhikkhave, pattagandhe adhivatthā devā. ",
      "english": "fragrant leaves, "
    },
    {
      "number": 15,
      "pali": "Santi, bhikkhave, pupphagandhe adhivatthā devā. ",
      "english": "fragrant flowers, "
    },
    {
      "number": 16,
      "pali": "Santi, bhikkhave, phalagandhe adhivatthā devā. ",
      "english": "fragrant fruit, "
    },
    {
      "number": 17,
      "pali": "Santi, bhikkhave, rasagandhe adhivatthā devā. ",
      "english": "fragrant sap, "
    },
    {
      "number": 18,
      "pali": "Santi, bhikkhave, gandhagandhe adhivatthā devā. ",
      "english": "and fragrant scents. "
    },
    {
      "number": 19,
      "pali": "Ime vuccanti, bhikkhave, gandhabbakāyikā devā”ti. ",
      "english": "These are called the gods of the centaur realm.” "
    },
    {
      "number": 20,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}