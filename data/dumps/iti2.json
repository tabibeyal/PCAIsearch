{
  "sutta_id": "ITI2",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 2 ",
      "english": "So It Was Said 2 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Dosasutta ",
      "english": "Hate "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Ekadhammaṁ, bhikkhave, pajahatha; ",
      "english": "“Mendicants, give up one thing "
    },
    {
      "number": 7,
      "pali": "ahaṁ vo pāṭibhogo anāgāmitāya. ",
      "english": "and I guarantee you non-return. "
    },
    {
      "number": 8,
      "pali": "Katamaṁ ekadhammaṁ? ",
      "english": "What one thing? "
    },
    {
      "number": 9,
      "pali": "Dosaṁ, bhikkhave, ekadhammaṁ pajahatha; ",
      "english": "Hate is the one thing. Give it up, "
    },
    {
      "number": 10,
      "pali": "ahaṁ vo pāṭibhogo anāgāmitāyā”ti. ",
      "english": "and I guarantee you non-return.” "
    },
    {
      "number": 11,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 12,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 13,
      "pali": "“Yena dosena duṭṭhāse, ",
      "english": "“When overcome by hate "
    },
    {
      "number": 14,
      "pali": "sattā gacchanti duggatiṁ; ",
      "english": "beings go to a bad place. "
    },
    {
      "number": 15,
      "pali": "Taṁ dosaṁ sammadaññāya, ",
      "english": "Having rightly understood that hate, "
    },
    {
      "number": 16,
      "pali": "pajahanti vipassino; ",
      "english": "the discerning give it up. "
    },
    {
      "number": 17,
      "pali": "Pahāya na punāyanti, ",
      "english": "Once they’ve given it up, "
    },
    {
      "number": 18,
      "pali": "imaṁ lokaṁ kudācanan”ti. ",
      "english": "they never return to this world.” "
    },
    {
      "number": 19,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 20,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}