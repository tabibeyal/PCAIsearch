{
  "sutta_id": "DHP422",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅgulimālattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Usabhaṁ pavaraṁ vīraṁ, ",
      "english": "Captain of the herd, excellent hero, "
    },
    {
      "number": 3,
      "pali": "mahesiṁ vijitāvinaṁ; ",
      "english": "great seer and victor; "
    },
    {
      "number": 4,
      "pali": "Anejaṁ nhātakaṁ buddhaṁ, ",
      "english": "unstirred, washed, awakened: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}