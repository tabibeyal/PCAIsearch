      "number": 1,
      "pali": "Aṅguttara Nikāya 4.248 ",
      "english": "Numbered Discourses 4.248 "
    },
    {
      "number": 2,
      "pali": "25. Āpattibhayavagga ",
      "english": "25. Perils of Offenses "
    },
    {
      "number": 3,
      "pali": "Paññāvuddhisutta ",
      "english": "The Growth of Wisdom "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, dhammā paññāvuddhiyā saṁvattanti. ",
      "english": "“Mendicants, these four things lead to the growth of wisdom. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sappurisasaṁsevo, saddhammasavanaṁ, yonisomanasikāro, dhammānudhammappaṭipatti—",
      "english": "Associating with true persons, listening to the true teaching, rational application of mind, and practicing in line with the teaching. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro dhammā paññāvuddhiyā saṁvattantī”ti. ",
      "english": "These four things lead to the growth of wisdom.” "
    },
    {
      "number": 8,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}