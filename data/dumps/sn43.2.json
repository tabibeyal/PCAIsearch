{
  "sutta_id": "SN43.2",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 43.2 ",
      "english": "Linked Discourses 43.2 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Samathavipassanāsutta ",
      "english": "Serenity and Discernment "
    },
    {
      "number": 4,
      "pali": "“Asaṅkhatañca vo, bhikkhave, desessāmi asaṅkhatagāmiñca maggaṁ. ",
      "english": "“Mendicants, I will teach you the unconditioned and the path that leads to the unconditioned. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 6,
      "pali": "Katamañca, bhikkhave, asaṅkhataṁ? ",
      "english": "And what is the unconditioned? "
    },
    {
      "number": 7,
      "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 8,
      "pali": "idaṁ vuccati, bhikkhave, asaṅkhataṁ. ",
      "english": "This is called the unconditioned. "
    },
    {
      "number": 9,
      "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo? ",
      "english": "And what is the path that leads to the unconditioned? "
    },
    {
      "number": 10,
      "pali": "Samatho ca vipassanā ca. ",
      "english": "Serenity and discernment. "
    },
    {
      "number": 11,
      "pali": "Ayaṁ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…. ",
      "english": "This is called the path that leads to the unconditioned. …” "
    },
    {
      "number": 12,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}