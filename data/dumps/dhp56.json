{
  "sutta_id": "DHP56",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākassapattherapiṇḍapātadinnavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamatto ayaṁ gandho, ",
      "english": "Faint is the fragrance "
    },
    {
      "number": 3,
      "pali": "yāyaṁ tagaracandanī; ",
      "english": "of sandal or pinwheel; "
    },
    {
      "number": 4,
      "pali": "Yo ca sīlavataṁ gandho, ",
      "english": "but the fragrance of the virtuous "
    },
    {
      "number": 5,
      "pali": "vāti devesu uttamo. ",
      "english": "floats to the highest gods. "
    }
  ]
}