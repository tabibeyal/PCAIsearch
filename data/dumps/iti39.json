  "sutta_id": "ITI39",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 39",
      "english": "Itivuttaka 39"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, the Tathāgata–worthy & rightly self-awakened–has two Dhamma discourses given in sequence. Which two? ‘See evil as evil.’ This is the first Dhamma discourse. ‘Having seen evil as evil, become disenchanted there, dispassionate there, released.’ This is the second Dhamma discourse. These are the two Dhamma discourses that the Tathāgata–worthy & rightly self-awakened–has given in sequence.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "See the two statements,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "declared in sequence,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "by the Tathāgata,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "awakened, sympathetic"
    },
    {
      "number": 8,
      "pali": "",
      "english": "to all beings."
    },
    {
      "number": 9,
      "pali": "",
      "english": "The first: see evil."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Be dispassionate there"
    },
    {
      "number": 11,
      "pali": "",
      "english": "toward evil."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Then, with a mind dispassionate,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "you will make an end"
    },
    {
      "number": 14,
      "pali": "",
      "english": "of suffering & stress."
    }
  ]
}