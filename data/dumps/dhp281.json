{
  "sutta_id": "DHP281",
  "verses": [
    {
      "number": 1,
      "pali": "Sūkarapetavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Vācānurakkhī manasā susaṁvuto, ",
      "english": "Guarded in speech, restrained in mind, "
    },
    {
      "number": 3,
      "pali": "Kāyena ca nākusalaṁ kayirā; ",
      "english": "doing no unskillful bodily deed. "
    },
    {
      "number": 4,
      "pali": "Ete tayo kammapathe visodhaye, ",
      "english": "Purify these three ways of performing deeds, "
    },
    {
      "number": 5,
      "pali": "Ārādhaye maggamisippaveditaṁ. ",
      "english": "and win the path known to seers. "
    }
  ]
}