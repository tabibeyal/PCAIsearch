{
  "sutta_id": "DHP228",
  "verses": [
    {
      "number": 1,
      "pali": "Na cāhu na ca bhavissati, ",
      "english": "There never was, nor will be, "
    },
    {
      "number": 2,
      "pali": "na cetarahi vijjati; ",
      "english": "nor is there today, "
    },
    {
      "number": 3,
      "pali": "Ekantaṁ nindito poso, ",
      "english": "someone who is wholly praised "
    },
    {
      "number": 4,
      "pali": "ekantaṁ vā pasaṁsito. ",
      "english": "or wholly blamed. "
    }
  ]
}