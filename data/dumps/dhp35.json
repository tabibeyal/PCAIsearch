{
  "sutta_id": "DHP35",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dunniggahassa lahuno, ",
      "english": "Hard to hold back, flighty, "
    },
    {
      "number": 3,
      "pali": "yatthakāmanipātino; ",
      "english": "alighting where it will; "
    },
    {
      "number": 4,
      "pali": "Cittassa damatho sādhu, ",
      "english": "it’s good to tame the mind; "
    },
    {
      "number": 5,
      "pali": "cittaṁ dantaṁ sukhāvahaṁ. ",
      "english": "a tamed mind leads to bliss. "
    }
  ]
}