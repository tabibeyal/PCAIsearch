{
  "sutta_id": "AN5.251",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.251 ",
      "english": "Numbered Discourses 5.251 "
    },
    {
      "number": 2,
      "pali": "26. Upasampadāvagga ",
      "english": "26. Ordination "
    },
    {
      "number": 3,
      "pali": "Upasampādetabbasutta ",
      "english": "Who Should Give Ordination "
    },
    {
      "number": 4,
      "pali": "“Pañcahi, bhikkhave, dhammehi samannāgatena bhikkhunā upasampādetabbaṁ. ",
      "english": "“Mendicants, ordination should be given by a mendicant with five qualities. "
    },
    {
      "number": 5,
      "pali": "Katamehi pañcahi? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Idha, bhikkhave, bhikkhu asekhena sīlakkhandhena samannāgato hoti; ",
      "english": "It’s a mendicant who has the entire spectrum of an adept’s ethics, "
    },
    {
      "number": 7,
      "pali": "asekhena samādhikkhandhena samannāgato hoti; ",
      "english": "immersion, "
    },
    {
      "number": 8,
      "pali": "asekhena paññākkhandhena samannāgato hoti; ",
      "english": "wisdom, "
    },
    {
      "number": 9,
      "pali": "asekhena vimuttikkhandhena samannāgato hoti; ",
      "english": "freedom, "
    },
    {
      "number": 10,
      "pali": "asekhena vimuttiñāṇadassanakkhandhena samannāgato hoti. ",
      "english": "and the knowledge and vision of freedom. "
    },
    {
      "number": 11,
      "pali": "Imehi kho, bhikkhave, pañcahi dhammehi samannāgatena bhikkhunā upasampādetabban”ti. ",
      "english": "Ordination should be given by a mendicant with these five qualities.” "
    },
    {
      "number": 12,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}