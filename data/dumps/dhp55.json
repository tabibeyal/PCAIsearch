{
  "sutta_id": "DHP55",
  "verses": [
    {
      "number": 1,
      "pali": "Candanaṁ tagaraṁ vāpi, ",
      "english": "Among all the fragrances—"
    },
    {
      "number": 2,
      "pali": "uppalaṁ atha vassikī; ",
      "english": "sandalwood or pinwheel "
    },
    {
      "number": 3,
      "pali": "Etesaṁ gandhajātānaṁ, ",
      "english": "or lotus or jasmine—"
    },
    {
      "number": 4,
      "pali": "sīlagandho anuttaro. ",
      "english": "the fragrance of virtue is supreme. "
    }
  ]
}