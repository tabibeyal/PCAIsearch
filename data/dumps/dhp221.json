    {
      "number": 1,
      "pali": "Khuddakanikāya ",
      "english": "Minor Collection "
    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 221–234 "
    },
    {
      "number": 3,
      "pali": "Kodhavagga ",
      "english": "17. Anger "
    },
    {
      "number": 4,
      "pali": "Rohinīkhattiyakaññāvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Kodhaṁ jahe vippajaheyya mānaṁ, ",
      "english": "Give up anger, get rid of conceit, "
    },
    {
      "number": 6,
      "pali": "Saṁyojanaṁ sabbamatikkameyya; ",
      "english": "and escape every fetter. "
    },
    {
      "number": 7,
      "pali": "Taṁ nāmarūpasmimasajjamānaṁ, ",
      "english": "Sufferings don’t befall one who has nothing, "
    },
    {
      "number": 8,
      "pali": "Akiñcanaṁ nānupatanti dukkhā. ",
      "english": "not clinging to name and form. "
    }
  ]
}