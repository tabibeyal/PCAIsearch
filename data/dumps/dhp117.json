{
  "sutta_id": "DHP117",
  "verses": [
    {
      "number": 1,
      "pali": "Seyyasakattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pāpañce puriso kayirā, ",
      "english": "If you do something bad, "
    },
    {
      "number": 3,
      "pali": "Na naṁ kayirā punappunaṁ; ",
      "english": "don’t do it again and again, "
    },
    {
      "number": 4,
      "pali": "Na tamhi chandaṁ kayirātha, ",
      "english": "don’t set your heart on it, "
    },
    {
      "number": 5,
      "pali": "Dukkho pāpassa uccayo. ",
      "english": "for piling up evil is suffering. "
    }
  ]
}