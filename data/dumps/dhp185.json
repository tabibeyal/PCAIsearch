{
  "sutta_id": "DHP185",
  "verses": [
    {
      "number": 1,
      "pali": "Anūpavādo anūpaghāto, ",
      "english": "Not speaking ill nor doing harm; "
    },
    {
      "number": 2,
      "pali": "Pātimokkhe ca saṁvaro; ",
      "english": "restraint in the monastic code; "
    },
    {
      "number": 3,
      "pali": "Mattaññutā ca bhattasmiṁ, ",
      "english": "moderation in eating; "
    },
    {
      "number": 4,
      "pali": "Pantañca sayanāsanaṁ; ",
      "english": "staying in remote lodgings; "
    },
    {
      "number": 5,
      "pali": "Adhicitte ca āyogo, ",
      "english": "commitment to the higher mind—"
    },
    {
      "number": 6,
      "pali": "Etaṁ buddhāna sāsanaṁ. ",
      "english": "this is the instruction of the Buddhas. "
    }
  ]
}