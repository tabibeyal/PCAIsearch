{
  "sutta_id": "DHP285",
  "verses": [
    {
      "number": 1,
      "pali": "Suvaṇṇakārattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ucchinda sinehamattano, ",
      "english": "Cut out affection for oneself, "
    },
    {
      "number": 3,
      "pali": "Kumudaṁ sāradikaṁva pāṇinā; ",
      "english": "like plucking an autumn lotus. "
    },
    {
      "number": 4,
      "pali": "Santimaggameva brūhaya, ",
      "english": "Foster only the path to peace, "
    },
    {
      "number": 5,
      "pali": "Nibbānaṁ sugatena desitaṁ. ",
      "english": "the extinguishment the Holy One taught. "
    }
  ]
}