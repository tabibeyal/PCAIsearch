{
  "sutta_id": "DHP370",
  "verses": [
    {
      "number": 1,
      "pali": "Pañca chinde pañca jahe, ",
      "english": "Five to cut, five to drop, "
    },
    {
      "number": 2,
      "pali": "pañca cuttari bhāvaye; ",
      "english": "and five more to develop. "
    },
    {
      "number": 3,
      "pali": "Pañca saṅgātigo bhikkhu, ",
      "english": "When a mendicant slips five chains "
    },
    {
      "number": 4,
      "pali": "“oghatiṇṇo”ti vuccati. ",
      "english": "they’re said to have crossed the flood. "
    }
  ]
}