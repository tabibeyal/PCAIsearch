{
  "sutta_id": "ITI50",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 50 ",
      "english": "So It Was Said 50 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Mūlasutta ",
      "english": "Roots "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, akusalamūlāni. ",
      "english": "“Mendicants, there are these three unskillful roots. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Lobho akusalamūlaṁ, doso akusalamūlaṁ, moho akusalamūlaṁ—",
      "english": "Greed, hate, and delusion. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi akusalamūlānī”ti. ",
      "english": "These are the three unskillful roots.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Lobho doso ca moho ca, ",
      "english": "“When greed, hate, and delusion, "
    },
    {
      "number": 13,
      "pali": "purisaṁ pāpacetasaṁ; ",
      "english": "have arisen inside oneself, "
    },
    {
      "number": 14,
      "pali": "Hiṁsanti attasambhūtā, ",
      "english": "they harm a person of wicked heart, "
    },
    {
      "number": 15,
      "pali": "tacasāraṁva samphalan”ti. ",
      "english": "as a bamboo is destroyed by its own fruit.” "
    },
    {
      "number": 16,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 17,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}