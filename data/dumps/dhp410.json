{
  "sutta_id": "DHP410",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Āsā yassa na vijjanti, ",
      "english": "They have no hope "
    },
    {
      "number": 3,
      "pali": "asmiṁ loke paramhi ca; ",
      "english": "in this world or the next; "
    },
    {
      "number": 4,
      "pali": "Nirāsāsaṁ visaṁyuttaṁ, ",
      "english": "with no need for hope, detached: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}