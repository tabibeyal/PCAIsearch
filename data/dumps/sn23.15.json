  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 23.15 ",
      "english": "Linked Discourses 23.15 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyamāravagga ",
      "english": "2. About Māra (2nd) "
    },
    {
      "number": 3,
      "pali": "Dukkhasutta ",
      "english": "Suffering "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ nisinno kho āyasmā rādho bhagavantaṁ etadavoca: ",
      "english": "Seated to one side, Venerable Rādha said to the Buddha: "
    },
    {
      "number": 6,
      "pali": "“‘dukkhaṁ, dukkhan’ti, bhante, vuccati. ",
      "english": "“Sir, they speak of ‘suffering’. "
    },
    {
      "number": 7,
      "pali": "Katamaṁ nu kho, bhante, dukkhan”ti? ",
      "english": "What is suffering?” "
    },
    {
      "number": 8,
      "pali": "“Rūpaṁ kho, rādha, dukkhaṁ, vedanā dukkhā, saññā dukkhā, saṅkhārā dukkhā, viññāṇaṁ dukkhaṁ. ",
      "english": "“Rādha, form, feeling, perception, choices, and consciousness are suffering. "
    },
    {
      "number": 9,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 10,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 11,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}