{
  "sutta_id": "DHP16",
  "verses": [
    {
      "number": 1,
      "pali": "Dhammikaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idha modati pecca modati, ",
      "english": "Here they rejoice, hereafter they rejoice, "
    },
    {
      "number": 3,
      "pali": "Katapuñño ubhayattha modati; ",
      "english": "one who does good rejoices in both places. "
    },
    {
      "number": 4,
      "pali": "So modati so pamodati, ",
      "english": "They rejoice and celebrate, "
    },
    {
      "number": 5,
      "pali": "Disvā kammavisuddhimattano. ",
      "english": "seeing their own pure deeds. "
    }
  ]
}