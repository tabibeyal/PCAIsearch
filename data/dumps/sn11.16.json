{
  "sutta_id": "SN11.16",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.16 ",
      "english": "Linked Discourses 11.16 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Yajamānasutta ",
      "english": "Sponsoring Sacrifice "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
      "english": "At one time the Buddha was staying near Rājagaha, on the Vulture’s Peak Mountain. "
    },
    {
      "number": 5,
      "pali": "Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ",
      "english": "And then Sakka, lord of gods, went up to the Buddha, bowed, stood to one side, "
    },
    {
      "number": 6,
      "pali": "Ekamantaṁ ṭhito kho sakko devānamindo bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "and addressed him in verse: "
    },
    {
      "number": 7,
      "pali": "“Yajamānānaṁ manussānaṁ, ",
      "english": "“For humans, those merit-seeking creatures, "
    },
    {
      "number": 8,
      "pali": "puññapekkhāna pāṇinaṁ; ",
      "english": "who sponsor sacrifices, "
    },
    {
      "number": 9,
      "pali": "Karotaṁ opadhikaṁ puññaṁ, ",
      "english": "making worldly merit, "
    },
    {
      "number": 10,
      "pali": "kattha dinnaṁ mahapphalan”ti. ",
      "english": "where is a gift very fruitful?” "
    },
    {
      "number": 11,
      "pali": "“Cattāro ca paṭipannā, ",
      "english": "“Four practicing the path, "
    },
    {
      "number": 12,
      "pali": "cattāro ca phale ṭhitā; ",
      "english": "and four established in the fruit. "
    },
    {
      "number": 13,
      "pali": "Esa saṅgho ujubhūto, ",
      "english": "This is the upright Saṅgha, "
    },
    {
      "number": 14,
      "pali": "paññāsīlasamāhito. ",
      "english": "with wisdom, ethics, and immersion. "
    },
    {
      "number": 15,
      "pali": "Yajamānānaṁ manussānaṁ, ",
      "english": "For humans, those merit-seeking creatures, "
    },
    {
      "number": 16,
      "pali": "Puññapekkhāna pāṇinaṁ; ",
      "english": "who sponsor sacrifices, "
    },
    {
      "number": 17,
      "pali": "Karotaṁ opadhikaṁ puññaṁ, ",
      "english": "making worldly merit, "
    },
    {
      "number": 18,
      "pali": "Saṅghe dinnaṁ mahapphalan”ti. ",
      "english": "what is given to the Saṅgha is very fruitful.” "
    }
  ]
}