{
  "sutta_id": "DHP252",
  "verses": [
    {
      "number": 1,
      "pali": "Meṇḍakaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sudassaṁ vajjamaññesaṁ, ",
      "english": "It’s easy to see the faults of others, "
    },
    {
      "number": 3,
      "pali": "attano pana duddasaṁ; ",
      "english": "hard to see one’s own. "
    },
    {
      "number": 4,
      "pali": "Paresaṁ hi so vajjāni, ",
      "english": "For the faults of others "
    },
    {
      "number": 5,
      "pali": "opunāti yathā bhusaṁ; ",
      "english": "are tossed high like hay, "
    },
    {
      "number": 6,
      "pali": "Attano pana chādeti, ",
      "english": "while one’s own are hidden, "
    },
    {
      "number": 7,
      "pali": "kaliṁva kitavā saṭho. ",
      "english": "as a cheat hides a bad hand. "
    }
  ]
}