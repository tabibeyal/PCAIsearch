{
  "sutta_id": "SN1.77",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.77 ",
      "english": "Linked Discourses 1.77 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Issariyasutta ",
      "english": "Authority "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu issariyaṁ loke, ",
      "english": "“What is authority in the world? "
    },
    {
      "number": 5,
      "pali": "kiṁsu bhaṇḍānamuttamaṁ; ",
      "english": "What’s the best of valuables? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu satthamalaṁ loke, ",
      "english": "What in the world is a rusty sword? "
    },
    {
      "number": 7,
      "pali": "kiṁsu lokasmimabbudaṁ. ",
      "english": "Who is a pest in the world? "
    },
    {
      "number": 8,
      "pali": "Kiṁsu harantaṁ vārenti, ",
      "english": "Who gets arrested when they take things away? "
    },
    {
      "number": 9,
      "pali": "haranto pana ko piyo; ",
      "english": "And who is loved when they take things away? "
    },
    {
      "number": 10,
      "pali": "Kiṁsu punappunāyantaṁ, ",
      "english": "And who is approved by the astute "
    },
    {
      "number": 11,
      "pali": "abhinandanti paṇḍitā”ti. ",
      "english": "when they come again and again?” "
    },
    {
      "number": 12,
      "pali": "“Vaso issariyaṁ loke, ",
      "english": "“Sway is authority in the world. "
    },
    {
      "number": 13,
      "pali": "itthī bhaṇḍānamuttamaṁ; ",
      "english": "A woman is the best of valuables. "
    },
    {
      "number": 14,
      "pali": "Kodho satthamalaṁ loke, ",
      "english": "Anger in the world is a rusty sword. "
    },
    {
      "number": 15,
      "pali": "corā lokasmimabbudā. ",
      "english": "A bandit is a pest in the world. "
    },
    {
      "number": 16,
      "pali": "Coraṁ harantaṁ vārenti, ",
      "english": "A bandit gets arrested when they take things away. "
    },
    {
      "number": 17,
      "pali": "haranto samaṇo piyo; ",
      "english": "And an ascetic is loved when they take things away. "
    },
    {
      "number": 18,
      "pali": "Samaṇaṁ punappunāyantaṁ, ",
      "english": "An ascetic is approved by the astute "
    },
    {
      "number": 19,
      "pali": "abhinandanti paṇḍitā”ti. ",
      "english": "when they come again and again.” "
    }
  ]
}