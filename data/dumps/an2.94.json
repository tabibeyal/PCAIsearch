{
  "sutta_id": "AN2.94",
  "verses": [
    {
      "number": 1,
      "pali": "94 ",
      "english": "94 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Dovacassatā ca pāpamittatā ca. ",
      "english": "Being hard to admonish and having bad friends. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}