{
  "sutta_id": "DHP412",
  "verses": [
    {
      "number": 1,
      "pali": "Revatattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yodha puññañca pāpañca, ",
      "english": "They’ve escaped clinging "
    },
    {
      "number": 3,
      "pali": "ubho saṅgamupaccagā; ",
      "english": "to both good and bad deeds; "
    },
    {
      "number": 4,
      "pali": "Asokaṁ virajaṁ suddhaṁ, ",
      "english": "sorrowless, stainless, pure: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}