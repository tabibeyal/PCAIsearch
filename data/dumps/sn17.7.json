  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 17.7 ",
      "english": "Linked Discourses 17.7 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Diddhasutta ",
      "english": "A Poisoned Arrow "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dāruṇo, bhikkhave, lābhasakkārasiloko …pe… adhigamāya. ",
      "english": "“Possessions, honor, and popularity are grim … "
    },
    {
      "number": 6,
      "pali": "Kaṁ, bhikkhave, diddhagatena visallena sallena vijjhatu, sekhaṁ appattamānasaṁ lābhasakkārasiloko anupāpuṇātu. ",
      "english": "Let whom be pierced by a poisoned arrow? Let possessions, honor, and popularity come to a trainee who has not achieved their heart’s desire. "
    },
    {
      "number": 7,
      "pali": "Sallanti kho, bhikkhave, lābhasakkārasilokassetaṁ adhivacanaṁ. ",
      "english": "‘Arrow’ is a term for possessions, honor, and popularity. "
    },
    {
      "number": 8,
      "pali": "Evaṁ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "So grim are possessions, honor, and popularity. …” "
    },
    {
      "number": 9,
      "pali": "evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}