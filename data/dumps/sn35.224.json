    {
      "number": 3,
      "pali": "Ajjhattāyatanaanattasutta ",
      "english": "The Interior as Not-Self "
    },
    {
      "number": 4,
      "pali": "“Cakkhu, bhikkhave, anattā …pe… jivhā anattā …pe… mano anattā. ",
      "english": "“Mendicants, the eye, ear, nose, tongue, body, and mind are not-self. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    }
