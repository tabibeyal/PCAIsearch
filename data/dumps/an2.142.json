{
  "sutta_id": "AN2.142",
  "verses": [
    {
      "number": 1,
      "pali": "142 ",
      "english": "142 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, yāgā. ",
      "english": "“There are these two offerings. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisayāgo ca dhammayāgo ca. ",
      "english": "An offering of things of the flesh and an offering of the teaching. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve yāgā. ",
      "english": "These are the two offerings. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ yāgānaṁ yadidaṁ dhammayāgo”ti. ",
      "english": "The better of these two offerings is an offering of the teaching.” "
    }
  ]
}