  "verses": [
    {
      "number": 1,
      "pali": "Ekaanāgāmittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Chandajāto anakkhāte, ",
      "english": "One eager to realize the ineffable "
    },
    {
      "number": 3,
      "pali": "Manasā ca phuṭo siyā; ",
      "english": "would be filled with awareness. "
    },
    {
      "number": 4,
      "pali": "Kāmesu ca appaṭibaddhacitto, ",
      "english": "Their mind not bound to pleasures of sense, "
    },
    {
      "number": 5,
      "pali": "Uddhaṁsototi vuccati. ",
      "english": "they’re said to be heading upstream. "
    }
  ]
