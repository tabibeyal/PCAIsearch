{
  "sutta_id": "DHP133",
  "verses": [
    {
      "number": 1,
      "pali": "Koṇḍadhānattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Māvoca pharusaṁ kañci, ",
      "english": "Don’t speak harshly, "
    },
    {
      "number": 3,
      "pali": "vuttā paṭivadeyyu taṁ; ",
      "english": "they may speak harshly back. "
    },
    {
      "number": 4,
      "pali": "Dukkhā hi sārambhakathā, ",
      "english": "For aggressive speech is painful, "
    },
    {
      "number": 5,
      "pali": "paṭidaṇḍā phuseyyu taṁ. ",
      "english": "and the rod may spring back on you. "
    }
  ]
}