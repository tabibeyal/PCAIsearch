{
  "sutta_id": "DHP315",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Nagaraṁ yathā paccantaṁ, ",
      "english": "As a frontier city "
    },
    {
      "number": 3,
      "pali": "guttaṁ santarabāhiraṁ; ",
      "english": "is guarded inside and out, "
    },
    {
      "number": 4,
      "pali": "Evaṁ gopetha attānaṁ, ",
      "english": "so you should ward yourselves—"
    },
    {
      "number": 5,
      "pali": "khaṇo vo mā upaccagā; ",
      "english": "don’t let the moment pass you by. "
    },
    {
      "number": 6,
      "pali": "Khaṇātītā hi socanti, ",
      "english": "For if you miss your moment "
    },
    {
      "number": 7,
      "pali": "nirayamhi samappitā. ",
      "english": "you’ll grieve when sent to hell. "
    }
  ]
}