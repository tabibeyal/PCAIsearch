{
  "sutta_id": "DHP10",
  "verses": [
    {
      "number": 1,
      "pali": "Yo ca vantakasāvassa, ",
      "english": "One who’s purged all their stains, "
    },
    {
      "number": 2,
      "pali": "sīlesu susamāhito; ",
      "english": "steady in ethics, "
    },
    {
      "number": 3,
      "pali": "Upeto damasaccena, ",
      "english": "possessed of self-control and of truth, "
    },
    {
      "number": 4,
      "pali": "sa ve kāsāvamarahati. ",
      "english": "they are truly worthy of the ocher robe. "
    }
  ]
}