{
  "sutta_id": "DHP236",
  "verses": [
    {
      "number": 1,
      "pali": "So karohi dīpamattano, ",
      "english": "Make an island of yourself! "
    },
    {
      "number": 2,
      "pali": "Khippaṁ vāyama paṇḍito bhava; ",
      "english": "Swiftly strive, learn to be wise! "
    },
    {
      "number": 3,
      "pali": "Niddhantamalo anaṅgaṇo, ",
      "english": "Purged of stains, flawless, "
    },
    {
      "number": 4,
      "pali": "Dibbaṁ ariyabhūmiṁ upehisi. ",
      "english": "you’ll go to the heavenly realm of the noble ones. "
    }
  ]
}