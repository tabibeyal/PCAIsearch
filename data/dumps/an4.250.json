{
  "sutta_id": "AN4.250",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.250 ",
      "english": "Numbered Discourses 4.250 "
    },
    {
      "number": 2,
      "pali": "25. Āpattibhayavagga ",
      "english": "25. Perils of Offenses "
    },
    {
      "number": 3,
      "pali": "Paṭhamavohārasutta ",
      "english": "Expressions (1st) "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, anariyavohārā. ",
      "english": "“Mendicants, there are these four ignoble expressions. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Adiṭṭhe diṭṭhavāditā, asute sutavāditā, amute mutavāditā, aviññāte viññātavāditā—",
      "english": "Saying you’ve seen, heard, thought, or known something, but you haven’t. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro anariyavohārā”ti. ",
      "english": "These are the four ignoble expressions.” "
    },
    {
      "number": 8,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}