{
  "sutta_id": "ITI79",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 79 ",
      "english": "So It Was Said 79 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Parihānasutta ",
      "english": "Decline "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, dhammā sekhassa bhikkhuno parihānāya saṁvattanti. ",
      "english": "“These three things lead to the decline of a mendicant trainee. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Idha, bhikkhave, sekho bhikkhu kammārāmo hoti, kammarato, kammārāmatamanuyutto; ",
      "english": "It’s when a mendicant relishes work, "
    },
    {
      "number": 9,
      "pali": "bhassārāmo hoti, bhassarato, bhassārāmatamanuyutto; ",
      "english": "talk, "
    },
    {
      "number": 10,
      "pali": "niddārāmo hoti, niddārato, niddārāmatamanuyutto. ",
      "english": "and sleep. "
    },
    {
      "number": 11,
      "pali": "Ime kho, bhikkhave, tayo dhammā sekhassa bhikkhuno parihānāya saṁvattanti. ",
      "english": "These three things lead to the decline of a mendicant trainee. "
    },
    {
      "number": 12,
      "pali": "Tayome, bhikkhave, dhammā sekhassa bhikkhuno aparihānāya saṁvattanti. ",
      "english": "These three things don’t lead to the decline of a mendicant trainee. "
    },
    {
      "number": 13,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 14,
      "pali": "Idha, bhikkhave, sekho bhikkhu na kammārāmo hoti, na kammarato, na kammārāmatamanuyutto; ",
      "english": "It’s when a mendicant doesn’t relish work, "
    },
    {
      "number": 15,
      "pali": "na bhassārāmo hoti, na bhassarato, na bhassārāmatamanuyutto; ",
      "english": "talk, "
    },
    {
      "number": 16,
      "pali": "na niddārāmo hoti, na niddārato, na niddārāmatamanuyutto. ",
      "english": "and sleep. "
    },
    {
      "number": 17,
      "pali": "Ime kho, bhikkhave, tayo dhammā sekhassa bhikkhuno aparihānāya saṁvattantī”ti. ",
      "english": "These three things don’t lead to the decline of a mendicant trainee.” "
    },
    {
      "number": 18,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 19,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 20,
      "pali": "“Kammārāmo bhassārāmo, ",
      "english": "“Restless, they relish "
    },
    {
      "number": 21,
      "pali": "Niddārāmo ca uddhato; ",
      "english": "work, talk, and sleep. "
    },
    {
      "number": 22,
      "pali": "Abhabbo tādiso bhikkhu, ",
      "english": "Such a mendicant is incapable "
    },
    {
      "number": 23,
      "pali": "Phuṭṭhuṁ sambodhimuttamaṁ. ",
      "english": "of experiencing the highest awakening. "
    },
    {
      "number": 24,
      "pali": "Tasmā hi appakiccassa, ",
      "english": "That’s why one ought have few duties, "
    },
    {
      "number": 25,
      "pali": "Appamiddho anuddhato; ",
      "english": "being wakeful not restless. "
    },
    {
      "number": 26,
      "pali": "Bhabbo so tādiso bhikkhu, ",
      "english": "Such a mendicant is capable "
    },
    {
      "number": 27,
      "pali": "Phuṭṭhuṁ sambodhimuttaman”ti. ",
      "english": "of experiencing the highest awakening.” "
    },
    {
      "number": 28,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 29,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 30,
      "pali": "Tatiyo vaggo. ",
      "english": ""
    },
    {
      "number": 31,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 32,
      "pali": "Dve diṭṭhī nissaraṇaṁ rūpaṁ, ",
      "english": ""
    },
    {
      "number": 33,
      "pali": "putto avuṭṭhikena ca; ",
      "english": ""
    },
    {
      "number": 34,
      "pali": "Sukhā ca bhiduro dhātu, ",
      "english": ""
    },
    {
      "number": 35,
      "pali": "parihānena te dasāti. ",
      "english": ""
    }
  ]
}