    {
      "number": 3,
      "pali": "Sampadāsutta ",
      "english": "Accomplishment "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, sampadā. ",
      "english": "“Mendicants, there are three accomplishments. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Saddhāsampadā, sīlasampadā, paññāsampadā—",
      "english": "Accomplishment in faith, ethics, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso sampadā”ti. ",
      "english": "These are the three accomplishments.” "
    },
    {
      "number": 8,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
