    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Sīlasampadā ca diṭṭhisampadā ca. ",
      "english": "Accomplishment in ethical conduct and accomplishment in view. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”. ",
      "english": "These are the two things.” "
    }
  ]
}