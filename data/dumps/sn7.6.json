{
  "sutta_id": "SN7.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 7.6 ",
      "english": "Linked Discourses 7.6 "
    },
    {
      "number": 2,
      "pali": "1. Arahantavagga ",
      "english": "1. The Perfected Ones "
    },
    {
      "number": 3,
      "pali": "Jaṭāsutta ",
      "english": "With Bhāradvāja of the Matted Hair "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Atha kho jaṭābhāradvājo brāhmaṇo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṁ sammodi. ",
      "english": "Then the brahmin Bhāradvāja of the Matted Hair went up to the Buddha, and exchanged greetings with him. "
    },
    {
      "number": 6,
      "pali": "Sammodanīyaṁ kathaṁ sāraṇīyaṁ vītisāretvā ekamantaṁ nisīdi. ",
      "english": "When the greetings and polite conversation were over, he sat down to one side, "
    },
    {
      "number": 7,
      "pali": "Ekamantaṁ nisinno kho jaṭābhāradvājo brāhmaṇo bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "and addressed the Buddha in verse: "
    },
    {
      "number": 8,
      "pali": "“Antojaṭā bahijaṭā, ",
      "english": "“Tangled within, tangled without: "
    },
    {
      "number": 9,
      "pali": "Jaṭāya jaṭitā pajā; ",
      "english": "these people are tangled in tangles. "
    },
    {
      "number": 10,
      "pali": "Taṁ taṁ gotama pucchāmi, ",
      "english": "I ask you this, Gotama: "
    },
    {
      "number": 11,
      "pali": "Ko imaṁ vijaṭaye jaṭan”ti. ",
      "english": "who can untangle this tangle?” "
    },
    {
      "number": 12,
      "pali": "“Sīle patiṭṭhāya naro sapañño, ",
      "english": "“A wise person grounded in ethics, "
    },
    {
      "number": 13,
      "pali": "Cittaṁ paññañca bhāvayaṁ; ",
      "english": "developing the mind and wisdom, "
    },
    {
      "number": 14,
      "pali": "Ātāpī nipako bhikkhu, ",
      "english": "a keen and alert mendicant—"
    },
    {
      "number": 15,
      "pali": "So imaṁ vijaṭaye jaṭaṁ. ",
      "english": "they can untangle this tangle. "
    },
    {
      "number": 16,
      "pali": "Yesaṁ rāgo ca doso ca, ",
      "english": "Those in whom greed, hate, and ignorance "
    },
    {
      "number": 17,
      "pali": "avijjā ca virājitā; ",
      "english": "have faded away; "
    },
    {
      "number": 18,
      "pali": "Khīṇāsavā arahanto, ",
      "english": "the perfected ones with defilements ended—"
    },
    {
      "number": 19,
      "pali": "tesaṁ vijaṭitā jaṭā. ",
      "english": "they have untangled the tangle. "
    },
    {
      "number": 20,
      "pali": "Yattha nāmañca rūpañca, ",
      "english": "Where name and form "
    },
    {
      "number": 21,
      "pali": "asesaṁ uparujjhati; ",
      "english": "cease with no residue left behind; "
    },
    {
      "number": 22,
      "pali": "Paṭighaṁ rūpasaññā ca, ",
      "english": "as well as impingement and perception of form: "
    },
    {
      "number": 23,
      "pali": "etthesā chijjate jaṭā”ti. ",
      "english": "it’s there that the tangle is cut.” "
    },
    {
      "number": 24,
      "pali": "Evaṁ vutte, jaṭābhāradvājo bhagavantaṁ etadavoca: ",
      "english": "When he had spoken, Bhāradvāja of the Matted Hair said to the Buddha, "
    },
    {
      "number": 25,
      "pali": "“abhikkantaṁ, bho gotama …pe… ",
      "english": "“Excellent, worthy Gotama! …” … "
    },
    {
      "number": 26,
      "pali": "aññataro ca panāyasmā bhāradvājo arahataṁ ahosī”ti. ",
      "english": "And Venerable Bhāradvāja became one of the perfected. "
    }
  ]
}