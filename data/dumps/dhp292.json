{
  "sutta_id": "DHP292",
  "verses": [
    {
      "number": 1,
      "pali": "Bhaddiyānaṁbhikkhūnaṁvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yañhi kiccaṁ apaviddhaṁ, ",
      "english": "They dump what should be done, "
    },
    {
      "number": 3,
      "pali": "akiccaṁ pana karīyati; ",
      "english": "and do what should not be done. "
    },
    {
      "number": 4,
      "pali": "Unnaḷānaṁ pamattānaṁ, ",
      "english": "For the insolent and the negligent, "
    },
    {
      "number": 5,
      "pali": "tesaṁ vaḍḍhanti āsavā. ",
      "english": "their defilements only grow. "
    }
  ]
}