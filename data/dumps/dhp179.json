    {
      "number": 4,
      "pali": "Māradhītaravatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Yassa jitaṁ nāvajīyati, ",
      "english": "He whose victory may not be undone, "
    },
    {
      "number": 6,
      "pali": "Jitaṁ yassa noyāti koci loke; ",
      "english": "a victory unrivaled in all the world; "
    },
    {
      "number": 7,
      "pali": "Taṁ buddhamanantagocaraṁ, ",
      "english": "by what track would you trace that Buddha, "
    },
    {
      "number": 8,
      "pali": "Apadaṁ kena padena nessatha. ",
      "english": "who leaves no track in his infinite range? "
    }
  ]
