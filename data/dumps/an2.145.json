{
  "sutta_id": "AN2.145",
  "verses": [
    {
      "number": 1,
      "pali": "145 ",
      "english": "145 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, bhogā. ",
      "english": "“There are these two riches. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisabhogo ca dhammabhogo ca. ",
      "english": "Riches in things of the flesh and riches in the teaching. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve bhogā. ",
      "english": "These are the two riches. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ bhogānaṁ yadidaṁ dhammabhogo”ti. ",
      "english": "The better of these two riches is riches in the teaching.” "
    }
  ]
}