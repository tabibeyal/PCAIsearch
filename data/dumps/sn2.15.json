{
  "sutta_id": "SN2.15",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.15 ",
      "english": "Linked Discourses 2.15 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Candanasutta ",
      "english": "With Candana "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho candano devaputto bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, the godling Candana addressed the Buddha in verse: "
    },
    {
      "number": 5,
      "pali": "“Kathaṁsu tarati oghaṁ, ",
      "english": "“Who here crosses the flood, "
    },
    {
      "number": 6,
      "pali": "rattindivamatandito; ",
      "english": "tireless all day and night? "
    },
    {
      "number": 7,
      "pali": "Appatiṭṭhe anālambe, ",
      "english": "Who, not standing and unsupported, "
    },
    {
      "number": 8,
      "pali": "ko gambhīre na sīdatī”ti. ",
      "english": "does not sink in the deep?” "
    },
    {
      "number": 9,
      "pali": "“Sabbadā sīlasampanno, ",
      "english": "“Someone who is always endowed with ethics, "
    },
    {
      "number": 10,
      "pali": "Paññavā susamāhito; ",
      "english": "wise and serene, "
    },
    {
      "number": 11,
      "pali": "Āraddhavīriyo pahitatto, ",
      "english": "energetic and resolute, "
    },
    {
      "number": 12,
      "pali": "Oghaṁ tarati duttaraṁ. ",
      "english": "crosses the flood so hard to cross. "
    },
    {
      "number": 13,
      "pali": "Virato kāmasaññāya, ",
      "english": "Someone who desists from sensual perception, "
    },
    {
      "number": 14,
      "pali": "rūpasaṁyojanātigo; ",
      "english": "has moved past the fetter of form, "
    },
    {
      "number": 15,
      "pali": "Nandīrāgaparikkhīṇo, ",
      "english": "and has finished with relishing and greed "
    },
    {
      "number": 16,
      "pali": "so gambhīre na sīdatī”ti. ",
      "english": "does not sink in the deep.” "
    }
  ]
}