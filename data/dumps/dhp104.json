{
  "sutta_id": "DHP104",
  "verses": [
    {
      "number": 1,
      "pali": "Anatthapucchakabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attā have jitaṁ seyyo, ",
      "english": "It is surely better to conquer oneself "
    },
    {
      "number": 3,
      "pali": "yā cāyaṁ itarā pajā; ",
      "english": "than all those other folk. "
    },
    {
      "number": 4,
      "pali": "Attadantassa posassa, ",
      "english": "When a person has tamed themselves, "
    },
    {
      "number": 5,
      "pali": "niccaṁ saññatacārino. ",
      "english": "always living restrained, "
    }
  ]
}