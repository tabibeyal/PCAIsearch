{
  "sutta_id": "DHP367",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcaggadāyakabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbaso nāmarūpasmiṁ, ",
      "english": "One who has no sense of ownership "
    },
    {
      "number": 3,
      "pali": "yassa natthi mamāyitaṁ; ",
      "english": "in the whole realm of name and form, "
    },
    {
      "number": 4,
      "pali": "Asatā ca na socati, ",
      "english": "who does not grieve for that which is not, "
    },
    {
      "number": 5,
      "pali": "sa ve “bhikkhū”ti vuccati. ",
      "english": "is said to be a mendicant. "
    }
  ]
}