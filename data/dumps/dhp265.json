{
  "sutta_id": "DHP265",
  "verses": [
    {
      "number": 1,
      "pali": "Yo ca sameti pāpāni, ",
      "english": "One who stops all wicked deeds, "
    },
    {
      "number": 2,
      "pali": "aṇuṁthūlāni sabbaso; ",
      "english": "great and small, "
    },
    {
      "number": 3,
      "pali": "Samitattā hi pāpānaṁ, ",
      "english": "because of stopping wicked deeds "
    },
    {
      "number": 4,
      "pali": "“samaṇo”ti pavuccati. ",
      "english": "is said to be an ascetic. "
    }
  ]
}