{
  "sutta_id": "DHP27",
  "verses": [
    {
      "number": 1,
      "pali": "Mā pamādamanuyuñjetha, ",
      "english": "Don’t devote yourself to negligence, "
    },
    {
      "number": 2,
      "pali": "mā kāmaratisanthavaṁ; ",
      "english": "or delight in erotic intimacy. "
    },
    {
      "number": 3,
      "pali": "Appamatto hi jhāyanto, ",
      "english": "For if you’re diligent and meditate, "
    },
    {
      "number": 4,
      "pali": "pappoti vipulaṁ sukhaṁ. ",
      "english": "you’ll attain abundant happiness. "
    }
  ]
}