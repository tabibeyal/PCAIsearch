  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.194 ",
      "english": "Numbered Discourses 10.194 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Āsevitabbadhammasutta ",
      "english": "Principles That Should Be Cultivated "
    },
    {
      "number": 4,
      "pali": "“Āsevitabbañca vo, bhikkhave, dhammaṁ desessāmi nāsevitabbañca. ",
      "english": "“I will teach you the principle to cultivate and the principle not to cultivate. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, nāsevitabbo dhammo? ",
      "english": "And what is the principle not to cultivate? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, nāsevitabbo dhammo. ",
      "english": "This is called the principle not to cultivate. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, āsevitabbo dhammo? ",
      "english": "And what is the principle to cultivate? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, āsevitabbo dhammo”ti. ",
      "english": "This is called the principle to cultivate.” "
    },
    {
      "number": 14,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}