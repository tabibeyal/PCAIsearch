{
  "sutta_id": "KHP9",
  "verses": [
    {
      "number": 1,
      "pali": "Khuddakapatha 9",
      "english": "Khuddakapatha 9"
    },
    {
      "number": 2,
      "pali": "Karaṇīya Mettā Sutta",
      "english": "Goodwill"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This is to be done by one skilled in aims"
    },
    {
      "number": 4,
      "pali": "",
      "english": "appreciating the state of peace:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "Be capable, upright, & straightforward,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "easy to instruct, gentle, & not conceited,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "content & easy to support,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "with few duties, living lightly,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "with peaceful faculties, astute,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "modest, & no greed for supporters."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Do not do the slightest thing"
    },
    {
      "number": 12,
      "pali": "",
      "english": "that the observant would later censure."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Think: Happy, at rest,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "may all beings be happy at heart.",
      "section": "commentary"
    },
    {
      "number": 15,
      "pali": "",
      "english": "Whatever beings there may be—",
      "section": "commentary"
    },
    {
      "number": 16,
      "pali": "",
      "english": "weak or strong, without exception,",
      "section": "commentary"
    },
    {
      "number": 17,
      "pali": "",
      "english": "long, large,",
      "section": "commentary"
    },
    {
      "number": 18,
      "pali": "",
      "english": "middling, short,",
      "section": "commentary"
    },
    {
      "number": 19,
      "pali": "",
      "english": "subtle, gross,",
      "section": "commentary"
    },
    {
      "number": 20,
      "pali": "",
      "english": "seen & unseen,",
      "section": "commentary"
    },
    {
      "number": 21,
      "pali": "",
      "english": "living near & far away,",
      "section": "commentary"
    },
    {
      "number": 22,
      "pali": "",
      "english": "born or seeking birth:",
      "section": "commentary"
    },
    {
      "number": 23,
      "pali": "",
      "english": "May all beings be happy at heart.",
      "section": "commentary"
    },
    {
      "number": 24,
      "pali": "",
      "english": "Let no one deceive another"
    },
    {
      "number": 25,
      "pali": "",
      "english": "or despise anyone anywhere,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "or through anger or resistance-perception"
    },
    {
      "number": 27,
      "pali": "",
      "english": "wish for another to suffer."
    },
    {
      "number": 28,
      "pali": "",
      "english": "As a mother would risk her life"
    },
    {
      "number": 29,
      "pali": "",
      "english": "to protect her child, her only child,"
    },
    {
      "number": 30,
      "pali": "",
      "english": "even so should one cultivate the heart limitlessly"
    },
    {
      "number": 31,
      "pali": "",
      "english": "with regard to all beings."
    },
    {
      "number": 32,
      "pali": "",
      "english": "With goodwill for the entire cosmos,"
    },
    {
      "number": 33,
      "pali": "",
      "english": "cultivate the heart limitlessly:"
    },
    {
      "number": 34,
      "pali": "",
      "english": "above, below, & all around,"
    },
    {
      "number": 35,
      "pali": "",
      "english": "unobstructed, without hostility or hate."
    },
    {
      "number": 36,
      "pali": "",
      "english": "Whether standing, walking,"
    },
    {
      "number": 37,
      "pali": "",
      "english": "sitting, or lying down,"
    },
    {
      "number": 38,
      "pali": "",
      "english": "as long as one has banished torpor,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "one should be determined on this mindfulness."
    },
    {
      "number": 40,
      "pali": "",
      "english": "This is called a Brahmā abiding"
    },
    {
      "number": 41,
      "pali": "",
      "english": "here."
    },
    {
      "number": 42,
      "pali": "",
      "english": "Not taken with views,"
    },
    {
      "number": 43,
      "pali": "",
      "english": "but virtuous & consummate in vision,"
    },
    {
      "number": 44,
      "pali": "",
      "english": "having subdued greed for sensuality,"
    },
    {
      "number": 45,
      "pali": "",
      "english": "one never again"
    },
    {
      "number": 46,
      "pali": "",
      "english": "will lie in the womb."
    }
  ]
}