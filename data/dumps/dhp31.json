{
  "sutta_id": "DHP31",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamādarato bhikkhu, ",
      "english": "A mendicant who loves diligence, "
    },
    {
      "number": 3,
      "pali": "pamāde bhayadassi vā; ",
      "english": "seeing fear in negligence—"
    },
    {
      "number": 4,
      "pali": "Saṁyojanaṁ aṇuṁ thūlaṁ, ",
      "english": "advances like fire, "
    },
    {
      "number": 5,
      "pali": "ḍahaṁ aggīva gacchati. ",
      "english": "burning up fetters big and small. "
    }
  ]
}