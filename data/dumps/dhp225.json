{
  "sutta_id": "DHP225",
  "verses": [
    {
      "number": 1,
      "pali": "Buddhapitubrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ahiṁsakā ye munayo, ",
      "english": "Those harmless sages, "
    },
    {
      "number": 3,
      "pali": "niccaṁ kāyena saṁvutā; ",
      "english": "always restrained in body, "
    },
    {
      "number": 4,
      "pali": "Te yanti accutaṁ ṭhānaṁ, ",
      "english": "go to the state that does not pass, "
    },
    {
      "number": 5,
      "pali": "yattha gantvā na socare. ",
      "english": "where there is no sorrow. "
    }
  ]
}