{
  "sutta_id": "DHP159",
  "verses": [
    {
      "number": 1,
      "pali": "Padhānikatissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attānañce tathā kayirā, ",
      "english": "If one were to treat oneself "
    },
    {
      "number": 3,
      "pali": "yathāññamanusāsati; ",
      "english": "as one instructs another, "
    },
    {
      "number": 4,
      "pali": "Sudanto vata dametha, ",
      "english": "the well-tamed indeed would tame: "
    },
    {
      "number": 5,
      "pali": "attā hi kira duddamo. ",
      "english": "for the self, it seems, is hard to tame. "
    }
  ]
}