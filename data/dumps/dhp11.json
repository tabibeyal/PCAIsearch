{
  "sutta_id": "DHP11",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Asāre sāramatino, ",
      "english": "Thinking the inessential is essential, "
    },
    {
      "number": 3,
      "pali": "sāre cāsāradassino; ",
      "english": "seeing the essential as inessential; "
    },
    {
      "number": 4,
      "pali": "Te sāraṁ nādhigacchanti, ",
      "english": "they don’t realize the essential, "
    },
    {
      "number": 5,
      "pali": "micchāsaṅkappagocarā. ",
      "english": "for wrong thoughts are their habitat. "
    }
  ]
}