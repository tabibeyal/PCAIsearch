{
  "sutta_id": "AN8.75",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.75 ",
      "english": "Numbered Discourses 8.75 "
    },
    {
      "number": 2,
      "pali": "8. Yamakavagga ",
      "english": "8. Pairs "
    },
    {
      "number": 3,
      "pali": "Paṭhamasampadāsutta ",
      "english": "Accomplishments (1st) "
    },
    {
      "number": 4,
      "pali": "“Aṭṭhimā, bhikkhave, sampadā. ",
      "english": "“Mendicants, there are these eight accomplishments. "
    },
    {
      "number": 5,
      "pali": "Katamā aṭṭha? ",
      "english": "What eight? "
    },
    {
      "number": 6,
      "pali": "Uṭṭhānasampadā, ārakkhasampadā, kalyāṇamittatā, samajīvitā, saddhāsampadā, sīlasampadā, cāgasampadā, paññāsampadā—",
      "english": "Accomplishment in initiative, protection, good friendship, and balanced finances. And accomplishment in faith, ethics, generosity, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, aṭṭha sampadāti. ",
      "english": "These are the eight accomplishments. "
    },
    {
      "number": 8,
      "pali": "Uṭṭhātā kammadheyyesu, ",
      "english": "They’re enterprising in the workplace, "
    },
    {
      "number": 9,
      "pali": "appamatto vidhānavā; ",
      "english": "diligent in managing things, "
    },
    {
      "number": 10,
      "pali": "Samaṁ kappeti jīvikaṁ, ",
      "english": "they balance their finances, "
    },
    {
      "number": 11,
      "pali": "sambhataṁ anurakkhati. ",
      "english": "and preserve their wealth. "
    },
    {
      "number": 12,
      "pali": "Saddho sīlena sampanno, ",
      "english": "Faithful, accomplished in ethics, "
    },
    {
      "number": 13,
      "pali": "vadaññū vītamaccharo; ",
      "english": "bountiful, rid of stinginess, "
    },
    {
      "number": 14,
      "pali": "Niccaṁ maggaṁ visodheti, ",
      "english": "they always purify the path "
    },
    {
      "number": 15,
      "pali": "sotthānaṁ samparāyikaṁ. ",
      "english": "to well-being in lives to come. "
    },
    {
      "number": 16,
      "pali": "Iccete aṭṭha dhammā ca, ",
      "english": "And so these eight qualities "
    },
    {
      "number": 17,
      "pali": "saddhassa gharamesino; ",
      "english": "of a faithful householder of discernment "
    },
    {
      "number": 18,
      "pali": "Akkhātā saccanāmena, ",
      "english": "are declared by the one who is truly named "
    },
    {
      "number": 19,
      "pali": "ubhayattha sukhāvahā. ",
      "english": "to lead to happiness in both spheres, "
    },
    {
      "number": 20,
      "pali": "Diṭṭhadhammahitatthāya, ",
      "english": "welfare and benefit in this life, "
    },
    {
      "number": 21,
      "pali": "samparāyasukhāya ca; ",
      "english": "and happiness in lives to come. "
    },
    {
      "number": 22,
      "pali": "Evametaṁ gahaṭṭhānaṁ, ",
      "english": "This is how, for a householder, "
    },
    {
      "number": 23,
      "pali": "cāgo puññaṁ pavaḍḍhatī”ti. ",
      "english": "merit grows by generosity.” "
    },
    {
      "number": 24,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}