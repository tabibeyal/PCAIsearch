{
  "sutta_id": "DHP38",
  "verses": [
    {
      "number": 1,
      "pali": "Cittahatthattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Anavaṭṭhitacittassa, ",
      "english": "Those of unsteady mind, "
    },
    {
      "number": 3,
      "pali": "saddhammaṁ avijānato; ",
      "english": "who don’t understand the true teaching, "
    },
    {
      "number": 4,
      "pali": "Pariplavapasādassa, ",
      "english": "and whose confidence wavers, "
    },
    {
      "number": 5,
      "pali": "paññā na paripūrati. ",
      "english": "do not perfect their wisdom. "
    }
  ]
}