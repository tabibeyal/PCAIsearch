    {
      "number": 5,
      "pali": "Mattāsukhapariccāgā, ",
      "english": "If by giving up material happiness "
    },
    {
      "number": 6,
      "pali": "passe ce vipulaṁ sukhaṁ; ",
      "english": "one sees abundant happiness, "
    },
    {
