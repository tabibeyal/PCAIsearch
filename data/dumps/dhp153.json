{
  "sutta_id": "DHP153",
  "verses": [
    {
      "number": 1,
      "pali": "Udānavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Anekajātisaṁsāraṁ, ",
      "english": "Transmigrating through countless rebirths, "
    },
    {
      "number": 3,
      "pali": "sandhāvissaṁ anibbisaṁ; ",
      "english": "I’ve journeyed without reward, "
    },
    {
      "number": 4,
      "pali": "Gahakāraṁ gavesanto, ",
      "english": "searching for the house-builder; "
    },
    {
      "number": 5,
      "pali": "dukkhā jāti punappunaṁ. ",
      "english": "painful is birth again and again. "
    }
  ]
}