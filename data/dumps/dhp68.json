{
  "sutta_id": "DHP68",
  "verses": [
    {
      "number": 1,
      "pali": "Sumanamālākāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Tañca kammaṁ kataṁ sādhu, ",
      "english": "It is good to do a deed "
    },
    {
      "number": 3,
      "pali": "yaṁ katvā nānutappati; ",
      "english": "that doesn’t plague you later on, "
    },
    {
      "number": 4,
      "pali": "Yassa patīto sumano, ",
      "english": "that gladdens and cheers, "
    },
    {
      "number": 5,
      "pali": "vipākaṁ paṭisevati. ",
      "english": "as its effect stays with you. "
    }
  ]
}