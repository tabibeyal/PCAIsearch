    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Suvaṇṇanikkhasuttādiaṭṭhaka ",
      "english": "A Gold Ingot, Etc. "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Idhāhaṁ, bhikkhave, ekaccaṁ puggalaṁ evaṁ cetasā ceto paricca pajānāmi: ",
      "english": "“Mendicants, when I’ve comprehended the mind of a certain individual, I understand: "
    },
    {
      "number": 6,
      "pali": "‘na cāyamāyasmā suvaṇṇanikkhassāpi hetu …pe… ",
      "english": "‘This venerable would not tell a deliberate lie even for the sake of a gold ingot.’ …” "
    },
    {
      "number": 7,
      "pali": "suvaṇṇanikkhasatassāpi hetu … ",
      "english": "“‘… for the sake of a hundred gold ingots.’ …” "
    },
    {
      "number": 8,
      "pali": "siṅgīnikkhassāpi hetu … ",
      "english": "“‘… for the sake of a mountain of gold.’ …” "
    },
    {
      "number": 9,
      "pali": "siṅgīnikkhasatassāpi hetu … ",
      "english": "“‘… for the sake of a hundred mountains of gold.’ …” "
    },
    {
      "number": 10,
      "pali": "pathaviyāpi jātarūpaparipūrāya hetu … ",
      "english": "“‘… for the sake of the whole earth full of gold.’ …” "
    },
    {
      "number": 11,
      "pali": "āmisakiñcikkhahetupi … ",
      "english": "“‘… for any kind of material reward.’ …” "
    },
    {
      "number": 12,
      "pali": "jīvitahetupi … ",
      "english": "“‘… for the sake of life.’ …” "
    },
    {
      "number": 13,
      "pali": "janapadakalyāṇiyāpi hetu sampajānamusā bhāseyyā’ti. ",
      "english": "“‘… for the sake of the finest lady in the land.’ "
    },
    {
      "number": 14,
      "pali": "Tamenaṁ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṁ pariyādiṇṇacittaṁ sampajānamusā bhāsantaṁ. ",
      "english": "But some time later I see them tell a deliberate lie because their mind is overcome and overwhelmed by possessions, honor, and popularity. "
    },
    {
      "number": 15,
      "pali": "Evaṁ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "So grim are possessions, honor, and popularity. …” "
    },
    {
      "number": 16,
      "pali": "evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Dutiyo vaggo. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Dve pāti dve suvaṇṇā ca, ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Siṅgīhi apare duve; ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Pathavī kiñcikkhajīvitaṁ, ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Janapadakalyāṇiyā dasāti. ",
      "english": ""
    }
  ]
}