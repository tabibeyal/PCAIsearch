{
  "sutta_id": "ITI14",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 14 ",
      "english": "So It Was Said 14 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Avijjānīvaraṇasutta ",
      "english": "The Shroud of Ignorance "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Nāhaṁ, bhikkhave, aññaṁ ekanīvaraṇampi samanupassāmi yena nīvaraṇena nivutā pajā dīgharattaṁ sandhāvanti saṁsaranti yathayidaṁ, bhikkhave, avijjānīvaraṇaṁ. ",
      "english": "“Mendicants, I do not see a single shroud, shrouded by which people wander and transmigrate for a long time like the shroud of ignorance. "
    },
    {
      "number": 7,
      "pali": "Avijjānīvaraṇena hi, bhikkhave, nivutā pajā dīgharattaṁ sandhāvanti saṁsarantī”ti. ",
      "english": "Shrouded by ignorance, people wander and transmigrate for a long time.” "
    },
    {
      "number": 8,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 9,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 10,
      "pali": "“Natthañño ekadhammopi, ",
      "english": "“There is no other thing "
    },
    {
      "number": 11,
      "pali": "yenevaṁ nivutā pajā; ",
      "english": "that shrouds people like ignorance. "
    },
    {
      "number": 12,
      "pali": "Saṁsaranti ahorattaṁ, ",
      "english": "Veiled by delusion, "
    },
    {
      "number": 13,
      "pali": "yathā mohena āvutā. ",
      "english": "they transmigrate day and night. "
    },
    {
      "number": 14,
      "pali": "Ye ca mohaṁ pahantvāna, ",
      "english": "Those who have given up delusion, "
    },
    {
      "number": 15,
      "pali": "tamokhandhaṁ padālayuṁ; ",
      "english": "shattering the mass of darkness, "
    },
    {
      "number": 16,
      "pali": "Na te puna saṁsaranti, ",
      "english": "wander no more, "
    },
    {
      "number": 17,
      "pali": "hetu tesaṁ na vijjatī”ti. ",
      "english": "the root is not found in them.” "
    },
    {
      "number": 18,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 19,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}