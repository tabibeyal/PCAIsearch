  "sutta_id": "ITI14",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 14",
      "english": "Itivuttaka 14"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, I don’t envision even one other hindrance–hindered by which people go wandering & transmigrating on for a long, long time–like the hindrance of ignorance. Hindered by the hindrance of ignorance, people go wandering & transmigrating on for a long, long time.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "No one other thing"
    },
    {
      "number": 5,
      "pali": "",
      "english": "so hinders people"
    },
    {
      "number": 6,
      "pali": "",
      "english": "that they wander on, day & night,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "as when they’re obstructed"
    },
    {
      "number": 8,
      "pali": "",
      "english": "by delusion."
    },
    {
      "number": 9,
      "pali": "",
      "english": "But those who, letting go of delusion,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "shatter the mass of darkness,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "wander no further."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Their cause isn’t found."
    }
  ]
}