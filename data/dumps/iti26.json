{
  "sutta_id": "ITI26",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 26",
      "english": "Itivuttaka 26"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, if beings knew, as I know, the results of giving & sharing, they would not eat without having given, nor would the stain of selfishness overcome their minds. Even if it were their last bite, their last mouthful, they would not eat without having shared, if there were someone to receive their gift. But because beings do not know, as I know, the results of giving & sharing, they eat without having given. The stain of selfishness overcomes their minds.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "If beings knew"
    },
    {
      "number": 5,
      "pali": "",
      "english": "what the Great Seer said,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "how the result of sharing"
    },
    {
      "number": 7,
      "pali": "",
      "english": "has such great fruit,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "then, subduing the stain of selfishness"
    },
    {
      "number": 9,
      "pali": "",
      "english": "with brightened awareness,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "they’d give in season"
    },
    {
      "number": 11,
      "pali": "",
      "english": "to the noble ones,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "where a gift bears great fruit."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Having given food"
    },
    {
      "number": 14,
      "pali": "",
      "english": "as an offering"
    },
    {
      "number": 15,
      "pali": "",
      "english": "to those worthy of offerings,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "many donors,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "when they pass away from here,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "the human state,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "go"
    },
    {
      "number": 20,
      "pali": "",
      "english": "to heaven."
    },
    {
      "number": 21,
      "pali": "",
      "english": "They, having gone there"
    },
    {
      "number": 22,
      "pali": "",
      "english": "to heaven,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "rejoice,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "enjoying sensual pleasures."
    },
    {
      "number": 25,
      "pali": "",
      "english": "Unselfish, they"
    },
    {
      "number": 26,
      "pali": "",
      "english": "partake of the result"
    },
    {
      "number": 27,
      "pali": "",
      "english": "of sharing."
    }
  ]
}