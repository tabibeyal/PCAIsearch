{
  "sutta_id": "DHP213",
  "verses": [
    {
      "number": 1,
      "pali": "Visākhāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pemato jāyatī soko, ",
      "english": "Sorrow springs from attachment, "
    },
    {
      "number": 3,
      "pali": "pemato jāyatī bhayaṁ; ",
      "english": "fear springs from attachment; "
    },
    {
      "number": 4,
      "pali": "Pemato vippamuttassa, ",
      "english": "one free from attachment "
    },
    {
      "number": 5,
      "pali": "natthi soko kuto bhayaṁ. ",
      "english": "has no sorrow, let alone fear. "
    }
  ]
}