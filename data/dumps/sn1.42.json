{
  "sutta_id": "SN1.42",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.42 ",
      "english": "Linked Discourses 1.42 "
    },
    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Kiṁdadasutta ",
      "english": "Giving What? "
    },
    {
      "number": 4,
      "pali": "“Kiṁdado balado hoti, ",
      "english": "“Giving what do you give strength? "
    },
    {
      "number": 5,
      "pali": "kiṁdado hoti vaṇṇado; ",
      "english": "Giving what do you give beauty? "
    },
    {
      "number": 6,
      "pali": "Kiṁdado sukhado hoti, ",
      "english": "Giving what do you give happiness? "
    },
    {
      "number": 7,
      "pali": "kiṁdado hoti cakkhudo; ",
      "english": "Giving what do you give vision? "
    },
    {
      "number": 8,
      "pali": "Ko ca sabbadado hoti, ",
      "english": "And who is the giver of all? "
    },
    {
      "number": 9,
      "pali": "taṁ me akkhāhi pucchito”ti. ",
      "english": "Please answer my question.” "
    },
    {
      "number": 10,
      "pali": "“Annado balado hoti, ",
      "english": "“Giving food you give strength. "
    },
    {
      "number": 11,
      "pali": "vatthado hoti vaṇṇado; ",
      "english": "Giving clothes you give beauty. "
    },
    {
      "number": 12,
      "pali": "Yānado sukhado hoti, ",
      "english": "Giving a vehicle you give happiness. "
    },
    {
      "number": 13,
      "pali": "dīpado hoti cakkhudo. ",
      "english": "Giving a lamp you give vision. "
    },
    {
      "number": 14,
      "pali": "So ca sabbadado hoti, ",
      "english": "And the giver of all "
    },
    {
      "number": 15,
      "pali": "yo dadāti upassayaṁ; ",
      "english": "is the one who gives monastic quarters. "
    },
    {
      "number": 16,
      "pali": "Amataṁ dado ca so hoti, ",
      "english": "But one who teaches the Dhamma "
    },
    {
      "number": 17,
      "pali": "yo dhammamanusāsatī”ti. ",
      "english": "gives the gift of freedom from death.” "
    }
  ]
}