{
  "sutta_id": "SN1.42",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.42",
      "english": "Linked Discourses 1.42"
    },
    {
      "number": 2,
      "pali": "Kindada Sutta",
      "english": "A Giver of What"
    },
    {
      "number": 3,
      "pali": "",
      "english": "A deva:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“A giver of what is a giver of strength?"
    },
    {
      "number": 5,
      "pali": "",
      "english": "A giver of what, a giver of beauty?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "A giver of what, a giver of ease?"
    },
    {
      "number": 7,
      "pali": "",
      "english": "A giver of what, a giver of vision?"
    },
    {
      "number": 8,
      "pali": "",
      "english": "And who is a giver of everything?"
    },
    {
      "number": 9,
      "pali": "",
      "english": "Being asked, please explain this to me.”"
    },
    {
      "number": 10,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "“A giver of food is a giver of strength."
    },
    {
      "number": 12,
      "pali": "",
      "english": "A giver of clothes, a giver of beauty."
    },
    {
      "number": 13,
      "pali": "",
      "english": "A giver of a vehicle, a giver of ease."
    },
    {
      "number": 14,
      "pali": "",
      "english": "A giver of a lamp, a giver of vision."
    },
    {
      "number": 15,
      "pali": "",
      "english": "And the one who gives a residence"
    },
    {
      "number": 16,
      "pali": "",
      "english": "is the one who’s a giver of everything."
    },
    {
      "number": 17,
      "pali": "",
      "english": "But the one who teaches the Dhamma"
    },
    {
      "number": 18,
      "pali": "",
      "english": "is a giver of"
    },
    {
      "number": 19,
      "pali": "",
      "english": "the Deathless.”"
    }
  ]
}