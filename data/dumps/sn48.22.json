    {
      "number": 2,
      "pali": "3. Chaḷindriyavagga ",
      "english": "3. The Six Faculties "
    },
    {
      "number": 3,
      "pali": "Jīvitindriyasutta ",
      "english": "The Life Faculty "
    },
    {
      "number": 4,
      "pali": "“Tīṇimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these three faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Itthindriyaṁ, purisindriyaṁ, jīvitindriyaṁ—",
      "english": "The faculties of femininity, masculinity, and life. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, tīṇi indriyānī”ti. ",
      "english": "These are the three faculties.” "
    },
    {
      "number": 8,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
