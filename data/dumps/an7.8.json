{
  "sutta_id": "AN7.8",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.8 ",
      "english": "Numbered Discourses 7.8 "
    },
    {
      "number": 2,
      "pali": "1. Dhanavagga ",
      "english": "1. Wealth "
    },
    {
      "number": 3,
      "pali": "Saṁyojanasutta ",
      "english": "Fetters "
    },
    {
      "number": 4,
      "pali": "“Sattimāni, bhikkhave, saṁyojanāni. ",
      "english": "“Mendicants, there are these seven fetters. "
    },
    {
      "number": 5,
      "pali": "Katamāni satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Anunayasaṁyojanaṁ, paṭighasaṁyojanaṁ, diṭṭhisaṁyojanaṁ, vicikicchāsaṁyojanaṁ, mānasaṁyojanaṁ, bhavarāgasaṁyojanaṁ, avijjāsaṁyojanaṁ. ",
      "english": "The fetters of attraction, aversion, views, doubt, conceit, desire for continued existence, and ignorance. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, satta saṁyojanānī”ti. ",
      "english": "These are the seven fetters.” "
    },
    {
      "number": 8,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}