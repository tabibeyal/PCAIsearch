{
  "sutta_id": "DHP348",
  "verses": [
    {
      "number": 1,
      "pali": "Uggasenavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Muñca pure muñca pacchato, ",
      "english": "Let go of the past, let go of the future, "
    },
    {
      "number": 3,
      "pali": "Majjhe muñca bhavassa pāragū; ",
      "english": "let go of the present, having gone beyond rebirth. "
    },
    {
      "number": 4,
      "pali": "Sabbattha vimuttamānaso, ",
      "english": "With your heart freed in every respect, "
    },
    {
      "number": 5,
      "pali": "Na punaṁ jātijaraṁ upehisi. ",
      "english": "you’ll not come again to rebirth and old age. "
    }
  ]
}