{
  "sutta_id": "AN4.56",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.56 ",
      "english": "Numbered Discourses 4.56 "
    },
    {
      "number": 2,
      "pali": "6. Puññābhisandavagga ",
      "english": "6. Overflowing Merit "
    },
    {
      "number": 3,
      "pali": "Dutiyasamajīvīsutta ",
      "english": "Equality (2nd) "
    },
    {
      "number": 4,
      "pali": "“Ākaṅkheyyuñce, bhikkhave, ubho jānipatayo diṭṭhe ceva dhamme aññamaññaṁ passituṁ abhisamparāyañca aññamaññaṁ passituṁ ubhova assu samasaddhā samasīlā samacāgā samapaññā, te diṭṭhe ceva dhamme aññamaññaṁ passanti abhisamparāyañca aññamaññaṁ passantīti. ",
      "english": "“Mendicants, if wife and husband want to see each other in both this life and the next, they should be equals in faith, ethics, generosity, and wisdom. …” "
    },
    {
      "number": 5,
      "pali": "Ubho saddhā vadaññū ca, ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "saññatā dhammajīvino; ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Te honti jānipatayo, ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "aññamaññaṁ piyaṁvadā. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Atthāsaṁ pacurā honti, ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "phāsukaṁ upajāyati; ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Amittā dummanā honti, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "ubhinnaṁ samasīlinaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Idha dhammaṁ caritvāna, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "samasīlabbatā ubho; ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Nandino devalokasmiṁ, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "modanti kāmakāmino”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}