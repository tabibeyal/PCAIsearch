{
  "sutta_id": "DHP249",
  "verses": [
    {
      "number": 1,
      "pali": "Tissadaharavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dadāti ve yathāsaddhaṁ, ",
      "english": "The people give according to their faith, "
    },
    {
      "number": 3,
      "pali": "yathāpasādanaṁ jano; ",
      "english": "according to their confidence. "
    },
    {
      "number": 4,
      "pali": "Tattha yo ca maṅku bhavati, ",
      "english": "If you get upset over that, "
    },
    {
      "number": 5,
      "pali": "paresaṁ pānabhojane; ",
      "english": "over other’s food and drink, "
    },
    {
      "number": 6,
      "pali": "Na so divā vā rattiṁ vā, ",
      "english": "you’ll not, by day or by night, "
    },
    {
      "number": 7,
      "pali": "samādhimadhigacchati. ",
      "english": "become immersed in samādhi. "
    }
  ]
}