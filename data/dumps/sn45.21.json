{
  "sutta_id": "SN45.21",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.21 ",
      "english": "Linked Discourses 45.21 "
    },
    {
      "number": 2,
      "pali": "3. Micchattavagga ",
      "english": "3. The Wrong Way "
    },
    {
      "number": 3,
      "pali": "Micchattasutta ",
      "english": "The Wrong Way "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Micchattañca vo, bhikkhave, desessāmi, sammattañca. ",
      "english": "“Mendicants, I will teach you the wrong way and the right way. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, micchattaṁ? ",
      "english": "And what is the wrong way? "
    },
    {
      "number": 8,
      "pali": "Seyyathidaṁ—micchādiṭṭhi …pe… micchāsamādhi. ",
      "english": "It is wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, and wrong immersion. "
    },
    {
      "number": 9,
      "pali": "Idaṁ vuccati, bhikkhave, micchattaṁ. ",
      "english": "This is called the wrong way. "
    },
    {
      "number": 10,
      "pali": "Katamañca, bhikkhave, sammattaṁ? ",
      "english": "And what is the right way? "
    },
    {
      "number": 11,
      "pali": "Seyyathidaṁ—sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "It is right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 12,
      "pali": "Idaṁ vuccati, bhikkhave, sammattan”ti. ",
      "english": "This is called the right way.” "
    },
    {
      "number": 13,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}