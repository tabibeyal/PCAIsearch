{
  "sutta_id": "DHP59",
  "verses": [
    {
      "number": 1,
      "pali": "Evaṁ saṅkārabhūtesu, ",
      "english": "So too, among those thought of as trash, "
    },
    {
      "number": 2,
      "pali": "andhabhūte puthujjane; ",
      "english": "a disciple of the perfect Buddha "
    },
    {
      "number": 3,
      "pali": "Atirocati paññāya, ",
      "english": "outshines with their wisdom "
    },
    {
      "number": 4,
      "pali": "sammāsambuddhasāvako. ",
      "english": "the blind ordinary folk. "
    },
    {
      "number": 5,
      "pali": "Pupphavaggo catuttho. ",
      "english": ""
    }
  ]
}