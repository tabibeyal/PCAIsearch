{
  "sutta_id": "DHP108",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtatherassa sahāyakabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yaṁ kiñci yiṭṭhaṁ va hutaṁ va loke, ",
      "english": "Whatever sacrifice or offering in the world "
    },
    {
      "number": 3,
      "pali": "Saṁvaccharaṁ yajetha puññapekkho; ",
      "english": "a seeker of merit may make for a year, "
    },
    {
      "number": 4,
      "pali": "Sabbampi taṁ na catubhāgameti, ",
      "english": "none of it is worth a quarter "
    },
    {
      "number": 5,
      "pali": "Abhivādanā ujjugatesu seyyo. ",
      "english": "of bowing to the sincere. "
    }
  ]
}