{
  "sutta_id": "SN1.56",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.56",
      "english": "Linked Discourses 1.56"
    },
    {
      "number": 2,
      "pali": "Jana Sutta",
      "english": "Engendered (2)"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“What engenders a person?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "What does one have that runs around?"
    },
    {
      "number": 5,
      "pali": "",
      "english": "What rushes toward the wandering-on?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "From what is one not yet released?”"
    },
    {
      "number": 7,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“Craving engenders a person."
    },
    {
      "number": 9,
      "pali": "",
      "english": "One’s mind is what runs around."
    },
    {
      "number": 10,
      "pali": "",
      "english": "A being rushes toward the wandering-on."
    },
    {
      "number": 11,
      "pali": "",
      "english": "From suffering one’s not yet released.”"
    }
  ]
}