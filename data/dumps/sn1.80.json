{
  "sutta_id": "SN1.80",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.80 ",
      "english": "Linked Discourses 1.80 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Pajjotasutta ",
      "english": "Lamp "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu lokasmi pajjoto, ",
      "english": "“What’s the lamp for the world? "
    },
    {
      "number": 5,
      "pali": "kiṁsu lokasmi jāgaro; ",
      "english": "What in the world is wakeful? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu kamme sajīvānaṁ, ",
      "english": "Who are one’s work colleagues? "
    },
    {
      "number": 7,
      "pali": "kimassa iriyāpatho. ",
      "english": "What is one’s walk of life? "
    },
    {
      "number": 8,
      "pali": "Kiṁsu alasaṁ analasañca, ",
      "english": "What nurtures the idle and the tireless, "
    },
    {
      "number": 9,
      "pali": "Mātā puttaṁva posati; ",
      "english": "like a mother her child? "
    },
    {
      "number": 10,
      "pali": "Kiṁ bhūtā upajīvanti, ",
      "english": "By what do the creatures who live off the earth "
    },
    {
      "number": 11,
      "pali": "Ye pāṇā pathavissitā”ti. ",
      "english": "sustain their life?” "
    },
    {
      "number": 12,
      "pali": "“Paññā lokasmi pajjoto, ",
      "english": "“Wisdom is the lamp for the world. "
    },
    {
      "number": 13,
      "pali": "sati lokasmi jāgaro; ",
      "english": "Mindfulness in the world is wakeful. "
    },
    {
      "number": 14,
      "pali": "Gāvo kamme sajīvānaṁ, ",
      "english": "Cattle are one’s work colleagues, "
    },
    {
      "number": 15,
      "pali": "sītassa iriyāpatho. ",
      "english": "and the furrow is one’s walk of life. "
    },
    {
      "number": 16,
      "pali": "Vuṭṭhi alasaṁ analasañca, ",
      "english": "Rain nurtures the idle and the tireless, "
    },
    {
      "number": 17,
      "pali": "Mātā puttaṁva posati; ",
      "english": "like a mother her child. "
    },
    {
      "number": 18,
      "pali": "Vuṭṭhiṁ bhūtā upajīvanti, ",
      "english": "The creatures who live off the earth "
    },
    {
      "number": 19,
      "pali": "Ye pāṇā pathavissitā”ti. ",
      "english": "sustain their life by rain.” "
    }
  ]
}