    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Vāsudattasutta ",
      "english": "With Vāsudatta "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho vāsudatto devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Vāsudatta spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 5,
      "pali": "“Sattiyā viya omaṭṭho, ",
      "english": "“Like they’re struck by a sword, "
    },
    {
      "number": 6,
      "pali": "ḍayhamānova matthake; ",
      "english": "like their head was on fire, "
    },
    {
      "number": 7,
      "pali": "Kāmarāgappahānāya, ",
      "english": "a mendicant should wander mindful, "
    },
    {
      "number": 8,
      "pali": "sato bhikkhu paribbaje”ti. ",
      "english": "to give up sensual desire.” "
    },
    {
      "number": 9,
      "pali": "“Sattiyā viya omaṭṭho, ",
      "english": "“Like they’re struck by a sword, "
    },
    {
      "number": 10,
      "pali": "ḍayhamānova matthake; ",
      "english": "like their head was on fire, "
    },
    {
      "number": 11,
      "pali": "Sakkāyadiṭṭhippahānāya, ",
      "english": "a mendicant should wander mindful, "
    },
    {
      "number": 12,
      "pali": "sato bhikkhu paribbaje”ti. ",
      "english": "to give up substantialist view.” "
    }
  ]
