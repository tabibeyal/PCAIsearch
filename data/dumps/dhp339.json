{
  "sutta_id": "DHP339",
  "verses": [
    {
      "number": 1,
      "pali": "Yassa chattiṁsati sotā, ",
      "english": "A person of low views "
    },
    {
      "number": 2,
      "pali": "manāpasavanā bhusā; ",
      "english": "in whom the thirty-six streams "
    },
    {
      "number": 3,
      "pali": "Mahāvahanti duddiṭṭhiṁ, ",
      "english": "that flow to pleasure are mighty, "
    },
    {
      "number": 4,
      "pali": "saṅkappā rāganissitā. ",
      "english": "is swept away by lustful thoughts. "
    }
  ]
}