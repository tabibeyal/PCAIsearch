{
  "sutta_id": "DHP110",
  "verses": [
    {
      "number": 1,
      "pali": "Saṅkiccasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "dussīlo asamāhito; ",
      "english": "ethical and absorbed in meditation "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "sīlavantassa jhāyino. ",
      "english": "unethical and lacking immersion. "
    }
  ]
}