{
  "sutta_id": "SN1.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.6 ",
      "english": "Linked Discourses 1.6 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Jāgarasutta ",
      "english": "Awake "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Kati jāgarataṁ suttā, ",
      "english": "“How many sleep among the waking? "
    },
    {
      "number": 7,
      "pali": "kati suttesu jāgarā; ",
      "english": "How many wake among the sleeping? "
    },
    {
      "number": 8,
      "pali": "Katibhi rajamādeti, ",
      "english": "By how many do you gather dust? "
    },
    {
      "number": 9,
      "pali": "katibhi parisujjhatī”ti. ",
      "english": "By how many are you cleansed?” "
    },
    {
      "number": 10,
      "pali": "“Pañca jāgarataṁ suttā, ",
      "english": "“Five sleep among the waking. "
    },
    {
      "number": 11,
      "pali": "pañca suttesu jāgarā; ",
      "english": "Five wake among the sleeping. "
    },
    {
      "number": 12,
      "pali": "Pañcabhi rajamādeti, ",
      "english": "By five you gather dust. "
    },
    {
      "number": 13,
      "pali": "pañcabhi parisujjhatī”ti. ",
      "english": "By five you’re cleansed.” "
    }
  ]
}