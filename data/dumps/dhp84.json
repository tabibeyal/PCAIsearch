{
  "sutta_id": "DHP84",
  "verses": [
    {
      "number": 1,
      "pali": "Dhammikattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na attahetu na parassa hetu, ",
      "english": "Never wish for success by unjust means, "
    },
    {
      "number": 3,
      "pali": "Na puttamicche na dhanaṁ na raṭṭhaṁ; ",
      "english": "for your own sake or that of another, "
    },
    {
      "number": 4,
      "pali": "Na iccheyya adhammena samiddhimattano, ",
      "english": "desiring children, wealth, or nation; "
    },
    {
      "number": 5,
      "pali": "Sa sīlavā paññavā dhammiko siyā. ",
      "english": "rather, be virtuous, wise, and just. "
    }
  ]
}