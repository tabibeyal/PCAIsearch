{
  "sutta_id": "DHP400",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akkodhanaṁ vatavantaṁ, ",
      "english": "Not irritable or pretentious, "
    },
    {
      "number": 3,
      "pali": "sīlavantaṁ anussadaṁ; ",
      "english": "dutiful in precepts and observances, "
    },
    {
      "number": 4,
      "pali": "Dantaṁ antimasārīraṁ, ",
      "english": "tamed, bearing their final body: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}