{
  "sutta_id": "DHP105",
  "verses": [
    {
      "number": 1,
      "pali": "Neva devo na gandhabbo, ",
      "english": "no god nor centaur, "
    },
    {
      "number": 2,
      "pali": "na māro saha brahmunā; ",
      "english": "nor Māra nor divinity, "
    },
    {
      "number": 3,
      "pali": "Jitaṁ apajitaṁ kayirā, ",
      "english": "can undo the victory "
    },
    {
      "number": 4,
      "pali": "tathārūpassa jantuno. ",
      "english": "of such a personage. "
    }
  ]
}