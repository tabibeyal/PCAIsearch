{
  "sutta_id": "DHP42",
  "verses": [
    {
      "number": 1,
      "pali": "Nandagopālakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Diso disaṁ yaṁ taṁ kayirā, ",
      "english": "A wrongly directed mind "
    },
    {
      "number": 3,
      "pali": "verī vā pana verinaṁ; ",
      "english": "would do you more harm "
    },
    {
      "number": 4,
      "pali": "Micchāpaṇihitaṁ cittaṁ, ",
      "english": "than a hater to the hated, "
    },
    {
      "number": 5,
      "pali": "pāpiyo naṁ tato kare. ",
      "english": "or an enemy to their foe. "
    }
  ]
}