{
  "sutta_id": "SN1.71",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.71",
      "english": "Linked Discourses 1.71"
    },
    {
      "number": 2,
      "pali": "Chetvā Sutta",
      "english": "Having Killed"
    },
    {
      "number": 3,
      "pali": "",
      "english": "As she was standing to one side, a devatā recited this verse to the Blessed One:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Having killed what"
    },
    {
      "number": 5,
      "pali": "",
      "english": "do you sleep in ease?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "Having killed what"
    },
    {
      "number": 7,
      "pali": "",
      "english": "do you not grieve?"
    },
    {
      "number": 8,
      "pali": "",
      "english": "Of the slaying"
    },
    {
      "number": 9,
      "pali": "",
      "english": "of what one thing"
    },
    {
      "number": 10,
      "pali": "",
      "english": "does Gotama approve?”"
    },
    {
      "number": 11,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "“Having killed anger"
    },
    {
      "number": 13,
      "pali": "",
      "english": "you sleep in ease."
    },
    {
      "number": 14,
      "pali": "",
      "english": "Having killed anger"
    },
    {
      "number": 15,
      "pali": "",
      "english": "you do not grieve."
    },
    {
      "number": 16,
      "pali": "",
      "english": "The noble ones praise"
    },
    {
      "number": 17,
      "pali": "",
      "english": "the slaying of anger"
    },
    {
      "number": 18,
      "pali": "",
      "english": "—with its honeyed crest"
    },
    {
      "number": 19,
      "pali": "",
      "english": "& poison root—"
    },
    {
      "number": 20,
      "pali": "",
      "english": "for having killed it"
    },
    {
      "number": 21,
      "pali": "",
      "english": "you do not grieve.”"
    }
  ]
}