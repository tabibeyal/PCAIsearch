{
  "sutta_id": "SN1.71",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.71 ",
      "english": "Linked Discourses 1.71 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Chetvāsutta ",
      "english": "Slain "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, that deity addressed the Buddha in verse: "
    },
    {
      "number": 6,
      "pali": "“Kiṁsu chetvā sukhaṁ seti, ",
      "english": "“When what is slain do you sleep at ease? "
    },
    {
      "number": 7,
      "pali": "kiṁsu chetvā na socati; ",
      "english": "When what is slain is there no sorrow? "
    },
    {
      "number": 8,
      "pali": "Kissassu ekadhammassa, ",
      "english": "What’s the one thing, Gotama, "
    },
    {
      "number": 9,
      "pali": "vadhaṁ rocesi gotamā”ti. ",
      "english": "whose killing you approve?” "
    },
    {
      "number": 10,
      "pali": "“Kodhaṁ chetvā sukhaṁ seti, ",
      "english": "“When anger’s slain you sleep at ease. "
    },
    {
      "number": 11,
      "pali": "kodhaṁ chetvā na socati; ",
      "english": "When anger’s slain there is no sorrow. "
    },
    {
      "number": 12,
      "pali": "Kodhassa visamūlassa, ",
      "english": "O deity, anger has a poisonous root "
    },
    {
      "number": 13,
      "pali": "madhuraggassa devate; ",
      "english": "and a sweet tip. "
    },
    {
      "number": 14,
      "pali": "Vadhaṁ ariyā pasaṁsanti, ",
      "english": "The noble ones praise its killing, "
    },
    {
      "number": 15,
      "pali": "tañhi chetvā na socatī”ti. ",
      "english": "for when it’s slain there is no sorrow.” "
    }
  ]
}