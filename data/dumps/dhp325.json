{
  "sutta_id": "DHP325",
  "verses": [
    {
      "number": 1,
      "pali": "Pasenadikosalavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Middhī yadā hoti mahagghaso ca, ",
      "english": "One who gets drowsy from overeating, "
    },
    {
      "number": 3,
      "pali": "Niddāyitā samparivattasāyī; ",
      "english": "fond of sleep, rolling round the bed "
    },
    {
      "number": 4,
      "pali": "Mahāvarāhova nivāpapuṭṭho, ",
      "english": "like a great hog stuffed with grain: "
    },
    {
      "number": 5,
      "pali": "Punappunaṁ gabbhamupeti mando. ",
      "english": "that dullard returns to the womb again and again. "
    }
  ]
}