{
  "sutta_id": "DHP95",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pathavisamo no virujjhati, ",
      "english": "Undisturbed like the earth, "
    },
    {
      "number": 3,
      "pali": "Indakhilupamo tādi subbato; ",
      "english": "true to their vows, steady as Indra’s pillar, "
    },
    {
      "number": 4,
      "pali": "Rahadova apetakaddamo, ",
      "english": "like a lake clear of mud; "
    },
    {
      "number": 5,
      "pali": "Saṁsārā na bhavanti tādino. ",
      "english": "such a one does not transmigrate. "
    }
  ]
}