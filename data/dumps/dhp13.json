{
  "sutta_id": "DHP13",
  "verses": [
    {
      "number": 1,
      "pali": "Nandattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathā agāraṁ ducchannaṁ, ",
      "english": "Just as rain seeps into "
    },
    {
      "number": 3,
      "pali": "vuṭṭhī samativijjhati; ",
      "english": "a poorly roofed house, "
    },
    {
      "number": 4,
      "pali": "Evaṁ abhāvitaṁ cittaṁ, ",
      "english": "lust seeps into "
    },
    {
      "number": 5,
      "pali": "rāgo samativijjhati. ",
      "english": "an undeveloped mind. "
    }
  ]
}