{
  "sutta_id": "DHP307",
  "verses": [
    {
      "number": 1,
      "pali": "Duccaritaphalapīḷitavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kāsāvakaṇṭhā bahavo, ",
      "english": "Many who wear a scrap of ocher cloth "
    },
    {
      "number": 3,
      "pali": "pāpadhammā asaññatā; ",
      "english": "are unrestrained and wicked. "
    },
    {
      "number": 4,
      "pali": "Pāpā pāpehi kammehi, ",
      "english": "Being wicked, they are reborn in hell "
    },
    {
      "number": 5,
      "pali": "nirayaṁ te upapajjare. ",
      "english": "due to their bad deeds. "
    }
  ]
}