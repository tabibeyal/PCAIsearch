  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 3.108 ",
      "english": "Numbered Discourses 3.108 "
    },
    {
      "number": 2,
      "pali": "11. Sambodhavagga ",
      "english": "11. Awakening "
    },
    {
      "number": 3,
      "pali": "Atittisutta ",
      "english": "Satisfaction "
    },
    {
      "number": 4,
      "pali": "“Tiṇṇaṁ, bhikkhave, paṭisevanāya natthi titti. ",
      "english": "“Mendicants, there are three indulgences that never satisfy. "
    },
    {
      "number": 5,
      "pali": "Katamesaṁ tiṇṇaṁ? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Soppassa, bhikkhave, paṭisevanāya natthi titti. ",
      "english": "Sleep, "
    },
    {
      "number": 7,
      "pali": "Surāmerayapānassa, bhikkhave, paṭisevanāya natthi titti. ",
      "english": "drinking beer and wine, "
    },
    {
      "number": 8,
      "pali": "Methunadhammasamāpattiyā, bhikkhave, paṭisevanāya natthi titti. ",
      "english": "and sexual intercourse. "
    },
    {
      "number": 9,
      "pali": "Imesaṁ, bhikkhave, tiṇṇaṁ paṭisevanāya natthi tittī”ti. ",
      "english": "These are the three indulgences that never satisfy.” "
    },
    {
      "number": 10,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}