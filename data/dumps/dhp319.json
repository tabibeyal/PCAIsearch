{
  "sutta_id": "DHP319",
  "verses": [
    {
      "number": 1,
      "pali": "Vajjañca vajjato ñatvā, ",
      "english": "Knowing a fault as a fault "
    },
    {
      "number": 2,
      "pali": "avajjañca avajjato; ",
      "english": "and the faultless as faultless, "
    },
    {
      "number": 3,
      "pali": "Sammādiṭṭhisamādānā, ",
      "english": "beings who uphold right view "
    },
    {
      "number": 4,
      "pali": "sattā gacchanti suggatiṁ. ",
      "english": "go to a good place. "
    },
    {
      "number": 5,
      "pali": "Nirayavaggo dvāvīsatimo. ",
      "english": ""
    }
  ]
}