{
  "sutta_id": "DHP62",
  "verses": [
    {
      "number": 1,
      "pali": "Ānandaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Puttā matthi dhanaṁ matthi, ",
      "english": "“Sons are mine, wealth is mine”—"
    },
    {
      "number": 3,
      "pali": "iti bālo vihaññati; ",
      "english": "thus the fool frets. "
    },
    {
      "number": 4,
      "pali": "Attā hi attano natthi, ",
      "english": "For even your self is not your own, "
    },
    {
      "number": 5,
      "pali": "kuto puttā kuto dhanaṁ. ",
      "english": "let alone your sons or wealth. "
    }
  ]
}