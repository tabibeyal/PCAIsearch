{
  "sutta_id": "AN2.128",
  "verses": [
    {
      "number": 1,
      "pali": "128 ",
      "english": "128 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, āpattiyo. ",
      "english": "“There are these two offenses. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Duṭṭhullā ca āpatti, aduṭṭhullā ca āpatti. ",
      "english": "An offense with corrupt intention and an offense without corrupt intention. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve āpattiyo”ti. ",
      "english": "These are the two offenses.” "
    }
  ]
}