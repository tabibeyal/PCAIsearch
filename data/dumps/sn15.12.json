{
  "sutta_id": "SN15.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 15.12 ",
      "english": "Linked Discourses 15.12 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Sukhitasutta ",
      "english": "In a Good Way "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Anamataggoyaṁ, bhikkhave, saṁsāro …pe… ",
      "english": "“Mendicants, this transmigration has no known beginning. … "
    },
    {
      "number": 6,
      "pali": "yaṁ, bhikkhave, passeyyātha sukhitaṁ susajjitaṁ, niṭṭhamettha gantabbaṁ: ",
      "english": "When you see someone in a good way, in a happy state, you should conclude: "
    },
    {
      "number": 7,
      "pali": "‘amhehipi evarūpaṁ paccanubhūtaṁ iminā dīghena addhunā’ti. ",
      "english": "‘In all this long time, we too have undergone the same thing.’ "
    },
    {
      "number": 8,
      "pali": "Taṁ kissa hetu? ",
      "english": "Why is that? "
    },
    {
      "number": 9,
      "pali": "Anamataggoyaṁ, bhikkhave, saṁsāro. ",
      "english": "This transmigration has no known beginning. … "
    },
    {
      "number": 10,
      "pali": "Pubbā koṭi na paññāyati …pe… ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "alaṁ vimuccitun”ti. ",
      "english": "This is quite enough for you to become disillusioned, dispassionate, and freed regarding all conditions.” "
    },
    {
      "number": 12,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}