{
  "sutta_id": "DHP342",
  "verses": [
    {
      "number": 1,
      "pali": "Tasiṇāya purakkhatā pajā, ",
      "english": "People governed by thirst, "
    },
    {
      "number": 2,
      "pali": "Parisappanti sasova bandhito; ",
      "english": "crawl about like a trapped rabbit. "
    },
    {
      "number": 3,
      "pali": "Saṁyojanasaṅgasattakā, ",
      "english": "Bound and fettered, for a long time "
    },
    {
      "number": 4,
      "pali": "Dukkhamupenti punappunaṁ cirāya. ",
      "english": "they return to pain time and again. "
    }
  ]
}