{
  "sutta_id": "DHP195",
  "verses": [
    {
      "number": 1,
      "pali": "Kassapadasabalassasuvaṇṇacetiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pūjārahe pūjayato, ",
      "english": "When a person venerates the worthy—"
    },
    {
      "number": 3,
      "pali": "buddhe yadi va sāvake; ",
      "english": "the Buddha or his disciple, "
    },
    {
      "number": 4,
      "pali": "Papañcasamatikkante, ",
      "english": "who have transcended proliferation, "
    },
    {
      "number": 5,
      "pali": "tiṇṇasokapariddave. ",
      "english": "and have left behind grief and lamentation, "
    }
  ]
}