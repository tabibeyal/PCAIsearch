{
  "sutta_id": "DHP365",
  "verses": [
    {
      "number": 1,
      "pali": "Vipakkhasevakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Salābhaṁ nātimaññeyya, ",
      "english": "A well-off mendicant ought not look down "
    },
    {
      "number": 3,
      "pali": "nāññesaṁ pihayaṁ care; ",
      "english": "on others, nor should they be envious. "
    },
    {
      "number": 4,
      "pali": "Aññesaṁ pihayaṁ bhikkhu, ",
      "english": "A mendicant who envies others "
    },
    {
      "number": 5,
      "pali": "samādhiṁ nādhigacchati. ",
      "english": "does not achieve immersion. "
    }
  ]
}