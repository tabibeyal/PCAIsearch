    {
      "number": 3,
      "pali": "Malavagga ",
      "english": "18. Stains "
    },
    {
      "number": 4,
      "pali": "Goghātakaputtavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Paṇḍupalāsova dānisi, ",
      "english": "Today you’re like a withered leaf, "
    },
    {
      "number": 6,
      "pali": "Yamapurisāpi ca te upaṭṭhitā; ",
      "english": "Yama’s men await you. "
    },
    {
      "number": 7,
      "pali": "Uyyogamukhe ca tiṭṭhasi, ",
      "english": "You stand at the departure gates, "
    },
    {
      "number": 8,
      "pali": "Pātheyyampi ca te na vijjati. ",
      "english": "yet you have no supplies for the road. "
    }
  ]
}