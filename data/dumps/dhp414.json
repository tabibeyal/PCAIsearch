{
  "sutta_id": "DHP414",
  "verses": [
    {
      "number": 1,
      "pali": "Sīvalittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yomaṁ palipathaṁ duggaṁ, ",
      "english": "They’ve got past this grueling swamp "
    },
    {
      "number": 3,
      "pali": "saṁsāraṁ mohamaccagā; ",
      "english": "of delusion, transmigration. "
    },
    {
      "number": 4,
      "pali": "Tiṇṇo pāraṅgato jhāyī, ",
      "english": "Meditating in stillness, free of indecision, "
    },
    {
      "number": 5,
      "pali": "anejo akathaṅkathī; ",
      "english": "they have crossed over to the far shore. "
    },
    {
      "number": 6,
      "pali": "Anupādāya nibbuto, ",
      "english": "They’re quenched by not grasping: "
    },
    {
      "number": 7,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}