{
  "sutta_id": "AN4.253",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.253 ",
      "english": "Numbered Discourses 4.253 "
    },
    {
      "number": 2,
      "pali": "25. Āpattibhayavagga ",
      "english": "25. Perils of Offenses "
    },
    {
      "number": 3,
      "pali": "Catutthavohārasutta ",
      "english": "Expressions (4th) "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, ariyavohārā. ",
      "english": "“Mendicants, there are these four noble expressions. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Diṭṭhe diṭṭhavāditā, sute sutavāditā, mute mutavāditā, viññāte viññātavāditā—",
      "english": "Saying you’ve seen, heard, thought, or known something, and you have. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro ariyavohārā”ti. ",
      "english": "These are the four noble expressions.” "
    },
    {
      "number": 8,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Āpattibhayavaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Bhedaāpatti sikkhā ca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "seyyā thūpārahena ca; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Paññāvuddhi bahukārā, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "vohārā caturo ṭhitāti. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Pañcamo paṇṇāsako samatto. ",
      "english": ""
    }
  ]
}