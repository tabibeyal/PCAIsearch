  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 64",
      "english": "Itivuttaka 64"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three kinds of misconduct. Which three? Bodily misconduct, verbal misconduct, mental misconduct. These are the three kinds of misconduct.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Having engaged"
    },
    {
      "number": 5,
      "pali": "",
      "english": "in bodily misconduct,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "acts of verbal misconduct,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "misconduct of mind,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "or whatever else is flawed,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "not having done what is skillful,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "having done much that is not,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "at the break-up of the body,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "the undiscerning one reappears in"
    },
    {
      "number": 13,
      "pali": "",
      "english": "hell."
    }
  ]
}