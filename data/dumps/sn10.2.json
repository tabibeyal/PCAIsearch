{
  "sutta_id": "SN10.2",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 10.2 ",
      "english": "Linked Discourses 10.2 "
    },
    {
      "number": 2,
      "pali": "1. Indakavagga ",
      "english": "1. With Indaka "
    },
    {
      "number": 3,
      "pali": "Sakkanāmasutta ",
      "english": "Sakka In Name Only "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
      "english": "At one time the Buddha was staying near Rājagaha, on the Vulture’s Peak Mountain. "
    },
    {
      "number": 5,
      "pali": "Atha kho sakkanāmako yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Then a spirit who was Sakka in name only went up to the Buddha, and addressed him in verse: "
    },
    {
      "number": 6,
      "pali": "“Sabbaganthappahīnassa, ",
      "english": "“You’ve given up all ties, "
    },
    {
      "number": 7,
      "pali": "vippamuttassa te sato; ",
      "english": "and are fully freed. "
    },
    {
      "number": 8,
      "pali": "Samaṇassa na taṁ sādhu, ",
      "english": "It’s not a good idea for you, ascetic, "
    },
    {
      "number": 9,
      "pali": "yadaññamanusāsasī”ti. ",
      "english": "to be instructing others.” "
    },
    {
      "number": 10,
      "pali": "“Yena kenaci vaṇṇena, ",
      "english": "“No matter how you explain why "
    },
    {
      "number": 11,
      "pali": "saṁvāso sakka jāyati; ",
      "english": "people gather together, Sakka, "
    },
    {
      "number": 12,
      "pali": "Na taṁ arahati sappañño, ",
      "english": "it’s unworthy for a wise person "
    },
    {
      "number": 13,
      "pali": "manasā anukampituṁ. ",
      "english": "not to think of the other with sympathy. "
    },
    {
      "number": 14,
      "pali": "Manasā ce pasannena, ",
      "english": "If you instruct others "
    },
    {
      "number": 15,
      "pali": "yadaññamanusāsati; ",
      "english": "with a mind clear and confident, "
    },
    {
      "number": 16,
      "pali": "Na tena hoti saṁyutto, ",
      "english": "your compassion and empathy "
    },
    {
      "number": 17,
      "pali": "yānukampā anuddayā”ti. ",
      "english": "don’t create attachments.” "
    }
  ]
}