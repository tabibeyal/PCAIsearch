{
  "sutta_id": "DHP233",
  "verses": [
    {
      "number": 1,
      "pali": "Manopakopaṁ rakkheyya, ",
      "english": "Guard against ill-tempered thoughts, "
    },
    {
      "number": 2,
      "pali": "manasā saṁvuto siyā; ",
      "english": "be restrained in mind. "
    },
    {
      "number": 3,
      "pali": "Manoduccaritaṁ hitvā, ",
      "english": "Giving up bad mental conduct, "
    },
    {
      "number": 4,
      "pali": "manasā sucaritaṁ care. ",
      "english": "conduct yourself well in mind. "
    }
  ]
}