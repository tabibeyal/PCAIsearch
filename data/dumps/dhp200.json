{
  "sutta_id": "DHP200",
  "verses": [
    {
      "number": 1,
      "pali": "Māravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Susukhaṁ vata jīvāma, ",
      "english": "Let us live so very happily, "
    },
    {
      "number": 3,
      "pali": "yesaṁ no natthi kiñcanaṁ; ",
      "english": "we who have nothing. "
    },
    {
      "number": 4,
      "pali": "Pītibhakkhā bhavissāma, ",
      "english": "We shall feed on rapture, "
    },
    {
      "number": 5,
      "pali": "devā ābhassarā yathā. ",
      "english": "like the gods of streaming radiance. "
    }
  ]
}