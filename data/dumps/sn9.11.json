{
  "sutta_id": "SN9.11",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 9.11",
      "english": "Linked Discourses 9.11"
    },
    {
      "number": 2,
      "pali": "Ayoniso-manasikāra Sutta",
      "english": "Inappropriate Attention"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that on one occasion a certain monk was staying among the Kosalans in a forest grove. Now at that time, he spent the day’s abiding thinking evil, unskillful thoughts: i.e., thoughts of sensuality, thoughts of ill will, thoughts of doing harm."
    },
    {
      "number": 4,
      "pali": "",
      "english": "Then the devatā inhabiting the forest grove, feeling sympathy for the monk, desiring his benefit, desiring to bring him to his senses, approached him and addressed him with this verse:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“From inappropriate attention"
    },
    {
      "number": 6,
      "pali": "",
      "english": "you’re being chewed by your thoughts."
    },
    {
      "number": 7,
      "pali": "",
      "english": "Relinquishing what’s inappropriate,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "contemplate"
    },
    {
      "number": 9,
      "pali": "",
      "english": "appropriately."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Keeping your mind on the Teacher,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "the Dhamma, the Saṅgha, your virtues,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "you will arrive at"
    },
    {
      "number": 13,
      "pali": "",
      "english": "joy,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "rapture,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "pleasure"
    },
    {
      "number": 16,
      "pali": "",
      "english": "without doubt."
    },
    {
      "number": 17,
      "pali": "",
      "english": "Then, saturated"
    },
    {
      "number": 18,
      "pali": "",
      "english": "with joy,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "you will put an end"
    },
    {
      "number": 20,
      "pali": "",
      "english": "to suffering & stress.”"
    },
    {
      "number": 21,
      "pali": "",
      "english": "The monk, chastened by the devatā, came to his senses."
    }
  ]
}