{
  "sutta_id": "DHP323",
  "verses": [
    {
      "number": 1,
      "pali": "Hatthācariyapubbakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na hi etehi yānehi, ",
      "english": "For not on those mounts "
    },
    {
      "number": 3,
      "pali": "gaccheyya agataṁ disaṁ; ",
      "english": "would you go to the untrodden place, "
    },
    {
      "number": 4,
      "pali": "Yathāttanā sudantena, ",
      "english": "whereas, with the help of one <j>whose self is well tamed, "
    },
    {
      "number": 5,
      "pali": "danto dantena gacchati. ",
      "english": "you go there, tamed by the tamed. "
    }
  ]
}