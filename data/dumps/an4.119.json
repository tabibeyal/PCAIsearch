  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.119 ",
      "english": "Numbered Discourses 4.119 "
    },
    {
      "number": 2,
      "pali": "12. Kesivagga ",
      "english": "12. With Kesi "
    },
    {
      "number": 3,
      "pali": "Paṭhamabhayasutta ",
      "english": "Perils (1st) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, bhayāni. ",
      "english": "“Mendicants, there are these four perils. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Jātibhayaṁ, jarābhayaṁ, byādhibhayaṁ, maraṇabhayaṁ—",
      "english": "The perils of rebirth, old age, sickness, and death. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri bhayānī”ti. ",
      "english": "These are the four perils.” "
    },
    {
      "number": 8,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}