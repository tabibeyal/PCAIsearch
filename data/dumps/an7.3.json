{
  "sutta_id": "AN7.3",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.3 ",
      "english": "Numbered Discourses 7.3 "
    },
    {
      "number": 2,
      "pali": "1. Dhanavagga ",
      "english": "1. Wealth "
    },
    {
      "number": 3,
      "pali": "Saṅkhittabalasutta ",
      "english": "Powers in Brief "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme …pe… ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. … "
    },
    {
      "number": 6,
      "pali": "sattimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these seven powers. "
    },
    {
      "number": 7,
      "pali": "Katamāni satta? ",
      "english": "What seven? "
    },
    {
      "number": 8,
      "pali": "Saddhābalaṁ, vīriyabalaṁ, hirībalaṁ, ottappabalaṁ, satibalaṁ, samādhibalaṁ, paññābalaṁ. ",
      "english": "The powers of faith, energy, conscience, prudence, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 9,
      "pali": "Imāni kho, bhikkhave, satta balānīti. ",
      "english": "These are the seven powers. "
    },
    {
      "number": 10,
      "pali": "Saddhābalaṁ vīriyañca, ",
      "english": "The powers are faith and energy, "
    },
    {
      "number": 11,
      "pali": "hirī ottappiyaṁ balaṁ; ",
      "english": "conscience and prudence, "
    },
    {
      "number": 12,
      "pali": "Satibalaṁ samādhi ca, ",
      "english": "mindfulness and immersion, "
    },
    {
      "number": 13,
      "pali": "paññā ve sattamaṁ balaṁ; ",
      "english": "and wisdom as the seventh power. "
    },
    {
      "number": 14,
      "pali": "Etehi balavā bhikkhu, ",
      "english": "Empowered by these, "
    },
    {
      "number": 15,
      "pali": "sukhaṁ jīvati paṇḍito. ",
      "english": "an astute mendicant lives happily. "
    },
    {
      "number": 16,
      "pali": "Yoniso vicine dhammaṁ, ",
      "english": "They should examine the teaching rationally, "
    },
    {
      "number": 17,
      "pali": "paññāyatthaṁ vipassati; ",
      "english": "discerning the meaning with wisdom. "
    },
    {
      "number": 18,
      "pali": "Pajjotasseva nibbānaṁ, ",
      "english": "The liberation of their heart "
    },
    {
      "number": 19,
      "pali": "vimokkho hoti cetaso”ti. ",
      "english": "is like a lamp going out.” "
    },
    {
      "number": 20,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}