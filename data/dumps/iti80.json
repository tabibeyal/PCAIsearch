{
  "sutta_id": "ITI80",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 80 ",
      "english": "So It Was Said 80 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Catutthavagga ",
      "english": "Chapter Four "
    },
    {
      "number": 4,
      "pali": "Vitakkasutta ",
      "english": "Thoughts "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, akusalavitakkā. ",
      "english": "“Mendicants, there are these three unskillful thoughts. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Anavaññattipaṭisaṁyutto vitakko, lābhasakkārasilokapaṭisaṁyutto vitakko, parānuddayatāpaṭisaṁyutto vitakko. ",
      "english": "The thought of status; of getting material things, honor, and popularity; and of fondness for others. "
    },
    {
      "number": 9,
      "pali": "Ime kho, bhikkhave, tayo akusalavitakkā”ti. ",
      "english": "These are the three unskillful thoughts.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Anavaññattisaṁyutto, ",
      "english": "“One concerned with being looked up to, "
    },
    {
      "number": 13,
      "pali": "lābhasakkāragāravo; ",
      "english": "with possessions, honor, and respect, "
    },
    {
      "number": 14,
      "pali": "Sahanandī amaccehi, ",
      "english": "with sharing joys with friends, "
    },
    {
      "number": 15,
      "pali": "ārā saṁyojanakkhayā. ",
      "english": "is far from the ending of fetters. "
    },
    {
      "number": 16,
      "pali": "Yo ca puttapasuṁ hitvā, ",
      "english": "But one who gives up children and herds, "
    },
    {
      "number": 17,
      "pali": "Vivāhe saṁharāni ca; ",
      "english": "marriage and acquisitions—"
    },
    {
      "number": 18,
      "pali": "Bhabbo so tādiso bhikkhu, ",
      "english": "such a mendicant is capable "
    },
    {
      "number": 19,
      "pali": "Phuṭṭhuṁ sambodhimuttaman”ti. ",
      "english": "of experiencing the highest awakening.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}