{
  "sutta_id": "SN11.25",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.25 ",
      "english": "Linked Discourses 11.25 "
    },
    {
      "number": 2,
      "pali": "3. Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 3,
      "pali": "Akkodhasutta ",
      "english": "Don’t Be Angry "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. "
    },
    {
      "number": 6,
      "pali": "Tatra kho bhagavā bhikkhū …pe… bhagavā etadavoca: ",
      "english": "There the Buddha addressed the mendicants: "
    },
    {
      "number": 7,
      "pali": "“bhūtapubbaṁ, bhikkhave, sakko devānamindo sudhammāyaṁ sabhāyaṁ deve tāvatiṁse anunayamāno tāyaṁ velāyaṁ imaṁ gāthaṁ abhāsi: ",
      "english": "“Once upon a time, mendicants, Sakka, lord of gods, guiding the gods of the thirty-three, spoke this verse: "
    },
    {
      "number": 8,
      "pali": "‘Mā vo kodho ajjhabhavi, ",
      "english": "‘Don’t let anger be your master, "
    },
    {
      "number": 9,
      "pali": "mā ca kujjhittha kujjhataṁ; ",
      "english": "don’t get angry at angry people. "
    },
    {
      "number": 10,
      "pali": "Akkodho avihiṁsā ca, ",
      "english": "Kindness and harmlessness "
    },
    {
      "number": 11,
      "pali": "ariyesu ca paṭipadā; ",
      "english": "are always present in the noble ones. "
    },
    {
      "number": 12,
      "pali": "Atha pāpajanaṁ kodho, ",
      "english": "For anger crushes bad people "
    },
    {
      "number": 13,
      "pali": "pabbatovābhimaddatī’”ti. ",
      "english": "like a mountain.’” "
    },
    {
      "number": 14,
      "pali": "Tatiyo vaggo. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Chetvā dubbaṇṇiya māyā, ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "accayena akodhano; ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Desitaṁ buddhaseṭṭhena, ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "idañhi sakkapañcakanti. ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Sakkasaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses with Sakka are complete. "
    },
    {
      "number": 21,
      "pali": "Sagāthāvaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Devatā devaputto ca, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "rājā māro ca bhikkhunī; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Brahmā brāhmaṇa vaṅgīso, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "vanayakkhena vāsavoti. ",
      "english": ""
    },
    {
      "number": 27,
      "pali": "Sagāthāvaggasaṁyuttapāḷi niṭṭhitā. ",
      "english": "The Book With Verses is finished. "
    }
  ]
}