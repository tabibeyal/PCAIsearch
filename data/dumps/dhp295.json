{
  "sutta_id": "DHP295",
  "verses": [
    {
      "number": 1,
      "pali": "Mātaraṁ pitaraṁ hantvā, ",
      "english": "Having slain mother and father, "
    },
    {
      "number": 2,
      "pali": "rājāno dve ca sotthiye; ",
      "english": "and two prosperous kings, "
    },
    {
      "number": 3,
      "pali": "Veyagghapañcamaṁ hantvā, ",
      "english": "and a tiger as the fifth, "
    },
    {
      "number": 4,
      "pali": "anīgho yāti brāhmaṇo. ",
      "english": "the brahmin walks on untroubled. "
    }
  ]
}