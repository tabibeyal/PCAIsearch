{
  "sutta_id": "AN2.141",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 2 ",
      "english": "Numbered Discourses 2.141–150 "
    },
    {
      "number": 2,
      "pali": "13. Dānavagga ",
      "english": "The Chapter on Giving "
    },
    {
      "number": 3,
      "pali": "141 ",
      "english": "141 "
    },
    {
      "number": 4,
      "pali": "“Dvemāni, bhikkhave, dānāni. ",
      "english": "“There are these two gifts. "
    },
    {
      "number": 5,
      "pali": "Katamāni dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Āmisadānañca dhammadānañca. ",
      "english": "A gift of things of the flesh and a gift of the teaching. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, dve dānāni. ",
      "english": "These are the two gifts. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ dānānaṁ yadidaṁ dhammadānan”ti. ",
      "english": "The better of these two gifts is the gift of the teaching.” "
    }
  ]
}