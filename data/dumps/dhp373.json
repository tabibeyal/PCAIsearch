{
  "sutta_id": "DHP373",
  "verses": [
    {
      "number": 1,
      "pali": "Suññāgāraṁ paviṭṭhassa, ",
      "english": "A mendicant who enters an empty hut "
    },
    {
      "number": 2,
      "pali": "santacittassa bhikkhuno; ",
      "english": "with mind at peace "
    },
    {
      "number": 3,
      "pali": "Amānusī rati hoti, ",
      "english": "finds a superhuman delight "
    },
    {
      "number": 4,
      "pali": "sammā dhammaṁ vipassato. ",
      "english": "as they rightly discern the Dhamma. "
    }
  ]
}