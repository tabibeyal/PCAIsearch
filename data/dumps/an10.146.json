{
  "sutta_id": "AN10.146",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.146 ",
      "english": "Numbered Discourses 10.146 "
    },
    {
      "number": 2,
      "pali": "15. Ariyavagga ",
      "english": "15. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Kaṇhamaggasutta ",
      "english": "The Dark Path "
    },
    {
      "number": 4,
      "pali": "“Kaṇhamaggañca vo, bhikkhave, dhammaṁ desessāmi sukkamaggañca. ",
      "english": "“I will teach you the dark path and the bright path. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, kaṇhamaggo? ",
      "english": "And what is the dark path? "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhi …pe… micchāvimutti—",
      "english": "Wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, wrong immersion, wrong knowledge, and wrong freedom. "
    },
    {
      "number": 8,
      "pali": "ayaṁ vuccati, bhikkhave, kaṇhamaggo. ",
      "english": "This is called the dark path. "
    },
    {
      "number": 9,
      "pali": "Katamo ca, bhikkhave, sukkamaggo? ",
      "english": "And what is the bright path? "
    },
    {
      "number": 10,
      "pali": "Sammādiṭṭhi …pe… sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 11,
      "pali": "ayaṁ vuccati, bhikkhave, sukkamaggo”ti. ",
      "english": "This is called the bright path.” "
    },
    {
      "number": 12,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}