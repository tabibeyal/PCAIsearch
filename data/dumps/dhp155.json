{
  "sutta_id": "DHP155",
  "verses": [
    {
      "number": 1,
      "pali": "Mahādhanaseṭṭhiputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Acaritvā brahmacariyaṁ, ",
      "english": "When young they spurned the spiritual path "
    },
    {
      "number": 3,
      "pali": "aladdhā yobbane dhanaṁ; ",
      "english": "and failed to earn any wealth. "
    },
    {
      "number": 4,
      "pali": "Jiṇṇakoñcāva jhāyanti, ",
      "english": "Now they brood like old cranes "
    },
    {
      "number": 5,
      "pali": "khīṇamaccheva pallale. ",
      "english": "in a pond bereft of fish. "
    }
  ]
}