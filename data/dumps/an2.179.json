{
  "sutta_id": "AN2.179",
  "verses": [
    {
      "number": 1,
      "pali": "179 ",
      "english": "179 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Sati ca sampajaññañca. ",
      "english": "Mindfulness and situational awareness. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    },
    {
      "number": 6,
      "pali": "Samāpattivaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Tatiyo paṇṇāsako samatto. ",
      "english": ""
    }
  ]
}