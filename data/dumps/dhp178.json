{
  "sutta_id": "DHP178",
  "verses": [
    {
      "number": 1,
      "pali": "Anāthapiṇḍikaputtakālavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pathabyā ekarajjena, ",
      "english": "The fruit of stream-entry is better "
    },
    {
      "number": 3,
      "pali": "saggassa gamanena vā; ",
      "english": "than being the one king of the earth, "
    },
    {
      "number": 4,
      "pali": "Sabbalokādhipaccena, ",
      "english": "than going to heaven, "
    },
    {
      "number": 5,
      "pali": "sotāpattiphalaṁ varaṁ. ",
      "english": "than lordship over all the world. "
    },
    {
      "number": 6,
      "pali": "Lokavaggo terasamo. ",
      "english": ""
    }
  ]
}