{
  "sutta_id": "DHP78",
  "verses": [
    {
      "number": 1,
      "pali": "Channattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na bhaje pāpake mitte, ",
      "english": "Don’t mix with bad friends, "
    },
    {
      "number": 3,
      "pali": "na bhaje purisādhame; ",
      "english": "nor with the worst of men. "
    },
    {
      "number": 4,
      "pali": "Bhajetha mitte kalyāṇe, ",
      "english": "Mix with spiritual friends, "
    },
    {
      "number": 5,
      "pali": "bhajetha purisuttame. ",
      "english": "and with the best of men. "
    }
  ]
}