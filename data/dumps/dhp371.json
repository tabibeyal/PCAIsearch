{
  "sutta_id": "DHP371",
  "verses": [
    {
      "number": 1,
      "pali": "Jhāya bhikkhu mā pamādo, ",
      "english": "Practice absorption, don’t be negligent! "
    },
    {
      "number": 2,
      "pali": "Mā te kāmaguṇe ramessu cittaṁ; ",
      "english": "Don’t let the mind delight in the senses! "
    },
    {
      "number": 3,
      "pali": "Mā lohaguḷaṁ gilī pamatto, ",
      "english": "Don’t heedlessly swallow a hot iron ball! "
    },
    {
      "number": 4,
      "pali": "Mā kandi “dukkhamidan”ti dayhamāno. ",
      "english": "And when it burns, don’t cry, “Oh, the pain!” "
    }
  ]
}