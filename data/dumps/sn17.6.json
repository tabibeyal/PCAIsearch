  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 17.6 ",
      "english": "Linked Discourses 17.6 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Asanisutta ",
      "english": "A Bolt of Lightning "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dāruṇo, bhikkhave, lābhasakkārasiloko …pe… adhigamāya. ",
      "english": "“Possessions, honor, and popularity are grim … "
    },
    {
      "number": 6,
      "pali": "Kaṁ, bhikkhave, asanivicakkaṁ āgacchatu, sekhaṁ appattamānasaṁ lābhasakkārasiloko anupāpuṇātu. ",
      "english": "Let forked lightning fall on whom? Let possessions, honor, and popularity come to a trainee who has not achieved their heart’s desire. "
    },
    {
      "number": 7,
      "pali": "Asanivicakkanti kho, bhikkhave, lābhasakkārasilokassetaṁ adhivacanaṁ. ",
      "english": "‘Forked lightning’ is a term for possessions, honor, and popularity. "
    },
    {
      "number": 8,
      "pali": "Evaṁ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "So grim are possessions, honor, and popularity. …” "
    },
    {
      "number": 9,
      "pali": "evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}