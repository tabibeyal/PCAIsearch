{
  "sutta_id": "AN4.47",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.47 ",
      "english": "Numbered Discourses 4.47 "
    },
    {
      "number": 2,
      "pali": "5. Rohitassavagga ",
      "english": "5. With Rohitassa "
    },
    {
      "number": 3,
      "pali": "Suvidūrasutta ",
      "english": "Very Far Apart "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, suvidūravidūrāni. ",
      "english": "“Mendicants, these four things are very far apart. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Nabhañca, bhikkhave, pathavī ca; ",
      "english": "The firmament and the earth. … "
    },
    {
      "number": 7,
      "pali": "idaṁ paṭhamaṁ suvidūravidūre. ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Orimañca, bhikkhave, tīraṁ samuddassa pārimañca; ",
      "english": "The near and the far shore of the ocean. … "
    },
    {
      "number": 9,
      "pali": "idaṁ dutiyaṁ suvidūravidūre. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Yato ca, bhikkhave, verocano abbhudeti yattha ca atthameti; ",
      "english": "Where the sun rises and where it sets. … "
    },
    {
      "number": 11,
      "pali": "idaṁ tatiyaṁ suvidūravidūre. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Satañca, bhikkhave, dhammo asatañca dhammo; ",
      "english": "The teaching of the virtuous and the teaching of the wicked. … "
    },
    {
      "number": 13,
      "pali": "idaṁ catutthaṁ suvidūravidūre. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Imāni kho, bhikkhave, cattāri suvidūravidūrānīti. ",
      "english": "These are the four things very far apart. "
    },
    {
      "number": 15,
      "pali": "Nabhañca dūre pathavī ca dūre, ",
      "english": "The firmament is far from the earth; "
    },
    {
      "number": 16,
      "pali": "Pāraṁ samuddassa tadāhu dūre; ",
      "english": "they say the other shore of the ocean is far; "
    },
    {
      "number": 17,
      "pali": "Yato ca verocano abbhudeti, ",
      "english": "and where the sun rises is far "
    },
    {
      "number": 18,
      "pali": "Pabhaṅkaro yattha ca atthameti; ",
      "english": "from where that beacon sets. "
    },
    {
      "number": 19,
      "pali": "Tato have dūrataraṁ vadanti, ",
      "english": "But even further apart than that, they say, "
    },
    {
      "number": 20,
      "pali": "Satañca dhammaṁ asatañca dhammaṁ. ",
      "english": "is the teaching of the virtuous from the wicked. "
    },
    {
      "number": 21,
      "pali": "Abyāyiko hoti sataṁ samāgamo, ",
      "english": "The company of the virtuous is reliable; "
    },
    {
      "number": 22,
      "pali": "Yāvāpi tiṭṭheyya tatheva hoti; ",
      "english": "as long as it remains, it stays the same. "
    },
    {
      "number": 23,
      "pali": "Khippañhi veti asataṁ samāgamo, ",
      "english": "But the company of the wicked is fickle, "
    },
    {
      "number": 24,
      "pali": "Tasmā sataṁ dhammo asabbhi ārakā”ti. ",
      "english": "and so the teaching of the virtuous <j>is far from the wicked.” "
    },
    {
      "number": 25,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}