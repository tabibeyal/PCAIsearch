{
  "sutta_id": "DHP50",
  "verses": [
    {
      "number": 1,
      "pali": "Pāveyyaājīvakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na paresaṁ vilomāni, ",
      "english": "Don’t find fault with others, "
    },
    {
      "number": 3,
      "pali": "na paresaṁ katākataṁ; ",
      "english": "with what they’ve done or left undone. "
    },
    {
      "number": 4,
      "pali": "Attanova avekkheyya, ",
      "english": "You should only watch yourself, "
    },
    {
      "number": 5,
      "pali": "katāni akatāni ca. ",
      "english": "what you’ve done or left undone. "
    }
  ]
}