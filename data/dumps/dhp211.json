{
  "sutta_id": "DHP211",
  "verses": [
    {
      "number": 1,
      "pali": "Tasmā piyaṁ na kayirātha, ",
      "english": "Therefore don’t hold anything dear, "
    },
    {
      "number": 2,
      "pali": "piyāpāyo hi pāpako; ",
      "english": "for it’s bad to lose those you love. "
    },
    {
      "number": 3,
      "pali": "Ganthā tesaṁ na vijjanti, ",
      "english": "No ties are found in they who "
    },
    {
      "number": 4,
      "pali": "yesaṁ natthi piyāppiyaṁ. ",
      "english": "hold nothing loved or loathed. "
    }
  ]
}