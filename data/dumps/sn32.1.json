{
  "sutta_id": "SN32.1",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 32.1 ",
      "english": "Linked Discourses 32.1 "
    },
    {
      "number": 2,
      "pali": "1. Valāhakavagga ",
      "english": "1. Gods of the Thunderclouds "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Valāhakakāyike vo, bhikkhave, deve desessāmi. ",
      "english": "“Mendicants, I will teach you about the gods of the thundercloud host. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katame ca, bhikkhave, valāhakakāyikā devā? ",
      "english": "And what are the gods of the thundercloud host? "
    },
    {
      "number": 8,
      "pali": "Santi, bhikkhave, sītavalāhakā devā; ",
      "english": "There are gods of the cool thunderclouds, "
    },
    {
      "number": 9,
      "pali": "santi uṇhavalāhakā devā; ",
      "english": "warm thunderclouds, "
    },
    {
      "number": 10,
      "pali": "santi abbhavalāhakā devā; ",
      "english": "stormy thunderclouds, "
    },
    {
      "number": 11,
      "pali": "santi vātavalāhakā devā; ",
      "english": "windy thunderclouds, "
    },
    {
      "number": 12,
      "pali": "santi vassavalāhakā devā—",
      "english": "and rainy thunderclouds. "
    },
    {
      "number": 13,
      "pali": "ime vuccanti, bhikkhave, ‘valāhakakāyikā devā’”ti. ",
      "english": "These are called gods of the thundercloud host.” "
    },
    {
      "number": 14,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}