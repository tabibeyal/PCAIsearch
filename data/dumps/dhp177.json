{
  "sutta_id": "DHP177",
  "verses": [
    {
      "number": 1,
      "pali": "Asadisadānavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na ve kadariyā devalokaṁ vajanti, ",
      "english": "The miserly don’t ascend to heaven, "
    },
    {
      "number": 3,
      "pali": "Bālā have nappasaṁsanti dānaṁ; ",
      "english": "it takes a fool to not praise giving. "
    },
    {
      "number": 4,
      "pali": "Dhīro ca dānaṁ anumodamāno, ",
      "english": "The attentive celebrate giving, "
    },
    {
      "number": 5,
      "pali": "Teneva so hoti sukhī parattha. ",
      "english": "and so find happiness in the hereafter. "
    }
  ]
}