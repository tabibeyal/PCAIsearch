{
  "sutta_id": "SN11.20",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.20 ",
      "english": "Linked Discourses 11.20 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Saṅghavandanāsutta ",
      "english": "Who Sakka Worships "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ jetavane. ",
      "english": "Near Sāvatthī in Jeta’s Grove. "
    },
    {
      "number": 5,
      "pali": "Tatra kho …pe… etadavoca: ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "“bhūtapubbaṁ, bhikkhave, sakko devānamindo mātaliṁ saṅgāhakaṁ āmantesi: ",
      "english": "“Once upon a time, mendicants, Sakka, lord of gods, addressed his chariot handler Mātali, "
    },
    {
      "number": 7,
      "pali": "‘yojehi, samma mātali, sahassayuttaṁ ājaññarathaṁ, uyyānabhūmiṁ gacchāma subhūmiṁ dassanāyā’ti. ",
      "english": "‘My dear Mātali, harness the chariot with its team of a thousand thoroughbreds. We will go to a park and see the scenery.’ "
    },
    {
      "number": 8,
      "pali": "‘Evaṁ, bhaddantavā’ti kho, bhikkhave, mātali saṅgāhako sakkassa devānamindassa paṭissutvā, sahassayuttaṁ ājaññarathaṁ yojetvā sakkassa devānamindassa paṭivedesi: ",
      "english": "‘Yes, lord,’ replied Mātali. He harnessed the chariot and informed Sakka, "
    },
    {
      "number": 9,
      "pali": "‘yutto kho te, mārisa, sahassayutto ājaññaratho, ",
      "english": "‘Good fellow, the chariot with its team of a thousand thoroughbreds has been harnessed. "
    },
    {
      "number": 10,
      "pali": "yassadāni kālaṁ maññasī’ti. ",
      "english": "Please go at your convenience.’ "
    },
    {
      "number": 11,
      "pali": "Atha kho, bhikkhave, sakko devānamindo vejayantapāsādā orohanto añjaliṁ katvā sudaṁ bhikkhusaṅghaṁ namassati. ",
      "english": "Then Sakka descended from the Palace of Victory, raised his cupped palms, and revered the mendicant Saṅgha. "
    },
    {
      "number": 12,
      "pali": "Atha kho, bhikkhave, mātali saṅgāhako sakkaṁ devānamindaṁ gāthāya ajjhabhāsi: ",
      "english": "So Mātali the chariot handler addressed Sakka in verse: "
    },
    {
      "number": 13,
      "pali": "‘Tañhi ete namasseyyuṁ, ",
      "english": "‘It’s these who should worship you, "
    },
    {
      "number": 14,
      "pali": "pūtidehasayā narā; ",
      "english": "namely the humans stuck in their putrid bodies, "
    },
    {
      "number": 15,
      "pali": "Nimuggā kuṇapamhete, ",
      "english": "sunk in a carcass, "
    },
    {
      "number": 16,
      "pali": "khuppipāsasamappitā. ",
      "english": "stricken by hunger and thirst. "
    },
    {
      "number": 17,
      "pali": "Kiṁ nu tesaṁ pihayasi, ",
      "english": "Why then do you envy those "
    },
    {
      "number": 18,
      "pali": "anāgārāna vāsava; ",
      "english": "who are homeless, Vāsava? "
    },
    {
      "number": 19,
      "pali": "Ācāraṁ isinaṁ brūhi, ",
      "english": "Relate the seers’ way of life, "
    },
    {
      "number": 20,
      "pali": "taṁ suṇoma vaco tavā’ti. ",
      "english": "let us hear what you say.’ "
    },
    {
      "number": 21,
      "pali": "‘Etaṁ tesaṁ pihayāmi, ",
      "english": "‘This is why I envy the "
    },
    {
      "number": 22,
      "pali": "anāgārāna mātali; ",
      "english": "homeless, Mātali. "
    },
    {
      "number": 23,
      "pali": "Yamhā gāmā pakkamanti, ",
      "english": "When they leave a village, "
    },
    {
      "number": 24,
      "pali": "anapekkhā vajanti te. ",
      "english": "they proceed without concern. "
    },
    {
      "number": 25,
      "pali": "Na tesaṁ koṭṭhe openti, ",
      "english": "They hoard no goods in storerooms, "
    },
    {
      "number": 26,
      "pali": "na kumbhi na kaḷopiyaṁ; ",
      "english": "nor in pots or baskets. "
    },
    {
      "number": 27,
      "pali": "Paraniṭṭhitamesānā, ",
      "english": "They seek food prepared by others, "
    },
    {
      "number": 28,
      "pali": "tena yāpenti subbatā. ",
      "english": "and, true to their vows, live on that. "
    },
    {
      "number": 29,
      "pali": "Sumantamantino dhīrā, ",
      "english": "The attentive, whose words are full of wisdom, "
    },
    {
      "number": 30,
      "pali": "tuṇhībhūtā samañcarā; ",
      "english": "live peacefully and quietly. "
    },
    {
      "number": 31,
      "pali": "Devā viruddhā asurehi, ",
      "english": "Gods fight with titans, "
    },
    {
      "number": 32,
      "pali": "puthu maccā ca mātali. ",
      "english": "and mortals fight each other, Mātali. "
    },
    {
      "number": 33,
      "pali": "Aviruddhā viruddhesu, ",
      "english": "Not fighting among those who fight, "
    },
    {
      "number": 34,
      "pali": "attadaṇḍesu nibbutā; ",
      "english": "quenched among those who have taken up arms, "
    },
    {
      "number": 35,
      "pali": "Sādānesu anādānā, ",
      "english": "not grasping among those who grasp: "
    },
    {
      "number": 36,
      "pali": "te namassāmi mātalī’ti. ",
      "english": "they’re who I worship, Mātali.’ "
    },
    {
      "number": 37,
      "pali": "‘Seṭṭhā hi kira lokasmiṁ, ",
      "english": "‘Those who you worship "
    },
    {
      "number": 38,
      "pali": "ye tvaṁ sakka namassasi; ",
      "english": "seem to be the best in the world, Sakka. "
    },
    {
      "number": 39,
      "pali": "Ahampi te namassāmi, ",
      "english": "I too will worship "
    },
    {
      "number": 40,
      "pali": "ye namassasi vāsavā’”ti. ",
      "english": "those who you worship, Vāsava.’ "
    },
    {
      "number": 41,
      "pali": "Idaṁ vatvāna maghavā, ",
      "english": "After saying this, Maghavā the chief, "
    },
    {
      "number": 42,
      "pali": "devarājā sujampati; ",
      "english": "king of gods, Sujā’s husband, "
    },
    {
      "number": 43,
      "pali": "Bhikkhusaṅghaṁ namassitvā, ",
      "english": "having worshipped the mendicant Saṅgha, "
    },
    {
      "number": 44,
      "pali": "pamukho rathamāruhīti. ",
      "english": "climbed into his chariot.” "
    },
    {
      "number": 45,
      "pali": "Dutiyo vaggo. ",
      "english": ""
    },
    {
      "number": 46,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 47,
      "pali": "Devā pana tayo vuttā, ",
      "english": ""
    },
    {
      "number": 48,
      "pali": "daliddañca rāmaṇeyyakaṁ; ",
      "english": ""
    },
    {
      "number": 49,
      "pali": "Yajamānañca vandanā, ",
      "english": ""
    },
    {
      "number": 50,
      "pali": "tayo sakkanamassanāti. ",
      "english": ""
    }
  ]
}