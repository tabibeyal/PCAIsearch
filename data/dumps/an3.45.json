{
  "sutta_id": "AN3.45",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 3.45 ",
      "english": "Numbered Discourses 3.45 "
    },
    {
      "number": 2,
      "pali": "5. Cūḷavagga ",
      "english": "5. The Lesser Chapter "
    },
    {
      "number": 3,
      "pali": "Paṇḍitasutta ",
      "english": "Recommended by the Astute "
    },
    {
      "number": 4,
      "pali": "“Tīṇimāni, bhikkhave, paṇḍitapaññattāni sappurisapaññattāni. ",
      "english": "“Mendicants, these three things are recommended by astute true persons. "
    },
    {
      "number": 5,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Dānaṁ, bhikkhave, paṇḍitapaññattaṁ sappurisapaññattaṁ. ",
      "english": "Giving, "
    },
    {
      "number": 7,
      "pali": "Pabbajjā, bhikkhave, paṇḍitapaññattā sappurisapaññattā. ",
      "english": "going forth, "
    },
    {
      "number": 8,
      "pali": "Mātāpitūnaṁ, bhikkhave, upaṭṭhānaṁ paṇḍitapaññattaṁ sappurisapaññattaṁ. ",
      "english": "and taking care of your mother and father. "
    },
    {
      "number": 9,
      "pali": "Imāni kho, bhikkhave, tīṇi paṇḍitapaññattāni sappurisapaññattānīti. ",
      "english": "These are the three things recommended by astute true persons. "
    },
    {
      "number": 10,
      "pali": "Sabbhi dānaṁ upaññattaṁ, ",
      "english": "The virtuous recommend giving, "
    },
    {
      "number": 11,
      "pali": "ahiṁsā saṁyamo damo; ",
      "english": "harmlessness, restraint, and self-control; "
    },
    {
      "number": 12,
      "pali": "Mātāpitu upaṭṭhānaṁ, ",
      "english": "caring for mother and father, "
    },
    {
      "number": 13,
      "pali": "santānaṁ brahmacārinaṁ. ",
      "english": "and peaceful spiritual practitioners. "
    },
    {
      "number": 14,
      "pali": "Sataṁ etāni ṭhānāni, ",
      "english": "These are the things recommended by the good, "
    },
    {
      "number": 15,
      "pali": "yāni sevetha paṇḍito; ",
      "english": "which the astute should cultivate. "
    },
    {
      "number": 16,
      "pali": "Ariyo dassanasampanno, ",
      "english": "A noble one, having vision, "
    },
    {
      "number": 17,
      "pali": "sa lokaṁ bhajate sivan”ti. ",
      "english": "will enjoy a world of grace.” "
    },
    {
      "number": 18,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}