{
  "sutta_id": "SN30.1",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 30.1 ",
      "english": "Linked Discourses 30.1 "
    },
    {
      "number": 2,
      "pali": "1. Supaṇṇavagga ",
      "english": "1. Phoenixes "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Catasso imā, bhikkhave, supaṇṇayoniyo. ",
      "english": "“Mendicants, phoenixes reproduce in these four ways. "
    },
    {
      "number": 6,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 7,
      "pali": "Aṇḍajā supaṇṇā, jalābujā supaṇṇā, saṁsedajā supaṇṇā, opapātikā supaṇṇā—",
      "english": "Phoenixes are born from eggs, from a womb, from moisture, or spontaneously. "
    },
    {
      "number": 8,
      "pali": "imā kho, bhikkhave, catasso supaṇṇayoniyo”ti. ",
      "english": "These are the four ways that phoenixes reproduce.” "
    },
    {
      "number": 9,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}