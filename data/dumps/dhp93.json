{
  "sutta_id": "DHP93",
  "verses": [
    {
      "number": 1,
      "pali": "Anuruddhattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassāsavā parikkhīṇā, ",
      "english": "One whose defilements have ended; "
    },
    {
      "number": 3,
      "pali": "āhāre ca anissito; ",
      "english": "who’s not attached to food; "
    },
    {
      "number": 4,
      "pali": "Suññato animitto ca, ",
      "english": "whose domain is the liberation "
    },
    {
      "number": 5,
      "pali": "vimokkho yassa gocaro; ",
      "english": "of the signless and the empty: "
    },
    {
      "number": 6,
      "pali": "Ākāseva sakuntānaṁ, ",
      "english": "their track is hard to trace, "
    },
    {
      "number": 7,
      "pali": "padaṁ tassa durannayaṁ. ",
      "english": "like birds in the sky. "
    }
  ]
}