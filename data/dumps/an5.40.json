{
  "sutta_id": "AN5.40",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.40 ",
      "english": "Numbered Discourses 5.40 "
    },
    {
      "number": 2,
      "pali": "4. Sumanavagga ",
      "english": "4. With Sumanā "
    },
    {
      "number": 3,
      "pali": "Mahāsālaputtasutta ",
      "english": "Great Sal Trees "
    },
    {
      "number": 4,
      "pali": "“Himavantaṁ, bhikkhave, pabbatarājaṁ nissāya mahāsālā pañcahi vaḍḍhīhi vaḍḍhanti. ",
      "english": "“Mendicants, great sal trees grow in five ways supported by the Himalayas, the king of mountains. "
    },
    {
      "number": 5,
      "pali": "Katamāhi pañcahi? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Sākhāpattapalāsena vaḍḍhanti; ",
      "english": "The branches, leaves, and foliage; "
    },
    {
      "number": 7,
      "pali": "tacena vaḍḍhanti; ",
      "english": "the bark; "
    },
    {
      "number": 8,
      "pali": "papaṭikāya vaḍḍhanti; ",
      "english": "the shoots; "
    },
    {
      "number": 9,
      "pali": "pheggunā vaḍḍhanti; ",
      "english": "the softwood; "
    },
    {
      "number": 10,
      "pali": "sārena vaḍḍhanti. ",
      "english": "and the hardwood. "
    },
    {
      "number": 11,
      "pali": "Himavantaṁ, bhikkhave, pabbatarājaṁ nissāya mahāsālā imāhi pañcahi vaḍḍhīhi vaḍḍhanti. ",
      "english": "Great sal trees grow in these five ways supported by the Himalayas, the king of mountains. "
    },
    {
      "number": 12,
      "pali": "Evamevaṁ kho, bhikkhave, saddhaṁ kulaputtaṁ nissāya antojano pañcahi vaḍḍhīhi vaḍḍhati. ",
      "english": "In the same way, a family grows in five ways supported by a family head with faith. "
    },
    {
      "number": 13,
      "pali": "Katamāhi pañcahi? ",
      "english": "What five? "
    },
    {
      "number": 14,
      "pali": "Saddhāya vaḍḍhati; ",
      "english": "Faith, "
    },
    {
      "number": 15,
      "pali": "sīlena vaḍḍhati; ",
      "english": "ethics, "
    },
    {
      "number": 16,
      "pali": "sutena vaḍḍhati; ",
      "english": "learning, "
    },
    {
      "number": 17,
      "pali": "cāgena vaḍḍhati; ",
      "english": "generosity, "
    },
    {
      "number": 18,
      "pali": "paññāya vaḍḍhati. ",
      "english": "and wisdom. "
    },
    {
      "number": 19,
      "pali": "Saddhaṁ, bhikkhave, kulaputtaṁ nissāya antojano imāhi pañcahi vaḍḍhīhi vaḍḍhatīti. ",
      "english": "A family grows in these five ways supported by a family head with faith. "
    },
    {
      "number": 20,
      "pali": "Yathā hi pabbato selo, ",
      "english": "Supported by the mountain crags "
    },
    {
      "number": 21,
      "pali": "araññasmiṁ brahāvane; ",
      "english": "in the wilds, the formidable forest, "
    },
    {
      "number": 22,
      "pali": "Taṁ rukkhā upanissāya, ",
      "english": "the tree grows "
    },
    {
      "number": 23,
      "pali": "vaḍḍhante te vanappatī. ",
      "english": "to become lord of the forest. "
    },
    {
      "number": 24,
      "pali": "Tatheva sīlasampannaṁ, ",
      "english": "So too, when the family head "
    },
    {
      "number": 25,
      "pali": "Saddhaṁ kulaputtaṁ imaṁ; ",
      "english": "is ethical and faithful, "
    },
    {
      "number": 26,
      "pali": "Upanissāya vaḍḍhanti, ",
      "english": "supported by them, they grow: "
    },
    {
      "number": 27,
      "pali": "Puttadārā ca bandhavā; ",
      "english": "children, partners, and kin, "
    },
    {
      "number": 28,
      "pali": "Amaccā ñātisaṅghā ca, ",
      "english": "colleagues, relatives, "
    },
    {
      "number": 29,
      "pali": "Ye cassa anujīvino. ",
      "english": "and those dependent for their livelihood. "
    },
    {
      "number": 30,
      "pali": "Tyassa sīlavato sīlaṁ, ",
      "english": "Seeing the ethical conduct of the virtuous, "
    },
    {
      "number": 31,
      "pali": "cāgaṁ sucaritāni ca; ",
      "english": "the generosity and good deeds, "
    },
    {
      "number": 32,
      "pali": "Passamānānukubbanti, ",
      "english": "those who see clearly "
    },
    {
      "number": 33,
      "pali": "ye bhavanti vicakkhaṇā. ",
      "english": "do likewise. "
    },
    {
      "number": 34,
      "pali": "Idha dhammaṁ caritvāna, ",
      "english": "Having practiced the teaching here, "
    },
    {
      "number": 35,
      "pali": "maggaṁ sugatigāminaṁ; ",
      "english": "the path that goes to a good place, "
    },
    {
      "number": 36,
      "pali": "Nandino devalokasmiṁ, ",
      "english": "they delight in the heavenly realm, "
    },
    {
      "number": 37,
      "pali": "modanti kāmakāmino”ti. ",
      "english": "enjoying all the pleasures they desire.” "
    },
    {
      "number": 38,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 39,
      "pali": "Sumanavaggo catuttho. ",
      "english": ""
    },
    {
      "number": 40,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 41,
      "pali": "Sumanā cundī uggaho, ",
      "english": ""
    },
    {
      "number": 42,
      "pali": "sīho dānānisaṁsako; ",
      "english": ""
    },
    {
      "number": 43,
      "pali": "Kālabhojanasaddhā ca, ",
      "english": ""
    },
    {
      "number": 44,
      "pali": "puttasālehi te dasāti. ",
      "english": ""
    }
  ]
}