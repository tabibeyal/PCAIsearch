{
  "sutta_id": "ITI107",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 107",
      "english": "Itivuttaka 107"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, brahmans & householders are very helpful to you, as they provide you with the requisites of robes, alms food, lodgings, & medical requisites for the sick. And you, monks, are very helpful to brahmans & householders, as you teach them the Dhamma admirable in the beginning, admirable in the middle, admirable in the end; as you expound the holy life both in its particulars & in its essence, entirely complete, surpassingly pure. In this way the holy life is lived in mutual dependence, for the purpose of crossing over the flood, for making a right end to stress.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Householders & the homeless"
    },
    {
      "number": 5,
      "pali": "",
      "english": "in mutual dependence"
    },
    {
      "number": 6,
      "pali": "",
      "english": "both reach the true Dhamma:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "the unsurpassed safety from bondage."
    },
    {
      "number": 8,
      "pali": "",
      "english": "From householders, the homeless"
    },
    {
      "number": 9,
      "pali": "",
      "english": "receive requisites: robes, lodgings,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "protection from inclemencies."
    },
    {
      "number": 11,
      "pali": "",
      "english": "While in dependence on those well-gone,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "home-loving householders"
    },
    {
      "number": 13,
      "pali": "",
      "english": "have conviction in Arahants"
    },
    {
      "number": 14,
      "pali": "",
      "english": "of noble discernment,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "absorbed in jhāna."
    },
    {
      "number": 16,
      "pali": "",
      "english": "Having practiced the Dhamma here–"
    },
    {
      "number": 17,
      "pali": "",
      "english": "the path leading to good destinations–"
    },
    {
      "number": 18,
      "pali": "",
      "english": "delighting in the deva world,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "they rejoice,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "enjoying sensual pleasures."
    }
  ]
}