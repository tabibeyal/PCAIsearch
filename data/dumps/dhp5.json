{
  "sutta_id": "DHP5",
  "verses": [
    {
      "number": 1,
      "pali": "Kāḷayakkhinīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na hi verena verāni, ",
      "english": "For never is hatred "
    },
    {
      "number": 3,
      "pali": "sammantīdha kudācanaṁ; ",
      "english": "laid to rest by hate, "
    },
    {
      "number": 4,
      "pali": "Averena ca sammanti, ",
      "english": "it’s laid to rest by love: "
    },
    {
      "number": 5,
      "pali": "esa dhammo sanantano. ",
      "english": "this is an ancient teaching. "
    }
  ]
}