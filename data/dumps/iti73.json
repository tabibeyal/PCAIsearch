{
  "sutta_id": "ITI73",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 73 ",
      "english": "So It Was Said 73 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Santatarasutta ",
      "english": "More Peaceful "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Rūpehi, bhikkhave, arūpā santatarā, arūpehi nirodho santataro”ti. ",
      "english": "“Mendicants, formless states are more peaceful than states of form; cessation is more peaceful than formless states.” "
    },
    {
      "number": 7,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 8,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 9,
      "pali": "“Ye ca rūpūpagā sattā, ",
      "english": "“There are beings in the realm of luminous form, "
    },
    {
      "number": 10,
      "pali": "ye ca arūpaṭṭhāyino; ",
      "english": "and others stuck in the formless. "
    },
    {
      "number": 11,
      "pali": "Nirodhaṁ appajānantā, ",
      "english": "Not understanding cessation, "
    },
    {
      "number": 12,
      "pali": "āgantāro punabbhavaṁ. ",
      "english": "they return in future lives. "
    },
    {
      "number": 13,
      "pali": "Ye ca rūpe pariññāya, ",
      "english": "But the people who completely understand form, "
    },
    {
      "number": 14,
      "pali": "arūpesu asaṇṭhitā; ",
      "english": "not stuck in the formless, "
    },
    {
      "number": 15,
      "pali": "Nirodhe ye vimuccanti, ",
      "english": "released in cessation—"
    },
    {
      "number": 16,
      "pali": "te janā maccuhāyino. ",
      "english": "they are conquerors of death. "
    },
    {
      "number": 17,
      "pali": "Kāyena amatadhātuṁ, ",
      "english": "Having directly experienced <j>the element free of death, "
    },
    {
      "number": 18,
      "pali": "phusayitvā nirūpadhiṁ; ",
      "english": "free of attachments; "
    },
    {
      "number": 19,
      "pali": "Upadhippaṭinissaggaṁ, ",
      "english": "having realised relinquishment "
    },
    {
      "number": 20,
      "pali": "sacchikatvā anāsavo; ",
      "english": "of attachments, the undefiled "
    },
    {
      "number": 21,
      "pali": "Deseti sammāsambuddho, ",
      "english": "fully awakened Buddha teaches "
    },
    {
      "number": 22,
      "pali": "asokaṁ virajaṁ padan”ti. ",
      "english": "the sorrowless, stainless state.” "
    },
    {
      "number": 23,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 24,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}