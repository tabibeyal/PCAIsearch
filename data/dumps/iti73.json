{
  "sutta_id": "ITI73",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 73",
      "english": "Itivuttaka 73"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, formless phenomena are more peaceful than forms; cessation, more peaceful than formless phenomena.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Those beings headed to forms,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "and those standing in the formless,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "with no knowledge of cessation,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "return to further becoming."
    },
    {
      "number": 8,
      "pali": "",
      "english": "But, comprehending form,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "not taking a stance in formless things,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "those released in cessation"
    },
    {
      "number": 11,
      "pali": "",
      "english": "are people who’ve left death behind."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Having touched with his body"
    },
    {
      "number": 13,
      "pali": "",
      "english": "the deathless property free"
    },
    {
      "number": 14,
      "pali": "",
      "english": "from acquisitions,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "having realized relinquishing"
    },
    {
      "number": 16,
      "pali": "",
      "english": "of acquisitions,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "effluent-free,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "the Rightly Self-awakened One"
    },
    {
      "number": 19,
      "pali": "",
      "english": "teaches the state"
    },
    {
      "number": 20,
      "pali": "",
      "english": "with"
    },
    {
      "number": 21,
      "pali": "",
      "english": "no sorrow,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "no dust."
    }
  ]
}