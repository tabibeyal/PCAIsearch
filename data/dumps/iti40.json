{
  "sutta_id": "ITI40",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 40 ",
      "english": "So It Was Said 40 "
    },
    {
      "number": 2,
      "pali": "Dukanipāta ",
      "english": "The Book of the Twos "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Vijjāsutta ",
      "english": "Knowledge "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Avijjā, bhikkhave, pubbaṅgamā akusalānaṁ dhammānaṁ samāpattiyā anvadeva ahirikaṁ anottappaṁ; ",
      "english": "“Mendicants, ignorance precedes the attainment of unskillful qualities, with lack of conscience and prudence following along. "
    },
    {
      "number": 7,
      "pali": "vijjā ca kho, bhikkhave, pubbaṅgamā kusalānaṁ dhammānaṁ samāpattiyā anvadeva hirottappan”ti. ",
      "english": "Knowledge precedes the attainment of skillful qualities, with conscience and prudence following along.” "
    },
    {
      "number": 8,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 9,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 10,
      "pali": "“Yā kācimā duggatiyo, ",
      "english": "“Bad destinies of whatever kind, "
    },
    {
      "number": 11,
      "pali": "asmiṁ loke paramhi ca; ",
      "english": "in this world or the next, "
    },
    {
      "number": 12,
      "pali": "Avijjāmūlikā sabbā, ",
      "english": "are all rooted in ignorance, "
    },
    {
      "number": 13,
      "pali": "icchālobhasamussayā. ",
      "english": "compounded of greed and desire. "
    },
    {
      "number": 14,
      "pali": "Yato ca hoti pāpiccho, ",
      "english": "Since one of corrupt wishes is "
    },
    {
      "number": 15,
      "pali": "ahirīko anādaro; ",
      "english": "unconscientious, lacking regard for others, "
    },
    {
      "number": 16,
      "pali": "Tato pāpaṁ pasavati, ",
      "english": "they brim with much wickedness, "
    },
    {
      "number": 17,
      "pali": "apāyaṁ tena gacchati. ",
      "english": "which sends them to a place of loss. "
    },
    {
      "number": 18,
      "pali": "Tasmā chandañca lobhañca, ",
      "english": "Therefore, dispelling desire "
    },
    {
      "number": 19,
      "pali": "avijjañca virājayaṁ; ",
      "english": "and greed and ignorance, "
    },
    {
      "number": 20,
      "pali": "Vijjaṁ uppādayaṁ bhikkhu, ",
      "english": "a mendicant arousing knowledge "
    },
    {
      "number": 21,
      "pali": "sabbā duggatiyo jahe”ti. ",
      "english": "would abandon all bad destinies.” "
    },
    {
      "number": 22,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 23,
      "pali": "Tatiyaṁ. ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Paṭhamabhāṇavāro. ",
      "english": ""
    }
  ]
}