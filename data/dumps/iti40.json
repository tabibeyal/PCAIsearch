{
  "sutta_id": "ITI40",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 40",
      "english": "Itivuttaka 40"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, ignorance precedes the arrival of unskillful qualities; lack of shame & lack of compunction follow after. Clear knowing precedes the arrival of skillful qualities; shame & compunction follow after.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Any bad destinations"
    },
    {
      "number": 5,
      "pali": "",
      "english": "in this world, in the next,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "are rooted in ignorance–all–"
    },
    {
      "number": 7,
      "pali": "",
      "english": "accumulations"
    },
    {
      "number": 8,
      "pali": "",
      "english": "of desire & greed."
    },
    {
      "number": 9,
      "pali": "",
      "english": "And when a person of evil desires"
    },
    {
      "number": 10,
      "pali": "",
      "english": "lacks shame & respect,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "evil comes from that,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "and by that he goes"
    },
    {
      "number": 13,
      "pali": "",
      "english": "to deprivation."
    },
    {
      "number": 14,
      "pali": "",
      "english": "So cleansing away"
    },
    {
      "number": 15,
      "pali": "",
      "english": "ignorance, desire, & greed,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "a monk giving rise to clear knowing"
    },
    {
      "number": 17,
      "pali": "",
      "english": "would abandon all bad destinations."
    }
  ]
}