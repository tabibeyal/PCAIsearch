{
  "sutta_id": "SN9.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 9.6 ",
      "english": "Linked Discourses 9.6 "
    },
    {
      "number": 2,
      "pali": "1. Vanavagga ",
      "english": "1. In the Woods "
    },
    {
      "number": 3,
      "pali": "Anuruddhasutta ",
      "english": "With Anuruddha "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ āyasmā anuruddho kosalesu viharati aññatarasmiṁ vanasaṇḍe. ",
      "english": "At one time Venerable Anuruddha was staying in the land of the Kosalans in a certain forest grove. "
    },
    {
      "number": 5,
      "pali": "Atha kho aññatarā tāvatiṁsakāyikā devatā jālinī nāma āyasmato anuruddhassa purāṇadutiyikā yenāyasmā anuruddho tenupasaṅkami; upasaṅkamitvā āyasmantaṁ anuruddhaṁ gāthāya ajjhabhāsi: ",
      "english": "Then a certain deity of the company of the thirty-three named Penelope had been Anuruddha’s partner in a former life. She went up to Anuruddha, and recited these verses: "
    },
    {
      "number": 6,
      "pali": "“Tattha cittaṁ paṇidhehi, ",
      "english": "“Set your heart there, "
    },
    {
      "number": 7,
      "pali": "yattha te vusitaṁ pure; ",
      "english": "where you used to live: "
    },
    {
      "number": 8,
      "pali": "Tāvatiṁsesu devesu, ",
      "english": "among the gods of the thirty-three, "
    },
    {
      "number": 9,
      "pali": "sabbakāmasamiddhisu; ",
      "english": "whose every desire is granted! "
    },
    {
      "number": 10,
      "pali": "Purakkhato parivuto, ",
      "english": "At the fore of a retinue "
    },
    {
      "number": 11,
      "pali": "devakaññāhi sobhasī”ti. ",
      "english": "of divine maidens, you’ll shine!” "
    },
    {
      "number": 12,
      "pali": "“Duggatā devakaññāyo, ",
      "english": "“Divine maidens are in a sorry state, "
    },
    {
      "number": 13,
      "pali": "sakkāyasmiṁ patiṭṭhitā; ",
      "english": "stuck in substantial reality. "
    },
    {
      "number": 14,
      "pali": "Te cāpi duggatā sattā, ",
      "english": "And those beings too are in a sorry state, "
    },
    {
      "number": 15,
      "pali": "devakaññāhi patthitā”ti. ",
      "english": "who are attached to divine maidens.” "
    },
    {
      "number": 16,
      "pali": "“Na te sukhaṁ pajānanti, ",
      "english": "“They don’t know pleasure "
    },
    {
      "number": 17,
      "pali": "ye na passanti nandanaṁ; ",
      "english": "who don’t see the Garden of Delight! "
    },
    {
      "number": 18,
      "pali": "Āvāsaṁ naradevānaṁ, ",
      "english": "It’s the abode of lordly gods, "
    },
    {
      "number": 19,
      "pali": "tidasānaṁ yasassinan”ti. ",
      "english": "the glorious host of Thirty!” "
    },
    {
      "number": 20,
      "pali": "“Na tvaṁ bāle vijānāsi, ",
      "english": "“Fool, don’t you understand "
    },
    {
      "number": 21,
      "pali": "yathā arahataṁ vaco; ",
      "english": "the saying of the perfected ones: "
    },
    {
      "number": 22,
      "pali": "Aniccā sabbasaṅkhārā, ",
      "english": "all conditions are impermanent, "
    },
    {
      "number": 23,
      "pali": "uppādavayadhammino; ",
      "english": "their nature is to rise and fall; "
    },
    {
      "number": 24,
      "pali": "Uppajjitvā nirujjhanti, ",
      "english": "having arisen, they cease; "
    },
    {
      "number": 25,
      "pali": "tesaṁ vūpasamo sukho. ",
      "english": "their settling is such bliss. "
    },
    {
      "number": 26,
      "pali": "Natthi dāni punāvāso, ",
      "english": "O Penelope, weaver of the web—"
    },
    {
      "number": 27,
      "pali": "devakāyasmi jālini; ",
      "english": "there are no more abodes for me in the host of gods. "
    },
    {
      "number": 28,
      "pali": "Vikkhīṇo jātisaṁsāro, ",
      "english": "Transmigration through births is finished, "
    },
    {
      "number": 29,
      "pali": "natthi dāni punabbhavo”ti. ",
      "english": "now there’ll be no more future lives.” "
    }
  ]
}