{
  "sutta_id": "SN9.6",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 9.6",
      "english": "Linked Discourses 9.6"
    },
    {
      "number": 2,
      "pali": "Anuruddha Sutta",
      "english": "Anuruddha"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that on one occasion Ven. Anuruddha was staying among the Kosalans in a forest grove. Now at that time, a devatā from the retinue of the heaven of the Thirty-three named Jālinī, one of Ven. Anuruddha’s former consorts, went to him and, on arrival, addressed him with this verse:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Direct your mind"
    },
    {
      "number": 5,
      "pali": "",
      "english": "to where you used to live,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "among the Devas of the Thirty-three,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "empowered"
    },
    {
      "number": 8,
      "pali": "",
      "english": "with all sensual pleasures."
    },
    {
      "number": 9,
      "pali": "",
      "english": "Honored, surrounded"
    },
    {
      "number": 10,
      "pali": "",
      "english": "by deva maidens,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "you"
    },
    {
      "number": 12,
      "pali": "",
      "english": "will shine.”"
    },
    {
      "number": 13,
      "pali": "",
      "english": "Ven. Anuruddha:"
    },
    {
      "number": 14,
      "pali": "",
      "english": "“They’ve gone astray,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "deva maidens"
    },
    {
      "number": 16,
      "pali": "",
      "english": "established in self-identity."
    },
    {
      "number": 17,
      "pali": "",
      "english": "And they’ve gone astray,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "those beings with deva maidens"
    },
    {
      "number": 19,
      "pali": "",
      "english": "as their aim.”"
    },
    {
      "number": 20,
      "pali": "",
      "english": "Jālinī:"
    },
    {
      "number": 21,
      "pali": "",
      "english": "“They don’t know bliss"
    },
    {
      "number": 22,
      "pali": "",
      "english": "who haven’t seen Nandana,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "abode of the eminent devas,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "glorious,"
    },
    {
      "number": 25,
      "pali": "",
      "english": "of the Thirty-three.”"
    },
    {
      "number": 26,
      "pali": "",
      "english": "Ven. Anuruddha:"
    },
    {
      "number": 27,
      "pali": "",
      "english": "“You fool, don’t you know"
    },
    {
      "number": 28,
      "pali": "",
      "english": "the arahants’ maxim?—"
    },
    {
      "number": 29,
      "pali": "",
      "english": "‘How inconstant are fabrications!"
    },
    {
      "number": 30,
      "pali": "",
      "english": "Their nature: to arise & pass away."
    },
    {
      "number": 31,
      "pali": "",
      "english": "They disband as they are arising."
    },
    {
      "number": 32,
      "pali": "",
      "english": "Their total stilling is bliss.’"
    },
    {
      "number": 33,
      "pali": "",
      "english": "Jālinī, there is now"
    },
    {
      "number": 34,
      "pali": "",
      "english": "in deva company"
    },
    {
      "number": 35,
      "pali": "",
      "english": "no further abode"
    },
    {
      "number": 36,
      "pali": "",
      "english": "(for me)."
    },
    {
      "number": 37,
      "pali": "",
      "english": "With the utter ending"
    },
    {
      "number": 38,
      "pali": "",
      "english": "of wandering on in birth,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "there is now"
    },
    {
      "number": 40,
      "pali": "",
      "english": "no further becoming.”"
    }
  ]
}