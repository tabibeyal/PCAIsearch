{
  "sutta_id": "DHP288",
  "verses": [
    {
      "number": 1,
      "pali": "Paṭācārāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na santi puttā tāṇāya, ",
      "english": "Children provide you no shelter, "
    },
    {
      "number": 3,
      "pali": "na pitā nāpi bandhavā; ",
      "english": "nor does father, nor relatives. "
    },
    {
      "number": 4,
      "pali": "Antakenādhipannassa, ",
      "english": "When you’re seized by the terminator, "
    },
    {
      "number": 5,
      "pali": "natthi ñātīsu tāṇatā. ",
      "english": "there’s no shelter in family. "
    }
  ]
}