{
  "sutta_id": "DHP32",
  "verses": [
    {
      "number": 1,
      "pali": "Nigamavāsitissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamādarato bhikkhu, ",
      "english": "A mendicant who loves diligence, "
    },
    {
      "number": 3,
      "pali": "pamāde bhayadassi vā; ",
      "english": "seeing fear in negligence—"
    },
    {
      "number": 4,
      "pali": "Abhabbo parihānāya, ",
      "english": "such a one can’t decline, "
    },
    {
      "number": 5,
      "pali": "nibbānasseva santike. ",
      "english": "and has drawn near to extinguishment. "
    },
    {
      "number": 6,
      "pali": "Appamādavaggo dutiyo. ",
      "english": ""
    }
  ]
}