{
  "sutta_id": "SN1.41",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.41 ",
      "english": "Linked Discourses 1.41 "
    },
    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Ādittasutta ",
      "english": "On Fire "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s Monastery. "
    },
    {
      "number": 6,
      "pali": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ",
      "english": "Then, late at night, a glorious deity, lighting up the entire Jeta’s Grove, went up to the Buddha, bowed, stood to one side, "
    },
    {
      "number": 7,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imā gāthāyo abhāsi: ",
      "english": "and recited these verses in the Buddha’s presence: "
    },
    {
      "number": 8,
      "pali": "“Ādittasmiṁ agārasmiṁ, ",
      "english": "“When your house is on fire, "
    },
    {
      "number": 9,
      "pali": "yaṁ nīharati bhājanaṁ; ",
      "english": "you rescue the pot "
    },
    {
      "number": 10,
      "pali": "Taṁ tassa hoti atthāya, ",
      "english": "that’s useful, "
    },
    {
      "number": 11,
      "pali": "no ca yaṁ tattha ḍayhati. ",
      "english": "not the one that’s burnt. "
    },
    {
      "number": 12,
      "pali": "Evaṁ ādittako loko, ",
      "english": "And as the world is on fire "
    },
    {
      "number": 13,
      "pali": "jarāya maraṇena ca; ",
      "english": "with old age and death, "
    },
    {
      "number": 14,
      "pali": "Nīharetheva dānena, ",
      "english": "you should rescue by giving, "
    },
    {
      "number": 15,
      "pali": "dinnaṁ hoti sunīhataṁ. ",
      "english": "for what’s given is rescued. "
    },
    {
      "number": 16,
      "pali": "Dinnaṁ sukhaphalaṁ hoti, ",
      "english": "What’s given has happiness as its fruit, "
    },
    {
      "number": 17,
      "pali": "nādinnaṁ hoti taṁ tathā; ",
      "english": "but not what isn’t given. "
    },
    {
      "number": 18,
      "pali": "Corā haranti rājāno, ",
      "english": "Bandits take it, or rulers, "
    },
    {
      "number": 19,
      "pali": "aggi ḍahati nassati. ",
      "english": "it’s consumed by fire, or lost. "
    },
    {
      "number": 20,
      "pali": "Atha antena jahati, ",
      "english": "Then in the end this corpse is cast off, "
    },
    {
      "number": 21,
      "pali": "Sarīraṁ sapariggahaṁ; ",
      "english": "along with all your possessions. "
    },
    {
      "number": 22,
      "pali": "Etadaññāya medhāvī, ",
      "english": "Knowing this, a clever person "
    },
    {
      "number": 23,
      "pali": "Bhuñjetha ca dadetha ca; ",
      "english": "would enjoy what they have and also give it away. "
    },
    {
      "number": 24,
      "pali": "Datvā ca bhutvā ca yathānubhāvaṁ, ",
      "english": "After giving and using according to their means, "
    },
    {
      "number": 25,
      "pali": "Anindito saggamupeti ṭhānan”ti. ",
      "english": "blameless, they go to a heavenly place.” "
    }
  ]
}