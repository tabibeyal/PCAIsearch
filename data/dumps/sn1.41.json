{
  "sutta_id": "SN1.41",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.41",
      "english": "Linked Discourses 1.41"
    },
    {
      "number": 2,
      "pali": "Āditta Sutta",
      "english": "On Fire"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that on one occasion the Blessed One was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. Then a certain devatā, in the far extreme of the night, her extreme radiance lighting up the entirety of Jeta’s Grove, went to the Blessed One and, on arrival, having bowed down to him, stood to one side. As she was standing there, she recited these verses in the Blessed One’s presence:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“When a house is on fire,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "the vessel salvaged"
    },
    {
      "number": 6,
      "pali": "",
      "english": "is the one that will be of use,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "not the one left there to burn."
    },
    {
      "number": 8,
      "pali": "",
      "english": "So when the world is on fire"
    },
    {
      "number": 9,
      "pali": "",
      "english": "with aging & death,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "one should salvage (one’s wealth) by giving:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "what’s given is well salvaged."
    },
    {
      "number": 12,
      "pali": "",
      "english": "What’s given bears fruit as pleasure."
    },
    {
      "number": 13,
      "pali": "",
      "english": "What isn’t given does not:"
    },
    {
      "number": 14,
      "pali": "",
      "english": "thieves take it away, or kings;"
    },
    {
      "number": 15,
      "pali": "",
      "english": "it gets burnt by fire or lost."
    },
    {
      "number": 16,
      "pali": "",
      "english": "Then in the end"
    },
    {
      "number": 17,
      "pali": "",
      "english": "one leaves the body"
    },
    {
      "number": 18,
      "pali": "",
      "english": "together with one’s possessions."
    },
    {
      "number": 19,
      "pali": "",
      "english": "Knowing this, the intelligent man"
    },
    {
      "number": 20,
      "pali": "",
      "english": "enjoys possessions & gives."
    },
    {
      "number": 21,
      "pali": "",
      "english": "Having enjoyed & given"
    },
    {
      "number": 22,
      "pali": "",
      "english": "in line with his means,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "uncensured he goes"
    },
    {
      "number": 24,
      "pali": "",
      "english": "to the heavenly state.”"
    }
  ]
}