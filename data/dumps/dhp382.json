{
  "sutta_id": "DHP382",
  "verses": [
    {
      "number": 1,
      "pali": "Sumanasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo have daharo bhikkhu, ",
      "english": "A young mendicant "
    },
    {
      "number": 3,
      "pali": "yuñjati buddhasāsane; ",
      "english": "devoted to the Buddha’s teaching, "
    },
    {
      "number": 4,
      "pali": "Somaṁ lokaṁ pabhāseti, ",
      "english": "lights up the world, "
    },
    {
      "number": 5,
      "pali": "abbhā muttova candimā. ",
      "english": "like the moon freed from clouds. "
    },
    {
      "number": 6,
      "pali": "Bhikkhuvaggo pañcavīsatimo. ",
      "english": ""
    }
  ]
}