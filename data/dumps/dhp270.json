{
  "sutta_id": "DHP270",
  "verses": [
    {
      "number": 1,
      "pali": "Bālisikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na tena ariyo hoti, ",
      "english": "You don’t become a noble one "
    },
    {
      "number": 3,
      "pali": "yena pāṇāni hiṁsati; ",
      "english": "by harming living beings. "
    },
    {
      "number": 4,
      "pali": "Ahiṁsā sabbapāṇānaṁ, ",
      "english": "One harmless towards all living beings "
    },
    {
      "number": 5,
      "pali": "“ariyo”ti pavuccati. ",
      "english": "is said to be a noble one. "
    }
  ]
}