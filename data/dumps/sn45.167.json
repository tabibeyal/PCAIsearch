  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.167 ",
      "english": "Linked Discourses 45.167 "
    },
    {
      "number": 2,
      "pali": "13. Esanāvagga ",
      "english": "13. Searches "
    },
    {
      "number": 3,
      "pali": "Malasutta ",
      "english": "Stains "
    },
    {
      "number": 4,
      "pali": "“Tīṇimāni, bhikkhave, malāni. ",
      "english": "“Mendicants, there are these three stains. "
    },
    {
      "number": 5,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Rāgo malaṁ, doso malaṁ, moho malaṁ—",
      "english": "Greed, hate, and delusion. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, tīṇi malāni. ",
      "english": "These are the three stains. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, tiṇṇannaṁ malānaṁ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṁ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti. ",
      "english": "The noble eightfold path should be developed for the direct knowledge, complete understanding, finishing, and giving up of these three stains.” "
    },
    {
      "number": 9,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}