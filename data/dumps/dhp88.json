{
  "sutta_id": "DHP88",
  "verses": [
    {
      "number": 1,
      "pali": "Tatrābhiratimiccheyya, ",
      "english": "try to find satisfaction there, "
    },
    {
      "number": 2,
      "pali": "hitvā kāme akiñcano; ",
      "english": "having left behind sensual pleasures. "
    },
    {
      "number": 3,
      "pali": "Pariyodapeyya attānaṁ, ",
      "english": "Owning nothing, an astute person "
    },
    {
      "number": 4,
      "pali": "cittaklesehi paṇḍito. ",
      "english": "would cleanse themselves of mental corruptions. "
    }
  ]
}