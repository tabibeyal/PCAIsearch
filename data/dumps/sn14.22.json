{
  "sutta_id": "SN14.22",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 14.22 ",
      "english": "Linked Discourses 14.22 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Kusītamūlakasutta ",
      "english": "Beginning With the Lazy "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Kusītā kusītehi saddhiṁ saṁsandanti samenti; ",
      "english": "the lazy with the lazy … "
    },
    {
      "number": 7,
      "pali": "muṭṭhassatino muṭṭhassatīhi saddhiṁ saṁsandanti samenti; ",
      "english": "unmindful … "
    },
    {
      "number": 8,
      "pali": "duppaññā duppaññehi saddhiṁ saṁsandanti samenti; ",
      "english": "witless … "
    },
    {
      "number": 9,
      "pali": "āraddhavīriyā āraddhavīriyehi saddhiṁ saṁsandanti samenti; ",
      "english": "energetic … "
    },
    {
      "number": 10,
      "pali": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṁ saṁsandanti samenti; paññavanto paññavantehi saddhiṁ saṁsandanti samentī”ti …pe…. ",
      "english": "mindful … wise …” "
    },
    {
      "number": 11,
      "pali": "Dvādasamaṁ. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "(Sabbattha atītānāgatapaccuppannaṁ kātabbaṁ.) ",
      "english": "(Tell all in full for the past, future, and present.) "
    },
    {
      "number": 13,
      "pali": "Dutiyo vaggo. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Sattimā sanidānañca, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "giñjakāvasathena ca; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Hīnādhimutti caṅkamaṁ, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "sagāthā assaddhasattamaṁ. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Assaddhamūlakā pañca, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Cattāro ahirikamūlakā; ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Anottappamūlakā tīṇi, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Duve appassutena ca. ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Kusītaṁ ekakaṁ vuttaṁ, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Suttantā tīṇi pañcakā; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Bāvīsati vuttā suttā, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "Dutiyo vaggo pavuccatīti. ",
      "english": ""
    }
  ]
}