{
  "sutta_id": "DHP43",
  "verses": [
    {
      "number": 1,
      "pali": "Soreyyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na taṁ mātā pitā kayirā, ",
      "english": "A rightly directed mind "
    },
    {
      "number": 3,
      "pali": "aññe vāpi ca ñātakā; ",
      "english": "would do you more good "
    },
    {
      "number": 4,
      "pali": "Sammāpaṇihitaṁ cittaṁ, ",
      "english": "than your mother or father "
    },
    {
      "number": 5,
      "pali": "seyyaso naṁ tato kare. ",
      "english": "or any other relative. "
    },
    {
      "number": 6,
      "pali": "Cittavaggo tatiyo. ",
      "english": ""
    }
  ]
}