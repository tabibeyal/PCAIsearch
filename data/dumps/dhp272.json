{
  "sutta_id": "DHP272",
  "verses": [
    {
      "number": 1,
      "pali": "Phusāmi nekkhammasukhaṁ, ",
      "english": "do I experience the bliss of renunciation "
    },
    {
      "number": 2,
      "pali": "aputhujjanasevitaṁ; ",
      "english": "not frequented by ordinary people. "
    },
    {
      "number": 3,
      "pali": "Bhikkhu vissāsamāpādi, ",
      "english": "A mendicant cannot rest confident "
    },
    {
      "number": 4,
      "pali": "appatto āsavakkhayaṁ. ",
      "english": "without attaining the end of defilements. "
    },
    {
      "number": 5,
      "pali": "Dhammaṭṭhavaggo ekūnavīsatimo. ",
      "english": ""
    }
  ]
}