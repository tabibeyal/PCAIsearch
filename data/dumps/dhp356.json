{
  "sutta_id": "DHP356",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅkuravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Tiṇadosāni khettāni, ",
      "english": "Weeds are the bane of crops, "
    },
    {
      "number": 3,
      "pali": "rāgadosā ayaṁ pajā; ",
      "english": "but greed is these folk’s bane. "
    },
    {
      "number": 4,
      "pali": "Tasmā hi vītarāgesu, ",
      "english": "That’s why a gift to one rid of greed "
    },
    {
      "number": 5,
      "pali": "dinnaṁ hoti mahapphalaṁ. ",
      "english": "is so very fruitful. "
    }
  ]
}