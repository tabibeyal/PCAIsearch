{
  "sutta_id": "DHP394",
  "verses": [
    {
      "number": 1,
      "pali": "Kuhakabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kiṁ te jaṭāhi dummedha, ",
      "english": "Why the matted hair, you simpleton, "
    },
    {
      "number": 3,
      "pali": "kiṁ te ajinasāṭiyā; ",
      "english": "and why the skin of deer? "
    },
    {
      "number": 4,
      "pali": "Abbhantaraṁ te gahanaṁ, ",
      "english": "The tangle is inside you, "
    },
    {
      "number": 5,
      "pali": "bāhiraṁ parimajjasi. ",
      "english": "yet you polish up your outsides. "
    }
  ]
}