{
  "sutta_id": "AN4.120",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.120 ",
      "english": "Numbered Discourses 4.120 "
    },
    {
      "number": 2,
      "pali": "12. Kesivagga ",
      "english": "12. With Kesi "
    },
    {
      "number": 3,
      "pali": "Dutiyabhayasutta ",
      "english": "Perils (2nd) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, bhayāni. ",
      "english": "“Mendicants, there are these four perils. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Aggibhayaṁ, udakabhayaṁ, rājabhayaṁ, corabhayaṁ—",
      "english": "The perils of fire, water, kings, and bandits. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri bhayānī”ti. ",
      "english": "These are the four perils.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Kesivaggo dutiyo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Kesi javo patodo ca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Nāgo ṭhānena pañcamaṁ; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Appamādo ca ārakkho, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Saṁvejanīyañca dve bhayāti. ",
      "english": ""
    }
  ]
}