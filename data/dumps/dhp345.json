  "verses": [
    {
      "number": 1,
      "pali": "Bandhanāgāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na taṁ daḷhaṁ bandhanamāhu dhīrā, ",
      "english": "The attentive say that shackle is not strong "
    },
    {
      "number": 3,
      "pali": "Yadāyasaṁ dārujapabbajañca; ",
      "english": "that’s made of iron, wood, or knots. "
    },
    {
      "number": 4,
      "pali": "Sārattarattā maṇikuṇḍalesu, ",
      "english": "But obsession with jeweled earrings, "
    },
    {
      "number": 5,
      "pali": "Puttesu dāresu ca yā apekkhā. ",
      "english": "concern for your partners and children: "
    }
  ]
}