      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Saññāsutta ",
      "english": "Perceptions "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "rūpasaññā niccā vā aniccā vā”ti? ",
      "english": "Is perception of sights permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“saddasaññā …pe… ",
      "english": "“… perception of sounds … "
    },
    {
      "number": 9,
      "pali": "gandhasaññā … ",
      "english": "perception of smells … "
    },
    {
      "number": 10,
      "pali": "rasasaññā … ",
      "english": "perception of tastes … "
    },
    {
      "number": 11,
      "pali": "phoṭṭhabbasaññā … ",
      "english": "perception of touches … "
    },
    {
      "number": 12,
      "pali": "dhammasaññā niccā vā aniccā vā”ti? ",
      "english": "Is perception of ideas permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako rūpasaññāyapi nibbindati …pe… saddasaññāyapi nibbindati … gandhasaññāyapi nibbindati … rasasaññāyapi nibbindati … phoṭṭhabbasaññāyapi nibbindati … dhammasaññāyapi nibbindati …pe… ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with the perception of sights, sounds, smells, tastes, touches, and ideas. …” "
    },
    {
      "number": 15,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
