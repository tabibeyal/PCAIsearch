{
  "sutta_id": "ITI8",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 8",
      "english": "Itivuttaka 8"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, one who has not fully known & fully understood conceit, whose mind has not been cleansed of passion for it, has not abandoned it, is incapable of putting an end to stress. But one who has fully known & fully understood conceit, whose mind has been cleansed of passion for it, has abandoned it, is capable of putting an end to stress.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "People are"
    },
    {
      "number": 5,
      "pali": "",
      "english": "possessed by conceit"
    },
    {
      "number": 6,
      "pali": "",
      "english": "bound with conceit"
    },
    {
      "number": 7,
      "pali": "",
      "english": "delighted with becoming."
    },
    {
      "number": 8,
      "pali": "",
      "english": "Not comprehending conceit,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "they come to further becoming."
    },
    {
      "number": 10,
      "pali": "",
      "english": "But those who, letting go of conceit,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "are, in its destruction, released,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "conquering the bond of conceit,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "go beyond"
    },
    {
      "number": 14,
      "pali": "",
      "english": "all bonds."
    }
  ]
}