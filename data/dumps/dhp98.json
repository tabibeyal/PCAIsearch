{
  "sutta_id": "DHP98",
  "verses": [
    {
      "number": 1,
      "pali": "Khadiravaniyarevatattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Gāme vā yadi vāraññe, ",
      "english": "Whether in village or wilderness, "
    },
    {
      "number": 3,
      "pali": "Ninne vā yadi vā thale; ",
      "english": "in a valley or the uplands, "
    },
    {
      "number": 4,
      "pali": "Yattha arahanto viharanti, ",
      "english": "wherever the perfected ones live "
    },
    {
      "number": 5,
      "pali": "Taṁ bhūmirāmaṇeyyakaṁ. ",
      "english": "is a delightful place. "
    }
  ]
}