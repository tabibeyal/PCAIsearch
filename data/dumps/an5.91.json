    {
      "number": 2,
      "pali": "10. Kakudhavagga ",
      "english": "10. With Kakudha "
    },
    {
      "number": 3,
      "pali": "Paṭhamasampadāsutta ",
      "english": "Accomplishments (1st) "
    },
    {
      "number": 4,
      "pali": "“Pañcimā, bhikkhave, sampadā. ",
      "english": "“Mendicants, there are five accomplishments. "
    },
    {
      "number": 5,
      "pali": "Katamā pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhāsampadā, sīlasampadā, sutasampadā, cāgasampadā, paññāsampadā—",
      "english": "Accomplishment in faith, ethics, learning, generosity, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, pañca sampadā”ti. ",
      "english": "These are the five accomplishments.” "
    },
    {
      "number": 8,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
