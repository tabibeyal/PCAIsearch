      "number": 2,
      "pali": "8. Balakaraṇīyavagga ",
      "english": "8. Hard Work "
    },
    {
      "number": 3,
      "pali": "Balādisutta ",
      "english": "Hard Work, Etc. "
    },
    {
      "number": 4,
      "pali": "“Seyyathāpi, bhikkhave, ye keci balakaraṇīyā kammantā karīyantī”ti  ",
      "english": "“Mendicants, all the hard work that gets done depends on the earth and is grounded on the earth. …” "
    },
    {
      "number": 5,
      "pali": "vitthāretabbaṁ.",
      "english": "(Tell in full as in SN 45.149–160.) "
    },
    {
      "number": 6,
      "pali": "Balakaraṇīyavaggo aṭṭhamo. ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Balaṁ bījañca nāgo ca, ",
      "english": "Hard work, seeds, and dragons, "
    },
    {
      "number": 9,
      "pali": "rukkho kumbhena sūkiyā; ",
      "english": "a tree, a pot, and a spike, "
    },
    {
      "number": 10,
      "pali": "Ākāsena ca dve meghā, ",
      "english": "the atmosphere, and two on clouds, "
    },
    {
      "number": 11,
      "pali": "nāvā āgantukā nadīti. ",
      "english": "a ship, a guest house, and a river. "
    }
  ]
