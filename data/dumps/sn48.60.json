  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 48.60 ",
      "english": "Linked Discourses 48.60 "
    },
    {
      "number": 2,
      "pali": "6. Sūkarakhatavagga ",
      "english": "6. The Boar’s Cave "
    },
    {
      "number": 3,
      "pali": "Dutiyauppādasutta ",
      "english": "Arising (2nd) "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, indriyāni bhāvitāni bahulīkatāni anuppannāni uppajjanti, nāññatra sugatavinayā. ",
      "english": "“Mendicants, these five faculties don’t arise to be developed and cultivated apart from the Holy One’s training. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhindriyaṁ, vīriyindriyaṁ, satindriyaṁ, samādhindriyaṁ, paññindriyaṁ—",
      "english": "The faculties of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañcindriyāni bhāvitāni bahulīkatāni anuppannāni uppajjanti, nāññatra sugatavinayā”ti. ",
      "english": "These five faculties don’t arise to be developed and cultivated apart from the Holy One’s training.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Sūkarakhatavaggo chaṭṭho. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Sālaṁ mallikaṁ sekho ca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "padaṁ sāraṁ patiṭṭhitaṁ; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Brahmasūkarakhatāyo, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "uppādā apare duveti. ",
      "english": ""
    }
  ]
}