{
  "sutta_id": "DHP125",
  "verses": [
    {
      "number": 1,
      "pali": "Kokasunakhaluddakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo appaduṭṭhassa narassa dussati, ",
      "english": "Whoever wrongs a man who has done no wrong, "
    },
    {
      "number": 3,
      "pali": "Suddhassa posassa anaṅgaṇassa; ",
      "english": "a pure man who has not a blemish, "
    },
    {
      "number": 4,
      "pali": "Tameva bālaṁ pacceti pāpaṁ, ",
      "english": "the evil backfires on the fool, "
    },
    {
      "number": 5,
      "pali": "Sukhumo rajo paṭivātaṁva khitto. ",
      "english": "like fine dust thrown upwind. "
    }
  ]
}