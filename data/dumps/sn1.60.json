    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Kavisutta ",
      "english": "A Poet "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu nidānaṁ gāthānaṁ, ",
      "english": "“What’s the source of verses? "
    },
    {
      "number": 5,
      "pali": "kiṁsu tāsaṁ viyañjanaṁ; ",
      "english": "What constitutes their phrasing? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu sannissitā gāthā, ",
      "english": "What do verses depend upon? "
    },
    {
      "number": 7,
      "pali": "kiṁsu gāthānamāsayo”ti. ",
      "english": "What underlies verses?” "
    },
    {
      "number": 8,
      "pali": "“Chando nidānaṁ gāthānaṁ, ",
      "english": "“Metre is the source of verses. "
    },
    {
      "number": 9,
      "pali": "akkharā tāsaṁ viyañjanaṁ; ",
      "english": "Syllables constitute their phrasing. "
    },
    {
      "number": 10,
      "pali": "Nāmasannissitā gāthā, ",
      "english": "Verses depend on names. "
    },
    {
      "number": 11,
      "pali": "kavi gāthānamāsayo”ti. ",
      "english": "A poet underlies verses.” "
    },
    {
      "number": 12,
      "pali": "Jarāvaggo chaṭṭho. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Jarā ajarasā mittaṁ, ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "vatthu tīṇi janāni ca; ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Uppatho ca dutiyo ca, ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "kavinā pūrito vaggoti. ",
      "english": ""
    }
  ]
}