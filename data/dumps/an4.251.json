    },
    {
      "number": 2,
      "pali": "25. Āpattibhayavagga ",
      "english": "25. Perils of Offenses "
    },
    {
      "number": 3,
      "pali": "Dutiyavohārasutta ",
      "english": "Expressions (2nd) "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, ariyavohārā. ",
      "english": "“Mendicants, there are these four noble expressions. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Adiṭṭhe adiṭṭhavāditā, asute asutavāditā, amute amutavāditā, aviññāte aviññātavāditā—",
      "english": "Saying you haven’t seen, heard, thought, or known something, and you haven’t. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro ariyavohārā”ti. ",
      "english": "These are the four noble expressions.” "
    },
    {
      "number": 8,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}