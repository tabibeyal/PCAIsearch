{
  "sutta_id": "DHP369",
  "verses": [
    {
      "number": 1,
      "pali": "Siñca bhikkhu imaṁ nāvaṁ, ",
      "english": "Bail out this boat, mendicant! "
    },
    {
      "number": 2,
      "pali": "sittā te lahumessati; ",
      "english": "When bailed out it will float lightly. "
    },
    {
      "number": 3,
      "pali": "Chetvā rāgañca dosañca, ",
      "english": "Having cut off desire and hate, "
    },
    {
      "number": 4,
      "pali": "tato nibbānamehisi. ",
      "english": "you shall reach extinguishment. "
    }
  ]
}