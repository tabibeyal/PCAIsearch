{
  "sutta_id": "DHP355",
  "verses": [
    {
      "number": 1,
      "pali": "Aputtakaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Hananti bhogā dummedhaṁ, ",
      "english": "Riches ruin a simpleton, "
    },
    {
      "number": 3,
      "pali": "no ca pāragavesino; ",
      "english": "but not a seeker of the far shore. "
    },
    {
      "number": 4,
      "pali": "Bhogataṇhāya dummedho, ",
      "english": "From craving for wealth, a simpleton "
    },
    {
      "number": 5,
      "pali": "hanti aññeva attanaṁ. ",
      "english": "ruins themselves and others. "
    }
  ]
}