{
  "sutta_id": "DHP244",
  "verses": [
    {
      "number": 1,
      "pali": "Cūḷasāribhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sujīvaṁ ahirikena, ",
      "english": "Life is easy for the shameless. "
    },
    {
      "number": 3,
      "pali": "kākasūrena dhaṁsinā; ",
      "english": "With all the rude courage of a crow, "
    },
    {
      "number": 4,
      "pali": "Pakkhandinā pagabbhena, ",
      "english": "they live pushy, "
    },
    {
      "number": 5,
      "pali": "saṅkiliṭṭhena jīvitaṁ. ",
      "english": "rude, and corrupt. "
    }
  ]
}