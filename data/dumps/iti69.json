  "sutta_id": "ITI69",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 69",
      "english": "Itivuttaka 69"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, anyone–monk or nun–in whom passion is unabandoned, aversion is unabandoned, & delusion is unabandoned, is said not to have crossed the ocean with its waves, breakers, & whirlpools, its seizers & demons. Anyone–monk or nun–in whom passion is abandoned, aversion is abandoned, & delusion is abandoned, is said to have crossed the ocean with its waves, breakers, & whirlpools, its seizers & demons. Having crossed over, having reached the far shore, he/she stands on high ground, a brahman.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "One whose passion, aversion, & ignorance"
    },
    {
      "number": 5,
      "pali": "",
      "english": "have faded away,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "has crossed over this ocean"
    },
    {
      "number": 7,
      "pali": "",
      "english": "with its seizers,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "demons,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "dangerous waves,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "so hard to cross."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Free from acquisitions"
    },
    {
      "number": 12,
      "pali": "",
      "english": "–bonds surmounted,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "death abandoned–"
    },
    {
      "number": 14,
      "pali": "",
      "english": "he has abandoned stress"
    },
    {
      "number": 15,
      "pali": "",
      "english": "with no further becoming."
    },
    {
      "number": 16,
      "pali": "",
      "english": "Having gone to the goal"
    },
    {
      "number": 17,
      "pali": "",
      "english": "he"
    },
    {
      "number": 18,
      "pali": "",
      "english": "is undefined,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "has outwitted, I tell you,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "the King of Death."
    }
  ]
}