{
  "sutta_id": "DHP75",
  "verses": [
    {
      "number": 1,
      "pali": "Vanavāsitissasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Aññā hi lābhūpanisā, ",
      "english": "For the means to profit and the path to quenching "
    },
    {
      "number": 3,
      "pali": "aññā nibbānagāminī; ",
      "english": "are two quite different things. "
    },
    {
      "number": 4,
      "pali": "Evametaṁ abhiññāya, ",
      "english": "A mendicant disciple of the Buddha, "
    },
    {
      "number": 5,
      "pali": "bhikkhu buddhassa sāvako; ",
      "english": "understanding what this really means, "
    },
    {
      "number": 6,
      "pali": "Sakkāraṁ nābhinandeyya, ",
      "english": "would never delight in honors, "
    },
    {
      "number": 7,
      "pali": "vivekamanubrūhaye. ",
      "english": "but rather would foster seclusion. "
    },
    {
      "number": 8,
      "pali": "Bālavaggo pañcamo. ",
      "english": ""
    }
  ]
}