{
  "sutta_id": "AN2.88",
  "verses": [
    {
      "number": 1,
      "pali": "88 ",
      "english": "88 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Paggāho ca avikkhepo ca. ",
      "english": "Exertion, and not being scattered. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}