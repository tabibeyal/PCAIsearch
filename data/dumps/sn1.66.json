{
  "sutta_id": "SN1.66",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.66 ",
      "english": "Linked Discourses 1.66 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Attahatasutta ",
      "english": "Beaten Down "
    },
    {
      "number": 4,
      "pali": "“Kenassubbhāhato loko, ",
      "english": "“By what is the world beaten down? "
    },
    {
      "number": 5,
      "pali": "kenassu parivārito; ",
      "english": "By what is it surrounded? "
    },
    {
      "number": 6,
      "pali": "Kena sallena otiṇṇo, ",
      "english": "What dart has laid it low? "
    },
    {
      "number": 7,
      "pali": "kissa dhūpāyito sadā”ti. ",
      "english": "With what is it always fuming?” "
    },
    {
      "number": 8,
      "pali": "“Maccunābbhāhato loko, ",
      "english": "“The world is beaten down by death. "
    },
    {
      "number": 9,
      "pali": "jarāya parivārito; ",
      "english": "It’s surrounded by old age. "
    },
    {
      "number": 10,
      "pali": "Taṇhāsallena otiṇṇo, ",
      "english": "The dart of craving has laid it low. "
    },
    {
      "number": 11,
      "pali": "icchādhūpāyito sadā”ti. ",
      "english": "It’s always fuming with desire.” "
    }
  ]
}