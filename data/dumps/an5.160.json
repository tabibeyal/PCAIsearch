      "number": 2,
      "pali": "16. Saddhammavagga ",
      "english": "16. The True Teaching "
    },
    {
      "number": 3,
      "pali": "Duppaṭivinodayasutta ",
      "english": "Hard to Get Rid Of "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, uppannā duppaṭivinodayā. ",
      "english": "“Mendicants, these five things are hard to get rid of once they’ve arisen. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Uppanno rāgo duppaṭivinodayo, uppanno doso duppaṭivinodayo, uppanno moho duppaṭivinodayo, uppannaṁ paṭibhānaṁ duppaṭivinodayaṁ, uppannaṁ gamikacittaṁ duppaṭivinodayaṁ. ",
      "english": "Greed, hate, delusion, the feeling of being inspired to speak out, and thoughts of traveling. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, pañca uppannā duppaṭivinodayā”ti. ",
      "english": "These five things are hard to get rid of once they’ve arisen.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Saddhammavaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Tayo sammattaniyāmā, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "tayo saddhammasammosā; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Dukkathā ceva sārajjaṁ, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "udāyidubbinodayāti. ",
      "english": ""
    }
  ]
}