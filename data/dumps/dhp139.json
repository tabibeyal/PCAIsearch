{
  "sutta_id": "DHP139",
  "verses": [
    {
      "number": 1,
      "pali": "Rājato vā upasaggaṁ, ",
      "english": "hazards from rulers; "
    },
    {
      "number": 2,
      "pali": "Abbhakkhānaṁ va dāruṇaṁ; ",
      "english": "vicious slander; "
    },
    {
      "number": 3,
      "pali": "Parikkhayaṁ va ñātīnaṁ, ",
      "english": "loss of kin; "
    },
    {
      "number": 4,
      "pali": "Bhogānaṁ va pabhaṅguraṁ. ",
      "english": "destruction of wealth; "
    }
  ]
}