{
  "sutta_id": "DHP174",
  "verses": [
    {
      "number": 1,
      "pali": "Pesakāradhītāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Andhabhūto ayaṁ loko, ",
      "english": "Blind is the world, "
    },
    {
      "number": 3,
      "pali": "tanukettha vipassati; ",
      "english": "few are those who clearly see. "
    },
    {
      "number": 4,
      "pali": "Sakuṇo jālamuttova, ",
      "english": "Only a handful go to heaven, "
    },
    {
      "number": 5,
      "pali": "appo saggāya gacchati. ",
      "english": "like a bird freed from a net. "
    }
  ]
}