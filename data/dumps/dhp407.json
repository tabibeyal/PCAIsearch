{
  "sutta_id": "DHP407",
  "verses": [
    {
      "number": 1,
      "pali": "Mahāpanthakattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa rāgo ca doso ca, ",
      "english": "They’ve discarded greed and hate, "
    },
    {
      "number": 3,
      "pali": "māno makkho ca pātito; ",
      "english": "along with conceit and contempt, "
    },
    {
      "number": 4,
      "pali": "Sāsaporiva āraggā, ",
      "english": "like a mustard seed off the point of a pin: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}