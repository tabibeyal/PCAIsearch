{
  "sutta_id": "AN6.23",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 6.23 ",
      "english": "Numbered Discourses 6.23 "
    },
    {
      "number": 2,
      "pali": "3. Anuttariyavagga ",
      "english": "3. Unsurpassable "
    },
    {
      "number": 3,
      "pali": "Bhayasutta ",
      "english": "Dangers "
    },
    {
      "number": 4,
      "pali": "“‘Bhayan’ti, bhikkhave, kāmānametaṁ adhivacanaṁ; ",
      "english": "“‘Danger’, mendicants, is a term for sensual pleasures. "
    },
    {
      "number": 5,
      "pali": "‘dukkhan’ti, bhikkhave, kāmānametaṁ adhivacanaṁ; ",
      "english": "‘Suffering’, "
    },
    {
      "number": 6,
      "pali": "‘rogo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ; ",
      "english": "‘disease’, "
    },
    {
      "number": 7,
      "pali": "‘gaṇḍo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ; ",
      "english": "‘boil’, "
    },
    {
      "number": 8,
      "pali": "‘saṅgo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ; ",
      "english": "‘chain’, "
    },
    {
      "number": 9,
      "pali": "‘paṅko’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "and ‘bog’ are terms for sensual pleasures. "
    },
    {
      "number": 10,
      "pali": "Kasmā ca, bhikkhave, ‘bhayan’ti kāmānametaṁ adhivacanaṁ? ",
      "english": "And why is ‘danger’ a term for sensual pleasures? "
    },
    {
      "number": 11,
      "pali": "Kāmarāgarattāyaṁ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati, samparāyikāpi bhayā na parimuccati, tasmā ‘bhayan’ti kāmānametaṁ adhivacanaṁ. ",
      "english": "Someone who is besotted by sensual greed and shackled by lustful desire is not freed from dangers in this life or in lives to come. That is why ‘danger’ is a term for sensual pleasures. "
    },
    {
      "number": 12,
      "pali": "Kasmā ca, bhikkhave, dukkhanti …pe… ",
      "english": "And why are ‘suffering’, "
    },
    {
      "number": 13,
      "pali": "rogoti … ",
      "english": "‘disease’, "
    },
    {
      "number": 14,
      "pali": "gaṇḍoti … ",
      "english": "‘boil’, "
    },
    {
      "number": 15,
      "pali": "saṅgoti … ",
      "english": "‘snare’, "
    },
    {
      "number": 16,
      "pali": "paṅkoti kāmānametaṁ adhivacanaṁ? ",
      "english": "and ‘bog’ terms for sensual pleasures? "
    },
    {
      "number": 17,
      "pali": "Kāmarāgarattāyaṁ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi paṅkā na parimuccati, samparāyikāpi paṅkā na parimuccati, tasmā ‘paṅko’ti kāmānametaṁ adhivacananti. ",
      "english": "Someone who is besotted by sensual greed and shackled by lustful desire is not freed from suffering, disease, boils, chains, or bogs in this life or in lives to come. That is why these are terms for sensual pleasures. "
    },
    {
      "number": 18,
      "pali": "Bhayaṁ dukkhaṁ rogo gaṇḍo, ",
      "english": "Danger, suffering, disease, boils, "
    },
    {
      "number": 19,
      "pali": "saṅgo paṅko ca ubhayaṁ; ",
      "english": "and chains and bogs both. "
    },
    {
      "number": 20,
      "pali": "Ete kāmā pavuccanti, ",
      "english": "These describe the sensual pleasures "
    },
    {
      "number": 21,
      "pali": "yattha satto puthujjano. ",
      "english": "to which ordinary people are attached. "
    },
    {
      "number": 22,
      "pali": "Upādāne bhayaṁ disvā, ",
      "english": "Seeing the danger in grasping, "
    },
    {
      "number": 23,
      "pali": "jātimaraṇasambhave; ",
      "english": "the origin of birth and death, "
    },
    {
      "number": 24,
      "pali": "Anupādā vimuccanti, ",
      "english": "the unattached are freed "
    },
    {
      "number": 25,
      "pali": "jātimaraṇasaṅkhaye. ",
      "english": "with the ending of birth and death. "
    },
    {
      "number": 26,
      "pali": "Te khemappattā sukhino, ",
      "english": "Happy, they’ve come to a safe place, "
    },
    {
      "number": 27,
      "pali": "diṭṭhadhammābhinibbutā; ",
      "english": "quenched in this very life. "
    },
    {
      "number": 28,
      "pali": "Sabbaverabhayātītā, ",
      "english": "They’ve gone beyond all threats and dangers, "
    },
    {
      "number": 29,
      "pali": "sabbadukkhaṁ upaccagun”ti. ",
      "english": "and risen above all suffering.” "
    },
    {
      "number": 30,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}