{
  "sutta_id": "DHP353",
  "verses": [
    {
      "number": 1,
      "pali": "Upakājīvakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbābhibhū sabbavidūhamasmi, ",
      "english": "I am the champion, the knower of all, "
    },
    {
      "number": 3,
      "pali": "Sabbesu dhammesu anūpalitto; ",
      "english": "unsullied in the midst of all things. "
    },
    {
      "number": 4,
      "pali": "Sabbañjaho taṇhakkhaye vimutto, ",
      "english": "I’ve given up all, freed in the ending of craving. "
    },
    {
      "number": 5,
      "pali": "Sayaṁ abhiññāya kamuddiseyyaṁ. ",
      "english": "Since I know for myself, whose follower should I be? "
    }
  ]
}