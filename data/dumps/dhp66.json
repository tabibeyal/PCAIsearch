{
  "sutta_id": "DHP66",
  "verses": [
    {
      "number": 1,
      "pali": "Suppabuddhakuṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Caranti bālā dummedhā, ",
      "english": "Fools and simpletons behave "
    },
    {
      "number": 3,
      "pali": "amitteneva attanā; ",
      "english": "like their own worst enemies, "
    },
    {
      "number": 4,
      "pali": "Karontā pāpakaṁ kammaṁ, ",
      "english": "doing wicked deeds "
    },
    {
      "number": 5,
      "pali": "yaṁ hoti kaṭukapphalaṁ. ",
      "english": "that ripen as bitter fruit. "
    }
  ]
}