{
  "sutta_id": "AN5.15",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.15 ",
      "english": "Numbered Discourses 5.15 "
    },
    {
      "number": 2,
      "pali": "2. Balavagga ",
      "english": "2. Powers "
    },
    {
      "number": 3,
      "pali": "Daṭṭhabbasutta ",
      "english": "Should Be Seen "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these five powers. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhābalaṁ, vīriyabalaṁ, satibalaṁ, samādhibalaṁ, paññābalaṁ. ",
      "english": "The powers of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Kattha ca, bhikkhave, saddhābalaṁ daṭṭhabbaṁ? ",
      "english": "And where should the power of faith be seen? "
    },
    {
      "number": 8,
      "pali": "Catūsu sotāpattiyaṅgesu. ",
      "english": "In the four factors of stream-entry. "
    },
    {
      "number": 9,
      "pali": "Ettha saddhābalaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Kattha ca, bhikkhave, vīriyabalaṁ daṭṭhabbaṁ? ",
      "english": "And where should the power of energy be seen? "
    },
    {
      "number": 11,
      "pali": "Catūsu sammappadhānesu. ",
      "english": "In the four right efforts. "
    },
    {
      "number": 12,
      "pali": "Ettha vīriyabalaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Kattha ca, bhikkhave, satibalaṁ daṭṭhabbaṁ? ",
      "english": "And where should the power of mindfulness be seen? "
    },
    {
      "number": 14,
      "pali": "Catūsu satipaṭṭhānesu. ",
      "english": "In the four kinds of mindfulness meditation. "
    },
    {
      "number": 15,
      "pali": "Ettha satibalaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Kattha ca, bhikkhave, samādhibalaṁ daṭṭhabbaṁ? ",
      "english": "And where should the power of immersion be seen? "
    },
    {
      "number": 17,
      "pali": "Catūsu jhānesu. ",
      "english": "In the four absorptions. "
    },
    {
      "number": 18,
      "pali": "Ettha samādhibalaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Kattha ca, bhikkhave, paññābalaṁ daṭṭhabbaṁ? ",
      "english": "And where should the power of wisdom be seen? "
    },
    {
      "number": 20,
      "pali": "Catūsu ariyasaccesu. ",
      "english": "In the four noble truths. "
    },
    {
      "number": 21,
      "pali": "Ettha paññābalaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Imāni kho, bhikkhave, pañca balānī”ti. ",
      "english": "These are the five powers.” "
    },
    {
      "number": 23,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}