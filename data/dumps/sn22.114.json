{
  "sutta_id": "SN22.114",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.114 ",
      "english": "Linked Discourses 22.114 "
    },
    {
      "number": 2,
      "pali": "12. Dhammakathikavagga ",
      "english": "12. A Dhamma speaker "
    },
    {
      "number": 3,
      "pali": "Vijjāsutta ",
      "english": "Knowledge "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ nisinno kho so bhikkhu bhagavantaṁ etadavoca: ",
      "english": "Seated to one side, that mendicant said to the Buddha: "
    },
    {
      "number": 6,
      "pali": "“‘vijjā, vijjā’ti, bhante, vuccati. ",
      "english": "“Sir, they speak of this thing called ‘knowledge’. "
    },
    {
      "number": 7,
      "pali": "Katamā nu kho, bhante, vijjā; ",
      "english": "What is knowledge? "
    },
    {
      "number": 8,
      "pali": "kittāvatā ca vijjāgato hotī”ti? ",
      "english": "And how is a knowing one defined?” "
    },
    {
      "number": 9,
      "pali": "“Idha, bhikkhu, sutavā ariyasāvako rūpaṁ pajānāti, rūpasamudayaṁ … rūpanirodhaṁ … rūpanirodhagāminiṁ paṭipadaṁ pajānāti. ",
      "english": "“Mendicant, it’s when a learned noble disciple understands form, its origin, its cessation, and the practice that leads to its cessation. "
    },
    {
      "number": 10,
      "pali": "Vedanaṁ … ",
      "english": "They understand feeling … "
    },
    {
      "number": 11,
      "pali": "saññaṁ … ",
      "english": "perception … "
    },
    {
      "number": 12,
      "pali": "saṅkhāre pajānāti …pe… ",
      "english": "choices … "
    },
    {
      "number": 13,
      "pali": "viññāṇanirodhagāminiṁ paṭipadaṁ pajānāti. ",
      "english": "consciousness, its origin, its cessation, and the practice that leads to its cessation. "
    },
    {
      "number": 14,
      "pali": "Ayaṁ vuccati, bhikkhu, vijjā; ",
      "english": "This is called knowledge. "
    },
    {
      "number": 15,
      "pali": "ettāvatā ca vijjāgato hotī”ti. ",
      "english": "And this is how a knowing one is defined.” "
    },
    {
      "number": 16,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}