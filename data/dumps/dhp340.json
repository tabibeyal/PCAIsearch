{
  "sutta_id": "DHP340",
  "verses": [
    {
      "number": 1,
      "pali": "Savanti sabbadhi sotā, ",
      "english": "The streams flow everywhere; "
    },
    {
      "number": 2,
      "pali": "latā uppajja tiṭṭhati; ",
      "english": "a weed springs up and remains. "
    },
    {
      "number": 3,
      "pali": "Tañca disvā lataṁ jātaṁ, ",
      "english": "Seeing this weed that has been born, "
    },
    {
      "number": 4,
      "pali": "mūlaṁ paññāya chindatha. ",
      "english": "cut the root with wisdom. "
    }
  ]
}