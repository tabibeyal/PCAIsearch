{
  "sutta_id": "SN14.30",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 14.30 ",
      "english": "Linked Discourses 14.30 "
    },
    {
      "number": 2,
      "pali": "4. Catutthavagga ",
      "english": "4. Chapter Four "
    },
    {
      "number": 3,
      "pali": "Catudhātusutta ",
      "english": "Four Elements "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme … ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. … "
    },
    {
      "number": 5,
      "pali": "“catasso imā, bhikkhave, dhātuyo. ",
      "english": "“Mendicants, there are these four elements. "
    },
    {
      "number": 6,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 7,
      "pali": "Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu—",
      "english": "The elements of earth, water, fire, and air. "
    },
    {
      "number": 8,
      "pali": "imā kho, bhikkhave, catasso dhātuyo”ti. ",
      "english": "These are the four elements.” "
    },
    {
      "number": 9,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}