{
  "sutta_id": "DHP163",
  "verses": [
    {
      "number": 1,
      "pali": "Saṅghabhedaparisakkanavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sukarāni asādhūni, ",
      "english": "It’s easy to do bad things "
    },
    {
      "number": 3,
      "pali": "attano ahitāni ca; ",
      "english": "harmful to oneself, "
    },
    {
      "number": 4,
      "pali": "Yaṁ ve hitañca sādhuñca, ",
      "english": "but good things that are helpful "
    },
    {
      "number": 5,
      "pali": "taṁ ve paramadukkaraṁ. ",
      "english": "are the hardest things to do. "
    }
  ]
}