  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.93 ",
      "english": "Numbered Discourses 7.93 "
    },
    {
      "number": 2,
      "pali": "9. Samaṇavagga ",
      "english": "9. An Ascetic "
    },
    {
      "number": 3,
      "pali": "Asaddhammasutta ",
      "english": "Bad Qualities "
    },
    {
      "number": 4,
      "pali": "“Sattime, bhikkhave, asaddhammā. ",
      "english": "“Mendicants, there are these seven bad qualities. "
    },
    {
      "number": 5,
      "pali": "Katame satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Assaddho hoti, ahiriko hoti, anottappī hoti, appassuto hoti, kusīto hoti, muṭṭhassati hoti, duppañño hoti. ",
      "english": "Someone is faithless, shameless, imprudent, unlearned, lazy, unmindful, and witless. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, satta asaddhammā”ti. ",
      "english": "These are the seven bad qualities.” "
    },
    {
      "number": 8,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}