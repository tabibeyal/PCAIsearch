{
  "sutta_id": "ITI41",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 41",
      "english": "Itivuttaka 41"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, those beings are truly deprived who are deprived of noble discernment. They live in stress in the present life–troubled, distressed, & feverish–and at the break-up of the body, after death, a bad destination can be expected."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Those beings are not deprived who are not deprived of noble discernment. They live in ease in the present life–untroubled, undistressed, & not feverish–and at the break-up of the body, after death, a good destination can be expected."
    },
    {
      "number": 5,
      "pali": "",
      "english": "Look at the world"
    },
    {
      "number": 6,
      "pali": "",
      "english": "–including its heavenly beings:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "deprived of discernment,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "making an abode in name-&-form,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "it conceives that ‘This is the truth.’"
    },
    {
      "number": 10,
      "pali": "",
      "english": "The best discernment in the world"
    },
    {
      "number": 11,
      "pali": "",
      "english": "is what leads"
    },
    {
      "number": 12,
      "pali": "",
      "english": "to penetration,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "for it rightly discerns"
    },
    {
      "number": 14,
      "pali": "",
      "english": "the total ending of birth & becoming."
    },
    {
      "number": 15,
      "pali": "",
      "english": "Human & heavenly beings"
    },
    {
      "number": 16,
      "pali": "",
      "english": "hold them dear:"
    },
    {
      "number": 17,
      "pali": "",
      "english": "those who are"
    },
    {
      "number": 18,
      "pali": "",
      "english": "self-awakened,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "mindful,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "bearing their last bodies"
    },
    {
      "number": 21,
      "pali": "",
      "english": "with joyful discernment."
    }
  ]
}