{
  "sutta_id": "ITI48",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 48",
      "english": "Itivuttaka 48"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, these two are doomed to deprivation, to hell, for not abandoning their conduct. Which two? One who, not living the celibate life, pretends to be one who lives the celibate life; and one who groundlessly accuses one who lives the celibate life perfectly & purely of uncelibate behavior. These are the two who are doomed to deprivation, to hell, for not abandoning their conduct.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "He goes to hell,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "the one who asserts"
    },
    {
      "number": 6,
      "pali": "",
      "english": "what didn’t take place,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "as does the one"
    },
    {
      "number": 8,
      "pali": "",
      "english": "who, having done,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "says, ‘I didn’t.’"
    },
    {
      "number": 10,
      "pali": "",
      "english": "Both–low-acting people–"
    },
    {
      "number": 11,
      "pali": "",
      "english": "there become equal:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "after death, in the world beyond."
    },
    {
      "number": 13,
      "pali": "",
      "english": "An ochre robe tied ’round their necks,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "many with evil qualities"
    },
    {
      "number": 15,
      "pali": "",
      "english": "–unrestrained, evil–"
    },
    {
      "number": 16,
      "pali": "",
      "english": "rearise, because of their evil acts,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "in hell."
    },
    {
      "number": 18,
      "pali": "",
      "english": "Better to eat an iron ball"
    },
    {
      "number": 19,
      "pali": "",
      "english": "–glowing, aflame–"
    },
    {
      "number": 20,
      "pali": "",
      "english": "than that, unprincipled &"
    },
    {
      "number": 21,
      "pali": "",
      "english": "unrestrained,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "you should eat the alms of the country."
    }
  ]
}