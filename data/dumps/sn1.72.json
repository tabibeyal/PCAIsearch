{
  "sutta_id": "SN1.72",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.72 ",
      "english": "Linked Discourses 1.72 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Rathasutta ",
      "english": "A Chariot "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu rathassa paññāṇaṁ, ",
      "english": "“What is a chariot known by? "
    },
    {
      "number": 5,
      "pali": "kiṁsu paññāṇamaggino; ",
      "english": "What is fire known by? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu raṭṭhassa paññāṇaṁ, ",
      "english": "What is a nation known by? "
    },
    {
      "number": 7,
      "pali": "kiṁsu paññāṇamitthiyā”ti. ",
      "english": "What is a woman known by?” "
    },
    {
      "number": 8,
      "pali": "“Dhajo rathassa paññāṇaṁ, ",
      "english": "“A chariot is known by a banner. "
    },
    {
      "number": 9,
      "pali": "dhūmo paññāṇamaggino; ",
      "english": "Fire is known by smoke. "
    },
    {
      "number": 10,
      "pali": "Rājā raṭṭhassa paññāṇaṁ, ",
      "english": "A nation is known by its ruler. "
    },
    {
      "number": 11,
      "pali": "bhattā paññāṇamitthiyā”ti. ",
      "english": "A woman is known by her husband.” "
    }
  ]
}