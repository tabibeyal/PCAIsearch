    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Assaddhā assaddhehi saddhiṁ saṁsandanti samenti; ",
      "english": "the faithless with the faithless, "
    },
    {
      "number": 7,
      "pali": "ahirikā ahirikehi saddhiṁ saṁsandanti samenti; ",
      "english": "the unconscientious with the unconscientious, "
    },
    {
      "number": 8,
      "pali": "anottappino anottappīhi saddhiṁ saṁsandanti samenti; ",
      "english": "the imprudent with the imprudent, "
    },
    {
      "number": 9,
      "pali": "appassutā appassutehi saddhiṁ saṁsandanti samenti; ",
      "english": "the unlearned with the unlearned, "
    },
    {
      "number": 10,
      "pali": "kusītā kusītehi saddhiṁ saṁsandanti samenti; ",
      "english": "the lazy with the lazy, "
    },
    {
      "number": 11,
      "pali": "muṭṭhassatino muṭṭhassatīhi saddhiṁ saṁsandanti samenti; ",
      "english": "the unmindful with the unmindful, "
    },
    {
      "number": 12,
      "pali": "duppaññā duppaññehi saddhiṁ saṁsandanti samenti. ",
      "english": "and the witless with the witless. "
    },
