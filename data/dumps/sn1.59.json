  "sutta_id": "SN1.59",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.59 ",
      "english": "Linked Discourses 1.59 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Dutiyasutta ",
      "english": "A Partner "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu dutiyā purisassa hoti, ",
      "english": "“What is a person’s partner? "
    },
    {
      "number": 5,
      "pali": "Kiṁsu cenaṁ pasāsati; ",
      "english": "What instructs them? "
    },
    {
      "number": 6,
      "pali": "Kissa cābhirato macco, ",
      "english": "Enjoying what is a mortal "
    },
    {
      "number": 7,
      "pali": "Sabbadukkhā pamuccatī”ti. ",
      "english": "released from all suffering?” "
    },
    {
      "number": 8,
      "pali": "“Saddhā dutiyā purisassa hoti, ",
      "english": "“Faith is a person’s partner. "
    },
    {
      "number": 9,
      "pali": "Paññā cenaṁ pasāsati; ",
      "english": "Wisdom instructs them. "
    },
    {
      "number": 10,
      "pali": "Nibbānābhirato macco, ",
      "english": "Delighting in extinguishment a mortal "
    },
    {
      "number": 11,
      "pali": "Sabbadukkhā pamuccatī”ti. ",
      "english": "is released from all suffering.” "
    }
  ]
}