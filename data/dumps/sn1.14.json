{
  "sutta_id": "SN1.14",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.14 ",
      "english": "Linked Discourses 1.14 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Khattiyasutta ",
      "english": "Aristocrats "
    },
    {
      "number": 4,
      "pali": "“Khattiyo dvipadaṁ seṭṭho, ",
      "english": "“An aristocrat is the best of bipeds, "
    },
    {
      "number": 5,
      "pali": "balībaddo catuppadaṁ; ",
      "english": "an ox is the best of quadrupeds, "
    },
    {
      "number": 6,
      "pali": "Komārī seṭṭhā bhariyānaṁ, ",
      "english": "a maiden is the best of wives, "
    },
    {
      "number": 7,
      "pali": "yo ca puttāna pubbajo”ti. ",
      "english": "and a first-born the best of sons.” "
    },
    {
      "number": 8,
      "pali": "“Sambuddho dvipadaṁ seṭṭho, ",
      "english": "“A Buddha is the best of bipeds, "
    },
    {
      "number": 9,
      "pali": "ājānīyo catuppadaṁ; ",
      "english": "a thoroughbred, the best of quadrupeds, "
    },
    {
      "number": 10,
      "pali": "Sussūsā seṭṭhā bhariyānaṁ, ",
      "english": "a good listener is the best of wives, "
    },
    {
      "number": 11,
      "pali": "yo ca puttānamassavo”ti. ",
      "english": "and the best of sons is loyal.” "
    }
  ]
}