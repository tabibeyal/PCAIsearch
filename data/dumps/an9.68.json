      "number": 1,
      "pali": "Aṅguttara Nikāya 9.68 ",
      "english": "Numbered Discourses 9.68 "
    },
    {
      "number": 2,
      "pali": "7. Satipaṭṭhānavagga ",
      "english": "7. Mindfulness Meditation "
    },
    {
      "number": 3,
      "pali": "Gatisutta ",
      "english": "Places of Rebirth "
    },
    {
      "number": 4,
      "pali": "“Pañcimā, bhikkhave, gatiyo. ",
      "english": "“Mendicants, there are five destinations. "
    },
    {
      "number": 5,
      "pali": "Katamā pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Nirayo, tiracchānayoni, pettivisayo, manussā, devā—",
      "english": "Hell, the animal realm, the ghost realm, humanity, and the gods. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, pañca gatiyo. ",
      "english": "These are the five destinations. "
    },
    {
      "number": 8,
      "pali": "Imāsaṁ kho, bhikkhave, pañcannaṁ gatīnaṁ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbā”ti. ",
      "english": "To give up these five destinations you should develop the four kinds of mindfulness meditation. …” "
    },
    {
      "number": 9,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}