{
  "sutta_id": "ITI47",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 47",
      "english": "Itivuttaka 47"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, a monk should be wakeful: mindful, alert, centered, sensitive, clear, & calm. And there he should, at the appropriate times, see clearly into skillful mental qualities. For a monk who is wakeful–mindful, alert, centered, sensitive, clear, & calm, seeing clearly, at the appropriate times, into skillful mental qualities–one of two fruits can be expected: either gnosis right in the here-&-now, or–if there be any remnant of clinging-sustenance–non-return.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Those who are wakeful, listen to this!"
    },
    {
      "number": 5,
      "pali": "",
      "english": "Those who are sleeping, wake up!"
    },
    {
      "number": 6,
      "pali": "",
      "english": "Wakefulness is better than sleep."
    },
    {
      "number": 7,
      "pali": "",
      "english": "For those who are wakeful,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "there’s no danger, no fear."
    },
    {
      "number": 9,
      "pali": "",
      "english": "Whoever is wakeful,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "mindful, alert,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "centered, sensitive,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "calm, & clear,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "rightly exploring the Dhamma"
    },
    {
      "number": 14,
      "pali": "",
      "english": "at appropriate times,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "he–on becoming unified–"
    },
    {
      "number": 16,
      "pali": "",
      "english": "could shatter the darkness."
    },
    {
      "number": 17,
      "pali": "",
      "english": "So be devoted to wakefulness."
    },
    {
      "number": 18,
      "pali": "",
      "english": "The ardent monk"
    },
    {
      "number": 19,
      "pali": "",
      "english": "–masterful, acquiring jhāna,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "cutting the fetter of birth & aging–"
    },
    {
      "number": 21,
      "pali": "",
      "english": "touches right here"
    },
    {
      "number": 22,
      "pali": "",
      "english": "a self-awakening un-"
    },
    {
      "number": 23,
      "pali": "",
      "english": "surpassed."
    }
  ]
}