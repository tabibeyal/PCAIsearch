{
  "sutta_id": "DHP89",
  "verses": [
    {
      "number": 1,
      "pali": "Yesaṁ sambodhiyaṅgesu, ",
      "english": "Those whose minds are rightly developed "
    },
    {
      "number": 2,
      "pali": "sammā cittaṁ subhāvitaṁ; ",
      "english": "in the awakening factors; "
    },
    {
      "number": 3,
      "pali": "Ādānapaṭinissagge, ",
      "english": "who, letting go of attachments, "
    },
    {
      "number": 4,
      "pali": "anupādāya ye ratā; ",
      "english": "delight in not grasping: "
    },
    {
      "number": 5,
      "pali": "Khīṇāsavā jutimanto, ",
      "english": "with defilements ended, brilliant, "
    },
    {
      "number": 6,
      "pali": "te loke parinibbutā. ",
      "english": "they are quenched in this world. "
    },
    {
      "number": 7,
      "pali": "Paṇḍitavaggo chaṭṭho. ",
      "english": ""
    }
  ]
}