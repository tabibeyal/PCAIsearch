{
  "sutta_id": "DHP352",
  "verses": [
    {
      "number": 1,
      "pali": "Vītataṇho anādāno, ",
      "english": "Rid of craving, free of grasping, "
    },
    {
      "number": 2,
      "pali": "Niruttipadakovido; ",
      "english": "expert in the definition of terms, "
    },
    {
      "number": 3,
      "pali": "Akkharānaṁ sannipātaṁ, ",
      "english": "knowing the correct "
    },
    {
      "number": 4,
      "pali": "Jaññā pubbāparāni ca; ",
      "english": "structure and sequence of syllables, "
    },
    {
      "number": 5,
      "pali": "Sa ve “antimasārīro, ",
      "english": "they are said to be one who bears their final body, "
    },
    {
      "number": 6,
      "pali": "Mahāpañño mahāpuriso”ti vuccati. ",
      "english": "one of great wisdom, a great person. "
    }
  ]
}