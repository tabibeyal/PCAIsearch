      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Rūpasutta ",
      "english": "Sights, Etc. "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "rūpā niccā vā aniccā vā”ti? ",
      "english": "Are sights permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” …pe… ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "saddā … ",
      "english": "“… sounds … "
    },
    {
      "number": 9,
      "pali": "gandhā … ",
      "english": "smells … "
    },
    {
      "number": 10,
      "pali": "rasā … ",
      "english": "tastes … "
    },
    {
      "number": 11,
      "pali": "phoṭṭhabbā … ",
      "english": "touches … "
    },
    {
      "number": 12,
      "pali": "dhammā niccā vā aniccā vā”ti? ",
      "english": "Are ideas permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako rūpesupi nibbindati … saddesupi nibbindati … gandhesupi nibbindati … rasesupi nibbindati … phoṭṭhabbesupi nibbindati … dhammesupi nibbindati; ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with sights, sounds, smells, tastes, touches, and ideas. "
    },
    {
      "number": 15,
      "pali": "nibbindaṁ virajjati …pe… ",
      "english": "Being disillusioned, desire fades away. …” "
    },
    {
      "number": 16,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Dutiyaṁ. ",
      "english": ""
