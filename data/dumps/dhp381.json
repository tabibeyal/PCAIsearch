{
  "sutta_id": "DHP381",
  "verses": [
    {
      "number": 1,
      "pali": "Vakkalittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pāmojjabahulo bhikkhu, ",
      "english": "A monk full of joy "
    },
    {
      "number": 3,
      "pali": "pasanno buddhasāsane; ",
      "english": "trusting in the Buddha’s teaching, "
    },
    {
      "number": 4,
      "pali": "Adhigacche padaṁ santaṁ, ",
      "english": "would realize the peaceful state, "
    },
    {
      "number": 5,
      "pali": "saṅkhārūpasamaṁ sukhaṁ. ",
      "english": "the blissful stilling of conditions. "
    }
  ]
}