  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.172 ",
      "english": "Linked Discourses 45.172 "
    },
    {
      "number": 2,
      "pali": "14. Oghavagga ",
      "english": "14. Floods "
    },
    {
      "number": 3,
      "pali": "Yogasutta ",
      "english": "Yokes "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, yogā. ",
      "english": "“Mendicants, there are these four yokes. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Kāmayogo, bhavayogo, diṭṭhiyogo avijjāyogo—",
      "english": "The yokes of sensual pleasures, future lives, views, and ignorance. "
    },
    {
      "number": 7,
      "pali": "ime kho, bhikkhave, cattāro yogā. ",
      "english": "These are the four yokes. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, catunnaṁ yogānaṁ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṁ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti. ",
      "english": "The noble eightfold path should be developed for the direct knowledge, complete understanding, finishing, and giving up of these four yokes.” "
    },
    {
      "number": 9,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}