{
  "sutta_id": "DHP322",
  "verses": [
    {
      "number": 1,
      "pali": "Varamassatarā dantā, ",
      "english": "Those who have tamed themselves are better "
    },
    {
      "number": 2,
      "pali": "ājānīyā ca sindhavā; ",
      "english": "than fine tamed mules, "
    },
    {
      "number": 3,
      "pali": "Kuñjarā ca mahānāgā, ",
      "english": "thoroughbreds from Sindh, "
    },
    {
      "number": 4,
      "pali": "attadanto tato varaṁ. ",
      "english": "or giant tuskers. "
    }
  ]
}