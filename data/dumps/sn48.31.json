  "sutta_id": "SN48.31",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 48.31 ",
      "english": "Linked Discourses 48.31 "
    },
    {
      "number": 2,
      "pali": "4. Sukhindriyavagga ",
      "english": "4. The Pleasure Faculty "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these five faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Sukhindriyaṁ, dukkhindriyaṁ, somanassindriyaṁ, domanassindriyaṁ, upekkhindriyaṁ—",
      "english": "The faculties of pleasure, pain, happiness, sadness, and equanimity. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañcindriyānī”ti. ",
      "english": "These are the five faculties.” "
    },
    {
      "number": 8,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}