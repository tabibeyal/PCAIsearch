{
  "sutta_id": "AN2.102",
  "verses": [
    {
      "number": 1,
      "pali": "102 ",
      "english": "102 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, bālā. ",
      "english": "“Mendicants, there are two fools. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Yo ca anāpattiyā āpattisaññī, yo ca āpattiyā anāpattisaññī. ",
      "english": "One who perceives a non-offense as an offense, and one who perceives an offense as a non-offense. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve bālā”ti. ",
      "english": "These are the two fools.” "
    }
  ]
}