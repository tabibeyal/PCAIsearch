{
  "sutta_id": "AN4.145",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.145 ",
      "english": "Numbered Discourses 4.145 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Pajjotasutta ",
      "english": "Lamps "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, pajjotā. ",
      "english": "“Mendicants, there are these four lamps. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Candapajjoto, sūriyapajjoto, aggipajjoto, paññāpajjoto—",
      "english": "The lamps of the moon, sun, fire, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro pajjotā. ",
      "english": "These are the four lamps. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ catunnaṁ pajjotānaṁ yadidaṁ paññāpajjoto”ti. ",
      "english": "The best of these four lamps is the lamp of wisdom.” "
    },
    {
      "number": 9,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}