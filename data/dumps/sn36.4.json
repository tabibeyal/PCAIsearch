{
  "sutta_id": "SN36.4",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 36.4",
      "english": "Linked Discourses 36.4"
    },
    {
      "number": 2,
      "pali": "Pātāla Sutta",
      "english": "The Bottomless Chasm"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“Monks, when an uninstructed run-of-the-mill person makes the statement, ‘There is a bottomless chasm in the ocean,’ he is talking about something that doesn’t exist, that can’t be found. The word ‘bottomless chasm’ is actually a designation for painful bodily feeling."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“When an uninstructed run-of-the-mill person is touched by a painful bodily feeling, he sorrows, grieves, & laments, beats his breast, becomes distraught. This is called an uninstructed run-of-the-mill person who has not risen up out of the bottomless chasm, who has not gained a foothold."
    },
    {
      "number": 5,
      "pali": "",
      "english": "“When a well-instructed disciple of the noble ones is touched by a painful bodily feeling, he does not sorrow, grieve, or lament, does not beat his breast or become distraught. This is called a well-instructed disciple of the noble ones who has risen up out of the bottomless chasm, whose foothold is gained.”"
    },
    {
      "number": 6,
      "pali": "",
      "english": "Whoever can’t endure them"
    },
    {
      "number": 7,
      "pali": "",
      "english": "once they’ve arisen—"
    },
    {
      "number": 8,
      "pali": "",
      "english": "painful bodily feelings"
    },
    {
      "number": 9,
      "pali": "",
      "english": "that could kill living beings—"
    },
    {
      "number": 10,
      "pali": "",
      "english": "who trembles at their touch,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "who cries & wails,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "a weakling with no resilience:"
    },
    {
      "number": 13,
      "pali": "",
      "english": "He hasn’t risen up"
    },
    {
      "number": 14,
      "pali": "",
      "english": "out of the bottomless chasm"
    },
    {
      "number": 15,
      "pali": "",
      "english": "or even gained"
    },
    {
      "number": 16,
      "pali": "",
      "english": "a foothold."
    },
    {
      "number": 17,
      "pali": "",
      "english": "Whoever endures them"
    },
    {
      "number": 18,
      "pali": "",
      "english": "once they’ve arisen—"
    },
    {
      "number": 19,
      "pali": "",
      "english": "painful bodily feelings"
    },
    {
      "number": 20,
      "pali": "",
      "english": "that could kill living beings—"
    },
    {
      "number": 21,
      "pali": "",
      "english": "who doesn’t tremble at their touch:"
    },
    {
      "number": 22,
      "pali": "",
      "english": "He’s risen up"
    },
    {
      "number": 23,
      "pali": "",
      "english": "out of the bottomless chasm;"
    },
    {
      "number": 24,
      "pali": "",
      "english": "his foothold is gained."
    }
  ]
}