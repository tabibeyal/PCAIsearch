{
  "sutta_id": "KHP5",
  "verses": [
    {
      "number": 1,
      "pali": "Khuddakapatha 5",
      "english": "Khuddakapatha 5"
    },
    {
      "number": 2,
      "pali": "Maṅgala Sutta",
      "english": "Protection"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that at one time the Blessed One was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. Then a certain deva, in the far extreme of the night, her extreme radiance lighting up the entirety of Jeta’s Grove, went to the Blessed One. On arrival, having bowed down to him, she stood to one side. As she was standing there, she addressed him with a verse."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Many devas & human beings"
    },
    {
      "number": 5,
      "pali": "",
      "english": "give thought to protection,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "desiring well-being."
    },
    {
      "number": 7,
      "pali": "",
      "english": "Tell, then, the highest protection.”"
    },
    {
      "number": 8,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 9,
      "pali": "",
      "english": "“Not consorting with fools,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "consorting with the wise,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "paying homage to those worthy of homage:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Living in a civilized land,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "having made merit in the past,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "directing oneself rightly:"
    },
    {
      "number": 16,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 17,
      "pali": "",
      "english": "Broad knowledge, skill,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "well-mastered discipline,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "well-spoken words:"
    },
    {
      "number": 20,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 21,
      "pali": "",
      "english": "Support for one’s mother & father,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "assistance to one’s wife and children,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "consistency in one’s work:"
    },
    {
      "number": 24,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 25,
      "pali": "",
      "english": "Generosity, living in rectitude,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "assistance to one’s relatives,"
    },
    {
      "number": 27,
      "pali": "",
      "english": "deeds that are blameless:"
    },
    {
      "number": 28,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 29,
      "pali": "",
      "english": "Avoiding, abstaining from evil;"
    },
    {
      "number": 30,
      "pali": "",
      "english": "refraining from intoxicants,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "being heedful of the mental qualities"
    },
    {
      "number": 32,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 33,
      "pali": "",
      "english": "Respect, humility,"
    },
    {
      "number": 34,
      "pali": "",
      "english": "contentment, gratitude,"
    },
    {
      "number": 35,
      "pali": "",
      "english": "hearing the Dhamma on timely occasions:"
    },
    {
      "number": 36,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 37,
      "pali": "",
      "english": "Patience, being easy to instruct,"
    },
    {
      "number": 38,
      "pali": "",
      "english": "seeing contemplatives,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "discussing the Dhamma on timely occasions:"
    },
    {
      "number": 40,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 41,
      "pali": "",
      "english": "Austerity, celibacy,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "seeing the noble truths,"
    },
    {
      "number": 43,
      "pali": "",
      "english": "realizing unbinding:"
    },
    {
      "number": 44,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 45,
      "pali": "",
      "english": "A mind that, when touched"
    },
    {
      "number": 46,
      "pali": "",
      "english": "by the ways of the world,"
    },
    {
      "number": 47,
      "pali": "",
      "english": "is unshaken, sorrowless, dustless, at rest:"
    },
    {
      "number": 48,
      "pali": "",
      "english": "This is the highest protection."
    },
    {
      "number": 49,
      "pali": "",
      "english": "When acting in this way,"
    },
    {
      "number": 50,
      "pali": "",
      "english": "everywhere undefeated,"
    },
    {
      "number": 51,
      "pali": "",
      "english": "people go everywhere in well-being:"
    },
    {
      "number": 52,
      "pali": "",
      "english": "This is their highest protection.”"
    }
  ]
}