    {
      "number": 3,
      "pali": "163 ",
      "english": "163 "
    },
    {
      "number": 4,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 5,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Samāpattikusalatā ca samāpattivuṭṭhānakusalatā ca. ",
      "english": "Skill in meditative attainments and skill in emerging from those attainments. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}