      "number": 1,
      "pali": "Khuddakanikāya ",
      "english": "Minor Collection "
    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 116–128 "
    },
    {
      "number": 3,
      "pali": "Pāpavagga ",
      "english": "9. Wickedness "
    },
    {
      "number": 4,
      "pali": "Cūḷekasāṭakabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Abhittharetha kalyāṇe, ",
      "english": "Rush to do good, "
    },
    {
      "number": 6,
      "pali": "pāpā cittaṁ nivāraye; ",
      "english": "shield your mind from evil; "
    },
    {
      "number": 7,
      "pali": "Dandhañhi karoto puññaṁ, ",
      "english": "for when you’re slow to do good, "
    },
    {
      "number": 8,
      "pali": "pāpasmiṁ ramatī mano. ",
      "english": "your thoughts delight in wickedness. "
    }
  ]
}