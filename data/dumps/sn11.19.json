{
  "sutta_id": "SN11.19",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.19 ",
      "english": "Linked Discourses 11.19 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Satthāravandanāsutta ",
      "english": "Who Sakka Worships "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ jetavane. ",
      "english": "Near Sāvatthī in Jeta’s Grove. "
    },
    {
      "number": 5,
      "pali": "“Bhūtapubbaṁ, bhikkhave, sakko devānamindo mātaliṁ saṅgāhakaṁ āmantesi: ",
      "english": "“Once upon a time, mendicants, Sakka, lord of gods, addressed his chariot handler Mātali, "
    },
    {
      "number": 6,
      "pali": "‘yojehi, samma mātali, sahassayuttaṁ ājaññarathaṁ, uyyānabhūmiṁ gacchāma subhūmiṁ dassanāyā’ti. ",
      "english": "‘My dear Mātali, harness the chariot with its team of a thousand thoroughbreds. We will go to a park and see the scenery.’ "
    },
    {
      "number": 7,
      "pali": "‘Evaṁ, bhaddantavā’ti kho, bhikkhave, mātali saṅgāhako sakkassa devānamindassa paṭissutvā sahassayuttaṁ ājaññarathaṁ yojetvā sakkassa devānamindassa paṭivedesi: ",
      "english": "‘Yes, lord,’ replied Mātali. He harnessed the chariot and informed Sakka, "
    },
    {
      "number": 8,
      "pali": "‘yutto kho te, mārisa, sahassayutto ājaññaratho. ",
      "english": "‘Good fellow, the chariot with its team of a thousand thoroughbreds has been harnessed. "
    },
    {
      "number": 9,
      "pali": "Yassadāni kālaṁ maññasī’ti. ",
      "english": "Please go at your convenience.’ "
    },
    {
      "number": 10,
      "pali": "Atha kho, bhikkhave, sakko devānamindo vejayantapāsādā orohanto añjaliṁ katvā sudaṁ bhagavantaṁ namassati. ",
      "english": "Then Sakka descended from the Palace of Victory, raised his cupped palms, and revered the Buddha. "
    },
    {
      "number": 11,
      "pali": "Atha kho, bhikkhave, mātali saṅgāhako sakkaṁ devānamindaṁ gāthāya ajjhabhāsi: ",
      "english": "So Mātali the chariot handler addressed Sakka in verse: "
    },
    {
      "number": 12,
      "pali": "‘Yañhi devā manussā ca, ",
      "english": "‘Gods and men "
    },
    {
      "number": 13,
      "pali": "taṁ namassanti vāsava; ",
      "english": "worship you, Vāsava. "
    },
    {
      "number": 14,
      "pali": "Atha ko nāma so yakkho, ",
      "english": "So what’s the name of the spirit "
    },
    {
      "number": 15,
      "pali": "yaṁ tvaṁ sakka namassasī’ti. ",
      "english": "that you worship, Sakka?’ "
    },
    {
      "number": 16,
      "pali": "‘Yo idha sammāsambuddho, ",
      "english": "‘It’s the fully awakened Buddha, "
    },
    {
      "number": 17,
      "pali": "asmiṁ loke sadevake; ",
      "english": "the Teacher of peerless name "
    },
    {
      "number": 18,
      "pali": "Anomanāmaṁ satthāraṁ, ",
      "english": "in this world with its gods—"
    },
    {
      "number": 19,
      "pali": "taṁ namassāmi mātali. ",
      "english": "that’s who I worship, Mātali. "
    },
    {
      "number": 20,
      "pali": "Yesaṁ rāgo ca doso ca, ",
      "english": "Those in whom greed, hate, and ignorance "
    },
    {
      "number": 21,
      "pali": "avijjā ca virājitā; ",
      "english": "have faded away; "
    },
    {
      "number": 22,
      "pali": "Khīṇāsavā arahanto, ",
      "english": "the perfected ones with defilements ended—"
    },
    {
      "number": 23,
      "pali": "te namassāmi mātali. ",
      "english": "they’re who I worship, Mātali. "
    },
    {
      "number": 24,
      "pali": "Ye rāgadosavinayā, ",
      "english": "The trainees who enjoy reducing suffering, "
    },
    {
      "number": 25,
      "pali": "avijjāsamatikkamā; ",
      "english": "diligently pursuing the training "
    },
    {
      "number": 26,
      "pali": "Sekkhā apacayārāmā, ",
      "english": "for getting rid of greed and hate, "
    },
    {
      "number": 27,
      "pali": "appamattānusikkhare; ",
      "english": "and going past ignorance—"
    },
    {
      "number": 28,
      "pali": "Te namassāmi mātalī’ti. ",
      "english": "they’re who I worship, Mātali.’ "
    },
    {
      "number": 29,
      "pali": "‘Seṭṭhā hi kira lokasmiṁ, ",
      "english": "‘Those who you worship "
    },
    {
      "number": 30,
      "pali": "ye tvaṁ sakka namassasi; ",
      "english": "seem to be the best in the world, Sakka. "
    },
    {
      "number": 31,
      "pali": "Ahampi te namassāmi, ",
      "english": "I too will worship "
    },
    {
      "number": 32,
      "pali": "ye namassasi vāsavā’ti. ",
      "english": "those who you worship, Sakka.’ "
    },
    {
      "number": 33,
      "pali": "Idaṁ vatvāna maghavā, ",
      "english": "After saying this, Maghavā the chief, "
    },
    {
      "number": 34,
      "pali": "devarājā sujampati; ",
      "english": "king of gods, Sujā’s husband, "
    },
    {
      "number": 35,
      "pali": "Bhagavantaṁ namassitvā, ",
      "english": "having worshipped the Buddha, "
    },
    {
      "number": 36,
      "pali": "pamukho rathamāruhī”ti. ",
      "english": "climbed into his chariot.” "
    }
  ]
}