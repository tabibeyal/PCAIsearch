{
  "sutta_id": "AN3.162",
  "verses": [
    {
      "number": 1,
      "pali": "Sammādiṭṭhiṁ bhāveti … ",
      "english": "They develop right view … "
    },
    {
      "number": 2,
      "pali": "sammāsaṅkappaṁ bhāveti … ",
      "english": "right purpose … "
    },
    {
      "number": 3,
      "pali": "sammāvācaṁ bhāveti … ",
      "english": "right speech … "
    },
    {
      "number": 4,
      "pali": "sammākammantaṁ bhāveti … ",
      "english": "right action … "
    },
    {
      "number": 5,
      "pali": "sammāājīvaṁ bhāveti … ",
      "english": "right livelihood … "
    },
    {
      "number": 6,
      "pali": "sammāvāyāmaṁ bhāveti … ",
      "english": "right effort … "
    },
    {
      "number": 7,
      "pali": "sammāsatiṁ bhāveti … ",
      "english": "right mindfulness … "
    },
    {
      "number": 8,
      "pali": "sammāsamādhiṁ bhāveti …. ",
      "english": "right immersion … "
    },
    {
      "number": 9,
      "pali": "Ayaṁ vuccati, bhikkhave, majjhimā paṭipadā. ",
      "english": "This is called the middle practice. "
    },
    {
      "number": 10,
      "pali": "Imā kho, bhikkhave, tisso paṭipadā”ti. ",
      "english": "These are the three practices.” "
    },
    {
      "number": 11,
      "pali": "Acelakavaggo chaṭṭho. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Satipaṭṭhānaṁ sammappadhānaṁ, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Iddhipādindriyena ca; ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Balaṁ bojjhaṅgo maggo ca, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Paṭipadāya yojayeti. ",
      "english": ""
    }
  ]
}