      "english": "11. Old Age "
    },
    {
      "number": 4,
      "pali": "Visākhāyasahāyikānaṁvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Ko nu hāso kimānando, ",
      "english": "What is joy, what is laughter, "
    },
    {
      "number": 6,
      "pali": "niccaṁ pajjalite sati; ",
      "english": "when the flames are ever burning? "
    },
    {
      "number": 7,
      "pali": "Andhakārena onaddhā, ",
      "english": "Shrouded by darkness, "
    },
    {
      "number": 8,
      "pali": "padīpaṁ na gavesatha. ",
      "english": "would you not seek a light? "
    }
  ]
