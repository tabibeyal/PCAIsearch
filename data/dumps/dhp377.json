{
  "sutta_id": "DHP377",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcasatabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Vassikā viya pupphāni, ",
      "english": "As a jasmine sheds "
    },
    {
      "number": 3,
      "pali": "maddavāni pamuñcati; ",
      "english": "its withered flowers, "
    },
    {
      "number": 4,
      "pali": "Evaṁ rāgañca dosañca, ",
      "english": "O mendicants, "
    },
    {
      "number": 5,
      "pali": "vippamuñcetha bhikkhavo. ",
      "english": "shed greed and hate. "
    }
  ]
}