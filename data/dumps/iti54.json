      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three searches. Which three? The search for sensuality, the search for becoming, the search for a holy life. These are the three searches.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Centered,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "alert,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "mindful,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "the Awakened One’s"
    },
    {
      "number": 8,
      "pali": "",
      "english": "disciple"
    },
    {
      "number": 9,
      "pali": "",
      "english": "discerns searches,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "how searches come into play,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "where they cease,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "& the path to their ending."
    },
    {
      "number": 13,
      "pali": "",
      "english": "With the ending of searches, a monk"
    },
    {
      "number": 14,
      "pali": "",
      "english": "free from hunger"
    },
    {
      "number": 15,
      "pali": "",
      "english": "is totally unbound."
    }
  ]
}