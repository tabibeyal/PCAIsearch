{
  "sutta_id": "ITI54",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 54 ",
      "english": "So It Was Said 54 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Paṭhamaesanāsutta ",
      "english": "Searches (1st) "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tisso imā, bhikkhave, esanā. ",
      "english": "“Mendicants, there are these three searches. "
    },
    {
      "number": 7,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāmesanā, bhavesanā, brahmacariyesanā—",
      "english": "The search for sensual pleasures, the search for continued existence, and the search for a spiritual path. "
    },
    {
      "number": 9,
      "pali": "imā kho, bhikkhave, tisso esanā”ti. ",
      "english": "These are the three searches. "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Samāhito sampajāno, ",
      "english": "“Stilled, aware, "
    },
    {
      "number": 13,
      "pali": "sato buddhassa sāvako; ",
      "english": "a mindful disciple of the Buddha "
    },
    {
      "number": 14,
      "pali": "Esanā ca pajānāti, ",
      "english": "understands searches, "
    },
    {
      "number": 15,
      "pali": "esanānañca sambhavaṁ. ",
      "english": "the cause of searches, "
    },
    {
      "number": 16,
      "pali": "Yattha cetā nirujjhanti, ",
      "english": "where they cease, "
    },
    {
      "number": 17,
      "pali": "maggañca khayagāminaṁ; ",
      "english": "and the path that leads to their ending. "
    },
    {
      "number": 18,
      "pali": "Esanānaṁ khayā bhikkhu, ",
      "english": "With the ending of searches, a mendicant "
    },
    {
      "number": 19,
      "pali": "nicchāto parinibbuto”ti. ",
      "english": "is hungerless, quenched.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}