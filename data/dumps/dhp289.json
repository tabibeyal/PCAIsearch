{
  "sutta_id": "DHP289",
  "verses": [
    {
      "number": 1,
      "pali": "Etamatthavasaṁ ñatvā, ",
      "english": "Knowing the reason for this, "
    },
    {
      "number": 2,
      "pali": "paṇḍito sīlasaṁvuto; ",
      "english": "astute, and ethically restrained, "
    },
    {
      "number": 3,
      "pali": "Nibbānagamanaṁ maggaṁ, ",
      "english": "one would quickly clear the path "
    },
    {
      "number": 4,
      "pali": "khippameva visodhaye. ",
      "english": "that leads to extinguishment. "
    },
    {
      "number": 5,
      "pali": "Maggavaggo vīsatimo. ",
      "english": ""
    }
  ]
}