{
  "sutta_id": "DHP376",
  "verses": [
    {
      "number": 1,
      "pali": "Mitte bhajassu kalyāṇe, ",
      "english": "Mix with spiritual friends, "
    },
    {
      "number": 2,
      "pali": "suddhājīve atandite; ",
      "english": "who are tireless and pure of livelihood. "
    },
    {
      "number": 3,
      "pali": "Paṭisanthāravutyassa, ",
      "english": "Share what you have with others, "
    },
    {
      "number": 4,
      "pali": "ācārakusalo siyā; ",
      "english": "being skillful in your conduct. "
    },
    {
      "number": 5,
      "pali": "Tato pāmojjabahulo, ",
      "english": "And when you’re full of joy, "
    },
    {
      "number": 6,
      "pali": "dukkhassantaṁ karissati. ",
      "english": "you’ll make an end to suffering. "
    }
  ]
}