{
  "sutta_id": "SN1.58",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.58 ",
      "english": "Linked Discourses 1.58 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Uppathasutta ",
      "english": "Deviation "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu uppatho akkhāto, ",
      "english": "“What’s declared to be a deviation? "
    },
    {
      "number": 5,
      "pali": "kiṁsu rattindivakkhayo; ",
      "english": "What is ending day and night? "
    },
    {
      "number": 6,
      "pali": "Kiṁ malaṁ brahmacariyassa, ",
      "english": "What’s the stain of chastity? "
    },
    {
      "number": 7,
      "pali": "kiṁ sinānamanodakan”ti. ",
      "english": "What’s the waterless bath?” "
    },
    {
      "number": 8,
      "pali": "“Rāgo uppatho akkhāto, ",
      "english": "“Lust is declared to be a deviation. "
    },
    {
      "number": 9,
      "pali": "Vayo rattindivakkhayo; ",
      "english": "Youth is ending day and night. "
    },
    {
      "number": 10,
      "pali": "Itthī malaṁ brahmacariyassa, ",
      "english": "Women are the stain of chastity, "
    },
    {
      "number": 11,
      "pali": "Etthāyaṁ sajjate pajā; ",
      "english": "to which this generation clings. "
    },
    {
      "number": 12,
      "pali": "Tapo ca brahmacariyañca, ",
      "english": "Fervor and chastity "
    },
    {
      "number": 13,
      "pali": "Taṁ sinānamanodakan”ti. ",
      "english": "are the waterless bath.” "
    }
  ]
}