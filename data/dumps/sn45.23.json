{
  "sutta_id": "SN45.23",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.23 ",
      "english": "Linked Discourses 45.23 "
    },
    {
      "number": 2,
      "pali": "3. Micchattavagga ",
      "english": "3. The Wrong Way "
    },
    {
      "number": 3,
      "pali": "Paṭhamapaṭipadāsutta ",
      "english": "Practice (1st) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Micchāpaṭipadañca vo, bhikkhave, desessāmi, sammāpaṭipadañca. ",
      "english": "“Mendicants, I will teach you the wrong practice and the right practice. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamā ca, bhikkhave, micchāpaṭipadā? ",
      "english": "And what’s the wrong practice? "
    },
    {
      "number": 8,
      "pali": "Seyyathidaṁ—micchādiṭṭhi …pe… micchāsamādhi. ",
      "english": "It is wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, and wrong immersion. "
    },
    {
      "number": 9,
      "pali": "Ayaṁ vuccati, bhikkhave, micchāpaṭipadā. ",
      "english": "This is called the wrong practice. "
    },
    {
      "number": 10,
      "pali": "Katamā ca, bhikkhave, sammāpaṭipadā? ",
      "english": "And what’s the right practice? "
    },
    {
      "number": 11,
      "pali": "Seyyathidaṁ—sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "It is right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 12,
      "pali": "Ayaṁ vuccati, bhikkhave, sammāpaṭipadā”ti. ",
      "english": "This is called the right practice.” "
    },
    {
      "number": 13,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}