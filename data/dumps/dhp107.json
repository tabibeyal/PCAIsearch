{
  "sutta_id": "DHP107",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattherassa bhāgineyyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jantu, ",
      "english": "Rather than serve the sacred flame "
    },
    {
      "number": 3,
      "pali": "aggiṁ paricare vane; ",
      "english": "in the forest for a hundred years, "
    },
    {
      "number": 4,
      "pali": "Ekañca bhāvitattānaṁ, ",
      "english": "it’s better to honor for a single hour "
    },
    {
      "number": 5,
      "pali": "muhuttamapi pūjaye; ",
      "english": "a personage who has developed themselves. "
    },
    {
      "number": 6,
      "pali": "Sāyeva pūjanā seyyo, ",
      "english": "That offering is better "
    },
    {
      "number": 7,
      "pali": "yañce vassasataṁ hutaṁ. ",
      "english": "than the hundred year sacrifice. "
    }
  ]
}