{
  "sutta_id": "AN8.85",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.85 ",
      "english": "Numbered Discourses 8.85 "
    },
    {
      "number": 2,
      "pali": "9. Sativagga ",
      "english": "9. Mindfulness "
    },
    {
      "number": 3,
      "pali": "Samaṇasutta ",
      "english": "Terms for the Realized One "
    },
    {
      "number": 4,
      "pali": "“‘Samaṇo’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "“‘Ascetic’ is a term for the Realized One, the perfected one, the fully awakened Buddha. "
    },
    {
      "number": 5,
      "pali": "‘Brāhmaṇo’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Brahmin’, "
    },
    {
      "number": 6,
      "pali": "‘Vedagū’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Knowledge Master’, "
    },
    {
      "number": 7,
      "pali": "‘Bhisakko’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Healer’, "
    },
    {
      "number": 8,
      "pali": "‘Nimmalo’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Unstained’, "
    },
    {
      "number": 9,
      "pali": "‘Vimalo’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Immaculate’, "
    },
    {
      "number": 10,
      "pali": "‘Ñāṇī’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassa. ",
      "english": "‘Knower’, "
    },
    {
      "number": 11,
      "pali": "‘Vimutto’ti, bhikkhave, tathāgatassetaṁ adhivacanaṁ arahato sammāsambuddhassāti. ",
      "english": "and ‘Freed’ are terms for the Realized One, the perfected one, the fully awakened Buddha. "
    },
    {
      "number": 12,
      "pali": "Yaṁ samaṇena pattabbaṁ, ",
      "english": "The supreme should be attained by an ascetic, "
    },
    {
      "number": 13,
      "pali": "brāhmaṇena vusīmatā; ",
      "english": "a brahmin who has lived the life; "
    },
    {
      "number": 14,
      "pali": "Yaṁ vedagunā pattabbaṁ, ",
      "english": "it should be attained by a knowledge master, "
    },
    {
      "number": 15,
      "pali": "bhisakkena anuttaraṁ. ",
      "english": "a healer. "
    },
    {
      "number": 16,
      "pali": "Yaṁ nimmalena pattabbaṁ, ",
      "english": "The supreme should be attained by the unstained, "
    },
    {
      "number": 17,
      "pali": "vimalena sucīmatā; ",
      "english": "stainless and pure; "
    },
    {
      "number": 18,
      "pali": "Yaṁ ñāṇinā ca pattabbaṁ, ",
      "english": "it should be attained by a knower, "
    },
    {
      "number": 19,
      "pali": "vimuttena anuttaraṁ. ",
      "english": "who is free. "
    },
    {
      "number": 20,
      "pali": "Sohaṁ vijitasaṅgāmo, ",
      "english": "I am victorious in battle! "
    },
    {
      "number": 21,
      "pali": "mutto mocemi bandhanā; ",
      "english": "Released, I release others from their chains. "
    },
    {
      "number": 22,
      "pali": "Nāgomhi paramadanto, ",
      "english": "I am a dragon completely tamed, "
    },
    {
      "number": 23,
      "pali": "asekho parinibbuto”ti. ",
      "english": "an adept, I am quenched.” "
    },
    {
      "number": 24,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}