{
  "sutta_id": "DHP48",
  "verses": [
    {
      "number": 1,
      "pali": "Patipūjikakumārivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pupphāni heva pacinantaṁ, ",
      "english": "The terminator gains control of the man "
    },
    {
      "number": 3,
      "pali": "byāsattamanasaṁ naraṁ; ",
      "english": "who has not had his fill of pleasures, "
    },
    {
      "number": 4,
      "pali": "Atittaññeva kāmesu, ",
      "english": "even as he gathers flowers, "
    },
    {
      "number": 5,
      "pali": "antako kurute vasaṁ. ",
      "english": "his mind caught up in them. "
    }
  ]
}