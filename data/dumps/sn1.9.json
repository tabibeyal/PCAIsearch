{
  "sutta_id": "SN1.9",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.9",
      "english": "Linked Discourses 1.9"
    },
    {
      "number": 2,
      "pali": "Manakāma Sutta",
      "english": "Fond of Conceit"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Standing to one side, a devatā addressed the Blessed One with a verse:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Here there’s no taming"
    },
    {
      "number": 5,
      "pali": "",
      "english": "for one fond of conceit,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "no sagacity"
    },
    {
      "number": 7,
      "pali": "",
      "english": "for one unconcentrated."
    },
    {
      "number": 8,
      "pali": "",
      "english": "One dwelling alone in the wilderness"
    },
    {
      "number": 9,
      "pali": "",
      "english": "heedlessly"
    },
    {
      "number": 10,
      "pali": "",
      "english": "won’t cross over beyond"
    },
    {
      "number": 11,
      "pali": "",
      "english": "Deaths’ realm."
    },
    {
      "number": 12,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 13,
      "pali": "",
      "english": "“Abandoning conceit,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "his mind well-concentrated,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "well-aware, everywhere"
    },
    {
      "number": 16,
      "pali": "",
      "english": "released,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "one dwelling alone in the wilderness"
    },
    {
      "number": 18,
      "pali": "",
      "english": "heedfully:"
    },
    {
      "number": 19,
      "pali": "",
      "english": "He will cross over beyond"
    },
    {
      "number": 20,
      "pali": "",
      "english": "Death’s realm."
    }
  ]
}