{
  "sutta_id": "SN1.9",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.9 ",
      "english": "Linked Discourses 1.9 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Mānakāmasutta ",
      "english": "Fond of Conceit "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Na mānakāmassa damo idhatthi, ",
      "english": "“One fond of conceit can’t be tamed, "
    },
    {
      "number": 7,
      "pali": "Na monamatthi asamāhitassa; ",
      "english": "no sage is lacking immersion. "
    },
    {
      "number": 8,
      "pali": "Eko araññe viharaṁ pamatto, ",
      "english": "Living negligent alone in the wilderness, "
    },
    {
      "number": 9,
      "pali": "Na maccudheyyassa tareyya pāran”ti. ",
      "english": "they can’t cross beyond Death’s dominion.” "
    },
    {
      "number": 10,
      "pali": "“Mānaṁ pahāya susamāhitatto, ",
      "english": "“Having given up conceit, serene within oneself, "
    },
    {
      "number": 11,
      "pali": "Sucetaso sabbadhi vippamutto; ",
      "english": "with a good heart, everywhere free; "
    },
    {
      "number": 12,
      "pali": "Eko araññe viharaṁ appamatto, ",
      "english": "living diligent alone in the wilderness, "
    },
    {
      "number": 13,
      "pali": "Sa maccudheyyassa tareyya pāran”ti. ",
      "english": "they cross beyond Death’s dominion.” "
    }
  ]
}