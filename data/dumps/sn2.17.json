{
  "sutta_id": "SN2.17",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.17 ",
      "english": "Linked Discourses 2.17 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Subrahmasutta ",
      "english": "With Subrahmā "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho subrahmā devaputto bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, the godling Subrahmā addressed the Buddha in verse: "
    },
    {
      "number": 5,
      "pali": "“Niccaṁ utrastamidaṁ cittaṁ, ",
      "english": "“This mind is always anxious, "
    },
    {
      "number": 6,
      "pali": "niccaṁ ubbiggamidaṁ mano; ",
      "english": "this mind is always stressed "
    },
    {
      "number": 7,
      "pali": "Anuppannesu kicchesu, ",
      "english": "about stresses that haven’t arisen "
    },
    {
      "number": 8,
      "pali": "atho uppatitesu ca; ",
      "english": "and those that have. "
    },
    {
      "number": 9,
      "pali": "Sace atthi anutrastaṁ, ",
      "english": "If there is a state free of anxiety, "
    },
    {
      "number": 10,
      "pali": "taṁ me akkhāhi pucchito”ti. ",
      "english": "please answer my question.” "
    },
    {
      "number": 11,
      "pali": "“Nāññatra bojjhā tapasā, ",
      "english": "“Not without understanding and fervor, "
    },
    {
      "number": 12,
      "pali": "nāññatrindriyasaṁvarā; ",
      "english": "not without restraining the sense faculties, "
    },
    {
      "number": 13,
      "pali": "Nāññatra sabbanissaggā, ",
      "english": "not without letting go of everything, "
    },
    {
      "number": 14,
      "pali": "sotthiṁ passāmi pāṇinan”ti. ",
      "english": "do I see safety for living creatures.” "
    },
    {
      "number": 15,
      "pali": "Idamavoca …pe… ",
      "english": "That is what the Buddha said. … "
    },
    {
      "number": 16,
      "pali": "tatthevantaradhāyīti. ",
      "english": "The god vanished right there. "
    }
  ]
}