{
  "sutta_id": "SN2.17",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 2.17",
      "english": "Linked Discourses 2.17"
    },
    {
      "number": 2,
      "pali": "Subrahma Sutta",
      "english": "Subrahma the Deva’s Son"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Standing to one side, Subrahma the deva’s son recited this verse to the Blessed One:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Constantly troubled is this mind,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "constantly trembling this heart,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "over duties that have yet to arise,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "and those already arisen."
    },
    {
      "number": 8,
      "pali": "",
      "english": "If there is an Untroubled,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "point it out to me, when asked.”"
    },
    {
      "number": 10,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "“Apart from the factors for awakening, austerity,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "apart from sense-faculty restraint,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "apart from relinquishing the all,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "I see no safety"
    },
    {
      "number": 15,
      "pali": "",
      "english": "for living beings.”"
    },
    {
      "number": 16,
      "pali": "",
      "english": "That is what the Blessed One said… the deva disappeared right there."
    }
  ]
}