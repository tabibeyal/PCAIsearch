    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Viññāṇasutta ",
      "english": "Consciousness "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "cakkhuviññāṇaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "Is eye consciousness permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccaṁ, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“sotaviññāṇaṁ …pe… ",
      "english": "“… ear consciousness … "
    },
    {
      "number": 9,
      "pali": "ghānaviññāṇaṁ … ",
      "english": "nose consciousness … "
    },
    {
      "number": 10,
      "pali": "jivhāviññāṇaṁ … ",
      "english": "tongue consciousness … "
    },
    {
      "number": 11,
      "pali": "kāyaviññāṇaṁ … ",
      "english": "body consciousness … "
    },
    {
      "number": 12,
      "pali": "manoviññāṇaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "Is mind consciousness permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccaṁ, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako cakkhuviññāṇasmimpi nibbindati …pe… sotaviññāṇasmimpi nibbindati … ghānaviññāṇasmimpi nibbindati … jivhāviññāṇasmimpi nibbindati … kāyaviññāṇasmimpi nibbindati … manoviññāṇasmimpi nibbindati; ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with eye consciousness, ear consciousness, nose consciousness, tongue consciousness, body consciousness, and mind consciousness. "
    },
    {
      "number": 15,
      "pali": "nibbindaṁ virajjati …pe… ",
      "english": "Being disillusioned, desire fades away. …” "
    },
    {
      "number": 16,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
