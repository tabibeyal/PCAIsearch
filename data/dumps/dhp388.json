  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇapabbajitavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Bāhitapāpoti brāhmaṇo, ",
      "english": "A brahmin’s so-called <j>since they’ve banished evil, "
    },
    {
      "number": 3,
      "pali": "Samacariyā samaṇoti vuccati; ",
      "english": "an ascetic’s so-called <j>since they live a serene life. "
    },
    {
      "number": 4,
      "pali": "Pabbājayamattano malaṁ, ",
      "english": "One who has renounced all stains "
    },
    {
      "number": 5,
      "pali": "Tasmā “pabbajito”ti vuccati. ",
      "english": "is said to be a “renunciant”. "
    }
  ]
