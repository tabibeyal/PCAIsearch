{
  "sutta_id": "DHP359",
  "verses": [
    {
      "number": 1,
      "pali": "Tiṇadosāni khettāni, ",
      "english": "Weeds are the bane of crops, "
    },
    {
      "number": 2,
      "pali": "icchādosā ayaṁ pajā; ",
      "english": "but desire is these folk’s bane. "
    },
    {
      "number": 3,
      "pali": "Tasmā hi vigaticchesu, ",
      "english": "That’s why a gift to one rid of desire "
    },
    {
      "number": 4,
      "pali": "dinnaṁ hoti mahapphalaṁ. ",
      "english": "is so very fruitful. "
    },
    {
      "number": 5,
      "pali": "Taṇhāvaggo catuvīsatimo. ",
      "english": ""
    }
  ]
}