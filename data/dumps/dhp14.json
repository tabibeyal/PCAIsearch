{
  "sutta_id": "DHP14",
  "verses": [
    {
      "number": 1,
      "pali": "Yathā agāraṁ suchannaṁ, ",
      "english": "Just as rain doesn’t seep into "
    },
    {
      "number": 2,
      "pali": "vuṭṭhī na samativijjhati; ",
      "english": "a well roofed house, "
    },
    {
      "number": 3,
      "pali": "Evaṁ subhāvitaṁ cittaṁ, ",
      "english": "lust doesn’t seep into "
    },
    {
      "number": 4,
      "pali": "rāgo na samativijjhati. ",
      "english": "a well developed mind. "
    }
  ]
}