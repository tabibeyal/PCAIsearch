{
  "sutta_id": "SN1.81",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.81 ",
      "english": "Linked Discourses 1.81 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Araṇasutta ",
      "english": "Free of Strife "
    },
    {
      "number": 4,
      "pali": "“Kesūdha araṇā loke, ",
      "english": "“Who in the world is free of strife? "
    },
    {
      "number": 5,
      "pali": "kesaṁ vusitaṁ na nassati; ",
      "english": "Whose life is not wasted? "
    },
    {
      "number": 6,
      "pali": "Kedha icchaṁ parijānanti, ",
      "english": "Who here completely understands desire? "
    },
    {
      "number": 7,
      "pali": "kesaṁ bhojissiyaṁ sadā. ",
      "english": "Who always lives as their own master? "
    },
    {
      "number": 8,
      "pali": "Kiṁsu mātā pitā bhātā, ",
      "english": "To whom do mother, father, and brothers "
    },
    {
      "number": 9,
      "pali": "vandanti naṁ patiṭṭhitaṁ; ",
      "english": "bow when they’re established? "
    },
    {
      "number": 10,
      "pali": "Kiṁsu idha jātihīnaṁ, ",
      "english": "Who here, though low born, "
    },
    {
      "number": 11,
      "pali": "abhivādenti khattiyā”ti. ",
      "english": "is bowed to even by aristocrats?” "
    },
    {
      "number": 12,
      "pali": "“Samaṇīdha araṇā loke, ",
      "english": "“Ascetics are free of strife in the world. "
    },
    {
      "number": 13,
      "pali": "Samaṇānaṁ vusitaṁ na nassati; ",
      "english": "The life of ascetics is not wasted. "
    },
    {
      "number": 14,
      "pali": "Samaṇā icchaṁ parijānanti, ",
      "english": "Ascetics completely understand desire. "
    },
    {
      "number": 15,
      "pali": "Samaṇānaṁ bhojissiyaṁ sadā. ",
      "english": "Ascetics always live as their own master. "
    },
    {
      "number": 16,
      "pali": "Samaṇaṁ mātā pitā bhātā, ",
      "english": "Mother, father, and brothers "
    },
    {
      "number": 17,
      "pali": "vandanti naṁ patiṭṭhitaṁ; ",
      "english": "bow to ascetics when they’re established. "
    },
    {
      "number": 18,
      "pali": "Samaṇīdha jātihīnaṁ, ",
      "english": "Even though an ascetic is low born, "
    },
    {
      "number": 19,
      "pali": "abhivādenti khattiyā”ti. ",
      "english": "they’re bowed to even by aristocrats.” "
    },
    {
      "number": 20,
      "pali": "Chetvāvaggo aṭṭhamo. ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Chetvā rathañca cittañca, ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "vuṭṭhi bhītā najīrati; ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Issaraṁ kāmaṁ pātheyyaṁ, ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "pajjoto araṇena cāti. ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "Devatāsaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses on Deities are complete. "
    }
  ]
}