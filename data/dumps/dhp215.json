{
  "sutta_id": "DHP215",
  "verses": [
    {
      "number": 1,
      "pali": "Anitthigandhakumāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kāmato jāyatī soko, ",
      "english": "Sorrow springs from desire, "
    },
    {
      "number": 3,
      "pali": "kāmato jāyatī bhayaṁ; ",
      "english": "fear springs from desire; "
    },
    {
      "number": 4,
      "pali": "Kāmato vippamuttassa, ",
      "english": "one free from desire "
    },
    {
      "number": 5,
      "pali": "natthi soko kuto bhayaṁ. ",
      "english": "has no sorrow, let alone fear. "
    }
  ]
}