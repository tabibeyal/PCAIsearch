{
  "sutta_id": "ITI66",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 66 ",
      "english": "So It Was Said 66 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Soceyyasutta ",
      "english": "Purity "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, soceyyāni. ",
      "english": "“Mendicants, there are these three kinds of purity. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāyasoceyyaṁ, vacīsoceyyaṁ, manosoceyyaṁ—",
      "english": "Purity of body, speech, and mind. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi soceyyānī”ti. ",
      "english": "These are the three kinds of purity.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Kāyasuciṁ vacīsuciṁ, ",
      "english": "“Purity of body, purity of speech, "
    },
    {
      "number": 13,
      "pali": "cetosucimanāsavaṁ; ",
      "english": "and undefiled purity of heart. "
    },
    {
      "number": 14,
      "pali": "Suciṁ soceyyasampannaṁ, ",
      "english": "A pure one, blessed with purity, "
    },
    {
      "number": 15,
      "pali": "āhu sabbappahāyinan”ti. ",
      "english": "has given up everything, they say.” "
    },
    {
      "number": 16,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 17,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}