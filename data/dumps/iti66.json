    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three kinds of cleanliness. Which three? Bodily cleanliness, verbal cleanliness, mental cleanliness. These are the three kinds of cleanliness.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Clean in body,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "clean in speech,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "clean in awareness"
    },
    {
      "number": 7,
      "pali": "",
      "english": "–effluent-free–"
    },
    {
      "number": 8,
      "pali": "",
      "english": "one who is clean,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "consummate in cleanliness,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "is said to have abandoned"
    },
    {
      "number": 11,
      "pali": "",
      "english": "the All."
    }
  ]
}