{
  "sutta_id": "DHP169",
  "verses": [
    {
      "number": 1,
      "pali": "Dhammaṁ care sucaritaṁ, ",
      "english": "Live by principle, with good conduct, "
    },
    {
      "number": 2,
      "pali": "na naṁ duccaritaṁ care; ",
      "english": "don’t conduct yourself badly. "
    },
    {
      "number": 3,
      "pali": "Dhammacārī sukhaṁ seti, ",
      "english": "For one of good conduct sleeps at ease, "
    },
    {
      "number": 4,
      "pali": "asmiṁ loke paramhi ca. ",
      "english": "in this world and the next. "
    }
  ]
}