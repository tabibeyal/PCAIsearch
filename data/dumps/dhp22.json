{
  "sutta_id": "DHP22",
  "verses": [
    {
      "number": 1,
      "pali": "Evaṁ visesato ñatvā, ",
      "english": "Understanding this distinction "
    },
    {
      "number": 2,
      "pali": "appamādamhi paṇḍitā; ",
      "english": "when it comes to heedfulness, "
    },
    {
      "number": 3,
      "pali": "Appamāde pamodanti, ",
      "english": "the astute rejoice in heedfulness, "
    },
    {
      "number": 4,
      "pali": "ariyānaṁ gocare ratā. ",
      "english": "happy in the noble ones’ domain. "
    }
  ]
}