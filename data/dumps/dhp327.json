{
  "sutta_id": "DHP327",
  "verses": [
    {
      "number": 1,
      "pali": "Pāveyyakahatthivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamādaratā hotha, ",
      "english": "Delight in diligence! "
    },
    {
      "number": 3,
      "pali": "sacittamanurakkhatha; ",
      "english": "Take good care of your mind! "
    },
    {
      "number": 4,
      "pali": "Duggā uddharathattānaṁ, ",
      "english": "Pull yourself out of this pit, "
    },
    {
      "number": 5,
      "pali": "paṅke sannova kuñjaro. ",
      "english": "like an elephant sunk in a bog. "
    }
  ]
}