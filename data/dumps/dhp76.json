  "sutta_id": "DHP76",
  "verses": [
    {
      "number": 1,
      "pali": "Khuddakanikāya ",
      "english": "Minor Collection "
    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 76–89 "
    },
    {
      "number": 3,
      "pali": "Paṇḍitavagga ",
      "english": "6. The Astute "
    },
    {
      "number": 4,
      "pali": "Rādhattheravatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Nidhīnaṁva pavattāraṁ, ",
      "english": "Regard one who sees your faults "
    },
    {
      "number": 6,
      "pali": "yaṁ passe vajjadassinaṁ; ",
      "english": "as a guide to a hidden treasure. "
    },
    {
      "number": 7,
      "pali": "Niggayhavādiṁ medhāviṁ, ",
      "english": "Stay close to one so wise and astute "
    },
    {
      "number": 8,
      "pali": "tādisaṁ paṇḍitaṁ bhaje; ",
      "english": "who corrects you when you need it. "
    },
    {
      "number": 9,
      "pali": "Tādisaṁ bhajamānassa, ",
      "english": "Sticking close to such an impartial person, "
    },
    {
      "number": 10,
      "pali": "seyyo hoti na pāpiyo. ",
      "english": "things get better, not worse. "
    }
  ]
}