{
  "sutta_id": "DHP223",
  "verses": [
    {
      "number": 1,
      "pali": "Uttarāupāsikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akkodhena jine kodhaṁ, ",
      "english": "Defeat anger with kindness, "
    },
    {
      "number": 3,
      "pali": "asādhuṁ sādhunā jine; ",
      "english": "villainy with virtue, "
    },
    {
      "number": 4,
      "pali": "Jine kadariyaṁ dānena, ",
      "english": "stinginess with giving, "
    },
    {
      "number": 5,
      "pali": "saccenālikavādinaṁ. ",
      "english": "and lies with truth. "
    }
  ]
}