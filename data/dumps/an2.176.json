    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Diṭṭhivisuddhi ca yathādiṭṭhissa ca padhānaṁ. ",
      "english": "Purification of view and making an effort in line with that view. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”. ",
      "english": "These are the two things.” "
    }
  ]
}