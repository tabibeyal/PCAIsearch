{
  "sutta_id": "SN1.13",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.13 ",
      "english": "Linked Discourses 1.13 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Natthiputtasamasutta ",
      "english": "There’s Nothing Like a Child "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Natthi puttasamaṁ pemaṁ, ",
      "english": "“There’s no fondness like that for a child, "
    },
    {
      "number": 7,
      "pali": "natthi gosamitaṁ dhanaṁ; ",
      "english": "no wealth equal to cattle, "
    },
    {
      "number": 8,
      "pali": "Natthi sūriyasamā ābhā, ",
      "english": "no light like that of the sun, "
    },
    {
      "number": 9,
      "pali": "samuddaparamā sarā”ti. ",
      "english": "and of lakes the ocean is paramount.” "
    },
    {
      "number": 10,
      "pali": "“Natthi attasamaṁ pemaṁ, ",
      "english": "“There’s no fondness like that for oneself, "
    },
    {
      "number": 11,
      "pali": "natthi dhaññasamaṁ dhanaṁ; ",
      "english": "no wealth equal to grain, "
    },
    {
      "number": 12,
      "pali": "Natthi paññāsamā ābhā, ",
      "english": "no light like that of wisdom, "
    },
    {
      "number": 13,
      "pali": "vuṭṭhi ve paramā sarā”ti. ",
      "english": "and of waters the rain is paramount.” "
    }
  ]
}