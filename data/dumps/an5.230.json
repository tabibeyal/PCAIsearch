{
  "sutta_id": "AN5.230",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.230 ",
      "english": "Numbered Discourses 5.230 "
    },
    {
      "number": 2,
      "pali": "23. Dīghacārikavagga ",
      "english": "23. Long Wandering "
    },
    {
      "number": 3,
      "pali": "Dutiyakaṇhasappasutta ",
      "english": "Black Snakes (2nd) "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, ādīnavā kaṇhasappe. ",
      "english": "“Mendicants, there are these five drawbacks of a black snake. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī. ",
      "english": "It’s irritable, acrimonious, venomous, fork-tongued, and treacherous. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, pañca ādīnavā kaṇhasappe. ",
      "english": "These are the five dangers of a black snake. "
    },
    {
      "number": 8,
      "pali": "Evamevaṁ kho, bhikkhave, pañcime ādīnavā mātugāme. ",
      "english": "In the same way there are five drawbacks of a lady. "
    },
    {
      "number": 9,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 10,
      "pali": "Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī. ",
      "english": "She’s irritable, acrimonious, venomous, fork-tongued, and treacherous. "
    },
    {
      "number": 11,
      "pali": "Tatridaṁ, bhikkhave, mātugāmassa ghoravisatā—",
      "english": "This is a lady’s venom: "
    },
    {
      "number": 12,
      "pali": "yebhuyyena, bhikkhave, mātugāmo tibbarāgo. ",
      "english": "usually she’s very lustful. "
    },
    {
      "number": 13,
      "pali": "Tatridaṁ, bhikkhave, mātugāmassa dujjivhatā—",
      "english": "This is a lady’s forked tongue: "
    },
    {
      "number": 14,
      "pali": "yebhuyyena, bhikkhave, mātugāmo pisuṇavāco. ",
      "english": "usually she backbites. "
    },
    {
      "number": 15,
      "pali": "Tatridaṁ, bhikkhave, mātugāmassa mittadubbhitā—",
      "english": "This is a lady’s treachery: "
    },
    {
      "number": 16,
      "pali": "yebhuyyena, bhikkhave, mātugāmo aticārinī. ",
      "english": "usually she’s an adulteress. "
    },
    {
      "number": 17,
      "pali": "Ime kho, bhikkhave, pañca ādīnavā mātugāme”ti. ",
      "english": "These are the five drawbacks of a lady.” "
    },
    {
      "number": 18,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Dīghacārikavaggo tatiyo. ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Dve dīghacārikā vuttā, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "atinivāsamaccharī; ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Dve ca kulūpakā bhogā, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "bhattaṁ sappāpare duveti. ",
      "english": ""
    }
  ]
}