    {
      "number": 3,
      "pali": "Āghātapaṭivinayasutta ",
      "english": "Getting Rid of Resentment "
    },
    {
      "number": 4,
      "pali": "“Dasayime, bhikkhave, āghātapaṭivinayā. ",
      "english": "“Mendicants, there are these ten ways to get rid of resentment. "
    },
    {
      "number": 5,
      "pali": "Katame dasa? ",
      "english": "What ten? "
    },
    {
      "number": 6,
      "pali": "‘Anatthaṁ me acari, taṁ kutettha labbhā’ti āghātaṁ paṭivineti, ",
      "english": "Thinking: ‘They harmed me, but what can I possibly do?’ you get rid of resentment. "
    },
    {
      "number": 7,
      "pali": "‘anatthaṁ me carati, taṁ kutettha labbhā’ti āghātaṁ paṭivineti, ",
      "english": "Thinking: ‘They are harming me …’ … "
    },
    {
      "number": 8,
      "pali": "‘anatthaṁ me carissati, taṁ kutettha labbhā’ti āghātaṁ paṭivineti, ",
      "english": "‘They will harm me …’ … "
    },
    {
      "number": 9,
      "pali": "piyassa me manāpassa anatthaṁ acari …pe… ",
      "english": "‘They harmed someone I love …’ … "
    },
    {
      "number": 10,
      "pali": "carati …pe… ",
      "english": "‘They are harming someone I love …’ "
    },
    {
      "number": 11,
      "pali": "carissati, taṁ kutettha labbhāti āghātaṁ paṭivineti, appiyassa me amanāpassa atthaṁ acari …pe… ",
      "english": "‘They will harm someone I love …’ … They helped someone I dislike …’ … "
    },
    {
      "number": 12,
      "pali": "atthaṁ carati …pe… ",
      "english": "‘They are helping someone I dislike …’ … "
    },
    {
      "number": 13,
      "pali": "atthaṁ carissati, taṁ kutettha labbhāti āghātaṁ paṭivineti, ",
      "english": "Thinking: ‘They will help someone I dislike, but what can I possibly do?’ you get rid of resentment. "
    },
    {
      "number": 14,
      "pali": "aṭṭhāne ca na kuppati—",
      "english": "And you don’t get angry for no reason. "
    },
    {
      "number": 15,
      "pali": "ime kho, bhikkhave, dasa āghātapaṭivinayā”ti. ",
      "english": "These are the ten ways of getting rid of resentment.” "
    },
    {
      "number": 16,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Ākaṅkhavaggo tatiyo. ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Ākaṅkho kaṇṭako iṭṭhā, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "vaḍḍhi ca migasālāya; ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Tayo dhammā ca kāko ca, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "nigaṇṭhā dve ca āghātāti. ",
      "english": ""
    }
