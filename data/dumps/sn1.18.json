{
  "sutta_id": "SN1.18",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.18",
      "english": "Linked Discourses 1.18"
    },
    {
      "number": 2,
      "pali": "Hiri Sutta",
      "english": "Shame"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This pair of verses provides an answer to the question posed and left unanswered in Dhp 143 ."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Who in the world"
    },
    {
      "number": 5,
      "pali": "",
      "english": "is a man constrained by shame,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "who awakens to censure"
    },
    {
      "number": 7,
      "pali": "",
      "english": "like a fine stallion to the whip?”"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“Those restrained by shame"
    },
    {
      "number": 9,
      "pali": "",
      "english": "are rare—"
    },
    {
      "number": 10,
      "pali": "",
      "english": "those who go through life"
    },
    {
      "number": 11,
      "pali": "",
      "english": "always mindful."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Having reached the end"
    },
    {
      "number": 13,
      "pali": "",
      "english": "of suffering & stress,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "they go among the discordant"
    },
    {
      "number": 15,
      "pali": "",
      "english": "harmoniously.”"
    }
  ]
}