{
  "sutta_id": "SN1.18",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.18 ",
      "english": "Linked Discourses 1.18 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Hirīsutta ",
      "english": "Conscience "
    },
    {
      "number": 4,
      "pali": "“Hirīnisedho puriso, ",
      "english": "“Can a person constrained by conscience "
    },
    {
      "number": 5,
      "pali": "koci lokasmiṁ vijjati; ",
      "english": "be found in the world, "
    },
    {
      "number": 6,
      "pali": "Yo nindaṁ apabodhati, ",
      "english": "who is cognizant of blame, "
    },
    {
      "number": 7,
      "pali": "asso bhadro kasāmivā”ti. ",
      "english": "like a fine horse of the whip?” "
    },
    {
      "number": 8,
      "pali": "“Hirīnisedhā tanuyā, ",
      "english": "“Few are those constrained by conscience, "
    },
    {
      "number": 9,
      "pali": "ye caranti sadā satā; ",
      "english": "who live always mindful. "
    },
    {
      "number": 10,
      "pali": "Antaṁ dukkhassa pappuyya, ",
      "english": "Having reached the end of suffering, "
    },
    {
      "number": 11,
      "pali": "caranti visame saman”ti. ",
      "english": "smoothly they walk in the rough.” "
    }
  ]
}