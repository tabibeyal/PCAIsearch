{
  "sutta_id": "SN1.24",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.24 ",
      "english": "Linked Discourses 1.24 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Manonivāraṇasutta ",
      "english": "Shielding the Mind "
    },
    {
      "number": 4,
      "pali": "“Yato yato mano nivāraye, ",
      "english": "“Whatever you’ve shielded the mind from "
    },
    {
      "number": 5,
      "pali": "Na dukkhameti naṁ tato tato; ",
      "english": "can’t cause you suffering. "
    },
    {
      "number": 6,
      "pali": "Sa sabbato mano nivāraye, ",
      "english": "So you should shield the mind from everything, "
    },
    {
      "number": 7,
      "pali": "Sa sabbato dukkhā pamuccatī”ti. ",
      "english": "then you’re freed from all suffering.” "
    },
    {
      "number": 8,
      "pali": "“Na sabbato mano nivāraye, ",
      "english": "“You need not shield the mind from everything, "
    },
    {
      "number": 9,
      "pali": "Na mano saṁyatattamāgataṁ; ",
      "english": "nor has the mind gained self-control. "
    },
    {
      "number": 10,
      "pali": "Yato yato ca pāpakaṁ, ",
      "english": "The mind need only be shielded "
    },
    {
      "number": 11,
      "pali": "Tato tato mano nivāraye”ti. ",
      "english": "from where the bad things come.” "
    }
  ]
}