  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.187 ",
      "english": "Numbered Discourses 10.187 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Dukkhudrayasutta ",
      "english": "With Suffering as Outcome "
    },
    {
      "number": 4,
      "pali": "“Dukkhudrayañca vo, bhikkhave, dhammaṁ desessāmi sukhudrayañca. ",
      "english": "“I will teach you the principle that has suffering as outcome, and that which has happiness as outcome. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, dukkhudrayo dhammo? ",
      "english": "And what is the principle whose outcome is suffering? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, dukkhudrayo dhammo. ",
      "english": "This is the principle whose outcome is suffering. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, sukhudrayo dhammo? ",
      "english": "And what is the principle whose outcome is happiness? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sukhudrayo dhammo”ti. ",
      "english": "This is the principle whose outcome is happiness.” "
    },
    {
      "number": 14,
      "pali": "Dasamaṁ. ",
      "english": ""
    }
  ]
}