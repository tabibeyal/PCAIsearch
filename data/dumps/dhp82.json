{
  "sutta_id": "DHP82",
  "verses": [
    {
      "number": 1,
      "pali": "Kāṇamātāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathāpi rahado gambhīro, ",
      "english": "Like a deep lake, "
    },
    {
      "number": 3,
      "pali": "vippasanno anāvilo; ",
      "english": "clear and unclouded, "
    },
    {
      "number": 4,
      "pali": "Evaṁ dhammāni sutvāna, ",
      "english": "so clear are the astute "
    },
    {
      "number": 5,
      "pali": "vippasīdanti paṇḍitā. ",
      "english": "when they hear the teachings. "
    }
  ]
}