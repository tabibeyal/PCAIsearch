{
  "sutta_id": "DHP328",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sace labhetha nipakaṁ sahāyaṁ, ",
      "english": "If you find an alert companion, "
    },
    {
      "number": 3,
      "pali": "Saddhiṁ caraṁ sādhuvihāridhīraṁ; ",
      "english": "an attentive friend to live happily together, "
    },
    {
      "number": 4,
      "pali": "Abhibhuyya sabbāni parissayāni, ",
      "english": "then, overcoming all adversities, "
    },
    {
      "number": 5,
      "pali": "Careyya tenattamano satīmā. ",
      "english": "wander with them, joyful and mindful. "
    }
  ]
}