{
  "sutta_id": "AN7.10",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.10 ",
      "english": "Numbered Discourses 7.10 "
    },
    {
      "number": 2,
      "pali": "1. Dhanavagga ",
      "english": "1. Wealth "
    },
    {
      "number": 3,
      "pali": "Macchariyasutta ",
      "english": "Stinginess "
    },
    {
      "number": 4,
      "pali": "“Sattimāni, bhikkhave, saṁyojanāni. ",
      "english": "“Mendicants, there are these seven fetters. "
    },
    {
      "number": 5,
      "pali": "Katamāni satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Anunayasaṁyojanaṁ, paṭighasaṁyojanaṁ, diṭṭhisaṁyojanaṁ, vicikicchāsaṁyojanaṁ, mānasaṁyojanaṁ, issāsaṁyojanaṁ, macchariyasaṁyojanaṁ. ",
      "english": "The fetters of attraction, aversion, views, doubt, conceit, jealousy, and stinginess. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, satta saṁyojanānī”ti. ",
      "english": "These are the seven fetters.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Dhanavaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Dve piyāni balaṁ dhanaṁ, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Saṅkhittañceva vitthataṁ; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Uggaṁ saṁyojanañceva, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Pahānaṁ macchariyena cāti. ",
      "english": ""
    }
  ]
}