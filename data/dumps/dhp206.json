{
  "sutta_id": "DHP206",
  "verses": [
    {
      "number": 1,
      "pali": "Sakkavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sāhu dassanamariyānaṁ, ",
      "english": "It’s good to see the noble ones, "
    },
    {
      "number": 3,
      "pali": "sannivāso sadā sukho; ",
      "english": "staying with them is always good. "
    },
    {
      "number": 4,
      "pali": "Adassanena bālānaṁ, ",
      "english": "Were you not to see fools, "
    },
    {
      "number": 5,
      "pali": "niccameva sukhī siyā. ",
      "english": "you’d always be happy. "
    }
  ]
}