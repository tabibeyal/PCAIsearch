{
  "sutta_id": "DHP239",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Anupubbena medhāvī, ",
      "english": "A smart person would purge "
    },
    {
      "number": 3,
      "pali": "thokaṁ thokaṁ khaṇe khaṇe; ",
      "english": "their own stains gradually, "
    },
    {
      "number": 4,
      "pali": "Kammāro rajatasseva, ",
      "english": "bit by bit, moment by moment, "
    },
    {
      "number": 5,
      "pali": "niddhame malamattano. ",
      "english": "like a smith smelting silver. "
    }
  ]
}