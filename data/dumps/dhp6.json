{
  "sutta_id": "DHP6",
  "verses": [
    {
      "number": 1,
      "pali": "Kosambakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pare ca na vijānanti, ",
      "english": "When others do not understand, "
    },
    {
      "number": 3,
      "pali": "mayamettha yamāmase; ",
      "english": "let us, who do understand this, "
    },
    {
      "number": 4,
      "pali": "Ye ca tattha vijānanti, ",
      "english": "restrain ourselves in this regard; "
    },
    {
      "number": 5,
      "pali": "tato sammanti medhagā. ",
      "english": "for that is how conflicts are laid to rest. "
    }
  ]
}