{
  "sutta_id": "SN1.73",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.73 ",
      "english": "Linked Discourses 1.73 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Vittasutta ",
      "english": "Wealth "
    },
    {
      "number": 4,
      "pali": "“Kiṁsūdha vittaṁ purisassa seṭṭhaṁ, ",
      "english": "“What’s a person’s best wealth? "
    },
    {
      "number": 5,
      "pali": "Kiṁsu suciṇṇo sukhamāvahati; ",
      "english": "What brings happiness when practiced well? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu have sādutaraṁ rasānaṁ, ",
      "english": "What’s the sweetest taste of all? "
    },
    {
      "number": 7,
      "pali": "Kathaṁjīviṁ jīvitamāhu seṭṭhan”ti. ",
      "english": "The one they say has the best life: how do they live?” "
    },
    {
      "number": 8,
      "pali": "“Saddhīdha vittaṁ purisassa seṭṭhaṁ, ",
      "english": "“Faith here is a person’s best wealth. "
    },
    {
      "number": 9,
      "pali": "Dhammo suciṇṇo sukhamāvahati; ",
      "english": "The teaching brings happiness when practiced well. "
    },
    {
      "number": 10,
      "pali": "Saccaṁ have sādutaraṁ rasānaṁ, ",
      "english": "Truth is the sweetest taste of all. "
    },
    {
      "number": 11,
      "pali": "Paññājīviṁ jīvitamāhu seṭṭhan”ti. ",
      "english": "The one they say has the best life lives by wisdom.” "
    }
  ]
}