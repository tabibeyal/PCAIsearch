  "sutta_id": "SN14.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 14.6 ",
      "english": "Linked Discourses 14.6 "
    },
    {
      "number": 2,
      "pali": "1. Nānattavagga ",
      "english": "1. Diversity "
    },
    {
      "number": 3,
      "pali": "Bāhiradhātunānattasutta ",
      "english": "External Diversity of Elements "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dhātunānattaṁ vo, bhikkhave, desessāmi. ",
      "english": "“Mendicants, I will teach you the diversity of elements. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "katamañca, bhikkhave, dhātunānattaṁ? ",
      "english": "And what is the diversity of elements? "
    },
    {
      "number": 8,
      "pali": "Rūpadhātu saddadhātu gandhadhātu rasadhātu phoṭṭhabbadhātu dhammadhātu—",
      "english": "The sight element, the sound element, the smell element, the taste element, the touch element, and the idea element. "
    },
    {
      "number": 9,
      "pali": "idaṁ vuccati, bhikkhave, dhātunānattan”ti. ",
      "english": "This is called the diversity of elements.” "
    },
    {
      "number": 10,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}