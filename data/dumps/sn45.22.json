{
  "sutta_id": "SN45.22",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.22 ",
      "english": "Linked Discourses 45.22 "
    },
    {
      "number": 2,
      "pali": "3. Micchattavagga ",
      "english": "3. The Wrong Way "
    },
    {
      "number": 3,
      "pali": "Akusaladhammasutta ",
      "english": "Unskillful Qualities "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Akusale ca kho, bhikkhave, dhamme desessāmi, kusale ca dhamme. ",
      "english": "“Mendicants, I will teach you skillful and unskillful qualities. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katame ca, bhikkhave, akusalā dhammā? ",
      "english": "And what are unskillful qualities? "
    },
    {
      "number": 8,
      "pali": "Seyyathidaṁ—micchādiṭṭhi …pe… micchāsamādhi. ",
      "english": "They are wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, and wrong immersion. "
    },
    {
      "number": 9,
      "pali": "Ime vuccanti, bhikkhave, akusalā dhammā. ",
      "english": "These are called unskillful qualities. "
    },
    {
      "number": 10,
      "pali": "Katame ca, bhikkhave, kusalā dhammā? ",
      "english": "And what are skillful qualities? "
    },
    {
      "number": 11,
      "pali": "Seyyathidaṁ—sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "They are right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 12,
      "pali": "Ime vuccanti, bhikkhave, kusalā dhammā”ti. ",
      "english": "These are called skillful qualities.” "
    },
    {
      "number": 13,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}