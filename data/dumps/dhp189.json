{
  "sutta_id": "DHP189",
  "verses": [
    {
      "number": 1,
      "pali": "Netaṁ kho saraṇaṁ khemaṁ, ",
      "english": "But such refuge is no sanctuary, "
    },
    {
      "number": 2,
      "pali": "netaṁ saraṇamuttamaṁ; ",
      "english": "it is no supreme refuge. "
    },
    {
      "number": 3,
      "pali": "Netaṁ saraṇamāgamma, ",
      "english": "By going to that refuge, "
    },
    {
      "number": 4,
      "pali": "sabbadukkhā pamuccati. ",
      "english": "you’re not released from all suffering. "
    }
  ]
}