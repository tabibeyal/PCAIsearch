{
  "sutta_id": "AN4.150",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.150 ",
      "english": "Numbered Discourses 4.150 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Sārasutta ",
      "english": "Essentials "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, sārā. ",
      "english": "“Mendicants, there are these four essentials. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sīlasāro, samādhisāro, paññāsāro, vimuttisāro—",
      "english": "Ethics, immersion, wisdom, and freedom are essentials. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro sārā”ti. ",
      "english": "These are the four essentials.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Ābhāvaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Ābhā pabhā ca ālokā, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "obhāsā ceva pajjotā; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Dve kālā caritā dve ca, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "honti sārena te dasāti. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Tatiyo paṇṇāsako samatto. ",
      "english": ""
    }
  ]
}