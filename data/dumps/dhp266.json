{
  "sutta_id": "DHP266",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na tena bhikkhu so hoti, ",
      "english": "You don’t become a mendicant "
    },
    {
      "number": 3,
      "pali": "yāvatā bhikkhate pare; ",
      "english": "just by begging from others. "
    },
    {
      "number": 4,
      "pali": "Vissaṁ dhammaṁ samādāya, ",
      "english": "One who has undertaken domestic duties "
    },
    {
      "number": 5,
      "pali": "bhikkhu hoti na tāvatā. ",
      "english": "has not yet become a mendicant. "
    }
  ]
}