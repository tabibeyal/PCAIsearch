{
  "sutta_id": "DHP210",
  "verses": [
    {
      "number": 1,
      "pali": "Mā piyehi samāgañchi, ",
      "english": "Don’t ever get too close "
    },
    {
      "number": 2,
      "pali": "appiyehi kudācanaṁ; ",
      "english": "to those you like or dislike. "
    },
    {
      "number": 3,
      "pali": "Piyānaṁ adassanaṁ dukkhaṁ, ",
      "english": "For not seeing the liked is suffering, "
    },
    {
      "number": 4,
      "pali": "appiyānañca dassanaṁ. ",
      "english": "and so is seeing the disliked. "
    }
  ]
}