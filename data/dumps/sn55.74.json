{
  "sutta_id": "SN55.74",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 55.74 ",
      "english": "Linked Discourses 55.74 "
    },
    {
      "number": 2,
      "pali": "7. Mahāpaññavagga ",
      "english": "7. Great Wisdom "
    },
    {
      "number": 3,
      "pali": "Nibbedhikapaññāsutta ",
      "english": "Penetrating Wisdom "
    },
    {
      "number": 4,
      "pali": "“… Nibbedhikapaññatāya saṁvattanti. ",
      "english": "“Mendicants, when four things are developed and cultivated they lead to penetrating wisdom. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sappurisasaṁsevo, saddhammassavanaṁ, yonisomanasikāro, dhammānudhammappaṭipatti—",
      "english": "Associating with true persons, listening to the true teaching, rational application of mind, and practicing in line with the teaching. "
    },
    {
      "number": 7,
      "pali": "ime kho, bhikkhave, cattāro dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṁvattantī”ti. ",
      "english": "When these four things are developed and cultivated they lead to penetrating wisdom.” "
    },
    {
      "number": 8,
      "pali": "Terasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Mahāpaññavaggo sattamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Mahā puthu vipula gambhīraṁ, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Appamatta bhūri bāhullaṁ; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Sīgha lahu hāsa javana, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Tikkha nibbedhikāya cāti. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Sotāpattisaṁyuttaṁ ekādasamaṁ. ",
      "english": "The Linked Discourses on Stream-Entry, the eleventh section. "
    }
  ]
}