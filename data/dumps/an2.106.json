{
  "sutta_id": "AN2.106",
  "verses": [
    {
      "number": 1,
      "pali": "106 ",
      "english": "106 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, bālā. ",
      "english": "“Mendicants, there are two fools. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Yo ca avinaye vinayasaññī, yo ca vinaye avinayasaññī. ",
      "english": "One who perceives what is not the training as the training, and one who perceives what is the training as not the training. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve bālā”ti. ",
      "english": "These are the two fools.” "
    }
  ]
}