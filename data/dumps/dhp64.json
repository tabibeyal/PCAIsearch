{
  "sutta_id": "DHP64",
  "verses": [
    {
      "number": 1,
      "pali": "Udāyittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yāvajīvampi ce bālo, ",
      "english": "Though a fool attends to the wise "
    },
    {
      "number": 3,
      "pali": "paṇḍitaṁ payirupāsati; ",
      "english": "even for the rest of their life, "
    },
    {
      "number": 4,
      "pali": "Na so dhammaṁ vijānāti, ",
      "english": "they still don’t understand the teaching, "
    },
    {
      "number": 5,
      "pali": "dabbī sūparasaṁ yathā. ",
      "english": "like a spoon the taste of the soup. "
    }
  ]
}