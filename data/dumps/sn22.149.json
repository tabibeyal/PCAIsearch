    {
      "number": 3,
      "pali": "Anattānupassīsutta ",
      "english": "Observing Not-Self "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Saddhāpabbajitassa, bhikkhave, kulaputtassa ayamanudhammo hoti—",
      "english": "“Mendicants, when a gentleman has gone forth out of faith, this is what’s in line with the teaching. "
    },
    {
      "number": 6,
      "pali": "yaṁ rūpe anattānupassī vihareyya. ",
      "english": "They should meditate observing not-self in form, "
    },
    {
      "number": 7,
      "pali": "Vedanāya … ",
      "english": "feeling, "
    },
    {
      "number": 8,
      "pali": "saññāya … ",
      "english": "perception, "
    },
    {
      "number": 9,
      "pali": "saṅkhāresu … ",
      "english": "choices, "
    },
    {
      "number": 10,
      "pali": "viññāṇe anattānupassī vihareyya. ",
      "english": "and consciousness. … "
    },
    {
      "number": 11,
      "pali": "Anattānupassī viharanto, vedanāya … ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "saññāya … ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "saṅkhāresu … ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "viññāṇe anattānupassī viharanto rūpaṁ parijānāti, vedanaṁ …pe… ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "saññaṁ … ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "saṅkhāre … ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "viññāṇaṁ parijānāti. ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "So rūpaṁ parijānaṁ vedanaṁ parijānaṁ saññaṁ parijānaṁ saṅkhāre parijānaṁ viññāṇaṁ parijānaṁ parimuccati rūpamhā, parimuccati vedanāya, parimuccati saññāya, parimuccati saṅkhārehi, parimuccati viññāṇamhā, parimuccati jātiyā jarāya maraṇena sokehi paridevehi dukkhehi domanassehi upāyāsehi; ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "‘parimuccati dukkhasmā’ti vadāmī”ti. ",
      "english": "They’re freed from suffering, I say.” "
    },
    {
      "number": 20,
      "pali": "Cuddasamaṁ. ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Kukkuḷavaggo catuttho. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Kukkuḷā tayo aniccena, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "dukkhena apare tayo; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Anattena tayo vuttā, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "kulaputtena dve dukāti. ",
      "english": ""
    }
  ]
