{
  "sutta_id": "SN35.136",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 35.136",
      "english": "Linked Discourses 35.136"
    },
    {
      "number": 2,
      "pali": "Rūpārāma Sutta",
      "english": "Delight in Forms"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“Monks, devas & human beings take pleasure in forms, delight in forms, rejoice in forms. With the change, fading away, & cessation of forms, devas & human beings dwell in suffering & stress."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Devas & human beings take pleasure in sounds… take pleasure in aromas… take pleasure in flavors… take pleasure in tactile sensations…"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“Devas & human beings take pleasure in ideas, delight in ideas, rejoice in ideas. With the change, fading away, & cessation of ideas, devas & human beings dwell in suffering & stress."
    },
    {
      "number": 6,
      "pali": "",
      "english": "“But the Tathāgata, monks—worthy & rightly self-awakened—knowing, as they have come to be, the origination, the disappearance, the allure, the drawbacks of—and escape from—forms, doesn’t take pleasure in forms, delight in forms, rejoice in forms. With the change, fading away, & cessation of forms, the Tathāgata dwells happily."
    },
    {
      "number": 7,
      "pali": "",
      "english": "“Knowing, as they have come to be, the origination, the disappearance, the allure, the drawbacks of—and escape from—sounds… aromas… flavors… tactile sensations…"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“Knowing, as they have come to be, the origination, the disappearance, the allure, the drawbacks of—and escape from—ideas, he doesn’t take pleasure in ideas, delight in ideas, rejoice in ideas. With the change, fading away, & cessation of ideas, the Tathāgata dwells happily.”"
    },
    {
      "number": 9,
      "pali": "",
      "english": "“All sights, sounds, aromas, flavors,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "tactile sensations, & ideas"
    },
    {
      "number": 11,
      "pali": "",
      "english": "that are welcome,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "appealing,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "agreeable—"
    },
    {
      "number": 14,
      "pali": "",
      "english": "as long as they’re said"
    },
    {
      "number": 15,
      "pali": "",
      "english": "to exist,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "are supposed by the world"
    },
    {
      "number": 17,
      "pali": "",
      "english": "together with its devas"
    },
    {
      "number": 18,
      "pali": "",
      "english": "to be bliss."
    },
    {
      "number": 19,
      "pali": "",
      "english": "But when they cease,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "that’s supposed by them"
    },
    {
      "number": 21,
      "pali": "",
      "english": "to be stress."
    },
    {
      "number": 22,
      "pali": "",
      "english": "The stopping of self-identity"
    },
    {
      "number": 23,
      "pali": "",
      "english": "is viewed by the noble ones"
    },
    {
      "number": 24,
      "pali": "",
      "english": "as bliss."
    },
    {
      "number": 25,
      "pali": "",
      "english": "This, when seen,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "runs counter"
    },
    {
      "number": 27,
      "pali": "",
      "english": "to the whole world."
    },
    {
      "number": 28,
      "pali": "",
      "english": "What others say is blissful,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "the noble ones say is stress."
    },
    {
      "number": 30,
      "pali": "",
      "english": "What others say is stressful,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "the noble know as bliss."
    },
    {
      "number": 32,
      "pali": "",
      "english": "See the Dhamma, hard to understand!"
    },
    {
      "number": 33,
      "pali": "",
      "english": "Here those who don’t know"
    },
    {
      "number": 34,
      "pali": "",
      "english": "are confused."
    },
    {
      "number": 35,
      "pali": "",
      "english": "For those who are veiled,"
    },
    {
      "number": 36,
      "pali": "",
      "english": "it’s darkness,"
    },
    {
      "number": 37,
      "pali": "",
      "english": "blindness"
    },
    {
      "number": 38,
      "pali": "",
      "english": "for those who don’t see."
    },
    {
      "number": 39,
      "pali": "",
      "english": "But for the good it’s blatant,"
    },
    {
      "number": 40,
      "pali": "",
      "english": "like light for those who see."
    },
    {
      "number": 41,
      "pali": "",
      "english": "Though in its very presence,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "they don’t understand it—"
    },
    {
      "number": 43,
      "pali": "",
      "english": "dumb animals, unadept in the Dhamma."
    },
    {
      "number": 44,
      "pali": "",
      "english": "It’s not easy"
    },
    {
      "number": 45,
      "pali": "",
      "english": "for those overcome"
    },
    {
      "number": 46,
      "pali": "",
      "english": "by passion for becoming,"
    },
    {
      "number": 47,
      "pali": "",
      "english": "flowing along"
    },
    {
      "number": 48,
      "pali": "",
      "english": "in the stream of becoming,"
    },
    {
      "number": 49,
      "pali": "",
      "english": "falling under Māra’s sway,"
    },
    {
      "number": 50,
      "pali": "",
      "english": "to wake up"
    },
    {
      "number": 51,
      "pali": "",
      "english": "to this Dhamma."
    },
    {
      "number": 52,
      "pali": "",
      "english": "Who, apart from the noble,"
    },
    {
      "number": 53,
      "pali": "",
      "english": "is worthy to wake up"
    },
    {
      "number": 54,
      "pali": "",
      "english": "to this state?—"
    },
    {
      "number": 55,
      "pali": "",
      "english": "the state that,"
    },
    {
      "number": 56,
      "pali": "",
      "english": "through rightly knowing it,"
    },
    {
      "number": 57,
      "pali": "",
      "english": "they totally unbind,"
    },
    {
      "number": 58,
      "pali": "",
      "english": "effluent-free.”"
    }
  ]
}