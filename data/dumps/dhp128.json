{
  "sutta_id": "DHP128",
  "verses": [
    {
      "number": 1,
      "pali": "Suppabuddhasakyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na antalikkhe na samuddamajjhe, ",
      "english": "Not in midair, nor mid-ocean, "
    },
    {
      "number": 3,
      "pali": "Na pabbatānaṁ vivaraṁ pavissa; ",
      "english": "nor hiding in a mountain cleft; "
    },
    {
      "number": 4,
      "pali": "Na vijjatī so jagatippadeso, ",
      "english": "you’ll find no place on the planet "
    },
    {
      "number": 5,
      "pali": "Yatthaṭṭhitaṁ nappasaheyya maccu. ",
      "english": "where you won’t be vanquished by death. "
    },
    {
      "number": 6,
      "pali": "Pāpavaggo navamo. ",
      "english": ""
    }
  ]
}