{
  "sutta_id": "DHP2",
  "verses": [
    {
      "number": 1,
      "pali": "Maṭṭhakuṇḍalīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Manopubbaṅgamā dhammā, ",
      "english": "Intention shapes experiences; "
    },
    {
      "number": 3,
      "pali": "manoseṭṭhā manomayā; ",
      "english": "intention is first, they’re made by intention. "
    },
    {
      "number": 4,
      "pali": "Manasā ce pasannena, ",
      "english": "If with pure intent "
    },
    {
      "number": 5,
      "pali": "bhāsati vā karoti vā; ",
      "english": "you speak or act, "
    },
    {
      "number": 6,
      "pali": "Tato naṁ sukhamanveti, ",
      "english": "happiness follows you "
    },
    {
      "number": 7,
      "pali": "chāyāva anapāyinī. ",
      "english": "like a shadow that never leaves. "
    }
  ]
}