{
  "sutta_id": "DHP121",
  "verses": [
    {
      "number": 1,
      "pali": "Asaññataparikkhāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Māvamaññetha pāpassa, ",
      "english": "Think not lightly of evil, "
    },
    {
      "number": 3,
      "pali": "na mantaṁ āgamissati; ",
      "english": "that it won’t come back to you. "
    },
    {
      "number": 4,
      "pali": "Udabindunipātena, ",
      "english": "The pot is filled with water "
    },
    {
      "number": 5,
      "pali": "udakumbhopi pūrati; ",
      "english": "falling drop by drop; "
    },
    {
      "number": 6,
      "pali": "Bālo pūrati pāpassa, ",
      "english": "the fool is filled with wickedness "
    },
    {
      "number": 7,
      "pali": "thokaṁ thokampi ācinaṁ. ",
      "english": "piled up bit by bit. "
    }
  ]
}