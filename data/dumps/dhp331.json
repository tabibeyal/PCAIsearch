{
  "sutta_id": "DHP331",
  "verses": [
    {
      "number": 1,
      "pali": "Māravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Atthamhi jātamhi sukhā sahāyā, ",
      "english": "A friend in need is a blessing; "
    },
    {
      "number": 3,
      "pali": "Tuṭṭhī sukhā yā itarītarena; ",
      "english": "it’s a blessing to be content with whatever; "
    },
    {
      "number": 4,
      "pali": "Puññaṁ sukhaṁ jīvitasaṅkhayamhi, ",
      "english": "good deeds are a blessing at the end of life, "
    },
    {
      "number": 5,
      "pali": "Sabbassa dukkhassa sukhaṁ pahānaṁ. ",
      "english": "and giving up all suffering is a blessing. "
    }
  ]
}