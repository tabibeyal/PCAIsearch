{
  "sutta_id": "AN2.97",
  "verses": [
    {
      "number": 1,
      "pali": "97 ",
      "english": "97 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āpattikusalatā ca āpattivuṭṭhānakusalatā ca. ",
      "english": "Skill in offenses and skill in resolving offenses. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    },
    {
      "number": 6,
      "pali": "Dhammavaggo catuttho. ",
      "english": ""
    }
  ]
}