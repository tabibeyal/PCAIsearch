{
  "sutta_id": "SN2.7",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.7 ",
      "english": "Linked Discourses 2.7 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Pañcālacaṇḍasutta ",
      "english": "With Pañcālacaṇḍa "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhito kho pañcālacaṇḍo devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Pañcālacaṇḍa spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Sambādhe vata okāsaṁ, ",
      "english": "“The opening amid confinement "
    },
    {
      "number": 7,
      "pali": "Avindi bhūrimedhaso; ",
      "english": "was discovered by the Buddha of vast intelligence, "
    },
    {
      "number": 8,
      "pali": "Yo jhānamabujjhi buddho, ",
      "english": "who awakened to absorption, "
    },
    {
      "number": 9,
      "pali": "Paṭilīnanisabho munī”ti. ",
      "english": "the sage, the solitary boss bull.” "
    },
    {
      "number": 10,
      "pali": "“Sambādhe vāpi vindanti, ",
      "english": "“Even amid confinement they understand,” "
    },
    {
      "number": 11,
      "pali": "(pañcālacaṇḍāti bhagavā) ",
      "english": "said the Buddha to Pañcālacaṇḍa, "
    },
    {
      "number": 12,
      "pali": "Dhammaṁ nibbānapattiyā; ",
      "english": "“the principle for attaining extinguishment. "
    },
    {
      "number": 13,
      "pali": "Ye satiṁ paccalatthaṁsu, ",
      "english": "Those who have acquired mindfulness "
    },
    {
      "number": 14,
      "pali": "Sammā te susamāhitā”ti. ",
      "english": "are perfectly serene in samādhi.” "
    }
  ]
}