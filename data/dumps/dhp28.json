{
  "sutta_id": "DHP28",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākassapattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pamādaṁ appamādena, ",
      "english": "When the astute dispel negligence "
    },
    {
      "number": 3,
      "pali": "yadā nudati paṇḍito; ",
      "english": "by means of diligence, "
    },
    {
      "number": 4,
      "pali": "Paññāpāsādamāruyha, ",
      "english": "ascending the palace of wisdom, "
    },
    {
      "number": 5,
      "pali": "asoko sokiniṁ pajaṁ; ",
      "english": "sorrowless, they behold this generation of sorrow, "
    },
    {
      "number": 6,
      "pali": "Pabbataṭṭhova bhūmaṭṭhe, ",
      "english": "as an attentive one on a mountain top "
    },
    {
      "number": 7,
      "pali": "dhīro bāle avekkhati. ",
      "english": "beholds the fools below. "
    }
  ]
}