{
  "sutta_id": "DHP379",
  "verses": [
    {
      "number": 1,
      "pali": "Naṅgalakulattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attanā codayattānaṁ, ",
      "english": "Urge yourself on, "
    },
    {
      "number": 3,
      "pali": "paṭimaṁsetha attanā; ",
      "english": "reflect on yourself. "
    },
    {
      "number": 4,
      "pali": "So attagutto satimā, ",
      "english": "A mendicant self-controlled and mindful "
    },
    {
      "number": 5,
      "pali": "sukhaṁ bhikkhu vihāhisi. ",
      "english": "will always dwell in happiness. "
    }
  ]
}