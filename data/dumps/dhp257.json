{
  "sutta_id": "DHP257",
  "verses": [
    {
      "number": 1,
      "pali": "Asāhasena dhammena, ",
      "english": "A wise one judges others without haste, "
    },
    {
      "number": 2,
      "pali": "samena nayatī pare; ",
      "english": "justly and impartially; "
    },
    {
      "number": 3,
      "pali": "Dhammassa gutto medhāvī, ",
      "english": "that guardian of the law "
    },
    {
      "number": 4,
      "pali": "“dhammaṭṭho”ti pavuccati. ",
      "english": "is said to be just. "
    }
  ]
}