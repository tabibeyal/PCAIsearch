{
  "sutta_id": "DHP181",
  "verses": [
    {
      "number": 1,
      "pali": "Devorohaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ye jhānapasutā dhīrā, ",
      "english": "The attentive intent on absorption, "
    },
    {
      "number": 3,
      "pali": "nekkhammūpasame ratā; ",
      "english": "who love the peace of renunciation, "
    },
    {
      "number": 4,
      "pali": "Devāpi tesaṁ pihayanti, ",
      "english": "the Buddhas, ever mindful, "
    },
    {
      "number": 5,
      "pali": "sambuddhānaṁ satīmataṁ. ",
      "english": "are envied by even the gods. "
    }
  ]
}