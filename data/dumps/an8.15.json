{
  "sutta_id": "AN8.15",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.15 ",
      "english": "Numbered Discourses 8.15 "
    },
    {
      "number": 2,
      "pali": "2. Mahāvagga ",
      "english": "2. The Great Chapter "
    },
    {
      "number": 3,
      "pali": "Malasutta ",
      "english": "Stains "
    },
    {
      "number": 4,
      "pali": "“Aṭṭhimāni, bhikkhave, malāni. ",
      "english": "“Mendicants, there are these eight stains. "
    },
    {
      "number": 5,
      "pali": "Katamāni aṭṭha? ",
      "english": "What eight? "
    },
    {
      "number": 6,
      "pali": "Asajjhāyamalā, bhikkhave, mantā; ",
      "english": "Not rehearsing is the stain of hymns. "
    },
    {
      "number": 7,
      "pali": "anuṭṭhānamalā, bhikkhave, gharā; ",
      "english": "Neglect is the stain of houses. "
    },
    {
      "number": 8,
      "pali": "malaṁ, bhikkhave, vaṇṇassa kosajjaṁ; ",
      "english": "Laziness is the stain of beauty. "
    },
    {
      "number": 9,
      "pali": "pamādo, bhikkhave, rakkhato malaṁ; ",
      "english": "Negligence is a guard’s stain. "
    },
    {
      "number": 10,
      "pali": "malaṁ, bhikkhave, itthiyā duccaritaṁ; ",
      "english": "Misconduct is a woman’s stain. "
    },
    {
      "number": 11,
      "pali": "maccheraṁ, bhikkhave, dadato malaṁ; ",
      "english": "Stinginess is a giver’s stain. "
    },
    {
      "number": 12,
      "pali": "malā, bhikkhave, pāpakā akusalā dhammā asmiṁ loke paramhi ca; ",
      "english": "Bad, unskillful qualities are a stain in this world and the next. "
    },
    {
      "number": 13,
      "pali": "tato, bhikkhave, malā malataraṁ avijjā paramaṁ malaṁ. ",
      "english": "Worse than any of these is ignorance, the worst stain of all. "
    },
    {
      "number": 14,
      "pali": "Imāni kho, bhikkhave, aṭṭha malānīti. ",
      "english": "These are the eight stains. "
    },
    {
      "number": 15,
      "pali": "Asajjhāyamalā mantā, ",
      "english": "Not rehearsing is the stain of hymns. "
    },
    {
      "number": 16,
      "pali": "anuṭṭhānamalā gharā; ",
      "english": "The stain of houses is neglect. "
    },
    {
      "number": 17,
      "pali": "Malaṁ vaṇṇassa kosajjaṁ, ",
      "english": "Laziness is the stain of beauty. "
    },
    {
      "number": 18,
      "pali": "pamādo rakkhato malaṁ. ",
      "english": "A guard’s stain is negligence. "
    },
    {
      "number": 19,
      "pali": "Malitthiyā duccaritaṁ, ",
      "english": "Misconduct is a woman’s stain. "
    },
    {
      "number": 20,
      "pali": "maccheraṁ dadato malaṁ; ",
      "english": "A giver’s stain is stinginess. "
    },
    {
      "number": 21,
      "pali": "Malā ve pāpakā dhammā, ",
      "english": "Bad qualities are a stain "
    },
    {
      "number": 22,
      "pali": "asmiṁ loke paramhi ca; ",
      "english": "in this world and the next. "
    },
    {
      "number": 23,
      "pali": "Tato malā malataraṁ, ",
      "english": "But a worse stain than these "
    },
    {
      "number": 24,
      "pali": "avijjā paramaṁ malan”ti. ",
      "english": "is ignorance, the worst stain of all.” "
    },
    {
      "number": 25,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}