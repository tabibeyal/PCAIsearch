  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 20 ",
      "english": "So It Was Said 20 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Paduṭṭhacittasutta ",
      "english": "A Corrupted Mind "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Idhāhaṁ, bhikkhave, ekaccaṁ puggalaṁ paduṭṭhacittaṁ evaṁ cetasā ceto paricca pajānāmi: ",
      "english": "“Mendicants, when I’ve comprehended the mind of an individual whose mind is corrupted, I understand: "
    },
    {
      "number": 7,
      "pali": "‘imamhi cāyaṁ samaye puggalo kālaṁ kareyya yathābhataṁ nikkhitto evaṁ niraye’. ",
      "english": "‘If this individual were to die right now, they would be placed in hell as if delivered there.’ "
    },
    {
      "number": 8,
      "pali": "Taṁ kissa hetu? ",
      "english": "Why is that? "
    },
    {
      "number": 9,
      "pali": "Cittaṁ hissa, bhikkhave, paduṭṭhaṁ. ",
      "english": "Because their mind is corrupted. "
    },
    {
      "number": 10,
      "pali": "Cetopadosahetu kho pana, bhikkhave, evam’idhekacce sattā kāyassa bhedā paraṁ maraṇā apāyaṁ duggatiṁ vinipātaṁ nirayaṁ upapajjantī”ti. ",
      "english": "Corruption of mind is the reason why some sentient beings, when their body breaks up, after death, are reborn in a place of loss, a bad place, the underworld, hell.” "
    },
    {
      "number": 11,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 12,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 13,
      "pali": "“Paduṭṭhacittaṁ ñatvāna, ",
      "english": "“Knowing an individual’s "
    },
    {
      "number": 14,
      "pali": "ekaccaṁ idha puggalaṁ; ",
      "english": "corrupted mind, "
    },
    {
      "number": 15,
      "pali": "Etamatthañca byākāsi, ",
      "english": "the Buddha explained this matter "
    },
    {
      "number": 16,
      "pali": "buddho bhikkhūna santike. ",
      "english": "in the mendicants’ presence. "
    },
    {
      "number": 17,
      "pali": "Imamhi cāyaṁ samaye, ",
      "english": "If that individual "
    },
    {
      "number": 18,
      "pali": "kālaṁ kayirātha puggalo; ",
      "english": "were to die at this time, "
    },
    {
      "number": 19,
      "pali": "Nirayaṁ upapajjeyya, ",
      "english": "they’d be reborn in hell, "
    },
    {
      "number": 20,
      "pali": "cittaṁ hissa padūsitaṁ. ",
      "english": "for their mind is corrupted. "
    },
    {
      "number": 21,
      "pali": "Yathā haritvā nikkhipeyya, ",
      "english": "That sort is cast down as surely "
    },
    {
      "number": 22,
      "pali": "evamevaṁ tathāvidho; ",
      "english": "as if they’d been carried off and put there. "
    },
    {
      "number": 23,
      "pali": "Cetopadosahetu hi, ",
      "english": "For corruption of mind is the reason "
    },
    {
      "number": 24,
      "pali": "sattā gacchanti duggatin”ti. ",
      "english": "sentient beings go to a bad place.” "
    },
    {
      "number": 25,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 26,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 27,
      "pali": "Dutiyo vaggo. ",
      "english": ""
    },
    {
      "number": 28,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 29,
      "pali": "Moho kodho atha makkho, ",
      "english": ""
    },
    {
      "number": 30,
      "pali": "Vijjā taṇhā sekhaduve ca; ",
      "english": ""
    },
    {
      "number": 31,
      "pali": "Bhedo sāmaggipuggalo, ",
      "english": ""
    },
    {
      "number": 32,
      "pali": "Vaggamāhu dutiyanti vuccatīti. ",
      "english": ""
    }
  ]
