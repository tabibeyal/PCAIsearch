{
  "sutta_id": "SN20.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 20.12 ",
      "english": "Linked Discourses 20.12 "
    },
    {
      "number": 2,
      "pali": "1. Opammavagga ",
      "english": "1. Similes "
    },
    {
      "number": 3,
      "pali": "Dutiyasiṅgālasutta ",
      "english": "A Jackal (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Assuttha no tumhe, bhikkhave, rattiyā paccūsasamayaṁ jarasiṅgālassa vassamānassā”ti? ",
      "english": "“Mendicants, did you hear an old jackal howling at the crack of dawn?” "
    },
    {
      "number": 6,
      "pali": "“Evaṁ, bhante”. ",
      "english": "“Yes, sir.” "
    },
    {
      "number": 7,
      "pali": "“Siyā kho, bhikkhave, tasmiṁ jarasiṅgāle yā kāci kataññutā kataveditā, na tveva idhekacce sakyaputtiyapaṭiññe siyā yā kāci kataññutā kataveditā. ",
      "english": "“There might be some gratitude and thankfulness in that old jackal, but there is none in a certain person here who claims to follow the Sakyan. "
    },
    {
      "number": 8,
      "pali": "Tasmātiha, bhikkhave, evaṁ sikkhitabbaṁ: ",
      "english": "So you should train like this: "
    },
    {
      "number": 9,
      "pali": "‘kataññuno bhavissāma katavedino; ",
      "english": "‘We will be grateful and thankful. "
    },
    {
      "number": 10,
      "pali": "na ca no amhesu appakampi kataṁ nassissatī’ti. ",
      "english": "We won’t forget even a small thing done for us.’ "
    },
    {
      "number": 11,
      "pali": "Evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": "That’s how you should train.” "
    },
    {
      "number": 12,
      "pali": "Dvādasamaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Opammavaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Kūṭaṁ nakhasikhaṁ kulaṁ, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "okkhā satti dhanuggaho; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Āṇi kaliṅgaro nāgo, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "biḷāro dve siṅgālakāti. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Opammasaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses with similes are complete. "
    }
  ]
}