{
  "sutta_id": "DHP393",
  "verses": [
    {
      "number": 1,
      "pali": "Jaṭilabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na jaṭāhi na gottena, ",
      "english": "Not by matted hair or family, "
    },
    {
      "number": 3,
      "pali": "na jaccā hoti brāhmaṇo; ",
      "english": "or birth is one a brahmin. "
    },
    {
      "number": 4,
      "pali": "Yamhi saccañca dhammo ca, ",
      "english": "Those who are  truthful and principled: "
    },
    {
      "number": 5,
      "pali": "so sucī so ca brāhmaṇo. ",
      "english": "they are pure, they are brahmins. "
    }
  ]
}