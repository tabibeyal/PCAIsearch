    {
      "number": 2,
      "pali": "5. Cakkavattivagga ",
      "english": "5. A Wheel-Turning Monarch "
    },
    {
      "number": 3,
      "pali": "Mārasutta ",
      "english": "About Māra "
    },
    {
      "number": 4,
      "pali": "“Mārasenappamaddanaṁ vo, bhikkhave, maggaṁ desessāmi; ",
      "english": "“Mendicants, I will teach you a path for crushing Māra’s army. "
    },
    {
      "number": 5,
      "pali": "taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 6,
      "pali": "Katamo ca, bhikkhave, mārasenappamaddano maggo? ",
      "english": "And what is that path? "
    },
    {
      "number": 7,
      "pali": "Yadidaṁ—",
      "english": ""
    },
    {
      "number": 8,
      "pali": "satta bojjhaṅgā. ",
      "english": "It is the seven awakening factors. "
    },
    {
      "number": 9,
      "pali": "Katame satta? ",
      "english": "What seven? "
    },
    {
      "number": 10,
      "pali": "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—",
      "english": "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity. "
    },
    {
      "number": 11,
      "pali": "ayaṁ kho, bhikkhave, mārasenappamaddano maggo”ti. ",
      "english": "This is the path for crushing Māra’s army.” "
    },
    {
      "number": 12,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}