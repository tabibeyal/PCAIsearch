{
  "sutta_id": "SN45.39",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.39 ",
      "english": "Linked Discourses 45.39 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Paṭhamabrahmacariyasutta ",
      "english": "The Spiritual Path (1st) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Brahmacariyañca vo, bhikkhave, desessāmi, brahmacariyaphalāni ca. ",
      "english": "“Mendicants, I will teach you the spiritual path and the fruits of the spiritual path. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, brahmacariyaṁ? ",
      "english": "And what is the spiritual path? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, brahmacariyaṁ. ",
      "english": "This is called the spiritual path. "
    },
    {
      "number": 11,
      "pali": "Katamāni ca, bhikkhave, brahmacariyaphalāni? ",
      "english": "And what are the fruits of the spiritual path? "
    },
    {
      "number": 12,
      "pali": "Sotāpattiphalaṁ, sakadāgāmiphalaṁ, anāgāmiphalaṁ, arahattaphalaṁ—",
      "english": "The fruits of stream-entry, once-return, non-return, and perfection. "
    },
    {
      "number": 13,
      "pali": "imāni vuccanti, bhikkhave, brahmacariyaphalānī”ti. ",
      "english": "These are called the fruits of the spiritual path.” "
    },
    {
      "number": 14,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}