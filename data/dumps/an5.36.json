{
  "sutta_id": "AN5.36",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.36 ",
      "english": "Numbered Discourses 5.36 "
    },
    {
      "number": 2,
      "pali": "4. Sumanavagga ",
      "english": "4. With Sumanā "
    },
    {
      "number": 3,
      "pali": "Kāladānasutta ",
      "english": "Timely Gifts "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, kāladānāni. ",
      "english": "“Mendicants, there are these five timely gifts. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Āgantukassa dānaṁ deti; ",
      "english": "A gift to a visitor. "
    },
    {
      "number": 7,
      "pali": "gamikassa dānaṁ deti; ",
      "english": "A gift to someone setting out on a journey. "
    },
    {
      "number": 8,
      "pali": "gilānassa dānaṁ deti; ",
      "english": "A gift to someone who is sick. "
    },
    {
      "number": 9,
      "pali": "dubbhikkhe dānaṁ deti; ",
      "english": "A gift at a time of famine. "
    },
    {
      "number": 10,
      "pali": "yāni tāni navasassāni navaphalāni tāni paṭhamaṁ sīlavantesu patiṭṭhāpeti. ",
      "english": "Presenting the freshly harvested grains and fruits first to those who are ethical. "
    },
    {
      "number": 11,
      "pali": "Imāni kho, bhikkhave, pañca kāladānānīti. ",
      "english": "These are the five timely gifts. "
    },
    {
      "number": 12,
      "pali": "Kāle dadanti sappaññā, ",
      "english": "The wise give at the right time, "
    },
    {
      "number": 13,
      "pali": "vadaññū vītamaccharā; ",
      "english": "being bountiful and rid of stinginess. "
    },
    {
      "number": 14,
      "pali": "Kālena dinnaṁ ariyesu, ",
      "english": "A religious donation at the right time "
    },
    {
      "number": 15,
      "pali": "ujubhūtesu tādisu. ",
      "english": "to the noble ones, upright and unaffected, "
    },
    {
      "number": 16,
      "pali": "Vippasannamanā tassa, ",
      "english": "given with a clear and confident mind, "
    },
    {
      "number": 17,
      "pali": "vipulā hoti dakkhiṇā; ",
      "english": "is indeed abundant. "
    },
    {
      "number": 18,
      "pali": "Ye tattha anumodanti, ",
      "english": "Those who rejoice at that, "
    },
    {
      "number": 19,
      "pali": "veyyāvaccaṁ karonti vā; ",
      "english": "or do other services, "
    },
    {
      "number": 20,
      "pali": "Na tena dakkhiṇā ūnā, ",
      "english": "don’t miss out on the offering; "
    },
    {
      "number": 21,
      "pali": "tepi puññassa bhāgino. ",
      "english": "they too have a share in the merit. "
    },
    {
      "number": 22,
      "pali": "Tasmā dade appaṭivānacitto, ",
      "english": "So you should give without holding back, "
    },
    {
      "number": 23,
      "pali": "Yattha dinnaṁ mahapphalaṁ; ",
      "english": "where a gift is very fruitful. "
    },
    {
      "number": 24,
      "pali": "Puññāni paralokasmiṁ, ",
      "english": "The good deeds of sentient beings "
    },
    {
      "number": 25,
      "pali": "Patiṭṭhā honti pāṇinan”ti. ",
      "english": "support them in the next world.” "
    },
    {
      "number": 26,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}