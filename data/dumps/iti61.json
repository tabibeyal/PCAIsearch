{
  "sutta_id": "ITI61",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 61",
      "english": "Itivuttaka 61"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three eyes. Which three? The eye of flesh, the divine eye, & the eye of discernment. These are the three eyes.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "The eye of flesh,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "the eye divine,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "the eye of discernment"
    },
    {
      "number": 7,
      "pali": "",
      "english": "unsurpassed:"
    },
    {
      "number": 8,
      "pali": "",
      "english": "these three eyes were taught"
    },
    {
      "number": 9,
      "pali": "",
      "english": "by the Superlative Person."
    },
    {
      "number": 10,
      "pali": "",
      "english": "The arising of the eye of flesh"
    },
    {
      "number": 11,
      "pali": "",
      "english": "is the path to the eye divine."
    },
    {
      "number": 12,
      "pali": "",
      "english": "When knowledge arises,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "the eye of discernment unsurpassed:"
    },
    {
      "number": 14,
      "pali": "",
      "english": "whoever gains this eye"
    },
    {
      "number": 15,
      "pali": "",
      "english": "is–from all suffering & stress–"
    },
    {
      "number": 16,
      "pali": "",
      "english": "released."
    }
  ]
}