{
  "sutta_id": "ITI61",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 61 ",
      "english": "So It Was Said 61 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Cakkhusutta ",
      "english": "The Eye "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, cakkhūni. ",
      "english": "“Mendicants, there are these three eyes. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Maṁsacakkhu, dibbacakkhu, paññācakkhu—",
      "english": "The eye of the flesh, the eye of clairvoyance, and the eye of wisdom. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi cakkhūnī”ti. ",
      "english": "These are the three eyes.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Maṁsacakkhu dibbacakkhu, ",
      "english": "“The eye of flesh, the clairvoyant eye, "
    },
    {
      "number": 13,
      "pali": "paññācakkhu anuttaraṁ; ",
      "english": "the supreme eye of wisdom: "
    },
    {
      "number": 14,
      "pali": "Etāni tīṇi cakkhūni, ",
      "english": "these three eyes "
    },
    {
      "number": 15,
      "pali": "akkhāsi purisuttamo. ",
      "english": "were taught by the supreme person. "
    },
    {
      "number": 16,
      "pali": "Maṁsacakkhussa uppādo, ",
      "english": "The arising of the eye of flesh "
    },
    {
      "number": 17,
      "pali": "maggo dibbassa cakkhuno; ",
      "english": "is the path to the clairvoyant eye. "
    },
    {
      "number": 18,
      "pali": "Yato ñāṇaṁ udapādi, ",
      "english": "When knowledge arises—"
    },
    {
      "number": 19,
      "pali": "paññācakkhu anuttaraṁ; ",
      "english": "the supreme eye of wisdom—"
    },
    {
      "number": 20,
      "pali": "Yassa cakkhussa paṭilābhā, ",
      "english": "one who gains that eye "
    },
    {
      "number": 21,
      "pali": "sabbadukkhā pamuccatī”ti. ",
      "english": "is released from all suffering.” "
    },
    {
      "number": 22,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 23,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}