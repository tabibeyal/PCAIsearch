{
  "sutta_id": "SN1.19",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.19 ",
      "english": "Linked Discourses 1.19 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Kuṭikāsutta ",
      "english": "Little Hut "
    },
    {
      "number": 4,
      "pali": "“Kacci te kuṭikā natthi, ",
      "english": "“Don’t you have a little hut? "
    },
    {
      "number": 5,
      "pali": "kacci natthi kulāvakā; ",
      "english": "Don’t you have a little nest? "
    },
    {
      "number": 6,
      "pali": "Kacci santānakā natthi, ",
      "english": "Don’t you have any networks? "
    },
    {
      "number": 7,
      "pali": "kacci muttosi bandhanā”ti. ",
      "english": "Aren’t you free of shackles?” "
    },
    {
      "number": 8,
      "pali": "“Taggha me kuṭikā natthi, ",
      "english": "“Indeed I have no little hut. "
    },
    {
      "number": 9,
      "pali": "taggha natthi kulāvakā; ",
      "english": "Indeed I have no little nest. "
    },
    {
      "number": 10,
      "pali": "Taggha santānakā natthi, ",
      "english": "Indeed I have no networks. "
    },
    {
      "number": 11,
      "pali": "taggha muttomhi bandhanā”ti. ",
      "english": "Indeed I’m free from shackles.” "
    },
    {
      "number": 12,
      "pali": "“Kintāhaṁ kuṭikaṁ brūmi, ",
      "english": "“What do you think I call your little hut? "
    },
    {
      "number": 13,
      "pali": "kiṁ te brūmi kulāvakaṁ; ",
      "english": "What do I call your little nest? "
    },
    {
      "number": 14,
      "pali": "Kiṁ te santānakaṁ brūmi, ",
      "english": "What do I call your network? "
    },
    {
      "number": 15,
      "pali": "kintāhaṁ brūmi bandhanan”ti. ",
      "english": "And what do I call your shackle?” "
    },
    {
      "number": 16,
      "pali": "“Mātaraṁ kuṭikaṁ brūsi, ",
      "english": "“You call mother a little hut; "
    },
    {
      "number": 17,
      "pali": "bhariyaṁ brūsi kulāvakaṁ; ",
      "english": "and wife a little nest. "
    },
    {
      "number": 18,
      "pali": "Putte santānake brūsi, ",
      "english": "You call children a network, "
    },
    {
      "number": 19,
      "pali": "taṇhaṁ me brūsi bandhanan”ti. ",
      "english": "and you call my craving a shackle.” "
    },
    {
      "number": 20,
      "pali": "“Sāhu te kuṭikā natthi, ",
      "english": "“It’s good you have no little hut! "
    },
    {
      "number": 21,
      "pali": "sāhu natthi kulāvakā; ",
      "english": "It’s good you have no little nest! "
    },
    {
      "number": 22,
      "pali": "Sāhu santānakā natthi, ",
      "english": "It’s good you have no networks! "
    },
    {
      "number": 23,
      "pali": "sāhu muttosi bandhanā”ti. ",
      "english": "And good that you’re free from shackles.” "
    }
  ]
}