{
  "sutta_id": "AN8.37",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.37 ",
      "english": "Numbered Discourses 8.37 "
    },
    {
      "number": 2,
      "pali": "4. Dānavagga ",
      "english": "4. Giving "
    },
    {
      "number": 3,
      "pali": "Sappurisadānasutta ",
      "english": "Gifts of a True Person "
    },
    {
      "number": 4,
      "pali": "“Aṭṭhimāni, bhikkhave, sappurisadānāni. ",
      "english": "“Mendicants, there are these eight gifts of a true person. "
    },
    {
      "number": 5,
      "pali": "Katamāni aṭṭha? ",
      "english": "What eight? "
    },
    {
      "number": 6,
      "pali": "Suciṁ deti, paṇītaṁ deti, kālena deti, kappiyaṁ deti, viceyya deti, abhiṇhaṁ deti, dadaṁ cittaṁ pasādeti, datvā attamano hoti. ",
      "english": "Their gift is pure, good quality, timely, appropriate, intelligent, and regular. While giving their heart is confident, and afterwards they’re uplifted. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, aṭṭha sappurisadānānīti. ",
      "english": "These are the eight gifts of a true person. "
    },
    {
      "number": 8,
      "pali": "Suciṁ paṇītaṁ kālena, ",
      "english": "He gives pure, good quality, and timely gifts "
    },
    {
      "number": 9,
      "pali": "kappiyaṁ pānabhojanaṁ; ",
      "english": "of appropriate food and drinks "
    },
    {
      "number": 10,
      "pali": "Abhiṇhaṁ dadāti dānaṁ, ",
      "english": "regularly to spiritual practitioners "
    },
    {
      "number": 11,
      "pali": "sukhettesu brahmacārisu. ",
      "english": "who are fertile fields of merit. "
    },
    {
      "number": 12,
      "pali": "Neva vippaṭisārissa, ",
      "english": "They never regret "
    },
    {
      "number": 13,
      "pali": "cajitvā āmisaṁ bahuṁ; ",
      "english": "giving away many things of the flesh. "
    },
    {
      "number": 14,
      "pali": "Evaṁ dinnāni dānāni, ",
      "english": "Discerning people praise "
    },
    {
      "number": 15,
      "pali": "vaṇṇayanti vipassino. ",
      "english": "giving such gifts. "
    },
    {
      "number": 16,
      "pali": "Evaṁ yajitvā medhāvī, ",
      "english": "An intelligent person sacrifices like this, "
    },
    {
      "number": 17,
      "pali": "saddho muttena cetasā; ",
      "english": "faithful, with a mind of letting go. "
    },
    {
      "number": 18,
      "pali": "Abyābajjhaṁ sukhaṁ lokaṁ, ",
      "english": "Such an astute person is reborn "
    },
    {
      "number": 19,
      "pali": "paṇḍito upapajjatī”ti. ",
      "english": "in a happy, pleasing world.” "
    },
    {
      "number": 20,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}