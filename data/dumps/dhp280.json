{
  "sutta_id": "DHP280",
  "verses": [
    {
      "number": 1,
      "pali": "Padhānakammikatissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Uṭṭhānakālamhi anuṭṭhahāno, ",
      "english": "They don’t get going when it’s time to start; "
    },
    {
      "number": 3,
      "pali": "Yuvā balī ālasiyaṁ upeto; ",
      "english": "they’re young and strong, but given to sloth. "
    },
    {
      "number": 4,
      "pali": "Saṁsannasaṅkappamano kusīto, ",
      "english": "Their mind depressed in sunken thought, "
    },
    {
      "number": 5,
      "pali": "Paññāya maggaṁ alaso na vindati. ",
      "english": "lazy and slothful, they can’t discern the path. "
    }
  ]
}