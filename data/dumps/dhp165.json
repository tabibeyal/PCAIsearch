{
  "sutta_id": "DHP165",
  "verses": [
    {
      "number": 1,
      "pali": "Cūḷakālaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attanā hi kataṁ pāpaṁ, ",
      "english": "For it is by oneself that evil’s done, "
    },
    {
      "number": 3,
      "pali": "attanā saṅkilissati; ",
      "english": "one is corrupted by oneself. "
    },
    {
      "number": 4,
      "pali": "Attanā akataṁ pāpaṁ, ",
      "english": "It’s by oneself that evil’s not done, "
    },
    {
      "number": 5,
      "pali": "attanāva visujjhati; ",
      "english": "one is purified by oneself. "
    },
    {
      "number": 6,
      "pali": "Suddhī asuddhi paccattaṁ, ",
      "english": "Purity and impurity are personal matters, "
    },
    {
      "number": 7,
      "pali": "nāñño aññaṁ visodhaye. ",
      "english": "no one can purify another. "
    }
  ]
}