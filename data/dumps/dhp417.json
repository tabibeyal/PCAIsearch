{
  "sutta_id": "DHP417",
  "verses": [
    {
      "number": 1,
      "pali": "Naṭaputtakattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Hitvā mānusakaṁ yogaṁ, ",
      "english": "They’ve thrown off the human yoke, "
    },
    {
      "number": 3,
      "pali": "dibbaṁ yogaṁ upaccagā; ",
      "english": "and slipped out of the heavenly yoke; "
    },
    {
      "number": 4,
      "pali": "Sabbayogavisaṁyuttaṁ, ",
      "english": "unyoked from all yokes: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}