{
  "sutta_id": "SN23.13",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 23.13 ",
      "english": "Linked Discourses 23.13 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyamāravagga ",
      "english": "2. About Māra (2nd) "
    },
    {
      "number": 3,
      "pali": "Aniccasutta ",
      "english": "Impermanence "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ nisinno kho āyasmā rādho bhagavantaṁ etadavoca: ",
      "english": "Seated to one side, Venerable Rādha said to the Buddha: "
    },
    {
      "number": 6,
      "pali": "“‘aniccaṁ, aniccan’ti, bhante, vuccati. ",
      "english": "“Sir, they speak of ‘impermanence’. "
    },
    {
      "number": 7,
      "pali": "Katamaṁ nu kho, bhante, aniccan”ti? ",
      "english": "What has impermanent nature?” "
    },
    {
      "number": 8,
      "pali": "“Rūpaṁ kho, rādha, aniccaṁ, vedanā aniccā, saññā aniccā, saṅkhārā aniccā, viññāṇaṁ aniccaṁ. ",
      "english": "“Rādha, form, feeling, perception, choices, and consciousness are impermanent. "
    },
    {
      "number": 9,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 10,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 11,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}