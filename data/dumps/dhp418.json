{
  "sutta_id": "DHP418",
  "verses": [
    {
      "number": 1,
      "pali": "Naṭaputtakattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Hitvā ratiñca aratiñca, ",
      "english": "Giving up desire and discontent, "
    },
    {
      "number": 3,
      "pali": "sītibhūtaṁ nirūpadhiṁ; ",
      "english": "they’re cooled and free of attachments; "
    },
    {
      "number": 4,
      "pali": "Sabbalokābhibhuṁ vīraṁ, ",
      "english": "a hero, master of the whole world: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}