{
  "sutta_id": "DHP234",
  "verses": [
    {
      "number": 1,
      "pali": "Kāyena saṁvutā dhīrā, ",
      "english": "An attentive one is restrained in body "
    },
    {
      "number": 2,
      "pali": "atho vācāya saṁvutā; ",
      "english": "restrained also in speech, "
    },
    {
      "number": 3,
      "pali": "Manasā saṁvutā dhīrā, ",
      "english": "in thought, too, they are restrained: "
    },
    {
      "number": 4,
      "pali": "te ve suparisaṁvutā. ",
      "english": "they are restrained in every way. "
    },
    {
      "number": 5,
      "pali": "Kodhavaggo sattarasamo. ",
      "english": ""
    }
  ]
}