{
  "sutta_id": "ITI57",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 57 ",
      "english": "So It Was Said 57 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Dutiyaāsavasutta ",
      "english": "Defilements (2nd) "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, āsavā. ",
      "english": "“Mendicants, there are these three defilements. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāmāsavo, bhavāsavo, avijjāsavo—",
      "english": "The defilements of sensuality, desire to be reborn, and ignorance. "
    },
    {
      "number": 9,
      "pali": "ime kho, bhikkhave, tayo āsavā”ti. ",
      "english": "These are the three defilements.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Yassa kāmāsavo khīṇo, ",
      "english": "“One who has ended the defilement of sensuality, "
    },
    {
      "number": 13,
      "pali": "avijjā ca virājitā; ",
      "english": "whose ignorance has faded away, "
    },
    {
      "number": 14,
      "pali": "Bhavāsavo parikkhīṇo, ",
      "english": "and whose desire to be reborn is finished—"
    },
    {
      "number": 15,
      "pali": "vippamutto nirūpadhi; ",
      "english": "liberated, free of attachments, "
    },
    {
      "number": 16,
      "pali": "Dhāreti antimaṁ dehaṁ, ",
      "english": "they bear their final body, "
    },
    {
      "number": 17,
      "pali": "jetvā māraṁ savāhinin”ti. ",
      "english": "having vanquished Māra with his legions.” "
    },
    {
      "number": 18,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 19,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}