    {
      "number": 1,
      "pali": "Itivuttaka 57",
      "english": "Itivuttaka 57"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three effluents. Which three? The effluent of sensuality, the effluent of becoming, the effluent of ignorance. These are the three effluents.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "His effluent of sensuality"
    },
    {
      "number": 5,
      "pali": "",
      "english": "ended,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "his ignorance"
    },
    {
      "number": 7,
      "pali": "",
      "english": "faded away,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "his effluent of becoming"
    },
    {
      "number": 9,
      "pali": "",
      "english": "exhausted:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "one totally released, acquisition-free,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "bears his last body,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "having conquered Māra"
    },
    {
      "number": 13,
      "pali": "",
      "english": "along with his mount."
    }
  ]
}