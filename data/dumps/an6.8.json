{
  "sutta_id": "AN6.8",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 6.8 ",
      "english": "Numbered Discourses 6.8 "
    },
    {
      "number": 2,
      "pali": "1. Āhuneyyavagga ",
      "english": "1. Worthy of Offerings "
    },
    {
      "number": 3,
      "pali": "Anuttariyasutta ",
      "english": "Unsurpassable "
    },
    {
      "number": 4,
      "pali": "“Chayimāni, bhikkhave, anuttariyāni. ",
      "english": "“Mendicants, these six things are unsurpassable. "
    },
    {
      "number": 5,
      "pali": "Katamāni cha? ",
      "english": "What six? "
    },
    {
      "number": 6,
      "pali": "Dassanānuttariyaṁ, savanānuttariyaṁ, lābhānuttariyaṁ, sikkhānuttariyaṁ, pāricariyānuttariyaṁ, anussatānuttariyaṁ. ",
      "english": "The unsurpassable seeing, listening, acquisition, training, service, and recollection. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cha anuttariyānī”ti. ",
      "english": "These are the six unsurpassable things.” "
    },
    {
      "number": 8,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}