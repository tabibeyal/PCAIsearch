{
  "sutta_id": "DHP199",
  "verses": [
    {
      "number": 1,
      "pali": "Susukhaṁ vata jīvāma, ",
      "english": "Let us live so very happily, "
    },
    {
      "number": 2,
      "pali": "ussukesu anussukā; ",
      "english": "content among the greedy. "
    },
    {
      "number": 3,
      "pali": "Ussukesu manussesu, ",
      "english": "Among greedy humans, "
    },
    {
      "number": 4,
      "pali": "viharāma anussukā. ",
      "english": "let us live content. "
    }
  ]
}