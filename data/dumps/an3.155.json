{
  "sutta_id": "AN3.155",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 3.155 ",
      "english": "Numbered Discourses 3.155 "
    },
    {
      "number": 2,
      "pali": "15. Maṅgalavagga ",
      "english": "15. Good Fortune "
    },
    {
      "number": 3,
      "pali": "Pubbaṇhasutta ",
      "english": "Morning "
    },
    {
      "number": 4,
      "pali": "“Ye, bhikkhave, sattā pubbaṇhasamayaṁ kāyena sucaritaṁ caranti, vācāya sucaritaṁ caranti, manasā sucaritaṁ caranti, supubbaṇho, bhikkhave, tesaṁ sattānaṁ. ",
      "english": "“Mendicants, those sentient beings who do good things in the morning by way of body, speech, and mind have a good morning. "
    },
    {
      "number": 5,
      "pali": "Ye, bhikkhave, sattā majjhanhikasamayaṁ kāyena sucaritaṁ caranti, vācāya sucaritaṁ caranti, manasā sucaritaṁ caranti, sumajjhanhiko, bhikkhave, tesaṁ sattānaṁ. ",
      "english": "Those sentient beings who do good things at midday by way of body, speech, and mind have a good midday. "
    },
    {
      "number": 6,
      "pali": "Ye, bhikkhave, sattā sāyanhasamayaṁ kāyena sucaritaṁ caranti, vācāya sucaritaṁ caranti, manasā sucaritaṁ caranti, susāyanho, bhikkhave, tesaṁ sattānanti. ",
      "english": "Those sentient beings who do good things in the evening by way of body, speech, and mind have a good evening. "
    },
    {
      "number": 7,
      "pali": "Sunakkhattaṁ sumaṅgalaṁ, ",
      "english": "A good star, a good fortune, "
    },
    {
      "number": 8,
      "pali": "suppabhātaṁ suhuṭṭhitaṁ; ",
      "english": "a good dawn, a good rising, "
    },
    {
      "number": 9,
      "pali": "Sukhaṇo sumuhutto ca, ",
      "english": "a good moment, a good hour: "
    },
    {
      "number": 10,
      "pali": "suyiṭṭhaṁ brahmacārisu. ",
      "english": "these come with good gifts to spiritual practitioners. "
    },
    {
      "number": 11,
      "pali": "Padakkhiṇaṁ kāyakammaṁ, ",
      "english": "Auspicious deeds of body, "
    },
    {
      "number": 12,
      "pali": "vācākammaṁ padakkhiṇaṁ; ",
      "english": "verbal auspicious deeds, "
    },
    {
      "number": 13,
      "pali": "Padakkhiṇaṁ manokammaṁ, ",
      "english": "auspicious deeds of mind, "
    },
    {
      "number": 14,
      "pali": "paṇīdhi te padakkhiṇe; ",
      "english": "auspicious resolutions: "
    },
    {
      "number": 15,
      "pali": "Padakkhiṇāni katvāna, ",
      "english": "when your deeds have been auspicious, "
    },
    {
      "number": 16,
      "pali": "labhantatthe padakkhiṇe. ",
      "english": "you get auspicious benefits. "
    },
    {
      "number": 17,
      "pali": "Te atthaladdhā sukhitā, ",
      "english": "Those happy with these benefits "
    },
    {
      "number": 18,
      "pali": "viruḷhā buddhasāsane; ",
      "english": "flourish in the Buddha’s teaching. "
    },
    {
      "number": 19,
      "pali": "Arogā sukhitā hotha, ",
      "english": "May you and all your relatives "
    },
    {
      "number": 20,
      "pali": "saha sabbehi ñātibhī”ti. ",
      "english": "be healthy and happy!” "
    },
    {
      "number": 21,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Maṅgalavaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Akusalañca sāvajjaṁ, ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "visamāsucinā saha; ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "Caturo khatā vandanā, ",
      "english": ""
    },
    {
      "number": 27,
      "pali": "pubbaṇhena ca te dasāti. ",
      "english": ""
    },
    {
      "number": 28,
      "pali": "Tatiyo paṇṇāsako samatto. ",
      "english": ""
    }
  ]
}