{
  "sutta_id": "AN4.141",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.141 ",
      "english": "Numbered Discourses 4.141 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Ābhāsutta ",
      "english": "Brightness "
    },
    {
      "number": 4,
      "pali": "“Catasso imā, bhikkhave, ābhā. ",
      "english": "“Mendicants, there are these four kinds of brightness. "
    },
    {
      "number": 5,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Candābhā, sūriyābhā, aggābhā, paññābhā—",
      "english": "The brightness of the moon, sun, fire, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, catasso ābhā. ",
      "english": "These are the four kinds of brightness. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imāsaṁ catunnaṁ ābhānaṁ yadidaṁ paññābhā”ti. ",
      "english": "The best of these four kinds of brightness is the brightness of wisdom.” "
    },
    {
      "number": 9,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}