{
  "sutta_id": "DHP311",
  "verses": [
    {
      "number": 1,
      "pali": "Dubbacabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kuso yathā duggahito, ",
      "english": "When kusa grass is wrongly grasped "
    },
    {
      "number": 3,
      "pali": "hatthamevānukantati; ",
      "english": "it only cuts the hand. "
    },
    {
      "number": 4,
      "pali": "Sāmaññaṁ dupparāmaṭṭhaṁ, ",
      "english": "So too, the ascetic life, when wrongly taken, "
    },
    {
      "number": 5,
      "pali": "nirayāyupakaḍḍhati. ",
      "english": "drags you to hell. "
    }
  ]
}