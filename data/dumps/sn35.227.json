    },
    {
      "number": 2,
      "pali": "17. Saṭṭhipeyyālavagga ",
      "english": "17. Sixty Abbreviated Texts "
    },
    {
      "number": 3,
      "pali": "Bāhirāyatanaanattasutta ",
      "english": "The Exterior as Not-Self "
    },
    {
      "number": 4,
      "pali": "“Rūpā, bhikkhave, anattā. Saddā … gandhā … rasā … phoṭṭhabbā … dhammā anattā. ",
      "english": "“Mendicants, sights, sounds, smells, tastes, touches, and ideas are not-self. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 7,
      "pali": "Saṭṭhipeyyālo samatto. ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Chandenaṭṭhārasa honti, ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "atītena ca dve nava; ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Yadaniccāṭṭhārasa vuttā, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "tayo ajjhattabāhirā; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Peyyālo saṭṭhiko vutto, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "buddhenādiccabandhunāti. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Suttantāni saṭṭhi. ",
      "english": ""
    }
  ]
}