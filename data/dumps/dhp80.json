{
  "sutta_id": "DHP80",
  "verses": [
    {
      "number": 1,
      "pali": "Paṇḍitasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Udakañhi nayanti nettikā, ",
      "english": "Irrigators guide water, "
    },
    {
      "number": 3,
      "pali": "Usukārā namayanti tejanaṁ; ",
      "english": "fletchers straighten arrows, "
    },
    {
      "number": 4,
      "pali": "Dāruṁ namayanti tacchakā, ",
      "english": "carpenters carve timber, "
    },
    {
      "number": 5,
      "pali": "Attānaṁ damayanti paṇḍitā. ",
      "english": "the astute tame themselves. "
    }
  ]
}