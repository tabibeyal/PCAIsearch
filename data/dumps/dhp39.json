{
  "sutta_id": "DHP39",
  "verses": [
    {
      "number": 1,
      "pali": "Anavassutacittassa, ",
      "english": "One whose mind is not festering, "
    },
    {
      "number": 2,
      "pali": "ananvāhatacetaso; ",
      "english": "whose heart is undamaged, "
    },
    {
      "number": 3,
      "pali": "Puññapāpapahīnassa, ",
      "english": "who’s given up right and wrong, "
    },
    {
      "number": 4,
      "pali": "natthi jāgarato bhayaṁ. ",
      "english": "alert, has nothing to fear. "
    }
  ]
}