{
  "sutta_id": "ITI24",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 24 ",
      "english": "So It Was Said 24 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Aṭṭhipuñjasutta ",
      "english": "A Heap of Bones "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Ekapuggalassa, bhikkhave, kappaṁ sandhāvato saṁsarato siyā evaṁ mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi yathāyaṁ vepullo pabbato, sace saṁhārako assa, sambhatañca na vinasseyyā”ti. ",
      "english": "“Mendicants, one person roaming and transmigrating for an eon would amass a heap of bones the size of this Mount Vepulla, if they were gathered together and not lost.” "
    },
    {
      "number": 7,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 8,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 9,
      "pali": "“Ekassekena kappena, ",
      "english": "“If the bones of a single individual "
    },
    {
      "number": 10,
      "pali": "puggalassaṭṭhisañcayo; ",
      "english": "for a single eon were gathered up, "
    },
    {
      "number": 11,
      "pali": "Siyā pabbatasamo rāsi, ",
      "english": "they’d make a pile the size of a mountain: "
    },
    {
      "number": 12,
      "pali": "iti vuttaṁ mahesinā. ",
      "english": "so said the great seer. "
    },
    {
      "number": 13,
      "pali": "So kho panāyaṁ akkhāto, ",
      "english": "And this is declared to be "
    },
    {
      "number": 14,
      "pali": "vepullo pabbato mahā; ",
      "english": "as huge as Mount Vepulla, "
    },
    {
      "number": 15,
      "pali": "Uttaro gijjhakūṭassa, ",
      "english": "higher than the Vulture’s Peak "
    },
    {
      "number": 16,
      "pali": "magadhānaṁ giribbaje. ",
      "english": "near the Mountainfold of the Magadhans. "
    },
    {
      "number": 17,
      "pali": "Yato ca ariyasaccāni, ",
      "english": "But then, with right understanding, "
    },
    {
      "number": 18,
      "pali": "sammappaññāya passati; ",
      "english": "one sees the noble truths—"
    },
    {
      "number": 19,
      "pali": "Dukkhaṁ dukkhasamuppādaṁ, ",
      "english": "suffering, suffering’s origin, "
    },
    {
      "number": 20,
      "pali": "dukkhassa ca atikkamaṁ; ",
      "english": "suffering’s transcendence, "
    },
    {
      "number": 21,
      "pali": "Ariyañcaṭṭhaṅgikaṁ maggaṁ, ",
      "english": "and the noble eightfold path "
    },
    {
      "number": 22,
      "pali": "dukkhūpasamagāminaṁ. ",
      "english": "that leads to the stilling of suffering. "
    },
    {
      "number": 23,
      "pali": "Sa sattakkhattuṁ paramaṁ, ",
      "english": "After roaming on seven times at most, "
    },
    {
      "number": 24,
      "pali": "sandhāvitvāna puggalo; ",
      "english": "that individual "
    },
    {
      "number": 25,
      "pali": "Dukkhassantakaro hoti, ",
      "english": "makes an end of suffering, "
    },
    {
      "number": 26,
      "pali": "sabbasaṁyojanakkhayā”ti. ",
      "english": "with the ending of all fetters.” "
    },
    {
      "number": 27,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 28,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}