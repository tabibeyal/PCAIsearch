  "sutta_id": "ITI24",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 24",
      "english": "Itivuttaka 24"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, if a single person were to wander & transmigrate on for an eon, he/she would leave behind a chain of bones, a pile of bones, a heap of bones, as large as this Mount Vepulla, if there were someone to collect them and the collection were not destroyed.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "The accumulation"
    },
    {
      "number": 5,
      "pali": "",
      "english": "of a single person’s"
    },
    {
      "number": 6,
      "pali": "",
      "english": "bones for an eon"
    },
    {
      "number": 7,
      "pali": "",
      "english": "would be a heap"
    },
    {
      "number": 8,
      "pali": "",
      "english": "on a par with the mountain,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "so said the Great Seer."
    },
    {
      "number": 10,
      "pali": "",
      "english": "(He declared this to be"
    },
    {
      "number": 11,
      "pali": "",
      "english": "the great Mount Vepulla"
    },
    {
      "number": 12,
      "pali": "",
      "english": "to the north of Vulture Peak"
    },
    {
      "number": 13,
      "pali": "",
      "english": "in the mountain-ring"
    },
    {
      "number": 14,
      "pali": "",
      "english": "of the Magadhans.)"
    },
    {
      "number": 15,
      "pali": "",
      "english": "But when that person sees"
    },
    {
      "number": 16,
      "pali": "",
      "english": "with right discernment"
    },
    {
      "number": 17,
      "pali": "",
      "english": "the four Noble Truths–"
    },
    {
      "number": 18,
      "pali": "",
      "english": "stress,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "the cause of stress,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "the transcending of stress,"
    },
    {
      "number": 21,
      "pali": "",
      "english": "& the noble eightfold path,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "the way to the stilling of stress–"
    },
    {
      "number": 23,
      "pali": "",
      "english": "having wandered on"
    },
    {
      "number": 24,
      "pali": "",
      "english": "seven times at most, then,"
    },
    {
      "number": 25,
      "pali": "",
      "english": "with the ending of all fetters,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "he makes an end"
    },
    {
      "number": 27,
      "pali": "",
      "english": "of stress."
    }
  ]
}