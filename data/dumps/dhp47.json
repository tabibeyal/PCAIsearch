{
  "sutta_id": "DHP47",
  "verses": [
    {
      "number": 1,
      "pali": "Viṭaṭūbhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pupphāni heva pacinantaṁ, ",
      "english": "As a mighty flood sweeps off a sleeping village, "
    },
    {
      "number": 3,
      "pali": "byāsattamanasaṁ naraṁ; ",
      "english": "death steals away a man "
    },
    {
      "number": 4,
      "pali": "Suttaṁ gāmaṁ mahoghova, ",
      "english": "even as he gathers flowers, "
    },
    {
      "number": 5,
      "pali": "maccu ādāya gacchati. ",
      "english": "his mind caught up in them. "
    }
  ]
}