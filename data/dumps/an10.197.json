  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.197 ",
      "english": "Numbered Discourses 10.197 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Anussaritabbasutta ",
      "english": "Should Be Recollected "
    },
    {
      "number": 4,
      "pali": "“Anussaritabbañca vo, bhikkhave, dhammaṁ desessāmi nānussaritabbañca. ",
      "english": "“I will teach you the principle to recollect and the principle not to recollect. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, nānussaritabbo dhammo? ",
      "english": "And what is the principle not to recollect? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, nānussaritabbo dhammo. ",
      "english": "This is called the principle not to recollect. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, anussaritabbo dhammo? ",
      "english": "And what is the principle to recollect? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, anussaritabbo dhammo”ti. ",
      "english": "This is called the principle to recollect.” "
    },
    {
      "number": 14,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}