{
  "sutta_id": "KHP8",
  "verses": [
    {
      "number": 1,
      "pali": "Khuddakapatha 8",
      "english": "Khuddakapatha 8"
    },
    {
      "number": 2,
      "pali": "Nidhi Kaṇḍa",
      "english": "The Reserve Fund"
    },
    {
      "number": 3,
      "pali": "",
      "english": "A person stashes a fund away"
    },
    {
      "number": 4,
      "pali": "",
      "english": "deep underground, at the water line:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“When a need or duty arises,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "this will provide for my needs,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "for my release if I’m denounced by the king,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "molested by thieves,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "in case of debt, famine, or accidents.”"
    },
    {
      "number": 10,
      "pali": "",
      "english": "With aims like this"
    },
    {
      "number": 11,
      "pali": "",
      "english": "in the world"
    },
    {
      "number": 12,
      "pali": "",
      "english": "a reserve fund is stashed away."
    },
    {
      "number": 13,
      "pali": "",
      "english": "But no matter how well it’s stored,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "deep underground, at the water line,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "it won’t all always serve one’s need."
    },
    {
      "number": 16,
      "pali": "",
      "english": "The fund gets shifted from its place,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "or one’s memory gets confused;"
    },
    {
      "number": 18,
      "pali": "",
      "english": "or—unseen—"
    },
    {
      "number": 19,
      "pali": "",
      "english": "nāgas make off with it,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "spirits steal it,"
    },
    {
      "number": 21,
      "pali": "",
      "english": "or hateful heirs run off with it."
    },
    {
      "number": 22,
      "pali": "",
      "english": "When one’s merit’s ended,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "it’s totally destroyed."
    },
    {
      "number": 24,
      "pali": "",
      "english": "But when a man or woman"
    },
    {
      "number": 25,
      "pali": "",
      "english": "has laid aside a well-stored fund"
    },
    {
      "number": 26,
      "pali": "",
      "english": "of generosity, virtue,"
    },
    {
      "number": 27,
      "pali": "",
      "english": "restraint, & self-control,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "with regard to a shrine,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "the Saṅgha,"
    },
    {
      "number": 30,
      "pali": "",
      "english": "a fine individual,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "guests,"
    },
    {
      "number": 32,
      "pali": "",
      "english": "mother, father,"
    },
    {
      "number": 33,
      "pali": "",
      "english": "or elder sibling:"
    },
    {
      "number": 34,
      "pali": "",
      "english": "That’s a well-stored fund."
    },
    {
      "number": 35,
      "pali": "",
      "english": "It can’t be wrested away."
    },
    {
      "number": 36,
      "pali": "",
      "english": "It follows you along."
    },
    {
      "number": 37,
      "pali": "",
      "english": "When, having left this world,"
    },
    {
      "number": 38,
      "pali": "",
      "english": "for wherever you must go,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "you take it with you."
    },
    {
      "number": 40,
      "pali": "",
      "english": "This fund is not held in common with others,"
    },
    {
      "number": 41,
      "pali": "",
      "english": "& cannot be stolen by thieves."
    },
    {
      "number": 42,
      "pali": "",
      "english": "So, enlightened, you should make merit,"
    },
    {
      "number": 43,
      "pali": "",
      "english": "the fund that will follow you along."
    },
    {
      "number": 44,
      "pali": "",
      "english": "This is the fund"
    },
    {
      "number": 45,
      "pali": "",
      "english": "that gives all they want"
    },
    {
      "number": 46,
      "pali": "",
      "english": "to beings human, divine."
    },
    {
      "number": 47,
      "pali": "",
      "english": "Whatever devas aspire to,"
    },
    {
      "number": 48,
      "pali": "",
      "english": "that is all gained by this."
    },
    {
      "number": 49,
      "pali": "",
      "english": "A fine complexion, fine voice,"
    },
    {
      "number": 50,
      "pali": "",
      "english": "a body well-built, well-formed,"
    },
    {
      "number": 51,
      "pali": "",
      "english": "lordship, a following:"
    },
    {
      "number": 52,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 53,
      "pali": "",
      "english": "Earthly kingship, supremacy,"
    },
    {
      "number": 54,
      "pali": "",
      "english": "the bliss of an emperor,"
    },
    {
      "number": 55,
      "pali": "",
      "english": "kingship over devas in the heavens:"
    },
    {
      "number": 56,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 57,
      "pali": "",
      "english": "The attainment of the human state,"
    },
    {
      "number": 58,
      "pali": "",
      "english": "any delight in heaven,"
    },
    {
      "number": 59,
      "pali": "",
      "english": "the attainment of unbinding:"
    },
    {
      "number": 60,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 61,
      "pali": "",
      "english": "Excellent friends,"
    },
    {
      "number": 62,
      "pali": "",
      "english": "appropriate application,"
    },
    {
      "number": 63,
      "pali": "",
      "english": "mastery of clear knowing & release :"
    },
    {
      "number": 64,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 65,
      "pali": "",
      "english": "Acumen, emancipations,"
    },
    {
      "number": 66,
      "pali": "",
      "english": "the perfection of disciplehood:"
    },
    {
      "number": 67,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 68,
      "pali": "",
      "english": "Private awakening,"
    },
    {
      "number": 69,
      "pali": "",
      "english": "Buddhahood:"
    },
    {
      "number": 70,
      "pali": "",
      "english": "That is all gained by this."
    },
    {
      "number": 71,
      "pali": "",
      "english": "So powerful this,"
    },
    {
      "number": 72,
      "pali": "",
      "english": "the accomplishment of merit."
    },
    {
      "number": 73,
      "pali": "",
      "english": "Thus the wise, the enlightened,"
    },
    {
      "number": 74,
      "pali": "",
      "english": "praise the fund of merit"
    },
    {
      "number": 75,
      "pali": "",
      "english": "already made."
    }
  ]
}