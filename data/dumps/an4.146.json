{
  "sutta_id": "AN4.146",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.146 ",
      "english": "Numbered Discourses 4.146 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Paṭhamakālasutta ",
      "english": "Times (1st) "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, kālā. ",
      "english": "“Mendicants, there are these four times. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Kālena dhammassavanaṁ, kālena dhammasākacchā, kālena sammasanā, kālena vipassanā—",
      "english": "A time for listening to the teaching, a time for discussing the teaching, a time for serenity, and a time for discernment. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro kālā”ti. ",
      "english": "These are the four times.” "
    },
    {
      "number": 8,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}