{
  "sutta_id": "DHP284",
  "verses": [
    {
      "number": 1,
      "pali": "Yāva hi vanatho na chijjati, ",
      "english": "So long as the vine, no matter how small, "
    },
    {
      "number": 2,
      "pali": "Aṇumattopi narassa nārisu; ",
      "english": "that ties a man to women is not cut, "
    },
    {
      "number": 3,
      "pali": "Paṭibaddhamanova tāva so, ",
      "english": "his mind remains trapped, "
    },
    {
      "number": 4,
      "pali": "Vaccho khīrapakova mātari. ",
      "english": "like a calf suckling its mother. "
    }
  ]
}