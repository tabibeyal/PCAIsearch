{
  "sutta_id": "DHP232",
  "verses": [
    {
      "number": 1,
      "pali": "Vacīpakopaṁ rakkheyya, ",
      "english": "Guard against ill-tempered words, "
    },
    {
      "number": 2,
      "pali": "vācāya saṁvuto siyā; ",
      "english": "be restrained in speech. "
    },
    {
      "number": 3,
      "pali": "Vacīduccaritaṁ hitvā, ",
      "english": "Giving up bad verbal conduct, "
    },
    {
      "number": 4,
      "pali": "vācāya sucaritaṁ care. ",
      "english": "conduct yourself well in speech. "
    }
  ]
}