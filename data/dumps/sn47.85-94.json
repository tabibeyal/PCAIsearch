{
  "sutta_id": "SN47.85-94",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 47.85–94 ",
      "english": "Linked Discourses 47.85–94 "
    },
    {
      "number": 2,
      "pali": "9. Esanāvagga ",
      "english": "9. Searches "
    },
    {
      "number": 3,
      "pali": "Esanādisutta ",
      "english": "Searches, Etc. "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, esanā. ",
      "english": "“Mendicants, there are these three searches. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Kāmesanā, bhavesanā, brahmacariyesanā”ti ",
      "english": "The search for sensual pleasures, the search for continued existence, and the search for a spiritual path. …” "
    },
    {
      "number": 7,
      "pali": "vitthāretabbaṁ. ",
      "english": "(Tell in full as in SN 45.161–170.) "
    },
    {
      "number": 8,
      "pali": "Esanāvaggo navamo. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Esanā vidhā āsavo, ",
      "english": "Searches, discriminations, defilements, "
    },
    {
      "number": 11,
      "pali": "Bhavo ca dukkhatā tisso; ",
      "english": "states of existence, three kinds of suffering, "
    },
    {
      "number": 12,
      "pali": "Khilaṁ malañca nīgho ca, ",
      "english": "barrenness, stains, and troubles, "
    },
    {
      "number": 13,
      "pali": "Vedanā taṇhā tasināya cāti. ",
      "english": "feelings, craving, and thirst. "
    }
  ]
}