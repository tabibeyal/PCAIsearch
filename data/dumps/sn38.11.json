{
  "sutta_id": "SN38.11",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 38.11 ",
      "english": "Linked Discourses 38.11 "
    },
    {
      "number": 2,
      "pali": "1. Jambukhādakavagga ",
      "english": "1. With Jambukhādaka "
    },
    {
      "number": 3,
      "pali": "Oghapañhāsutta ",
      "english": "A Question About Floods "
    },
    {
      "number": 4,
      "pali": "“‘Ogho, ogho’ti, āvuso sāriputta, vuccati. ",
      "english": "“Reverend Sāriputta, they speak of this thing called ‘a flood’. "
    },
    {
      "number": 5,
      "pali": "Katamo nu kho, āvuso, ogho”ti? ",
      "english": "What is a flood?” "
    },
    {
      "number": 6,
      "pali": "“Cattārome, āvuso, oghā. ",
      "english": "“Reverend, there are these four floods. "
    },
    {
      "number": 7,
      "pali": "Kāmogho, bhavogho, diṭṭhogho, avijjogho—",
      "english": "The floods of sensuality, desire to be reborn, views, and ignorance. "
    },
    {
      "number": 8,
      "pali": "ime kho, āvuso, cattāro oghā”ti. ",
      "english": "These are the four floods.” "
    },
    {
      "number": 9,
      "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etesaṁ oghānaṁ pahānāyā”ti? ",
      "english": "“But, reverend, is there a path and a practice for completely understanding these floods?” "
    },
    {
      "number": 10,
      "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etesaṁ oghānaṁ pahānāyā”ti. ",
      "english": "“There is.” … "
    },
    {
      "number": 11,
      "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etesaṁ oghānaṁ pahānāyā”ti? ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etesaṁ oghānaṁ pahānāya, seyyathidaṁ—",
      "english": ""
    },
    {
      "number": 13,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Ayaṁ kho, āvuso, maggo ayaṁ paṭipadā, etesaṁ oghānaṁ pahānāyā”ti. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etesaṁ oghānaṁ pahānāya. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Alañca panāvuso sāriputta, appamādāyā”ti. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    }
  ]
}