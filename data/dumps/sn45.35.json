{
  "sutta_id": "SN45.35",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.35 ",
      "english": "Linked Discourses 45.35 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Paṭhamasāmaññasutta ",
      "english": "The Ascetic Life (1st) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Sāmaññañca vo, bhikkhave, desessāmi, sāmaññaphalāni ca. ",
      "english": "“Mendicants, I will teach you the ascetic life and the fruits of the ascetic life. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, sāmaññaṁ? ",
      "english": "And what is the ascetic life? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, sāmaññaṁ. ",
      "english": "This is called the ascetic life. "
    },
    {
      "number": 11,
      "pali": "Katamāni ca, bhikkhave, sāmaññaphalāni? ",
      "english": "And what are the fruits of the ascetic life? "
    },
    {
      "number": 12,
      "pali": "Sotāpattiphalaṁ, sakadāgāmiphalaṁ, anāgāmiphalaṁ, arahattaphalaṁ—",
      "english": "The fruits of stream-entry, once-return, non-return, and perfection. "
    },
    {
      "number": 13,
      "pali": "imāni vuccanti, bhikkhave, sāmaññaphalānī”ti. ",
      "english": "These are called the fruits of the ascetic life.” "
    },
    {
      "number": 14,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}