  "sutta_id": "ITI5",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 5",
      "english": "Itivuttaka 5"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Abandon one quality, monks, and I guarantee you non-return. Which one quality? Abandon contempt as the one quality, and I guarantee you non-return.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "The contempt with which"
    },
    {
      "number": 5,
      "pali": "",
      "english": "beings go to a bad destination,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "disdainful:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "from rightly knowing that contempt,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "those who see clearly"
    },
    {
      "number": 9,
      "pali": "",
      "english": "let go."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Letting go,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "they never come to this world"
    },
    {
      "number": 12,
      "pali": "",
      "english": "again."
    }
  ]
}