    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.220 ",
      "english": "Numbered Discourses 5.220 "
    },
    {
      "number": 2,
      "pali": "22. Akkosakavagga ",
      "english": "22. Abuse "
    },
    {
      "number": 3,
      "pali": "Madhurāsutta ",
      "english": "About Madhurā "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, ādīnavā madhurāyaṁ. ",
      "english": "“Mendicants, there are these five drawbacks of Madhurā. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Visamā, bahurajā, caṇḍasunakhā, vāḷayakkhā, dullabhapiṇḍā. ",
      "english": "The ground is uneven and dusty, the hounds are fierce, the native spirits are vicious, and it’s hard to get almsfood. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, pañca ādīnavā madhurāyan”ti. ",
      "english": "These are the five drawbacks of Madhurā.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Akkosakavaggo dutiyo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Akkosabhaṇḍanasīlaṁ, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "bahubhāṇī dve akhantiyo; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Apāsādikā dve vuttā, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "aggismiṁ madhurena cāti. ",
      "english": ""
    }
  ]
}