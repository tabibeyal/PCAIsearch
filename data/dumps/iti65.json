      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three kinds of good conduct. Which three? Bodily good conduct, verbal good conduct, mental good conduct. These are the three kinds of good conduct.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Having abandoned"
    },
    {
      "number": 5,
      "pali": "",
      "english": "bodily misconduct,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "acts of verbal misconduct,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "misconduct of mind,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "& whatever else is flawed,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "not having done what’s not skillful,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "having done much that is,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "at the break-up of the body,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "the discerning one reappears"
    },
    {
      "number": 13,
      "pali": "",
      "english": "in heaven."
    }
  ]
}