{
  "sutta_id": "ITI65",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 65 ",
      "english": "So It Was Said 65 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Sucaritasutta ",
      "english": "Good Conduct "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, sucaritāni. ",
      "english": "“Mendicants, there are these kinds of good conduct. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāyasucaritaṁ, vacīsucaritaṁ, manosucaritaṁ—",
      "english": "Good conduct by way of body, speech, and mind. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi sucaritānī”ti. ",
      "english": "These are the three kinds of good conduct.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Kāyaduccaritaṁ hitvā, ",
      "english": "“Having given up bad conduct "
    },
    {
      "number": 13,
      "pali": "vacīduccaritāni ca; ",
      "english": "by way of body, "
    },
    {
      "number": 14,
      "pali": "Manoduccaritaṁ hitvā, ",
      "english": "speech, and mind, "
    },
    {
      "number": 15,
      "pali": "yañcaññaṁ dosasaṁhitaṁ. ",
      "english": "and whatever else is corrupt; "
    },
    {
      "number": 16,
      "pali": "Akatvākusalaṁ kammaṁ, ",
      "english": "not having done bad deeds, "
    },
    {
      "number": 17,
      "pali": "katvāna kusalaṁ bahuṁ; ",
      "english": "and having done many good, "
    },
    {
      "number": 18,
      "pali": "Kāyassa bhedā sappañño, ",
      "english": "when their body breaks up, that wise person "
    },
    {
      "number": 19,
      "pali": "saggaṁ so upapajjatī”ti. ",
      "english": "is reborn in heaven.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}