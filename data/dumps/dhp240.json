{
  "sutta_id": "DHP240",
  "verses": [
    {
      "number": 1,
      "pali": "Tissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ayasāva malaṁ samuṭṭhitaṁ, ",
      "english": "It is the rust born on the iron "
    },
    {
      "number": 3,
      "pali": "Tatuṭṭhāya tameva khādati; ",
      "english": "that eats away the place it arose. "
    },
    {
      "number": 4,
      "pali": "Evaṁ atidhonacārinaṁ, ",
      "english": "And so it is their own deeds "
    },
    {
      "number": 5,
      "pali": "Sāni kammāni nayanti duggatiṁ. ",
      "english": "that lead the overly-ascetic to a bad place. "
    }
  ]
}