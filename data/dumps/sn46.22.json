    },
    {
      "number": 2,
      "pali": "3. Udāyivagga ",
      "english": "3. With Udāyī "
    },
    {
      "number": 3,
      "pali": "Bojjhaṅgadesanāsutta ",
      "english": "A Teaching on the Awakening Factors "
    },
    {
      "number": 4,
      "pali": "“Satta vo, bhikkhave, bojjhaṅge desessāmi; ",
      "english": "“Mendicants, I will teach you the seven awakening factors. "
    },
    {
      "number": 5,
      "pali": "taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 6,
      "pali": "Katame ca, bhikkhave, satta bojjhaṅgā? ",
      "english": "And what are the seven awakening factors? "
    },
    {
      "number": 7,
      "pali": "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—",
      "english": "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity. "
    },
    {
      "number": 8,
      "pali": "ime kho, bhikkhave, satta bojjhaṅgā”ti. ",
      "english": "These are the seven awakening factors.” "
    },
    {
      "number": 9,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}