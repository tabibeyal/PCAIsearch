{
  "sutta_id": "SN1.43",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.43 ",
      "english": "Linked Discourses 1.43 "
    },
    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Annasutta ",
      "english": "Food "
    },
    {
      "number": 4,
      "pali": "“Annamevābhinandanti, ",
      "english": "“Both gods and humans "
    },
    {
      "number": 5,
      "pali": "ubhaye devamānusā; ",
      "english": "enjoy their food. "
    },
    {
      "number": 6,
      "pali": "Atha ko nāma so yakkho, ",
      "english": "So what’s the name of the spirit "
    },
    {
      "number": 7,
      "pali": "yaṁ annaṁ nābhinandatī”ti. ",
      "english": "who doesn’t enjoy food?” "
    },
    {
      "number": 8,
      "pali": "“Ye naṁ dadanti saddhāya, ",
      "english": "“Those who give with faith "
    },
    {
      "number": 9,
      "pali": "vippasannena cetasā; ",
      "english": "and a clear and confident heart, "
    },
    {
      "number": 10,
      "pali": "Tameva annaṁ bhajati, ",
      "english": "partake of food "
    },
    {
      "number": 11,
      "pali": "asmiṁ loke paramhi ca. ",
      "english": "in this world and the next. "
    },
    {
      "number": 12,
      "pali": "Tasmā vineyya maccheraṁ, ",
      "english": "So you should dispel stinginess, "
    },
    {
      "number": 13,
      "pali": "dajjā dānaṁ malābhibhū; ",
      "english": "overcoming that stain, and give a gift. "
    },
    {
      "number": 14,
      "pali": "Puññāni paralokasmiṁ, ",
      "english": "The good deeds of sentient beings "
    },
    {
      "number": 15,
      "pali": "patiṭṭhā honti pāṇinan”ti. ",
      "english": "support them in the next world.” "
    }
  ]
}