{
  "sutta_id": "DHP72",
  "verses": [
    {
      "number": 1,
      "pali": "Saṭṭhikūṭapetavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yāvadeva anatthāya, ",
      "english": "Whatever fame a fool may get, "
    },
    {
      "number": 3,
      "pali": "ñattaṁ bālassa jāyati; ",
      "english": "it only gives rise to harm. "
    },
    {
      "number": 4,
      "pali": "Hanti bālassa sukkaṁsaṁ, ",
      "english": "Whatever good features they have it ruins, "
    },
    {
      "number": 5,
      "pali": "muddhamassa vipātayaṁ. ",
      "english": "and blows their head into bits. "
    }
  ]
}