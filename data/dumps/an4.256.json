{
  "sutta_id": "AN4.256",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.256 ",
      "english": "Numbered Discourses 4.256 "
    },
    {
      "number": 2,
      "pali": "26. Abhiññāvagga ",
      "english": "26. Insight "
    },
    {
      "number": 3,
      "pali": "Saṅgahavatthusutta ",
      "english": "Ways of Being Inclusive "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, saṅgahavatthūni. ",
      "english": "“Mendicants, there are these four ways of being inclusive. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Dānaṁ, peyyavajjaṁ, atthacariyā, samānattatā—",
      "english": "Giving, kindly words, taking care, and equality. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri saṅgahavatthūnī”ti. ",
      "english": "These are the four ways of being inclusive.” "
    },
    {
      "number": 8,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}