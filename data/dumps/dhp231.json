{
  "sutta_id": "DHP231",
  "verses": [
    {
      "number": 1,
      "pali": "Chabbaggiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kāyappakopaṁ rakkheyya, ",
      "english": "Guard against ill-tempered deeds, "
    },
    {
      "number": 3,
      "pali": "kāyena saṁvuto siyā; ",
      "english": "be restrained in body. "
    },
    {
      "number": 4,
      "pali": "Kāyaduccaritaṁ hitvā, ",
      "english": "Giving up bad bodily conduct, "
    },
    {
      "number": 5,
      "pali": "kāyena sucaritaṁ care. ",
      "english": "conduct yourself well in body. "
    }
  ]
}