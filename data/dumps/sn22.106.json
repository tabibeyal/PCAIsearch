{
  "sutta_id": "SN22.106",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.106 ",
      "english": "Linked Discourses 22.106 "
    },
    {
      "number": 2,
      "pali": "11. Antavagga ",
      "english": "11. Ends "
    },
    {
      "number": 3,
      "pali": "Pariññeyyasutta ",
      "english": "Should Be Completely Understood "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Pariññeyye ca, bhikkhave, dhamme desessāmi pariññañca pariññātāviñca puggalaṁ. ",
      "english": "“Mendicants, I will teach you the things that should be completely understood, complete understanding, and the individual who has completely understood. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katame ca, bhikkhave, pariññeyyā dhammā? ",
      "english": "And what things should be completely understood? "
    },
    {
      "number": 8,
      "pali": "Rūpaṁ, bhikkhave, pariññeyyo dhammo. ",
      "english": "Form, "
    },
    {
      "number": 9,
      "pali": "Vedanā …pe… ",
      "english": "feeling, "
    },
    {
      "number": 10,
      "pali": "saññā … ",
      "english": "perception, "
    },
    {
      "number": 11,
      "pali": "saṅkhārā … ",
      "english": "choices, "
    },
    {
      "number": 12,
      "pali": "viññāṇaṁ pariññeyyo dhammo. ",
      "english": "and consciousness. "
    },
    {
      "number": 13,
      "pali": "Ime vuccanti, bhikkhave, pariññeyyā dhammā. ",
      "english": "These are called the things that should be completely understood. "
    },
    {
      "number": 14,
      "pali": "Katamā ca, bhikkhave, pariññā? ",
      "english": "And what is complete understanding? "
    },
    {
      "number": 15,
      "pali": "Rāgakkhayo, dosakkhayo, mohakkhayo—",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 16,
      "pali": "ayaṁ vuccati, bhikkhave, pariññā. ",
      "english": "This is called complete understanding. "
    },
    {
      "number": 17,
      "pali": "Katamo ca, bhikkhave, pariññātāvī puggalo? ",
      "english": "And who is the individual who has completely understood? "
    },
    {
      "number": 18,
      "pali": "Arahātissa vacanīyaṁ. ",
      "english": "It should be said: a perfected one, "
    },
    {
      "number": 19,
      "pali": "Yvāyaṁ āyasmā evaṁnāmo evaṅgotto—",
      "english": "the venerable of such and such name and clan. "
    },
    {
      "number": 20,
      "pali": "ayaṁ vuccati, bhikkhave, pariññātāvī puggalo”ti. ",
      "english": "This is called the individual who has completely understood.” "
    },
    {
      "number": 21,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}