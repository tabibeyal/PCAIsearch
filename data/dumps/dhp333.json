{
  "sutta_id": "DHP333",
  "verses": [
    {
      "number": 1,
      "pali": "Sukhaṁ yāva jarā sīlaṁ, ",
      "english": "It’s a blessing to keep precepts until you grow old; "
    },
    {
      "number": 2,
      "pali": "sukhā saddhā patiṭṭhitā; ",
      "english": "a blessing to be grounded in faith; "
    },
    {
      "number": 3,
      "pali": "Sukho paññāya paṭilābho, ",
      "english": "the getting of wisdom’s a blessing; "
    },
    {
      "number": 4,
      "pali": "pāpānaṁ akaraṇaṁ sukhaṁ. ",
      "english": "and it’s a blessing to avoid doing wrong. "
    },
    {
      "number": 5,
      "pali": "Nāgavaggo tevīsatimo. ",
      "english": ""
    }
  ]
}