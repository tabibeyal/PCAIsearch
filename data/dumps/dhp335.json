{
  "sutta_id": "DHP335",
  "verses": [
    {
      "number": 1,
      "pali": "Yaṁ esā sahate jammī, ",
      "english": "Whoever is beaten by this wretched craving, "
    },
    {
      "number": 2,
      "pali": "taṇhā loke visattikā; ",
      "english": "this attachment to the world, "
    },
    {
      "number": 3,
      "pali": "Sokā tassa pavaḍḍhanti, ",
      "english": "their sorrow grows, "
    },
    {
      "number": 4,
      "pali": "abhivaṭṭhaṁva bīraṇaṁ. ",
      "english": "like grass in the rain. "
    }
  ]
}