{
  "sutta_id": "DHP337",
  "verses": [
    {
      "number": 1,
      "pali": "Taṁ vo vadāmi bhaddaṁ vo, ",
      "english": "I say this to you, good people, "
    },
    {
      "number": 2,
      "pali": "yāvantettha samāgatā; ",
      "english": "all those who have gathered here: "
    },
    {
      "number": 3,
      "pali": "Taṇhāya mūlaṁ khaṇatha, ",
      "english": "dig up the root of craving, "
    },
    {
      "number": 4,
      "pali": "usīratthova bīraṇaṁ; ",
      "english": "as you’d dig up grass in search of roots. "
    },
    {
      "number": 5,
      "pali": "Mā vo naḷaṁva sotova, ",
      "english": "Don’t let Māra break you again and again, "
    },
    {
      "number": 6,
      "pali": "māro bhañji punappunaṁ. ",
      "english": "like a stream breaking a reed. "
    }
  ]
}