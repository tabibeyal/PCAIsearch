{
  "sutta_id": "DHP111",
  "verses": [
    {
      "number": 1,
      "pali": "Khāṇukoṇḍaññattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "duppañño asamāhito; ",
      "english": "wise and absorbed in meditation "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "paññavantassa jhāyino. ",
      "english": "witless and lacking immersion. "
    }
  ]
}