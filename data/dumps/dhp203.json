{
  "sutta_id": "DHP203",
  "verses": [
    {
      "number": 1,
      "pali": "Ekaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Jighacchāparamā rogā, ",
      "english": "Hunger is the worst illness, "
    },
    {
      "number": 3,
      "pali": "saṅkhāraparamā dukhā; ",
      "english": "conditions are the worst suffering. "
    },
    {
      "number": 4,
      "pali": "Etaṁ ñatvā yathābhūtaṁ, ",
      "english": "For one who truly knows this, "
    },
    {
      "number": 5,
      "pali": "nibbānaṁ paramaṁ sukhaṁ. ",
      "english": "extinguishment is the ultimate happiness. "
    }
  ]
}