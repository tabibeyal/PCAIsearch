    {
      "number": 3,
      "pali": "Cittavagga ",
      "english": "3. The Mind "
    },
    {
      "number": 4,
      "pali": "Meghiyattheravatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Phandanaṁ capalaṁ cittaṁ, ",
      "english": "The mind quivers and shakes, "
    },
    {
      "number": 6,
      "pali": "dūrakkhaṁ dunnivārayaṁ; ",
      "english": "hard to guard, hard to curb. "
    },
    {
      "number": 7,
      "pali": "Ujuṁ karoti medhāvī, ",
      "english": "The discerning straighten it out, "
    },
    {
      "number": 8,
      "pali": "usukārova tejanaṁ. ",
      "english": "like a fletcher straightens an arrow. "
    }
  ]
