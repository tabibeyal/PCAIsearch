{
  "sutta_id": "DHP164",
  "verses": [
    {
      "number": 1,
      "pali": "Kālattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo sāsanaṁ arahataṁ, ",
      "english": "On account of wicked views—"
    },
    {
      "number": 3,
      "pali": "ariyānaṁ dhammajīvinaṁ; ",
      "english": "scorning the guidance "
    },
    {
      "number": 4,
      "pali": "Paṭikkosati dummedho, ",
      "english": "of the perfected ones, "
    },
    {
      "number": 5,
      "pali": "diṭṭhiṁ nissāya pāpikaṁ; ",
      "english": "the noble ones living righteously—"
    },
    {
      "number": 6,
      "pali": "Phalāni kaṭṭhakasseva, ",
      "english": "the idiot begets their own self’s demise, "
    },
    {
      "number": 7,
      "pali": "attaghātāya phallati. ",
      "english": "like the bamboo bearing fruit. "
    }
  ]
}