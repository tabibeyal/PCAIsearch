{
  "sutta_id": "DHP134",
  "verses": [
    {
      "number": 1,
      "pali": "Sace neresi attānaṁ, ",
      "english": "If you still yourself "
    },
    {
      "number": 2,
      "pali": "kaṁso upahato yathā; ",
      "english": "like a broken gong, "
    },
    {
      "number": 3,
      "pali": "Esa pattosi nibbānaṁ, ",
      "english": "you reach extinguishment "
    },
    {
      "number": 4,
      "pali": "sārambho te na vijjati. ",
      "english": "and know no conflict. "
    }
  ]
}