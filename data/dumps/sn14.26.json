      "english": "Linked Discourses 14.26 "
    },
    {
      "number": 2,
      "pali": "3. Kammapathavagga ",
      "english": "3. Ways of Performing Deeds "
    },
    {
      "number": 3,
      "pali": "Sattakammapathasutta ",
      "english": "Seven Ways of Performing Deeds "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Pāṇātipātino pāṇātipātīhi saddhiṁ saṁsandanti samenti; ",
      "english": "those who kill living creatures with those who kill living creatures, "
    },
    {
      "number": 7,
      "pali": "adinnādāyino adinnādāyīhi saddhiṁ saṁsandanti samenti; ",
      "english": "those who steal … "
    },
    {
      "number": 8,
      "pali": "kāmesumicchācārino kāmesumicchācārīhi saddhiṁ saṁsandanti samenti; ",
      "english": "commit sexual misconduct … "
    },
    {
      "number": 9,
      "pali": "musāvādino musāvādīhi saddhiṁ saṁsandanti samenti; ",
      "english": "lie … "
    },
    {
      "number": 10,
      "pali": "pisuṇavācā pisuṇavācehi saddhiṁ saṁsandanti samenti; ",
      "english": "backbite … "
    },
    {
      "number": 11,
      "pali": "pharusavācā pharusavācehi saddhiṁ saṁsandanti samenti; ",
      "english": "speak harshly … "
    },
    {
      "number": 12,
      "pali": "samphappalāpino samphappalāpīhi saddhiṁ saṁsandanti samenti. ",
      "english": "talk nonsense … "
    },
    {
      "number": 13,
      "pali": "Pāṇātipātā paṭiviratā …pe… ",
      "english": "Those who refrain from killing living creatures. … "
    },
    {
      "number": 14,
      "pali": "adinnādānā paṭiviratā … ",
      "english": "who refrain from stealing … "
    },
    {
      "number": 15,
      "pali": "kāmesumicchācārā paṭiviratā … ",
      "english": "who refrain from sexual misconduct … "
    },
    {
      "number": 16,
      "pali": "musāvādā paṭiviratā … ",
      "english": "who refrain from lying … "
    },
    {
      "number": 17,
      "pali": "pisuṇāya vācāya paṭiviratā pisuṇāya vācāya paṭiviratehi saddhiṁ saṁsandanti samenti; ",
      "english": "who refrain from backbiting … "
    },
    {
      "number": 18,
      "pali": "pharusāya vācāya paṭiviratā pharusāya vācāya paṭiviratehi saddhiṁ saṁsandanti samenti; ",
      "english": "who refrain from harsh speech … "
    },
    {
      "number": 19,
      "pali": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṁ saṁsandanti samentī”ti. ",
      "english": "who refrain from talking nonsense with those who refrain from talking nonsense.” "
    },
    {
      "number": 20,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
