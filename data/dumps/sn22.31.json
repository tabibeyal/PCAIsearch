{
  "sutta_id": "SN22.31",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.31 ",
      "english": "Linked Discourses 22.31 "
    },
    {
      "number": 2,
      "pali": "3. Bhāravagga ",
      "english": "3. The Burden "
    },
    {
      "number": 3,
      "pali": "Aghamūlasutta ",
      "english": "The Root of Gloom "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Aghañca, bhikkhave, desessāmi aghamūlañca. ",
      "english": "“Mendicants, I will teach you gloom and the root of gloom. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, aghaṁ? ",
      "english": "And what is gloom? "
    },
    {
      "number": 8,
      "pali": "Rūpaṁ, bhikkhave, aghaṁ, vedanā aghaṁ, saññā aghaṁ, saṅkhārā aghaṁ, viññāṇaṁ aghaṁ. ",
      "english": "Form, feeling, perception, choices, and consciousness are gloom. "
    },
    {
      "number": 9,
      "pali": "Idaṁ vuccati, bhikkhave, aghaṁ. ",
      "english": "This is called gloom. "
    },
    {
      "number": 10,
      "pali": "Katamañca, bhikkhave, aghamūlaṁ? ",
      "english": "And what is the root of gloom? "
    },
    {
      "number": 11,
      "pali": "Yāyaṁ taṇhā ponobhavikā nandīrāgasahagatā tatratatrābhinandinī; ",
      "english": "It’s the craving that leads to future lives, mixed up with relishing and greed, taking pleasure there wherever it alights. That is, "
    },
    {
      "number": 12,
      "pali": "Seyyathidaṁ—kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
      "english": "craving for sensual pleasures, craving for existence, and craving for nonexistence. "
    },
    {
      "number": 13,
      "pali": "Idaṁ vuccati, bhikkhave, aghamūlan”ti. ",
      "english": "This is called the root of gloom.” "
    },
    {
      "number": 14,
      "pali": "Dasamaṁ. ",
      "english": ""
    }
  ]
}