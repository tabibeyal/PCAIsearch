{
  "sutta_id": "DHP15",
  "verses": [
    {
      "number": 1,
      "pali": "Cundasūkarikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idha socati pecca socati, ",
      "english": "Here they grieve, hereafter they grieve, "
    },
    {
      "number": 3,
      "pali": "Pāpakārī ubhayattha socati; ",
      "english": "an evildoer grieves in both places. "
    },
    {
      "number": 4,
      "pali": "So socati so vihaññati, ",
      "english": "They grieve and fret, "
    },
    {
      "number": 5,
      "pali": "Disvā kammakiliṭṭhamattano. ",
      "english": "seeing their own corrupt deeds. "
    }
  ]
}