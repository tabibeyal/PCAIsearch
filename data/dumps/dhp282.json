{
  "sutta_id": "DHP282",
  "verses": [
    {
      "number": 1,
      "pali": "Poṭṭhilattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yogā ve jāyatī bhūri, ",
      "english": "From meditation springs wisdom, "
    },
    {
      "number": 3,
      "pali": "ayogā bhūrisaṅkhayo; ",
      "english": "without meditation, wisdom ends. "
    },
    {
      "number": 4,
      "pali": "Etaṁ dvedhāpathaṁ ñatvā, ",
      "english": "Knowing these two paths—"
    },
    {
      "number": 5,
      "pali": "bhavāya vibhavāya ca; ",
      "english": "of progress and decline—"
    },
    {
      "number": 6,
      "pali": "Tathāttānaṁ niveseyya, ",
      "english": "you should conduct yourself "
    },
    {
      "number": 7,
      "pali": "yathā bhūri pavaḍḍhati. ",
      "english": "so that wisdom grows. "
    }
  ]
}