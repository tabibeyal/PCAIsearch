{
  "sutta_id": "SN2.22",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 2.22",
      "english": "Linked Discourses 2.22"
    },
    {
      "number": 2,
      "pali": "Khema Sutta",
      "english": "Khema the Deva’s Son"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Standing to one side, Khema the deva’s son recited these verses in the Blessed One’s presence."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Foolish people, lacking wisdom,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "behave like enemies to themselves."
    },
    {
      "number": 6,
      "pali": "",
      "english": "They do evil deeds"
    },
    {
      "number": 7,
      "pali": "",
      "english": "that bear bitter fruit."
    },
    {
      "number": 8,
      "pali": "",
      "english": "It’s not good,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "the doing of the deed"
    },
    {
      "number": 10,
      "pali": "",
      "english": "that, once it’s done,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "you regret,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "whose result you reap crying,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "your face in tears."
    },
    {
      "number": 14,
      "pali": "",
      "english": "It’s good,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "the doing of the deed"
    },
    {
      "number": 16,
      "pali": "",
      "english": "that, once it’s done,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "you don’t regret,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "whose result you reap gratified,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "happy at heart."
    },
    {
      "number": 20,
      "pali": "",
      "english": "You should do prudently, right away,"
    },
    {
      "number": 21,
      "pali": "",
      "english": "what you know is for your own benefit."
    },
    {
      "number": 22,
      "pali": "",
      "english": "A thinker, enlightened, you shouldn’t strive"
    },
    {
      "number": 23,
      "pali": "",
      "english": "for the sake of the cart driver’s thinking."
    },
    {
      "number": 24,
      "pali": "",
      "english": "Just as a cart driver who—having left"
    },
    {
      "number": 25,
      "pali": "",
      "english": "the smoothed, even highway,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "and climbed onto an uneven path—"
    },
    {
      "number": 27,
      "pali": "",
      "english": "his axle broken, broods;"
    },
    {
      "number": 28,
      "pali": "",
      "english": "in the same way,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "a fool—having departed from Dhamma"
    },
    {
      "number": 30,
      "pali": "",
      "english": "to follow non-Dhamma,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "having fallen into the mouth of death—"
    },
    {
      "number": 32,
      "pali": "",
      "english": "his axle broken, broods.”"
    }
  ]
}