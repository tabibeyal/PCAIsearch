{
  "sutta_id": "SN2.22",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.22 ",
      "english": "Linked Discourses 2.22 "
    },
    {
      "number": 2,
      "pali": "3. Nānātitthiyavagga ",
      "english": "3. Various Sectarians "
    },
    {
      "number": 3,
      "pali": "Khemasutta ",
      "english": "With Khema "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho khemo devaputto bhagavato santike imā gāthāyo abhāsi: ",
      "english": "Standing to one side, the godling Khema recited these verses in the Buddha’s presence: "
    },
    {
      "number": 5,
      "pali": "“Caranti bālā dummedhā, ",
      "english": "“Fools and simpletons behave "
    },
    {
      "number": 6,
      "pali": "amitteneva attanā; ",
      "english": "like their own worst enemies, "
    },
    {
      "number": 7,
      "pali": "Karontā pāpakaṁ kammaṁ, ",
      "english": "doing wicked deeds "
    },
    {
      "number": 8,
      "pali": "yaṁ hoti kaṭukapphalaṁ. ",
      "english": "that ripen as bitter fruit. "
    },
    {
      "number": 9,
      "pali": "Na taṁ kammaṁ kataṁ sādhu, ",
      "english": "It’s not good to do a deed "
    },
    {
      "number": 10,
      "pali": "yaṁ katvā anutappati; ",
      "english": "that plagues you later on, "
    },
    {
      "number": 11,
      "pali": "Yassa assumukho rodaṁ, ",
      "english": "for which you weep and wail, "
    },
    {
      "number": 12,
      "pali": "vipākaṁ paṭisevati. ",
      "english": "as its effect stays with you. "
    },
    {
      "number": 13,
      "pali": "Tañca kammaṁ kataṁ sādhu, ",
      "english": "It is good to do a deed "
    },
    {
      "number": 14,
      "pali": "yaṁ katvā nānutappati; ",
      "english": "that doesn’t plague you later on, "
    },
    {
      "number": 15,
      "pali": "Yassa patīto sumano, ",
      "english": "that gladdens and cheers, "
    },
    {
      "number": 16,
      "pali": "vipākaṁ paṭisevati. ",
      "english": "as its effect stays with you.” "
    },
    {
      "number": 17,
      "pali": "Paṭikacceva taṁ kayirā, ",
      "english": "“As a precaution, you should do "
    },
    {
      "number": 18,
      "pali": "yaṁ jaññā hitamattano; ",
      "english": "what you know is for your own welfare. "
    },
    {
      "number": 19,
      "pali": "Na sākaṭikacintāya, ",
      "english": "A thinker, a wise one would not proceed "
    },
    {
      "number": 20,
      "pali": "mantā dhīro parakkame. ",
      "english": "thinking like the cart driver. "
    },
    {
      "number": 21,
      "pali": "Yathā sākaṭiko maṭṭhaṁ, ",
      "english": "Suppose a cart driver leaves the highway, "
    },
    {
      "number": 22,
      "pali": "samaṁ hitvā mahāpathaṁ; ",
      "english": "so even and well compacted. "
    },
    {
      "number": 23,
      "pali": "Visamaṁ maggamāruyha, ",
      "english": "They enter upon a rough road, "
    },
    {
      "number": 24,
      "pali": "akkhacchinnova jhāyati. ",
      "english": "and fret as soon as their axle is broken. "
    },
    {
      "number": 25,
      "pali": "Evaṁ dhammā apakkamma, ",
      "english": "So too, a dullard leaves the good "
    },
    {
      "number": 26,
      "pali": "adhammamanuvattiya; ",
      "english": "to follow what’s against the good. "
    },
    {
      "number": 27,
      "pali": "Mando maccumukhaṁ patto, ",
      "english": "Fallen in the jaws of death, "
    },
    {
      "number": 28,
      "pali": "akkhacchinnova jhāyatī”ti. ",
      "english": "they fret like one whose axle is broken.” "
    }
  ]
}