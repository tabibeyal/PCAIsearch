  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.184 ",
      "english": "Numbered Discourses 10.184 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Vajjasutta ",
      "english": "Blameworthy "
    },
    {
      "number": 4,
      "pali": "“Sāvajjañca vo, bhikkhave, dhammaṁ desessāmi anavajjañca. ",
      "english": "“I will teach you the blameworthy principle and the blameless. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, sāvajjo dhammo? ",
      "english": "And what is the blameworthy principle? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, sāvajjo dhammo. ",
      "english": "This is called the blameworthy principle. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, anavajjo dhammo? ",
      "english": "And what is the blameless principle? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, anavajjo dhammo”ti. ",
      "english": "This is called the blameless principle.” "
    },
    {
      "number": 14,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}