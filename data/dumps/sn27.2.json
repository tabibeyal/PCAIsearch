    },
    {
      "number": 5,
      "pali": "“Yo, bhikkhave, rūpesu chandarāgo, cittasseso upakkileso. ",
      "english": "“Mendicants, desire and greed for sights, "
    },
    {
      "number": 6,
      "pali": "Yo saddesu … ",
      "english": "sounds, "
    },
    {
      "number": 7,
