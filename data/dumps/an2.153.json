{
  "sutta_id": "AN2.153",
  "verses": [
    {
      "number": 1,
      "pali": "153 ",
      "english": "153 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, esanā. ",
      "english": "“There are these two quests. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisesanā ca dhammesanā ca. ",
      "english": "The quest for things of the flesh and the quest for the teaching. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve esanā. ",
      "english": "These are the two quests. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imāsaṁ dvinnaṁ esanānaṁ yadidaṁ dhammesanā”ti. ",
      "english": "The better of these two quests is the quest for the teaching.” "
    }
  ]
}