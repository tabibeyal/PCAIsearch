{
  "sutta_id": "DHP261",
  "verses": [
    {
      "number": 1,
      "pali": "Yamhi saccañca dhammo ca, ",
      "english": "One who is truthful and principled, "
    },
    {
      "number": 2,
      "pali": "ahiṁsā saṁyamo damo; ",
      "english": "harmless, restrained, and self-controlled, "
    },
    {
      "number": 3,
      "pali": "Sa ve vantamalo dhīro, ",
      "english": "attentive, purged of stains, "
    },
    {
      "number": 4,
      "pali": "“thero” iti pavuccati. ",
      "english": "is said to be a senior. "
    }
  ]
}