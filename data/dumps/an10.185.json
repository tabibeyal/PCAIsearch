      "number": 1,
      "pali": "Aṅguttara Nikāya 10.185 ",
      "english": "Numbered Discourses 10.185 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Tapanīyasutta ",
      "english": "Mortifying "
    },
    {
      "number": 4,
      "pali": "“Tapanīyañca vo, bhikkhave, dhammaṁ desessāmi atapanīyañca. ",
      "english": "“I will teach you the mortifying principle and the unmortifying. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, tapanīyo dhammo? ",
      "english": "And what is the mortifying principle? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, tapanīyo dhammo. ",
      "english": "This is called the mortifying principle. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, atapanīyo dhammo? ",
      "english": "And what is the unmortifying principle? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, atapanīyo dhammo”ti. ",
      "english": "This is called the unmortifying principle.” "
    },
    {
      "number": 14,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}