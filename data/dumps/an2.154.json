{
  "sutta_id": "AN2.154",
  "verses": [
    {
      "number": 1,
      "pali": "154 ",
      "english": "154 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, pariyesanā. ",
      "english": "“There are these two searches. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisapariyesanā ca dhammapariyesanā ca. ",
      "english": "The search for things of the flesh and the search for the teaching. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve pariyesanā. ",
      "english": "These are the two searches. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imāsaṁ dvinnaṁ pariyesanānaṁ yadidaṁ dhammapariyesanā”ti. ",
      "english": "The better of these two searches is the search for the teaching.” "
    }
  ]
}