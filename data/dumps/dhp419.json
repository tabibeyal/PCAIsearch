{
  "sutta_id": "DHP419",
  "verses": [
    {
      "number": 1,
      "pali": "Vaṅgīsattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Cutiṁ yo vedi sattānaṁ, ",
      "english": "They know the passing away "
    },
    {
      "number": 3,
      "pali": "upapattiñca sabbaso; ",
      "english": "and rebirth of all beings; "
    },
    {
      "number": 4,
      "pali": "Asattaṁ sugataṁ buddhaṁ, ",
      "english": "unattached, holy, awakened: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}