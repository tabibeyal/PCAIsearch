{
  "sutta_id": "DHP201",
  "verses": [
    {
      "number": 1,
      "pali": "Kosalaraññoparājayavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Jayaṁ veraṁ pasavati, ",
      "english": "Victory breeds enmity; "
    },
    {
      "number": 3,
      "pali": "dukkhaṁ seti parājito; ",
      "english": "the defeated sleep badly. "
    },
    {
      "number": 4,
      "pali": "Upasanto sukhaṁ seti, ",
      "english": "The peaceful sleep at ease, "
    },
    {
      "number": 5,
      "pali": "hitvā jayaparājayaṁ. ",
      "english": "having left victory and defeat behind. "
    }
  ]
}