    {
      "number": 2,
      "pali": "4. Catutthavagga ",
      "english": "4. Chapter Four "
    },
    {
      "number": 3,
      "pali": "Dutiyasamaṇabrāhmaṇasutta ",
      "english": "Ascetics and Brahmins (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Catasso imā, bhikkhave, dhātuyo. ",
      "english": "“Mendicants, there are these four elements. "
    },
    {
      "number": 6,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 7,
      "pali": "Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu. ",
      "english": "The elements of earth, water, fire, and air. "
    },
    {
      "number": 8,
      "pali": "Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imāsaṁ catunnaṁ dhātūnaṁ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṁ nappajānanti …pe… ",
      "english": "There are ascetics and brahmins who don’t truly understand these four elements’ origin, disappearance, gratification, drawback, and escape … "
    },
    {
      "number": 9,
      "pali": "(vitthāretabbaṁ) ",
      "english": "(Tell all in full.) "
    },
    {
      "number": 10,
      "pali": "pajānanti …pe… ",
      "english": "There are ascetics and brahmins who do truly understand these four elements’ origin, disappearance, gratification, drawback, and escape …” "
    },
    {
      "number": 11,
      "pali": "sayaṁ abhiññā sacchikatvā upasampajja viharantī”ti. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
