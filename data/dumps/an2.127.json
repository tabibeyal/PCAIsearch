{
  "sutta_id": "AN2.127",
  "verses": [
    {
      "number": 1,
      "pali": "127 ",
      "english": "127 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, āpattiyo. ",
      "english": "“There are these two offenses. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Lahukā ca āpatti, garukā ca āpatti. ",
      "english": "A light offense and a serious offense. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve āpattiyo”ti. ",
      "english": "These are the two offenses.” "
    }
  ]
}