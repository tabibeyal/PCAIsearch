{
  "sutta_id": "DHP366",
  "verses": [
    {
      "number": 1,
      "pali": "Appalābhopi ce bhikkhu, ",
      "english": "If a mendicant is poor in offerings, "
    },
    {
      "number": 2,
      "pali": "salābhaṁ nātimaññati; ",
      "english": "the well-to-do ought not look down on them. "
    },
    {
      "number": 3,
      "pali": "Taṁ ve devā pasaṁsanti, ",
      "english": "For the gods indeed praise them, "
    },
    {
      "number": 4,
      "pali": "suddhājīviṁ atanditaṁ. ",
      "english": "who are tireless and pure of livelihood. "
    }
  ]
}