{
  "sutta_id": "DHP57",
  "verses": [
    {
      "number": 1,
      "pali": "Godhikattheraparinibbānavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Tesaṁ sampannasīlānaṁ, ",
      "english": "For those accomplished in ethics, "
    },
    {
      "number": 3,
      "pali": "appamādavihārinaṁ; ",
      "english": "meditating diligently, "
    },
    {
      "number": 4,
      "pali": "Sammadaññāvimuttānaṁ, ",
      "english": "freed through the highest knowledge, "
    },
    {
      "number": 5,
      "pali": "māro maggaṁ na vindati. ",
      "english": "Māra cannot find their path. "
    }
  ]
}