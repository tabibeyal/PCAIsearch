{
  "sutta_id": "DHP386",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Jhāyiṁ virajamāsīnaṁ, ",
      "english": "Absorbed, rid of hopes, "
    },
    {
      "number": 3,
      "pali": "katakiccamanāsavaṁ; ",
      "english": "their task completed, without defilements, "
    },
    {
      "number": 4,
      "pali": "Uttamatthamanuppattaṁ, ",
      "english": "arrived at the highest goal: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}