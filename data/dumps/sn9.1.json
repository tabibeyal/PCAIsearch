{
  "sutta_id": "SN9.1",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 9.1",
      "english": "Linked Discourses 9.1"
    },
    {
      "number": 2,
      "pali": "Viveka Sutta",
      "english": "Seclusion"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that on one occasion a certain monk was staying among the Kosalans in a forest grove. Now at that time, as he had gone to spend the day (in the grove), he was thinking unskillful thoughts, connected with the household life."
    },
    {
      "number": 4,
      "pali": "",
      "english": "Then the devatā inhabiting the forest grove, feeling sympathy for the monk, desiring his benefit, desiring to bring him to his senses, approached him and addressed him with this verse:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“Desiring seclusion"
    },
    {
      "number": 6,
      "pali": "",
      "english": "you’ve entered the forest,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "and yet your mind"
    },
    {
      "number": 8,
      "pali": "",
      "english": "goes running outside."
    },
    {
      "number": 9,
      "pali": "",
      "english": "You, a person:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "subdue your desire for people."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Then you’ll be happy, free"
    },
    {
      "number": 12,
      "pali": "",
      "english": "from passion."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Dispel discontent,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "be mindful."
    },
    {
      "number": 15,
      "pali": "",
      "english": "Let me remind you"
    },
    {
      "number": 16,
      "pali": "",
      "english": "of that which is good—"
    },
    {
      "number": 17,
      "pali": "",
      "english": "for the dust"
    },
    {
      "number": 18,
      "pali": "",
      "english": "of the regions below"
    },
    {
      "number": 19,
      "pali": "",
      "english": "is hard to transcend."
    },
    {
      "number": 20,
      "pali": "",
      "english": "Don’t let the dust"
    },
    {
      "number": 21,
      "pali": "",
      "english": "of the sensual"
    },
    {
      "number": 22,
      "pali": "",
      "english": "pull"
    },
    {
      "number": 23,
      "pali": "",
      "english": "you"
    },
    {
      "number": 24,
      "pali": "",
      "english": "down."
    },
    {
      "number": 25,
      "pali": "",
      "english": "As a bird"
    },
    {
      "number": 26,
      "pali": "",
      "english": "spattered with dirt"
    },
    {
      "number": 27,
      "pali": "",
      "english": "sheds the adhering dust with a shake,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "so a monk"
    },
    {
      "number": 29,
      "pali": "",
      "english": "—energetic & mindful—"
    },
    {
      "number": 30,
      "pali": "",
      "english": "sheds the adhering dust.”"
    },
    {
      "number": 31,
      "pali": "",
      "english": "The monk, chastened by the devatā, came to his senses."
    }
  ]
}