{
  "sutta_id": "DHP283",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcamahallakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Vanaṁ chindatha mā rukkhaṁ, ",
      "english": "Cut down the jungle, not just a tree; "
    },
    {
      "number": 3,
      "pali": "vanato jāyate bhayaṁ; ",
      "english": "from the jungle springs fear. "
    },
    {
      "number": 4,
      "pali": "Chetvā vanañca vanathañca, ",
      "english": "Having cut down jungle and snarl, "
    },
    {
      "number": 5,
      "pali": "nibbanā hotha bhikkhavo. ",
      "english": "be free of jungles, mendicants! "
    }
  ]
}