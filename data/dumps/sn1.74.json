{
  "sutta_id": "SN1.74",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.74 ",
      "english": "Linked Discourses 1.74 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Vuṭṭhisutta ",
      "english": "Rain "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu uppatataṁ seṭṭhaṁ, ",
      "english": "“What’s the best of things that rise? "
    },
    {
      "number": 5,
      "pali": "kiṁsu nipatataṁ varaṁ; ",
      "english": "And what’s the finest thing to fall? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu pavajamānānaṁ, ",
      "english": "And what of the things that go forth? "
    },
    {
      "number": 7,
      "pali": "kiṁsu pavadataṁ varan”ti. ",
      "english": "And who’s the finest speaker?” "
    },
    {
      "number": 8,
      "pali": "“Bījaṁ uppatataṁ seṭṭhaṁ, ",
      "english": "“A seed’s the best of things that rise. "
    },
    {
      "number": 9,
      "pali": "vuṭṭhi nipatataṁ varā; ",
      "english": "Rain’s the finest thing to fall. "
    },
    {
      "number": 10,
      "pali": "Gāvo pavajamānānaṁ, ",
      "english": "Cattle, of things that go forth. "
    },
    {
      "number": 11,
      "pali": "putto pavadataṁ varo”ti. ",
      "english": "And a child is the finest speaker.” "
    },
    {
      "number": 12,
      "pali": "“Vijjā uppatataṁ seṭṭhā, ",
      "english": "“Knowledge is best of things that rise. "
    },
    {
      "number": 13,
      "pali": "avijjā nipatataṁ varā; ",
      "english": "Ignorance the finest thing to fall. "
    },
    {
      "number": 14,
      "pali": "Saṅgho pavajamānānaṁ, ",
      "english": "The Saṅgha, of things that go forth. "
    },
    {
      "number": 15,
      "pali": "buddho pavadataṁ varo”ti. ",
      "english": "And the Buddha is the finest speaker.” "
    }
  ]
}