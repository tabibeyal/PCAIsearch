    {
      "number": 3,
      "pali": "Pupphavagga ",
      "english": "4. Flowers "
    },
    {
      "number": 4,
      "pali": "Pathavikathāpasutapañcasatabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Ko imaṁ pathaviṁ vicessati, ",
      "english": "Who bestirs this earth, "
    },
    {
      "number": 6,
      "pali": "Yamalokañca imaṁ sadevakaṁ; ",
      "english": "and the Yama realm with its gods? "
    },
    {
      "number": 7,
      "pali": "Ko dhammapadaṁ sudesitaṁ, ",
      "english": "Who sets out the well-taught word of truth, "
    },
    {
      "number": 8,
      "pali": "Kusalo pupphamiva pacessati. ",
      "english": "as an expert a flower? "
    }
  ]
