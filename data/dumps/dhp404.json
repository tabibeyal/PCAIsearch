{
  "sutta_id": "DHP404",
  "verses": [
    {
      "number": 1,
      "pali": "Pabbhāravāsitissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Asaṁsaṭṭhaṁ gahaṭṭhehi, ",
      "english": "Mixing with neither "
    },
    {
      "number": 3,
      "pali": "anāgārehi cūbhayaṁ; ",
      "english": "householders nor the homeless; "
    },
    {
      "number": 4,
      "pali": "Anokasārimappicchaṁ, ",
      "english": "a migrant with no bastion, few in wishes: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}