{
  "sutta_id": "DHP58",
  "verses": [
    {
      "number": 1,
      "pali": "Garahadinnavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathā saṅkāradhānasmiṁ, ",
      "english": "From a heap of trash "
    },
    {
      "number": 3,
      "pali": "ujjhitasmiṁ mahāpathe; ",
      "english": "discarded on the highway, "
    },
    {
      "number": 4,
      "pali": "Padumaṁ tattha jāyetha, ",
      "english": "a lotus might blossom, "
    },
    {
      "number": 5,
      "pali": "sucigandhaṁ manoramaṁ. ",
      "english": "fragrant and delightful. "
    }
  ]
}