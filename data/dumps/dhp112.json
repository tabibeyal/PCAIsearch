{
  "sutta_id": "DHP112",
  "verses": [
    {
      "number": 1,
      "pali": "Sabbadāsattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "kusīto hīnavīriyo; ",
      "english": "energetic and strong, "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "vīriyamārabhato daḷhaṁ. ",
      "english": "lazy and lacking energy. "
    }
  ]
}