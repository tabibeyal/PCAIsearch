{
  "sutta_id": "DHP113",
  "verses": [
    {
      "number": 1,
      "pali": "Paṭācārātherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "apassaṁ udayabbayaṁ; ",
      "english": "seeing rise and fall "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "passato udayabbayaṁ. ",
      "english": "blind to rise and fall. "
    }
  ]
}