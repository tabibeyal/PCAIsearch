{
  "sutta_id": "SN1.79",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.79 ",
      "english": "Linked Discourses 1.79 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Pātheyyasutta ",
      "english": "Provisions "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu bandhati pātheyyaṁ, ",
      "english": "“What binds the provisions for a journey? "
    },
    {
      "number": 5,
      "pali": "kiṁsu bhogānamāsayo; ",
      "english": "What’s the vault of wealth? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu naraṁ parikassati, ",
      "english": "What drags a person around? "
    },
    {
      "number": 7,
      "pali": "kiṁsu lokasmi dujjahaṁ; ",
      "english": "What in the world is hard to give up? "
    },
    {
      "number": 8,
      "pali": "Kismiṁ baddhā puthū sattā, ",
      "english": "With what are ordinary beings bound, "
    },
    {
      "number": 9,
      "pali": "pāsena sakuṇī yathā”ti. ",
      "english": "like birds in a snare?” "
    },
    {
      "number": 10,
      "pali": "“Saddhā bandhati pātheyyaṁ, ",
      "english": "“Faith binds the provisions for a journey. "
    },
    {
      "number": 11,
      "pali": "sirī bhogānamāsayo; ",
      "english": "Majesty is the vault of wealth. "
    },
    {
      "number": 12,
      "pali": "Icchā naraṁ parikassati, ",
      "english": "Desire drags a person around. "
    },
    {
      "number": 13,
      "pali": "icchā lokasmi dujjahā; ",
      "english": "Desire in the world is hard to give up. "
    },
    {
      "number": 14,
      "pali": "Icchābaddhā puthū sattā, ",
      "english": "Ordinary beings are bound by desire, "
    },
    {
      "number": 15,
      "pali": "pāsena sakuṇī yathā”ti. ",
      "english": "like birds in a snare.” "
    }
  ]
}