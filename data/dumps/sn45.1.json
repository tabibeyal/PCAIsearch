{
  "sutta_id": "SN45.1",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.1 ",
      "english": "Linked Discourses 45.1 "
    },
    {
      "number": 2,
      "pali": "1. Avijjāvagga ",
      "english": "1. Ignorance "
    },
    {
      "number": 3,
      "pali": "Avijjāsutta ",
      "english": "Ignorance "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
      "english": "At one time the Buddha was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. "
    },
    {
      "number": 6,
      "pali": "Tatra kho bhagavā bhikkhū āmantesi: ",
      "english": "There the Buddha addressed the mendicants, "
    },
    {
      "number": 7,
      "pali": "“bhikkhavo”ti. ",
      "english": "“Mendicants!” "
    },
    {
      "number": 8,
      "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
      "english": "“Venerable sir,” they replied. "
    },
    {
      "number": 9,
      "pali": "Bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 10,
      "pali": "“Avijjā, bhikkhave, pubbaṅgamā akusalānaṁ dhammānaṁ samāpattiyā, anvadeva ahirikaṁ anottappaṁ. ",
      "english": "“Mendicants, ignorance precedes the attainment of unskillful qualities, with lack of conscience and prudence following along. "
    },
    {
      "number": 11,
      "pali": "Avijjāgatassa, bhikkhave, aviddasuno micchādiṭṭhi pahoti; ",
      "english": "An ignoramus, sunk in ignorance, produces wrong view. "
    },
    {
      "number": 12,
      "pali": "micchādiṭṭhissa micchāsaṅkappo pahoti; ",
      "english": "Wrong view produces wrong purpose. "
    },
    {
      "number": 13,
      "pali": "micchāsaṅkappassa micchāvācā pahoti; ",
      "english": "Wrong purpose produces wrong speech. "
    },
    {
      "number": 14,
      "pali": "micchāvācassa micchākammanto pahoti; ",
      "english": "Wrong speech produces wrong action. "
    },
    {
      "number": 15,
      "pali": "micchākammantassa micchāājīvo pahoti; ",
      "english": "Wrong action produces wrong livelihood. "
    },
    {
      "number": 16,
      "pali": "micchāājīvassa micchāvāyāmo pahoti; ",
      "english": "Wrong livelihood produces wrong effort. "
    },
    {
      "number": 17,
      "pali": "micchāvāyāmassa micchāsati pahoti; ",
      "english": "Wrong effort produces wrong mindfulness. "
    },
    {
      "number": 18,
      "pali": "micchāsatissa micchāsamādhi pahoti. ",
      "english": "Wrong mindfulness produces wrong immersion. "
    },
    {
      "number": 19,
      "pali": "Vijjā ca kho, bhikkhave, pubbaṅgamā kusalānaṁ dhammānaṁ samāpattiyā, anvadeva hirottappaṁ. ",
      "english": "Knowledge precedes the attainment of skillful qualities, with conscience and prudence following along. "
    },
    {
      "number": 20,
      "pali": "Vijjāgatassa, bhikkhave, viddasuno sammādiṭṭhi pahoti; ",
      "english": "A knowing one, firm in knowledge, produces right view. "
    },
    {
      "number": 21,
      "pali": "sammādiṭṭhissa sammāsaṅkappo pahoti; ",
      "english": "Right view produces right purpose. "
    },
    {
      "number": 22,
      "pali": "sammāsaṅkappassa sammāvācā pahoti; ",
      "english": "Right purpose produces right speech. "
    },
    {
      "number": 23,
      "pali": "sammāvācassa sammākammanto pahoti; ",
      "english": "Right speech produces right action. "
    },
    {
      "number": 24,
      "pali": "sammākammantassa sammāājīvo pahoti; ",
      "english": "Right action produces right livelihood. "
    },
    {
      "number": 25,
      "pali": "sammāājīvassa sammāvāyāmo pahoti; ",
      "english": "Right livelihood produces right effort. "
    },
    {
      "number": 26,
      "pali": "sammāvāyāmassa sammāsati pahoti; ",
      "english": "Right effort produces right mindfulness. "
    },
    {
      "number": 27,
      "pali": "sammāsatissa sammāsamādhi pahotī”ti. ",
      "english": "Right mindfulness produces right immersion.” "
    },
    {
      "number": 28,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}