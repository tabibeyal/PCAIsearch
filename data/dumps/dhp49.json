{
  "sutta_id": "DHP49",
  "verses": [
    {
      "number": 1,
      "pali": "Macchariyakosiyaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathāpi bhamaro pupphaṁ, ",
      "english": "A bee takes the nectar "
    },
    {
      "number": 3,
      "pali": "vaṇṇagandhamaheṭhayaṁ; ",
      "english": "and moves on, doing no damage "
    },
    {
      "number": 4,
      "pali": "Paleti rasamādāya, ",
      "english": "to the flower’s beauty and fragrance; "
    },
    {
      "number": 5,
      "pali": "evaṁ gāme munī care. ",
      "english": "and that’s how a sage should walk in the village. "
    }
  ]
}