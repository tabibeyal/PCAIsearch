{
  "sutta_id": "DHP416",
  "verses": [
    {
      "number": 1,
      "pali": "Jaṭilattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yodha taṇhaṁ pahantvāna, ",
      "english": "They’ve given up craving, "
    },
    {
      "number": 3,
      "pali": "anāgāro paribbaje; ",
      "english": "and have gone forth from lay life; "
    },
    {
      "number": 4,
      "pali": "Taṇhābhavaparikkhīṇaṁ, ",
      "english": "they’ve ended craving to be reborn: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    },
    {
      "number": 6,
      "pali": "Jotikattheravatthu ",
      "english": ""
    },
    {
