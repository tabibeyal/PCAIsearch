{
  "sutta_id": "AN8.18",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.18 ",
      "english": "Numbered Discourses 8.18 "
    },
    {
      "number": 2,
      "pali": "2. Mahāvagga ",
      "english": "2. The Great Chapter "
    },
    {
      "number": 3,
      "pali": "Dutiyabandhanasutta ",
      "english": "Catching (2nd) "
    },
    {
      "number": 4,
      "pali": "“Aṭṭhahi, bhikkhave, ākārehi puriso itthiṁ bandhati. ",
      "english": "“Mendicants, a man catches a woman using eight features. "
    },
    {
      "number": 5,
      "pali": "Katamehi aṭṭhahi? ",
      "english": "What eight? "
    },
    {
      "number": 6,
      "pali": "Ruṇṇena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "With weeping, "
    },
    {
      "number": 7,
      "pali": "hasitena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "laughing, "
    },
    {
      "number": 8,
      "pali": "bhaṇitena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "speaking, "
    },
    {
      "number": 9,
      "pali": "ākappena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "appearance, "
    },
    {
      "number": 10,
      "pali": "vanabhaṅgena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "gifts of wildflowers, "
    },
    {
      "number": 11,
      "pali": "gandhena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "scents, "
    },
    {
      "number": 12,
      "pali": "rasena, bhikkhave, puriso itthiṁ bandhati; ",
      "english": "tastes, "
    },
    {
      "number": 13,
      "pali": "phassena, bhikkhave, puriso itthiṁ bandhati. ",
      "english": "and touches. "
    },
    {
      "number": 14,
      "pali": "Imehi kho, bhikkhave, aṭṭhahākārehi puriso itthiṁ bandhati. ",
      "english": "A man catches a woman using these eight features. "
    },
    {
      "number": 15,
      "pali": "Te, bhikkhave, sattā subaddhā, ye phassena baddhā”ti. ",
      "english": "But those beings who are caught by touch are well and truly caught.” "
    },
    {
      "number": 16,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}