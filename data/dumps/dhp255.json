{
  "sutta_id": "DHP255",
  "verses": [
    {
      "number": 1,
      "pali": "Ākāseva padaṁ natthi, ",
      "english": "In the atmosphere there is no track, "
    },
    {
      "number": 2,
      "pali": "samaṇo natthi bāhire; ",
      "english": "there’s no true ascetic outside here. "
    },
    {
      "number": 3,
      "pali": "Saṅkhārā sassatā natthi, ",
      "english": "No conditions last forever, "
    },
    {
      "number": 4,
      "pali": "natthi buddhānamiñjitaṁ. ",
      "english": "the Awakened Ones are not shaken. "
    },
    {
      "number": 5,
      "pali": "Malavaggo aṭṭhārasamo. ",
      "english": ""
    }
  ]
}