{
  "sutta_id": "SN2.2",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.2 ",
      "english": "Linked Discourses 2.2 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Dutiyakassapasutta ",
      "english": "With Kassapa (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhito kho kassapo devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Kassapa spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Bhikkhu siyā jhāyī vimuttacitto, ",
      "english": "“If a mendicant is a meditator, freed in mind, "
    },
    {
      "number": 7,
      "pali": "Ākaṅkhe ce hadayassānupattiṁ; ",
      "english": "and if they desire the heart’s fulfillment— "
    },
    {
      "number": 8,
      "pali": "Lokassa ñatvā udayabbayañca, ",
      "english": "having known the arising and passing of the world, "
    },
    {
      "number": 9,
      "pali": "Sucetaso anissito tadānisaṁso”ti. ",
      "english": "good-hearted, independent, that is their reward.” "
    }
  ]
}