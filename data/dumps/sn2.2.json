{
  "sutta_id": "SN2.2",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 2.2",
      "english": "Linked Discourses 2.2"
    },
    {
      "number": 2,
      "pali": "Kassapa Sutta",
      "english": "Kassapa the Deva’s Son"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Near Sāvatthi in the monastery… Standing to one side, Kassapa the deva’s son recited this verse in the Blessed One’s presence:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“A monk should have jhāna,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "be released in mind,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "if he wants the heart’s attainment:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "knowing the arising & passing away of the world,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "good in his awareness, independent,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "aimed at that reward.”"
    }
  ]
}