{
  "sutta_id": "DHP132",
  "verses": [
    {
      "number": 1,
      "pali": "Sukhakāmāni bhūtāni, ",
      "english": "Creatures love happiness, "
    },
    {
      "number": 2,
      "pali": "yo daṇḍena na hiṁsati; ",
      "english": "so if you don’t harm them with a stick "
    },
    {
      "number": 3,
      "pali": "Attano sukhamesāno, ",
      "english": "in search of your own happiness, "
    },
    {
      "number": 4,
      "pali": "pecca so labhate sukhaṁ. ",
      "english": "after death you will find happiness. "
    }
  ]
}