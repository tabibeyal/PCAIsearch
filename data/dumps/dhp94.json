{
  "sutta_id": "DHP94",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākaccāyanattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassindriyāni samathaṅgatāni, ",
      "english": "Whose faculties have become serene, "
    },
    {
      "number": 3,
      "pali": "Assā yathā sārathinā sudantā; ",
      "english": "like horses tamed by a charioteer, "
    },
    {
      "number": 4,
      "pali": "Pahīnamānassa anāsavassa, ",
      "english": "who has abandoned conceit and defilements; "
    },
    {
      "number": 5,
      "pali": "Devāpi tassa pihayanti tādino. ",
      "english": "the unaffected one is envied by even the gods. "
    }
  ]
}