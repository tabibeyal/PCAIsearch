    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Pāṇātipātino pāṇātipātīhi saddhiṁ saṁsandanti samenti; ",
      "english": "those who kill living creatures with those who kill living creatures, "
    },
    {
      "number": 7,
      "pali": "adinnādāyino …pe… ",
      "english": "those who steal … "
    },
    {
      "number": 8,
      "pali": "kāmesumicchācārino … ",
      "english": "commit sexual misconduct … "
    },
    {
      "number": 9,
      "pali": "musāvādino … ",
      "english": "lie … "
    },
    {
      "number": 10,
      "pali": "pisuṇavācā … ",
      "english": "backbite … "
    },
    {
      "number": 11,
      "pali": "pharusavācā … ",
      "english": "speak harshly … "
    },
    {
      "number": 12,
      "pali": "samphappalāpino samphappalāpīhi saddhiṁ saṁsandanti samenti; ",
      "english": "talk nonsense … "
    },
    {
      "number": 13,
      "pali": "abhijjhāluno abhijjhālūhi saddhiṁ saṁsandanti samenti; ",
      "english": "are covetous … "
    },
    {
      "number": 14,
      "pali": "byāpannacittā byāpannacittehi saddhiṁ saṁsandanti samenti; ",
      "english": "are malicious … "
    },
    {
      "number": 15,
      "pali": "micchādiṭṭhikā micchādiṭṭhikehi saddhiṁ saṁsandanti samenti. ",
      "english": "have wrong view … "
    },
    {
      "number": 16,
      "pali": "Pāṇātipātā paṭiviratā pāṇātipātā paṭiviratehi saddhiṁ saṁsandanti samenti; ",
      "english": "Those who refrain from killing living creatures … "
    },
    {
      "number": 17,
      "pali": "adinnādānā paṭiviratā …pe… ",
      "english": "who refrain from stealing … "
    },
    {
      "number": 18,
      "pali": "kāmesumicchācārā paṭiviratā … ",
      "english": "who refrain from sexual misconduct … "
    },
    {
      "number": 19,
      "pali": "musāvādā paṭiviratā … ",
      "english": "who refrain from lying … "
    },
    {
      "number": 20,
      "pali": "pisuṇāya vācāya … ",
      "english": "who refrain from backbiting … "
    },
    {
      "number": 21,
      "pali": "pharusāya vācāya … ",
      "english": "who refrain from harsh speech … "
    },
    {
      "number": 22,
      "pali": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṁ saṁsandanti samenti; ",
      "english": "who refrain from talking nonsense … "
    },
    {
      "number": 23,
      "pali": "anabhijjhāluno anabhijjhālūhi saddhiṁ saṁsandanti samenti; ",
      "english": "are not covetous … "
    },
    {
      "number": 24,
      "pali": "abyāpannacittā abyāpannacittehi saddhiṁ saṁsandanti samenti; ",
      "english": "are not malicious … "
    },
    {
      "number": 25,
      "pali": "sammādiṭṭhikā sammādiṭṭhikehi saddhiṁ saṁsandanti samentī”ti. ",
      "english": "have right view with those who have right view.” "
