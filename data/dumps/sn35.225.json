    {
      "number": 3,
      "pali": "Bāhirāyatanaaniccasutta ",
      "english": "The Exterior as Impermanent "
    },
    {
      "number": 4,
      "pali": "“Rūpā, bhikkhave, aniccā. Saddā … gandhā … rasā … phoṭṭhabbā … dhammā aniccā. ",
      "english": "“Mendicants, sights, sounds, smells, tastes, touches, and ideas are impermanent. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    }
  ]
