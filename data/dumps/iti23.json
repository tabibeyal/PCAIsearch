{
  "sutta_id": "ITI23",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 23 ",
      "english": "So It Was Said 23 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Ubhayatthasutta ",
      "english": "Both Kinds of Benefit "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Ekadhammo, bhikkhave, bhāvito bahulīkato ubho atthe samadhigayha tiṭṭhati—",
      "english": "“This one thing, mendicants, when developed and cultivated, secures equal benefits for both "
    },
    {
      "number": 7,
      "pali": "diṭṭhadhammikañceva atthaṁ samparāyikañca. ",
      "english": "this life and lives to come. "
    },
    {
      "number": 8,
      "pali": "Katamo ekadhammo? ",
      "english": "What one thing? "
    },
    {
      "number": 9,
      "pali": "Appamādo kusalesu dhammesu. ",
      "english": "Diligence in skillful qualities. "
    },
    {
      "number": 10,
      "pali": "Ayaṁ kho, bhikkhave, ekadhammo bhāvito bahulīkato ubho atthe samadhigayha tiṭṭhati—",
      "english": "This is the one thing that, when developed and cultivated, secures equal benefits for both "
    },
    {
      "number": 11,
      "pali": "diṭṭhadhammikañceva atthaṁ samparāyikañcā”ti. ",
      "english": "this life and lives to come.” "
    },
    {
      "number": 12,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 13,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 14,
      "pali": "“Appamādaṁ pasaṁsanti, ",
      "english": "“The astute praise diligence "
    },
    {
      "number": 15,
      "pali": "puññakiriyāsu paṇḍitā; ",
      "english": "in making merit. "
    },
    {
      "number": 16,
      "pali": "Appamatto ubho atthe, ",
      "english": "Being diligent, an astute person "
    },
    {
      "number": 17,
      "pali": "adhigaṇhāti paṇḍito. ",
      "english": "secures both benefits: "
    },
    {
      "number": 18,
      "pali": "Diṭṭhe dhamme ca yo attho, ",
      "english": "the benefit in this life, "
    },
    {
      "number": 19,
      "pali": "yo cattho samparāyiko; ",
      "english": "and in lives to come. "
    },
    {
      "number": 20,
      "pali": "Atthābhisamayā dhīro, ",
      "english": "Attentive, comprehending the meaning, "
    },
    {
      "number": 21,
      "pali": "paṇḍitoti pavuccatī”ti. ",
      "english": "they are said to be astute.” "
    },
    {
      "number": 22,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 23,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}