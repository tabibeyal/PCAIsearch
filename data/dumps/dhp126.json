{
  "sutta_id": "DHP126",
  "verses": [
    {
      "number": 1,
      "pali": "Maṇikārakulūpakatissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Gabbhameke uppajjanti, ",
      "english": "Some are born in a womb; "
    },
    {
      "number": 3,
      "pali": "nirayaṁ pāpakammino; ",
      "english": "evil-doers go to hell; "
    },
    {
      "number": 4,
      "pali": "Saggaṁ sugatino yanti, ",
      "english": "the virtuous go to heaven; "
    },
    {
      "number": 5,
      "pali": "parinibbanti anāsavā. ",
      "english": "the undefiled are fully extinguished. "
    }
  ]
}