    {
      "number": 3,
      "pali": "Daṇḍavagga ",
      "english": "10. The Rod "
    },
    {
      "number": 4,
      "pali": "Chabbaggiyabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Sabbe tasanti daṇḍassa, ",
      "english": "All tremble at the rod, "
    },
    {
      "number": 6,
      "pali": "sabbe bhāyanti maccuno; ",
      "english": "all fear death. "
    },
    {
      "number": 7,
      "pali": "Attānaṁ upamaṁ katvā, ",
      "english": "Treating others like oneself, "
    },
    {
      "number": 8,
      "pali": "na haneyya na ghātaye. ",
      "english": "neither kill nor incite to kill. "
    }
  ]
}