{
  "sutta_id": "AN4.18",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.18 ",
      "english": "Numbered Discourses 4.18 "
    },
    {
      "number": 2,
      "pali": "2. Caravagga ",
      "english": "2. Walking "
    },
    {
      "number": 3,
      "pali": "Dutiyaagatisutta ",
      "english": "Prejudice (2nd) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, nāgatigamanāni. ",
      "english": "“Mendicants, there are these four ways of making unprejudiced decisions. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Na chandāgatiṁ gacchati, na dosāgatiṁ gacchati, na mohāgatiṁ gacchati, na bhayāgatiṁ gacchati—",
      "english": "Making decisions unprejudiced by favoritism, hostility, stupidity, and cowardice. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri nāgatigamanānīti. ",
      "english": "These are the four ways of making unprejudiced decisions. "
    },
    {
      "number": 8,
      "pali": "Chandā dosā bhayā mohā, ",
      "english": "If you don’t act against the teaching "
    },
    {
      "number": 9,
      "pali": "yo dhammaṁ nātivattati; ",
      "english": "out of favoritism, hostility, cowardice, and stupidity, "
    },
    {
      "number": 10,
      "pali": "Āpūrati tassa yaso, ",
      "english": "your fame swells, "
    },
    {
      "number": 11,
      "pali": "sukkapakkheva candimā”ti. ",
      "english": "like the moon in the waxing fortnight.” "
    },
    {
      "number": 12,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}