{
  "sutta_id": "DHP227",
  "verses": [
    {
      "number": 1,
      "pali": "Atulaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Porāṇametaṁ atula, ",
      "english": "It’s always been this way, Atula, "
    },
    {
      "number": 3,
      "pali": "netaṁ ajjatanāmiva; ",
      "english": "it’s not just today. "
    },
    {
      "number": 4,
      "pali": "Nindanti tuṇhimāsīnaṁ, ",
      "english": "They blame you when you’re silent, "
    },
    {
      "number": 5,
      "pali": "nindanti bahubhāṇinaṁ; ",
      "english": "they blame you when you speak a lot, "
    },
    {
      "number": 6,
      "pali": "Mitabhāṇimpi nindanti, ",
      "english": "and even when you speak just right: "
    },
    {
      "number": 7,
      "pali": "natthi loke anindito. ",
      "english": "no-one in the world escapes blame. "
    }
  ]
}