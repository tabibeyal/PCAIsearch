{
  "sutta_id": "DHP375",
  "verses": [
    {
      "number": 1,
      "pali": "Tatrāyamādi bhavati, ",
      "english": "This is the very start of the path "
    },
    {
      "number": 2,
      "pali": "idha paññassa bhikkhuno; ",
      "english": "for a wise mendicant here: "
    },
    {
      "number": 3,
      "pali": "Indriyagutti santuṭṭhi, ",
      "english": "guarding the senses, contentment, "
    },
    {
      "number": 4,
      "pali": "pātimokkhe ca saṁvaro. ",
      "english": "and restraint in the monastic code. "
    }
  ]
}