{
  "sutta_id": "AN10.136",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.136 ",
      "english": "Numbered Discourses 10.136 "
    },
    {
      "number": 2,
      "pali": "14. Sādhuvagga ",
      "english": "14. Good "
    },
    {
      "number": 3,
      "pali": "Akusalasutta ",
      "english": "Unskillful "
    },
    {
      "number": 4,
      "pali": "“Akusalañca vo, bhikkhave, desessāmi kusalañca. ",
      "english": "“I will teach you the skillful and the unskillful … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamañca, bhikkhave, akusalaṁ? ",
      "english": "And what is the unskillful? "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhi …pe… micchāvimutti—",
      "english": "Wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, wrong immersion, wrong knowledge, and wrong freedom. "
    },
    {
      "number": 8,
      "pali": "idaṁ vuccati, bhikkhave, akusalaṁ. ",
      "english": "This is called the unskillful. "
    },
    {
      "number": 9,
      "pali": "Katamañca, bhikkhave, kusalaṁ? ",
      "english": "And what is the skillful? "
    },
    {
      "number": 10,
      "pali": "Sammādiṭṭhi …pe… sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 11,
      "pali": "idaṁ vuccati, bhikkhave, kusalan”ti. ",
      "english": "This is called the skillful.” "
    },
    {
      "number": 12,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}