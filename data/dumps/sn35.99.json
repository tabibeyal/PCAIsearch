    {
      "number": 2,
      "pali": "10. Saḷavagga ",
      "english": "10. The Sixes "
    },
    {
      "number": 3,
      "pali": "Samādhisutta ",
      "english": "Immersion "
    },
    {
      "number": 4,
      "pali": "“Samādhiṁ, bhikkhave, bhāvetha. ",
      "english": "“Mendicants, develop immersion. "
    },
    {
      "number": 5,
      "pali": "Samāhito, bhikkhave, bhikkhu yathābhūtaṁ pajānāti. ",
      "english": "A mendicant who has immersion truly understands. "
    },
    {
      "number": 6,
      "pali": "Kiñca yathābhūtaṁ pajānāti? ",
      "english": "What do they truly understand? "
    },
    {
      "number": 7,
      "pali": "‘Cakkhu aniccan’ti yathābhūtaṁ pajānāti; ",
      "english": "They truly understand that the eye is impermanent. "
    },
    {
      "number": 8,
      "pali": "‘rūpā aniccā’ti yathābhūtaṁ pajānāti; ",
      "english": "They truly understand that sights … "
    },
    {
      "number": 9,
      "pali": "‘cakkhuviññāṇaṁ aniccan’ti yathābhūtaṁ pajānāti; ",
      "english": "eye consciousness … "
    },
    {
      "number": 10,
      "pali": "‘cakkhusamphasso anicco’ti yathābhūtaṁ pajānāti. ",
      "english": "eye contact … "
    },
    {
      "number": 11,
      "pali": "‘Yampidaṁ cakkhusamphassapaccayā uppajjati vedayitaṁ sukhaṁ vā dukkhaṁ vā adukkhamasukhaṁ vā tampi aniccan’ti yathābhūtaṁ pajānāti …pe… ",
      "english": "the pleasant, painful, or neutral feeling that arises dependent on eye contact is impermanent. … "
    },
    {
      "number": 12,
      "pali": "‘mano aniccan’ti yathābhūtaṁ pajānāti. ",
      "english": "They truly understand that the mind is impermanent. "
    },
    {
      "number": 13,
      "pali": "Dhammā … ",
      "english": "They truly understand that ideas … "
    },
    {
      "number": 14,
      "pali": "manoviññāṇaṁ … ",
      "english": "mind consciousness … "
    },
    {
      "number": 15,
      "pali": "manosamphasso … ",
      "english": "mind contact … "
    },
    {
      "number": 16,
      "pali": "‘yampidaṁ manosamphassapaccayā uppajjati vedayitaṁ sukhaṁ vā dukkhaṁ vā adukkhamasukhaṁ vā tampi aniccan’ti yathābhūtaṁ pajānāti. ",
      "english": "the pleasant, painful, or neutral feeling that arises dependent on mind contact is impermanent. "
    },
    {
      "number": 17,
      "pali": "Samādhiṁ, bhikkhave, bhāvetha. ",
      "english": "Mendicants, develop immersion. "
    },
    {
      "number": 18,
      "pali": "Samāhito, bhikkhave, bhikkhu yathābhūtaṁ pajānātī”ti. ",
      "english": "A mendicant who has immersion truly understands.” "
    },
    {
      "number": 19,
      "pali": "Chaṭṭhaṁ. ",
