{
  "sutta_id": "DHP293",
  "verses": [
    {
      "number": 1,
      "pali": "Yesañca susamāraddhā, ",
      "english": "Those that have properly undertaken "
    },
    {
      "number": 2,
      "pali": "niccaṁ kāyagatā sati; ",
      "english": "constant mindfulness of the body, "
    },
    {
      "number": 3,
      "pali": "Akiccaṁ te na sevanti, ",
      "english": "don’t cultivate what should not be done, "
    },
    {
      "number": 4,
      "pali": "kicce sātaccakārino; ",
      "english": "but always do what should be done. "
    },
    {
      "number": 5,
      "pali": "Satānaṁ sampajānānaṁ, ",
      "english": "Mindful and aware, "
    },
    {
      "number": 6,
      "pali": "atthaṁ gacchanti āsavā. ",
      "english": "their defilements come to an end. "
    }
  ]
}