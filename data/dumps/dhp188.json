{
  "sutta_id": "DHP188",
  "verses": [
    {
      "number": 1,
      "pali": "Aggidattabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Bahuṁ ve saraṇaṁ yanti, ",
      "english": "So many go for refuge "
    },
    {
      "number": 3,
      "pali": "pabbatāni vanāni ca; ",
      "english": "to mountains and forest groves, "
    },
    {
      "number": 4,
      "pali": "Ārāmarukkhacetyāni, ",
      "english": "to shrines in tended parks; "
    },
    {
      "number": 5,
      "pali": "manussā bhayatajjitā. ",
      "english": "those people are driven by fear. "
    }
  ]
}