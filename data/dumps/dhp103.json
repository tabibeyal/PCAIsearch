{
  "sutta_id": "DHP103",
  "verses": [
    {
      "number": 1,
      "pali": "Yo sahassaṁ sahassena, ",
      "english": "The supreme conqueror is "
    },
    {
      "number": 2,
      "pali": "saṅgāme mānuse jine; ",
      "english": "not he who conquers a million men in battle, "
    },
    {
      "number": 3,
      "pali": "Ekañca jeyyamattānaṁ, ",
      "english": "but he who conquers a single man: "
    },
    {
      "number": 4,
      "pali": "sa ve saṅgāmajuttamo. ",
      "english": "himself. "
    }
  ]
}