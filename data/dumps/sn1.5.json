  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.5 ",
      "english": "Linked Discourses 1.5 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Katichindasutta ",
      "english": "Cut How Many? "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Kati chinde kati jahe, ",
      "english": "“Cut how many? Drop how many? "
    },
    {
      "number": 7,
      "pali": "kati cuttari bhāvaye; ",
      "english": "Develop how many more? "
    },
    {
      "number": 8,
      "pali": "Kati saṅgātigo bhikkhu, ",
      "english": "When a mendicant slips how many chains "
    },
    {
      "number": 9,
      "pali": "oghatiṇṇoti vuccatī”ti. ",
      "english": "are they said to have crossed the flood?” "
    },
    {
      "number": 10,
      "pali": "“Pañca chinde pañca jahe, ",
      "english": "“Five to cut, five to drop, "
    },
    {
      "number": 11,
      "pali": "pañca cuttari bhāvaye; ",
      "english": "and five more to develop. "
    },
    {
      "number": 12,
      "pali": "Pañca saṅgātigo bhikkhu, ",
      "english": "When a mendicant slips five chains "
    },
    {
      "number": 13,
      "pali": "oghatiṇṇoti vuccatī”ti. ",
      "english": "they’re said to have crossed the flood.” "
    }
  ]
}