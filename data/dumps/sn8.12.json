{
  "sutta_id": "SN8.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 8.12 ",
      "english": "Linked Discourses 8.12 "
    },
    {
      "number": 2,
      "pali": "1. Vaṅgīsavagga ",
      "english": "1. With Vaṅgīsa "
    },
    {
      "number": 3,
      "pali": "Vaṅgīsasutta ",
      "english": "With Vaṅgīsa "
    },
    {
      "number": 4,
      "pali": "Ekaṁ samayaṁ āyasmā vaṅgīso sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
      "english": "At one time Venerable Vaṅgīsa was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. "
    },
    {
      "number": 5,
      "pali": "Tena kho pana samayena āyasmā vaṅgīso aciraarahattappatto hutvā vimuttisukhaṁ paṭisaṁvedī tāyaṁ velāyaṁ imā gāthāyo abhāsi: ",
      "english": "Now at that time Vaṅgīsa had recently attained perfection. While experiencing the bliss of freedom, on that occasion he recited these verses: "
    },
    {
      "number": 6,
      "pali": "“Kāveyyamattā vicarimha pubbe, ",
      "english": "“We used to wander, drunk on poetry, "
    },
    {
      "number": 7,
      "pali": "Gāmā gāmaṁ purā puraṁ; ",
      "english": "village to village, town to town. "
    },
    {
      "number": 8,
      "pali": "Athaddasāma sambuddhaṁ, ",
      "english": "Then we saw the Buddha, "
    },
    {
      "number": 9,
      "pali": "Saddhā no upapajjatha. ",
      "english": "and faith arose in us. "
    },
    {
      "number": 10,
      "pali": "So me dhammamadesesi, ",
      "english": "He taught me Dhamma: "
    },
    {
      "number": 11,
      "pali": "khandhāyatanadhātuyo; ",
      "english": "the aggregates, sense fields, and elements. "
    },
    {
      "number": 12,
      "pali": "Tassāhaṁ dhammaṁ sutvāna, ",
      "english": "When I heard his teaching "
    },
    {
      "number": 13,
      "pali": "pabbajiṁ anagāriyaṁ. ",
      "english": "I went forth to homelessness. "
    },
    {
      "number": 14,
      "pali": "Bahunnaṁ vata atthāya, ",
      "english": "It was truly for the benefit of many "
    },
    {
      "number": 15,
      "pali": "bodhiṁ ajjhagamā muni; ",
      "english": "that the sage achieved awakening—"
    },
    {
      "number": 16,
      "pali": "Bhikkhūnaṁ bhikkhunīnañca, ",
      "english": "for the monks and for the nuns "
    },
    {
      "number": 17,
      "pali": "ye niyāmagataddasā. ",
      "english": "who see that they’ve reached certainty. "
    },
    {
      "number": 18,
      "pali": "Svāgataṁ vata me āsi, ",
      "english": "It was so welcome for me "
    },
    {
      "number": 19,
      "pali": "mama buddhassa santike; ",
      "english": "to be in the presence of the Buddha. "
    },
    {
      "number": 20,
      "pali": "Tisso vijjā anuppattā, ",
      "english": "I’ve attained the three knowledges, "
    },
    {
      "number": 21,
      "pali": "kataṁ buddhassa sāsanaṁ. ",
      "english": "and fulfilled the Buddha’s instructions. "
    },
    {
      "number": 22,
      "pali": "Pubbenivāsaṁ jānāmi, ",
      "english": "I know my past lives, "
    },
    {
      "number": 23,
      "pali": "Dibbacakkhuṁ visodhitaṁ; ",
      "english": "my clairvoyance is purified, "
    },
    {
      "number": 24,
      "pali": "Tevijjo iddhipattomhi, ",
      "english": "I am master of three knowledges, <j>attained in psychic power, "
    },
    {
      "number": 25,
      "pali": "Cetopariyāyakovido”ti. ",
      "english": "expert in encompassing the minds of others.” "
    },
    {
      "number": 26,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 27,
      "pali": "Nikkhantaṁ arati ceva, ",
      "english": ""
    },
    {
      "number": 28,
      "pali": "pesalā atimaññanā; ",
      "english": ""
    },
    {
      "number": 29,
      "pali": "Ānandena subhāsitā, ",
      "english": ""
    },
    {
      "number": 30,
      "pali": "sāriputtapavāraṇā; ",
      "english": ""
    },
    {
      "number": 31,
      "pali": "Parosahassaṁ koṇḍañño, ",
      "english": ""
    },
    {
      "number": 32,
      "pali": "moggallānena gaggarā; ",
      "english": ""
    },
    {
      "number": 33,
      "pali": "Vaṅgīsena dvādasāti. ",
      "english": ""
    },
    {
      "number": 34,
      "pali": "Vaṅgīsasaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses with Vaṅgīsa are complete. "
    }
  ]
}