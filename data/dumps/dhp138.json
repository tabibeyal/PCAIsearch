{
  "sutta_id": "DHP138",
  "verses": [
    {
      "number": 1,
      "pali": "Vedanaṁ pharusaṁ jāniṁ, ",
      "english": "harsh pain; loss; "
    },
    {
      "number": 2,
      "pali": "sarīrassa va bhedanaṁ; ",
      "english": "the breakup of the body; "
    },
    {
      "number": 3,
      "pali": "Garukaṁ vāpi ābādhaṁ, ",
      "english": "serious illness; "
    },
    {
      "number": 4,
      "pali": "cittakkhepaṁ va pāpuṇe. ",
      "english": "mental distress; "
    }
  ]
}