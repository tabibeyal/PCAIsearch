    {
      "number": 2,
      "pali": "18. Upāsakavagga ",
      "english": "18. A Lay Follower "
    },
    {
      "number": 3,
      "pali": "Vaṇijjāsutta ",
      "english": "Trades "
    },
    {
      "number": 4,
      "pali": "“Pañcimā, bhikkhave, vaṇijjā upāsakena akaraṇīyā. ",
      "english": "“Mendicants, a lay follower should not engage in these five trades. "
    },
    {
      "number": 5,
      "pali": "Katamā pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Satthavaṇijjā, sattavaṇijjā, maṁsavaṇijjā, majjavaṇijjā, visavaṇijjā—",
      "english": "Trade in weapons, living creatures, meat, intoxicants, and poisons. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, pañca vaṇijjā upāsakena akaraṇīyā”ti. ",
      "english": "A lay follower should not engage in these five trades.” "
    },
    {
      "number": 8,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}