{
  "sutta_id": "SN48.1",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 48.1 ",
      "english": "Linked Discourses 48.1 "
    },
    {
      "number": 2,
      "pali": "1. Suddhikavagga ",
      "english": "1. Plain Version "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Tatra kho bhagavā etadavoca. ",
      "english": "There the Buddha said: "
    },
    {
      "number": 6,
      "pali": "“Pañcimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these five faculties. "
    },
    {
      "number": 7,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 8,
      "pali": "Saddhindriyaṁ, vīriyindriyaṁ, satindriyaṁ, samādhindriyaṁ, paññindriyaṁ—",
      "english": "The faculties of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, pañcindriyānī”ti. ",
      "english": "These are the five faculties.” "
    },
    {
      "number": 10,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}