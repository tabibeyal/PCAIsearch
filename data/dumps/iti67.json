{
  "sutta_id": "ITI67",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 67 ",
      "english": "So It Was Said 67 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Moneyyasutta ",
      "english": "Sagacity "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, moneyyāni. ",
      "english": "“Mendicants, there are these three kinds of sagacity. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāyamoneyyaṁ, vacīmoneyyaṁ, manomoneyyaṁ—",
      "english": "Sagacity of body, speech, and mind. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi moneyyānī”ti. ",
      "english": "These are the three kinds of sagacity.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Kāyamuniṁ vacīmuniṁ, ",
      "english": "“A sage in body, a sage in speech, "
    },
    {
      "number": 13,
      "pali": "manomunimanāsavaṁ; ",
      "english": "a sage undefiled in mind; "
    },
    {
      "number": 14,
      "pali": "Muniṁ moneyyasampannaṁ, ",
      "english": "a sage, blessed with sagacity, "
    },
    {
      "number": 15,
      "pali": "āhu ninhātapāpakan”ti. ",
      "english": "has washed off all bad things, they say.” "
    },
    {
      "number": 16,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 17,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}