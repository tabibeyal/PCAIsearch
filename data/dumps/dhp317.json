{
  "sutta_id": "DHP317",
  "verses": [
    {
      "number": 1,
      "pali": "Abhaye bhayadassino, ",
      "english": "Seeing danger where there is none, "
    },
    {
      "number": 2,
      "pali": "bhaye cābhayadassino; ",
      "english": "and blind to the actual danger, "
    },
    {
      "number": 3,
      "pali": "Micchādiṭṭhisamādānā, ",
      "english": "beings who uphold wrong view "
    },
    {
      "number": 4,
      "pali": "sattā gacchanti duggatiṁ. ",
      "english": "go to a bad place. "
    }
  ]
}