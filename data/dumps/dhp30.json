{
  "sutta_id": "DHP30",
  "verses": [
    {
      "number": 1,
      "pali": "Maghavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamādena maghavā, ",
      "english": "Maghavā became chief of the gods "
    },
    {
      "number": 3,
      "pali": "devānaṁ seṭṭhataṁ gato; ",
      "english": "by means of diligence. "
    },
    {
      "number": 4,
      "pali": "Appamādaṁ pasaṁsanti, ",
      "english": "People praise diligence, "
    },
    {
      "number": 5,
      "pali": "pamādo garahito sadā. ",
      "english": "while negligence is always deplored. "
    }
  ]
}