{
  "sutta_id": "SN47.42",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 47.42 ",
      "english": "Linked Discourses 47.42 "
    },
    {
      "number": 2,
      "pali": "5. Amatavagga ",
      "english": "5. Freedom From Death "
    },
    {
      "number": 3,
      "pali": "Samudayasutta ",
      "english": "Origin "
    },
    {
      "number": 4,
      "pali": "“Catunnaṁ, bhikkhave, satipaṭṭhānānaṁ samudayañca atthaṅgamañca desessāmi. ",
      "english": "“Mendicants, I will teach you the origin and ending of the four kinds of mindfulness meditation. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 6,
      "pali": "Ko ca, bhikkhave, kāyassa samudayo? ",
      "english": "What is the origin of the body? "
    },
    {
      "number": 7,
      "pali": "Āhārasamudayā kāyassa samudayo; ",
      "english": "The body originates from fuel. "
    },
    {
      "number": 8,
      "pali": "āhāranirodhā kāyassa atthaṅgamo. ",
      "english": "When fuel ceases, the body ends. "
    },
    {
      "number": 9,
      "pali": "Phassasamudayā vedanānaṁ samudayo; ",
      "english": "Feelings originate from contact. "
    },
    {
      "number": 10,
      "pali": "phassanirodhā vedanānaṁ atthaṅgamo. ",
      "english": "When contact ceases, feelings end. "
    },
    {
      "number": 11,
      "pali": "Nāmarūpasamudayā cittassa samudayo; ",
      "english": "The mind originates from name and form. "
    },
    {
      "number": 12,
      "pali": "nāmarūpanirodhā cittassa atthaṅgamo. ",
      "english": "When name and form cease, the mind ends. "
    },
    {
      "number": 13,
      "pali": "Manasikārasamudayā dhammānaṁ samudayo; ",
      "english": "Principles originate from application of mind. "
    },
    {
      "number": 14,
      "pali": "manasikāranirodhā dhammānaṁ atthaṅgamo”ti. ",
      "english": "When application of mind ends, principles end.” "
    },
    {
      "number": 15,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}