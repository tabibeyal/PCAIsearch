{
  "sutta_id": "AN2.90",
  "verses": [
    {
      "number": 1,
      "pali": "90 ",
      "english": "90 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Vijjā ca vimutti ca. ",
      "english": "Knowledge and freedom. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}