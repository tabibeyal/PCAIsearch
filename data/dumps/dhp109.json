{
  "sutta_id": "DHP109",
  "verses": [
    {
      "number": 1,
      "pali": "Āyuvaḍḍhanakumāravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Abhivādanasīlissa, ",
      "english": "For one in the habit of bowing, "
    },
    {
      "number": 3,
      "pali": "niccaṁ vuḍḍhāpacāyino; ",
      "english": "always honoring the elders, "
    },
    {
      "number": 4,
      "pali": "Cattāro dhammā vaḍḍhanti, ",
      "english": "four blessings grow: "
    },
    {
      "number": 5,
      "pali": "āyu vaṇṇo sukhaṁ balaṁ. ",
      "english": "lifespan, beauty, happiness, and strength. "
    }
  ]
}