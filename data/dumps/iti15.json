{
  "sutta_id": "ITI15",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 15",
      "english": "Itivuttaka 15"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, I don’t envision even one other fetter–fettered by which beings conjoined go wandering & transmigrating on for a long, long time–like the fetter of craving. Fettered with the fetter of craving, beings conjoined go wandering & transmigrating on for a long, long time.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "With craving his companion, a man"
    },
    {
      "number": 5,
      "pali": "",
      "english": "wanders on a long, long time."
    },
    {
      "number": 6,
      "pali": "",
      "english": "Neither in this state here"
    },
    {
      "number": 7,
      "pali": "",
      "english": "nor anywhere else"
    },
    {
      "number": 8,
      "pali": "",
      "english": "does he go beyond"
    },
    {
      "number": 9,
      "pali": "",
      "english": "the wandering-on."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Knowing this drawback–"
    },
    {
      "number": 11,
      "pali": "",
      "english": "that craving brings stress into play–"
    },
    {
      "number": 12,
      "pali": "",
      "english": "free from craving,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "devoid of clinging,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "mindful, the monk"
    },
    {
      "number": 15,
      "pali": "",
      "english": "lives the mendicant life."
    }
  ]
}