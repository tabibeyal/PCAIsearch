{
  "sutta_id": "AN4.66",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.66 ",
      "english": "Numbered Discourses 4.66 "
    },
    {
      "number": 2,
      "pali": "7. Pattakammavagga ",
      "english": "7. Fitting Deeds "
    },
    {
      "number": 3,
      "pali": "Sarāgasutta ",
      "english": "Greedy "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“Mendicants, these four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sarāgo, sadoso, samoho, samāno—",
      "english": "The greedy, the hateful, the delusional, and the conceited. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasminti. ",
      "english": "These are the four individuals found in the world. "
    },
    {
      "number": 8,
      "pali": "Sārattā rajanīyesu, ",
      "english": "Full of desire for desirable things, "
    },
    {
      "number": 9,
      "pali": "Piyarūpābhinandino; ",
      "english": "enjoying things that seem pleasant, "
    },
    {
      "number": 10,
      "pali": "Mohena āvutā sattā, ",
      "english": "beings veiled by delusion "
    },
    {
      "number": 11,
      "pali": "Baddhā vaḍḍhenti bandhanaṁ. ",
      "english": "only tighten their bonds. "
    },
    {
      "number": 12,
      "pali": "Rāgajaṁ dosajañcāpi, ",
      "english": "Born of greed, born of hate, "
    },
    {
      "number": 13,
      "pali": "mohajaṁ cāpaviddasū; ",
      "english": "born of delusion: the ignorant "
    },
    {
      "number": 14,
      "pali": "Karontākusalaṁ kammaṁ, ",
      "english": "do unskillful deeds "
    },
    {
      "number": 15,
      "pali": "savighātaṁ dukhudrayaṁ. ",
      "english": "that afflict and produce pain. "
    },
    {
      "number": 16,
      "pali": "Avijjānivutā posā, ",
      "english": "If you act out of these qualities, <j>that’s what you become. "
    },
    {
      "number": 17,
      "pali": "andhabhūtā acakkhukā; ",
      "english": "But men shrouded by ignorance, "
    },
    {
      "number": 18,
      "pali": "Yathā dhammā tathā santā, ",
      "english": "are blind, with no eyes to see, "
    },
    {
      "number": 19,
      "pali": "na tassevanti maññare”ti. ",
      "english": "and they never imagine that this could be so.” "
    },
    {
      "number": 20,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}