    },
    {
      "number": 5,
      "pali": "Maggānaṭṭhaṅgiko seṭṭho, ",
      "english": "Of paths, the eightfold is the best; "
    },
    {
      "number": 6,
      "pali": "saccānaṁ caturo padā; ",
      "english": "of truths, the four statements; "
    },
    {
      "number": 7,
      "pali": "Virāgo seṭṭho dhammānaṁ, ",
      "english": "dispassion is the best of things, "
    },
    {
      "number": 8,
      "pali": "dvipadānañca cakkhumā. ",
      "english": "and the Clear-eyed One is the best of humans. "
    }
