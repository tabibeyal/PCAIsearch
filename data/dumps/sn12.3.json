{
  "sutta_id": "SN12.3",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 12.3 ",
      "english": "Linked Discourses 12.3 "
    },
    {
      "number": 2,
      "pali": "1. Buddhavagga ",
      "english": "1. The Buddhas "
    },
    {
      "number": 3,
      "pali": "Paṭipadāsutta ",
      "english": "Practice "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati …pe… ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“micchāpaṭipadañca vo, bhikkhave, desessāmi sammāpaṭipadañca. ",
      "english": "“Mendicants, I will teach you the wrong practice and the right practice. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha, sādhukaṁ manasi karotha, bhāsissāmī”ti. ",
      "english": "Listen and apply your mind well, I will speak.” "
    },
    {
      "number": 7,
      "pali": "“Evaṁ, bhante”ti kho te bhikkhū bhagavato paccassosuṁ. ",
      "english": "“Yes, sir,” they replied. "
    },
    {
      "number": 8,
      "pali": "Bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 9,
      "pali": "“Katamā ca, bhikkhave, micchāpaṭipadā? ",
      "english": "“And what’s the wrong practice? "
    },
    {
      "number": 10,
      "pali": "Avijjāpaccayā, bhikkhave, saṅkhārā; ",
      "english": "Ignorance is a requirement for choices. "
    },
    {
      "number": 11,
      "pali": "saṅkhārapaccayā viññāṇaṁ …pe… ",
      "english": "Choices are a requirement for consciousness. … "
    },
    {
      "number": 12,
      "pali": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
      "english": "That is how this entire mass of suffering originates. "
    },
    {
      "number": 13,
      "pali": "Ayaṁ vuccati, bhikkhave, micchāpaṭipadā. ",
      "english": "This is called the wrong practice. "
    },
    {
      "number": 14,
      "pali": "Katamā ca, bhikkhave, sammāpaṭipadā? ",
      "english": "And what’s the right practice? "
    },
    {
      "number": 15,
      "pali": "Avijjāya tveva asesavirāganirodhā saṅkhāranirodho; ",
      "english": "When ignorance fades away and ceases with no residue left behind, choices cease. "
    },
    {
      "number": 16,
      "pali": "saṅkhāranirodhā viññāṇanirodho …pe… ",
      "english": "When choices cease, consciousness ceases. … "
    },
    {
      "number": 17,
      "pali": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
      "english": "That is how this entire mass of suffering ceases. "
    },
    {
      "number": 18,
      "pali": "Ayaṁ vuccati, bhikkhave, sammāpaṭipadā”ti. ",
      "english": "This is called the right practice.” "
    },
    {
      "number": 19,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}