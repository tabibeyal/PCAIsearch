{
  "sutta_id": "DHP263",
  "verses": [
    {
      "number": 1,
      "pali": "Yassa cetaṁ samucchinnaṁ, ",
      "english": "But if they’ve cut that out, "
    },
    {
      "number": 2,
      "pali": "mūlaghaccaṁ samūhataṁ; ",
      "english": "dug it up at the root, eradicated it, "
    },
    {
      "number": 3,
      "pali": "Sa vantadoso medhāvī, ",
      "english": "that wise one, purged of vice, "
    },
    {
      "number": 4,
      "pali": "“sādhurūpo”ti vuccati. ",
      "english": "is said to be holy. "
    }
  ]
}