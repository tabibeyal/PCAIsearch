{
  "sutta_id": "AN10.78",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.78 ",
      "english": "Numbered Discourses 10.78 "
    },
    {
      "number": 2,
      "pali": "8. Ākaṅkhavagga ",
      "english": "8. If You Want "
    },
    {
      "number": 3,
      "pali": "Nigaṇṭhasutta ",
      "english": "Jains "
    },
    {
      "number": 4,
      "pali": "“Dasahi, bhikkhave, asaddhammehi samannāgatā nigaṇṭhā. ",
      "english": "“Mendicants, Jain ascetics have ten bad qualities. "
    },
    {
      "number": 5,
      "pali": "Katamehi dasahi? ",
      "english": "What ten? "
    },
    {
      "number": 6,
      "pali": "Assaddhā, bhikkhave, nigaṇṭhā; ",
      "english": "They’re faithless and "
    },
    {
      "number": 7,
      "pali": "dussīlā, bhikkhave, nigaṇṭhā; ",
      "english": "unethical, "
    },
    {
      "number": 8,
      "pali": "ahirikā, bhikkhave, nigaṇṭhā; ",
      "english": "without conscience "
    },
    {
      "number": 9,
      "pali": "anottappino, bhikkhave, nigaṇṭhā; ",
      "english": "or prudence, "
    },
    {
      "number": 10,
      "pali": "asappurisasambhattino, bhikkhave, nigaṇṭhā; ",
      "english": "and devoted to untrue persons. "
    },
    {
      "number": 11,
      "pali": "attukkaṁsakaparavambhakā, bhikkhave, nigaṇṭhā; ",
      "english": "They glorify themselves and put others down. "
    },
    {
      "number": 12,
      "pali": "sandiṭṭhiparāmāsā ādhānaggāhī duppaṭinissaggino, bhikkhave, nigaṇṭhā; ",
      "english": "They’re attached to their own views, holding them tight, and refusing to let go. "
    },
    {
      "number": 13,
      "pali": "kuhakā, bhikkhave, nigaṇṭhā; ",
      "english": "They’re deceptive, "
    },
    {
      "number": 14,
      "pali": "pāpicchā, bhikkhave, nigaṇṭhā; ",
      "english": "with corrupt wishes "
    },
    {
      "number": 15,
      "pali": "pāpamittā, bhikkhave, nigaṇṭhā—",
      "english": "and bad friends. "
    },
    {
      "number": 16,
      "pali": "imehi kho, bhikkhave, dasahi asaddhammehi samannāgatā nigaṇṭhā”ti. ",
      "english": "Jain ascetics possess these ten bad qualities.” "
    },
    {
      "number": 17,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}