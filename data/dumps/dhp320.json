    {
      "number": 3,
      "pali": "Nāgavagga ",
      "english": "23. Elephants "
    },
    {
      "number": 4,
      "pali": "Attadantavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Ahaṁ nāgova saṅgāme, ",
      "english": "Like an elephant struck "
    },
    {
      "number": 6,
      "pali": "cāpato patitaṁ saraṁ; ",
      "english": "with arrows in battle, "
    },
    {
      "number": 7,
      "pali": "Ativākyaṁ titikkhissaṁ, ",
      "english": "I shall endure abuse, "
    },
    {
      "number": 8,
      "pali": "dussīlo hi bahujjano. ",
      "english": "for so many folk are badly behaved. "
    }
  ]
}