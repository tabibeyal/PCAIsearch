{
  "sutta_id": "DHP222",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ve uppatitaṁ kodhaṁ, ",
      "english": "When anger surges like a lurching chariot, "
    },
    {
      "number": 3,
      "pali": "rathaṁ bhantaṁva vāraye; ",
      "english": "keep it in check. "
    },
    {
      "number": 4,
      "pali": "Tamahaṁ sārathiṁ brūmi, ",
      "english": "That’s what I call a charioteer; "
    },
    {
      "number": 5,
      "pali": "rasmiggāho itaro jano. ",
      "english": "others just hold the reins. "
    }
  ]
}