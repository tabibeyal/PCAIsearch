{
  "sutta_id": "DHP403",
  "verses": [
    {
      "number": 1,
      "pali": "Khemābhikkhunīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Gambhīrapaññaṁ medhāviṁ, ",
      "english": "Deep in wisdom, intelligent, "
    },
    {
      "number": 3,
      "pali": "maggāmaggassa kovidaṁ; ",
      "english": "expert in the path and what is not the path; "
    },
    {
      "number": 4,
      "pali": "Uttamatthamanuppattaṁ, ",
      "english": "arrived at the highest goal: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}