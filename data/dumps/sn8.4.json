{
  "sutta_id": "SN8.4",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 8.4",
      "english": "Linked Discourses 8.4"
    },
    {
      "number": 2,
      "pali": "Ānanda Sutta",
      "english": "Ānanda (Instructions to Vaṅgīsa)"
    },
    {
      "number": 3,
      "pali": "",
      "english": "On one occasion Ven. Ānanda was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. Then early in the morning, having adjusted his lower robe and taking his bowl & outer robe, he went into Sāvatthī for alms with Ven. Vaṅgīsa as his attendant monk. Now at that time dissatisfaction (with the celibate life) had arisen in Ven. Vaṅgīsa. Lust invaded his mind. So he addressed Ven. Ānanda with this verse:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“With sensual lust I burn."
    },
    {
      "number": 5,
      "pali": "",
      "english": "My mind is on fire."
    },
    {
      "number": 6,
      "pali": "",
      "english": "Please, Gotama, from compassion,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "tell me how"
    },
    {
      "number": 8,
      "pali": "",
      "english": "to put it out.”"
    },
    {
      "number": 9,
      "pali": "",
      "english": "Ven. Ānanda:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "“From distorted perception"
    },
    {
      "number": 11,
      "pali": "",
      "english": "your mind is on fire."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Shun the theme of the beautiful"
    },
    {
      "number": 13,
      "pali": "",
      "english": "accompanied by lust."
    },
    {
      "number": 14,
      "pali": "",
      "english": "See mental fabrications as other,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "as stress,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "& not-self."
    },
    {
      "number": 17,
      "pali": "",
      "english": "Extinguish your great lust."
    },
    {
      "number": 18,
      "pali": "",
      "english": "Don’t keep burning again & again."
    },
    {
      "number": 19,
      "pali": "",
      "english": "Develop the mind"
    },
    {
      "number": 20,
      "pali": "",
      "english": "—well-centered & one—"
    },
    {
      "number": 21,
      "pali": "",
      "english": "in the foul,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "through the foul."
    },
    {
      "number": 23,
      "pali": "",
      "english": "Have your mindfulness"
    },
    {
      "number": 24,
      "pali": "",
      "english": "immersed in the body."
    },
    {
      "number": 25,
      "pali": "",
      "english": "Be one who pursues"
    },
    {
      "number": 26,
      "pali": "",
      "english": "disenchantment."
    },
    {
      "number": 27,
      "pali": "",
      "english": "Develop the theme-less."
    },
    {
      "number": 28,
      "pali": "",
      "english": "Cast out conceit."
    },
    {
      "number": 29,
      "pali": "",
      "english": "Then, from breaking through"
    },
    {
      "number": 30,
      "pali": "",
      "english": "conceit,"
    },
    {
      "number": 31,
      "pali": "",
      "english": "you will go on your way,"
    },
    {
      "number": 32,
      "pali": "",
      "english": "at peace.”"
    }
  ]
}