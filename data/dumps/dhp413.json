{
  "sutta_id": "DHP413",
  "verses": [
    {
      "number": 1,
      "pali": "Candābhattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Candaṁva vimalaṁ suddhaṁ, ",
      "english": "Pure as the spotless moon, "
    },
    {
      "number": 3,
      "pali": "vippasannamanāvilaṁ; ",
      "english": "clear and undisturbed, "
    },
    {
      "number": 4,
      "pali": "Nandībhavaparikkhīṇaṁ, ",
      "english": "they’ve ended relish for rebirth: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}