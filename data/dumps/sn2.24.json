{
  "sutta_id": "SN2.24",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.24 ",
      "english": "Linked Discourses 2.24 "
    },
    {
      "number": 2,
      "pali": "3. Nānātitthiyavagga ",
      "english": "3. Various Sectarians "
    },
    {
      "number": 3,
      "pali": "Ghaṭīkārasutta ",
      "english": "With Ghaṭīkāra "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho ghaṭīkāro devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Ghaṭīkāra spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 5,
      "pali": "“Avihaṁ upapannāse, ",
      "english": "“Seven mendicants reborn in Aviha "
    },
    {
      "number": 6,
      "pali": "vimuttā satta bhikkhavo; ",
      "english": "have been freed. "
    },
    {
      "number": 7,
      "pali": "Rāgadosaparikkhīṇā, ",
      "english": "With the complete ending of greed and hate, "
    },
    {
      "number": 8,
      "pali": "tiṇṇā loke visattikan”ti. ",
      "english": "they’ve crossed over clinging to the world.” "
    },
    {
      "number": 9,
      "pali": "“Ke ca te ataruṁ paṅkaṁ, ",
      "english": "“Who are those who’ve crossed the bog, "
    },
    {
      "number": 10,
      "pali": "maccudheyyaṁ suduttaraṁ; ",
      "english": "Death’s dominion so hard to pass? "
    },
    {
      "number": 11,
      "pali": "Ke hitvā mānusaṁ dehaṁ, ",
      "english": "Who, after leaving behind the human body, "
    },
    {
      "number": 12,
      "pali": "dibbayogaṁ upaccagun”ti. ",
      "english": "have risen above celestial yokes?” "
    },
    {
      "number": 13,
      "pali": "“Upako palagaṇḍo ca, ",
      "english": "“Upaka and Palagaṇḍa, "
    },
    {
      "number": 14,
      "pali": "pukkusāti ca te tayo; ",
      "english": "and Pukkusāti, these three; "
    },
    {
      "number": 15,
      "pali": "Bhaddiyo khaṇḍadevo ca, ",
      "english": "Bhaddiya and Bhaddadeva, "
    },
    {
      "number": 16,
      "pali": "bāhuraggi ca saṅgiyo; ",
      "english": "and Bāhudantī and Piṅgiya. "
    },
    {
      "number": 17,
      "pali": "Te hitvā mānusaṁ dehaṁ, ",
      "english": "They, after leaving behind the human body, "
    },
    {
      "number": 18,
      "pali": "dibbayogaṁ upaccagun”ti. ",
      "english": "have risen above celestial yokes.” "
    },
    {
      "number": 19,
      "pali": "“Kusalī bhāsasī tesaṁ, ",
      "english": "“You speak well of them, "
    },
    {
      "number": 20,
      "pali": "mārapāsappahāyinaṁ; ",
      "english": "who have let go the snares of Māra. "
    },
    {
      "number": 21,
      "pali": "Kassa te dhammamaññāya, ",
      "english": "Whose teaching did they understand "
    },
    {
      "number": 22,
      "pali": "acchiduṁ bhavabandhanan”ti. ",
      "english": "to cut the bonds of rebirth?” "
    },
    {
      "number": 23,
      "pali": "“Na aññatra bhagavatā, ",
      "english": "“None other than the Blessed One! "
    },
    {
      "number": 24,
      "pali": "nāññatra tava sāsanā; ",
      "english": "None other than your instruction! "
    },
    {
      "number": 25,
      "pali": "Yassa te dhammamaññāya, ",
      "english": "It was your teaching that they understood "
    },
    {
      "number": 26,
      "pali": "acchiduṁ bhavabandhanaṁ. ",
      "english": "to cut the bonds of rebirth. "
    },
    {
      "number": 27,
      "pali": "Yattha nāmañca rūpañca, ",
      "english": "Where name and form "
    },
    {
      "number": 28,
      "pali": "asesaṁ uparujjhati; ",
      "english": "cease with no residue left behind; "
    },
    {
      "number": 29,
      "pali": "Taṁ te dhammaṁ idhaññāya, ",
      "english": "understanding this teaching, "
    },
    {
      "number": 30,
      "pali": "acchiduṁ bhavabandhanan”ti. ",
      "english": "they cut the bonds of rebirth.” "
    },
    {
      "number": 31,
      "pali": "“Gambhīraṁ bhāsasī vācaṁ, ",
      "english": "“The words you say are deep, "
    },
    {
      "number": 32,
      "pali": "dubbijānaṁ sudubbudhaṁ; ",
      "english": "hard to understand, so very hard to wake up to. "
    },
    {
      "number": 33,
      "pali": "Kassa tvaṁ dhammamaññāya, ",
      "english": "Whose teaching did you understand "
    },
    {
      "number": 34,
      "pali": "vācaṁ bhāsasi īdisan”ti. ",
      "english": "to be able to say such things?” "
    },
    {
      "number": 35,
      "pali": "“Kumbhakāro pure āsiṁ, ",
      "english": "“In the past I was a potter "
    },
    {
      "number": 36,
      "pali": "vekaḷiṅge ghaṭīkaro; ",
      "english": "in Vebhaliṅga called Ghaṭīkāra. "
    },
    {
      "number": 37,
      "pali": "Mātāpettibharo āsiṁ, ",
      "english": "I took care of my parents "
    },
    {
      "number": 38,
      "pali": "kassapassa upāsako. ",
      "english": "as a lay follower of Buddha Kassapa. "
    },
    {
      "number": 39,
      "pali": "Virato methunā dhammā, ",
      "english": "I refrained from sexual intercourse, "
    },
    {
      "number": 40,
      "pali": "brahmacārī nirāmiso; ",
      "english": "I was chaste, spiritual. "
    },
    {
      "number": 41,
      "pali": "Ahuvā te sagāmeyyo, ",
      "english": "We lived in the same village; "
    },
    {
      "number": 42,
      "pali": "ahuvā te pure sakhā. ",
      "english": "in the past I was your comrade. "
    },
    {
      "number": 43,
      "pali": "Sohamete pajānāmi, ",
      "english": "I am the one who understands "
    },
    {
      "number": 44,
      "pali": "vimutte satta bhikkhavo; ",
      "english": "that these seven mendicants have been freed. "
    },
    {
      "number": 45,
      "pali": "Rāgadosaparikkhīṇe, ",
      "english": "With the complete ending of greed and hate, "
    },
    {
      "number": 46,
      "pali": "tiṇṇe loke visattikan”ti. ",
      "english": "they’ve crossed over clinging to the world.” "
    },
    {
      "number": 47,
      "pali": "“Evametaṁ tadā āsi, ",
      "english": "“That’s exactly how it was, "
    },
    {
      "number": 48,
      "pali": "yathā bhāsasi bhaggava; ",
      "english": "just as you say, Bhaggava. "
    },
    {
      "number": 49,
      "pali": "Kumbhakāro pure āsi, ",
      "english": "In the past you were a potter "
    },
    {
      "number": 50,
      "pali": "vekaḷiṅge ghaṭīkaro. ",
      "english": "in Vebhaliṅga called Ghaṭīkāra. "
    },
    {
      "number": 51,
      "pali": "Mātāpettibharo āsi, ",
      "english": "You took care of your parents "
    },
    {
      "number": 52,
      "pali": "kassapassa upāsako; ",
      "english": "as a lay follower of Buddha Kassapa. "
    },
    {
      "number": 53,
      "pali": "Virato methunā dhammā, ",
      "english": "You refrained from sexual intercourse, "
    },
    {
      "number": 54,
      "pali": "brahmacārī nirāmiso; ",
      "english": "you were chaste, spiritual. "
    },
    {
      "number": 55,
      "pali": "Ahuvā me sagāmeyyo, ",
      "english": "We lived in the same village; "
    },
    {
      "number": 56,
      "pali": "ahuvā me pure sakhā”ti. ",
      "english": "in the past you were my comrade.” "
    },
    {
      "number": 57,
      "pali": "“Evametaṁ purāṇānaṁ, ",
      "english": "“That’s how it was "
    },
    {
      "number": 58,
      "pali": "sahāyānaṁ ahu saṅgamo; ",
      "english": "when those friends of old met again. "
    },
    {
      "number": 59,
      "pali": "Ubhinnaṁ bhāvitattānaṁ, ",
      "english": "Both of them are evolved, "
    },
    {
      "number": 60,
      "pali": "sarīrantimadhārinan”ti. ",
      "english": "and bear their final body.” "
    }
  ]
}