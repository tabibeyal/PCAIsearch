{
  "sutta_id": "AN10.192",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.192 ",
      "english": "Numbered Discourses 10.192 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Sappurisadhammasutta ",
      "english": "The Teaching of the True Persons "
    },
    {
      "number": 4,
      "pali": "“Sappurisadhammañca vo, bhikkhave, desessāmi asappurisadhammañca. ",
      "english": "“Mendicants, I will teach you the teaching of the true persons and the teaching of the untrue persons. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, asappurisadhammo? ",
      "english": "And what is the teaching of the untrue persons? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, asappurisadhammo. ",
      "english": "This is the teaching of the untrue persons. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, sappurisadhammo? ",
      "english": "And what is the teaching of the true persons? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sappurisadhammo”ti. ",
      "english": "This is the teaching of the true persons.” "
    },
    {
      "number": 14,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}