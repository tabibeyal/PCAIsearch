{
  "sutta_id": "DHP220",
  "verses": [
    {
      "number": 1,
      "pali": "Tatheva katapuññampi, ",
      "english": "Just so, when one who has done good "
    },
    {
      "number": 2,
      "pali": "asmā lokā paraṁ gataṁ; ",
      "english": "goes from this world to the next, "
    },
    {
      "number": 3,
      "pali": "Puññāni paṭigaṇhanti, ",
      "english": "their good deeds receive them there, "
    },
    {
      "number": 4,
      "pali": "piyaṁ ñātīva āgataṁ. ",
      "english": "as family welcomes home one they love. "
    },
    {
      "number": 5,
      "pali": "Piyavaggo soḷasamo. ",
      "english": ""
    }
  ]
}