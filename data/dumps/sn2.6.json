{
  "sutta_id": "SN2.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.6 ",
      "english": "Linked Discourses 2.6 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Kāmadasutta ",
      "english": "With Kāmada "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhito kho kāmado devaputto bhagavantaṁ etadavoca: ",
      "english": "Standing to one side, the godling Kāmada said to the Buddha, "
    },
    {
      "number": 6,
      "pali": "“dukkaraṁ, bhagavā, sudukkaraṁ, bhagavā”ti. ",
      "english": "“It’s too hard, Blessed One! It’s just too hard!” "
    },
    {
      "number": 7,
      "pali": "“Dukkaraṁ vāpi karonti, ",
      "english": "“They do it even though it’s hard,” "
    },
    {
      "number": 8,
      "pali": "(kāmadāti bhagavā) ",
      "english": "said the Buddha to Kāmada, "
    },
    {
      "number": 9,
      "pali": "Sekhā sīlasamāhitā; ",
      "english": "“the stable trainees with ethics, and immersion. "
    },
    {
      "number": 10,
      "pali": "Ṭhitattā anagāriyupetassa, ",
      "english": "For one who has entered the homeless life, "
    },
    {
      "number": 11,
      "pali": "Tuṭṭhi hoti sukhāvahā”ti. ",
      "english": "contentment brings happiness.” "
    },
    {
      "number": 12,
      "pali": "“Dullabhā, bhagavā, yadidaṁ tuṭṭhī”ti. ",
      "english": "“Such contentment, Blessed One, is hard to find.” "
    },
    {
      "number": 13,
      "pali": "“Dullabhaṁ vāpi labhanti, ",
      "english": "“They find it even though it’s hard,” "
    },
    {
      "number": 14,
      "pali": "(kāmadāti bhagavā) ",
      "english": "said the Buddha to Kāmada, "
    },
    {
      "number": 15,
      "pali": "Cittavūpasame ratā; ",
      "english": "“those who love peace of mind; "
    },
    {
      "number": 16,
      "pali": "Yesaṁ divā ca ratto ca, ",
      "english": "whose minds love to meditate "
    },
    {
      "number": 17,
      "pali": "Bhāvanāya rato mano”ti. ",
      "english": "day and night.” "
    },
    {
      "number": 18,
      "pali": "“Dussamādahaṁ, bhagavā, yadidaṁ cittan”ti. ",
      "english": "“But it’s hard, Blessed One, to immerse this mind in samādhi.” "
    },
    {
      "number": 19,
      "pali": "“Dussamādahaṁ vāpi samādahanti, ",
      "english": "“They become immersed in samādhi <j>even though it’s hard,” "
    },
    {
      "number": 20,
      "pali": "(kāmadāti bhagavā) ",
      "english": "said the Buddha to Kāmada, "
    },
    {
      "number": 21,
      "pali": "Indriyūpasame ratā; ",
      "english": "“those who love calming the faculties. "
    },
    {
      "number": 22,
      "pali": "Te chetvā maccuno jālaṁ, ",
      "english": "Having cut through the net of Death, "
    },
    {
      "number": 23,
      "pali": "Ariyā gacchanti kāmadā”ti. ",
      "english": "the noble ones, Kāmada, go on their way.” "
    },
    {
      "number": 24,
      "pali": "“Duggamo, bhagavā, visamo maggo”ti. ",
      "english": "“But this path, Blessed One, is rough and hard to travel.” "
    },
    {
      "number": 25,
      "pali": "“Duggame visame vāpi, ",
      "english": "“Though it’s rough, hard to travel, "
    },
    {
      "number": 26,
      "pali": "Ariyā gacchanti kāmada; ",
      "english": "the noble ones, Kāmada, go on their way. "
    },
    {
      "number": 27,
      "pali": "Anariyā visame magge, ",
      "english": "The ignoble fall headfirst "
    },
    {
      "number": 28,
      "pali": "Papatanti avaṁsirā; ",
      "english": "on a rough path. "
    },
    {
      "number": 29,
      "pali": "Ariyānaṁ samo maggo, ",
      "english": "But the path of the noble ones is smooth, "
    },
    {
      "number": 30,
      "pali": "Ariyā hi visame samā”ti. ",
      "english": "for the noble ones are smooth amid the rough.” "
    }
  ]
}