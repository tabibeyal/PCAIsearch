{
  "sutta_id": "SN45.37",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.37 ",
      "english": "Linked Discourses 45.37 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Paṭhamabrahmaññasutta ",
      "english": "The Brahmin Life (1st) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Brahmaññañca vo, bhikkhave, desessāmi, brahmaññaphalāni ca. ",
      "english": "“Mendicants, I will teach you life as a brahmin and the fruits of life as a brahmin. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca kho, bhikkhave, brahmaññaṁ? ",
      "english": "And what is life as a brahmin? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, brahmaññaṁ. ",
      "english": "This is called life as a brahmin. "
    },
    {
      "number": 11,
      "pali": "Katamāni ca, bhikkhave, brahmaññaphalāni? ",
      "english": "And what are the fruits of life as a brahmin? "
    },
    {
      "number": 12,
      "pali": "Sotāpattiphalaṁ, sakadāgāmiphalaṁ, anāgāmiphalaṁ, arahattaphalaṁ—",
      "english": "The fruits of stream-entry, once-return, non-return, and perfection. "
    },
    {
      "number": 13,
      "pali": "imāni vuccanti, bhikkhave, brahmaññaphalānī”ti. ",
      "english": "These are called the fruits of life as a brahmin.” "
    },
    {
      "number": 14,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}