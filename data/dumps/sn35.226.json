      "pali": "17. Saṭṭhipeyyālavagga ",
      "english": "17. Sixty Abbreviated Texts "
    },
    {
      "number": 3,
      "pali": "Bāhirāyatanadukkhasutta ",
      "english": "The Exterior as Suffering "
    },
    {
      "number": 4,
      "pali": "“Rūpā, bhikkhave, dukkhā. Saddā … gandhā … rasā … phoṭṭhabbā … dhammā dukkhā. ",
      "english": "“Mendicants, sights, sounds, smells, tastes, touches, and ideas are suffering. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    }
  ]
