    {
      "number": 3,
      "pali": "Ekamūlasutta ",
      "english": "One Root "
    },
    {
      "number": 4,
      "pali": "“Ekamūlaṁ dvirāvaṭṭaṁ, ",
      "english": "“One the root, two the loops, "
    },
    {
      "number": 5,
      "pali": "timalaṁ pañcapattharaṁ; ",
      "english": "three the stains, five the spreads, "
    },
    {
      "number": 6,
      "pali": "Samuddaṁ dvādasāvaṭṭaṁ, ",
      "english": "and the ocean, the twelfth whirlpool: "
    },
    {
      "number": 7,
      "pali": "pātālaṁ atarī isī”ti. ",
      "english": "such is the abyss crossed by the seer.” "
    }
  ]
