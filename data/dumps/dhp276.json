{
  "sutta_id": "DHP276",
  "verses": [
    {
      "number": 1,
      "pali": "Tumhehi kiccamātappaṁ, ",
      "english": "You yourselves must do the work, "
    },
    {
      "number": 2,
      "pali": "akkhātāro tathāgatā; ",
      "english": "the Realized Ones just show the way. "
    },
    {
      "number": 3,
      "pali": "Paṭipannā pamokkhanti, ",
      "english": "Meditators practicing absorption "
    },
    {
      "number": 4,
      "pali": "jhāyino mārabandhanā. ",
      "english": "are released from Māra’s bonds. "
    }
  ]
}