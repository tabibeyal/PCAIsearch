  "sutta_id": "SN1.54",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.54 ",
      "english": "Linked Discourses 1.54 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Vatthusutta ",
      "english": "Grounds "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu vatthu manussānaṁ, ",
      "english": "“What is the site for human beings? "
    },
    {
      "number": 5,
      "pali": "kiṁsūdha paramo sakhā; ",
      "english": "What is the best comrade here? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu bhūtā upajīvanti, ",
      "english": "By what do the creatures who live off the earth "
    },
    {
      "number": 7,
      "pali": "ye pāṇā pathavissitā”ti. ",
      "english": "sustain their life?” "
    },
    {
      "number": 8,
      "pali": "“Puttā vatthu manussānaṁ, ",
      "english": "“Children are the site for human beings. "
    },
    {
      "number": 9,
      "pali": "bhariyā ca paramo sakhā; ",
      "english": "A wife is the best comrade. "
    },
    {
      "number": 10,
      "pali": "Vuṭṭhiṁ bhūtā upajīvanti, ",
      "english": "The creatures who live off the earth "
    },
    {
      "number": 11,
      "pali": "ye pāṇā pathavissitā”ti. ",
      "english": "sustain their life by rain.” "
    }
  ]
}