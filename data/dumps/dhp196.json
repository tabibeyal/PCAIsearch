{
  "sutta_id": "DHP196",
  "verses": [
    {
      "number": 1,
      "pali": "Te tādise pūjayato, ",
      "english": "quenched, fearing nothing from any quarter—"
    },
    {
      "number": 2,
      "pali": "nibbute akutobhaye; ",
      "english": "the merit of one venerating such as these, "
    },
    {
      "number": 3,
      "pali": "Na sakkā puññaṁ saṅkhātuṁ, ",
      "english": "cannot be calculated by anyone, "
    },
    {
      "number": 4,
      "pali": "imettamapi kenaci. ",
      "english": "saying it is just this much. "
    },
    {
      "number": 5,
      "pali": "Buddhavaggo cuddasamo. ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "Paṭhamabhāṇavāraṁ. ",
      "english": ""
    }
  ]
}