{
  "sutta_id": "AN2.100",
  "verses": [
    {
      "number": 1,
      "pali": "100 ",
      "english": "100 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, bālā. ",
      "english": "“Mendicants, there are two fools. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Yo ca akappiye kappiyasaññī, yo ca kappiye akappiyasaññī. ",
      "english": "One who perceives what is unallowable as allowable, and one who perceives what is allowable as unallowable. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve bālā”ti. ",
      "english": "These are the two fools.” "
    }
  ]
}