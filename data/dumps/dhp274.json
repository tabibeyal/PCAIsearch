{
  "sutta_id": "DHP274",
  "verses": [
    {
      "number": 1,
      "pali": "Eseva maggo natthañño, ",
      "english": "<em>This</em> is the path, there is no other "
    },
    {
      "number": 2,
      "pali": "Dassanassa visuddhiyā; ",
      "english": "for the purification of vision. "
    },
    {
      "number": 3,
      "pali": "Etañhi tumhe paṭipajjatha, ",
      "english": "You all must practice this, "
    },
    {
      "number": 4,
      "pali": "Mārassetaṁ pamohanaṁ. ",
      "english": "it is the way to baffle Māra. "
    }
  ]
}