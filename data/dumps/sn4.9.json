{
  "sutta_id": "SN4.9",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 4.9 ",
      "english": "Linked Discourses 4.9 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "1. Lifespan "
    },
    {
      "number": 3,
      "pali": "Paṭhamaāyusutta ",
      "english": "Lifespan (1st) "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā rājagahe viharati veḷuvane kalandakanivāpe. ",
      "english": "At one time the Buddha was staying near Rājagaha, in the Bamboo Grove, the squirrels’ feeding ground. "
    },
    {
      "number": 6,
      "pali": "Tatra kho bhagavā bhikkhū āmantesi: ",
      "english": "There the Buddha addressed the mendicants, "
    },
    {
      "number": 7,
      "pali": "“bhikkhavo”ti. ",
      "english": "“Mendicants!” "
    },
    {
      "number": 8,
      "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
      "english": "“Venerable sir,” they replied. "
    },
    {
      "number": 9,
      "pali": "Bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 10,
      "pali": "“Appamidaṁ, bhikkhave, manussānaṁ āyu. ",
      "english": "“Mendicants, the lifespan of humans is short. "
    },
    {
      "number": 11,
      "pali": "Gamanīyo samparāyo, kattabbaṁ kusalaṁ, caritabbaṁ brahmacariyaṁ. ",
      "english": "You must go to the next life. So you should do what is skillful, you should practice the spiritual life. "
    },
    {
      "number": 12,
      "pali": "Natthi jātassa amaraṇaṁ. ",
      "english": "No-one born is immortal. "
    },
    {
      "number": 13,
      "pali": "Yo, bhikkhave, ciraṁ jīvati, so vassasataṁ appaṁ vā bhiyyo”ti. ",
      "english": "A long life is a hundred years or a little more.” "
    },
    {
      "number": 14,
      "pali": "Atha kho māro pāpimā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Then Māra the Wicked went up to the Buddha and addressed him in verse: "
    },
    {
      "number": 15,
      "pali": "“Dīghamāyu manussānaṁ, ",
      "english": "“The life of humans is long! "
    },
    {
      "number": 16,
      "pali": "na naṁ hīḷe suporiso; ",
      "english": "A true person wouldn’t scorn it. "
    },
    {
      "number": 17,
      "pali": "Careyya khīramattova, ",
      "english": "Live like a suckling babe, "
    },
    {
      "number": 18,
      "pali": "natthi maccussa āgamo”ti. ",
      "english": "for Death has not come for you.” "
    },
    {
      "number": 19,
      "pali": "“Appamāyu manussānaṁ, ",
      "english": "“The life of humans is short, "
    },
    {
      "number": 20,
      "pali": "hīḷeyya naṁ suporiso; ",
      "english": "and a true person scorns it. "
    },
    {
      "number": 21,
      "pali": "Careyyādittasīsova, ",
      "english": "They should live as though their head was on fire, "
    },
    {
      "number": 22,
      "pali": "natthi maccussa nāgamo”ti. ",
      "english": "for Death comes for everyone.” "
    },
    {
      "number": 23,
      "pali": "Atha kho māro …pe… tatthevantaradhāyīti. ",
      "english": "Then Māra … vanished right there. "
    }
  ]
}