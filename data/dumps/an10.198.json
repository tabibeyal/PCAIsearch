  "sutta_id": "AN10.198",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.198 ",
      "english": "Numbered Discourses 10.198 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Sacchikātabbasutta ",
      "english": "Should Be Realized "
    },
    {
      "number": 4,
      "pali": "“Sacchikātabbañca vo, bhikkhave, dhammaṁ desessāmi na sacchikātabbañca. ",
      "english": "“I will teach you the principle to realize and the principle not to realize. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, na sacchikātabbo dhammo? ",
      "english": "And what is the principle not to realize? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, na sacchikātabbo dhammo. ",
      "english": "This is called the principle not to realize. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, sacchikātabbo dhammo? ",
      "english": "And what is the principle to realize? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sacchikātabbo dhammo”ti. ",
      "english": "This is called the principle to realize.” "
    },
    {
      "number": 14,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Ariyamaggavaggo catuttho. ",
      "english": ""
    }
  ]
}