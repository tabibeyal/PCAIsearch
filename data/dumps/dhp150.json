{
  "sutta_id": "DHP150",
  "verses": [
    {
      "number": 1,
      "pali": "Janapadakalyāṇīrūpanandātherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Aṭṭhīnaṁ nagaraṁ kataṁ, ",
      "english": "In this city built of bones, "
    },
    {
      "number": 3,
      "pali": "maṁsalohitalepanaṁ; ",
      "english": "plastered with flesh and blood, "
    },
    {
      "number": 4,
      "pali": "Yattha jarā ca maccu ca, ",
      "english": "old age and death are stashed away, "
    },
    {
      "number": 5,
      "pali": "māno makkho ca ohito. ",
      "english": "along with conceit and contempt. "
    }
  ]
}