{
  "sutta_id": "AN2.129",
  "verses": [
    {
      "number": 1,
      "pali": "129 ",
      "english": "129 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, āpattiyo. ",
      "english": "“There are these two offenses. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Sāvasesā ca āpatti, anavasesā ca āpatti. ",
      "english": "An offense requiring rehabilitation and an offense not requiring rehabilitation. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve āpattiyo”ti. ",
      "english": "These are the two offenses.” "
    },
    {
      "number": 6,
      "pali": "Āsāduppajahavaggo paṭhamo. ",
      "english": ""
    }
  ]
}