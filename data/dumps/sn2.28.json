{
  "sutta_id": "SN2.28",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.28 ",
      "english": "Linked Discourses 2.28 "
    },
    {
      "number": 2,
      "pali": "3. Nānātitthiyavagga ",
      "english": "3. Various Sectarians "
    },
    {
      "number": 3,
      "pali": "Nandivisālasutta ",
      "english": "With Nandivisāla "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho nandivisālo devaputto bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, the godling Nandivisāla addressed the Buddha in verse: "
    },
    {
      "number": 5,
      "pali": "“Catucakkaṁ navadvāraṁ, ",
      "english": "“Four are its wheels, and nine its doors; "
    },
    {
      "number": 6,
      "pali": "puṇṇaṁ lobhena saṁyutaṁ; ",
      "english": "it’s stuffed full, bound with greed, "
    },
    {
      "number": 7,
      "pali": "Paṅkajātaṁ mahāvīra, ",
      "english": "and born from a bog. "
    },
    {
      "number": 8,
      "pali": "kathaṁ yātrā bhavissatī”ti. ",
      "english": "Great hero, how will I keep going?” "
    },
    {
      "number": 9,
      "pali": "“Chetvā naddhiṁ varattañca, ",
      "english": "“Having cut the strap and harness—"
    },
    {
      "number": 10,
      "pali": "icchālobhañca pāpakaṁ; ",
      "english": "wicked desire and greed—"
    },
    {
      "number": 11,
      "pali": "Samūlaṁ taṇhamabbuyha, ",
      "english": "and having plucked out craving, root and all: "
    },
    {
      "number": 12,
      "pali": "evaṁ yātrā bhavissatī”ti. ",
      "english": "that’s how you will keep going.” "
    }
  ]
}