{
  "sutta_id": "DHP294",
  "verses": [
    {
      "number": 1,
      "pali": "Lakuṇḍakabhaddiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Mātaraṁ pitaraṁ hantvā, ",
      "english": "Having slain mother and father, "
    },
    {
      "number": 3,
      "pali": "rājāno dve ca khattiye; ",
      "english": "and two aristocratic kings, "
    },
    {
      "number": 4,
      "pali": "Raṭṭhaṁ sānucaraṁ hantvā, ",
      "english": "and having wiped out <j>the kingdom with its tax collector, "
    },
    {
      "number": 5,
      "pali": "anīgho yāti brāhmaṇo. ",
      "english": "the brahmin walks on untroubled. "
    }
  ]
}