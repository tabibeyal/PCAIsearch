{
  "sutta_id": "AN10.188",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.188 ",
      "english": "Numbered Discourses 10.188 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Vipākasutta ",
      "english": "Result "
    },
    {
      "number": 4,
      "pali": "“Dukkhavipākañca vo, bhikkhave, dhammaṁ desessāmi sukhavipākañca. ",
      "english": "“I will teach you the principle that results in suffering and that which results in happiness. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, dukkhavipāko dhammo? ",
      "english": "And what is the principle that results in suffering? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, dukkhavipāko dhammo. ",
      "english": "This is called the principle that results in suffering. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, sukhavipāko dhammo? ",
      "english": "And what is the principle that results in happiness? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sukhavipāko dhammo”ti. ",
      "english": "This is called the principle that results in happiness.” "
    },
    {
      "number": 14,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Sādhuvaggo tatiyo. ",
      "english": ""
    }
  ]
}