{
  "sutta_id": "DHP278",
  "verses": [
    {
      "number": 1,
      "pali": "Dukkhalakkhaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "“Sabbe saṅkhārā dukkhā”ti, ",
      "english": "All conditions are suffering—"
    },
    {
      "number": 3,
      "pali": "yadā paññāya passati; ",
      "english": "when this is seen with wisdom, "
    },
    {
      "number": 4,
      "pali": "Atha nibbindati dukkhe, ",
      "english": "one grows disillusioned with suffering: "
    },
    {
      "number": 5,
      "pali": "esa maggo visuddhiyā. ",
      "english": "this is the path to purity. "
    }
  ]
}