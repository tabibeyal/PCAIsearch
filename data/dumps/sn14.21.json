      "pali": "Saṁyutta Nikāya 14.21 ",
      "english": "Linked Discourses 14.21 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Appassutamūlakasutta ",
      "english": "Beginning With the Unlearned "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Appassutā appassutehi saddhiṁ saṁsandanti samenti; ",
      "english": "the unlearned with the unlearned … "
    },
    {
      "number": 7,
      "pali": "kusītā kusītehi saddhiṁ saṁsandanti samenti; ",
      "english": "lazy … "
    },
    {
      "number": 8,
      "pali": "duppaññā duppaññehi saddhiṁ saṁsandanti samenti; ",
      "english": "witless. "
    },
    {
      "number": 9,
      "pali": "bahussutā bahussutehi saddhiṁ saṁsandanti samenti; ",
      "english": "The learned with the learned … "
    },
    {
      "number": 10,
      "pali": "āraddhavīriyā āraddhavīriyehi saddhiṁ saṁsandanti samenti; paññavanto paññavantehi saddhiṁ saṁsandanti samenti …pe…. ",
      "english": "energetic … wise. "
    },
    {
      "number": 11,
      "pali": "Appassutā appassutehi saddhiṁ saṁsandanti samenti; ",
      "english": "… the unlearned with the unlearned … "
    },
    {
      "number": 12,
      "pali": "muṭṭhassatino muṭṭhassatīhi saddhiṁ saṁsandanti samenti; ",
      "english": "unmindful … "
    },
    {
      "number": 13,
      "pali": "duppaññā duppaññehi saddhiṁ saṁsandanti samenti; ",
      "english": "witless. "
    },
    {
      "number": 14,
      "pali": "bahussutā bahussutehi saddhiṁ saṁsandanti samenti; ",
      "english": "The learned with the learned … "
    },
    {
      "number": 15,
      "pali": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṁ saṁsandanti samenti; paññavanto paññavantehi saddhiṁ saṁsandanti samentī”ti …pe…. ",
      "english": "mindful … wise.” "
    },
    {
      "number": 16,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    }
  ]
