{
  "sutta_id": "SN37.34",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 37.34",
      "english": "Linked Discourses 37.34"
    },
    {
      "number": 2,
      "pali": "Vaḍḍhinā Sutta",
      "english": "Growth"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“A female disciple of the noble ones who grows in terms of these five types of growth grows in the noble growth. She grasps hold of what is essential and what is excellent in the body. Which five?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“She grows in terms of conviction."
    },
    {
      "number": 5,
      "pali": "",
      "english": "“She grows in terms of virtue."
    },
    {
      "number": 6,
      "pali": "",
      "english": "“She grows in terms of learning."
    },
    {
      "number": 7,
      "pali": "",
      "english": "“She grows in terms of generosity."
    },
    {
      "number": 8,
      "pali": "",
      "english": "“She grows in terms of discernment."
    },
    {
      "number": 9,
      "pali": "",
      "english": "“Growing in terms of these five types of growth, the female disciple of the noble ones grows in the noble growth. She grasps hold of what is essential and what is excellent in the body.”"
    },
    {
      "number": 10,
      "pali": "",
      "english": "She grows in conviction & virtue,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "discernment, generosity, & learning:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "A virtuous female lay disciple"
    },
    {
      "number": 13,
      "pali": "",
      "english": "such as this"
    },
    {
      "number": 14,
      "pali": "",
      "english": "takes hold of the essence"
    },
    {
      "number": 15,
      "pali": "",
      "english": "right here within herself."
    }
  ]
}