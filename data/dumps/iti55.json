{
  "sutta_id": "ITI55",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 55",
      "english": "Itivuttaka 55"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three searches. Which three? The search for sensuality, the search for becoming, the search for a holy life. These are the three searches.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Sensuality-search, becoming-search,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "together with the holy-life search–"
    },
    {
      "number": 6,
      "pali": "",
      "english": "i.e., grasping at ‘such is the truth’"
    },
    {
      "number": 7,
      "pali": "",
      "english": "based on an accumulation"
    },
    {
      "number": 8,
      "pali": "",
      "english": "of viewpoints:"
    },
    {
      "number": 9,
      "pali": "",
      "english": "through the relinquishing of searches"
    },
    {
      "number": 10,
      "pali": "",
      "english": "& the abolishing of viewpoints"
    },
    {
      "number": 11,
      "pali": "",
      "english": "of one dispassionate to"
    },
    {
      "number": 12,
      "pali": "",
      "english": "all passion,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "and released in the ending"
    },
    {
      "number": 14,
      "pali": "",
      "english": "of craving,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "through the ending of searches, the monk"
    },
    {
      "number": 16,
      "pali": "",
      "english": "is without perplexity, free"
    },
    {
      "number": 17,
      "pali": "",
      "english": "of longing."
    }
  ]
}