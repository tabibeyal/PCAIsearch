{
  "sutta_id": "DHP124",
  "verses": [
    {
      "number": 1,
      "pali": "Kukkuṭamittanesādavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pāṇimhi ce vaṇo nāssa, ",
      "english": "You can carry poison in your hand "
    },
    {
      "number": 3,
      "pali": "hareyya pāṇinā visaṁ; ",
      "english": "if it has no wound, "
    },
    {
      "number": 4,
      "pali": "Nābbaṇaṁ visamanveti, ",
      "english": "for poison does not infect without a wound; "
    },
    {
      "number": 5,
      "pali": "natthi pāpaṁ akubbato. ",
      "english": "nothing bad happens unless you do bad. "
    }
  ]
}