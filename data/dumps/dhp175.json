{
  "sutta_id": "DHP175",
  "verses": [
    {
      "number": 1,
      "pali": "Tiṁsabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Haṁsādiccapathe yanti, ",
      "english": "Swans fly by the sun’s path, "
    },
    {
      "number": 3,
      "pali": "ākāse yanti iddhiyā; ",
      "english": "psychic sages fly through space. "
    },
    {
      "number": 4,
      "pali": "Nīyanti dhīrā lokamhā, ",
      "english": "The attentive leave the world, "
    },
    {
      "number": 5,
      "pali": "jetvā māraṁ savāhiniṁ. ",
      "english": "having vanquished Māra with his legions. "
    }
  ]
}