{
  "sutta_id": "DHP115",
  "verses": [
    {
      "number": 1,
      "pali": "Bahuputtikattherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "apassaṁ dhammamuttamaṁ; ",
      "english": "seeing the supreme teaching "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "passato dhammamuttamaṁ. ",
      "english": "blind to the supreme teaching. "
    },
    {
      "number": 6,
      "pali": "Sahassavaggo aṭṭhamo. ",
      "english": ""
    }
  ]
}