  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 2 ",
      "english": "Numbered Discourses 2.87–97 "
    },
    {
      "number": 2,
      "pali": "9. Dhammavagga ",
      "english": "The Chapter on Two Things "
    },
    {
      "number": 3,
      "pali": "87 ",
      "english": "87 "
    },
    {
      "number": 4,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 5,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Cetovimutti ca paññāvimutti ca. ",
      "english": "Freedom of heart and freedom by wisdom. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}