  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.75 ",
      "english": "Numbered Discourses 4.75 "
    },
    {
      "number": 2,
      "pali": "8. Apaṇṇakavagga ",
      "english": "8.  Sure Bet "
    },
    {
      "number": 3,
      "pali": "Dutiyaaggasutta ",
      "english": "Best (2nd) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, aggāni. ",
      "english": "“Mendicants, these four things are the best. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Rūpaggaṁ, vedanāggaṁ, saññāggaṁ, bhavaggaṁ—",
      "english": "The best form, feeling, perception, and existence. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri aggānī”ti. ",
      "english": "These are the four things that are the best.” "
    },
    {
      "number": 8,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}