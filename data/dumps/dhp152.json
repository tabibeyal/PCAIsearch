{
  "sutta_id": "DHP152",
  "verses": [
    {
      "number": 1,
      "pali": "Lāḷudāyītheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appassutāyaṁ puriso, ",
      "english": "A person of little learning "
    },
    {
      "number": 3,
      "pali": "balībaddhova jīrati; ",
      "english": "ages like an ox—"
    },
    {
      "number": 4,
      "pali": "Maṁsāni tassa vaḍḍhanti, ",
      "english": "their flesh grows, "
    },
    {
      "number": 5,
      "pali": "paññā tassa na vaḍḍhati. ",
      "english": "but not their wisdom. "
    }
  ]
}