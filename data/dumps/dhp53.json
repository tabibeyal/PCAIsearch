{
  "sutta_id": "DHP53",
  "verses": [
    {
      "number": 1,
      "pali": "Visākhāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathāpi puppharāsimhā, ",
      "english": "Just as one would create many garlands "
    },
    {
      "number": 3,
      "pali": "kayirā mālāguṇe bahū; ",
      "english": "from a heap of flowers, "
    },
    {
      "number": 4,
      "pali": "Evaṁ jātena maccena, ",
      "english": "when a person has come to be born, "
    },
    {
      "number": 5,
      "pali": "kattabbaṁ kusalaṁ bahuṁ. ",
      "english": "they should do many skillful things. "
    }
  ]
}