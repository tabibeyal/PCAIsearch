{
  "sutta_id": "DHP358",
  "verses": [
    {
      "number": 1,
      "pali": "Tiṇadosāni khettāni, ",
      "english": "Weeds are the bane of crops, "
    },
    {
      "number": 2,
      "pali": "mohadosā ayaṁ pajā; ",
      "english": "but delusion is these folk’s bane. "
    },
    {
      "number": 3,
      "pali": "Tasmā hi vītamohesu, ",
      "english": "That’s why a gift to one rid of delusion "
    },
    {
      "number": 4,
      "pali": "dinnaṁ hoti mahapphalaṁ. ",
      "english": "is so very fruitful. "
    }
  ]
}