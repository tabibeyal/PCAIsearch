{
  "sutta_id": "DHP226",
  "verses": [
    {
      "number": 1,
      "pali": "Puṇṇadāsīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sadā jāgaramānānaṁ, ",
      "english": "Always wakeful, "
    },
    {
      "number": 3,
      "pali": "ahorattānusikkhinaṁ; ",
      "english": "practicing night and day, "
    },
    {
      "number": 4,
      "pali": "Nibbānaṁ adhimuttānaṁ, ",
      "english": "focused only on extinguishment, "
    },
    {
      "number": 5,
      "pali": "atthaṁ gacchanti āsavā. ",
      "english": "their defilements come to an end. "
    }
  ]
}