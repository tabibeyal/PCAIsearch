{
  "sutta_id": "SN35.42",
  "verses": [
    {
      "number": 1,
      "pali": "“Sabbaṁ, bhikkhave, nirodhadhammaṁ … ",
      "english": "“Mendicants, all is liable to cease. …” "
    },
    {
      "number": 2,
      "pali": "saṅkhittaṁ. ",
      "english": ""
    },
    {
      "number": 3,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 4,
      "pali": "Jātidhammavaggo catuttho. ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "Jātijarābyādhimaraṇaṁ, ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Soko ca saṅkilesikaṁ; ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Khayavayasamudayaṁ, ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Nirodhadhammena te dasāti. ",
      "english": ""
    }
  ]
