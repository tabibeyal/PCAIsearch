    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Kodhavinayo ca upanāhavinayo ca. ",
      "english": "Dispelling anger and dispelling acrimony. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    },
    {
      "number": 6,
      "pali": "Āyācanavaggo dutiyo. ",
      "english": ""
    }
  ]
}