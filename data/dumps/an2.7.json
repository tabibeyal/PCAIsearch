{
  "sutta_id": "AN2.7",
  "verses": [
    {
      "number": 1,
      "pali": "7. Kaṇhasutta ",
      "english": "7. Dark "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā kaṇhā. ",
      "english": "“These two things, mendicants, are dark. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Ahirikañca anottappañca. ",
      "english": "Lack of conscience and prudence. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā kaṇhā”ti. ",
      "english": "These are the two things that are dark.” "
    },
    {
      "number": 6,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}