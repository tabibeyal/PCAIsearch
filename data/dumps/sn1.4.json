{
  "sutta_id": "SN1.4",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.4 ",
      "english": "Linked Discourses 1.4 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Accentisutta ",
      "english": "Time Flies "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Accenti kālā tarayanti rattiyo, ",
      "english": "“Time flies, nights pass by, "
    },
    {
      "number": 7,
      "pali": "Vayoguṇā anupubbaṁ jahanti; ",
      "english": "the stages of life leave us one by one. "
    },
    {
      "number": 8,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 9,
      "pali": "Puññāni kayirātha sukhāvahānī”ti. ",
      "english": "do good deeds that bring you joy.” "
    },
    {
      "number": 10,
      "pali": "“Accenti kālā tarayanti rattiyo, ",
      "english": "“Time flies, nights pass by, "
    },
    {
      "number": 11,
      "pali": "Vayoguṇā anupubbaṁ jahanti; ",
      "english": "the stages of life leave us one by one. "
    },
    {
      "number": 12,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 13,
      "pali": "Lokāmisaṁ pajahe santipekkho”ti. ",
      "english": "a seeker of peace would drop the world’s bait.” "
    }
  ]
}