{
  "sutta_id": "SN1.52",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.52 ",
      "english": "Linked Discourses 1.52 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Ajarasāsutta ",
      "english": "Getting Old "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu ajarasā sādhu, ",
      "english": "“What’s good because it never gets old? "
    },
    {
      "number": 5,
      "pali": "kiṁsu sādhu adhiṭṭhitaṁ; ",
      "english": "What’s good when committed? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu narānaṁ ratanaṁ, ",
      "english": "What is people’s treasure? "
    },
    {
      "number": 7,
      "pali": "kiṁsu corehyahāriyan”ti. ",
      "english": "What can thieves never take?” "
    },
    {
      "number": 8,
      "pali": "“Sīlaṁ ajarasā sādhu, ",
      "english": "“Ethics are good because they never grow old. "
    },
    {
      "number": 9,
      "pali": "saddhā sādhu adhiṭṭhitā; ",
      "english": "Faith is good when committed. "
    },
    {
      "number": 10,
      "pali": "Paññā narānaṁ ratanaṁ, ",
      "english": "Wisdom is people’s treasure. "
    },
    {
      "number": 11,
      "pali": "puññaṁ corehyahāriyan”ti. ",
      "english": "Merit’s what thieves can never take.” "
    }
  ]
}