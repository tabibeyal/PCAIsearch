{
  "sutta_id": "DHP406",
  "verses": [
    {
      "number": 1,
      "pali": "Sāmaṇerānaṁvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Aviruddhaṁ viruddhesu, ",
      "english": "Not fighting among those who fight, "
    },
    {
      "number": 3,
      "pali": "attadaṇḍesu nibbutaṁ; ",
      "english": "quenched among those who have taken up arms, "
    },
    {
      "number": 4,
      "pali": "Sādānesu anādānaṁ, ",
      "english": "not grasping among those who grasp: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}