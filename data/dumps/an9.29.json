{
  "sutta_id": "AN9.29",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 9.29 ",
      "english": "Numbered Discourses 9.29 "
    },
    {
      "number": 2,
      "pali": "3. Sattāvāsavagga ",
      "english": "3. Abodes of Sentient Beings "
    },
    {
      "number": 3,
      "pali": "Āghātavatthusutta ",
      "english": "Grounds for Resentment "
    },
    {
      "number": 4,
      "pali": "“Navayimāni, bhikkhave, āghātavatthūni. ",
      "english": "“Mendicants, there are nine grounds for resentment. "
    },
    {
      "number": 5,
      "pali": "Katamāni nava? ",
      "english": "What nine? "
    },
    {
      "number": 6,
      "pali": "‘Anatthaṁ me acarī’ti āghātaṁ bandhati; ",
      "english": "Thinking: ‘They did wrong to me,’ you harbor resentment. "
    },
    {
      "number": 7,
      "pali": "‘anatthaṁ me caratī’ti āghātaṁ bandhati; ",
      "english": "Thinking: ‘They are doing wrong to me’ … "
    },
    {
      "number": 8,
      "pali": "‘anatthaṁ me carissatī’ti āghātaṁ bandhati; ",
      "english": "‘They will do wrong to me’ … "
    },
    {
      "number": 9,
      "pali": "‘piyassa me manāpassa anatthaṁ acarī’ti …pe… ",
      "english": "‘They did wrong to someone I love’ … "
    },
    {
      "number": 10,
      "pali": "‘anatthaṁ caratī’ti …pe… ",
      "english": "‘They are doing wrong to someone I love’ … "
    },
    {
      "number": 11,
      "pali": "‘anatthaṁ carissatī’ti āghātaṁ bandhati; ",
      "english": "‘They will do wrong to someone I love’ … "
    },
    {
      "number": 12,
      "pali": "‘appiyassa me amanāpassa atthaṁ acarī’ti …pe… ",
      "english": "‘They helped someone I dislike’ … "
    },
    {
      "number": 13,
      "pali": "‘atthaṁ caratī’ti …pe… ",
      "english": "‘They are helping someone I dislike’ … "
    },
    {
      "number": 14,
      "pali": "‘atthaṁ carissatī’ti āghātaṁ bandhati. ",
      "english": "Thinking: ‘They will help someone I dislike,’ you harbor resentment. "
    },
    {
      "number": 15,
      "pali": "Imāni kho, bhikkhave, nava āghātavatthūnī”ti. ",
      "english": "These are the nine grounds for resentment.” "
    },
    {
      "number": 16,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}