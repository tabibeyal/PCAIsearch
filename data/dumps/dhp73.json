{
  "sutta_id": "DHP73",
  "verses": [
    {
      "number": 1,
      "pali": "Cittagahapativatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Asantaṁ bhāvanamiccheyya, ",
      "english": "They’d seek the esteem that they lack, "
    },
    {
      "number": 3,
      "pali": "Purekkhārañca bhikkhusu; ",
      "english": "and status among the mendicants; "
    },
    {
      "number": 4,
      "pali": "Āvāsesu ca issariyaṁ, ",
      "english": "authority over monasteries, "
    },
    {
      "number": 5,
      "pali": "Pūjaṁ parakulesu ca. ",
      "english": "and honor among other families. "
    }
  ]
}