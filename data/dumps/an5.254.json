{
  "sutta_id": "AN5.254",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.254 ",
      "english": "Numbered Discourses 5.254 "
    },
    {
      "number": 2,
      "pali": "26. Upasampadāvagga ",
      "english": "26. Ordination "
    },
    {
      "number": 3,
      "pali": "Pañcamacchariyasutta ",
      "english": "Five Kinds of Stinginess "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, macchariyāni. ",
      "english": "“Mendicants, there are these five kinds of stinginess. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Āvāsamacchariyaṁ, kulamacchariyaṁ, lābhamacchariyaṁ, vaṇṇamacchariyaṁ, dhammamacchariyaṁ—",
      "english": "Stinginess with dwellings, families, material things, praise, and the teachings. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañca macchariyāni. ",
      "english": "These are the five kinds of stinginess. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, pañcannaṁ macchariyānaṁ etaṁ paṭikuṭṭhaṁ, yadidaṁ dhammamacchariyan”ti. ",
      "english": "The most contemptible of these five kinds of stinginess is stinginess with the teaching.” "
    },
    {
      "number": 9,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}