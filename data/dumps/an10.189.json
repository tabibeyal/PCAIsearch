    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Ariyamaggasutta ",
      "english": "The Noble Path "
    },
    {
      "number": 4,
      "pali": "“Ariyamaggañca vo, bhikkhave, desessāmi anariyamaggañca. ",
      "english": "“I will teach you the noble path and the ignoble path. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, anariyo maggo? ",
      "english": "And what is the ignoble path? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, anariyo maggo. ",
      "english": "This is called the ignoble path. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, ariyo maggo? ",
      "english": "And what is the noble path? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, ariyo maggo”ti. ",
      "english": "This is called the noble path.” "
    },
    {
      "number": 14,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
