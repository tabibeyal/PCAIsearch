      "english": "5. The Fool "
    },
    {
      "number": 4,
      "pali": "Aññatarapurisavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Dīghā jāgarato ratti, ",
      "english": "Long is the night for the wakeful; "
    },
    {
      "number": 6,
      "pali": "dīghaṁ santassa yojanaṁ; ",
      "english": "long is the league for the weary; "
    },
    {
      "number": 7,
      "pali": "Dīgho bālāna saṁsāro, ",
      "english": "long transmigrate the fools "
    },
    {
      "number": 8,
      "pali": "saddhammaṁ avijānataṁ. ",
      "english": "who don’t understand the true teaching. "
    }
