{
  "sutta_id": "ITI58",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 58",
      "english": "Itivuttaka 58"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three cravings. Which three? Craving for sensuality, craving for becoming, craving for non-becoming. These are the three cravings.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Bound with the bondage of craving,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "their minds smitten"
    },
    {
      "number": 6,
      "pali": "",
      "english": "with becoming & non-,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "they are bound with the bondage of Māra–"
    },
    {
      "number": 8,
      "pali": "",
      "english": "people with no safety from bondage,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "beings going through the wandering-on,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "headed for birth & death."
    },
    {
      "number": 11,
      "pali": "",
      "english": "While those who’ve abandoned craving,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "free from the craving for becoming & non-,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "reaching the ending of effluents,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "though in the world,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "have gone beyond."
    }
  ]
}