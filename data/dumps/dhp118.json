{
  "sutta_id": "DHP118",
  "verses": [
    {
      "number": 1,
      "pali": "Lājadevadhītāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Puññañce puriso kayirā, ",
      "english": "If you do something good, "
    },
    {
      "number": 3,
      "pali": "kayirā naṁ punappunaṁ; ",
      "english": "do it again and again, "
    },
    {
      "number": 4,
      "pali": "Tamhi chandaṁ kayirātha, ",
      "english": "set your heart on it, "
    },
    {
      "number": 5,
      "pali": "sukho puññassa uccayo. ",
      "english": "for piling up goodness is joyful. "
    }
  ]
}