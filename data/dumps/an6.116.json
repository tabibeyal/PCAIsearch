{
  "sutta_id": "AN6.116",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 6.116 ",
      "english": "Numbered Discourses 6.116 "
    },
    {
      "number": 2,
      "pali": "11. Tikavagga ",
      "english": "11. Triads "
    },
    {
      "number": 3,
      "pali": "Uddhaccasutta ",
      "english": "Restlessness "
    },
    {
      "number": 4,
      "pali": "“Tayome, bhikkhave, dhammā. ",
      "english": "“Mendicants, there are these three things. "
    },
    {
      "number": 5,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Uddhaccaṁ, asaṁvaro, pamādo. ",
      "english": "Restlessness, lack of restraint, and negligence. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, tayo dhammā. ",
      "english": "These are the three things. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, tiṇṇaṁ dhammānaṁ pahānāya tayo dhammā bhāvetabbā. ",
      "english": "To give up these three things you should develop three things. "
    },
    {
      "number": 9,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 10,
      "pali": "Uddhaccassa pahānāya samatho bhāvetabbo, asaṁvarassa pahānāya saṁvaro bhāvetabbo, pamādassa pahānāya appamādo bhāvetabbo. ",
      "english": "You should develop serenity to give up restlessness, restraint to give up lack of restraint, and diligence to give up negligence. "
    },
    {
      "number": 11,
      "pali": "Imesaṁ kho, bhikkhave, tiṇṇaṁ dhammānaṁ pahānāya ime tayo dhammā bhāvetabbā”ti. ",
      "english": "These are the three things you should develop to give up those three things.” "
    },
    {
      "number": 12,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Tikavaggo ekādasamo. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Rāgaduccaritavitakka, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Saññā dhātūti vuccati; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Assādaaratituṭṭhi, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Duve ca uddhaccena vaggoti. ",
      "english": ""
    }
  ]
}