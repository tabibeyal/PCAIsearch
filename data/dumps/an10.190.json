  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.190 ",
      "english": "Numbered Discourses 10.190 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Kaṇhamaggasutta ",
      "english": "The Dark Path "
    },
    {
      "number": 4,
      "pali": "“Kaṇhamaggañca vo, bhikkhave, desessāmi sukkamaggañca. ",
      "english": "“I will teach you the dark path and the bright path. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, kaṇho maggo? ",
      "english": "And what is the dark path? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, kaṇho maggo. ",
      "english": "This is called the dark path. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, sukko maggo? ",
      "english": "And what is the bright path? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sukko maggo”ti. ",
      "english": "This is called the bright path.” "
    },
    {
      "number": 14,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}