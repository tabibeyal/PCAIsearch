{
  "sutta_id": "DHP395",
  "verses": [
    {
      "number": 1,
      "pali": "Kisāgotamīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Paṁsukūladharaṁ jantuṁ, ",
      "english": "A personage who wears robes of rags, "
    },
    {
      "number": 3,
      "pali": "kisaṁ dhamanisanthataṁ; ",
      "english": "lean, their limbs showing veins, "
    },
    {
      "number": 4,
      "pali": "Ekaṁ vanasmiṁ jhāyantaṁ, ",
      "english": "meditating alone in the forest, "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}