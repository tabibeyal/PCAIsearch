  "sutta_id": "SN22.6",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.6 ",
      "english": "Linked Discourses 22.6 "
    },
    {
      "number": 2,
      "pali": "1. Nakulapituvagga ",
      "english": "1. Nakula’s Father "
    },
    {
      "number": 3,
      "pali": "Paṭisallāṇasutta ",
      "english": "Retreat "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Paṭisallāṇe, bhikkhave, yogamāpajjatha. ",
      "english": "“Mendicants, meditate in retreat. "
    },
    {
      "number": 6,
      "pali": "Paṭisallīṇo, bhikkhave, bhikkhu yathābhūtaṁ pajānāti. ",
      "english": "A mendicant in retreat truly understands. "
    },
    {
      "number": 7,
      "pali": "Kiñca yathābhūtaṁ pajānāti? ",
      "english": "What do they truly understand? "
    },
    {
      "number": 8,
      "pali": "Rūpassa samudayañca atthaṅgamañca, vedanāya samudayañca atthaṅgamañca, saññāya samudayañca atthaṅgamañca, saṅkhārānaṁ samudayañca atthaṅgamañca, viññāṇassa samudayañca atthaṅgamañca …pe… ",
      "english": "The origin and ending of form, feeling, perception, choices, and consciousness. …” "
    },
    {
      "number": 9,
      "pali": "(yathā paṭhamasutte tathā vitthāretabbo.) ",
      "english": "(Tell in full as in the previous discourse.) "
    },
    {
      "number": 10,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}