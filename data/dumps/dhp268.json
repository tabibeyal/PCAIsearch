{
  "sutta_id": "DHP268",
  "verses": [
    {
      "number": 1,
      "pali": "Titthiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na monena munī hoti, ",
      "english": "You don’t become a sage by being sagelike, "
    },
    {
      "number": 3,
      "pali": "mūḷharūpo aviddasu; ",
      "english": "while still confused and ignorant. "
    },
    {
      "number": 4,
      "pali": "Yo ca tulaṁva paggayha, ",
      "english": "The astute one who holds the scales, "
    },
    {
      "number": 5,
      "pali": "varamādāya paṇḍito. ",
      "english": "taking only the best, "
    }
  ]
}