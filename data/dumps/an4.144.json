{
  "sutta_id": "AN4.144",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.144 ",
      "english": "Numbered Discourses 4.144 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Obhāsasutta ",
      "english": "Shining "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, obhāsā. ",
      "english": "“Mendicants, there are four kinds of shining. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Candobhāso, sūriyobhāso, aggobhāso, paññobhāso—",
      "english": "The shining of the moon, sun, fire, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro obhāsā. ",
      "english": "These are the four kinds of shining. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ catunnaṁ obhāsānaṁ yadidaṁ paññobhāso”ti. ",
      "english": "The best of these four kinds of shining is the shining of wisdom.” "
    },
    {
      "number": 9,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}