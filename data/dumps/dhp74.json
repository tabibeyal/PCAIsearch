{
  "sutta_id": "DHP74",
  "verses": [
    {
      "number": 1,
      "pali": "Mameva kata maññantu, ",
      "english": "“Let both layfolk and renunciants think "
    },
    {
      "number": 2,
      "pali": "gihī pabbajitā ubho; ",
      "english": "the work was done by me alone. "
    },
    {
      "number": 3,
      "pali": "Mamevātivasā assu, ",
      "english": "In anything at all that’s to be done, "
    },
    {
      "number": 4,
      "pali": "kiccākiccesu kismici; ",
      "english": "let them fall under my sway alone.” "
    },
    {
      "number": 5,
      "pali": "Iti bālassa saṅkappo, ",
      "english": "So thinks the fool, "
    },
    {
      "number": 6,
      "pali": "icchā māno ca vaḍḍhati. ",
      "english": "their greed and pride only growing. "
    }
  ]
}