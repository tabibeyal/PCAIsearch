{
  "sutta_id": "DHP70",
  "verses": [
    {
      "number": 1,
      "pali": "Jambukattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Māse māse kusaggena, ",
      "english": "Month after month a fool may eat "
    },
    {
      "number": 3,
      "pali": "bālo bhuñjeyya bhojanaṁ; ",
      "english": "food from a grass-blade’s tip; "
    },
    {
      "number": 4,
      "pali": "Na so saṅkhātadhammānaṁ, ",
      "english": "but they’ll never be worth a sixteenth part "
    },
    {
      "number": 5,
      "pali": "kalaṁ agghati soḷasiṁ. ",
      "english": "of one who has appraised the teaching. "
    }
  ]
}