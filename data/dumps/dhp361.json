{
  "sutta_id": "DHP361",
  "verses": [
    {
      "number": 1,
      "pali": "Kāyena saṁvaro sādhu, ",
      "english": "Restraint of the body is good; "
    },
    {
      "number": 2,
      "pali": "sādhu vācāya saṁvaro; ",
      "english": "good is restraint of speech; "
    },
    {
      "number": 3,
      "pali": "Manasā saṁvaro sādhu, ",
      "english": "restraint of mind is good; "
    },
    {
      "number": 4,
      "pali": "sādhu sabbattha saṁvaro; ",
      "english": "everywhere, restraint is good. "
    },
    {
      "number": 5,
      "pali": "Sabbattha saṁvuto bhikkhu, ",
      "english": "The mendicant restrained everywhere "
    },
    {
      "number": 6,
      "pali": "sabbadukkhā pamuccati. ",
      "english": "is released from all suffering. "
    }
  ]
}