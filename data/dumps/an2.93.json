{
  "sutta_id": "AN2.93",
  "verses": [
    {
      "number": 1,
      "pali": "93 ",
      "english": "93 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Hirī ca ottappañca. ",
      "english": "Conscience and prudence. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}