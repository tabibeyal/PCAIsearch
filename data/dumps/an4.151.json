{
  "sutta_id": "AN4.151",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.151 ",
      "english": "Numbered Discourses 4.151 "
    },
    {
      "number": 2,
      "pali": "16. Indriyavagga ",
      "english": "16. Faculties "
    },
    {
      "number": 3,
      "pali": "Indriyasutta ",
      "english": "Faculties "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these four faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Saddhindriyaṁ, vīriyindriyaṁ, satindriyaṁ, samādhindriyaṁ—",
      "english": "The faculties of faith, energy, mindfulness, and immersion. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri indriyānī”ti. ",
      "english": "These are the four faculties.” "
    },
    {
      "number": 8,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}