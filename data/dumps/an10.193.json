  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.193 ",
      "english": "Numbered Discourses 10.193 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Uppādetabbadhammasutta ",
      "english": "Principles That Should Be Activated "
    },
    {
      "number": 4,
      "pali": "“Uppādetabbañca vo, bhikkhave, dhammaṁ desessāmi na uppādetabbañca. ",
      "english": "“I will teach you the principle to activate and the principle not to activate. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, na uppādetabbo dhammo? ",
      "english": "And what is the principle not to activate? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, na uppādetabbo dhammo. ",
      "english": "This is called the principle not to activate. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, uppādetabbo dhammo? ",
      "english": "And what is the principle to activate? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, uppādetabbo dhammo”ti. ",
      "english": "This is called the principle to activate.” "
    },
    {
      "number": 14,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}