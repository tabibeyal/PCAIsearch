    {
      "number": 3,
      "pali": "Ajjhattāyatanaaniccasutta ",
      "english": "The Interior as Impermanent "
    },
    {
      "number": 4,
      "pali": "“Cakkhu, bhikkhave, aniccaṁ …pe… jivhā aniccā …pe… mano anicco. ",
      "english": "“Mendicants, the eye, ear, nose, tongue, body, and mind are impermanent. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    }
