{
  "sutta_id": "DHP351",
  "verses": [
    {
      "number": 1,
      "pali": "Māravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Niṭṭhaṅgato asantāsī, ",
      "english": "One who is confident, unafraid, "
    },
    {
      "number": 3,
      "pali": "vītataṇho anaṅgaṇo; ",
      "english": "rid of craving, free of blemish, "
    },
    {
      "number": 4,
      "pali": "Acchindi bhavasallāni, ",
      "english": "having struck down the arrows flying to future lives, "
    },
    {
      "number": 5,
      "pali": "antimoyaṁ samussayo. ",
      "english": "this bag of bones is their last. "
    }
  ]
}