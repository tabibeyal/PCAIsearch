{
  "sutta_id": "SN1.3",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.3 ",
      "english": "Linked Discourses 1.3 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Upanīyasutta ",
      "english": "Led On "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Upanīyati jīvitamappamāyu, ",
      "english": "“This life, so very short, is led onward. "
    },
    {
      "number": 7,
      "pali": "Jarūpanītassa na santi tāṇā; ",
      "english": "One led on to old age has no shelter. "
    },
    {
      "number": 8,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 9,
      "pali": "Puññāni kayirātha sukhāvahānī”ti. ",
      "english": "do good deeds that bring you joy.” "
    },
    {
      "number": 10,
      "pali": "“Upanīyati jīvitamappamāyu, ",
      "english": "“This life, so very short, is led onward; "
    },
    {
      "number": 11,
      "pali": "Jarūpanītassa na santi tāṇā; ",
      "english": "one led on to old age has no shelter. "
    },
    {
      "number": 12,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 13,
      "pali": "Lokāmisaṁ pajahe santipekkho”ti. ",
      "english": "a seeker of peace would drop the world’s bait.” "
    }
  ]
}