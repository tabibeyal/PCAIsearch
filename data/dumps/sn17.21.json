    {
      "number": 3,
      "pali": "Mātugāmasutta ",
      "english": "A Female "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dāruṇo, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "“Possessions, honor, and popularity are grim … "
    },
    {
      "number": 6,
      "pali": "na tassa, bhikkhave, mātugāmo eko ekassa cittaṁ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṁ pariyādāya tiṭṭhati. ",
      "english": "Even if you’re alone with a lady she might not occupy your mind, but possessions, honor and popularity would still occupy your mind. "
    },
    {
      "number": 7,
      "pali": "Evaṁ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "So grim are possessions, honor, and popularity. …” "
    },
    {
      "number": 8,
      "pali": "evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
