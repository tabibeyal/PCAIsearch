{
  "sutta_id": "DHP71",
  "verses": [
    {
      "number": 1,
      "pali": "Ahipetavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na hi pāpaṁ kataṁ kammaṁ, ",
      "english": "For a wicked deed that has been done "
    },
    {
      "number": 3,
      "pali": "Sajjukhīraṁva muccati; ",
      "english": "does not curdle quickly like milk. "
    },
    {
      "number": 4,
      "pali": "Ḍahantaṁ bālamanveti, ",
      "english": "Smoldering, it follows the fool, "
    },
    {
      "number": 5,
      "pali": "Bhasmacchannova pāvako. ",
      "english": "like a fire smothered over with ash. "
    }
  ]
}