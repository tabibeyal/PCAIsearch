  "verses": [
    {
      "number": 1,
      "pali": "Khuddakanikāya ",
      "english": "Minor Collection "
    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 1–20 "
    },
    {
      "number": 3,
      "pali": "Yamakavagga ",
      "english": "1. Pairs "
    },
    {
      "number": 4,
      "pali": "Cakkhupālattheravatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Manopubbaṅgamā dhammā, ",
      "english": "Intention shapes experiences; "
    },
    {
      "number": 6,
      "pali": "manoseṭṭhā manomayā; ",
      "english": "intention is first, they’re made by intention. "
    },
    {
      "number": 7,
      "pali": "Manasā ce paduṭṭhena, ",
      "english": "If with corrupt intent "
    },
    {
      "number": 8,
      "pali": "bhāsati vā karoti vā; ",
      "english": "you speak or act, "
    },
    {
      "number": 9,
      "pali": "Tato naṁ dukkhamanveti, ",
      "english": "suffering follows you, "
    },
    {
      "number": 10,
      "pali": "cakkaṁva vahato padaṁ. ",
      "english": "like a wheel, the ox’s foot. "
    }
  ]
}