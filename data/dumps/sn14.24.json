      "number": 1,
      "pali": "Saṁyutta Nikāya 14.24 ",
      "english": "Linked Discourses 14.24 "
    },
    {
      "number": 2,
      "pali": "3. Kammapathavagga ",
      "english": "3. Ways of Performing Deeds "
    },
    {
      "number": 3,
      "pali": "Dussīlasutta ",
      "english": "Unethical "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
      "english": "“Mendicants, sentient beings join together and converge because of an element: "
    },
    {
      "number": 6,
      "pali": "Assaddhā assaddhehi saddhiṁ saṁsandanti samenti; ",
      "english": "the faithless with the faithless … "
    },
    {
      "number": 7,
      "pali": "ahirikā ahirikehi saddhiṁ saṁsandanti samenti; ",
      "english": "shameless … "
    },
    {
      "number": 8,
      "pali": "anottappino anottappīhi saddhiṁ saṁsandanti samenti; ",
      "english": "imprudent … "
    },
    {
      "number": 9,
      "pali": "dussīlā dussīlehi saddhiṁ saṁsandanti samenti; ",
      "english": "unethical … "
    },
    {
      "number": 10,
      "pali": "duppaññā duppaññehi saddhiṁ saṁsandanti samenti. ",
      "english": "witless … "
    },
    {
      "number": 11,
      "pali": "Saddhā saddhehi saddhiṁ saṁsandanti samenti; ",
      "english": "The faithful with the faithful … "
    },
    {
      "number": 12,
      "pali": "hirimanā hirimanehi saddhiṁ saṁsandanti samenti; ",
      "english": "conscientious … "
    },
    {
      "number": 13,
      "pali": "ottappino ottappīhi saddhiṁ saṁsandanti samenti; ",
      "english": "prudent … "
    },
    {
      "number": 14,
      "pali": "sīlavanto sīlavantehi saddhiṁ saṁsandanti samenti; ",
      "english": "ethical … "
    },
    {
      "number": 15,
      "pali": "paññavanto paññavantehi saddhiṁ saṁsandanti samentī”ti. ",
      "english": "and the wise with the wise.” "
    },
    {
      "number": 16,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
