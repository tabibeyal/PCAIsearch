{
  "sutta_id": "ITI25",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 25 ",
      "english": "So It Was Said 25 "
    },
    {
      "number": 2,
      "pali": "Ekakanipāta ",
      "english": "The Book of the Ones "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Musāvādasutta ",
      "english": "Lying "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Ekadhammaṁ atītassa, bhikkhave, purisapuggalassa nāhaṁ tassa kiñci pāpakammaṁ akaraṇīyanti vadāmi. ",
      "english": "“Mendicants, for an individual person who transgresses in one thing, there is no bad deed they would not do, I say. "
    },
    {
      "number": 7,
      "pali": "Katamaṁ ekadhammaṁ? ",
      "english": "What one thing? "
    },
    {
      "number": 8,
      "pali": "Yadidaṁ, bhikkhave, sampajānamusāvādo”ti. ",
      "english": "It is this: telling a deliberate lie.” "
    },
    {
      "number": 9,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 10,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 11,
      "pali": "“Ekadhammaṁ atītassa, ",
      "english": "“When a personage, spurning the hereafter, "
    },
    {
      "number": 12,
      "pali": "musāvādissa jantuno; ",
      "english": "transgresses in just one thing—"
    },
    {
      "number": 13,
      "pali": "Vitiṇṇaparalokassa, ",
      "english": "lying—"
    },
    {
      "number": 14,
      "pali": "natthi pāpaṁ akāriyan”ti. ",
      "english": "there is no evil they would not do.” "
    },
    {
      "number": 15,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 16,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}