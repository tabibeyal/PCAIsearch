{
  "sutta_id": "DHP9",
  "verses": [
    {
      "number": 1,
      "pali": "Devadattavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Anikkasāvo kāsāvaṁ, ",
      "english": "One who, not free of stains themselves, "
    },
    {
      "number": 3,
      "pali": "yo vatthaṁ paridahissati; ",
      "english": "would wear the robe stained in ocher, "
    },
    {
      "number": 4,
      "pali": "Apeto damasaccena, ",
      "english": "bereft of self-control and of truth: "
    },
    {
      "number": 5,
      "pali": "na so kāsāvamarahati. ",
      "english": "they are not worthy of the ocher robe. "
    }
  ]
}