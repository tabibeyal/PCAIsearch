{
  "sutta_id": "AN5.35",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.35 ",
      "english": "Numbered Discourses 5.35 "
    },
    {
      "number": 2,
      "pali": "4. Sumanavagga ",
      "english": "4. With Sumanā "
    },
    {
      "number": 3,
      "pali": "Dānānisaṁsasutta ",
      "english": "The Benefits of Giving "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, dāne ānisaṁsā. ",
      "english": "“Mendicants, there are five benefits of giving. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Bahuno janassa piyo hoti manāpo; ",
      "english": "A giver, a donor is dear and beloved by many people. "
    },
    {
      "number": 7,
      "pali": "santo sappurisā bhajanti; ",
      "english": "Good and true persons associate with them. "
    },
    {
      "number": 8,
      "pali": "kalyāṇo kittisaddo abbhuggacchati; ",
      "english": "They get a good reputation. "
    },
    {
      "number": 9,
      "pali": "gihidhammā anapagato hoti; ",
      "english": "They don’t neglect a layperson’s duties. "
    },
    {
      "number": 10,
      "pali": "kāyassa bhedā paraṁ maraṇā sugatiṁ saggaṁ lokaṁ upapajjati. ",
      "english": "When their body breaks up, after death, they’re reborn in a good place, a heavenly realm. "
    },
    {
      "number": 11,
      "pali": "Ime kho, bhikkhave, pañca dāne ānisaṁsāti. ",
      "english": "These are the five benefits of giving. "
    },
    {
      "number": 12,
      "pali": "Dadamāno piyo hoti, ",
      "english": "Giving, one is loved, "
    },
    {
      "number": 13,
      "pali": "sataṁ dhammaṁ anukkamaṁ; ",
      "english": "and follows the way of the good. "
    },
    {
      "number": 14,
      "pali": "Santo naṁ sadā bhajanti, ",
      "english": "The good, disciplined spiritual practitioners "
    },
    {
      "number": 15,
      "pali": "saññatā brahmacārayo. ",
      "english": "always associate with you. "
    },
    {
      "number": 16,
      "pali": "Te tassa dhammaṁ desenti, ",
      "english": "They teach you the Dhamma "
    },
    {
      "number": 17,
      "pali": "Sabbadukkhāpanūdanaṁ; ",
      "english": "that casts aside all suffering. "
    },
    {
      "number": 18,
      "pali": "Yaṁ so dhammaṁ idhaññāya, ",
      "english": "Having understood this teaching, "
    },
    {
      "number": 19,
      "pali": "Parinibbāti anāsavo”ti. ",
      "english": "the undefiled one is fully extinguished.” "
    },
    {
      "number": 20,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}