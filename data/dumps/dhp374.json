{
  "sutta_id": "DHP374",
  "verses": [
    {
      "number": 1,
      "pali": "Yato yato sammasati, ",
      "english": "Whenever they are mindful "
    },
    {
      "number": 2,
      "pali": "khandhānaṁ udayabbayaṁ; ",
      "english": "of the rise and fall of the aggregates, "
    },
    {
      "number": 3,
      "pali": "Labhatī pītipāmojjaṁ, ",
      "english": "they feel rapture and joy: "
    },
    {
      "number": 4,
      "pali": "amataṁ taṁ vijānataṁ. ",
      "english": "that is freedom from death for one who knows. "
    }
  ]
}