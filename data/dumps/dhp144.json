{
  "sutta_id": "DHP144",
  "verses": [
    {
      "number": 1,
      "pali": "Asso yathā bhadro kasāniviṭṭho, ",
      "english": "Like a fine horse under the whip, "
    },
    {
      "number": 2,
      "pali": "Ātāpino saṁvegino bhavātha; ",
      "english": "be keen and full of urgency. "
    },
    {
      "number": 3,
      "pali": "Saddhāya sīlena ca vīriyena ca, ",
      "english": "With faith, ethics, and energy, "
    },
    {
      "number": 4,
      "pali": "Samādhinā dhammavinicchayena ca; ",
      "english": "immersion, and investigation of principles, "
    },
    {
      "number": 5,
      "pali": "Sampannavijjācaraṇā patissatā, ",
      "english": "accomplished in knowledge and conduct, mindful, "
    },
    {
      "number": 6,
      "pali": "Jahissatha dukkhamidaṁ anappakaṁ. ",
      "english": "give up this vast suffering. "
    }
  ]
}