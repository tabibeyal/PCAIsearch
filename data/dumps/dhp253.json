{
  "sutta_id": "DHP253",
  "verses": [
    {
      "number": 1,
      "pali": "Ujjhānasaññittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Paravajjānupassissa, ",
      "english": "When you look for the flaws of others, "
    },
    {
      "number": 3,
      "pali": "niccaṁ ujjhānasaññino; ",
      "english": "always finding fault, "
    },
    {
      "number": 4,
      "pali": "Āsavā tassa vaḍḍhanti, ",
      "english": "your defilements only grow, "
    },
    {
      "number": 5,
      "pali": "ārā so āsavakkhayā. ",
      "english": "you’re far from ending defilements. "
    }
  ]
}