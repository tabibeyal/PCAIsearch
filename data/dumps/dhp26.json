{
  "sutta_id": "DHP26",
  "verses": [
    {
      "number": 1,
      "pali": "Bālanakkhattasaṅghuṭṭhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pamādamanuyuñjanti, ",
      "english": "Fools and simpletons "
    },
    {
      "number": 3,
      "pali": "bālā dummedhino janā; ",
      "english": "devote themselves to negligence. "
    },
    {
      "number": 4,
      "pali": "Appamādañca medhāvī, ",
      "english": "But the wise protect diligence "
    },
    {
      "number": 5,
      "pali": "dhanaṁ seṭṭhaṁva rakkhati. ",
      "english": "as their best treasure. "
    }
  ]
}