{
  "sutta_id": "DHP241",
  "verses": [
    {
      "number": 1,
      "pali": "Lāḷudāyīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Asajjhāyamalā mantā, ",
      "english": "Not rehearsing is the stain of hymns. "
    },
    {
      "number": 3,
      "pali": "anuṭṭhānamalā gharā; ",
      "english": "The stain of houses is neglect. "
    },
    {
      "number": 4,
      "pali": "Malaṁ vaṇṇassa kosajjaṁ, ",
      "english": "Laziness is the stain of beauty. "
    },
    {
      "number": 5,
      "pali": "pamādo rakkhato malaṁ. ",
      "english": "A guard’s stain is negligence. "
    }
  ]
}