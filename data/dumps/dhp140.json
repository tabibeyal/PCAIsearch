{
  "sutta_id": "DHP140",
  "verses": [
    {
      "number": 1,
      "pali": "Atha vāssa agārāni, ",
      "english": "or else their home "
    },
    {
      "number": 2,
      "pali": "aggi ḍahati pāvako; ",
      "english": "is consumed by fire. "
    },
    {
      "number": 3,
      "pali": "Kāyassa bhedā duppañño, ",
      "english": "When their body breaks up, that witless person "
    },
    {
      "number": 4,
      "pali": "nirayaṁ sopapajjati. ",
      "english": "is reborn in hell. "
    }
  ]
}