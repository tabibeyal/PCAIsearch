{
  "sutta_id": "DHP162",
  "verses": [
    {
      "number": 1,
      "pali": "Devadattavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa accantadussilyaṁ, ",
      "english": "One choked by immorality, "
    },
    {
      "number": 3,
      "pali": "māluvā sālamivotthataṁ; ",
      "english": "as a sal tree by a creeper, "
    },
    {
      "number": 4,
      "pali": "Karoti so tathattānaṁ, ",
      "english": "does to themselves "
    },
    {
      "number": 5,
      "pali": "yathā naṁ icchatī diso. ",
      "english": "what a foe only wishes. "
    }
  ]
}