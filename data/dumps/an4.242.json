{
  "sutta_id": "AN4.242",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.242 ",
      "english": "Numbered Discourses 4.242 "
    },
    {
      "number": 2,
      "pali": "24. Kammavagga ",
      "english": "24. Deeds "
    },
    {
      "number": 3,
      "pali": "Sappurisānisaṁsasutta ",
      "english": "Benefits of Relying on a True Person "
    },
    {
      "number": 4,
      "pali": "“Sappurisaṁ, bhikkhave, nissāya cattāro ānisaṁsā pāṭikaṅkhā. ",
      "english": "“Mendicants, you can expect four benefits from relying on a true person. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Ariyena sīlena vaḍḍhati, ariyena samādhinā vaḍḍhati, ariyāya paññāya vaḍḍhati, ariyāya vimuttiyā vaḍḍhati—",
      "english": "Growth in noble ethics, immersion, wisdom, and freedom. "
    },
    {
      "number": 7,
      "pali": "sappurisaṁ, bhikkhave, nissāya ime cattāro ānisaṁsā pāṭikaṅkhā”ti. ",
      "english": "You can expect these four benefits from relying on a true person.” "
    },
    {
      "number": 8,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Kammavaggo catuttho. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Saṅkhitta vitthāra soṇakāyana, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Sikkhāpadaṁ ariyamaggo bojjhaṅgaṁ; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Sāvajjañceva abyābajjhaṁ, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Samaṇo ca sappurisānisaṁsoti. ",
      "english": ""
    }
  ]
}