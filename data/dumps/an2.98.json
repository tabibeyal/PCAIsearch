{
  "sutta_id": "AN2.98",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 2 ",
      "english": "Numbered Discourses 2.98–117 "
    },
    {
      "number": 2,
      "pali": "10. Bālavagga ",
      "english": "The Chapter on Fools "
    },
    {
      "number": 3,
      "pali": "98 ",
      "english": "98 "
    },
    {
      "number": 4,
      "pali": "“Dveme, bhikkhave, bālā. ",
      "english": "“Mendicants, there are two fools. "
    },
    {
      "number": 5,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Yo ca anāgataṁ bhāraṁ vahati, yo ca āgataṁ bhāraṁ na vahati. ",
      "english": "One who carries the burden of what has not come to pass, and one who doesn’t carry the burden of what has come to pass. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, dve bālā”ti. ",
      "english": "These are the two fools.” "
    }
  ]
}