{
  "sutta_id": "DHP214",
  "verses": [
    {
      "number": 1,
      "pali": "Licchavīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ratiyā jāyatī soko, ",
      "english": "Sorrow springs from relishing, "
    },
    {
      "number": 3,
      "pali": "ratiyā jāyatī bhayaṁ; ",
      "english": "fear springs from relishing; "
    },
    {
      "number": 4,
      "pali": "Ratiyā vippamuttassa, ",
      "english": "one free from relishing "
    },
    {
      "number": 5,
      "pali": "natthi soko kuto bhayaṁ. ",
      "english": "has no sorrow, let alone fear. "
    }
  ]
}