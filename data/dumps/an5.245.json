{
  "sutta_id": "AN5.245",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.245 ",
      "english": "Numbered Discourses 5.245 "
    },
    {
      "number": 2,
      "pali": "25. Duccaritavagga ",
      "english": "25. Bad Conduct "
    },
    {
      "number": 3,
      "pali": "Dutiyaduccaritasutta ",
      "english": "Bad Conduct (2nd) "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, ādīnavā duccarite. ",
      "english": "“Mendicants, there are these five drawbacks of bad conduct. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Attāpi attānaṁ upavadati; ",
      "english": "You blame yourself. "
    },
    {
      "number": 7,
      "pali": "anuvicca viññū garahanti; ",
      "english": "After examination, sensible people criticize you. "
    },
    {
      "number": 8,
      "pali": "pāpako kittisaddo abbhuggacchati; ",
      "english": "You get a bad reputation. "
    },
    {
      "number": 9,
      "pali": "saddhammā vuṭṭhāti; ",
      "english": "You drift away from true teachings. "
    },
    {
      "number": 10,
      "pali": "asaddhamme patiṭṭhāti. ",
      "english": "You settle on untrue teachings. "
    },
    {
      "number": 11,
      "pali": "Ime kho, bhikkhave, pañca ādīnavā duccarite. ",
      "english": "These are the five drawbacks of bad conduct. "
    },
    {
      "number": 12,
      "pali": "Pañcime, bhikkhave, ānisaṁsā sucarite. ",
      "english": "There are these five benefits of good conduct. "
    },
    {
      "number": 13,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 14,
      "pali": "Attāpi attānaṁ na upavadati; ",
      "english": "You don’t blame yourself. "
    },
    {
      "number": 15,
      "pali": "anuvicca viññū pasaṁsanti; ",
      "english": "After examination, sensible people praise you. "
    },
    {
      "number": 16,
      "pali": "kalyāṇo kittisaddo abbhuggacchati; ",
      "english": "You get a good reputation. "
    },
    {
      "number": 17,
      "pali": "asaddhammā vuṭṭhāti; ",
      "english": "You drift away from untrue teachings. "
    },
    {
      "number": 18,
      "pali": "saddhamme patiṭṭhāti. ",
      "english": "You settle on true teachings. "
    },
    {
      "number": 19,
      "pali": "Ime kho, bhikkhave, pañca ānisaṁsā sucarite”ti. ",
      "english": "These are the five benefits of good conduct.” "
    },
    {
      "number": 20,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}