      "number": 1,
      "pali": "Aṅguttara Nikāya 5.182 ",
      "english": "Numbered Discourses 5.182 "
    },
    {
      "number": 2,
      "pali": "19. Araññavagga ",
      "english": "19. Wilderness Dwellers "
    },
    {
      "number": 3,
      "pali": "Cīvarasutta ",
      "english": "Robes "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, paṁsukūlikā. ",
      "english": "“Mendicants, these five wear rag robes. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Mandattā momūhattā paṁsukūliko hoti …pe… idamatthitaṁyeva nissāya paṁsukūliko hoti. ",
      "english": "One may wear rag robes because of stupidity … corrupt wishes … madness … because it is praised by the Buddhas … or for the sake of having few wishes … "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, pañca paṁsukūlikā”ti. ",
      "english": "These are the five who wear rag robes.” "
    },
    {
      "number": 8,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}