{
  "sutta_id": "DHP25",
  "verses": [
    {
      "number": 1,
      "pali": "Cūḷapanthakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Uṭṭhānenappamādena, ",
      "english": "By hard work and diligence, "
    },
    {
      "number": 3,
      "pali": "saṁyamena damena ca; ",
      "english": "by restraint and by self-control, "
    },
    {
      "number": 4,
      "pali": "Dīpaṁ kayirātha medhāvī, ",
      "english": "a smart person would build an island "
    },
    {
      "number": 5,
      "pali": "yaṁ ogho nābhikīrati. ",
      "english": "that the floods cannot overflow. "
    }
  ]
}