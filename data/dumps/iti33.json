{
  "sutta_id": "ITI33",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 33 ",
      "english": "So It Was Said 33 "
    },
    {
      "number": 2,
      "pali": "Dukanipāta ",
      "english": "The Book of the Twos "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Dutiyasīlasutta ",
      "english": "Ethics (2nd) "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Dvīhi, bhikkhave, dhammehi samannāgato puggalo yathābhataṁ nikkhitto evaṁ sagge. ",
      "english": "“Mendicants, an individual with two qualities is placed in heaven as if delivered there. "
    },
    {
      "number": 7,
      "pali": "Katamehi dvīhi? ",
      "english": "What two? "
    },
    {
      "number": 8,
      "pali": "Bhaddakena ca sīlena, bhaddikāya ca diṭṭhiyā. ",
      "english": "Excellent conduct and excellent view. "
    },
    {
      "number": 9,
      "pali": "Imehi kho, bhikkhave, dvīhi dhammehi samannāgato puggalo yathābhataṁ nikkhitto evaṁ sagge”ti. ",
      "english": "A individual with these two qualities is placed in heaven as if delivered there.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Bhaddakena ca sīlena, ",
      "english": "“If a person possesses "
    },
    {
      "number": 13,
      "pali": "bhaddikāya ca diṭṭhiyā; ",
      "english": "these two qualities—"
    },
    {
      "number": 14,
      "pali": "Etehi dvīhi dhammehi, ",
      "english": "excellent conduct "
    },
    {
      "number": 15,
      "pali": "yo samannāgato naro; ",
      "english": "and excellent views—"
    },
    {
      "number": 16,
      "pali": "Kāyassa bhedā sappañño, ",
      "english": "when their body breaks up, that wise person "
    },
    {
      "number": 17,
      "pali": "saggaṁ so upapajjatī”ti. ",
      "english": "is reborn in heaven.” "
    },
    {
      "number": 18,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 19,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}