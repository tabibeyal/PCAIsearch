{
  "sutta_id": "DHP329",
  "verses": [
    {
      "number": 1,
      "pali": "No ce labhetha nipakaṁ sahāyaṁ, ",
      "english": "If you find no alert companion, "
    },
    {
      "number": 2,
      "pali": "Saddhiṁ caraṁ sādhuvihāridhīraṁ; ",
      "english": "no attentive friend to live happily together, "
    },
    {
      "number": 3,
      "pali": "Rājāva raṭṭhaṁ vijitaṁ pahāya, ",
      "english": "then, like a king who flees his conquered realm, "
    },
    {
      "number": 4,
      "pali": "Eko care mātaṅgaraññeva nāgo. ",
      "english": "wander alone like a tusker in the wilds. "
    }
  ]
}