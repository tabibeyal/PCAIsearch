{
  "sutta_id": "DHP423",
  "verses": [
    {
      "number": 1,
      "pali": "Devahitabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pubbenivāsaṁ yo vedi, ",
      "english": "One who knows their past lives, "
    },
    {
      "number": 3,
      "pali": "saggāpāyañca passati; ",
      "english": "sees heaven and places of loss, "
    },
    {
      "number": 4,
      "pali": "Atho jātikkhayaṁ patto, ",
      "english": "and has attained the end of rebirth; "
    },
    {
      "number": 5,
      "pali": "abhiññāvosito muni; ",
      "english": "a sage of perfect insight "
    },
    {
      "number": 6,
      "pali": "Sabbavositavosānaṁ, ",
      "english": "at the summit of spiritual perfection: "
    },
    {
      "number": 7,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    },
    {
      "number": 8,
      "pali": "Brāhmaṇavaggo chabbīsatimo. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Ettāvatā sabbapaṭhame yamakavagge cuddasa vatthūni, appamādavagge nava, cittavagge nava, pupphavagge dvādasa, bālavagge pannarasa, paṇḍitavagge ekādasa, arahantavagge dasa, sahassavagge cuddasa, pāpavagge dvādasa, daṇḍavagge ekādasa, jarāvagge nava, attavagge dasa, lokavagge ekādasa, buddhavagge nava, sukhavagge aṭṭha, piyavagge nava, kodhavagge aṭṭha, malavagge dvādasa, dhammaṭṭhavagge dasa, maggavagge dvādasa, pakiṇṇakavagge nava, nirayavagge nava, nāgavagge aṭṭha, taṇhāvagge dvādasa, bhikkhuvagge dvādasa, brāhmaṇavagge cattālīsāti pañcādhikāni tīṇi vatthusatāni. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Satevīsacatussatā, ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "catusaccavibhāvinā; ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Satattayañca vatthūnaṁ, ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "pañcādhikaṁ samuṭṭhitāti. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Dhammapade vaggānamuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Yamakappamādo cittaṁ, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "pupphaṁ bālena paṇḍito; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Arahanto sahassañca, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "pāpaṁ daṇḍena te dasa. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Jarā attā ca loko ca, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "buddho sukhaṁ piyena ca; ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Kodho malañca dhammaṭṭho, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "maggavaggena vīsati. ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Pakiṇṇaṁ nirayo nāgo, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "taṇhā bhikkhu ca brāhmaṇo; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Ete chabbīsati vaggā, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "desitādiccabandhunā. ",
      "english": ""
    },
    {
      "number": 27,
      "pali": "Gāthānamuddānaṁ ",
      "english": ""
    },
    {
      "number": 28,
      "pali": "Yamake vīsati gāthā, ",
      "english": ""
    },
    {
      "number": 29,
      "pali": "appamādamhi dvādasa; ",
      "english": ""
    },
    {
      "number": 30,
      "pali": "Ekādasa cittavagge, ",
      "english": ""
    },
    {
      "number": 31,
      "pali": "pupphavaggamhi soḷasa. ",
      "english": ""
    },
    {
      "number": 32,
      "pali": "Bāle ca soḷasa gāthā, ",
      "english": ""
    },
    {
      "number": 33,
      "pali": "paṇḍitamhi catuddasa; ",
      "english": ""
    },
    {
      "number": 34,
      "pali": "Arahante dasa gāthā, ",
      "english": ""
    },
    {
      "number": 35,
      "pali": "sahasse honti soḷasa. ",
      "english": ""
    },
    {
      "number": 36,
      "pali": "Terasa pāpavaggamhi, ",
      "english": ""
    },
    {
      "number": 37,
      "pali": "daṇḍamhi dasa satta ca; ",
      "english": ""
    },
    {
      "number": 38,
      "pali": "Ekādasa jarā vagge, ",
      "english": ""
    },
    {
      "number": 39,
      "pali": "attavaggamhi tā dasa. ",
      "english": ""
    },
    {
      "number": 40,
      "pali": "Dvādasa lokavaggamhi, ",
      "english": ""
    },
    {
      "number": 41,
      "pali": "buddhavaggamhi ṭhārasa; ",
      "english": ""
    },
    {
      "number": 42,
      "pali": "Sukhe ca piyavagge ca, ",
      "english": ""
    },
    {
      "number": 43,
      "pali": "gāthāyo honti dvādasa. ",
      "english": ""
    },
    {
      "number": 44,
      "pali": "Cuddasa kodhavaggamhi, ",
      "english": ""
    },
    {
      "number": 45,
      "pali": "malavaggekavīsati; ",
      "english": ""
    },
    {
      "number": 46,
      "pali": "Sattarasa ca dhammaṭṭhe, ",
      "english": ""
    },
    {
      "number": 47,
      "pali": "maggavagge sattarasa. ",
      "english": ""
    },
    {
      "number": 48,
      "pali": "Pakiṇṇe soḷasa gāthā, ",
      "english": ""
    },
    {
      "number": 49,
      "pali": "niraye nāge ca cuddasa; ",
      "english": ""
    },
    {
      "number": 50,
      "pali": "Chabbīsa taṇhāvaggamhi, ",
      "english": ""
    },
    {
      "number": 51,
      "pali": "tevīsa bhikkhuvaggikā. ",
      "english": ""
    },
    {
      "number": 52,
      "pali": "Ekatālīsagāthāyo, ",
      "english": ""
    },
    {
      "number": 53,
      "pali": "brāhmaṇe vaggamuttame; ",
      "english": ""
    },
    {
      "number": 54,
      "pali": "Gāthāsatāni cattāri, ",
      "english": ""
    },
    {
      "number": 55,
      "pali": "tevīsa ca punāpare; ",
      "english": ""
    },
    {
      "number": 56,
      "pali": "Dhammapade nipātamhi, ",
      "english": ""
    },
    {
      "number": 57,
      "pali": "desitādiccabandhunāti. ",
      "english": ""
    },
    {
      "number": 58,
      "pali": "Dhammapadapāḷi samattā. ",
      "english": "The Sayings of the Dhamma are completed. "
    }
  ]
}