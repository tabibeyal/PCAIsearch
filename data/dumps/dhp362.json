{
  "sutta_id": "DHP362",
  "verses": [
    {
      "number": 1,
      "pali": "Haṁsaghātakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Hatthasaṁyato pādasaṁyato, ",
      "english": "One restrained in hand and foot, "
    },
    {
      "number": 3,
      "pali": "Vācāsaṁyato saṁyatuttamo; ",
      "english": "and in speech, the supreme restraint; "
    },
    {
      "number": 4,
      "pali": "Ajjhattarato samāhito, ",
      "english": "happy inside, serene, "
    },
    {
      "number": 5,
      "pali": "Eko santusito tamāhu bhikkhuṁ. ",
      "english": "solitary, content, I call a mendicant. "
    }
  ]
}