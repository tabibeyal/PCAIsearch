{
  "sutta_id": "DHP131",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulakumārakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sukhakāmāni bhūtāni, ",
      "english": "Creatures love happiness, "
    },
    {
      "number": 3,
      "pali": "yo daṇḍena vihiṁsati; ",
      "english": "so if you harm them with a stick "
    },
    {
      "number": 4,
      "pali": "Attano sukhamesāno, ",
      "english": "in search of your own happiness, "
    },
    {
      "number": 5,
      "pali": "pecca so na labhate sukhaṁ. ",
      "english": "after death you won’t find happiness. "
    }
  ]
}