{
  "sutta_id": "SN9.14",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 9.14",
      "english": "Linked Discourses 9.14"
    },
    {
      "number": 2,
      "pali": "Padumapuppha Sutta",
      "english": "The Thief of a Scent"
    },
    {
      "number": 3,
      "pali": "",
      "english": "I have heard that on one occasion a certain monk was staying among the Kosalans in a forest grove. Now at that time, after his meal, returning from his almsround, he went down to a lotus pond and sniffed a red lotus."
    },
    {
      "number": 4,
      "pali": "",
      "english": "Then the devatā inhabiting the forest grove, feeling sympathy for the monk, desiring his benefit, desiring to bring him to his senses, approached him and addressed him with this verse:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“You sniff this water-born flower"
    },
    {
      "number": 6,
      "pali": "",
      "english": "that hasn’t been given to you."
    },
    {
      "number": 7,
      "pali": "",
      "english": "This, dear sir, is a factor of stealing."
    },
    {
      "number": 8,
      "pali": "",
      "english": "You are a thief of a scent.”"
    },
    {
      "number": 9,
      "pali": "",
      "english": "The monk:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "“I don’t take, don’t damage."
    },
    {
      "number": 11,
      "pali": "",
      "english": "I sniff at the lotus"
    },
    {
      "number": 12,
      "pali": "",
      "english": "from far away."
    },
    {
      "number": 13,
      "pali": "",
      "english": "So why do you call me"
    },
    {
      "number": 14,
      "pali": "",
      "english": "a thief of a scent?"
    },
    {
      "number": 15,
      "pali": "",
      "english": "One who"
    },
    {
      "number": 16,
      "pali": "",
      "english": "digs up the stalks,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "damages flowers,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "one of such ruthless behavior:"
    },
    {
      "number": 19,
      "pali": "",
      "english": "why don’t you say it of him?”"
    },
    {
      "number": 20,
      "pali": "",
      "english": "The devatā:"
    },
    {
      "number": 21,
      "pali": "",
      "english": "“A person ruthless & grasping,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "smeared like a nursing diaper:"
    },
    {
      "number": 23,
      "pali": "",
      "english": "to him"
    },
    {
      "number": 24,
      "pali": "",
      "english": "I have nothing to say."
    },
    {
      "number": 25,
      "pali": "",
      "english": "It’s you"
    },
    {
      "number": 26,
      "pali": "",
      "english": "to whom I should speak."
    },
    {
      "number": 27,
      "pali": "",
      "english": "To a person unblemished,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "constantly searching for purity,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "a hair-tip’s worth of evil"
    },
    {
      "number": 30,
      "pali": "",
      "english": "seems as large"
    },
    {
      "number": 31,
      "pali": "",
      "english": "as a cloud.”"
    },
    {
      "number": 32,
      "pali": "",
      "english": "The monk:"
    },
    {
      "number": 33,
      "pali": "",
      "english": "“Yes, yakkha, you understand me"
    },
    {
      "number": 34,
      "pali": "",
      "english": "and show me sympathy."
    },
    {
      "number": 35,
      "pali": "",
      "english": "Warn me again, yakkha,"
    },
    {
      "number": 36,
      "pali": "",
      "english": "whenever again"
    },
    {
      "number": 37,
      "pali": "",
      "english": "you see something like this.”"
    },
    {
      "number": 38,
      "pali": "",
      "english": "The devatā:"
    },
    {
      "number": 39,
      "pali": "",
      "english": "“I don’t depend on you"
    },
    {
      "number": 40,
      "pali": "",
      "english": "for my living"
    },
    {
      "number": 41,
      "pali": "",
      "english": "nor am I"
    },
    {
      "number": 42,
      "pali": "",
      "english": "your hired hand."
    },
    {
      "number": 43,
      "pali": "",
      "english": "You, monk,"
    },
    {
      "number": 44,
      "pali": "",
      "english": "you yourself should know"
    },
    {
      "number": 45,
      "pali": "",
      "english": "how to go to the good destination.”"
    },
    {
      "number": 46,
      "pali": "",
      "english": "The monk, chastened by the devatā, came to his senses."
    }
  ]
}