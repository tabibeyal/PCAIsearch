{
  "sutta_id": "AN1.77",
  "verses": [
    {
      "number": 1,
      "pali": "77 ",
      "english": "77 "
    },
    {
      "number": 2,
      "pali": "“Appamattikā esā, bhikkhave, vuddhi yadidaṁ ñātivuddhi. ",
      "english": "“Growth of relatives, mendicants, is a small thing. "
    },
    {
      "number": 3,
      "pali": "Etadaggaṁ, bhikkhave, vuddhīnaṁ yadidaṁ paññāvuddhi. ",
      "english": "Wisdom is the best thing to grow. "
    },
    {
      "number": 4,
      "pali": "Tasmātiha, bhikkhave, evaṁ sikkhitabbaṁ: ",
      "english": "So you should train like this: "
    },
    {
      "number": 5,
      "pali": "‘paññāvuddhiyā vaddhissāmā’ti. ",
      "english": "‘We will grow in wisdom.’ "
    },
    {
      "number": 6,
      "pali": "Evañhi vo, bhikkhave, sikkhitabban”ti. ",
      "english": "That’s how you should train.” "
    },
    {
      "number": 7,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}