{
  "sutta_id": "AN4.132",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.132 ",
      "english": "Numbered Discourses 4.132 "
    },
    {
      "number": 2,
      "pali": "14. Puggalavagga ",
      "english": "14. Individuals "
    },
    {
      "number": 3,
      "pali": "Paṭibhānasutta ",
      "english": "Eloquence "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“Mendicants, these four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Yuttappaṭibhāno, no muttappaṭibhāno; ",
      "english": "One whose elocution is on topic, but not fluent. "
    },
    {
      "number": 7,
      "pali": "muttappaṭibhāno, no yuttappaṭibhāno; ",
      "english": "One whose elocution is fluent, but not on topic. "
    },
    {
      "number": 8,
      "pali": "yuttappaṭibhāno ca muttappaṭibhāno ca; ",
      "english": "One whose elocution is both on topic and fluent. "
    },
    {
      "number": 9,
      "pali": "neva yuttappaṭibhāno na muttappaṭibhāno—",
      "english": "One whose elocution is neither on topic nor fluent. "
    },
    {
      "number": 10,
      "pali": "ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasmin”ti. ",
      "english": "These are the four individuals found in the world.” "
    },
    {
      "number": 11,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}