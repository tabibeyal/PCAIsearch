      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yadā dvayesu dhammesu, ",
      "english": "When a brahmin has gone beyond "
    },
    {
      "number": 3,
      "pali": "pāragū hoti brāhmaṇo; ",
      "english": "dualistic phenomena, "
    },
    {
      "number": 4,
      "pali": "Athassa sabbe saṁyogā, ",
      "english": "then they consciously "
    },
    {
      "number": 5,
      "pali": "atthaṁ gacchanti jānato. ",
      "english": "make an end of all fetters. "
    }
  ]
