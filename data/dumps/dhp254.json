{
  "sutta_id": "DHP254",
  "verses": [
    {
      "number": 1,
      "pali": "Subhaddaparibbājakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ākāseva padaṁ natthi, ",
      "english": "In the atmosphere there is no track, "
    },
    {
      "number": 3,
      "pali": "samaṇo natthi bāhire; ",
      "english": "there’s no true ascetic outside here. "
    },
    {
      "number": 4,
      "pali": "Papañcābhiratā pajā, ",
      "english": "People enjoy proliferation, "
    },
    {
      "number": 5,
      "pali": "nippapañcā tathāgatā. ",
      "english": "the Realized Ones are free of proliferation. "
    }
  ]
}