{
  "sutta_id": "SN2.18",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.18 ",
      "english": "Linked Discourses 2.18 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Kakudhasutta ",
      "english": "With Kakudha "
    },
    {
      "number": 4,
      "pali": "Evaṁ me sutaṁ—",
      "english": "So I have heard. "
    },
    {
      "number": 5,
      "pali": "ekaṁ samayaṁ bhagavā sākete viharati añjanavane migadāye. ",
      "english": "At one time the Buddha was staying near Sāketa in the deer park at the Añjana Wood. "
    },
    {
      "number": 6,
      "pali": "Atha kho kakudho devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṁ añjanavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. Ekamantaṁ ṭhito kho kakudho devaputto bhagavantaṁ etadavoca: ",
      "english": "Then, late at night, the glorious godling Kakudha, lighting up the entire Añjana Wood, went up to the Buddha, bowed, stood to one side, and said to him, "
    },
    {
      "number": 7,
      "pali": "“nandasi, samaṇā”ti? ",
      "english": "“Do you delight, ascetic?” "
    },
    {
      "number": 8,
      "pali": "“Kiṁ laddhā, āvuso”ti? ",
      "english": "“What have I gained, sir?” "
    },
    {
      "number": 9,
      "pali": "“Tena hi, samaṇa, socasī”ti? ",
      "english": "“Well then, ascetic, do you sorrow?” "
    },
    {
      "number": 10,
      "pali": "“Kiṁ jīyittha, āvuso”ti? ",
      "english": "“What have I lost, sir?” "
    },
    {
      "number": 11,
      "pali": "“Tena hi, samaṇa, neva nandasi na ca socasī”ti? ",
      "english": "“Well then, ascetic, do you neither delight nor sorrow?” "
    },
    {
      "number": 12,
      "pali": "“Evamāvuso”ti. ",
      "english": "“Yes, sir.” "
    },
    {
      "number": 13,
      "pali": "“Kacci tvaṁ anagho bhikkhu, ",
      "english": "“I hope you’re not gloomy, mendicant, "
    },
    {
      "number": 14,
      "pali": "kacci nandī na vijjati; ",
      "english": "I hope that delight isn’t found in you. "
    },
    {
      "number": 15,
      "pali": "Kacci taṁ ekamāsīnaṁ, ",
      "english": "I hope that discontent doesn’t "
    },
    {
      "number": 16,
      "pali": "aratī nābhikīratī”ti. ",
      "english": "overwhelm you as you sit alone.” "
    },
    {
      "number": 17,
      "pali": "“Anagho ve ahaṁ yakkha, ",
      "english": "“I’m genuinely not gloomy, spirit, "
    },
    {
      "number": 18,
      "pali": "atho nandī na vijjati; ",
      "english": "and no delight is found in me. "
    },
    {
      "number": 19,
      "pali": "Atho maṁ ekamāsīnaṁ, ",
      "english": "And also discontent doesn’t "
    },
    {
      "number": 20,
      "pali": "aratī nābhikīratī”ti. ",
      "english": "overwhelm me as I sit alone.” "
    },
    {
      "number": 21,
      "pali": "“Kathaṁ tvaṁ anagho bhikkhu, ",
      "english": "“How are you not gloomy, mendicant? "
    },
    {
      "number": 22,
      "pali": "kathaṁ nandī na vijjati; ",
      "english": "How is delight not found in you? "
    },
    {
      "number": 23,
      "pali": "Kathaṁ taṁ ekamāsīnaṁ, ",
      "english": "How does discontent not "
    },
    {
      "number": 24,
      "pali": "aratī nābhikīratī”ti. ",
      "english": "overwhelm you as you sit alone?” "
    },
    {
      "number": 25,
      "pali": "“Aghajātassa ve nandī, ",
      "english": "“Delight is born from gloom, "
    },
    {
      "number": 26,
      "pali": "nandījātassa ve aghaṁ; ",
      "english": "gloom is born from delight; "
    },
    {
      "number": 27,
      "pali": "Anandī anagho bhikkhu, ",
      "english": "sir, you should know me as "
    },
    {
      "number": 28,
      "pali": "evaṁ jānāhi āvuso”ti. ",
      "english": "a mendicant free of delight and gloom.” "
    },
    {
      "number": 29,
      "pali": "“Cirassaṁ vata passāmi, ",
      "english": "“After a long time I see "
    },
    {
      "number": 30,
      "pali": "brāhmaṇaṁ parinibbutaṁ; ",
      "english": "a brahmin fully quenched. "
    },
    {
      "number": 31,
      "pali": "Anandiṁ anaghaṁ bhikkhuṁ, ",
      "english": "A mendicant free of delight and gloom, "
    },
    {
      "number": 32,
      "pali": "tiṇṇaṁ loke visattikan”ti. ",
      "english": "he has crossed over clinging to the world.” "
    }
  ]
}