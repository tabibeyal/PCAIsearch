    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Taṇhāsutta ",
      "english": "Craving "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "rūpataṇhā niccā vā aniccā vā”ti? ",
      "english": "Is craving for sights permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“saddataṇhā …pe… ",
      "english": "“… craving for sounds … "
    },
    {
      "number": 9,
      "pali": "gandhataṇhā … ",
      "english": "craving for smells … "
    },
    {
      "number": 10,
      "pali": "rasataṇhā … ",
      "english": "craving for tastes … "
    },
    {
      "number": 11,
      "pali": "phoṭṭhabbataṇhā … ",
      "english": "craving for touches … "
    },
    {
      "number": 12,
      "pali": "dhammataṇhā niccā vā aniccā vā”ti? ",
      "english": "Is craving for ideas permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako rūpataṇhāyapi nibbindati …pe… saddataṇhāyapi nibbindati … gandhataṇhāyapi nibbindati … rasataṇhāyapi nibbindati … phoṭṭhabbataṇhāyapi nibbindati … dhammataṇhāyapi nibbindati …pe… ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with craving for sights, sounds, smells, tastes, touches, and ideas. …” "
    },
    {
      "number": 15,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
