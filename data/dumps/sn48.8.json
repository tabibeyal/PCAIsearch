{
  "sutta_id": "SN48.8",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 48.8 ",
      "english": "Linked Discourses 48.8 "
    },
    {
      "number": 2,
      "pali": "1. Suddhikavagga ",
      "english": "1. Plain Version "
    },
    {
      "number": 3,
      "pali": "Daṭṭhabbasutta ",
      "english": "Should Be Seen "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these five faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhindriyaṁ …pe… paññindriyaṁ. ",
      "english": "The faculties of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Kattha ca, bhikkhave, saddhindriyaṁ daṭṭhabbaṁ? ",
      "english": "And where should the faculty of faith be seen? "
    },
    {
      "number": 8,
      "pali": "Catūsu sotāpattiyaṅgesu—",
      "english": "In the four factors of stream-entry. "
    },
    {
      "number": 9,
      "pali": "ettha saddhindriyaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Kattha ca, bhikkhave, vīriyindriyaṁ daṭṭhabbaṁ? ",
      "english": "And where should the faculty of energy be seen? "
    },
    {
      "number": 11,
      "pali": "Catūsu sammappadhānesu—",
      "english": "In the four right efforts. "
    },
    {
      "number": 12,
      "pali": "ettha vīriyindriyaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Kattha ca, bhikkhave, satindriyaṁ daṭṭhabbaṁ? ",
      "english": "And where should the faculty of mindfulness be seen? "
    },
    {
      "number": 14,
      "pali": "Catūsu satipaṭṭhānesu—",
      "english": "In the four kinds of mindfulness meditation. "
    },
    {
      "number": 15,
      "pali": "ettha satindriyaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Kattha ca, bhikkhave, samādhindriyaṁ daṭṭhabbaṁ? ",
      "english": "And where should the faculty of immersion be seen? "
    },
    {
      "number": 17,
      "pali": "Catūsu jhānesu—",
      "english": "In the four absorptions. "
    },
    {
      "number": 18,
      "pali": "ettha samādhindriyaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Kattha ca, bhikkhave, paññindriyaṁ daṭṭhabbaṁ? ",
      "english": "And where should the faculty of wisdom be seen? "
    },
    {
      "number": 20,
      "pali": "Catūsu ariyasaccesu—",
      "english": "In the four noble truths. "
    },
    {
      "number": 21,
      "pali": "ettha paññindriyaṁ daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Imāni kho, bhikkhave, pañcindriyānī”ti. ",
      "english": "These are the five faculties.” "
    },
    {
      "number": 23,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}