  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 18.10 ",
      "english": "Linked Discourses 18.10 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Khandhasutta ",
      "english": "The Aggregates "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "rūpaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "Is form permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccaṁ, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“vedanā …pe… ",
      "english": "“… feeling … "
    },
    {
      "number": 9,
      "pali": "saññā … ",
      "english": "perception … "
    },
    {
      "number": 10,
      "pali": "saṅkhārā … ",
      "english": "choices … "
    },
    {
      "number": 11,
      "pali": "viññāṇaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "Is consciousness permanent or impermanent?” "
    },
    {
      "number": 12,
      "pali": "“Aniccaṁ, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 13,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako rūpasmimpi nibbindati …pe… vedanāyapi nibbindati … saññāyapi nibbindati … saṅkhāresupi nibbindati … viññāṇasmimpi nibbindati; ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with form, feeling, perception, choices, and consciousness. "
    },
    {
      "number": 14,
      "pali": "nibbindaṁ virajjati; virāgā vimuccati; vimuttasmiṁ vimuttamiti ñāṇaṁ hoti. ",
      "english": "Being disillusioned, desire fades away. When desire fades away they’re freed. When they’re freed, they know they’re freed. "
    },
    {
      "number": 15,
      "pali": "‘Khīṇā jāti, vusitaṁ brahmacariyaṁ, kataṁ karaṇīyaṁ, nāparaṁ itthattāyā’ti pajānātī”ti. ",
      "english": "They understand: ‘Rebirth is ended, the spiritual journey has been completed, what had to be done has been done, there is nothing further for this place.’” "
    },
    {
      "number": 16,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Paṭhamo vaggo. ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Cakkhu rūpañca viññāṇaṁ, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "samphasso vedanāya ca; ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Saññā sañcetanā taṇhā, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "dhātu khandhena te dasāti. ",
      "english": ""
    }
  ]
}