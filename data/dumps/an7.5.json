{
  "sutta_id": "AN7.5",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.5 ",
      "english": "Numbered Discourses 7.5 "
    },
    {
      "number": 2,
      "pali": "1. Dhanavagga ",
      "english": "1. Wealth "
    },
    {
      "number": 3,
      "pali": "Saṅkhittadhanasutta ",
      "english": "Wealth in Brief "
    },
    {
      "number": 4,
      "pali": "“Sattimāni, bhikkhave, dhanāni. ",
      "english": "“Mendicants, there are these seven kinds of wealth. "
    },
    {
      "number": 5,
      "pali": "Katamāni satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Saddhādhanaṁ, sīladhanaṁ, hirīdhanaṁ, ottappadhanaṁ, sutadhanaṁ, cāgadhanaṁ, paññādhanaṁ. ",
      "english": "The wealth of faith, ethics, conscience, prudence, learning, generosity, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, satta dhanānīti. ",
      "english": "These are the seven kinds of wealth. "
    },
    {
      "number": 8,
      "pali": "Saddhādhanaṁ sīladhanaṁ, ",
      "english": "Faith and ethical conduct are kinds of wealth, "
    },
    {
      "number": 9,
      "pali": "hirī ottappiyaṁ dhanaṁ; ",
      "english": "as are conscience and prudence, "
    },
    {
      "number": 10,
      "pali": "Sutadhanañca cāgo ca, ",
      "english": "learning and generosity, "
    },
    {
      "number": 11,
      "pali": "paññā ve sattamaṁ dhanaṁ. ",
      "english": "and wisdom is the seventh kind of wealth. "
    },
    {
      "number": 12,
      "pali": "Yassa ete dhanā atthi, ",
      "english": "When a woman or man "
    },
    {
      "number": 13,
      "pali": "itthiyā purisassa vā; ",
      "english": "has these kinds of wealth, "
    },
    {
      "number": 14,
      "pali": "Adaliddoti taṁ āhu, ",
      "english": "they’re said to be prosperous, "
    },
    {
      "number": 15,
      "pali": "amoghaṁ tassa jīvitaṁ. ",
      "english": "their life is not in vain. "
    },
    {
      "number": 16,
      "pali": "Tasmā saddhañca sīlañca, ",
      "english": "So let the wise devote themselves "
    },
    {
      "number": 17,
      "pali": "Pasādaṁ dhammadassanaṁ; ",
      "english": "to faith, ethical behavior, "
    },
    {
      "number": 18,
      "pali": "Anuyuñjetha medhāvī, ",
      "english": "confidence, and insight into the teaching, "
    },
    {
      "number": 19,
      "pali": "Saraṁ buddhāna sāsanan”ti. ",
      "english": "remembering the instructions of the Buddhas.” "
    },
    {
      "number": 20,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}