{
  "sutta_id": "DHP318",
  "verses": [
    {
      "number": 1,
      "pali": "Titthiyasāvakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Avajje vajjamatino, ",
      "english": "Seeing fault where there is none, "
    },
    {
      "number": 3,
      "pali": "vajje cāvajjadassino; ",
      "english": "and blind to the actual fault, "
    },
    {
      "number": 4,
      "pali": "Micchādiṭṭhisamādānā, ",
      "english": "beings who uphold wrong view "
    },
    {
      "number": 5,
      "pali": "sattā gacchanti duggatiṁ. ",
      "english": "go to a bad place. "
    }
  ]
}