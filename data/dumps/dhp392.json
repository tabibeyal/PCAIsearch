{
  "sutta_id": "DHP392",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yamhā dhammaṁ vijāneyya, ",
      "english": "You should graciously honor "
    },
    {
      "number": 3,
      "pali": "sammāsambuddhadesitaṁ; ",
      "english": "the one from whom you learn the Dhamma "
    },
    {
      "number": 4,
      "pali": "Sakkaccaṁ taṁ namasseyya, ",
      "english": "taught by the awakened Buddha, "
    },
    {
      "number": 5,
      "pali": "aggihuttaṁva brāhmaṇo. ",
      "english": "as a brahmin honors the sacred flame. "
    }
  ]
}