{
  "sutta_id": "SN1.16",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.16 ",
      "english": "Linked Discourses 1.16 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Niddātandīsutta ",
      "english": "Sleepiness and Sloth "
    },
    {
      "number": 4,
      "pali": "“Niddā tandī vijambhitā, ",
      "english": "“Sleepiness, sloth, and yawning, "
    },
    {
      "number": 5,
      "pali": "Aratī bhattasammado; ",
      "english": "discontent, and grogginess after eating: "
    },
    {
      "number": 6,
      "pali": "Etena nappakāsati, ",
      "english": "because of this the noble path "
    },
    {
      "number": 7,
      "pali": "Ariyamaggo idha pāṇinan”ti. ",
      "english": "doesn’t shine for creatures here.” "
    },
    {
      "number": 8,
      "pali": "“Niddaṁ tandiṁ vijambhitaṁ, ",
      "english": "“Sleepiness, sloth, and yawning, "
    },
    {
      "number": 9,
      "pali": "Aratiṁ bhattasammadaṁ; ",
      "english": "discontent, and grogginess after eating: "
    },
    {
      "number": 10,
      "pali": "Vīriyena naṁ paṇāmetvā, ",
      "english": "when this is energetically fended off, "
    },
    {
      "number": 11,
      "pali": "Ariyamaggo visujjhatī”ti. ",
      "english": "the noble path is purified.” "
    }
  ]
}