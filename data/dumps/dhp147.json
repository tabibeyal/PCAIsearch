{
  "sutta_id": "DHP147",
  "verses": [
    {
      "number": 1,
      "pali": "Sirimāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Passa cittakataṁ bimbaṁ, ",
      "english": "See this fancy puppet, "
    },
    {
      "number": 3,
      "pali": "arukāyaṁ samussitaṁ; ",
      "english": "a body built of sores, "
    },
    {
      "number": 4,
      "pali": "Āturaṁ bahusaṅkappaṁ, ",
      "english": "diseased, obsessed over, "
    },
    {
      "number": 5,
      "pali": "yassa natthi dhuvaṁ ṭhiti. ",
      "english": "in which nothing lasts at all. "
    }
  ]
}