{
  "sutta_id": "SN1.53",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.53 ",
      "english": "Linked Discourses 1.53 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Mittasutta ",
      "english": "A Friend "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu pavasato mittaṁ, ",
      "english": "“Who’s your friend while journeying? "
    },
    {
      "number": 5,
      "pali": "kiṁsu mittaṁ sake ghare; ",
      "english": "Who’s your friend at home? "
    },
    {
      "number": 6,
      "pali": "Kiṁ mittaṁ atthajātassa, ",
      "english": "Who’s your friend in need? "
    },
    {
      "number": 7,
      "pali": "kiṁ mittaṁ samparāyikan”ti. ",
      "english": "Who’s your friend in the next life?” "
    },
    {
      "number": 8,
      "pali": "“Sattho pavasato mittaṁ, ",
      "english": "“A caravan is your friend while journeying. "
    },
    {
      "number": 9,
      "pali": "mātā mittaṁ sake ghare; ",
      "english": "Mother is your friend at home. "
    },
    {
      "number": 10,
      "pali": "Sahāyo atthajātassa, ",
      "english": "An ally in a time of need "
    },
    {
      "number": 11,
      "pali": "hoti mittaṁ punappunaṁ; ",
      "english": "is a friend time and again. "
    },
    {
      "number": 12,
      "pali": "Sayaṅkatāni puññāni, ",
      "english": "But the good deeds you’ve done yourself—"
    },
    {
      "number": 13,
      "pali": "taṁ mittaṁ samparāyikan”ti. ",
      "english": "that’s your friend in the next life.” "
    }
  ]
}