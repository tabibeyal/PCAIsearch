{
  "sutta_id": "SN22.23",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.23 ",
      "english": "Linked Discourses 22.23 "
    },
    {
      "number": 2,
      "pali": "3. Bhāravagga ",
      "english": "3. The Burden "
    },
    {
      "number": 3,
      "pali": "Pariññasutta ",
      "english": "Complete Understanding "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Pariññeyye ca, bhikkhave, dhamme desessāmi pariññañca. ",
      "english": "“Mendicants, I will teach you the things that should be completely understood, and complete understanding. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katame ca, bhikkhave, pariññeyyā dhammā? ",
      "english": "And what things should be completely understood? "
    },
    {
      "number": 8,
      "pali": "Rūpaṁ, bhikkhave, pariññeyyo dhammo, vedanā pariññeyyo dhammo, saññā pariññeyyo dhammo, saṅkhārā pariññeyyo dhammo, viññāṇaṁ pariññeyyo dhammo. ",
      "english": "Form, feeling, perception, choices, and consciousness. "
    },
    {
      "number": 9,
      "pali": "Ime vuccanti, bhikkhave, pariññeyyā dhammā. ",
      "english": "These are called the things that should be completely understood. "
    },
    {
      "number": 10,
      "pali": "Katamā ca, bhikkhave, pariññā? ",
      "english": "And what is complete understanding? "
    },
    {
      "number": 11,
      "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo. ",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 12,
      "pali": "Ayaṁ vuccati, bhikkhave, pariññā”ti. ",
      "english": "This is called complete understanding.” "
    },
    {
      "number": 13,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}