{
  "sutta_id": "DHP46",
  "verses": [
    {
      "number": 1,
      "pali": "Marīcikammaṭṭhānikabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pheṇūpamaṁ kāyamimaṁ viditvā, ",
      "english": "Knowing this body’s like foam, "
    },
    {
      "number": 3,
      "pali": "Marīcidhammaṁ abhisambudhāno; ",
      "english": "realizing it’s all just a mirage, "
    },
    {
      "number": 4,
      "pali": "Chetvāna mārassa papupphakāni, ",
      "english": "and cutting off Māra’s blossoming, "
    },
    {
      "number": 5,
      "pali": "Adassanaṁ maccurājassa gacche. ",
      "english": "vanish from the King of Death. "
    }
  ]
}