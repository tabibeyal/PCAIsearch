  "sutta_id": "SN22.159",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.159 ",
      "english": "Linked Discourses 22.159 "
    },
    {
      "number": 2,
      "pali": "15. Diṭṭhivagga ",
      "english": "15. Views "
    },
    {
      "number": 3,
      "pali": "Ānandasutta ",
      "english": "With Ānanda "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Atha kho āyasmā ānando yena bhagavā tenupasaṅkami; upasaṅkamitvā …pe… bhagavantaṁ etadavoca: ",
      "english": "Then Venerable Ānanda went up to the Buddha, bowed, sat down to one side, and said to him: "
    },
    {
      "number": 6,
      "pali": "“sādhu me, bhante, bhagavā saṅkhittena dhammaṁ desetu, yamahaṁ bhagavato dhammaṁ sutvā eko vūpakaṭṭho appamatto ātāpī pahitatto vihareyyan”ti. ",
      "english": "“Sir, may the Buddha please teach me Dhamma in brief. When I’ve heard it, I’ll live alone, withdrawn, diligent, keen, and resolute.” "
    },
    {
      "number": 7,
      "pali": "“Taṁ kiṁ maññasi, ānanda, ",
      "english": "“What do you think, Ānanda? "
    },
    {
      "number": 8,
      "pali": "rūpaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "Is form permanent or impermanent?” "
    },
    {
      "number": 9,
      "pali": "“Aniccaṁ, bhante”. ",
      "english": "“Impermanent, sir.” "
    },
    {
      "number": 10,
      "pali": "“Yaṁ panāniccaṁ dukkhaṁ vā taṁ sukhaṁ vā”ti? ",
      "english": "“But if it’s impermanent, is it suffering or happiness?” "
    },
    {
      "number": 11,
      "pali": "“Dukkhaṁ, bhante”. ",
      "english": "“Suffering, sir.” "
    },
    {
      "number": 12,
      "pali": "“Yaṁ panāniccaṁ dukkhaṁ vipariṇāmadhammaṁ, kallaṁ nu taṁ samanupassituṁ: ",
      "english": "“But if it’s impermanent, suffering, and perishable, is it fit to be regarded thus: "
    },
    {
      "number": 13,
      "pali": "‘etaṁ mama, esohamasmi, eso me attā’”ti? ",
      "english": "‘This is mine, I am this, this is my self’?” "
    },
    {
      "number": 14,
      "pali": "“No hetaṁ, bhante”. ",
      "english": "“No, sir.” "
    },
    {
      "number": 15,
      "pali": "“Vedanā … ",
      "english": "“Is feeling … "
    },
    {
      "number": 16,
      "pali": "saññā … ",
      "english": "perception … "
    },
    {
      "number": 17,
      "pali": "saṅkhārā … ",
      "english": "choices … "
    },
    {
      "number": 18,
      "pali": "viññāṇaṁ niccaṁ vā aniccaṁ vā”ti? ",
      "english": "consciousness permanent or impermanent?” "
    },
    {
      "number": 19,
      "pali": "“Aniccaṁ, bhante”. ",
      "english": "“Impermanent, sir.” "
    },
    {
      "number": 20,
      "pali": "“Yaṁ panāniccaṁ dukkhaṁ vā taṁ sukhaṁ vā”ti? ",
      "english": "“But if it’s impermanent, is it suffering or happiness?” "
    },
    {
      "number": 21,
      "pali": "“Dukkhaṁ, bhante”. ",
      "english": "“Suffering, sir.” "
    },
    {
      "number": 22,
      "pali": "“Yaṁ panāniccaṁ dukkhaṁ vipariṇāmadhammaṁ, kallaṁ nu taṁ samanupassituṁ: ",
      "english": "“But if it’s impermanent, suffering, and perishable, is it fit to be regarded thus: "
    },
    {
      "number": 23,
      "pali": "‘etaṁ mama, esohamasmi, eso me attā’”ti? ",
      "english": "‘This is mine, I am this, this is my self’?” "
    },
    {
      "number": 24,
      "pali": "“No hetaṁ, bhante”. ",
      "english": "“No, sir.” … "
    },
    {
      "number": 25,
      "pali": "“Evaṁ passaṁ …pe… ",
      "english": "“Seeing this … "
    },
    {
      "number": 26,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 27,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 28,
      "pali": "Diṭṭhivaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 29,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 30,
      "pali": "Ajjhattikaṁ etaṁmama, ",
      "english": ""
    },
    {
      "number": 31,
      "pali": "Soattā nocamesiyā; ",
      "english": ""
    },
    {
      "number": 32,
      "pali": "Micchāsakkāyattānu dve, ",
      "english": ""
    },
    {
      "number": 33,
      "pali": "Abhinivesā ānandenāti. ",
      "english": ""
    },
    {
      "number": 34,
      "pali": "Uparipaṇṇāsako samatto. ",
      "english": ""
    },
    {
      "number": 35,
      "pali": "Tassa uparipaṇṇāsakassa vagguddānaṁ ",
      "english": ""
    },
    {
      "number": 36,
      "pali": "Anto dhammakathikā vijjā, ",
      "english": ""
    },
    {
      "number": 37,
      "pali": "kukkuḷaṁ diṭṭhipañcamaṁ; ",
      "english": ""
    },
    {
      "number": 38,
      "pali": "Tatiyo paṇṇāsako vutto, ",
      "english": ""
    },
    {
      "number": 39,
      "pali": "nipātoti pavuccatīti. ",
      "english": ""
    },
    {
      "number": 40,
      "pali": "Khandhasaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses on the aggregates are complete. "
    }
