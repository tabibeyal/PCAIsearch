{
  "sutta_id": "DHP260",
  "verses": [
    {
      "number": 1,
      "pali": "Lakuṇḍakabhaddiyattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na tena thero so hoti, ",
      "english": "You don’t become a senior "
    },
    {
      "number": 3,
      "pali": "yenassa palitaṁ siro; ",
      "english": "by getting some grey hairs; "
    },
    {
      "number": 4,
      "pali": "Paripakko vayo tassa, ",
      "english": "for one ripe only in age, "
    },
    {
      "number": 5,
      "pali": "“moghajiṇṇo”ti vuccati. ",
      "english": "is said to have aged in vain. "
    }
  ]
}