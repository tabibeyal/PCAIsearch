{
  "sutta_id": "AN4.17",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.17 ",
      "english": "Numbered Discourses 4.17 "
    },
    {
      "number": 2,
      "pali": "2. Caravagga ",
      "english": "2. Walking "
    },
    {
      "number": 3,
      "pali": "Paṭhamaagatisutta ",
      "english": "Prejudice (1st) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, agatigamanāni. ",
      "english": "“Mendicants, there are these four ways of making prejudiced decisions. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Chandāgatiṁ gacchati, dosāgatiṁ gacchati, mohāgatiṁ gacchati, bhayāgatiṁ gacchati—",
      "english": "Making decisions prejudiced by favoritism, hostility, stupidity, and cowardice. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri agatigamanānīti. ",
      "english": "These are the four ways of making prejudiced decisions. "
    },
    {
      "number": 8,
      "pali": "Chandā dosā bhayā mohā, ",
      "english": "If you act against the teaching "
    },
    {
      "number": 9,
      "pali": "yo dhammaṁ ativattati; ",
      "english": "out of favoritism, hostility, cowardice, or stupidity, "
    },
    {
      "number": 10,
      "pali": "Nihīyati tassa yaso, ",
      "english": "your fame fades away, "
    },
    {
      "number": 11,
      "pali": "kāḷapakkheva candimā”ti. ",
      "english": "like the moon in the waning fortnight.” "
    },
    {
      "number": 12,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}