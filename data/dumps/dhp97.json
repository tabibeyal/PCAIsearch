{
  "sutta_id": "DHP97",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Assaddho akataññū ca, ",
      "english": "Lacking faith, a house-breaker, "
    },
    {
      "number": 3,
      "pali": "sandhicchedo ca yo naro; ",
      "english": "one who acknowledges nothing, "
    },
    {
      "number": 4,
      "pali": "Hatāvakāso vantāso, ",
      "english": "purged of hope, they’ve wasted their chance: "
    },
    {
      "number": 5,
      "pali": "sa ve uttamaporiso. ",
      "english": "that is indeed the supreme person! "
    }
  ]
}