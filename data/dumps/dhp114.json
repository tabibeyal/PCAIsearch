{
  "sutta_id": "DHP114",
  "verses": [
    {
      "number": 1,
      "pali": "Kisāgotamīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca vassasataṁ jīve, ",
      "english": "Better to live a single day "
    },
    {
      "number": 3,
      "pali": "apassaṁ amataṁ padaṁ; ",
      "english": "seeing the state free of death "
    },
    {
      "number": 4,
      "pali": "Ekāhaṁ jīvitaṁ seyyo, ",
      "english": "than to live a hundred years "
    },
    {
      "number": 5,
      "pali": "passato amataṁ padaṁ. ",
      "english": "blind to the state free of death. "
    }
  ]
}