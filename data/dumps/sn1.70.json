{
  "sutta_id": "SN1.70",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.70 ",
      "english": "Linked Discourses 1.70 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Lokasutta ",
      "english": "The World "
    },
    {
      "number": 4,
      "pali": "“Kismiṁ loko samuppanno, ",
      "english": "“In what has the world arisen? "
    },
    {
      "number": 5,
      "pali": "kismiṁ kubbati santhavaṁ; ",
      "english": "With what does it get intimate? "
    },
    {
      "number": 6,
      "pali": "Kissa loko upādāya, ",
      "english": "By grasping what "
    },
    {
      "number": 7,
      "pali": "kismiṁ loko vihaññatī”ti. ",
      "english": "is the world troubled in what?” "
    },
    {
      "number": 8,
      "pali": "“Chasu loko samuppanno, ",
      "english": "“The world has arisen in six. "
    },
    {
      "number": 9,
      "pali": "chasu kubbati santhavaṁ; ",
      "english": "It gets intimate with six. "
    },
    {
      "number": 10,
      "pali": "Channameva upādāya, ",
      "english": "Derived from the six, "
    },
    {
      "number": 11,
      "pali": "chasu loko vihaññatī”ti. ",
      "english": "the world’s troubled in six.” "
    },
    {
      "number": 12,
      "pali": "Addhavaggo sattamo. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Nāmaṁ cittañca taṇhā ca, ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "saṁyojanañca bandhanā; ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Abbhāhatuḍḍito pihito, ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "icchā lokena te dasāti. ",
      "english": ""
    }
  ]
}