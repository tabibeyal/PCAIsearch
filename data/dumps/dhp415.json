{
  "sutta_id": "DHP415",
  "verses": [
    {
      "number": 1,
      "pali": "Sundarasamuddattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yodha kāme pahantvāna, ",
      "english": "They’ve given up sensual stimulations, "
    },
    {
      "number": 3,
      "pali": "anāgāro paribbaje; ",
      "english": "and have gone forth from lay life; "
    },
    {
      "number": 4,
      "pali": "Kāmabhavaparikkhīṇaṁ, ",
      "english": "they’ve ended rebirth in the sensual realm: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}