  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.149 ",
      "english": "Numbered Discourses 4.149 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Sucaritasutta ",
      "english": "Good Conduct "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, vacīsucaritāni. ",
      "english": "“Mendicants, there are these four kinds of good conduct by way of speech. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Saccavācā, apisuṇā vācā, saṇhā vācā, mantabhāsā—",
      "english": "Speech that’s true, harmonious, gentle, and thoughtful. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri vacīsucaritānī”ti. ",
      "english": "These are the four kinds of good conduct by way of speech.” "
    },
    {
      "number": 8,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}