  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.168 ",
      "english": "Linked Discourses 45.168 "
    },
    {
      "number": 2,
      "pali": "13. Esanāvagga ",
      "english": "13. Searches "
    },
    {
      "number": 3,
      "pali": "Nīghasutta ",
      "english": "Troubles "
    },
    {
      "number": 4,
      "pali": "“Tayome, bhikkhave, nīghā. ",
      "english": "“Mendicants, there are these three troubles. "
    },
    {
      "number": 5,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Rāgo nīgho, doso nīgho, moho nīgho—",
      "english": "Greed, hate, and delusion. "
    },
    {
      "number": 7,
      "pali": "ime kho, bhikkhave, tayo nīghā. ",
      "english": "These are the three troubles. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, tiṇṇannaṁ nīghānaṁ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṁ ariyo aṭṭhaṅgiko maggo bhāvetabbo”ti. ",
      "english": "The noble eightfold path should be developed for the direct knowledge, complete understanding, finishing, and giving up of these three troubles.” "
    },
    {
      "number": 9,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}