{
  "sutta_id": "AN10.138",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.138 ",
      "english": "Numbered Discourses 10.138 "
    },
    {
      "number": 2,
      "pali": "14. Sādhuvagga ",
      "english": "14. Good "
    },
    {
      "number": 3,
      "pali": "Dhammasutta ",
      "english": "The Teaching "
    },
    {
      "number": 4,
      "pali": "“Dhammañca vo, bhikkhave, desessāmi adhammañca. ",
      "english": "“I will teach you what is the teaching and what is not the teaching. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, adhammo? ",
      "english": "And what is not the teaching? "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhi …pe… micchāvimutti—",
      "english": "Wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, wrong immersion, wrong knowledge, and wrong freedom. "
    },
    {
      "number": 8,
      "pali": "ayaṁ vuccati, bhikkhave, adhammo. ",
      "english": "This is called what is not the teaching. "
    },
    {
      "number": 9,
      "pali": "Katamo ca, bhikkhave, dhammo? ",
      "english": "And what is the teaching? "
    },
    {
      "number": 10,
      "pali": "Sammādiṭṭhi …pe… sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 11,
      "pali": "ayaṁ vuccati, bhikkhave, dhammo”ti. ",
      "english": "This is called the teaching.” "
    },
    {
      "number": 12,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}