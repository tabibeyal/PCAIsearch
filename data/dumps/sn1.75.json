{
  "sutta_id": "SN1.75",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.75 ",
      "english": "Linked Discourses 1.75 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Bhītāsutta ",
      "english": "Afraid "
    },
    {
      "number": 4,
      "pali": "“Kiṁsūdha bhītā janatā anekā, ",
      "english": "“Why are so many people here afraid, "
    },
    {
      "number": 5,
      "pali": "Maggo canekāyatanappavutto; ",
      "english": "when the path has been taught <j>with so many dimensions? "
    },
    {
      "number": 6,
      "pali": "Pucchāmi taṁ gotama bhūripañña, ",
      "english": "I ask you, Gotama, whose wisdom is vast: "
    },
    {
      "number": 7,
      "pali": "Kismiṁ ṭhito paralokaṁ na bhāye”ti. ",
      "english": "Standing on what need one not fear the next world?” "
    },
    {
      "number": 8,
      "pali": "“Vācaṁ manañca paṇidhāya sammā, ",
      "english": "“When speech and mind are directed right, "
    },
    {
      "number": 9,
      "pali": "Kāyena pāpāni akubbamāno; ",
      "english": "and you don’t do anything bad with the body "
    },
    {
      "number": 10,
      "pali": "Bahvannapānaṁ gharamāvasanto, ",
      "english": "while dwelling at home with plenty of food and drink. "
    },
    {
      "number": 11,
      "pali": "Saddho mudū saṁvibhāgī vadaññū; ",
      "english": "Faithful, gentle, charitable, and bountiful: "
    },
    {
      "number": 12,
      "pali": "Etesu dhammesu ṭhito catūsu, ",
      "english": "one who stands on these four principles, "
    },
    {
      "number": 13,
      "pali": "Dhamme ṭhito paralokaṁ na bhāye”ti. ",
      "english": "who stands on the teaching <j>need not fear the next world.” "
    }
  ]
}