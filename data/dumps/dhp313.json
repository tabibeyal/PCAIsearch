{
  "sutta_id": "DHP313",
  "verses": [
    {
      "number": 1,
      "pali": "Kayirā ce kayirāthenaṁ, ",
      "english": "If one is to do what should be done, "
    },
    {
      "number": 2,
      "pali": "daḷhamenaṁ parakkame; ",
      "english": "one should staunchly strive. "
    },
    {
      "number": 3,
      "pali": "Sithilo hi paribbājo, ",
      "english": "For the life gone forth when laxly led "
    },
    {
      "number": 4,
      "pali": "bhiyyo ākirate rajaṁ. ",
      "english": "just stirs up dust all the more. "
    }
  ]
}