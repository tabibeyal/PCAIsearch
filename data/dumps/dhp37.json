{
  "sutta_id": "DHP37",
  "verses": [
    {
      "number": 1,
      "pali": "Saṅgharakkhitabhāgineyyattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dūraṅgamaṁ ekacaraṁ, ",
      "english": "The mind travels far, wandering alone; "
    },
    {
      "number": 3,
      "pali": "asarīraṁ guhāsayaṁ; ",
      "english": "incorporeal, it lies hidden in the heart. "
    },
    {
      "number": 4,
      "pali": "Ye cittaṁ saṁyamissanti, ",
      "english": "Those who will restrain the mind "
    },
    {
      "number": 5,
      "pali": "mokkhanti mārabandhanā. ",
      "english": "are freed from Māra’s bonds. "
    }
  ]
}