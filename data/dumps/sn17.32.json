    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Dāruṇo, bhikkhave, lābhasakkārasiloko. ",
      "english": "“Possessions, honor, and popularity are grim … "
    },
    {
      "number": 6,
      "pali": "Lābhasakkārasilokena abhibhūtassa pariyādiṇṇacittassa, bhikkhave, devadattassa kusalamūlaṁ samucchedamagamā. ",
      "english": "Devadatta cut off his skillful root because his mind was overcome and overwhelmed by possessions, honor, and popularity. "
    },
    {
      "number": 7,
      "pali": "Evaṁ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
      "english": "So grim are possessions, honor, and popularity. …” "
    },
