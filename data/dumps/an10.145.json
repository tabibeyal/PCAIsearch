  "sutta_id": "AN10.145",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.145 ",
      "english": "Numbered Discourses 10.145 "
    },
    {
      "number": 2,
      "pali": "15. Ariyavagga ",
      "english": "15. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Ariyamaggasutta ",
      "english": "The Noble Path "
    },
    {
      "number": 4,
      "pali": "“Ariyamaggañca vo, bhikkhave, dhammaṁ desessāmi anariyamaggañca. ",
      "english": "“I will teach you the noble path and the ignoble path. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, anariyo maggo? ",
      "english": "And what is the ignoble path? "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhi …pe… micchāvimutti—",
      "english": "Wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, wrong immersion, wrong knowledge, and wrong freedom. "
    },
    {
      "number": 8,
      "pali": "ayaṁ vuccati, bhikkhave, anariyo maggo. ",
      "english": "This is called the ignoble path. "
    },
    {
      "number": 9,
      "pali": "Katamo ca, bhikkhave, ariyo maggo? ",
      "english": "And what is the noble path? "
    },
    {
      "number": 10,
      "pali": "Sammādiṭṭhi …pe… sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 11,
      "pali": "ayaṁ vuccati, bhikkhave, ariyo maggo”ti. ",
      "english": "This is called the noble path.” "
    },
    {
      "number": 12,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}