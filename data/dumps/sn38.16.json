{
  "sutta_id": "SN38.16",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 38.16 ",
      "english": "Linked Discourses 38.16 "
    },
    {
      "number": 2,
      "pali": "1. Jambukhādakavagga ",
      "english": "1. With Jambukhādaka "
    },
    {
      "number": 3,
      "pali": "Dukkarapañhāsutta ",
      "english": "A Question About What’s Hard to Do "
    },
    {
      "number": 4,
      "pali": "“Kiṁ nu kho, āvuso sāriputta, imasmiṁ dhammavinaye dukkaran”ti? ",
      "english": "“Reverend Sāriputta, in this teaching and training, what is hard to do?” "
    },
    {
      "number": 5,
      "pali": "“Pabbajjā kho, āvuso, imasmiṁ dhammavinaye dukkarā”ti. ",
      "english": "“Going forth, reverend, is hard to do in this teaching and training.” "
    },
    {
      "number": 6,
      "pali": "“Pabbajitena panāvuso, kiṁ dukkaran”ti? ",
      "english": "“But what’s hard to do for someone who has gone forth?” "
    },
    {
      "number": 7,
      "pali": "“Pabbajitena kho, āvuso, abhirati dukkarā”ti. ",
      "english": "“When you’ve gone forth it’s hard to be satisfied.” "
    },
    {
      "number": 8,
      "pali": "“Abhiratena panāvuso, kiṁ dukkaran”ti? ",
      "english": "“But what’s hard to do for someone who is satisfied?” "
    },
    {
      "number": 9,
      "pali": "“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti. ",
      "english": "“When you’re satisfied, it’s hard to practice in line with the teaching.” "
    },
    {
      "number": 10,
      "pali": "“Kīvaciraṁ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṁ assā”ti? ",
      "english": "“But if a mendicant practices in line with the teaching, will it take them long to become a perfected one?” "
    },
    {
      "number": 11,
      "pali": "“Naciraṁ, āvuso”ti. ",
      "english": "“Not long, reverend.” "
    },
    {
      "number": 12,
      "pali": "Soḷasamaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Jambukhādakasaṁyuttaṁ samattaṁ. ",
      "english": "The Linked Discourses with Jambukhādaka are complete. "
    },
    {
      "number": 14,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Nibbānaṁ arahattañca, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "dhammavādī kimatthiyaṁ; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Assāso paramassāso, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "vedanā āsavāvijjā; ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Taṇhā oghā upādānaṁ, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "bhavo dukkhañca sakkāyo. ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Imasmiṁ dhammavinaye dukkaranti. ",
      "english": ""
    }
  ]
}