{
  "sutta_id": "DHP420",
  "verses": [
    {
      "number": 1,
      "pali": "Yassa gatiṁ na jānanti, ",
      "english": "Gods, centaurs, and humans "
    },
    {
      "number": 2,
      "pali": "devā gandhabbamānusā; ",
      "english": "don’t know their destiny; "
    },
    {
      "number": 3,
      "pali": "Khīṇāsavaṁ arahantaṁ, ",
      "english": "the perfected ones with defilements ended: "
    },
    {
      "number": 4,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}