{
  "sutta_id": "ITI52",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 52 ",
      "english": "So It Was Said 52 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Paṭhamavedanāsutta ",
      "english": "Feelings (1st) "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tisso imā, bhikkhave, vedanā. ",
      "english": "“Mendicants, there are these three feelings. "
    },
    {
      "number": 7,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—",
      "english": "Pleasant, painful, and neutral feeling. "
    },
    {
      "number": 9,
      "pali": "imā kho, bhikkhave, tisso vedanā”ti. ",
      "english": "These are the three feelings.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Samāhito sampajāno, ",
      "english": "“Stilled, aware, "
    },
    {
      "number": 13,
      "pali": "sato buddhassa sāvako; ",
      "english": "a mindful disciple of the Buddha "
    },
    {
      "number": 14,
      "pali": "Vedanā ca pajānāti, ",
      "english": "understands feelings, "
    },
    {
      "number": 15,
      "pali": "vedanānañca sambhavaṁ. ",
      "english": "the cause of feelings, "
    },
    {
      "number": 16,
      "pali": "Yattha cetā nirujjhanti, ",
      "english": "where they cease, "
    },
    {
      "number": 17,
      "pali": "maggañca khayagāminaṁ; ",
      "english": "and the path that leads to their ending. "
    },
    {
      "number": 18,
      "pali": "Vedanānaṁ khayā bhikkhu, ",
      "english": "With the ending of feelings, a mendicant "
    },
    {
      "number": 19,
      "pali": "nicchāto parinibbuto”ti. ",
      "english": "is hungerless, quenched.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}