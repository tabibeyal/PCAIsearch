{
  "sutta_id": "DHP7",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākāḷattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Subhānupassiṁ viharantaṁ, ",
      "english": "Those who contemplate the beautiful, "
    },
    {
      "number": 3,
      "pali": "indriyesu asaṁvutaṁ; ",
      "english": "their faculties unrestrained, "
    },
    {
      "number": 4,
      "pali": "Bhojanamhi cāmattaññuṁ, ",
      "english": "immoderate in eating, "
    },
    {
      "number": 5,
      "pali": "kusītaṁ hīnavīriyaṁ; ",
      "english": "lazy, lacking energy: "
    },
    {
      "number": 6,
      "pali": "Taṁ ve pasahati māro, ",
      "english": "Māra strikes them down "
    },
    {
      "number": 7,
      "pali": "vāto rukkhaṁva dubbalaṁ. ",
      "english": "like the wind, a feeble tree. "
    }
  ]
}