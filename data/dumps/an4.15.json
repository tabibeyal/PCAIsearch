{
  "sutta_id": "AN4.15",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.15 ",
      "english": "Numbered Discourses 4.15 "
    },
    {
      "number": 2,
      "pali": "2. Caravagga ",
      "english": "2. Walking "
    },
    {
      "number": 3,
      "pali": "Paññattisutta ",
      "english": "Regarded as Foremost "
    },
    {
      "number": 4,
      "pali": "“Catasso imā, bhikkhave, aggapaññattiyo. ",
      "english": "“Mendicants, these four are regarded as foremost. "
    },
    {
      "number": 5,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, attabhāvīnaṁ yadidaṁ—",
      "english": "The foremost in size of incarnation is "
    },
    {
      "number": 7,
      "pali": "rāhu asurindo. ",
      "english": "Rāhu, lord of titans. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, kāmabhogīnaṁ yadidaṁ—",
      "english": "The foremost pleasure seeker is "
    },
    {
      "number": 9,
      "pali": "rājā mandhātā. ",
      "english": "King Mandhātā. "
    },
    {
      "number": 10,
      "pali": "Etadaggaṁ, bhikkhave, ādhipateyyānaṁ yadidaṁ—",
      "english": "The foremost in sovereignty is "
    },
    {
      "number": 11,
      "pali": "māro pāpimā. ",
      "english": "Māra the Wicked. "
    },
    {
      "number": 12,
      "pali": "Sadevake, bhikkhave, loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya tathāgato aggamakkhāyati arahaṁ sammāsambuddho. ",
      "english": "In this world—with its gods, Māras, and divinities, this population with its ascetics and brahmins, gods and humans—a Realized One, the perfected one, the fully awakened Buddha is said to be the best. "
    },
    {
      "number": 13,
      "pali": "Imā kho, bhikkhave, catasso aggapaññattiyoti. ",
      "english": "These are the four regarded as foremost. "
    },
    {
      "number": 14,
      "pali": "Rāhuggaṁ attabhāvīnaṁ, ",
      "english": "Rāhu is foremost in size of incarnation, "
    },
    {
      "number": 15,
      "pali": "mandhātā kāmabhoginaṁ; ",
      "english": "Mandhātā in enjoying sensual pleasures, "
    },
    {
      "number": 16,
      "pali": "Māro ādhipateyyānaṁ, ",
      "english": "Māra in sovereignty, "
    },
    {
      "number": 17,
      "pali": "iddhiyā yasasā jalaṁ. ",
      "english": "shining with power and glory. "
    },
    {
      "number": 18,
      "pali": "Uddhaṁ tiriyaṁ apācīnaṁ, ",
      "english": "Above, below, all round, "
    },
    {
      "number": 19,
      "pali": "yāvatājagatogati; ",
      "english": "as far as the planet extends; "
    },
    {
      "number": 20,
      "pali": "Sadevakassa lokassa, ",
      "english": "in all the world with its gods, "
    },
    {
      "number": 21,
      "pali": "buddho aggo pavuccatī”ti. ",
      "english": "the Buddha is declared foremost.” "
    },
    {
      "number": 22,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}