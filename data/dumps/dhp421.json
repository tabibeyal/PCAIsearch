{
  "sutta_id": "DHP421",
  "verses": [
    {
      "number": 1,
      "pali": "Dhammadinnāttherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa pure ca pacchā ca, ",
      "english": "They have nothing before or after, "
    },
    {
      "number": 3,
      "pali": "majjhe ca natthi kiñcanaṁ; ",
      "english": "or even in between. "
    },
    {
      "number": 4,
      "pali": "Akiñcanaṁ anādānaṁ, ",
      "english": "Having nothing, taking nothing: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}