    {
      "number": 2,
      "pali": "3. Aṭṭhasatapariyāyavagga ",
      "english": "3. The Explanation of the Hundred and Eight "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, vedanā. ",
      "english": "“Mendicants, there are these three feelings. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—",
      "english": "Pleasant, painful, and neutral feelings. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso vedanā”ti. ",
      "english": "These are the three feelings.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    }
  ]
