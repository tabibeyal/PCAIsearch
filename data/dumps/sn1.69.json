      "number": 1,
      "pali": "Saṁyutta Nikāya 1.69 ",
      "english": "Linked Discourses 1.69 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Icchāsutta ",
      "english": "Desire "
    },
    {
      "number": 4,
      "pali": "“Kenassu bajjhatī loko, ",
      "english": "“What is it that binds the world? "
    },
    {
      "number": 5,
      "pali": "kissa vinayāya muccati; ",
      "english": "By removing what is it freed? "
    },
    {
      "number": 6,
      "pali": "Kissassu vippahānena, ",
      "english": "With the giving up of what "
    },
    {
      "number": 7,
      "pali": "sabbaṁ chindati bandhanan”ti. ",
      "english": "are all bonds severed?” "
    },
    {
      "number": 8,
      "pali": "“Icchāya bajjhatī loko, ",
      "english": "“Desire is what binds the world. "
    },
    {
      "number": 9,
      "pali": "icchāvinayāya muccati; ",
      "english": "By the removing of desire it’s freed. "
    },
    {
      "number": 10,
      "pali": "Icchāya vippahānena, ",
      "english": "With the giving up of desire, "
    },
    {
      "number": 11,
      "pali": "sabbaṁ chindati bandhanan”ti. ",
      "english": "all bonds are severed.” "
    }
  ]
}