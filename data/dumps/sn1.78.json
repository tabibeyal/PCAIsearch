    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Kāmasutta ",
      "english": "Desire "
    },
    {
      "number": 4,
      "pali": "“Kimatthakāmo na dade, ",
      "english": "“What should one who wants what’s best <j>not give away? "
    },
    {
      "number": 5,
      "pali": "kiṁ macco na pariccaje; ",
      "english": "What should a mortal not forsake? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu muñceyya kalyāṇaṁ, ",
      "english": "What should be released when it’s good, "
    },
    {
      "number": 7,
      "pali": "pāpikaṁ na ca mocaye”ti. ",
      "english": "but not when it’s bad?” "
    },
    {
      "number": 8,
      "pali": "“Attānaṁ na dade poso, ",
      "english": "“A man shouldn’t give away himself. "
    },
    {
      "number": 9,
      "pali": "attānaṁ na pariccaje; ",
      "english": "He shouldn’t forsake himself. "
    },
    {
      "number": 10,
      "pali": "Vācaṁ muñceyya kalyāṇaṁ, ",
      "english": "Speech should be released when it’s good, "
    },
    {
      "number": 11,
      "pali": "pāpikañca na mocaye”ti. ",
      "english": "but not when it’s bad.” "
    }
  ]
