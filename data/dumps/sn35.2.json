    {
      "number": 3,
      "pali": "Ajjhattadukkhasutta ",
      "english": "The Interior as Suffering "
    },
    {
      "number": 4,
      "pali": "“Cakkhuṁ, bhikkhave, dukkhaṁ. ",
      "english": "“Mendicants, the eye is suffering. "
    },
    {
      "number": 5,
      "pali": "Yaṁ dukkhaṁ tadanattā; ",
      "english": "What’s suffering is not-self. "
    },
    {
      "number": 6,
      "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 7,
      "pali": "Sotaṁ dukkhaṁ …pe… ",
      "english": "The ear, "
    },
    {
      "number": 8,
      "pali": "ghānaṁ dukkhaṁ … ",
      "english": "nose, "
    },
    {
      "number": 9,
      "pali": "jivhā dukkhā … ",
      "english": "tongue, "
    },
    {
      "number": 10,
      "pali": "kāyo dukkho … ",
      "english": "body, "
    },
    {
      "number": 11,
      "pali": "mano dukkho. ",
      "english": "and mind are suffering. "
    },
    {
      "number": 12,
      "pali": "Yaṁ dukkhaṁ tadanattā; ",
      "english": "What’s suffering is not-self. "
    },
    {
      "number": 13,
      "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 14,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 15,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
