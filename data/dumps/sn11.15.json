{
  "sutta_id": "SN11.15",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.15 ",
      "english": "Linked Discourses 11.15 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 3,
      "pali": "Rāmaṇeyyakasutta ",
      "english": "Delightful "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ jetavane. ",
      "english": "Near Sāvatthī in Jeta’s Grove. "
    },
    {
      "number": 5,
      "pali": "Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. Ekamantaṁ ṭhito kho sakko devānamindo bhagavantaṁ etadavoca: ",
      "english": "And then Sakka, lord of gods, went up to the Buddha, bowed, stood to one side, and said to him, "
    },
    {
      "number": 6,
      "pali": "“kiṁ nu kho, bhante, bhūmirāmaṇeyyakan”ti? ",
      "english": "“Sir, what is a delightful place?” "
    },
    {
      "number": 7,
      "pali": "“Ārāmacetyā vanacetyā, ",
      "english": "“Shrines in parks and forests, "
    },
    {
      "number": 8,
      "pali": "pokkharañño sunimmitā; ",
      "english": "well-made lotus ponds, "
    },
    {
      "number": 9,
      "pali": "Manussarāmaṇeyyassa, ",
      "english": "are not worth a sixteenth part "
    },
    {
      "number": 10,
      "pali": "kalaṁ nāgghanti soḷasiṁ. ",
      "english": "of a delightful human being. "
    },
    {
      "number": 11,
      "pali": "Gāme vā yadi vāraññe, ",
      "english": "Whether in village or wilderness, "
    },
    {
      "number": 12,
      "pali": "Ninne vā yadi vā thale; ",
      "english": "in a valley or the uplands, "
    },
    {
      "number": 13,
      "pali": "Yattha arahanto viharanti, ",
      "english": "wherever the perfected ones live "
    },
    {
      "number": 14,
      "pali": "Taṁ bhūmirāmaṇeyyakan”ti. ",
      "english": "is a delightful place.” "
    }
  ]
}