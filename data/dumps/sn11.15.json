{
  "sutta_id": "SN11.15",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 11.15",
      "english": "Linked Discourses 11.15"
    },
    {
      "number": 2,
      "pali": "Rāmaṇeyyaka Sutta",
      "english": "A Delightful Place"
    },
    {
      "number": 3,
      "pali": "",
      "english": "On one occasion the Blessed One was staying near Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery. Then Sakka the deva-king went to the Blessed One and, on arrival, having bowed down to him, stood to one side. As he was standing there, he said to the Blessed One, “What, lord, is a delightful place?”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“Park shrines, forest shrines,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "well-constructed lotus ponds"
    },
    {
      "number": 7,
      "pali": "",
      "english": "aren’t worth one-sixteenth"
    },
    {
      "number": 8,
      "pali": "",
      "english": "of a delightful human being."
    },
    {
      "number": 9,
      "pali": "",
      "english": "In village or wilds,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "valley, plateau:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "that place is delightful"
    },
    {
      "number": 12,
      "pali": "",
      "english": "where arahants dwell.”"
    }
  ]
}