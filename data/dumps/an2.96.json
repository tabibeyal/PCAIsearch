{
  "sutta_id": "AN2.96",
  "verses": [
    {
      "number": 1,
      "pali": "96 ",
      "english": "96 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Dhātukusalatā ca manasikārakusalatā ca. ",
      "english": "Skill in the elements and skill in application of mind. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}