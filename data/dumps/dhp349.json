{
  "sutta_id": "DHP349",
  "verses": [
    {
      "number": 1,
      "pali": "Cūḷadhanuggahapaṇḍitavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Vitakkamathitassa jantuno, ",
      "english": "For a personage churned by thoughts, "
    },
    {
      "number": 3,
      "pali": "Tibbarāgassa subhānupassino; ",
      "english": "very lustful, focusing on beauty, "
    },
    {
      "number": 4,
      "pali": "Bhiyyo taṇhā pavaḍḍhati, ",
      "english": "their craving grows and grows, "
    },
    {
      "number": 5,
      "pali": "Esa kho daḷhaṁ karoti bandhanaṁ. ",
      "english": "tying them with a stout bond. "
    }
  ]
}