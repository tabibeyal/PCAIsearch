  "sutta_id": "AN10.133",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.133 ",
      "english": "Numbered Discourses 10.133 "
    },
    {
      "number": 2,
      "pali": "13. Parisuddhavagga ",
      "english": "13. Purified "
    },
    {
      "number": 3,
      "pali": "Ekādasamasutta ",
      "english": "Eleventh "
    },
    {
      "number": 4,
      "pali": "“Dasayime, bhikkhave, sammattā. ",
      "english": "“Mendicants, there are ten right ways. "
    },
    {
      "number": 5,
      "pali": "Katame dasa? ",
      "english": "What ten? "
    },
    {
      "number": 6,
      "pali": "Sammādiṭṭhi, sammāsaṅkappo, sammāvācā, sammākammanto, sammāājīvo, sammāvāyāmo, sammāsati, sammāsamādhi, sammāñāṇaṁ, sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 7,
      "pali": "ime kho, bhikkhave, dasa sammattā”ti. ",
      "english": "These are the ten right ways.” "
    },
    {
      "number": 8,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Parisuddhavaggo tatiyo. ",
      "english": ""
    }
  ]
}