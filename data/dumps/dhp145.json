{
  "sutta_id": "DHP145",
  "verses": [
    {
      "number": 1,
      "pali": "Sukhasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Udakañhi nayanti nettikā, ",
      "english": "While irrigators guide water, "
    },
    {
      "number": 3,
      "pali": "Usukārā namayanti tejanaṁ; ",
      "english": "fletchers shape arrows, "
    },
    {
      "number": 4,
      "pali": "Dāruṁ namayanti tacchakā, ",
      "english": "and carpenters carve timber—"
    },
    {
      "number": 5,
      "pali": "Attānaṁ damayanti subbatā. ",
      "english": "those true to their vows tame themselves. "
    },
    {
      "number": 6,
      "pali": "Daṇḍavaggo dasamo. ",
      "english": ""
    }
  ]
}