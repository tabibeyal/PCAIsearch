{
  "sutta_id": "DHP332",
  "verses": [
    {
      "number": 1,
      "pali": "Sukhā matteyyatā loke, ",
      "english": "In this world it’s a blessing to serve "
    },
    {
      "number": 2,
      "pali": "atho petteyyatā sukhā; ",
      "english": "one’s mother and one’s father. "
    },
    {
      "number": 3,
      "pali": "Sukhā sāmaññatā loke, ",
      "english": "And it’s a blessing also to serve "
    },
    {
      "number": 4,
      "pali": "atho brahmaññatā sukhā. ",
      "english": "ascetics and brahmins. "
    }
  ]
}