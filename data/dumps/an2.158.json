{
  "sutta_id": "AN2.158",
  "verses": [
    {
      "number": 1,
      "pali": "158 ",
      "english": "158 "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, iddhiyo. ",
      "english": "“There are, mendicants, these two successes. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisiddhi ca dhammiddhi ca. ",
      "english": "Success in things of the flesh and success in the teaching. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve iddhiyo. ",
      "english": "These are the two successes. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imāsaṁ dvinnaṁ iddhīnaṁ yadidaṁ dhammiddhī”ti. ",
      "english": "The better of these two successes is success in the teaching.” "
    }
  ]
}