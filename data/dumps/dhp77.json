{
  "sutta_id": "DHP77",
  "verses": [
    {
      "number": 1,
      "pali": "Assajipunabbasukavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ovadeyyānusāseyya, ",
      "english": "Advise and instruct; "
    },
    {
      "number": 3,
      "pali": "asabbhā ca nivāraye; ",
      "english": "curb wickedness: "
    },
    {
      "number": 4,
      "pali": "Satañhi so piyo hoti, ",
      "english": "for you shall be loved by the good, "
    },
    {
      "number": 5,
      "pali": "asataṁ hoti appiyo. ",
      "english": "and disliked by the bad. "
    }
  ]
}