{
  "sutta_id": "DHP350",
  "verses": [
    {
      "number": 1,
      "pali": "Vitakkūpasame ca yo rato, ",
      "english": "But one who loves to calm their thoughts, "
    },
    {
      "number": 2,
      "pali": "Asubhaṁ bhāvayate sadā sato; ",
      "english": "developing perception of ugliness, ever mindful, "
    },
    {
      "number": 3,
      "pali": "Esa kho byanti kāhiti, ",
      "english": "will surely eliminate that craving, "
    },
    {
      "number": 4,
      "pali": "Esa checchati mārabandhanaṁ. ",
      "english": "cutting off the bonds of Māra. "
    }
  ]
}