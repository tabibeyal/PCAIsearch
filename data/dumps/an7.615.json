    {
      "number": 4,
      "pali": "“Rāgassa, bhikkhave, abhiññāya satta dhammā bhāvetabbā. ",
      "english": "“Mendicants, for insight into greed, seven things should be developed. "
    },
    {
      "number": 5,
      "pali": "Katame satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Satisambojjhaṅgo …pe… ",
      "english": "The awakening factor of mindfulness … "
    },
    {
      "number": 7,
      "pali": "upekkhāsambojjhaṅgo—",
      "english": "the awakening factor of equanimity. "
    },
    {
      "number": 8,
      "pali": "rāgassa, bhikkhave, abhiññāya ime satta dhammā bhāvetabbā”ti. ",
      "english": "These seven things should be developed for insight into greed.” "
    }
