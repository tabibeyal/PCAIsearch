{
  "sutta_id": "DHP207",
  "verses": [
    {
      "number": 1,
      "pali": "Bālasaṅgatacārī hi, ",
      "english": "For one who consorts with fools "
    },
    {
      "number": 2,
      "pali": "dīghamaddhāna socati; ",
      "english": "grieves long. "
    },
    {
      "number": 3,
      "pali": "Dukkho bālehi saṁvāso, ",
      "english": "Painful is living with fools, "
    },
    {
      "number": 4,
      "pali": "amitteneva sabbadā; ",
      "english": "like being stuck with your enemy. "
    },
    {
      "number": 5,
      "pali": "Dhīro ca sukhasaṁvāso, ",
      "english": "Happy is living with an attentive one, "
    },
    {
      "number": 6,
      "pali": "ñātīnaṁva samāgamo. ",
      "english": "like meeting with your kin. "
    }
  ]
}