{
  "sutta_id": "DHP397",
  "verses": [
    {
      "number": 1,
      "pali": "Uggasenaseṭṭhiputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbasaṁyojanaṁ chetvā, ",
      "english": "Having cut off all fetters "
    },
    {
      "number": 3,
      "pali": "yo ve na paritassati; ",
      "english": "they have no anxiety. "
    },
    {
      "number": 4,
      "pali": "Saṅgātigaṁ visaṁyuttaṁ, ",
      "english": "They’ve slipped their chains and are detached: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}