{
  "sutta_id": "SN22.132",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.132 ",
      "english": "Linked Discourses 22.132 "
    },
    {
      "number": 2,
      "pali": "13. Avijjāvagga ",
      "english": "13. Ignorance "
    },
    {
      "number": 3,
      "pali": "Dutiyasamudayasutta ",
      "english": "Origin (2nd) "
    },
    {
      "number": 4,
      "pali": "Bārāṇasiyaṁ viharanti isipatane migadāye …pe… ",
      "english": "At Varanasi. "
    },
    {
      "number": 5,
      "pali": "ekamantaṁ nisinno kho āyasmā mahākoṭṭhiko āyasmantaṁ sāriputtaṁ etadavoca: ",
      "english": "Mahākoṭṭhita said to Sāriputta: "
    },
    {
      "number": 6,
      "pali": "“‘vijjā, vijjā’ti, āvuso sāriputta, vuccati. ",
      "english": "“Reverend Sāriputta, they speak of this thing called ‘knowledge’. "
    },
    {
      "number": 7,
      "pali": "Katamā nu kho, āvuso, vijjā; ",
      "english": "What is knowledge? "
    },
    {
      "number": 8,
      "pali": "kittāvatā ca vijjāgato hotī”ti? ",
      "english": "And how is a knowing one defined?” "
    },
    {
      "number": 9,
      "pali": "“Idhāvuso, sutavā ariyasāvako rūpassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṁ pajānāti. ",
      "english": "“Reverend, a learned noble disciple truly understands the origin, the disappearance, the gratification, the drawback, and the escape when it comes to form, "
    },
    {
      "number": 10,
      "pali": "Vedanāya …pe… ",
      "english": "feeling, "
    },
    {
      "number": 11,
      "pali": "saññāya … ",
      "english": "perception, "
    },
    {
      "number": 12,
      "pali": "saṅkhārānaṁ … ",
      "english": "choices, "
    },
    {
      "number": 13,
      "pali": "viññāṇassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṁ pajānāti. ",
      "english": "and consciousness. "
    },
    {
      "number": 14,
      "pali": "Ayaṁ vuccatāvuso, vijjā; ",
      "english": "This is called knowledge. "
    },
    {
      "number": 15,
      "pali": "ettāvatā ca vijjāgato hotī”ti. ",
      "english": "And this is how a knowing one is defined.” "
    },
    {
      "number": 16,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}