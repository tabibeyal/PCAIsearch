{
  "sutta_id": "AN2.10",
  "verses": [
    {
      "number": 1,
      "pali": "10. Vassūpanāyikasutta ",
      "english": "10. Entering the Rainy Season "
    },
    {
      "number": 2,
      "pali": "“Dvemā, bhikkhave, vassūpanāyikā. ",
      "english": "“There are, mendicants, these two entries to the rainy season. "
    },
    {
      "number": 3,
      "pali": "Katamā dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Purimikā ca pacchimikā ca. ",
      "english": "Earlier and later. "
    },
    {
      "number": 5,
      "pali": "Imā kho, bhikkhave, dve vassūpanāyikā”ti. ",
      "english": "These are the two entries to the rainy season.” "
    },
    {
      "number": 6,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Kammakaraṇavaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Vajjā padhānā dve tapanīyā, ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Upaññātena pañcamaṁ; ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Saṁyojanañca kaṇhañca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Sukkaṁ cariyā vassūpanāyikena vaggo. ",
      "english": ""
    }
  ]
}