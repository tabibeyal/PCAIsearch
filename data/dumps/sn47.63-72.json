      "number": 3,
      "pali": "Tathāgatādisutta ",
      "english": "The Realized One "
    },
    {
      "number": 4,
      "pali": "“Yāvatā, bhikkhave, sattā apadā vā dvipadā vā catuppadā vā bahuppadā vā”ti  ",
      "english": "“Mendicants, the Realized One, the perfected one, the fully awakened Buddha, is said to be the best of all sentient beings—be they footless, with two feet, four feet, or many feet …” "
    },
    {
      "number": 5,
      "pali": "vitthāretabbaṁ.",
      "english": "(Tell in full as in SN 45.139–148.) "
    },
    {
      "number": 6,
      "pali": "Appamādavaggo sattamo. ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Tathāgataṁ padaṁ kūṭaṁ, ",
      "english": "The Realized One, footprint, roof peak, "
    },
    {
      "number": 9,
      "pali": "mūlaṁ sāro ca vassikaṁ; ",
      "english": "roots, heartwood, jasmine, "
    },
    {
      "number": 10,
      "pali": "Rājā candimasūriyā, ",
      "english": "monarch, sun and moon, "
    },
    {
      "number": 11,
      "pali": "vatthena dasamaṁ padanti. ",
      "english": "and cloth is the tenth. "
    }
  ]
