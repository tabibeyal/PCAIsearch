{
  "sutta_id": "SN1.46",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.46 ",
      "english": "Linked Discourses 1.46 "
    },
    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Accharāsutta ",
      "english": "Nymphs "
    },
    {
      "number": 4,
      "pali": "“Accharāgaṇasaṅghuṭṭhaṁ, ",
      "english": "“It’s resounding with a group of nymphs, "
    },
    {
      "number": 5,
      "pali": "pisācagaṇasevitaṁ; ",
      "english": "but haunted by a gang of goblins! "
    },
    {
      "number": 6,
      "pali": "Vanantaṁ mohanaṁ nāma, ",
      "english": "This grove is called ‘Deluding’. "
    },
    {
      "number": 7,
      "pali": "kathaṁ yātrā bhavissatī”ti. ",
      "english": "How will I keep going?” "
    },
    {
      "number": 8,
      "pali": "“Ujuko nāma so maggo, ",
      "english": "“That path is called ‘the direct way’, "
    },
    {
      "number": 9,
      "pali": "abhayā nāma sā disā; ",
      "english": "and it’s headed for the place called ‘fearless’. "
    },
    {
      "number": 10,
      "pali": "Ratho akūjano nāma, ",
      "english": "The chariot is called ‘unswerving’, "
    },
    {
      "number": 11,
      "pali": "dhammacakkehi saṁyuto. ",
      "english": "fitted with wheels of the teaching. "
    },
    {
      "number": 12,
      "pali": "Hirī tassa apālambo, ",
      "english": "Conscience is its bench-back, "
    },
    {
      "number": 13,
      "pali": "satyassa parivāraṇaṁ; ",
      "english": "mindfulness its upholstery. "
    },
    {
      "number": 14,
      "pali": "Dhammāhaṁ sārathiṁ brūmi, ",
      "english": "I say the teaching is the driver, "
    },
    {
      "number": 15,
      "pali": "sammādiṭṭhipurejavaṁ. ",
      "english": "with right view running out in front. "
    },
    {
      "number": 16,
      "pali": "Yassa etādisaṁ yānaṁ, ",
      "english": "Any woman or man "
    },
    {
      "number": 17,
      "pali": "itthiyā purisassa vā; ",
      "english": "who has such a vehicle, "
    },
    {
      "number": 18,
      "pali": "Sa ve etena yānena, ",
      "english": "by means of this vehicle "
    },
    {
      "number": 19,
      "pali": "nibbānasseva santike”ti. ",
      "english": "has drawn near to extinguishment.” "
    }
  ]
}