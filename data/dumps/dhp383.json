      "number": 3,
      "pali": "Brāhmaṇavagga ",
      "english": "26. Brahmins "
    },
    {
      "number": 4,
      "pali": "Pasādabahulabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Chinda sotaṁ parakkamma, ",
      "english": "Cut the stream, striving! "
    },
    {
      "number": 6,
      "pali": "kāme panuda brāhmaṇa; ",
      "english": "Cast aside sensual pleasures, brahmin. "
    },
    {
      "number": 7,
      "pali": "Saṅkhārānaṁ khayaṁ ñatvā, ",
      "english": "Knowing the ending of conditions, "
    },
    {
      "number": 8,
      "pali": "akataññūsi brāhmaṇa. ",
      "english": "know the uncreated, brahmin. "
    }
  ]
}