{
  "sutta_id": "DHP212",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarakuṭumbikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Piyato jāyatī soko, ",
      "english": "Sorrow springs from what we hold dear, "
    },
    {
      "number": 3,
      "pali": "piyato jāyatī bhayaṁ; ",
      "english": "fear springs from what we hold dear; "
    },
    {
      "number": 4,
      "pali": "Piyato vippamuttassa, ",
      "english": "one free from holding anything dear "
    },
    {
      "number": 5,
      "pali": "natthi soko kuto bhayaṁ. ",
      "english": "has no sorrow, let alone fear. "
    }
  ]
}