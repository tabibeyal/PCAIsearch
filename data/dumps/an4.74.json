    },
    {
      "number": 2,
      "pali": "8. Apaṇṇakavagga ",
      "english": "8.  Sure Bet "
    },
    {
      "number": 3,
      "pali": "Paṭhamaaggasutta ",
      "english": "Best (1st) "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, aggāni. ",
      "english": "“Mendicants, these four things are the best. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sīlaggaṁ, samādhiggaṁ, paññāggaṁ, vimuttaggaṁ—",
      "english": "The best ethics, immersion, wisdom, and freedom. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri aggānī”ti. ",
      "english": "These are the four things that are the best.” "
    },
    {
      "number": 8,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
