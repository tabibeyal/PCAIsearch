{
  "sutta_id": "DHP173",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅgulimālattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa pāpaṁ kataṁ kammaṁ, ",
      "english": "Someone whose bad deed "
    },
    {
      "number": 3,
      "pali": "kusalena pidhīyati; ",
      "english": "is supplanted by the good, "
    },
    {
      "number": 4,
      "pali": "Somaṁ lokaṁ pabhāseti, ",
      "english": "lights up the world, "
    },
    {
      "number": 5,
      "pali": "abbhā muttova candimā. ",
      "english": "like the moon freed from clouds. "
    }
  ]
}