{
  "sutta_id": "DHP198",
  "verses": [
    {
      "number": 1,
      "pali": "Susukhaṁ vata jīvāma, ",
      "english": "Let us live so very happily, "
    },
    {
      "number": 2,
      "pali": "āturesu anāturā; ",
      "english": "healthy among the ailing. "
    },
    {
      "number": 3,
      "pali": "Āturesu manussesu, ",
      "english": "Among ailing humans "
    },
    {
      "number": 4,
      "pali": "viharāma anāturā. ",
      "english": "let us live healthily. "
    }
  ]
}