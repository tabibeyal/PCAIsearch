{
  "sutta_id": "DHP378",
  "verses": [
    {
      "number": 1,
      "pali": "Santakāyattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Santakāyo santavāco, ",
      "english": "Calm in body, calm in speech, "
    },
    {
      "number": 3,
      "pali": "santavā susamāhito; ",
      "english": "peaceful and serene; "
    },
    {
      "number": 4,
      "pali": "Vantalokāmiso bhikkhu, ",
      "english": "a mendicant who’s spat out the world’s bait "
    },
    {
      "number": 5,
      "pali": "“upasanto”ti vuccati. ",
      "english": "is said to be one at peace. "
    }
  ]
}