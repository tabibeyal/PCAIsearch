{
  "sutta_id": "SN45.36",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.36 ",
      "english": "Linked Discourses 45.36 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Dutiyasāmaññasutta ",
      "english": "The Ascetic Life (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Sāmaññañca vo, bhikkhave, desessāmi, sāmaññatthañca. ",
      "english": "“Mendicants, I will teach you the ascetic life and the goal of the ascetic life. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca kho, bhikkhave, sāmaññaṁ? ",
      "english": "And what is the ascetic life? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, sāmaññaṁ. ",
      "english": "This is called the ascetic life. "
    },
    {
      "number": 11,
      "pali": "Katamo ca, bhikkhave, sāmaññattho? ",
      "english": "And what is the goal of the ascetic life? "
    },
    {
      "number": 12,
      "pali": "Yo kho, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, sāmaññattho”ti. ",
      "english": "This is called the goal of the ascetic life.” "
    },
    {
      "number": 14,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}