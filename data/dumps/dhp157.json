    {
      "number": 3,
      "pali": "Attavagga ",
      "english": "12. The Self "
    },
    {
      "number": 4,
      "pali": "Bodhirājakumāravatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Attānañce piyaṁ jaññā, ",
      "english": "If you knew your self as beloved, "
    },
    {
      "number": 6,
      "pali": "rakkheyya naṁ surakkhitaṁ; ",
      "english": "you’d look after it so well. "
    },
    {
      "number": 7,
      "pali": "Tiṇṇaṁ aññataraṁ yāmaṁ, ",
      "english": "In one of the night’s three watches, "
    },
    {
      "number": 8,
      "pali": "paṭijaggeyya paṇḍito. ",
      "english": "an astute person would remain alert. "
    }
  ]
