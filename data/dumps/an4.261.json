{
  "sutta_id": "AN4.261",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.261 ",
      "english": "Numbered Discourses 4.261 "
    },
    {
      "number": 2,
      "pali": "26. Abhiññāvagga ",
      "english": "26. Insight "
    },
    {
      "number": 3,
      "pali": "Balasutta ",
      "english": "Powers "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these four powers. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Vīriyabalaṁ, satibalaṁ, samādhibalaṁ, paññābalaṁ—",
      "english": "The powers of energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri balānī”ti. ",
      "english": "These are the four powers.” "
    },
    {
      "number": 8,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}