  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 29.1 ",
      "english": "Linked Discourses 29.1 "
    },
    {
      "number": 2,
      "pali": "1. Nāgavagga ",
      "english": "1. Dragons "
    },
    {
      "number": 3,
      "pali": "Suddhikasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Catasso imā, bhikkhave, nāgayoniyo. ",
      "english": "“Mendicants, dragons reproduce in these four ways. "
    },
    {
      "number": 6,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 7,
      "pali": "Aṇḍajā nāgā, jalābujā nāgā, saṁsedajā nāgā, opapātikā nāgā—",
      "english": "Dragons are born from eggs, from a womb, from moisture, or spontaneously. "
    },
    {
      "number": 8,
      "pali": "imā kho, bhikkhave, catasso nāgayoniyo”ti. ",
      "english": "These are the four ways that dragons reproduce.” "
    },
    {
      "number": 9,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}