{
  "sutta_id": "SN1.55",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.55 ",
      "english": "Linked Discourses 1.55 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Paṭhamajanasutta ",
      "english": "Gives Birth (1st) "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu janeti purisaṁ, ",
      "english": "“What gives birth to a person? "
    },
    {
      "number": 5,
      "pali": "kiṁsu tassa vidhāvati; ",
      "english": "What do they have that runs about? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu saṁsāramāpādi, ",
      "english": "What enters transmigration? "
    },
    {
      "number": 7,
      "pali": "kiṁsu tassa mahabbhayan”ti. ",
      "english": "What’s their greatest fear?” "
    },
    {
      "number": 8,
      "pali": "“Taṇhā janeti purisaṁ, ",
      "english": "“Craving gives birth to a person. "
    },
    {
      "number": 9,
      "pali": "cittamassa vidhāvati; ",
      "english": "Their mind is what runs about. "
    },
    {
      "number": 10,
      "pali": "Satto saṁsāramāpādi, ",
      "english": "A sentient being enters transmigration. "
    },
    {
      "number": 11,
      "pali": "dukkhamassa mahabbhayan”ti. ",
      "english": "Suffering is their greatest fear.” "
    }
  ]
}