  "sutta_id": "ITI34",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 34",
      "english": "Itivuttaka 34"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, a person without ardency, without compunction, is incapable of self-awakening, incapable of Unbinding, incapable of attaining the unsurpassed safety from bondage. A person ardent & compunctious is capable of self-awakening, capable of Unbinding, capable of attaining the unsurpassed safety from bondage.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "With no ardency, no"
    },
    {
      "number": 5,
      "pali": "",
      "english": "compunction,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "lazy, with low persistence,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "full of sloth & drowsiness,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "shameless, without respect:"
    },
    {
      "number": 9,
      "pali": "",
      "english": "he’s incapable,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "a monk like this,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "of touching superlative"
    },
    {
      "number": 12,
      "pali": "",
      "english": "self-awakening."
    },
    {
      "number": 13,
      "pali": "",
      "english": "But whoever is mindful, masterful,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "absorbed in jhāna,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "ardent, concerned, & heedful,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "cutting the fetter of birth & aging,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "touches right here"
    },
    {
      "number": 18,
      "pali": "",
      "english": "a self-awakening un-"
    },
    {
      "number": 19,
      "pali": "",
      "english": "surpassed."
    }
  ]
}