{
  "sutta_id": "DHP23",
  "verses": [
    {
      "number": 1,
      "pali": "Te jhāyino sātatikā, ",
      "english": "They who regularly meditate, "
    },
    {
      "number": 2,
      "pali": "niccaṁ daḷhaparakkamā; ",
      "english": "always staunchly vigorous; "
    },
    {
      "number": 3,
      "pali": "Phusanti dhīrā nibbānaṁ, ",
      "english": "the attentive realize extinguishment, "
    },
    {
      "number": 4,
      "pali": "yogakkhemaṁ anuttaraṁ. ",
      "english": "the supreme sanctuary from the yoke. "
    }
  ]
}