  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 51",
      "english": "Itivuttaka 51"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three properties. Which three? The property of form, the property of formlessness, the property of cessation. These are the three properties.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Comprehending the property of form,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "not taking a stance in the formless,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "those released in cessation"
    },
    {
      "number": 7,
      "pali": "",
      "english": "are people who’ve left death behind."
    },
    {
      "number": 8,
      "pali": "",
      "english": "Having touched with his body"
    },
    {
      "number": 9,
      "pali": "",
      "english": "the deathless"
    },
    {
      "number": 10,
      "pali": "",
      "english": "property free"
    },
    {
      "number": 11,
      "pali": "",
      "english": "from acquisitions,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "having realized the relinquishing"
    },
    {
      "number": 13,
      "pali": "",
      "english": "of acquisitions,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "effluent-free,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "the Rightly"
    },
    {
      "number": 16,
      "pali": "",
      "english": "Self-awakened One"
    },
    {
      "number": 17,
      "pali": "",
      "english": "teaches the state"
    },
    {
      "number": 18,
      "pali": "",
      "english": "with"
    },
    {
      "number": 19,
      "pali": "",
      "english": "no sorrow,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "no dust."
    }
  ]
}