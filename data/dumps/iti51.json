{
  "sutta_id": "ITI51",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 51 ",
      "english": "So It Was Said 51 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Dhātusutta ",
      "english": "Elements "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tisso imā, bhikkhave, dhātuyo. ",
      "english": "“Mendicants, there are these three elements. "
    },
    {
      "number": 7,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Rūpadhātu, arūpadhātu, nirodhadhātu—",
      "english": "The elements of form, formlessness, and cessation. "
    },
    {
      "number": 9,
      "pali": "imā kho, bhikkhave, tisso dhātuyo”ti. ",
      "english": "These are the three elements.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Rūpadhātuṁ pariññāya, ",
      "english": "“Comprehending the element of form, "
    },
    {
      "number": 13,
      "pali": "āruppesu asaṇṭhitā; ",
      "english": "not stuck in the formless, "
    },
    {
      "number": 14,
      "pali": "Nirodhe ye vimuccanti, ",
      "english": "those who are released in cessation, "
    },
    {
      "number": 15,
      "pali": "te janā maccuhāyino. ",
      "english": "they are conquerors of death. "
    },
    {
      "number": 16,
      "pali": "Kāyena amataṁ dhātuṁ, ",
      "english": "Having directly experienced <j>the element free of death, "
    },
    {
      "number": 17,
      "pali": "phusayitvā nirūpadhiṁ; ",
      "english": "free of attachments; "
    },
    {
      "number": 18,
      "pali": "Upadhippaṭinissaggaṁ, ",
      "english": "having realised relinquishment "
    },
    {
      "number": 19,
      "pali": "sacchikatvā anāsavo; ",
      "english": "of attachments, the undefiled "
    },
    {
      "number": 20,
      "pali": "Deseti sammāsambuddho, ",
      "english": "fully awakened Buddha teaches "
    },
    {
      "number": 21,
      "pali": "asokaṁ virajaṁ padan”ti. ",
      "english": "the sorrowless, stainless state.” "
    },
    {
      "number": 22,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 23,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}