{
  "sutta_id": "DHP192",
  "verses": [
    {
      "number": 1,
      "pali": "Etaṁ kho saraṇaṁ khemaṁ, ",
      "english": "Such refuge is a sanctuary, "
    },
    {
      "number": 2,
      "pali": "etaṁ saraṇamuttamaṁ; ",
      "english": "it is the supreme refuge. "
    },
    {
      "number": 3,
      "pali": "Etaṁ saraṇamāgamma, ",
      "english": "By going to that refuge, "
    },
    {
      "number": 4,
      "pali": "sabbadukkhā pamuccati. ",
      "english": "you’re released from all suffering. "
    }
  ]
}