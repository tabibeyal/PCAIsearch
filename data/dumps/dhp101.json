      "pali": "Bāhiyadārucīriyattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sahassamapi ce gāthā, ",
      "english": "Better than a thousand "
    },
    {
      "number": 3,
      "pali": "anatthapadasaṁhitā; ",
      "english": "meaningless verses "
    },
    {
      "number": 4,
      "pali": "Ekaṁ gāthāpadaṁ seyyo, ",
      "english": "is a single meaningful verse, "
    },
    {
