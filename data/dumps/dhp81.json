{
  "sutta_id": "DHP81",
  "verses": [
    {
      "number": 1,
      "pali": "Lakuṇḍakabhaddiyattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Selo yathā ekaghano, ",
      "english": "As the wind cannot stir "
    },
    {
      "number": 3,
      "pali": "vātena na samīrati; ",
      "english": "a solid mass of rock, "
    },
    {
      "number": 4,
      "pali": "Evaṁ nindāpasaṁsāsu, ",
      "english": "so too blame and praise "
    },
    {
      "number": 5,
      "pali": "na samiñjanti paṇḍitā. ",
      "english": "do not affect the wise. "
    }
  ]
}