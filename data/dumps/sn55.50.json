    },
    {
      "number": 2,
      "pali": "5. Sagāthakapuññābhisandavagga ",
      "english": "5. Overflowing Merit, With Verses "
    },
    {
      "number": 3,
      "pali": "Aṅgasutta ",
      "english": "Factors "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, sotāpattiyaṅgāni. ",
      "english": "“Mendicants, there are these four factors for stream-entry. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Sappurisasaṁsevo, saddhammassavanaṁ, yonisomanasikāro, dhammānudhammappaṭipatti—",
      "english": "Associating with true persons, listening to the true teaching, rational application of mind, and practicing in line with the teaching. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, cattāri sotāpattiyaṅgānī”ti. ",
      "english": "These are the four factors for stream-entry.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Sagāthakapuññābhisandavaggo pañcamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Abhisandā tayo vuttā, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Duve mahaddhanena ca; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Suddhaṁ nandiyaṁ bhaddiyaṁ, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Mahānāmaṅgena te dasāti. ",
      "english": ""
    }
  ]
}