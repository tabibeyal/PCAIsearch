      "pali": "Piyavagga ",
      "english": "16. The Beloved "
    },
    {
      "number": 4,
      "pali": "Tayojanapabbajitavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Ayoge yuñjamattānaṁ, ",
      "english": "Applying yourself where you ought not, "
    },
    {
      "number": 6,
      "pali": "yogasmiñca ayojayaṁ; ",
      "english": "neglecting what you should be doing, "
    },
    {
      "number": 7,
      "pali": "Atthaṁ hitvā piyaggāhī, ",
      "english": "forgetting your goal, you cling to what you hold dear, "
    },
    {
      "number": 8,
      "pali": "pihetattānuyoginaṁ. ",
      "english": "jealous of those devoted to their heart’s goal. "
    }
  ]
