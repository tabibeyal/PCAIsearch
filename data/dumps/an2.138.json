  "verses": [
    {
      "number": 1,
      "pali": "138 ",
      "english": "138 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Sacittavodānañca na ca kiñci loke upādiyati. ",
      "english": "Cleaning your own mind, and not grasping at anything in the world. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}