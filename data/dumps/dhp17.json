{
  "sutta_id": "DHP17",
  "verses": [
    {
      "number": 1,
      "pali": "Devadattavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idha tappati pecca tappati, ",
      "english": "Here they’re tormented, <j>hereafter they’re tormented, "
    },
    {
      "number": 3,
      "pali": "Pāpakārī ubhayattha tappati; ",
      "english": "an evildoer is tormented in both places. "
    },
    {
      "number": 4,
      "pali": "“Pāpaṁ me katan”ti tappati, ",
      "english": "They’re tormented <j>thinking of bad things they’ve done; "
    },
    {
      "number": 5,
      "pali": "Bhiyyo tappati duggatiṁ gato. ",
      "english": "when gone to a bad place, <j>they’re tormented all the more. "
    }
  ]
}