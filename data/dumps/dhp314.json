{
  "sutta_id": "DHP314",
  "verses": [
    {
      "number": 1,
      "pali": "Issāpakataitthivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akataṁ dukkaṭaṁ seyyo, ",
      "english": "A bad deed is better left undone, "
    },
    {
      "number": 3,
      "pali": "pacchā tappati dukkaṭaṁ; ",
      "english": "for it will plague you later on. "
    },
    {
      "number": 4,
      "pali": "Katañca sukataṁ seyyo, ",
      "english": "A good deed is better done, "
    },
    {
      "number": 5,
      "pali": "yaṁ katvā nānutappati. ",
      "english": "one that does not plague you. "
    }
  ]
}