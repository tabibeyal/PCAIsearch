{
  "sutta_id": "ITI96",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 96",
      "english": "Itivuttaka 96"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Tied by the yoke of sensuality & the yoke of becoming, monks, one is a returner, returning to this state. Untied from the yoke of sensuality but tied by the yoke of becoming, one is a non-returner, not returning to this state. Untied from [both] the yoke of sensuality & from the yoke of becoming, one is an Arahant whose effluents are ended.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Tied by both"
    },
    {
      "number": 5,
      "pali": "",
      "english": "the yoke of sensuality"
    },
    {
      "number": 6,
      "pali": "",
      "english": "& the yoke of becoming,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "beings go to the wandering-on"
    },
    {
      "number": 8,
      "pali": "",
      "english": "leading to birth"
    },
    {
      "number": 9,
      "pali": "",
      "english": "& death."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Those who’ve abandoned the sensual"
    },
    {
      "number": 11,
      "pali": "",
      "english": "without reaching the ending of effluents,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "are tied by the yoke of becoming,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "are said to be Non-returners."
    },
    {
      "number": 14,
      "pali": "",
      "english": "While those who’ve cut off doubt"
    },
    {
      "number": 15,
      "pali": "",
      "english": "have no more conceit"
    },
    {
      "number": 16,
      "pali": "",
      "english": "or further becoming."
    },
    {
      "number": 17,
      "pali": "",
      "english": "They who have reached"
    },
    {
      "number": 18,
      "pali": "",
      "english": "the ending of effluents,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "while in the world"
    },
    {
      "number": 20,
      "pali": "",
      "english": "have gone"
    },
    {
      "number": 21,
      "pali": "",
      "english": "beyond."
    }
  ]
}