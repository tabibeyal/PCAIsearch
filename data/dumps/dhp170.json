{
  "sutta_id": "DHP170",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcasatavipassakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathā pubbuḷakaṁ passe, ",
      "english": "Look upon the world "
    },
    {
      "number": 3,
      "pali": "yathā passe marīcikaṁ; ",
      "english": "as a bubble "
    },
    {
      "number": 4,
      "pali": "Evaṁ lokaṁ avekkhantaṁ, ",
      "english": "or a mirage, "
    },
    {
      "number": 5,
      "pali": "maccurājā na passati. ",
      "english": "then the King of Death won’t see you. "
    }
  ]
}