{
  "sutta_id": "AN5.38",
  "verses": [
    {
      "number": 1,
      "pali": "Numerical Discourses 5.38",
      "english": "Numerical Discourses 5.38"
    },
    {
      "number": 2,
      "pali": "Saddha Sutta",
      "english": "Conviction"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“These are the five rewards of conviction in a lay person. Which five?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“When the truly good people in the world show compassion, they will first show compassion to people of conviction, and not to people without conviction. When visiting, they first visit people of conviction, and not people without conviction. When accepting gifts, they will first accept those from people with conviction, and not from people without conviction. When teaching the Dhamma, they will first teach those with conviction, and not those without conviction. A person of conviction, on the break-up of the body, after death, will arise in a good destination, a heavenly world. These are the five rewards of conviction in a lay person."
    },
    {
      "number": 5,
      "pali": "",
      "english": "“Just as a large banyan tree, on level ground where four roads meet, is a haven for the birds all around, even so a lay person of conviction is a haven for many people: monks, nuns, male lay followers, & female lay followers.”"
    },
    {
      "number": 6,
      "pali": "",
      "english": "A massive tree"
    },
    {
      "number": 7,
      "pali": "",
      "english": "whose branches carry fruits & leaves,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "with trunks & roots"
    },
    {
      "number": 9,
      "pali": "",
      "english": "& an abundance of fruits:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "There the birds find rest."
    },
    {
      "number": 11,
      "pali": "",
      "english": "In that delightful sphere"
    },
    {
      "number": 12,
      "pali": "",
      "english": "they make their home."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Those seeking shade"
    },
    {
      "number": 14,
      "pali": "",
      "english": "come to the shade,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "those seeking fruit"
    },
    {
      "number": 16,
      "pali": "",
      "english": "find fruit to eat."
    },
    {
      "number": 17,
      "pali": "",
      "english": "So with the person consummate"
    },
    {
      "number": 18,
      "pali": "",
      "english": "in virtue & conviction,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "humble, sensitive, gentle,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "delightful, & mild:"
    },
    {
      "number": 21,
      "pali": "",
      "english": "To him come those without effluent—"
    },
    {
      "number": 22,
      "pali": "",
      "english": "free from passion,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "free from aversion,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "free from delusion—"
    },
    {
      "number": 25,
      "pali": "",
      "english": "the field of merit for the world."
    },
    {
      "number": 26,
      "pali": "",
      "english": "They teach him the Dhamma"
    },
    {
      "number": 27,
      "pali": "",
      "english": "that dispels all stress."
    },
    {
      "number": 28,
      "pali": "",
      "english": "And when he understands,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "he is freed from effluents,"
    },
    {
      "number": 30,
      "pali": "",
      "english": "totally unbound."
    }
  ]
}