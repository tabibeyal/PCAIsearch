{
  "sutta_id": "ITI63",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 63 ",
      "english": "So It Was Said 63 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Addhāsutta ",
      "english": "Periods "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, addhā. ",
      "english": "“Mendicants, there are these three periods. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Atīto addhā, anāgato addhā, paccuppanno addhā—",
      "english": "Past, future, and present. "
    },
    {
      "number": 9,
      "pali": "ime kho, bhikkhave, tayo addhā”ti. ",
      "english": "These are the three periods.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Akkheyyasaññino sattā, ",
      "english": "“Sentient beings who perceive the communicable, "
    },
    {
      "number": 13,
      "pali": "akkheyyasmiṁ patiṭṭhitā; ",
      "english": "become established in the communicable. "
    },
    {
      "number": 14,
      "pali": "Akkheyyaṁ apariññāya, ",
      "english": "Not understanding the communicable, "
    },
    {
      "number": 15,
      "pali": "yogamāyanti maccuno. ",
      "english": "they fall under the yoke of Death. "
    },
    {
      "number": 16,
      "pali": "Akkheyyañca pariññāya, ",
      "english": "But having fully understood the communicable, "
    },
    {
      "number": 17,
      "pali": "akkhātāraṁ na maññati; ",
      "english": "they don’t conceive a communicator, "
    },
    {
      "number": 18,
      "pali": "Phuṭṭho vimokkho manasā, ",
      "english": "as they’ve touched liberation with their mind, "
    },
    {
      "number": 19,
      "pali": "santipadamanuttaraṁ. ",
      "english": "the supreme state of peace. "
    },
    {
      "number": 20,
      "pali": "Sa ve akkheyyasampanno, ",
      "english": "Accomplished in the communicable, "
    },
    {
      "number": 21,
      "pali": "santo santipade rato; ",
      "english": "peaceful, in love with the state of peace; "
    },
    {
      "number": 22,
      "pali": "Saṅkhāya sevī dhammaṭṭho, ",
      "english": "making use after reflection, firm in principle, "
    },
    {
      "number": 23,
      "pali": "saṅkhyaṁ nopeti vedagū”ti. ",
      "english": "a knowledge master cannot be reckoned.” "
    },
    {
      "number": 24,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 25,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}