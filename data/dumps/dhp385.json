{
  "sutta_id": "DHP385",
  "verses": [
    {
      "number": 1,
      "pali": "Māravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa pāraṁ apāraṁ vā, ",
      "english": "One for whom there is no crossing over "
    },
    {
      "number": 3,
      "pali": "pārāpāraṁ na vijjati; ",
      "english": "or crossing back, or crossing over and back; "
    },
    {
      "number": 4,
      "pali": "Vītaddaraṁ visaṁyuttaṁ, ",
      "english": "stress-free, detached, "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}