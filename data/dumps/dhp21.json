    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 21–32 "
    },
    {
      "number": 3,
      "pali": "Appamādavagga ",
      "english": "2. Diligence "
    },
    {
      "number": 4,
      "pali": "Sāmāvatīvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Appamādo amatapadaṁ, ",
      "english": "Heedfulness is the state free of death; "
    },
    {
      "number": 6,
      "pali": "pamādo maccuno padaṁ; ",
      "english": "heedlessness is the state of death. "
    },
    {
      "number": 7,
      "pali": "Appamattā na mīyanti, ",
      "english": "The heedful do not die, "
    },
    {
      "number": 8,
      "pali": "ye pamattā yathā matā. ",
      "english": "while the heedless are like the dead. "
    }
  ]
}