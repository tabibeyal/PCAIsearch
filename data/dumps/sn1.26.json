{
  "sutta_id": "SN1.26",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.26 ",
      "english": "Linked Discourses 1.26 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Pajjotasutta ",
      "english": "Lamps "
    },
    {
      "number": 4,
      "pali": "“Kati lokasmiṁ pajjotā, ",
      "english": "“How many lamps are there "
    },
    {
      "number": 5,
      "pali": "Tehi loko pakāsati; ",
      "english": "that light up the world? "
    },
    {
      "number": 6,
      "pali": "Bhagavantaṁ puṭṭhumāgamma, ",
      "english": "We’ve come to ask you, worthy sir: "
    },
    {
      "number": 7,
      "pali": "Kathaṁ jānemu taṁ mayan”ti. ",
      "english": "how are we to understand this?” "
    },
    {
      "number": 8,
      "pali": "“Cattāro loke pajjotā, ",
      "english": "“There are four lamps in the world, "
    },
    {
      "number": 9,
      "pali": "pañcamettha na vijjati; ",
      "english": "a fifth is not found. "
    },
    {
      "number": 10,
      "pali": "Divā tapati ādicco, ",
      "english": "The sun blazes by day, "
    },
    {
      "number": 11,
      "pali": "rattimābhāti candimā. ",
      "english": "the moon radiates at night, "
    },
    {
      "number": 12,
      "pali": "Atha aggi divārattiṁ, ",
      "english": "while a fire illuminates both "
    },
    {
      "number": 13,
      "pali": "tattha tattha pakāsati; ",
      "english": "by day and by night. "
    },
    {
      "number": 14,
      "pali": "Sambuddho tapataṁ seṭṭho, ",
      "english": "But a Buddha is the best of blazes: "
    },
    {
      "number": 15,
      "pali": "esā ābhā anuttarā”ti. ",
      "english": "this is the supreme radiance.” "
    }
  ]
}