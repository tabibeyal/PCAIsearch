  "sutta_id": "SN22.131",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.131 ",
      "english": "Linked Discourses 22.131 "
    },
    {
      "number": 2,
      "pali": "13. Avijjāvagga ",
      "english": "13. Ignorance "
    },
    {
      "number": 3,
      "pali": "Samudayasutta ",
      "english": "Origin "
    },
    {
      "number": 4,
      "pali": "Bārāṇasiyaṁ viharanti isipatane migadāye …pe… ",
      "english": "At Varanasi. "
    },
    {
      "number": 5,
      "pali": "“‘avijjā, avijjā’ti, āvuso sāriputta, vuccati. ",
      "english": "“Reverend Sāriputta, they speak of this thing called ‘ignorance’. "
    },
    {
      "number": 6,
      "pali": "Katamā nu kho, āvuso, avijjā; ",
      "english": "What is ignorance? "
    },
    {
      "number": 7,
      "pali": "kittāvatā ca avijjāgato hotī”ti? ",
      "english": "And how is an ignoramus defined?” "
    },
    {
      "number": 8,
      "pali": "“Idhāvuso, assutavā puthujjano rūpassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṁ nappajānāti. ",
      "english": "“Reverend, an unlearned ordinary person doesn’t truly understand the origin, the disappearance, the gratification, the drawback, and the escape when it comes to form, "
    },
    {
      "number": 9,
      "pali": "Vedanāya …pe… ",
      "english": "feeling, "
    },
    {
      "number": 10,
      "pali": "saññāya … ",
      "english": "perception, "
    },
    {
      "number": 11,
      "pali": "saṅkhārānaṁ … ",
      "english": "choices, "
    },
    {
      "number": 12,
      "pali": "viññāṇassa samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṁ nappajānāti. ",
      "english": "and consciousness. "
    },
    {
      "number": 13,
      "pali": "Ayaṁ vuccatāvuso, avijjā; ",
      "english": "This is called ignorance. "
    },
    {
      "number": 14,
      "pali": "ettāvatā ca avijjāgato hotī”ti. ",
      "english": "And this is how an ignoramus is defined.” "
    },
    {
      "number": 15,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}