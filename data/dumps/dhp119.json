{
  "sutta_id": "DHP119",
  "verses": [
    {
      "number": 1,
      "pali": "Anāthapiṇḍikaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pāpopi passati bhadraṁ, ",
      "english": "Even the wicked see good things, "
    },
    {
      "number": 3,
      "pali": "Yāva pāpaṁ na paccati; ",
      "english": "so long as their wickedness has not ripened. "
    },
    {
      "number": 4,
      "pali": "Yadā ca paccati pāpaṁ, ",
      "english": "But as soon as that wickedness ripens, "
    },
    {
      "number": 5,
      "pali": "Atha pāpo pāpāni passati. ",
      "english": "then the wicked see wicked things. "
    }
  ]
}