{
  "sutta_id": "DHP402",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo dukkhassa pajānāti, ",
      "english": "They understand for themselves "
    },
    {
      "number": 3,
      "pali": "idheva khayamattano; ",
      "english": "the end of suffering in this life; "
    },
    {
      "number": 4,
      "pali": "Pannabhāraṁ visaṁyuttaṁ, ",
      "english": "with burden put down, detached: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}