{
  "sutta_id": "DHP258",
  "verses": [
    {
      "number": 1,
      "pali": "Chabbaggiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na tena paṇḍito hoti, ",
      "english": "You’re not an astute scholar "
    },
    {
      "number": 3,
      "pali": "yāvatā bahu bhāsati; ",
      "english": "just because you speak a lot. "
    },
    {
      "number": 4,
      "pali": "Khemī averī abhayo, ",
      "english": "One who is secure, free of enmity and fear, "
    },
    {
      "number": 5,
      "pali": "“paṇḍito”ti pavuccati. ",
      "english": "is said to be astute. "
    }
  ]
}