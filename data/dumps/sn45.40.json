{
  "sutta_id": "SN45.40",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.40 ",
      "english": "Linked Discourses 45.40 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Dutiyabrahmacariyasutta ",
      "english": "The Spiritual Path (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Brahmacariyañca vo, bhikkhave, desessāmi, brahmacariyatthañca. ",
      "english": "“Mendicants, I will teach you the spiritual path and the goal of the spiritual path. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, brahmacariyaṁ? ",
      "english": "And what is the spiritual path? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, brahmacariyaṁ. ",
      "english": "This is called the spiritual path. "
    },
    {
      "number": 11,
      "pali": "Katamo ca, bhikkhave, brahmacariyattho? ",
      "english": "And what is the goal of the spiritual path? "
    },
    {
      "number": 12,
      "pali": "Yo kho, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, brahmacariyattho”ti. ",
      "english": "This is called the goal of the spiritual path.” "
    },
    {
      "number": 14,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Paṭipattivaggo catuttho. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Paṭipatti paṭipanno ca, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "viraddhañca pāraṅgamā; ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Sāmaññena ca dve vuttā, ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "brahmaññā apare duve; ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Brahmacariyena dve vuttā, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "vaggo tena pavuccatīti. ",
      "english": ""
    }
  ]
}