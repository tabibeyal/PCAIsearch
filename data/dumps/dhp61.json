{
  "sutta_id": "DHP61",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākassapasaddhivihārikavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Carañce nādhigaccheyya, ",
      "english": "If while wandering you find no partner "
    },
    {
      "number": 3,
      "pali": "Seyyaṁ sadisamattano; ",
      "english": "equal or better than yourself, "
    },
    {
      "number": 4,
      "pali": "Ekacariyaṁ daḷhaṁ kayirā, ",
      "english": "then firmly resolve to wander alone—"
    },
    {
      "number": 5,
      "pali": "Natthi bāle sahāyatā. ",
      "english": "there’s no fellowship with fools. "
    }
  ]
}