{
  "sutta_id": "DHP409",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yodha dīghaṁ va rassaṁ vā, ",
      "english": "They don’t steal anything in the world, "
    },
    {
      "number": 3,
      "pali": "aṇuṁ thūlaṁ subhāsubhaṁ; ",
      "english": "long or short, "
    },
    {
      "number": 4,
      "pali": "Loke adinnaṁ nādiyati, ",
      "english": "fine or coarse, beautiful or ugly: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}