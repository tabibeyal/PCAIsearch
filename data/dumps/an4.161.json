{
  "sutta_id": "AN4.161",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.161 ",
      "english": "Numbered Discourses 4.161 "
    },
    {
      "number": 2,
      "pali": "17. Paṭipadāvagga ",
      "english": "17. Practice "
    },
    {
      "number": 3,
      "pali": "Saṅkhittasutta ",
      "english": "In Brief "
    },
    {
      "number": 4,
      "pali": "“Catasso imā, bhikkhave, paṭipadā. ",
      "english": "“Mendicants, there are four ways of practice. "
    },
    {
      "number": 5,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Dukkhā paṭipadā dandhābhiññā, ",
      "english": "Painful practice with slow insight, "
    },
    {
      "number": 7,
      "pali": "dukkhā paṭipadā khippābhiññā, ",
      "english": "painful practice with swift insight, "
    },
    {
      "number": 8,
      "pali": "sukhā paṭipadā dandhābhiññā, ",
      "english": "pleasant practice with slow insight, and "
    },
    {
      "number": 9,
      "pali": "sukhā paṭipadā khippābhiññā—",
      "english": "pleasant practice with swift insight. "
    },
    {
      "number": 10,
      "pali": "imā kho, bhikkhave, catasso paṭipadā”ti. ",
      "english": "These are the four ways of practice.” "
    },
    {
      "number": 11,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}