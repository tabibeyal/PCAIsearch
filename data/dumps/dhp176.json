{
  "sutta_id": "DHP176",
  "verses": [
    {
      "number": 1,
      "pali": "Ciñcamāṇavikāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ekaṁ dhammaṁ atītassa, ",
      "english": "When a personage, spurning the hereafter, "
    },
    {
      "number": 3,
      "pali": "musāvādissa jantuno; ",
      "english": "transgresses in just one thing—"
    },
    {
      "number": 4,
      "pali": "Vitiṇṇaparalokassa, ",
      "english": "lying—"
    },
    {
      "number": 5,
      "pali": "natthi pāpaṁ akāriyaṁ. ",
      "english": "there is no evil they would not do. "
    }
  ]
}