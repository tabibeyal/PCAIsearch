{
  "sutta_id": "DHP135",
  "verses": [
    {
      "number": 1,
      "pali": "Uposathikaitthīnaṁvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathā daṇḍena gopālo, ",
      "english": "As a cowherd drives the cows "
    },
    {
      "number": 3,
      "pali": "gāvo pājeti gocaraṁ; ",
      "english": "to pasture with the rod, "
    },
    {
      "number": 4,
      "pali": "Evaṁ jarā ca maccu ca, ",
      "english": "so too old age and death "
    },
    {
      "number": 5,
      "pali": "āyuṁ pājenti pāṇinaṁ. ",
      "english": "drive life from living beings. "
    }
  ]
}