  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.25",
      "english": "Linked Discourses 1.25"
    },
    {
      "number": 2,
      "pali": "Arahanta Sutta",
      "english": "An Arahant"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“An arahant monk,"
    },
    {
      "number": 4,
      "pali": "",
      "english": "one who is done,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "effluent-free, bearing his last body:"
    },
    {
      "number": 6,
      "pali": "",
      "english": "Would he say, ‘I speak’?"
    },
    {
      "number": 7,
      "pali": "",
      "english": "Would he say, ‘They speak to me’?”"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“An arahant monk,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "one who is done,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "effluent-free, bearing his last body:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "He would say, ‘I speak’;"
    },
    {
      "number": 12,
      "pali": "",
      "english": "would say, ‘They speak to me.’"
    },
    {
      "number": 13,
      "pali": "",
      "english": "Skillful,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "knowing harmonious gnosis"
    },
    {
      "number": 15,
      "pali": "",
      "english": "with regard to the world,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "he uses expressions"
    },
    {
      "number": 17,
      "pali": "",
      "english": "just as expressions.”"
    },
    {
      "number": 18,
      "pali": "",
      "english": "“An arahant monk,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "one who is done,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "effluent-free, bearing his last body:"
    },
    {
      "number": 21,
      "pali": "",
      "english": "Is it from conceit"
    },
    {
      "number": 22,
      "pali": "",
      "english": "that he’d say, ‘ I speak’?—"
    },
    {
      "number": 23,
      "pali": "",
      "english": "that he’d say, ‘They speak to me’?”"
    },
    {
      "number": 24,
      "pali": "",
      "english": "“For one whose conceit is abandoned,"
    },
    {
      "number": 25,
      "pali": "",
      "english": "whose knot of conceit is dispersed,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "no knots exist"
    },
    {
      "number": 27,
      "pali": "",
      "english": "at all."
    },
    {
      "number": 28,
      "pali": "",
      "english": "He, beyond any concept, wise,"
    },
    {
      "number": 29,
      "pali": "",
      "english": "would say, ‘I speak’;"
    },
    {
      "number": 30,
      "pali": "",
      "english": "would say, ‘They speak to me.’"
    },
    {
      "number": 31,
      "pali": "",
      "english": "Skillful,"
    },
    {
      "number": 32,
      "pali": "",
      "english": "knowing harmonious gnosis"
    },
    {
      "number": 33,
      "pali": "",
      "english": "with regard to the world,"
    },
    {
      "number": 34,
      "pali": "",
      "english": "he uses expressions"
    },
    {
      "number": 35,
      "pali": "",
      "english": "just as expressions.”"
    }
  ]
}