{
  "sutta_id": "DHP34",
  "verses": [
    {
      "number": 1,
      "pali": "Vārijova thale khitto, ",
      "english": "Like a fish pulled from the sea "
    },
    {
      "number": 2,
      "pali": "okamokataubbhato; ",
      "english": "and cast upon the shore, "
    },
    {
      "number": 3,
      "pali": "Pariphandatidaṁ cittaṁ, ",
      "english": "this mind flounders about, "
    },
    {
      "number": 4,
      "pali": "māradheyyaṁ pahātave. ",
      "english": "trying to throw off Māra’s dominion. "
    }
  ]
}