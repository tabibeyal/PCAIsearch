{
  "sutta_id": "DHP246",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo pāṇamatipāteti, ",
      "english": "Take anyone in this world "
    },
    {
      "number": 3,
      "pali": "musāvādañca bhāsati; ",
      "english": "who kills living creatures, "
    },
    {
      "number": 4,
      "pali": "Loke adinnamādiyati, ",
      "english": "speaks falsely, steals, "
    },
    {
      "number": 5,
      "pali": "paradārañca gacchati. ",
      "english": "commits adultery, "
    }
  ]
}