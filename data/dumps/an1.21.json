    {
      "number": 4,
      "pali": "“Nāhaṁ, bhikkhave, aññaṁ ekadhammampi samanupassāmi yaṁ evaṁ abhāvitaṁ akammaniyaṁ hoti yathayidaṁ, bhikkhave, cittaṁ. ",
      "english": "“Mendicants, I do not see a single thing that, when it’s not developed like this, is as unworkable as the mind. "
    },
    {
      "number": 5,
      "pali": "Cittaṁ, bhikkhave, abhāvitaṁ akammaniyaṁ hotī”ti. ",
      "english": "An undeveloped mind is unworkable.” "
    },
    {
      "number": 6,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
