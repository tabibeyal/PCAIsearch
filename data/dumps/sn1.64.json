{
  "sutta_id": "SN1.64",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.64",
      "english": "Linked Discourses 1.64"
    },
    {
      "number": 2,
      "pali": "Saññojana Sutta",
      "english": "Fettered"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“With what is the world fettered?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "What is its exploration?"
    },
    {
      "number": 5,
      "pali": "",
      "english": "With the abandoning"
    },
    {
      "number": 6,
      "pali": "",
      "english": "of what"
    },
    {
      "number": 7,
      "pali": "",
      "english": "is there said,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "‘unbinding’?”"
    },
    {
      "number": 9,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "“Fettered with delight is the world."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Directed thought is its exploration."
    },
    {
      "number": 12,
      "pali": "",
      "english": "With the abandoning"
    },
    {
      "number": 13,
      "pali": "",
      "english": "of craving"
    },
    {
      "number": 14,
      "pali": "",
      "english": "is there said,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "‘unbinding.’”"
    }
  ]
}