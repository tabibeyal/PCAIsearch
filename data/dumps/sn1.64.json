  "sutta_id": "SN1.64",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.64 ",
      "english": "Linked Discourses 1.64 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Saṁyojanasutta ",
      "english": "Fetter "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu saṁyojano loko, ",
      "english": "“What fetters the world? "
    },
    {
      "number": 5,
      "pali": "kiṁsu tassa vicāraṇaṁ; ",
      "english": "How does it travel about? "
    },
    {
      "number": 6,
      "pali": "Kissassu vippahānena, ",
      "english": "With the giving up of what "
    },
    {
      "number": 7,
      "pali": "nibbānaṁ iti vuccatī”ti. ",
      "english": "is extinguishment spoken of?” "
    },
    {
      "number": 8,
      "pali": "“Nandīsaṁyojano loko, ",
      "english": "“Delight fetters the world. "
    },
    {
      "number": 9,
      "pali": "vitakkassa vicāraṇaṁ; ",
      "english": "It travels about by means of thought. "
    },
    {
      "number": 10,
      "pali": "Taṇhāya vippahānena, ",
      "english": "With the giving up of craving "
    },
    {
      "number": 11,
      "pali": "nibbānaṁ iti vuccatī”ti. ",
      "english": "extinguishment is spoken of.” "
    }
  ]
}