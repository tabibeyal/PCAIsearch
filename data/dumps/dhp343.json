{
  "sutta_id": "DHP343",
  "verses": [
    {
      "number": 1,
      "pali": "Tasiṇāya purakkhatā pajā, ",
      "english": "People governed by thirst, "
    },
    {
      "number": 2,
      "pali": "Parisappanti sasova bandhito; ",
      "english": "crawl about like a trapped rabbit. "
    },
    {
      "number": 3,
      "pali": "Tasmā tasiṇaṁ vinodaye, ",
      "english": "That’s why one who longs for dispassion "
    },
    {
      "number": 4,
      "pali": "Ākaṅkhanta virāgamattano. ",
      "english": "should dispel thirst. "
    }
  ]
}