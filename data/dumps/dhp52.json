{
  "sutta_id": "DHP52",
  "verses": [
    {
      "number": 1,
      "pali": "Yathāpi ruciraṁ pupphaṁ, ",
      "english": "Just like a glorious flower "
    },
    {
      "number": 2,
      "pali": "Vaṇṇavantaṁ sagandhakaṁ; ",
      "english": "that’s both colorful and fragrant, "
    },
    {
      "number": 3,
      "pali": "Evaṁ subhāsitā vācā, ",
      "english": "eloquent speech is fruitful "
    },
    {
      "number": 4,
      "pali": "Saphalā hoti kubbato. ",
      "english": "for one who acts on it. "
    }
  ]
}