{
  "sutta_id": "DHP309",
  "verses": [
    {
      "number": 1,
      "pali": "Khemakaseṭṭhiputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Cattāri ṭhānāni naro pamatto, ",
      "english": "Four things befall a heedless man "
    },
    {
      "number": 3,
      "pali": "Āpajjati paradārūpasevī; ",
      "english": "who sleeps with another’s wife: "
    },
    {
      "number": 4,
      "pali": "Apuññalābhaṁ na nikāmaseyyaṁ, ",
      "english": "wickedness, poor sleep, "
    },
    {
      "number": 5,
      "pali": "Nindaṁ tatīyaṁ nirayaṁ catutthaṁ. ",
      "english": "ill-repute, and rebirth in hell. "
    }
  ]
}