{
  "sutta_id": "DHP259",
  "verses": [
    {
      "number": 1,
      "pali": "Ekudānakhīṇāsavavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na tāvatā dhammadharo, ",
      "english": "You’re not one who has memorized the teaching "
    },
    {
      "number": 3,
      "pali": "yāvatā bahu bhāsati; ",
      "english": "just because you recite a lot. "
    },
    {
      "number": 4,
      "pali": "Yo ca appampi sutvāna, ",
      "english": "Someone who directly sees the teaching "
    },
    {
      "number": 5,
      "pali": "dhammaṁ kāyena passati; ",
      "english": "after hearing only a little "
    },
    {
      "number": 6,
      "pali": "Sa ve dhammadharo hoti, ",
      "english": "is truly one who has memorized the teaching, "
    },
    {
      "number": 7,
      "pali": "yo dhammaṁ nappamajjati. ",
      "english": "for they can never forget it. "
    }
  ]
}