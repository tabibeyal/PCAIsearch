{
  "sutta_id": "AN4.32",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.32 ",
      "english": "Numbered Discourses 4.32 "
    },
    {
      "number": 2,
      "pali": "4. Cakkavagga ",
      "english": "4. Situations "
    },
    {
      "number": 3,
      "pali": "Saṅgahasutta ",
      "english": "Inclusion "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, saṅgahavatthūni. ",
      "english": "“Mendicants, there are these four ways of being inclusive. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Dānaṁ, peyyavajjaṁ, atthacariyā, samānattatā—",
      "english": "Giving, kindly words, taking care, and equality. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri saṅgahavatthūnīti. ",
      "english": "These are the four ways of being inclusive. "
    },
    {
      "number": 8,
      "pali": "Dānañca peyyavajjañca, ",
      "english": "Giving and kindly words, "
    },
    {
      "number": 9,
      "pali": "atthacariyā ca yā idha; ",
      "english": "taking care here, "
    },
    {
      "number": 10,
      "pali": "Samānattatā ca dhammesu, ",
      "english": "and treating equally in worldly conditions, "
    },
    {
      "number": 11,
      "pali": "tattha tattha yathārahaṁ; ",
      "english": "as they deserve in each case. "
    },
    {
      "number": 12,
      "pali": "Ete kho saṅgahā loke, ",
      "english": "These ways of being inclusive in the world "
    },
    {
      "number": 13,
      "pali": "rathassāṇīva yāyato. ",
      "english": "are like a moving chariot’s linchpin. "
    },
    {
      "number": 14,
      "pali": "Ete ca saṅgahā nāssu, ",
      "english": "If there were no such ways of being inclusive, "
    },
    {
      "number": 15,
      "pali": "na mātā puttakāraṇā; ",
      "english": "neither mother nor father "
    },
    {
      "number": 16,
      "pali": "Labhetha mānaṁ pūjaṁ vā, ",
      "english": "would be respected and honored "
    },
    {
      "number": 17,
      "pali": "pitā vā puttakāraṇā. ",
      "english": "for what they’ve done for their children. "
    },
    {
      "number": 18,
      "pali": "Yasmā ca saṅgahā ete, ",
      "english": "But since these ways of being inclusive do exist, "
    },
    {
      "number": 19,
      "pali": "samavekkhanti paṇḍitā; ",
      "english": "the astute do regard them well, "
    },
    {
      "number": 20,
      "pali": "Tasmā mahattaṁ papponti, ",
      "english": "so they achieve greatness "
    },
    {
      "number": 21,
      "pali": "pāsaṁsā ca bhavanti te”ti. ",
      "english": "and are praised.” "
    },
    {
      "number": 22,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}