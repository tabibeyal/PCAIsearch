{
  "sutta_id": "DHP399",
  "verses": [
    {
      "number": 1,
      "pali": "Akkosakabhāradvājavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akkosaṁ vadhabandhañca, ",
      "english": "Abuse, killing, caging: "
    },
    {
      "number": 3,
      "pali": "aduṭṭho yo titikkhati; ",
      "english": "they endure these without anger. "
    },
    {
      "number": 4,
      "pali": "Khantībalaṁ balānīkaṁ, ",
      "english": "Patience is their powerful army: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}