{
  "sutta_id": "SN22.17",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.17 ",
      "english": "Linked Discourses 22.17 "
    },
    {
      "number": 2,
      "pali": "2. Aniccavagga ",
      "english": "2. Impermanence "
    },
    {
      "number": 3,
      "pali": "Yadanattāsutta ",
      "english": "That Which is Not-Self "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Rūpaṁ, bhikkhave, anattā. ",
      "english": "“Mendicants, form is not-self. "
    },
    {
      "number": 6,
      "pali": "Yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 7,
      "pali": "Vedanā anattā … ",
      "english": "Feeling is not-self … "
    },
    {
      "number": 8,
      "pali": "saññā anattā … ",
      "english": "Perception is not-self … "
    },
    {
      "number": 9,
      "pali": "saṅkhārā anattā … ",
      "english": "Choices are not-self … "
    },
    {
      "number": 10,
      "pali": "viññāṇaṁ anattā. ",
      "english": "Consciousness is not-self. "
    },
    {
      "number": 11,
      "pali": "Yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 12,
      "pali": "Evaṁ passaṁ, bhikkhave …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 13,
      "pali": "nāparaṁ itthattāyā’ti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 14,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}