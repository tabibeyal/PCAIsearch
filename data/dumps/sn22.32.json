{
  "sutta_id": "SN22.32",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.32 ",
      "english": "Linked Discourses 22.32 "
    },
    {
      "number": 2,
      "pali": "3. Bhāravagga ",
      "english": "3. The Burden "
    },
    {
      "number": 3,
      "pali": "Pabhaṅgusutta ",
      "english": "Brittle "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Pabhaṅguñca, bhikkhave, desessāmi appabhaṅguñca. ",
      "english": "“Mendicants, I will teach you what is brittle and what is not brittle. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Kiñca, bhikkhave, pabhaṅgu, kiṁ appabhaṅgu? ",
      "english": "And what is brittle? What is not brittle? "
    },
    {
      "number": 8,
      "pali": "Rūpaṁ, bhikkhave, pabhaṅgu. ",
      "english": "Form is brittle, "
    },
    {
      "number": 9,
      "pali": "Yo tassa nirodho vūpasamo atthaṅgamo, idaṁ appabhaṅgu. ",
      "english": "but its cessation, settling, and ending is not brittle. "
    },
    {
      "number": 10,
      "pali": "Vedanā pabhaṅgu. ",
      "english": "Feeling … "
    },
    {
      "number": 11,
      "pali": "Yo tassā nirodho vūpasamo atthaṅgamo, idaṁ appabhaṅgu. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Saññā pabhaṅgu … ",
      "english": "perception … "
    },
    {
      "number": 13,
      "pali": "saṅkhārā pabhaṅgu. ",
      "english": "choices … "
    },
    {
      "number": 14,
      "pali": "Yo tesaṁ nirodho vūpasamo atthaṅgamo, idaṁ appabhaṅgu. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Viññāṇaṁ pabhaṅgu. ",
      "english": "consciousness is brittle, "
    },
    {
      "number": 16,
      "pali": "Yo tassa nirodho vūpasamo atthaṅgamo, idaṁ appabhaṅgū”ti. ",
      "english": "but its cessation, settling, and ending is not brittle.” "
    },
    {
      "number": 17,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Bhāravaggo tatiyo. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Bhāraṁ pariññaṁ abhijānaṁ, ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "chandarāgaṁ catutthakaṁ; ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Assādā ca tayo vuttā, ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "abhinandanamaṭṭhamaṁ; ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Uppādaṁ aghamūlañca, ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "ekādasamo pabhaṅgūti. ",
      "english": ""
    }
  ]
}