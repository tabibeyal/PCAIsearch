{
  "sutta_id": "DHP54",
  "verses": [
    {
      "number": 1,
      "pali": "Ānandattherapañhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na pupphagandho paṭivātameti, ",
      "english": "The fragrance of flowers doesn’t spread upwind, "
    },
    {
      "number": 3,
      "pali": "Na candanaṁ tagaramallikā vā; ",
      "english": "nor sandalwood, pinwheel, or jasmine; "
    },
    {
      "number": 4,
      "pali": "Satañca gandho paṭivātameti, ",
      "english": "but the fragrance of the good spreads upwind; "
    },
    {
      "number": 5,
      "pali": "Sabbā disā sappuriso pavāyati. ",
      "english": "a true person’s virtue spreads in every direction. "
    }
  ]
}