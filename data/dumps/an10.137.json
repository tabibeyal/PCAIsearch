{
  "sutta_id": "AN10.137",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.137 ",
      "english": "Numbered Discourses 10.137 "
    },
    {
      "number": 2,
      "pali": "14. Sādhuvagga ",
      "english": "14. Good "
    },
    {
      "number": 3,
      "pali": "Atthasutta ",
      "english": "Beneficial "
    },
    {
      "number": 4,
      "pali": "“Atthañca vo, bhikkhave, desessāmi anatthañca. ",
      "english": "“I will teach you the beneficial and the harmful. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, anattho? ",
      "english": "And what is the harmful? "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhi …pe… micchāvimutti—",
      "english": "Wrong view, wrong purpose, wrong speech, wrong action, wrong livelihood, wrong effort, wrong mindfulness, wrong immersion, wrong knowledge, and wrong freedom. "
    },
    {
      "number": 8,
      "pali": "ayaṁ vuccati, bhikkhave, anattho. ",
      "english": "This is called the harmful. "
    },
    {
      "number": 9,
      "pali": "Katamo ca, bhikkhave, attho? ",
      "english": "And what is the beneficial? "
    },
    {
      "number": 10,
      "pali": "Sammādiṭṭhi …pe… sammāvimutti—",
      "english": "Right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, right immersion, right knowledge, and right freedom. "
    },
    {
      "number": 11,
      "pali": "ayaṁ vuccati, bhikkhave, attho”ti. ",
      "english": "This is called the beneficial.” "
    },
    {
      "number": 12,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}