{
  "sutta_id": "DHP202",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarakuladārikāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Natthi rāgasamo aggi, ",
      "english": "There is no fire like greed, "
    },
    {
      "number": 3,
      "pali": "Natthi dosasamo kali; ",
      "english": "no crime like hate, "
    },
    {
      "number": 4,
      "pali": "Natthi khandhasamā dukkhā, ",
      "english": "no suffering like the aggregates, "
    },
    {
      "number": 5,
      "pali": "Natthi santiparaṁ sukhaṁ. ",
      "english": "no bliss beyond peace. "
    }
  ]
}