{
  "sutta_id": "DHP391",
  "verses": [
    {
      "number": 1,
      "pali": "Mahāpajāpatigotamīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassa kāyena vācāya, ",
      "english": "Who does nothing wrong "
    },
    {
      "number": 3,
      "pali": "manasā natthi dukkaṭaṁ; ",
      "english": "by body, speech or mind, "
    },
    {
      "number": 4,
      "pali": "Saṁvutaṁ tīhi ṭhānehi, ",
      "english": "restrained in these three respects, "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}