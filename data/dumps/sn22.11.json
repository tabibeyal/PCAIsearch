{
  "sutta_id": "SN22.11",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 22.11 ",
      "english": "Linked Discourses 22.11 "
    },
    {
      "number": 2,
      "pali": "1. Nakulapituvagga ",
      "english": "1. Nakula’s Father "
    },
    {
      "number": 3,
      "pali": "Kālattayaanattasutta ",
      "english": "Not-Self in the Three Times "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Rūpaṁ, bhikkhave, anattā atītānāgataṁ; ",
      "english": "“Mendicants, form of the past and future is not-self, "
    },
    {
      "number": 6,
      "pali": "ko pana vādo paccuppannassa. ",
      "english": "let alone the present. "
    },
    {
      "number": 7,
      "pali": "Evaṁ passaṁ, bhikkhave, sutavā ariyasāvako atītasmiṁ rūpasmiṁ anapekkho hoti; ",
      "english": "Seeing this, a learned noble disciple is not concerned with past form, "
    },
    {
      "number": 8,
      "pali": "anāgataṁ rūpaṁ nābhinandati; ",
      "english": "doesn’t look forward to enjoying future form, "
    },
    {
      "number": 9,
      "pali": "paccuppannassa rūpassa nibbidāya virāgāya nirodhāya paṭipanno hoti. ",
      "english": "and they practice for disillusionment, dispassion, and cessation regarding present form. "
    },
    {
      "number": 10,
      "pali": "Vedanā anattā … ",
      "english": "Feeling … "
    },
    {
      "number": 11,
      "pali": "saññā anattā … ",
      "english": "Perception … "
    },
    {
      "number": 12,
      "pali": "saṅkhārā anattā … ",
      "english": "Choices … "
    },
    {
      "number": 13,
      "pali": "viññāṇaṁ anattā atītānāgataṁ; ",
      "english": "Consciousness of the past and future is not-self, "
    },
    {
      "number": 14,
      "pali": "ko pana vādo paccuppannassa. ",
      "english": "let alone the present. "
    },
    {
      "number": 15,
      "pali": "Evaṁ passaṁ, bhikkhave, sutavā ariyasāvako atītasmiṁ viññāṇasmiṁ anapekkho hoti; ",
      "english": "Seeing this, a learned noble disciple is not concerned with past consciousness, "
    },
    {
      "number": 16,
      "pali": "anāgataṁ viññāṇaṁ nābhinandati; ",
      "english": "doesn’t look forward to enjoying future consciousness, "
    },
    {
      "number": 17,
      "pali": "paccuppannassa viññāṇassa nibbidāya virāgāya nirodhāya paṭipanno hotī”ti. ",
      "english": "and they practice for the disillusionment, dispassion, and cessation regarding present consciousness.” "
    },
    {
      "number": 18,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Nakulapituvaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Nakulapitā devadahā, ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Dvepi hāliddikāni ca; ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Samādhipaṭisallāṇā, ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Upādāparitassanā duve; ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Atītānāgatapaccuppannā, ",
      "english": ""
    },
    {
      "number": 26,
      "pali": "Vaggo tena pavuccati. ",
      "english": ""
    }
  ]
}