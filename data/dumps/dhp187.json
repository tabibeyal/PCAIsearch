{
  "sutta_id": "DHP187",
  "verses": [
    {
      "number": 1,
      "pali": "Api dibbesu kāmesu, ",
      "english": "Thus they find no delight "
    },
    {
      "number": 2,
      "pali": "ratiṁ so nādhigacchati; ",
      "english": "even in celestial pleasures. "
    },
    {
      "number": 3,
      "pali": "Taṇhakkhayarato hoti, ",
      "english": "A disciple of the fully awakened Buddha "
    },
    {
      "number": 4,
      "pali": "sammāsambuddhasāvako. ",
      "english": "delights in the ending of craving. "
    }
  ]
}