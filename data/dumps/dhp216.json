{
  "sutta_id": "DHP216",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Taṇhāya jāyatī soko, ",
      "english": "Sorrow springs from craving, "
    },
    {
      "number": 3,
      "pali": "taṇhāya jāyatī bhayaṁ; ",
      "english": "fear springs from craving; "
    },
    {
      "number": 4,
      "pali": "Taṇhāya vippamuttassa, ",
      "english": "one free from craving "
    },
    {
      "number": 5,
      "pali": "natthi soko kuto bhayaṁ. ",
      "english": "has no sorrow, let alone fear. "
    }
  ]
}