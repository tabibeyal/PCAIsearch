{
  "sutta_id": "ITI62",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 62",
      "english": "Itivuttaka 62"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three faculties. Which three? The faculty of ‘I am about to know what is not yet finally known,’ the faculty of final knowledge, the faculty of one who has finally known. These are the three faculties.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "For a learner in training"
    },
    {
      "number": 5,
      "pali": "",
      "english": "along the straight path:"
    },
    {
      "number": 6,
      "pali": "",
      "english": "first, the knowledge of ending;"
    },
    {
      "number": 7,
      "pali": "",
      "english": "then, immediately,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "gnosis;"
    },
    {
      "number": 9,
      "pali": "",
      "english": "then, from the ending"
    },
    {
      "number": 10,
      "pali": "",
      "english": "of the fetter–becoming–"
    },
    {
      "number": 11,
      "pali": "",
      "english": "there’s the knowledge,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "the gnosis of one released"
    },
    {
      "number": 13,
      "pali": "",
      "english": "who is Such:"
    },
    {
      "number": 14,
      "pali": "",
      "english": "‘My release is unprovoked.’"
    },
    {
      "number": 15,
      "pali": "",
      "english": "One consummate in these faculties,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "peaceful,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "delighting in the peaceful state,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "bears his last body,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "having conquered Māra"
    },
    {
      "number": 20,
      "pali": "",
      "english": "along with his mount."
    }
  ]
}