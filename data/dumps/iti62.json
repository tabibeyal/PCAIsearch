{
  "sutta_id": "ITI62",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 62 ",
      "english": "So It Was Said 62 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Indriyasutta ",
      "english": "Faculties "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these three faculties. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Anaññātaññassāmītindriyaṁ, aññindriyaṁ, aññātāvindriyaṁ—",
      "english": "The faculty of understanding that enlightenment is imminent. The faculty of enlightenment. The faculty of one who is enlightened. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi indriyānī”ti. ",
      "english": "These are the three faculties.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Sekhassa sikkhamānassa, ",
      "english": "“As a trainee trains, "
    },
    {
      "number": 13,
      "pali": "ujumaggānusārino; ",
      "english": "following the straight road, "
    },
    {
      "number": 14,
      "pali": "Khayasmiṁ paṭhamaṁ ñāṇaṁ, ",
      "english": "first they know about ending; "
    },
    {
      "number": 15,
      "pali": "tato aññā anantarā. ",
      "english": "enlightenment follows without delay. "
    },
    {
      "number": 16,
      "pali": "Tato aññāvimuttassa, ",
      "english": "Then the knowledge comes "
    },
    {
      "number": 17,
      "pali": "ñāṇaṁ ve hoti tādino; ",
      "english": "to such a one, freed through enlightenment, "
    },
    {
      "number": 18,
      "pali": "Akuppā me vimuttīti, ",
      "english": "with the end of the fetters of continued existence: "
    },
    {
      "number": 19,
      "pali": "bhavasaṁyojanakkhayā. ",
      "english": "‘My freedom is unshakable.’ "
    },
    {
      "number": 20,
      "pali": "Sa ve indriyasampanno, ",
      "english": "Accomplished in the faculties, "
    },
    {
      "number": 21,
      "pali": "santo santipade rato; ",
      "english": "peaceful, in love with the state of peace, "
    },
    {
      "number": 22,
      "pali": "Dhāreti antimaṁ dehaṁ, ",
      "english": "they bear their final body, "
    },
    {
      "number": 23,
      "pali": "jetvā māraṁ savāhinin”ti. ",
      "english": "having vanquished Māra with his legions.” "
    },
    {
      "number": 24,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 25,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}