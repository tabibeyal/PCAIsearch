      "english": "13. The World "
    },
    {
      "number": 4,
      "pali": "Daharabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Hīnaṁ dhammaṁ na seveyya, ",
      "english": "Don’t resort to lowly things, "
    },
    {
      "number": 6,
      "pali": "pamādena na saṁvase; ",
      "english": "don’t abide in negligence, "
    },
    {
      "number": 7,
      "pali": "Micchādiṭṭhiṁ na seveyya, ",
      "english": "don’t resort to wrong views, "
    },
    {
      "number": 8,
      "pali": "na siyā lokavaḍḍhano. ",
      "english": "don’t perpetuate the world. "
    }
