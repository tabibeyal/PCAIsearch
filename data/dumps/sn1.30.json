{
  "sutta_id": "SN1.30",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.30 ",
      "english": "Linked Discourses 1.30 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Eṇijaṅghasutta ",
      "english": "Antelope Calves "
    },
    {
      "number": 4,
      "pali": "“Eṇijaṅghaṁ kisaṁ vīraṁ, ",
      "english": "“O hero so lean, with antelope calves, "
    },
    {
      "number": 5,
      "pali": "appāhāraṁ alolupaṁ; ",
      "english": "not greedy, eating little, "
    },
    {
      "number": 6,
      "pali": "Sīhaṁvekacaraṁ nāgaṁ, ",
      "english": "a giant, wandering alone like a lion, "
    },
    {
      "number": 7,
      "pali": "kāmesu anapekkhinaṁ; ",
      "english": "you’re not concerned for sensual pleasures. "
    },
    {
      "number": 8,
      "pali": "Upasaṅkamma pucchāma, ",
      "english": "We’ve come to ask a question: "
    },
    {
      "number": 9,
      "pali": "kathaṁ dukkhā pamuccatī”ti. ",
      "english": "How is one released from all suffering?” "
    },
    {
      "number": 10,
      "pali": "“Pañca kāmaguṇā loke, ",
      "english": "“The world has five kinds of sensual stimulation, "
    },
    {
      "number": 11,
      "pali": "manochaṭṭhā paveditā; ",
      "english": "and the mind is said to be the sixth. "
    },
    {
      "number": 12,
      "pali": "Ettha chandaṁ virājetvā, ",
      "english": "When you’ve discarded desire for these, "
    },
    {
      "number": 13,
      "pali": "evaṁ dukkhā pamuccatī”ti. ",
      "english": "you’re released from all suffering.” "
    },
    {
      "number": 14,
      "pali": "Sattivaggo tatiyo. ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Sattiyā phusati ceva, ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "jaṭā manonivāraṇā; ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "Arahantena pajjoto, ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "sarā mahaddhanena ca; ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Catucakkena navamaṁ, ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "eṇijaṅghena te dasāti. ",
      "english": ""
    }
  ]
}