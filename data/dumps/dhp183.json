{
  "sutta_id": "DHP183",
  "verses": [
    {
      "number": 1,
      "pali": "Ānandattherapañhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbapāpassa akaraṇaṁ, ",
      "english": "Not to do any evil; "
    },
    {
      "number": 3,
      "pali": "kusalassa upasampadā; ",
      "english": "to embrace the good; "
    },
    {
      "number": 4,
      "pali": "Sacittapariyodapanaṁ, ",
      "english": "to purify one’s mind: "
    },
    {
      "number": 5,
      "pali": "etaṁ buddhāna sāsanaṁ. ",
      "english": "this is the instruction of the Buddhas. "
    }
  ]
}