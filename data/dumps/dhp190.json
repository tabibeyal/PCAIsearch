{
  "sutta_id": "DHP190",
  "verses": [
    {
      "number": 1,
      "pali": "Yo ca buddhañca dhammañca, ",
      "english": "One gone for refuge to the Buddha, "
    },
    {
      "number": 2,
      "pali": "saṅghañca saraṇaṁ gato; ",
      "english": "to his teaching and to the Saṅgha, "
    },
    {
      "number": 3,
      "pali": "Cattāri ariyasaccāni, ",
      "english": "sees the four noble truths "
    },
    {
      "number": 4,
      "pali": "sammappaññāya passati. ",
      "english": "with right understanding: "
    }
  ]
}