{
  "sutta_id": "DHP106",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattherassa mātulabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Māse māse sahassena, ",
      "english": "Rather than a thousandfold sacrifice, "
    },
    {
      "number": 3,
      "pali": "yo yajetha sataṁ samaṁ; ",
      "english": "every month for a full century, "
    },
    {
      "number": 4,
      "pali": "Ekañca bhāvitattānaṁ, ",
      "english": "it’s better to honor for a single hour "
    },
    {
      "number": 5,
      "pali": "muhuttamapi pūjaye; ",
      "english": "one who has developed themselves. "
    },
    {
      "number": 6,
      "pali": "Sāyeva pūjanā seyyo, ",
      "english": "That offering is better "
    },
    {
      "number": 7,
      "pali": "yañce vassasataṁ hutaṁ. ",
      "english": "than the hundred year sacrifice. "
    }
  ]
}