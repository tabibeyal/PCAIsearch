{
  "sutta_id": "SN1.65",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.65 ",
      "english": "Linked Discourses 1.65 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Bandhanasutta ",
      "english": "Bonds "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu sambandhano loko, ",
      "english": "“What binds the world? "
    },
    {
      "number": 5,
      "pali": "kiṁsu tassa vicāraṇaṁ; ",
      "english": "How does it travel about? "
    },
    {
      "number": 6,
      "pali": "Kissassu vippahānena, ",
      "english": "With the giving up of what "
    },
    {
      "number": 7,
      "pali": "sabbaṁ chindati bandhanan”ti. ",
      "english": "are all bonds severed?” "
    },
    {
      "number": 8,
      "pali": "“Nandīsambandhano loko, ",
      "english": "“Delight binds the world. "
    },
    {
      "number": 9,
      "pali": "vitakkassa vicāraṇaṁ; ",
      "english": "It travels about by means of thought. "
    },
    {
      "number": 10,
      "pali": "Taṇhāya vippahānena, ",
      "english": "With the giving up of craving "
    },
    {
      "number": 11,
      "pali": "sabbaṁ chindati bandhanan”ti. ",
      "english": "all bonds are severed.” "
    }
  ]
}