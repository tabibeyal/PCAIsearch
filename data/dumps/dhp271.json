{
  "sutta_id": "DHP271",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulasīlādisampannabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na sīlabbatamattena, ",
      "english": "Not by precepts and observances, "
    },
    {
      "number": 3,
      "pali": "bāhusaccena vā pana; ",
      "english": "nor by much learning, "
    },
    {
      "number": 4,
      "pali": "Atha vā samādhilābhena, ",
      "english": "nor by meditative immersion, "
    },
    {
      "number": 5,
      "pali": "vivittasayanena vā. ",
      "english": "nor by living in seclusion, "
    }
  ]
}