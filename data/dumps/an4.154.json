  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.154 ",
      "english": "Numbered Discourses 4.154 "
    },
    {
      "number": 2,
      "pali": "16. Indriyavagga ",
      "english": "16. Faculties "
    },
    {
      "number": 3,
      "pali": "Satibalasutta ",
      "english": "The Power of Mindfulness "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these four powers. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Satibalaṁ, samādhibalaṁ, anavajjabalaṁ, saṅgahabalaṁ—",
      "english": "The powers of mindfulness, immersion, blamelessness, and inclusiveness. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri balānī”ti. ",
      "english": "These are the four powers.” "
    },
    {
      "number": 8,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}