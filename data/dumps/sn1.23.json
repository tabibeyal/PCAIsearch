{
  "sutta_id": "SN1.23",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.23 ",
      "english": "Linked Discourses 1.23 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Jaṭāsutta ",
      "english": "A Tangle "
    },
    {
      "number": 4,
      "pali": "“Antojaṭā bahijaṭā, ",
      "english": "“Tangled within, tangled without: "
    },
    {
      "number": 5,
      "pali": "Jaṭāya jaṭitā pajā; ",
      "english": "these people are tangled in tangles. "
    },
    {
      "number": 6,
      "pali": "Taṁ taṁ gotama pucchāmi, ",
      "english": "I ask you this, Gotama: "
    },
    {
      "number": 7,
      "pali": "Ko imaṁ vijaṭaye jaṭan”ti. ",
      "english": "who can untangle this tangle?” "
    },
    {
      "number": 8,
      "pali": "“Sīle patiṭṭhāya naro sapañño, ",
      "english": "“A wise person grounded in ethics, "
    },
    {
      "number": 9,
      "pali": "Cittaṁ paññañca bhāvayaṁ; ",
      "english": "developing the mind and wisdom, "
    },
    {
      "number": 10,
      "pali": "Ātāpī nipako bhikkhu, ",
      "english": "a keen and alert mendicant—"
    },
    {
      "number": 11,
      "pali": "So imaṁ vijaṭaye jaṭaṁ. ",
      "english": "they can untangle this tangle. "
    },
    {
      "number": 12,
      "pali": "Yesaṁ rāgo ca doso ca, ",
      "english": "Those in whom greed, hate, and ignorance "
    },
    {
      "number": 13,
      "pali": "avijjā ca virājitā; ",
      "english": "have faded away; "
    },
    {
      "number": 14,
      "pali": "Khīṇāsavā arahanto, ",
      "english": "the perfected ones with defilements ended—"
    },
    {
      "number": 15,
      "pali": "tesaṁ vijaṭitā jaṭā. ",
      "english": "they have untangled the tangle. "
    },
    {
      "number": 16,
      "pali": "Yattha nāmañca rūpañca, ",
      "english": "And where name and form "
    },
    {
      "number": 17,
      "pali": "asesaṁ uparujjhati; ",
      "english": "cease with no residue left behind; "
    },
    {
      "number": 18,
      "pali": "Paṭighaṁ rūpasaññā ca, ",
      "english": "and impingement and perception of form: "
    },
    {
      "number": 19,
      "pali": "etthesā chijjate jaṭā”ti. ",
      "english": "it’s here that the tangle is cut.” "
    }
  ]
}