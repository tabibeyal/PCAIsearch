{
  "sutta_id": "DHP262",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na vākkaraṇamattena, ",
      "english": "Not by mere enunciation, "
    },
    {
      "number": 3,
      "pali": "vaṇṇapokkharatāya vā; ",
      "english": "or a beautiful complexion "
    },
    {
      "number": 4,
      "pali": "Sādhurūpo naro hoti, ",
      "english": "does a person become holy, "
    },
    {
      "number": 5,
      "pali": "issukī maccharī saṭho. ",
      "english": "if they’re jealous, stingy, and devious. "
    }
  ]
}