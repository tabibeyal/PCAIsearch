{
  "sutta_id": "DHP364",
  "verses": [
    {
      "number": 1,
      "pali": "Dhammārāmattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dhammārāmo dhammarato, ",
      "english": "Delighting in the teaching, enjoying the teaching, "
    },
    {
      "number": 3,
      "pali": "dhammaṁ anuvicintayaṁ; ",
      "english": "contemplating the teaching, "
    },
    {
      "number": 4,
      "pali": "Dhammaṁ anussaraṁ bhikkhu, ",
      "english": "a mendicant who recollects the teaching "
    },
    {
      "number": 5,
      "pali": "saddhammā na parihāyati. ",
      "english": "doesn’t fall away from the true teaching. "
    }
  ]
}