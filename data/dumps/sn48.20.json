{
  "sutta_id": "SN48.20",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 48.20 ",
      "english": "Linked Discourses 48.20 "
    },
    {
      "number": 2,
      "pali": "2. Mudutaravagga ",
      "english": "2. Weaker "
    },
    {
      "number": 3,
      "pali": "Āsavakkhayasutta ",
      "english": "The Ending of Defilements "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these five faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhindriyaṁ …pe… paññindriyaṁ—",
      "english": "The faculties of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañcindriyāni. ",
      "english": "These are the five faculties. "
    },
    {
      "number": 8,
      "pali": "Imesaṁ kho, bhikkhave, pañcannaṁ indriyānaṁ bhāvitattā bahulīkatattā bhikkhu āsavānaṁ khayā anāsavaṁ cetovimuttiṁ paññāvimuttiṁ diṭṭheva dhamme sayaṁ abhiññā sacchikatvā upasampajja viharatī”ti. ",
      "english": "It’s because of developing and cultivating these five faculties that a mendicant realizes the undefiled freedom of heart and freedom by wisdom in this very life. And they live having realized it with their own insight due to the ending of defilements.” "
    },
    {
      "number": 9,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Mudutaravaggo dutiyo. ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Paṭilābho tayo saṅkhittā, ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "vitthārā apare tayo; ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Paṭipanno ca sampanno, ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "dasamaṁ āsavakkhayanti. ",
      "english": ""
    }
  ]
}