{
  "sutta_id": "DHP83",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcasatabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbattha ve sappurisā cajanti, ",
      "english": "True persons give up everything, "
    },
    {
      "number": 3,
      "pali": "Na kāmakāmā lapayanti santo; ",
      "english": "they don’t cajole for the things they desire. "
    },
    {
      "number": 4,
      "pali": "Sukhena phuṭṭhā atha vā dukhena, ",
      "english": "Though touched by sadness or happiness, "
    },
    {
      "number": 5,
      "pali": "Na uccāvacaṁ paṇḍitā dassayanti. ",
      "english": "the astute appear neither depressed nor elated. "
    }
  ]
}