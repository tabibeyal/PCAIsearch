{
  "sutta_id": "AN4.211",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.211 ",
      "english": "Numbered Discourses 4.211 "
    },
    {
      "number": 2,
      "pali": "22. Parisāvagga ",
      "english": "22. Assembly "
    },
    {
      "number": 3,
      "pali": "Parisāsutta ",
      "english": "Assembly "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, parisadūsanā. ",
      "english": "“Mendicants, these four corrupt an assembly. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Bhikkhu, bhikkhave, dussīlo pāpadhammo parisadūsano; ",
      "english": "A monk, nun, layman, or laywoman who is unethical, of bad character. "
    },
    {
      "number": 7,
      "pali": "bhikkhunī, bhikkhave, dussīlā pāpadhammā parisadūsanā; ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "upāsako, bhikkhave, dussīlo pāpadhammo parisadūsano; ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "upāsikā, bhikkhave, dussīlā pāpadhammā parisadūsanā. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Ime kho, bhikkhave, cattāro parisadūsanā. ",
      "english": "These are the four that corrupt an assembly. "
    },
    {
      "number": 11,
      "pali": "Cattārome, bhikkhave, parisasobhanā. ",
      "english": "Mendicants, these four grace an assembly. "
    },
    {
      "number": 12,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 13,
      "pali": "Bhikkhu, bhikkhave, sīlavā kalyāṇadhammo parisasobhano; ",
      "english": "A monk, nun, layman, or laywoman who is ethical, of good character. "
    },
    {
      "number": 14,
      "pali": "bhikkhunī, bhikkhave, sīlavatī kalyāṇadhammā parisasobhanā; ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "upāsako, bhikkhave, sīlavā kalyāṇadhammo parisasobhano; ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "upāsikā, bhikkhave, sīlavatī kalyāṇadhammā parisasobhanā. ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Ime kho, bhikkhave, cattāro parisasobhanā”ti. ",
      "english": "These are the four that grace an assembly.” "
    },
    {
      "number": 18,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}