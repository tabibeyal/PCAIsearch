{
  "sutta_id": "DHP194",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sukho buddhānamuppādo, ",
      "english": "Happy, the arising of Buddhas! "
    },
    {
      "number": 3,
      "pali": "sukhā saddhammadesanā; ",
      "english": "Happy, the teaching of Dhamma! "
    },
    {
      "number": 4,
      "pali": "Sukhā saṅghassa sāmaggī, ",
      "english": "Happy is the harmony of the Saṅgha, "
    },
    {
      "number": 5,
      "pali": "samaggānaṁ tapo sukho. ",
      "english": "and the striving of the harmonious is happy. "
    }
  ]
}