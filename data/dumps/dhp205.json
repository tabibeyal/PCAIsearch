{
  "sutta_id": "DHP205",
  "verses": [
    {
      "number": 1,
      "pali": "Tissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Pavivekarasaṁ pitvā, ",
      "english": "Having drunk the nectar of seclusion "
    },
    {
      "number": 3,
      "pali": "rasaṁ upasamassa ca; ",
      "english": "and the nectar of peace—"
    },
    {
      "number": 4,
      "pali": "Niddaro hoti nippāpo, ",
      "english": "free of stress, free of evil, "
    },
    {
      "number": 5,
      "pali": "dhammapītirasaṁ pivaṁ. ",
      "english": "drink the joyous nectar of truth. "
    }
  ]
}