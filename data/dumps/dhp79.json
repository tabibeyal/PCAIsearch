{
  "sutta_id": "DHP79",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākappinattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dhammapīti sukhaṁ seti, ",
      "english": "Through joy in the teaching you sleep at ease, "
    },
    {
      "number": 3,
      "pali": "vippasannena cetasā; ",
      "english": "with clear and confident heart. "
    },
    {
      "number": 4,
      "pali": "Ariyappavedite dhamme, ",
      "english": "An astute person always delights in the teaching "
    },
    {
      "number": 5,
      "pali": "sadā ramati paṇḍito. ",
      "english": "proclaimed by the Noble One. "
    }
  ]
}