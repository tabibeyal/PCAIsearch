      "pali": "Aṅguttara Nikāya 10.179 ",
      "english": "Numbered Discourses 10.179 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Ariyadhammasutta ",
      "english": "The Teaching of the Noble Ones "
    },
    {
      "number": 4,
      "pali": "“Ariyadhammañca vo, bhikkhave, desessāmi anariyadhammañca. ",
      "english": "“Mendicants, I will teach you the teaching of the noble ones, and what is not the teaching of the noble ones. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": "Listen and apply your mind well, I will speak. … "
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, anariyo dhammo? ",
      "english": "And what is not the teaching of the noble ones? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, anariyo dhammo. ",
      "english": "This is called what is not the teaching of the noble ones. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, ariyo dhammo? ",
      "english": "And what is the teaching of the noble ones? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, ariyo dhammo”ti. ",
      "english": "This is called the teaching of the noble ones.” "
    },
    {
      "number": 14,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}