{
  "sutta_id": "DHP243",
  "verses": [
    {
      "number": 1,
      "pali": "Tato malā malataraṁ, ",
      "english": "But a worse stain than these "
    },
    {
      "number": 2,
      "pali": "avijjā paramaṁ malaṁ; ",
      "english": "is ignorance, the worst stain of all. "
    },
    {
      "number": 3,
      "pali": "Etaṁ malaṁ pahantvāna, ",
      "english": "Having given up that stain, "
    },
    {
      "number": 4,
      "pali": "nimmalā hotha bhikkhavo. ",
      "english": "be without stains, mendicants! "
    }
  ]
}