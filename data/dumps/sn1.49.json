    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Maccharisutta ",
      "english": "Stingy "
    },
    {
      "number": 4,
      "pali": "“Yedha maccharino loke, ",
      "english": "“Those folk in the world who are stingy, "
    },
    {
      "number": 5,
      "pali": "kadariyā paribhāsakā; ",
      "english": "miserly and abusive, "
    },
    {
      "number": 6,
      "pali": "Aññesaṁ dadamānānaṁ, ",
      "english": "setting up obstacles "
    },
    {
      "number": 7,
      "pali": "antarāyakarā narā. ",
      "english": "for others who give. "
    },
    {
      "number": 8,
      "pali": "Kīdiso tesaṁ vipāko, ",
      "english": "What kind of result do they reap? "
    },
    {
      "number": 9,
      "pali": "samparāyo ca kīdiso; ",
      "english": "What kind of future life? "
    },
    {
      "number": 10,
      "pali": "Bhagavantaṁ puṭṭhumāgamma, ",
      "english": "We’ve come to ask you, worthy sir: "
    },
    {
      "number": 11,
      "pali": "kathaṁ jānemu taṁ mayan”ti. ",
      "english": "how are we to understand this?” "
    },
    {
      "number": 12,
      "pali": "“Yedha maccharino loke, ",
      "english": "“Those folk in the world who are stingy, "
    },
    {
      "number": 13,
      "pali": "kadariyā paribhāsakā; ",
      "english": "miserly and abusive, "
    },
    {
      "number": 14,
      "pali": "Aññesaṁ dadamānānaṁ, ",
      "english": "setting up obstacles "
    },
    {
      "number": 15,
      "pali": "antarāyakarā narā. ",
      "english": "for others who give: "
    },
    {
      "number": 16,
      "pali": "Nirayaṁ tiracchānayoniṁ, ",
      "english": "they’re reborn in hell, "
    },
    {
      "number": 17,
      "pali": "yamalokaṁ upapajjare; ",
      "english": "the animal realm, or Yama’s world. "
    },
    {
      "number": 18,
      "pali": "Sace enti manussattaṁ, ",
      "english": "If they return to the human state, "
    },
    {
      "number": 19,
      "pali": "dalidde jāyare kule. ",
      "english": "they’re born in a poor family, "
    },
    {
      "number": 20,
      "pali": "Coḷaṁ piṇḍo ratī khiḍḍā, ",
      "english": "where clothes, food, pleasure, and play "
    },
    {
      "number": 21,
      "pali": "yattha kicchena labbhati; ",
      "english": "are hard to find. "
    },
    {
      "number": 22,
      "pali": "Parato āsīsare bālā, ",
      "english": "They don’t even get "
    },
    {
      "number": 23,
      "pali": "tampi tesaṁ na labbhati; ",
      "english": "what they hope for from others. "
    },
    {
      "number": 24,
      "pali": "Diṭṭhe dhammesa vipāko, ",
      "english": "This is the result in the present life, "
    },
    {
      "number": 25,
      "pali": "samparāye ca duggatī”ti. ",
      "english": "and in the next, a bad destination.” "
    },
    {
      "number": 26,
      "pali": "“Itihetaṁ vijānāma, ",
      "english": "“We understand what you’re saying, "
    },
    {
      "number": 27,
      "pali": "aññaṁ pucchāma gotama; ",
      "english": "and ask another question, Gotama. "
    },
    {
      "number": 28,
      "pali": "Yedha laddhā manussattaṁ, ",
      "english": "What about those who’ve gained the human state, "
    },
    {
      "number": 29,
      "pali": "vadaññū vītamaccharā. ",
      "english": "who are bountiful and rid of stinginess, "
    },
    {
      "number": 30,
      "pali": "Buddhe pasannā dhamme ca, ",
      "english": "confident in the Buddha and the teaching, "
    },
    {
      "number": 31,
      "pali": "saṅghe ca tibbagāravā; ",
      "english": "with keen respect for the Saṅgha? "
    },
    {
      "number": 32,
      "pali": "Kīdiso tesaṁ vipāko, ",
      "english": "What kind of result do they reap? "
    },
    {
