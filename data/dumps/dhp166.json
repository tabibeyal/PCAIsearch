{
  "sutta_id": "DHP166",
  "verses": [
    {
      "number": 1,
      "pali": "Attadatthattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attadatthaṁ paratthena, ",
      "english": "Never neglect what is good for yourself "
    },
    {
      "number": 3,
      "pali": "bahunāpi na hāpaye; ",
      "english": "for the sake of another, however great. "
    },
    {
      "number": 4,
      "pali": "Attadatthamabhiññāya, ",
      "english": "Knowing well what is good for yourself, "
    },
    {
      "number": 5,
      "pali": "sadatthapasuto siyā. ",
      "english": "be intent upon your heart’s goal. "
    },
    {
      "number": 6,
      "pali": "Attavaggo dvādasamo. ",
      "english": ""
    }
  ]
}