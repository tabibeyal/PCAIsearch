{
  "sutta_id": "DHP92",
  "verses": [
    {
      "number": 1,
      "pali": "Belaṭṭhasīsattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yesaṁ sannicayo natthi, ",
      "english": "Those with nothing stored up, "
    },
    {
      "number": 3,
      "pali": "ye pariññātabhojanā; ",
      "english": "who have understood their food, "
    },
    {
      "number": 4,
      "pali": "Suññato animitto ca, ",
      "english": "whose domain is the liberation "
    },
    {
      "number": 5,
      "pali": "vimokkho yesaṁ gocaro; ",
      "english": "of the signless and the empty: "
    },
    {
      "number": 6,
      "pali": "Ākāseva sakuntānaṁ, ",
      "english": "their path is hard to trace, "
    },
    {
      "number": 7,
      "pali": "gati tesaṁ durannayā. ",
      "english": "like birds in the sky. "
    }
  ]
}