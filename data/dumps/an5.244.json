{
  "sutta_id": "AN5.244",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.244 ",
      "english": "Numbered Discourses 5.244 "
    },
    {
      "number": 2,
      "pali": "25. Duccaritavagga ",
      "english": "25. Bad Conduct "
    },
    {
      "number": 3,
      "pali": "Paṭhamamanoduccaritasutta ",
      "english": "Bad Mental Conduct (1st) "
    },
    {
      "number": 4,
      "pali": "“Pañcime, bhikkhave, ādīnavā manoduccarite …pe… ānisaṁsā manosucarite. ",
      "english": "“Mendicants, there are these five drawbacks in bad mental conduct … benefits in good mental conduct …” "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "Attāpi attānaṁ na upavadati; ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "anuvicca viññū pasaṁsanti; ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "kalyāṇo kittisaddo abbhuggacchati; ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "asammūḷho kālaṁ karoti; ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "kāyassa bhedā paraṁ maraṇā sugatiṁ saggaṁ lokaṁ upapajjati. ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Ime kho, bhikkhave, pañca ānisaṁsā manosucarite”ti. ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}