      "english": ""
    },
    {
      "number": 11,
      "pali": "rasā … ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "phoṭṭhabbā … ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "dhammā aniccā atītānāgatā; ",
      "english": ""
    },
    {
