{
  "sutta_id": "DHP12",
  "verses": [
    {
      "number": 1,
      "pali": "Sārañca sārato ñatvā, ",
      "english": "Having known the essential as essential, "
    },
    {
      "number": 2,
      "pali": "asārañca asārato; ",
      "english": "and the inessential as inessential; "
    },
    {
      "number": 3,
      "pali": "Te sāraṁ adhigacchanti, ",
      "english": "they realize the essential, "
    },
    {
      "number": 4,
      "pali": "sammāsaṅkappagocarā. ",
      "english": "for right thoughts are their habitat. "
    }
  ]
}