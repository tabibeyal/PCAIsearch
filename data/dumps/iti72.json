{
  "sutta_id": "ITI72",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 72",
      "english": "Itivuttaka 72"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three properties for escape. Which three? This is the escape from sensuality: renunciation. This is the escape from form: formlessness. And as for whatever has come into being, is fabricated & dependently co-arisen, the escape from that is cessation. These are the three properties for escape.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Knowing the escape from sensuality,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "& the overcoming of forms"
    },
    {
      "number": 6,
      "pali": "",
      "english": "–ardent"
    },
    {
      "number": 7,
      "pali": "",
      "english": "always–"
    },
    {
      "number": 8,
      "pali": "",
      "english": "touching the stilling"
    },
    {
      "number": 9,
      "pali": "",
      "english": "of all fabrications:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "he is a monk"
    },
    {
      "number": 11,
      "pali": "",
      "english": "who’s seen rightly."
    },
    {
      "number": 12,
      "pali": "",
      "english": "From that he is there released."
    },
    {
      "number": 13,
      "pali": "",
      "english": "A master of direct knowing,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "at peace,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "he is a sage"
    },
    {
      "number": 16,
      "pali": "",
      "english": "gone beyond bonds."
    }
  ]
}