{
  "sutta_id": "ITI72",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 72 ",
      "english": "So It Was Said 72 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Nissaraṇiyasutta ",
      "english": "Elements of Escape "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tisso imā, bhikkhave, nissaraṇiyā dhātuyo. ",
      "english": "“Mendicants, there are these three elements of escape. "
    },
    {
      "number": 7,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāmānametaṁ nissaraṇaṁ yadidaṁ nekkhammaṁ, rūpānametaṁ nissaraṇaṁ yadidaṁ āruppaṁ, yaṁ kho pana kiñci bhūtaṁ saṅkhataṁ paṭiccasamuppannaṁ nirodho tassa nissaraṇaṁ—",
      "english": "Renunciation is the escape from sensual pleasures. Formlessness is the escape from form. Cessation is the escape from whatever is created, conditioned, and dependently originated. "
    },
    {
      "number": 9,
      "pali": "imā kho, bhikkhave, tisso nissaraṇiyā dhātuyo”ti. ",
      "english": "These are the three elements of escape.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Kāmanissaraṇaṁ ñatvā, ",
      "english": "“Knowing the escape from sensuality, "
    },
    {
      "number": 13,
      "pali": "rūpānañca atikkamaṁ; ",
      "english": "and form’s transcendence, "
    },
    {
      "number": 14,
      "pali": "Sabbasaṅkhārasamathaṁ, ",
      "english": "one always keen touches "
    },
    {
      "number": 15,
      "pali": "phusaṁ ātāpi sabbadā. ",
      "english": "the stilling of all activities. "
    },
    {
      "number": 16,
      "pali": "Sa ve sammaddaso bhikkhu, ",
      "english": "That mendicant sees rightly, "
    },
    {
      "number": 17,
      "pali": "yato tattha vimuccati; ",
      "english": "and when freed in regards to that, "
    },
    {
      "number": 18,
      "pali": "Abhiññāvosito santo, ",
      "english": "that peaceful sage, with perfect insight, "
    },
    {
      "number": 19,
      "pali": "sa ve yogātigo munī”ti. ",
      "english": "has truly slipped their yoke.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}