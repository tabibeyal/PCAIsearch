{
  "sutta_id": "DHP291",
  "verses": [
    {
      "number": 1,
      "pali": "Kukkuṭaṇḍakhādikāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Paradukkhūpadhānena, ",
      "english": "Seeking their own happiness "
    },
    {
      "number": 3,
      "pali": "attano sukhamicchati; ",
      "english": "by imposing suffering on others, "
    },
    {
      "number": 4,
      "pali": "Verasaṁsaggasaṁsaṭṭho, ",
      "english": "living intimate with enmity, "
    },
    {
      "number": 5,
      "pali": "verā so na parimuccati. ",
      "english": "they’re not freed from enmity. "
    }
  ]
}