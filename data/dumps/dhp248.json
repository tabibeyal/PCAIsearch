{
  "sutta_id": "DHP248",
  "verses": [
    {
      "number": 1,
      "pali": "Evaṁ bho purisa jānāhi, ",
      "english": "Know this, my friend: "
    },
    {
      "number": 2,
      "pali": "pāpadhammā asaññatā; ",
      "english": "they are unrestrained and wicked. "
    },
    {
      "number": 3,
      "pali": "Mā taṁ lobho adhammo ca, ",
      "english": "Don’t let that greed and unrighteousness "
    },
    {
      "number": 4,
      "pali": "ciraṁ dukkhāya randhayuṁ. ",
      "english": "inflict pain on you for long. "
    }
  ]
}