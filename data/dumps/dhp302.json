{
  "sutta_id": "DHP302",
  "verses": [
    {
      "number": 1,
      "pali": "Vajjiputtakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Duppabbajjaṁ durabhiramaṁ, ",
      "english": "Going forth is hard, it’s hard to be happy; "
    },
    {
      "number": 3,
      "pali": "Durāvāsā gharā dukhā; ",
      "english": "life at home is hard too, and painful, "
    },
    {
      "number": 4,
      "pali": "Dukkhosamānasaṁvāso, ",
      "english": "it’s painful to stay when you’ve nothing in common. "
    },
    {
      "number": 5,
      "pali": "Dukkhānupatitaddhagū; ",
      "english": "A traveler is a prey to pain, "
    },
    {
      "number": 6,
      "pali": "Tasmā na caddhagū siyā, ",
      "english": "so don’t be a traveler, "
    },
    {
      "number": 7,
      "pali": "Na ca dukkhānupatito siyā. ",
      "english": "don’t be prey to pain. "
    }
  ]
}