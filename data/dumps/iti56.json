{
  "sutta_id": "ITI56",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 56 ",
      "english": "So It Was Said 56 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 4,
      "pali": "Paṭhamaāsavasutta ",
      "english": "Defilements (1st) "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, āsavā. ",
      "english": "“Mendicants, there are these three defilements. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Kāmāsavo, bhavāsavo, avijjāsavo—",
      "english": "The defilements of sensuality, desire to be reborn, and ignorance. "
    },
    {
      "number": 9,
      "pali": "ime kho, bhikkhave, tayo āsavā”ti. ",
      "english": "These are the three defilements.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Samāhito sampajāno, ",
      "english": "“Stilled, aware, "
    },
    {
      "number": 13,
      "pali": "sato buddhassa sāvako; ",
      "english": "a mindful disciple of the Buddha "
    },
    {
      "number": 14,
      "pali": "Āsave ca pajānāti, ",
      "english": "understands defilements, "
    },
    {
      "number": 15,
      "pali": "āsavānañca sambhavaṁ. ",
      "english": "the cause of defilements, "
    },
    {
      "number": 16,
      "pali": "Yattha cetā nirujjhanti, ",
      "english": "where they cease, "
    },
    {
      "number": 17,
      "pali": "maggañca khayagāminaṁ; ",
      "english": "and the path that leads to their ending. "
    },
    {
      "number": 18,
      "pali": "Āsavānaṁ khayā bhikkhu, ",
      "english": "With the ending of defilements, a mendicant "
    },
    {
      "number": 19,
      "pali": "nicchāto parinibbuto”ti. ",
      "english": "is hungerless, quenched.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}