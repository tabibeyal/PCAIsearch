{
  "sutta_id": "DHP29",
  "verses": [
    {
      "number": 1,
      "pali": "Pamattāpamattadvesahāyakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Appamatto pamattesu, ",
      "english": "Heedful among the heedless, "
    },
    {
      "number": 3,
      "pali": "suttesu bahujāgaro; ",
      "english": "wide awake while others sleep—"
    },
    {
      "number": 4,
      "pali": "Abalassaṁva sīghasso, ",
      "english": "a true sage leaves them behind, "
    },
    {
      "number": 5,
      "pali": "hitvā yāti sumedhaso. ",
      "english": "like a swift horse passing a feeble. "
    }
  ]
}