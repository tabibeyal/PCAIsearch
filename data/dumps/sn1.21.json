    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Sattiyā viya omaṭṭho, ",
      "english": "“Like they’re struck by a sword, "
    },
    {
      "number": 7,
      "pali": "ḍayhamānova matthake; ",
      "english": "like their head was on fire, "
    },
    {
      "number": 8,
      "pali": "Kāmarāgappahānāya, ",
      "english": "a mendicant, mindful, should go forth, "
    },
    {
      "number": 9,
      "pali": "sato bhikkhu paribbaje”ti. ",
      "english": "to give up sensual desire.” "
    },
    {
      "number": 10,
      "pali": "“Sattiyā viya omaṭṭho, ",
      "english": "“Like they’re struck by a sword, "
    },
