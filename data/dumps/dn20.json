      "english": "so beautiful and glorious. "
    },
    {
      "number": 119,
      "pali": "Modamānā abhikkāmuṁ, ",
      "english": "Rejoicing, they’ve come forth "
    },
    {
      "number": 120,
      "pali": "bhikkhūnaṁ samitiṁ vanaṁ. ",
      "english": "to the meeting of mendicants in the wood. "
    },
    {
      "number": 121,
      "pali": "Dakkhiṇañca disaṁ rājā, ",
      "english": "King Virūḷhaka rules "
    },
    {
      "number": 122,
      "pali": "virūḷho taṁ pasāsati; ",
      "english": "the southern quarter. "
    },
    {
      "number": 123,
      "pali": "Kumbhaṇḍānaṁ adhipati, ",
      "english": "Lord of the gnomes, "
    },
    {
      "number": 124,
      "pali": "mahārājā yasassiso. ",
      "english": "he’s a great king, glorious. "
    },
    {
      "number": 125,
      "pali": "Puttāpi tassa bahavo, ",
      "english": "And he has many mighty sons "
    },
    {
      "number": 126,
      "pali": "indanāmā mahabbalā; ",
      "english": "all of them named Indra. "
    },
    {
      "number": 127,
      "pali": "Iddhimanto jutimanto, ",
      "english": "They’re powerful and brilliant, "
    },
    {
      "number": 128,
      "pali": "vaṇṇavanto yasassino; ",
      "english": "so beautiful and glorious. "
    },
    {
      "number": 129,
      "pali": "Modamānā abhikkāmuṁ, ",
      "english": "Rejoicing, they’ve come forth "
    },
    {
      "number": 130,
      "pali": "bhikkhūnaṁ samitiṁ vanaṁ. ",
      "english": "to the meeting of mendicants in the wood. "
    },
    {
      "number": 131,
      "pali": "Pacchimañca disaṁ rājā, ",
      "english": "King Virūpakkha rules "
    },
    {
      "number": 132,
      "pali": "virūpakkho pasāsati; ",
      "english": "the western quarter. "
    },
    {
      "number": 133,
      "pali": "Nāgānañca adhipati, ",
      "english": "Lord of the dragons, "
    },
    {
