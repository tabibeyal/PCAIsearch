    },
    {
      "number": 98,
      "pali": "bhikkhūnaṁ samitiṁ vanaṁ. ",
      "english": "to the meeting of mendicants in the wood. "
    },
    {
      "number": 99,
      "pali": "Vessāmittā pañcasatā, ",
      "english": "From Vessāmitta’s mountain there are five hundred "
    },
    {
      "number": 100,
      "pali": "yakkhā nānattavaṇṇino; ",
      "english": "spirits of different colors. "
    },
    {
