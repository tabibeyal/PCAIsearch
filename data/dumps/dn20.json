    },
    {
      "number": 104,
      "pali": "bhikkhūnaṁ samitiṁ vanaṁ. ",
      "english": "to the meeting of mendicants in the wood. "
    },
    {
      "number": 105,
      "pali": "Kumbhīro rājagahiko, ",
      "english": "And there’s Kumbhīra of Rājagaha, "
    },
    {
      "number": 106,
      "pali": "vepullassa nivesanaṁ; ",
      "english": "whose home is on Mount Vepulla. "
    },
    {
      "number": 107,
      "pali": "Bhiyyo naṁ satasahassaṁ, ",
      "english": "Attended by more than "
    },
    {
      "number": 108,
      "pali": "yakkhānaṁ payirupāsati; ",
      "english": "a hundred thousand spirits, "
    },
    {
      "number": 109,
      "pali": "Kumbhīro rājagahiko, ",
      "english": "Kumbhīra of Rājagaha "
    },
    {
      "number": 110,
      "pali": "sopāgā samitiṁ vanaṁ. ",
      "english": "also came to the meeting in the wood. "
    },
    {
      "number": 111,
      "pali": "Purimañca disaṁ rājā, ",
      "english": "King Dhataraṭṭha rules "
    },
    {
      "number": 112,
      "pali": "dhataraṭṭho pasāsati; ",
      "english": "the eastern quarter. "
    },
    {
      "number": 113,
      "pali": "Gandhabbānaṁ adhipati, ",
      "english": "Lord of the centaurs, "
    },
    {
      "number": 114,
      "pali": "mahārājā yasassiso. ",
      "english": "he’s a great king, glorious. "
    },
    {
      "number": 115,
      "pali": "Puttāpi tassa bahavo, ",
      "english": "And he has many mighty sons "
    },
    {
      "number": 116,
      "pali": "indanāmā mahabbalā; ",
      "english": "all of them named Indra. "
    },
    {
      "number": 117,
