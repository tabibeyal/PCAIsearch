{
  "sutta_id": "SN1.22",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.22 ",
      "english": "Linked Discourses 1.22 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Phusatisutta ",
      "english": "Impact "
    },
    {
      "number": 4,
      "pali": "“Nāphusantaṁ phusati ca, ",
      "english": "“It doesn’t impact one who doesn’t impact others. "
    },
    {
      "number": 5,
      "pali": "phusantañca tato phuse; ",
      "english": "It impacts one because they impact others. "
    },
    {
      "number": 6,
      "pali": "Tasmā phusantaṁ phusati, ",
      "english": "That’s why it impacts one who impacts, "
    },
    {
      "number": 7,
      "pali": "appaduṭṭhapadosinan”ti. ",
      "english": "who wrongs one who’s done no wrong.” "
    },
    {
      "number": 8,
      "pali": "“Yo appaduṭṭhassa narassa dussati, ",
      "english": "“Whoever wrongs a man who has done no wrong, "
    },
    {
      "number": 9,
      "pali": "Suddhassa posassa anaṅgaṇassa; ",
      "english": "a pure man who has not a blemish, "
    },
    {
      "number": 10,
      "pali": "Tameva bālaṁ pacceti pāpaṁ, ",
      "english": "the evil backfires on the fool, "
    },
    {
      "number": 11,
      "pali": "Sukhumo rajo paṭivātaṁva khitto”ti. ",
      "english": "like fine dust thrown upwind.” "
    }
  ]
}