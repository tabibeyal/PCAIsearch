{
  "sutta_id": "DHP186",
  "verses": [
    {
      "number": 1,
      "pali": "Anabhiratabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na kahāpaṇavassena, ",
      "english": "Even if it were raining money, "
    },
    {
      "number": 3,
      "pali": "titti kāmesu vijjati; ",
      "english": "you’d not be sated in sensual pleasures. "
    },
    {
      "number": 4,
      "pali": "Appassādā dukhā kāmā, ",
      "english": "An astute person understands that sensual pleasures "
    },
    {
      "number": 5,
      "pali": "iti viññāya paṇḍito. ",
      "english": "offer little gratification and much suffering. "
    }
  ]
}