{
  "sutta_id": "AN4.142",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.142 ",
      "english": "Numbered Discourses 4.142 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Pabhāsutta ",
      "english": "Radiance "
    },
    {
      "number": 4,
      "pali": "“Catasso imā, bhikkhave, pabhā. ",
      "english": "“Mendicants, there are these four kinds of radiance. "
    },
    {
      "number": 5,
      "pali": "Katamā catasso? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Candappabhā, sūriyappabhā, aggippabhā, paññāpabhā—",
      "english": "The radiance of the moon, sun, fire, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, catasso pabhā. ",
      "english": "These are the four kinds of radiance. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imāsaṁ catunnaṁ pabhānaṁ yadidaṁ paññāpabhā”ti. ",
      "english": "The best of these four kinds of radiance is the radiance of wisdom.” "
    },
    {
      "number": 9,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}