{
  "sutta_id": "DHP63",
  "verses": [
    {
      "number": 1,
      "pali": "Gaṇṭhibhedakacoravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo bālo maññati bālyaṁ, ",
      "english": "The fool who thinks they’re a fool "
    },
    {
      "number": 3,
      "pali": "paṇḍito vāpi tena so; ",
      "english": "is wise at least to that extent. "
    },
    {
      "number": 4,
      "pali": "Bālo ca paṇḍitamānī, ",
      "english": "But the true fool is said to be one "
    },
    {
      "number": 5,
      "pali": "sa ve “bālo”ti vuccati. ",
      "english": "who imagines that they are wise. "
    }
  ]
}