      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Sañcetanāsutta ",
      "english": "Intention "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "rūpasañcetanā niccā vā aniccā vā”ti? ",
      "english": "Is intention regarding sights permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“saddasañcetanā …pe… ",
      "english": "“… intention regarding sounds … "
    },
    {
      "number": 9,
      "pali": "gandhasañcetanā … ",
      "english": "intention regarding smells … "
    },
    {
      "number": 10,
      "pali": "rasasañcetanā … ",
      "english": "intention regarding tastes … "
    },
    {
      "number": 11,
      "pali": "phoṭṭhabbasañcetanā … ",
      "english": "intention regarding touches … "
    },
    {
      "number": 12,
      "pali": "dhammasañcetanā niccā vā aniccā vā”ti? ",
      "english": "Is intention regarding ideas permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako rūpasañcetanāyapi nibbindati …pe… saddasañcetanāyapi nibbindati … gandhasañcetanāyapi nibbindati … rasasañcetanāyapi nibbindati … phoṭṭhabbasañcetanāyapi nibbindati … dhammasañcetanāyapi nibbindati …pe… ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with intention regarding sights, sounds, smells, tastes, touches, and ideas. …” "
    },
    {
      "number": 15,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
