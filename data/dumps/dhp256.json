    {
      "number": 3,
      "pali": "Dhammaṭṭhavagga ",
      "english": "19. The Just "
    },
    {
      "number": 4,
      "pali": "Vinicchayamahāmattavatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Na tena hoti dhammaṭṭho, ",
      "english": "You don’t become just "
    },
    {
      "number": 6,
      "pali": "yenatthaṁ sāhasā naye; ",
      "english": "by passing hasty judgment. "
    },
    {
      "number": 7,
      "pali": "Yo ca atthaṁ anatthañca, ",
      "english": "An astute person evaluates both "
    },
    {
      "number": 8,
      "pali": "ubho niccheyya paṇḍito. ",
      "english": "what is pertinent and what is irrelevant. "
    }
  ]
