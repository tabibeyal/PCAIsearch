{
  "sutta_id": "AN10.195",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.195 ",
      "english": "Numbered Discourses 10.195 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Bhāvetabbadhammasutta ",
      "english": "Principles That Should Be Developed "
    },
    {
      "number": 4,
      "pali": "“Bhāvetabbañca vo, bhikkhave, dhammaṁ desessāmi na bhāvetabbañca. ",
      "english": "“I will teach you the principle to develop and the principle not to develop. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": "Listen and apply your mind well, I will speak. "
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, na bhāvetabbo dhammo? ",
      "english": "And what is the principle not to develop? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, na bhāvetabbo dhammo. ",
      "english": "This is called the principle not to develop. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, bhāvetabbo dhammo? ",
      "english": "And what is the principle to develop? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, bhāvetabbo dhammo”ti. ",
      "english": "This is called the principle to develop.” "
    },
    {
      "number": 14,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}