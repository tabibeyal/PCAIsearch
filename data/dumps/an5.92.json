    },
    {
      "number": 2,
      "pali": "10. Kakudhavagga ",
      "english": "10. With Kakudha "
    },
    {
      "number": 3,
      "pali": "Dutiyasampadāsutta ",
      "english": "Accomplishment (2nd) "
    },
    {
      "number": 4,
      "pali": "“Pañcimā, bhikkhave, sampadā. ",
      "english": "“Mendicants, there are five accomplishments. "
    },
    {
      "number": 5,
      "pali": "Katamā pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Sīlasampadā, samādhisampadā, paññāsampadā, vimuttisampadā, vimuttiñāṇadassanasampadā—",
      "english": "Accomplishment in ethics, immersion, wisdom, freedom, and the knowledge and vision of freedom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, pañca sampadā”ti. ",
      "english": "These are the five accomplishments.” "
    },
    {
      "number": 8,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
