{
  "sutta_id": "AN4.42",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.42 ",
      "english": "Numbered Discourses 4.42 "
    },
    {
      "number": 2,
      "pali": "5. Rohitassavagga ",
      "english": "5. With Rohitassa "
    },
    {
      "number": 3,
      "pali": "Pañhabyākaraṇasutta ",
      "english": "Ways of Answering Questions "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, pañhabyākaraṇāni. ",
      "english": "“Mendicants, there are these four ways of answering questions. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Atthi, bhikkhave, pañho ekaṁsabyākaraṇīyo; ",
      "english": "There is a question that should be answered categorically. "
    },
    {
      "number": 7,
      "pali": "atthi, bhikkhave, pañho vibhajjabyākaraṇīyo; ",
      "english": "There is a question that should be answered analytically. "
    },
    {
      "number": 8,
      "pali": "atthi, bhikkhave, pañho paṭipucchābyākaraṇīyo; ",
      "english": "There is a question that should be answered with a counter-question. "
    },
    {
      "number": 9,
      "pali": "atthi, bhikkhave, pañho ṭhapanīyo. ",
      "english": "There is a question that should be set aside. "
    },
    {
      "number": 10,
      "pali": "Imāni kho, bhikkhave, cattāri pañhabyākaraṇānīti. ",
      "english": "These are the four ways of answering questions. "
    },
    {
      "number": 11,
      "pali": "Ekaṁsavacanaṁ ekaṁ, ",
      "english": "One is stated categorically, "
    },
    {
      "number": 12,
      "pali": "vibhajjavacanāparaṁ; ",
      "english": "another analytically, "
    },
    {
      "number": 13,
      "pali": "Tatiyaṁ paṭipuccheyya, ",
      "english": "a third with a counter-question, "
    },
    {
      "number": 14,
      "pali": "catutthaṁ pana ṭhāpaye. ",
      "english": "while a fourth is set aside. "
    },
    {
      "number": 15,
      "pali": "Yo ca tesaṁ tattha tattha, ",
      "english": "That sort of mendicant, <j>who knows each of these, "
    },
    {
      "number": 16,
      "pali": "jānāti anudhammataṁ; ",
      "english": "in line with good principles, "
    },
    {
      "number": 17,
      "pali": "Catupañhassa kusalo, ",
      "english": "is said to be skilled "
    },
    {
      "number": 18,
      "pali": "āhu bhikkhuṁ tathāvidhaṁ. ",
      "english": "in the four kinds of questions. "
    },
    {
      "number": 19,
      "pali": "Durāsado duppasaho, ",
      "english": "They’re intimidating, hard to defeat, "
    },
    {
      "number": 20,
      "pali": "gambhīro duppadhaṁsiyo; ",
      "english": "deep, and hard to crush. "
    },
    {
      "number": 21,
      "pali": "Atho atthe anatthe ca, ",
      "english": "They’re expert in both "
    },
    {
      "number": 22,
      "pali": "ubhayassa hoti kovido. ",
      "english": "what the meaning is and what it isn’t. "
    },
    {
      "number": 23,
      "pali": "Anatthaṁ parivajjeti, ",
      "english": "Shunning what is not the meaning, "
    },
    {
      "number": 24,
      "pali": "atthaṁ gaṇhāti paṇḍito; ",
      "english": "an astute person grasps the meaning. "
    },
    {
      "number": 25,
      "pali": "Atthābhisamayā dhīro, ",
      "english": "An attentive one, comprehending the meaning, "
    },
    {
      "number": 26,
      "pali": "paṇḍitoti pavuccatī”ti. ",
      "english": "is said to be astute.” "
    },
    {
      "number": 27,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}