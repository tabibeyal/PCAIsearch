{
  "sutta_id": "AN4.42",
  "verses": [
    {
      "number": 1,
      "pali": "Numerical Discourses 4.42",
      "english": "Numerical Discourses 4.42"
    },
    {
      "number": 2,
      "pali": "Pañha Sutta",
      "english": "Questions"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“There are these four ways of answering questions. Which four? There are questions that should be answered categorically [straightforwardly yes, no, this, that]. There are questions that should be answered with an analytical answer [defining or redefining the terms]. There are questions that should be answered with a counter-question. There are questions that should be put aside. These are the four ways of answering questions.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "First the categorical statement,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "then the analytical statement,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "third, the type to be counter-questioned,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "& fourth, the one to be put aside."
    },
    {
      "number": 8,
      "pali": "",
      "english": "Any monk who knows which is which,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "in line with the Dhamma,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "is said to be skilled"
    },
    {
      "number": 11,
      "pali": "",
      "english": "in the four types of questions:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "hard to overcome, hard to beat,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "profound, hard to defeat."
    },
    {
      "number": 14,
      "pali": "",
      "english": "He knows what’s worthwhile"
    },
    {
      "number": 15,
      "pali": "",
      "english": "& what’s not,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "proficient in (recognizing) both,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "he"
    },
    {
      "number": 18,
      "pali": "",
      "english": "rejects the worthless,"
    },
    {
      "number": 19,
      "pali": "",
      "english": "grasps the worthwhile."
    },
    {
      "number": 20,
      "pali": "",
      "english": "He’s called"
    },
    {
      "number": 21,
      "pali": "",
      "english": "one who has broken through"
    },
    {
      "number": 22,
      "pali": "",
      "english": "to what’s worthwhile,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "enlightened,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "wise."
    }
  ]
}