{
  "sutta_id": "DHP122",
  "verses": [
    {
      "number": 1,
      "pali": "Biḷālapādakaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Māvamaññetha puññassa, ",
      "english": "Think not lightly of goodness, "
    },
    {
      "number": 3,
      "pali": "na mandaṁ āgamissati; ",
      "english": "that it won’t come back to you. "
    },
    {
      "number": 4,
      "pali": "Udabindunipātena, ",
      "english": "The pot is filled with water "
    },
    {
      "number": 5,
      "pali": "udakumbhopi pūrati; ",
      "english": "falling drop by drop; "
    },
    {
      "number": 6,
      "pali": "Dhīro pūrati puññassa, ",
      "english": "the attentive one is filled with goodness "
    },
    {
      "number": 7,
      "pali": "thokaṁ thokampi ācinaṁ. ",
      "english": "piled up bit by bit. "
    }
  ]
}