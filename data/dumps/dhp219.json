{
  "sutta_id": "DHP219",
  "verses": [
    {
      "number": 1,
      "pali": "Nandiyavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Cirappavāsiṁ purisaṁ, ",
      "english": "When a man returns safely "
    },
    {
      "number": 3,
      "pali": "dūrato sotthimāgataṁ; ",
      "english": "after a long time spent abroad, "
    },
    {
      "number": 4,
      "pali": "Ñātimittā suhajjā ca, ",
      "english": "family, friends, and loved ones "
    },
    {
      "number": 5,
      "pali": "abhinandanti āgataṁ. ",
      "english": "celebrate his return. "
    }
  ]
}