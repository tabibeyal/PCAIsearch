{
  "sutta_id": "DHP102",
  "verses": [
    {
      "number": 1,
      "pali": "Kuṇḍalakesitherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca gāthā sataṁ bhāse, ",
      "english": "Better than reciting "
    },
    {
      "number": 3,
      "pali": "anatthapadasaṁhitā; ",
      "english": "a hundred meaningless verses "
    },
    {
      "number": 4,
      "pali": "Ekaṁ dhammapadaṁ seyyo, ",
      "english": "is a single saying of Dhamma, "
    },
    {
      "number": 5,
      "pali": "yaṁ sutvā upasammati. ",
      "english": "hearing which brings you peace. "
    }
  ]
}