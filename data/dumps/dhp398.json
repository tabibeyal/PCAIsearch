{
  "sutta_id": "DHP398",
  "verses": [
    {
      "number": 1,
      "pali": "Dvebrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Chetvā naddhiṁ varattañca, ",
      "english": "They’ve cut the strap and harness, "
    },
    {
      "number": 3,
      "pali": "sandānaṁ sahanukkamaṁ; ",
      "english": "the halter and bridle too, "
    },
    {
      "number": 4,
      "pali": "Ukkhittapalighaṁ buddhaṁ, ",
      "english": "with cross-bar lifted, they’re awakened: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}