{
  "sutta_id": "SN18.5",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 18.5 ",
      "english": "Linked Discourses 18.5 "
    },
    {
      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Vedanāsutta ",
      "english": "Feeling "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "cakkhusamphassajā vedanā niccā vā aniccā vā”ti? ",
      "english": "Is feeling born of eye contact permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“sotasamphassajā vedanā …pe… ",
      "english": "“… feeling born of ear contact … "
    },
    {
      "number": 9,
      "pali": "ghānasamphassajā vedanā … ",
      "english": "feeling born of nose contact … "
    },
    {
      "number": 10,
      "pali": "jivhāsamphassajā vedanā … ",
      "english": "feeling born of tongue contact … "
    },
    {
      "number": 11,
      "pali": "kāyasamphassajā vedanā … ",
      "english": "feeling born of body contact … "
    },
    {
      "number": 12,
      "pali": "manosamphassajā vedanā niccā vā aniccā vā”ti? ",
      "english": "Is feeling born of mind contact permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako cakkhusamphassajāya vedanāyapi nibbindati …pe… sota … ghāna … jivhā … kāya … manosamphassajāya vedanāyapi nibbindati …pe… ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with feeling born of eye contact, ear contact, nose contact, tongue contact, body contact, and mind contact. …” "
    },
    {
      "number": 15,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}