    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Nāmasutta ",
      "english": "Name "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu sabbaṁ addhabhavi, ",
      "english": "“What overcomes everything? "
    },
    {
      "number": 5,
      "pali": "kismā bhiyyo na vijjati; ",
      "english": "What is it that nothing excels? "
    },
    {
      "number": 6,
      "pali": "Kissassu ekadhammassa, ",
      "english": "What is the one thing "
    },
    {
      "number": 7,
      "pali": "sabbeva vasamanvagū”ti. ",
      "english": "that has everything under its sway?” "
    },
    {
      "number": 8,
      "pali": "“Nāmaṁ sabbaṁ addhabhavi, ",
      "english": "“Name overcomes everything. "
    },
    {
      "number": 9,
      "pali": "nāmā bhiyyo na vijjati; ",
      "english": "Nothing excels name. "
    },
    {
      "number": 10,
      "pali": "Nāmassa ekadhammassa, ",
      "english": "Name is the one thing "
    },
    {
      "number": 11,
      "pali": "sabbeva vasamanvagū”ti. ",
      "english": "that has everything under its sway.” "
    }
  ]
