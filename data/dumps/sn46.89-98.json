    {
      "number": 3,
      "pali": "Tathāgatādisutta ",
      "english": "A Realized One, Etc. "
    },
    {
      "number": 4,
      "pali": "“Yāvatā, bhikkhave, sattā apadā vā dvipadā vā catuppadā vā bahuppadā vā”ti vitthāretabbaṁ. ",
      "english": "“Mendicants, the Realized One, the perfected one, the fully awakened Buddha, is said to be the best of all sentient beings—be they footless, with two feet, four feet, or many feet …” "
    },
    {
      "number": 5,
      "pali": "Appamādavaggo dasamo. ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 7,
      "pali": "Tathāgataṁ padaṁ kūṭaṁ, ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "mūlaṁ sārena vassikaṁ; ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Rājā candimasūriyā ca, ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "vatthena dasamaṁ padanti. ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "(Appamādavaggo bojjhaṅgasaṁyuttassa bojjhaṅgavasena vitthāretabbo.) ",
      "english": "(Tell in full as in SN 45.139–148.) "
    }
  ]
