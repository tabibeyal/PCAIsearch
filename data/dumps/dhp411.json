{
  "sutta_id": "DHP411",
  "verses": [
    {
      "number": 1,
      "pali": "Mahāmoggallānattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yassālayā na vijjanti, ",
      "english": "They have no clinging, "
    },
    {
      "number": 3,
      "pali": "aññāya akathaṅkathī; ",
      "english": "knowledge has freed them of indecision, "
    },
    {
      "number": 4,
      "pali": "Amatogadhamanuppattaṁ, ",
      "english": "they’ve arrived at the objective, freedom from death: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}