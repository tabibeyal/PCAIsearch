{
  "sutta_id": "DHP154",
  "verses": [
    {
      "number": 1,
      "pali": "Gahakāraka diṭṭhosi, ",
      "english": "I’ve seen you, house-builder! "
    },
    {
      "number": 2,
      "pali": "puna gehaṁ na kāhasi; ",
      "english": "You won’t build a house again! "
    },
    {
      "number": 3,
      "pali": "Sabbā te phāsukā bhaggā, ",
      "english": "Your rafters are all broken, "
    },
    {
      "number": 4,
      "pali": "gahakūṭaṁ visaṅkhataṁ; ",
      "english": "your roof-peak demolished. "
    },
    {
      "number": 5,
      "pali": "Visaṅkhāragataṁ cittaṁ, ",
      "english": "The mind, set on demolition, "
    },
    {
      "number": 6,
      "pali": "taṇhānaṁ khayamajjhagā. ",
      "english": "has reached the end of cravings. "
    }
  ]
}