{
  "sutta_id": "DHP184",
  "verses": [
    {
      "number": 1,
      "pali": "Khantī paramaṁ tapo titikkhā, ",
      "english": "Patient acceptance is the ultimate fervor. "
    },
    {
      "number": 2,
      "pali": "Nibbānaṁ paramaṁ vadanti buddhā; ",
      "english": "Extinguishment is the ultimate, say the Buddhas. "
    },
    {
      "number": 3,
      "pali": "Na hi pabbajito parūpaghātī, ",
      "english": "No true renunciate injures another, "
    },
    {
      "number": 4,
      "pali": "Na samaṇo hoti paraṁ viheṭhayanto. ",
      "english": "nor does an ascetic hurt another. "
    }
  ]
}