    {
      "number": 3,
      "pali": "Dukkhānupassīsutta ",
      "english": "Observing Suffering "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Saddhāpabbajitassa, bhikkhave, kulaputtassa ayamanudhammo hoti—",
      "english": "“Mendicants, when a gentleman has gone forth out of faith, this is what’s in line with the teaching. "
    },
    {
      "number": 6,
      "pali": "yaṁ rūpe dukkhānupassī vihareyya. ",
      "english": "They should meditate observing suffering in form, "
    },
    {
      "number": 7,
      "pali": "Vedanāya … ",
      "english": "feeling, "
    },
    {
      "number": 8,
      "pali": "saññāya … ",
      "english": "perception, "
    },
    {
      "number": 9,
      "pali": "saṅkhāresu … ",
      "english": "choices, "
    },
    {
      "number": 10,
      "pali": "viññāṇe dukkhānupassī vihareyya …pe… ",
      "english": "and consciousness. … "
    },
    {
      "number": 11,
      "pali": "‘parimuccati dukkhasmā’ti vadāmī”ti. ",
      "english": "They’re freed from suffering, I say.” "
    },
    {
      "number": 12,
      "pali": "Terasamaṁ. ",
      "english": ""
    }
  ]
