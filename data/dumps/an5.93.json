{
  "sutta_id": "AN5.93",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 5.93 ",
      "english": "Numbered Discourses 5.93 "
    },
    {
      "number": 2,
      "pali": "10. Kakudhavagga ",
      "english": "10. With Kakudha "
    },
    {
      "number": 3,
      "pali": "Byākaraṇasutta ",
      "english": "Declarations "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, aññābyākaraṇāni. ",
      "english": "“Mendicants, there are five ways of declaring enlightenment. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Mandattā momūhattā aññaṁ byākaroti; ",
      "english": "One declares enlightenment out of stupidity and folly. "
    },
    {
      "number": 7,
      "pali": "pāpiccho icchāpakato aññaṁ byākaroti; ",
      "english": "Or because of corrupt wishes, being of wishful temperament. "
    },
    {
      "number": 8,
      "pali": "ummādā cittakkhepā aññaṁ byākaroti; ",
      "english": "Or because of madness and mental disorder. "
    },
    {
      "number": 9,
      "pali": "adhimānena aññaṁ byākaroti; ",
      "english": "Or out of overestimation. "
    },
    {
      "number": 10,
      "pali": "sammadeva aññaṁ byākaroti. ",
      "english": "Or one declares enlightenment rightly. "
    },
    {
      "number": 11,
      "pali": "Imāni kho, bhikkhave, pañca aññābyākaraṇānī”ti. ",
      "english": "These are the five ways of declaring enlightenment.” "
    },
    {
      "number": 12,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}