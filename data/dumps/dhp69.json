{
  "sutta_id": "DHP69",
  "verses": [
    {
      "number": 1,
      "pali": "Uppalavaṇṇattherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Madhuṁvā maññati bālo, ",
      "english": "The fool imagines that evil is sweet, "
    },
    {
      "number": 3,
      "pali": "yāva pāpaṁ na paccati; ",
      "english": "so long as it has not yet ripened. "
    },
    {
      "number": 4,
      "pali": "Yadā ca paccati pāpaṁ, ",
      "english": "But as soon as that evil ripens, "
    },
    {
      "number": 5,
      "pali": "atha dukkhaṁ nigacchati. ",
      "english": "they fall into suffering. "
    }
  ]
}