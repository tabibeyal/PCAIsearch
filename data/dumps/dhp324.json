{
  "sutta_id": "DHP324",
  "verses": [
    {
      "number": 1,
      "pali": "Parijiṇṇabrāhmaṇaputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dhanapālo nāma kuñjaro, ",
      "english": "The tusker named Dhanapāla "
    },
    {
      "number": 3,
      "pali": "Kaṭukabhedano dunnivārayo; ",
      "english": "is musky in rut, hard to control. "
    },
    {
      "number": 4,
      "pali": "Baddho kabaḷaṁ na bhuñjati, ",
      "english": "Bound, he eats not a morsel, "
    },
    {
      "number": 5,
      "pali": "Sumarati nāgavanassa kuñjaro. ",
      "english": "for he misses the elephant forest. "
    }
  ]
}