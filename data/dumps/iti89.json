{
  "sutta_id": "ITI89",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 89 ",
      "english": "So It Was Said 89 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Catutthavagga ",
      "english": "Chapter Four "
    },
    {
      "number": 4,
      "pali": "Devadattasutta ",
      "english": "About Devadatta "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīhi, bhikkhave, asaddhammehi abhibhūto pariyādinnacitto devadatto āpāyiko nerayiko kappaṭṭho atekiccho. ",
      "english": "“Mendicants, overcome and overwhelmed by three things that oppose the true teaching, Devadatta is going to a place of loss, to hell, there to remain for an eon, irredeemable. "
    },
    {
      "number": 7,
      "pali": "Katamehi tīhi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Pāpicchatāya, bhikkhave, abhibhūto pariyādinnacitto devadatto āpāyiko nerayiko kappaṭṭho atekiccho. ",
      "english": "Corrupt wishes … "
    },
    {
      "number": 9,
      "pali": "Pāpamittatāya, bhikkhave, abhibhūto pariyādinnacitto devadatto āpāyiko nerayiko kappaṭṭho atekiccho. ",
      "english": "Bad friendship … "
    },
    {
      "number": 10,
      "pali": "Sati kho pana uttarikaraṇīye oramattakena visesādhigamena antarā vosānaṁ āpādi. ",
      "english": "When there is still more to be done, stopping half-way after achieving some trifling distinction. "
    },
    {
      "number": 11,
      "pali": "Imehi kho, bhikkhave, tīhi asaddhammehi abhibhūto pariyādinnacitto devadatto āpāyiko nerayiko kappaṭṭho atekiccho”ti. ",
      "english": "Overcome and overwhelmed by these three things that oppose the true teaching, Devadatta is going to a place of loss, to hell, there to remain for an eon, irredeemable.” "
    },
    {
      "number": 12,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 13,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 14,
      "pali": "“Mā jātu koci lokasmiṁ, ",
      "english": "“Let none of wicked desire "
    },
    {
      "number": 15,
      "pali": "pāpiccho udapajjatha; ",
      "english": "ever be reborn into this world. "
    },
    {
      "number": 16,
      "pali": "Tadamināpi jānātha, ",
      "english": "And by this too you should know "
    },
    {
      "number": 17,
      "pali": "pāpicchānaṁ yathā gati. ",
      "english": "the place where those of corrupt wishes go. "
    },
    {
      "number": 18,
      "pali": "Paṇḍitoti samaññāto, ",
      "english": "He once was considered astute, "
    },
    {
      "number": 19,
      "pali": "bhāvitattoti sammato; ",
      "english": "deemed to be evolved, "
    },
    {
      "number": 20,
      "pali": "Jalaṁva yasasā aṭṭhā, ",
      "english": "his glory stood forth like a flame, "
    },
    {
      "number": 21,
      "pali": "devadattoti vissuto. ",
      "english": "the renowned Devadatta. "
    },
    {
      "number": 22,
      "pali": "So samānamanuciṇṇo, ",
      "english": "Seduced by heedlessness, "
    },
    {
      "number": 23,
      "pali": "āsajja naṁ tathāgataṁ; ",
      "english": "he attacked the Realized One. "
    },
    {
      "number": 24,
      "pali": "Avīcinirayaṁ patto, ",
      "english": "He has fallen to Avīci hell, "
    },
    {
      "number": 25,
      "pali": "catudvāraṁ bhayānakaṁ. ",
      "english": "four-doored and terrifying. "
    },
    {
      "number": 26,
      "pali": "Aduṭṭhassa hi yo dubbhe, ",
      "english": "When someone betrays the innocent, "
    },
    {
      "number": 27,
      "pali": "pāpakammaṁ akubbato; ",
      "english": "who have done no wrong, "
    },
    {
      "number": 28,
      "pali": "Tameva pāpaṁ phusati, ",
      "english": "their bad deeds impact the one "
    },
    {
      "number": 29,
      "pali": "duṭṭhacittaṁ anādaraṁ. ",
      "english": "with corrupt heart, lacking regard for others. "
    },
    {
      "number": 30,
      "pali": "Samuddaṁ visakumbhena, ",
      "english": "One might think to pollute "
    },
    {
      "number": 31,
      "pali": "yo maññeyya padūsituṁ; ",
      "english": "the ocean with a pot of poison, "
    },
    {
      "number": 32,
      "pali": "Na so tena padūseyya, ",
      "english": "but it wouldn’t work, "
    },
    {
      "number": 33,
      "pali": "bhesmā hi udadhi mahā. ",
      "english": "for the sea is terribly large. "
    },
    {
      "number": 34,
      "pali": "Evamevaṁ tathāgataṁ, ",
      "english": "So too when someone attacks "
    },
    {
      "number": 35,
      "pali": "yo vādena vihiṁsati; ",
      "english": "with words the Realized One—"
    },
    {
      "number": 36,
      "pali": "Sammaggataṁ santacittaṁ, ",
      "english": "rightly comported, of peaceful mind—"
    },
    {
      "number": 37,
      "pali": "vādo tamhi na rūhati. ",
      "english": "the words don’t take. "
    },
    {
      "number": 38,
      "pali": "Tādisaṁ mittaṁ kubbetha, ",
      "english": "The astute would befriend one like this, "
    },
    {
      "number": 39,
      "pali": "tañca seveyya paṇḍito; ",
      "english": "and follow them around. "
    },
    {
      "number": 40,
      "pali": "Yassa maggānugo bhikkhu, ",
      "english": "A mendicant who walks the path "
    },
    {
      "number": 41,
      "pali": "khayaṁ dukkhassa pāpuṇe”ti. ",
      "english": "attains the ending of suffering.” "
    },
    {
      "number": 42,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 43,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 44,
      "pali": "Catuttho vaggo. ",
      "english": ""
    },
    {
      "number": 45,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 46,
      "pali": "Vitakkāsakkārasadda, ",
      "english": ""
    },
    {
      "number": 47,
      "pali": "cavanaloke asubhaṁ; ",
      "english": ""
    },
    {
      "number": 48,
      "pali": "Dhammaandhakāramalaṁ, ",
      "english": ""
    },
    {
      "number": 49,
      "pali": "devadattena te dasāti. ",
      "english": ""
    }
  ]
}