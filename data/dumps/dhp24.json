{
  "sutta_id": "DHP24",
  "verses": [
    {
      "number": 1,
      "pali": "Kumbaghosakaseṭṭhivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Uṭṭhānavato satīmato, ",
      "english": "For the hard-working and mindful, "
    },
    {
      "number": 3,
      "pali": "Sucikammassa nisammakārino; ",
      "english": "pure of deed and attentive, "
    },
    {
      "number": 4,
      "pali": "Saññatassa dhammajīvino, ",
      "english": "restrained, living righteously, and diligent, "
    },
    {
      "number": 5,
      "pali": "Appamattassa yasobhivaḍḍhati. ",
      "english": "their reputation only grows. "
    }
  ]
}