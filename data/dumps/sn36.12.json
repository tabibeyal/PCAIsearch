{
  "sutta_id": "SN36.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 36.12 ",
      "english": "Linked Discourses 36.12 "
    },
    {
      "number": 2,
      "pali": "2. Rahogatavagga ",
      "english": "2. In Private "
    },
    {
      "number": 3,
      "pali": "Paṭhamaākāsasutta ",
      "english": "In the Atmosphere (1st) "
    },
    {
      "number": 4,
      "pali": "“Seyyathāpi, bhikkhave, ākāse vividhā vātā vāyanti. ",
      "english": "“Mendicants, various winds blow in the atmosphere. "
    },
    {
      "number": 5,
      "pali": "Puratthimāpi vātā vāyanti, pacchimāpi vātā vāyanti, uttarāpi vātā vāyanti, dakkhiṇāpi vātā vāyanti, sarajāpi vātā vāyanti, arajāpi vātā vāyanti, sītāpi vātā vāyanti, uṇhāpi vātā vāyanti, parittāpi vātā vāyanti, adhimattāpi vātā vāyanti. ",
      "english": "Winds blow from the east, the west, the north, and the south. There are winds that are dusty and dustless, cool and warm, weak and strong. "
    },
    {
      "number": 6,
      "pali": "Evameva kho, bhikkhave, imasmiṁ kāyasmiṁ vividhā vedanā uppajjanti, sukhāpi vedanā uppajjati, dukkhāpi vedanā uppajjati, adukkhamasukhāpi vedanā uppajjatīti. ",
      "english": "In the same way, various feelings arise in this body: pleasant, painful, and neutral feelings. "
    },
    {
      "number": 7,
      "pali": "Yathāpi vātā ākāse, ",
      "english": "There are many and various "
    },
    {
      "number": 8,
      "pali": "vāyanti vividhā puthū; ",
      "english": "winds that blow in the atmosphere. "
    },
    {
      "number": 9,
      "pali": "Puratthimā pacchimā cāpi, ",
      "english": "From the east they come, also the west, "
    },
    {
      "number": 10,
      "pali": "uttarā atha dakkhiṇā. ",
      "english": "the north, and then the south. "
    },
    {
      "number": 11,
      "pali": "Sarajā arajā capi, ",
      "english": "They are dusty and dustless, "
    },
    {
      "number": 12,
      "pali": "sītā uṇhā ca ekadā; ",
      "english": "cool and sometimes warm, "
    },
    {
      "number": 13,
      "pali": "Adhimattā parittā ca, ",
      "english": "strong and weak; "
    },
    {
      "number": 14,
      "pali": "puthū vāyanti mālutā. ",
      "english": "these are the different gales that blow. "
    },
    {
      "number": 15,
      "pali": "Tathevimasmiṁ kāyasmiṁ, ",
      "english": "So too, in this body "
    },
    {
      "number": 16,
      "pali": "samuppajjanti vedanā; ",
      "english": "feelings arise, "
    },
    {
      "number": 17,
      "pali": "Sukhadukkhasamuppatti, ",
      "english": "pleasant and painful, "
    },
    {
      "number": 18,
      "pali": "adukkhamasukhā ca yā. ",
      "english": "and those that are neutral. "
    },
    {
      "number": 19,
      "pali": "Yato ca bhikkhu ātāpī, ",
      "english": "But when a mendicant is keen, "
    },
    {
      "number": 20,
      "pali": "sampajaññaṁ na riñcati; ",
      "english": "not neglecting situational awareness, "
    },
    {
      "number": 21,
      "pali": "Tato so vedanā sabbā, ",
      "english": "that astute person "
    },
    {
      "number": 22,
      "pali": "parijānāti paṇḍito. ",
      "english": "understands all feelings. "
    },
    {
      "number": 23,
      "pali": "So vedanā pariññāya, ",
      "english": "Completely understanding feelings, "
    },
    {
      "number": 24,
      "pali": "diṭṭhe dhamme anāsavo; ",
      "english": "they’re without defilements in this very life. "
    },
    {
      "number": 25,
      "pali": "Kāyassa bhedā dhammaṭṭho, ",
      "english": "That knowledge master is firm in principle; "
    },
    {
      "number": 26,
      "pali": "saṅkhyaṁ nopeti vedagū”ti. ",
      "english": "when their body breaks up, they can’t be reckoned.” "
    },
    {
      "number": 27,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}