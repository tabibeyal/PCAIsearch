{
  "sutta_id": "DHP91",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākassapattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Uyyuñjanti satīmanto, ",
      "english": "The mindful apply themselves; "
    },
    {
      "number": 3,
      "pali": "na nikete ramanti te; ",
      "english": "they delight in no abode. "
    },
    {
      "number": 4,
      "pali": "Haṁsāva pallalaṁ hitvā, ",
      "english": "Like a swan gone from the marsh, "
    },
    {
      "number": 5,
      "pali": "okamokaṁ jahanti te. ",
      "english": "they leave home after home behind. "
    }
  ]
}