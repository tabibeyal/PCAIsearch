{
  "sutta_id": "DHP396",
  "verses": [
    {
      "number": 1,
      "pali": "Ekabrāhmaṇavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na cāhaṁ brāhmaṇaṁ brūmi, ",
      "english": "I don’t call someone a brahmin "
    },
    {
      "number": 3,
      "pali": "yonijaṁ mattisambhavaṁ; ",
      "english": "after the mother’s womb they’re born from. "
    },
    {
      "number": 4,
      "pali": "Bhovādi nāma so hoti, ",
      "english": "If they still have attachments, "
    },
    {
      "number": 5,
      "pali": "sace hoti sakiñcano; ",
      "english": "they’re just someone who says “worthy”. "
    },
    {
      "number": 6,
      "pali": "Akiñcanaṁ anādānaṁ, ",
      "english": "Having nothing, taking nothing: "
    },
    {
      "number": 7,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}