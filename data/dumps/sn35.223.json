    {
      "number": 3,
      "pali": "Ajjhattāyatanadukkhasutta ",
      "english": "The Interior as Suffering "
    },
    {
      "number": 4,
      "pali": "“Cakkhu, bhikkhave, dukkhaṁ …pe… jivhā dukkhā …pe… mano dukkho. ",
      "english": "“Mendicants, the eye, ear, nose, tongue, body, and mind are suffering. "
    },
    {
      "number": 5,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 6,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    }
