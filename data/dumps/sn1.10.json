{
  "sutta_id": "SN1.10",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.10 ",
      "english": "Linked Discourses 1.10 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Araññasutta ",
      "english": "Wilderness "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, that deity addressed the Buddha in verse: "
    },
    {
      "number": 6,
      "pali": "“Araññe viharantānaṁ, ",
      "english": "“Living in the wilderness, "
    },
    {
      "number": 7,
      "pali": "santānaṁ brahmacārinaṁ; ",
      "english": "peaceful spiritual practitioners "
    },
    {
      "number": 8,
      "pali": "Ekabhattaṁ bhuñjamānānaṁ, ",
      "english": "eat just one meal a day: "
    },
    {
      "number": 9,
      "pali": "kena vaṇṇo pasīdatī”ti. ",
      "english": "so why is their complexion so clear?” "
    },
    {
      "number": 10,
      "pali": "“Atītaṁ nānusocanti, ",
      "english": "“They don’t grieve for the past, "
    },
    {
      "number": 11,
      "pali": "nappajappanti nāgataṁ; ",
      "english": "nor do they pray for the future; "
    },
    {
      "number": 12,
      "pali": "Paccuppannena yāpenti, ",
      "english": "they feed on whatever comes that day, "
    },
    {
      "number": 13,
      "pali": "tena vaṇṇo pasīdati. ",
      "english": "that’s why their complexion’s so clear. "
    },
    {
      "number": 14,
      "pali": "Anāgatappajappāya, ",
      "english": "Because they long for the future, "
    },
    {
      "number": 15,
      "pali": "atītassānusocanā; ",
      "english": "and grieve for the past, "
    },
    {
      "number": 16,
      "pali": "Etena bālā sussanti, ",
      "english": "fools wither away, "
    },
    {
      "number": 17,
      "pali": "naḷova harito luto”ti. ",
      "english": "like a green reed mowed down.” "
    },
    {
      "number": 18,
      "pali": "Naḷavaggo paṭhamo. ",
      "english": ""
    },
    {
      "number": 19,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 20,
      "pali": "Oghaṁ nimokkhaṁ upaneyyaṁ, ",
      "english": ""
    },
    {
      "number": 21,
      "pali": "Accenti katichindi ca; ",
      "english": ""
    },
    {
      "number": 22,
      "pali": "Jāgaraṁ appaṭividitā, ",
      "english": ""
    },
    {
      "number": 23,
      "pali": "Susammuṭṭhā mānakāminā; ",
      "english": ""
    },
    {
      "number": 24,
      "pali": "Araññe dasamo vutto, ",
      "english": ""
    },
    {
      "number": 25,
      "pali": "Vaggo tena pavuccati. ",
      "english": ""
    }
  ]
}