{
  "sutta_id": "SN1.10",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.10",
      "english": "Linked Discourses 1.10"
    },
    {
      "number": 2,
      "pali": "Arañña Sutta",
      "english": "The Wilderness"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Standing to one side, a devatā addressed the Blessed One with a verse:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Living in the wilderness,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "staying peaceful, remaining chaste,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "eating just one meal a day:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "why are their faces"
    },
    {
      "number": 8,
      "pali": "",
      "english": "so bright & serene?”"
    },
    {
      "number": 9,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 10,
      "pali": "",
      "english": "“They don’t sorrow over the past,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "don’t long for the future."
    },
    {
      "number": 12,
      "pali": "",
      "english": "They survive on the present."
    },
    {
      "number": 13,
      "pali": "",
      "english": "That’s why their faces"
    },
    {
      "number": 14,
      "pali": "",
      "english": "are bright & serene."
    },
    {
      "number": 15,
      "pali": "",
      "english": "From longing for the future,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "from sorrowing over the past,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "fools wither away"
    },
    {
      "number": 18,
      "pali": "",
      "english": "like a green reed cut down.”"
    }
  ]
}