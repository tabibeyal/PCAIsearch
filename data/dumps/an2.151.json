{
  "sutta_id": "AN2.151",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 2 ",
      "english": "Numbered Discourses 2.151–162 "
    },
    {
      "number": 2,
      "pali": "14. Santhāravagga ",
      "english": "The Chapter on Welcome "
    },
    {
      "number": 3,
      "pali": "151 ",
      "english": "151 "
    },
    {
      "number": 4,
      "pali": "“Dveme, bhikkhave, santhārā. ",
      "english": "“There are these two kinds of welcome. "
    },
    {
      "number": 5,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 6,
      "pali": "Āmisasanthāro ca dhammasanthāro ca. ",
      "english": "Welcome in things of the flesh and welcome in the teaching. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, dve santhārā. ",
      "english": "These are the two kinds of welcome. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ santhārānaṁ yadidaṁ dhammasanthāro”ti. ",
      "english": "The better of these two kinds of welcome is the welcome in the teaching.” "
    }
  ]
}