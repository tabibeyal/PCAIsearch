{
  "sutta_id": "DHP316",
  "verses": [
    {
      "number": 1,
      "pali": "Nigaṇṭhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Alajjitāye lajjanti, ",
      "english": "Unashamed of what is shameful, "
    },
    {
      "number": 3,
      "pali": "lajjitāye na lajjare; ",
      "english": "ashamed of what is not shameful; "
    },
    {
      "number": 4,
      "pali": "Micchādiṭṭhisamādānā, ",
      "english": "beings who uphold wrong view "
    },
    {
      "number": 5,
      "pali": "sattā gacchanti duggatiṁ. ",
      "english": "go to a bad place. "
    }
  ]
}