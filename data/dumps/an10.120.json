{
  "sutta_id": "AN10.120",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.120 ",
      "english": "Numbered Discourses 10.120 "
    },
    {
      "number": 2,
      "pali": "12. Paccorohaṇivagga ",
      "english": "12. The Ceremony of Descent "
    },
    {
      "number": 3,
      "pali": "Dutiyapaccorohaṇīsutta ",
      "english": "The Ceremony of Descent (2nd) "
    },
    {
      "number": 4,
      "pali": "“Ariyaṁ vo, bhikkhave, paccorohaṇiṁ desessāmi. ",
      "english": "“Mendicants, I will teach you the noble descent. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha … ",
      "english": "Listen and apply your mind well, I will speak. … "
    },
    {
      "number": 6,
      "pali": "katamā ca, bhikkhave, ariyā paccorohaṇī? ",
      "english": "And what is the noble descent? "
    },
    {
      "number": 7,
      "pali": "Idha, bhikkhave, ariyasāvako iti paṭisañcikkhati: ",
      "english": "It’s when a noble disciple reflects: "
    },
    {
      "number": 8,
      "pali": "‘micchādiṭṭhiyā kho pāpako vipāko—",
      "english": "‘Wrong view has a bad result "
    },
    {
      "number": 9,
      "pali": "diṭṭhe ceva dhamme abhisamparāyañcā’ti. ",
      "english": "in both this life and the next.’ "
    },
    {
      "number": 10,
      "pali": "So iti paṭisaṅkhāya micchādiṭṭhiṁ pajahati; ",
      "english": "Reflecting like this, they give up wrong view, "
    },
    {
      "number": 11,
      "pali": "micchādiṭṭhiyā paccorohati. ",
      "english": "they descend from wrong view. "
    },
    {
      "number": 12,
      "pali": "Micchāsaṅkappassa kho pāpako vipāko … ",
      "english": "‘Wrong purpose has a bad result …’ … "
    },
    {
      "number": 13,
      "pali": "micchāvācāya kho … ",
      "english": "‘Wrong speech …’ … "
    },
    {
      "number": 14,
      "pali": "micchākammantassa kho … ",
      "english": "‘Wrong action …’ … "
    },
    {
      "number": 15,
      "pali": "micchāājīvassa kho … ",
      "english": "‘Wrong livelihood …’ … "
    },
    {
      "number": 16,
      "pali": "micchāvāyāmassa kho … ",
      "english": "‘Wrong effort …’ … "
    },
    {
      "number": 17,
      "pali": "micchāsatiyā kho … ",
      "english": "‘Wrong mindfulness …’ … "
    },
    {
      "number": 18,
      "pali": "micchāsamādhissa kho … ",
      "english": "‘Wrong immersion …’ … "
    },
    {
      "number": 19,
      "pali": "micchāñāṇassa kho … ",
      "english": "‘Wrong knowledge …’ … "
    },
    {
      "number": 20,
      "pali": "micchāvimuttiyā kho pāpako vipāko—",
      "english": "‘Wrong freedom has a bad result "
    },
    {
      "number": 21,
      "pali": "diṭṭhe ceva dhamme abhisamparāyañcāti. ",
      "english": "in both this life and the next.’ "
    },
    {
      "number": 22,
      "pali": "So iti paṭisaṅkhāya micchāvimuttiṁ pajahati; ",
      "english": "Reflecting like this, they give up wrong freedom, "
    },
    {
      "number": 23,
      "pali": "micchāvimuttiyā paccorohati. ",
      "english": "they descend from wrong freedom. "
    },
    {
      "number": 24,
      "pali": "Ayaṁ vuccati, bhikkhave, ariyā paccorohaṇī”ti. ",
      "english": "This is called the noble descent.” "
    },
    {
      "number": 25,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}