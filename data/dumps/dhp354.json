{
  "sutta_id": "DHP354",
  "verses": [
    {
      "number": 1,
      "pali": "Sakkapañhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sabbadānaṁ dhammadānaṁ jināti, ",
      "english": "The gift of the teaching surmounts all other gifts; "
    },
    {
      "number": 3,
      "pali": "Sabbarasaṁ dhammaraso jināti; ",
      "english": "the taste of the teaching surmounts all other tastes; "
    },
    {
      "number": 4,
      "pali": "Sabbaratiṁ dhammarati jināti, ",
      "english": "the joy of the teaching surmounts all other joys; "
    },
    {
      "number": 5,
      "pali": "Taṇhakkhayo sabbadukkhaṁ jināti. ",
      "english": "the ending of craving surmounts all suffering. "
    }
  ]
}