{
  "sutta_id": "DHP267",
  "verses": [
    {
      "number": 1,
      "pali": "Yodha puññañca pāpañca, ",
      "english": "But one living a spiritual life, "
    },
    {
      "number": 2,
      "pali": "bāhetvā brahmacariyavā; ",
      "english": "who has banished both merit and evil, "
    },
    {
      "number": 3,
      "pali": "Saṅkhāya loke carati, ",
      "english": "who wanders having appraised the world, "
    },
    {
      "number": 4,
      "pali": "sa ve “bhikkhū”ti vuccati. ",
      "english": "is said to be a mendicant. "
    }
  ]
}