{
  "sutta_id": "ITI95",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 95 ",
      "english": "So It Was Said 95 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Pañcamavagga ",
      "english": "Chapter Five "
    },
    {
      "number": 4,
      "pali": "Kāmūpapattisutta ",
      "english": "Provided With Pleasure "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tisso imā, bhikkhave, kāmūpapattiyo. ",
      "english": "“Mendicants, there are these three ways of being provided with sensual pleasures. "
    },
    {
      "number": 7,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Paccupaṭṭhitakāmā, nimmānaratino, paranimmitavasavattino—",
      "english": "Some sensual pleasures are simply present; some are for those who love to create; and some are for those who control what is created by others. "
    },
    {
      "number": 9,
      "pali": "imā kho, bhikkhave, tisso kāmūpapattiyo”ti. ",
      "english": "These are the three ways of being provided with sensual pleasures.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Paccupaṭṭhitakāmā ca, ",
      "english": "“Sensual pleasures that are simply present, "
    },
    {
      "number": 13,
      "pali": "ye devā vasavattino; ",
      "english": "gods who control what is imagined by others, "
    },
    {
      "number": 14,
      "pali": "Nimmānaratino devā, ",
      "english": "gods who love to create, "
    },
    {
      "number": 15,
      "pali": "ye caññe kāmabhogino; ",
      "english": "and others who indulge in sensual pleasures—"
    },
    {
      "number": 16,
      "pali": "Itthabhāvaññathābhāvaṁ, ",
      "english": "They go from this state to another, "
    },
    {
      "number": 17,
      "pali": "saṁsāraṁ nātivattare. ",
      "english": "but don’t escape transmigration. "
    },
    {
      "number": 18,
      "pali": "Etamādīnavaṁ ñatvā, ",
      "english": "Knowing this danger "
    },
    {
      "number": 19,
      "pali": "kāmabhogesu paṇḍito; ",
      "english": "in sensual indulgence, an astute person "
    },
    {
      "number": 20,
      "pali": "Sabbe pariccaje kāme, ",
      "english": "would forsake all sensual pleasures, "
    },
    {
      "number": 21,
      "pali": "ye dibbā ye ca mānusā. ",
      "english": "both human and heavenly. "
    },
    {
      "number": 22,
      "pali": "Piyarūpasātagadhitaṁ, ",
      "english": "Having cut the stream so hard to pass, "
    },
    {
      "number": 23,
      "pali": "chetvā sotaṁ duraccayaṁ; ",
      "english": "that’s tied to pleasant seeming things, "
    },
    {
      "number": 24,
      "pali": "Asesaṁ parinibbanti, ",
      "english": "they become fully extinguished, "
    },
    {
      "number": 25,
      "pali": "asesaṁ dukkhamaccaguṁ. ",
      "english": "completely transcending suffering. "
    },
    {
      "number": 26,
      "pali": "Ariyaddasā vedaguno, ",
      "english": "Seers of the noble truths, knowledge masters, "
    },
    {
      "number": 27,
      "pali": "sammadaññāya paṇḍitā; ",
      "english": "the astute, understanding rightly, "
    },
    {
      "number": 28,
      "pali": "Jātikkhayamabhiññāya, ",
      "english": "directly know the ending of rebirth, "
    },
    {
      "number": 29,
      "pali": "nāgacchanti punabbhavan”ti. ",
      "english": "they come not back to future lives.” "
    },
    {
      "number": 30,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 31,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}