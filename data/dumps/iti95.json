{
  "sutta_id": "ITI95",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 95",
      "english": "Itivuttaka 95"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three ways of obtaining sensual pleasures. Which three? Those whose sensual pleasures are already provided, those who delight in creating, those with control over what is created by others. These are the three ways of obtaining sensual pleasures.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Devas whose pleasures are already provided,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "those with control,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "those who delight in creation,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "and any others enjoying sensual pleasures"
    },
    {
      "number": 8,
      "pali": "",
      "english": "in this state here"
    },
    {
      "number": 9,
      "pali": "",
      "english": "or anywhere else,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "don’t go beyond"
    },
    {
      "number": 11,
      "pali": "",
      "english": "the wandering-on."
    },
    {
      "number": 12,
      "pali": "",
      "english": "Knowing this drawback"
    },
    {
      "number": 13,
      "pali": "",
      "english": "in sensual pleasures, the wise"
    },
    {
      "number": 14,
      "pali": "",
      "english": "should abandon all sensual desires,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "whether human"
    },
    {
      "number": 16,
      "pali": "",
      "english": "or divine."
    },
    {
      "number": 17,
      "pali": "",
      "english": "Having cut the flow of greed"
    },
    {
      "number": 18,
      "pali": "",
      "english": "for lovely, alluring forms"
    },
    {
      "number": 19,
      "pali": "",
      "english": "so hard to transcend,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "having, without remainder,"
    },
    {
      "number": 21,
      "pali": "",
      "english": "comprehended stress,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "they are, without remainder,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "totally unbound."
    },
    {
      "number": 24,
      "pali": "",
      "english": "They, the wise, with an attainer-of-wisdom’s"
    },
    {
      "number": 25,
      "pali": "",
      "english": "noble vision,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "right gnosis,"
    },
    {
      "number": 27,
      "pali": "",
      "english": "directly knowing the ending of birth,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "come to no further becoming."
    }
  ]
}