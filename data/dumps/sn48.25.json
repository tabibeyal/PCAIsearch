      "number": 1,
      "pali": "Saṁyutta Nikāya 48.25 ",
      "english": "Linked Discourses 48.25 "
    },
    {
      "number": 2,
      "pali": "3. Chaḷindriyavagga ",
      "english": "3. The Six Faculties "
    },
    {
      "number": 3,
      "pali": "Suddhakasutta ",
      "english": "Plain Version "
    },
    {
      "number": 4,
      "pali": "“Chayimāni, bhikkhave, indriyāni. ",
      "english": "“Mendicants, there are these six faculties. "
    },
    {
      "number": 5,
      "pali": "Katamāni cha? ",
      "english": "What six? "
    },
    {
      "number": 6,
      "pali": "Cakkhundriyaṁ, sotindriyaṁ, ghānindriyaṁ, jivhindriyaṁ, kāyindriyaṁ, manindriyaṁ—",
      "english": "The faculties of the eye, ear, nose, tongue, body, and mind. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, cha indriyānī”ti. ",
      "english": "These are the six faculties.” "
    },
    {
      "number": 8,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}