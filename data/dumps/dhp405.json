{
  "sutta_id": "DHP405",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Nidhāya daṇḍaṁ bhūtesu, ",
      "english": "They’ve laid aside violence "
    },
    {
      "number": 3,
      "pali": "tasesu thāvaresu ca; ",
      "english": "against creatures firm and frail; "
    },
    {
      "number": 4,
      "pali": "Yo na hanti na ghāteti, ",
      "english": "not killing or making others kill: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}