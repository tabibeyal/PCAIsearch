  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 77",
      "english": "Itivuttaka 77"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, this body falls apart; consciousness is subject to fading; all acquisitions are inconstant, stressful, subject to change.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Knowing the body as falling apart,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "& consciousness as dissolving away,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "seeing the danger in acquisitions,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "you’ve gone beyond"
    },
    {
      "number": 8,
      "pali": "",
      "english": "birth & death."
    },
    {
      "number": 9,
      "pali": "",
      "english": "Having reached the foremost peace,"
    },
    {
      "number": 10,
      "pali": "",
      "english": "you bide your time,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "composed."
    }
  ]
}