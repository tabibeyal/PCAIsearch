{
  "sutta_id": "ITI77",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 77 ",
      "english": "So It Was Said 77 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Bhidurasutta ",
      "english": "Fragile "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Bhidurāyaṁ, bhikkhave, kāyo, viññāṇaṁ virāgadhammaṁ, sabbe upadhī aniccā dukkhā vipariṇāmadhammā”ti. ",
      "english": "“This body is fragile, mendicants, consciousness is liable to fade away, and all attachments are impermanent, suffering, and perishable.” "
    },
    {
      "number": 7,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 8,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 9,
      "pali": "“Kāyañca bhiduraṁ ñatvā, ",
      "english": "“Knowing that the body is fragile, "
    },
    {
      "number": 10,
      "pali": "Viññāṇañca virāgunaṁ; ",
      "english": "that consciousness is faded, "
    },
    {
      "number": 11,
      "pali": "Upadhīsu bhayaṁ disvā, ",
      "english": "and seeing the danger in attachments, "
    },
    {
      "number": 12,
      "pali": "Jātimaraṇamaccagā; ",
      "english": "they go beyond birth and death. "
    },
    {
      "number": 13,
      "pali": "Sampatvā paramaṁ santiṁ, ",
      "english": "Having attained ultimate peace, "
    },
    {
      "number": 14,
      "pali": "Kālaṁ kaṅkhati bhāvitatto”ti. ",
      "english": "evolved, they await their time.” "
    },
    {
      "number": 15,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 16,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}