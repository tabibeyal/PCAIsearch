{
  "sutta_id": "DHP368",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Mettāvihārī yo bhikkhu, ",
      "english": "A mendicant who meditates on love, "
    },
    {
      "number": 3,
      "pali": "pasanno buddhasāsane; ",
      "english": "devoted to the Buddha’s teaching, "
    },
    {
      "number": 4,
      "pali": "Adhigacche padaṁ santaṁ, ",
      "english": "would realize the peaceful state, "
    },
    {
      "number": 5,
      "pali": "saṅkhārūpasamaṁ sukhaṁ. ",
      "english": "the blissful stilling of conditions. "
    }
  ]
}