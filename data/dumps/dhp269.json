{
  "sutta_id": "DHP269",
  "verses": [
    {
      "number": 1,
      "pali": "Pāpāni parivajjeti, ",
      "english": "and shunning the bad—"
    },
    {
      "number": 2,
      "pali": "sa munī tena so muni; ",
      "english": "that is a sage, <j>and that is how one becomes a sage. "
    },
    {
      "number": 3,
      "pali": "Yo munāti ubho loke, ",
      "english": "One who sagely weighs both in the world, "
    },
    {
      "number": 4,
      "pali": "“muni” tena pavuccati. ",
      "english": "is thereby said to be a sage. "
    }
  ]
}