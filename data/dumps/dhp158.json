{
  "sutta_id": "DHP158",
  "verses": [
    {
      "number": 1,
      "pali": "Upanandasakyaputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attānameva paṭhamaṁ, ",
      "english": "The astute would avoid being corrupted "
    },
    {
      "number": 3,
      "pali": "patirūpe nivesaye; ",
      "english": "by first grounding themselves "
    },
    {
      "number": 4,
      "pali": "Athaññamanusāseyya, ",
      "english": "in what is suitable, "
    },
    {
      "number": 5,
      "pali": "na kilisseyya paṇḍito. ",
      "english": "and then instructing others. "
    }
  ]
}