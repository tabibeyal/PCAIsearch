{
  "sutta_id": "SN34.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 34.12 ",
      "english": "Linked Discourses 34.12 "
    },
    {
      "number": 2,
      "pali": "1. Jhānavagga ",
      "english": "1. Absorption "
    },
    {
      "number": 3,
      "pali": "Samāpattimūlakavuṭṭhānasutta ",
      "english": "Entering and Emerging "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Cattārome, bhikkhave, jhāyī. ",
      "english": "“Mendicants, there are these four meditators. "
    },
    {
      "number": 6,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 7,
      "pali": "Idha, bhikkhave, ekacco jhāyī samādhismiṁ samāpattikusalo hoti, na samādhismiṁ vuṭṭhānakusalo. ",
      "english": "One meditator is skilled in entering immersion but not in emerging from it. …” "
    },
    {
      "number": 8,
      "pali": "Idha pana, bhikkhave, ekacco jhāyī samādhismiṁ vuṭṭhānakusalo hoti, na samādhismiṁ samāpattikusalo. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Idha pana, bhikkhave, ekacco jhāyī neva samādhismiṁ samāpattikusalo hoti, na ca samādhismiṁ vuṭṭhānakusalo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Idha pana, bhikkhave, ekacco jhāyī samādhismiṁ samāpattikusalo ca hoti, samādhismiṁ vuṭṭhānakusalo ca. ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Tatra, bhikkhave, yvāyaṁ jhāyī …pe… ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "pavaro cā”ti. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Dvādasamaṁ. ",
      "english": ""
    }
  ]
}