  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.186 ",
      "english": "Numbered Discourses 10.186 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Ācayagāmisutta ",
      "english": "Leading to Accumulation "
    },
    {
      "number": 4,
      "pali": "“Ācayagāmiñca vo, bhikkhave, dhammaṁ desessāmi apacayagāmiñca. ",
      "english": "“I will teach you the principle that leads to accumulation and that which leads to dispersal. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, ācayagāmī dhammo? ",
      "english": "And what is the principle that leads to accumulation? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, ācayagāmī dhammo. ",
      "english": "This is called the principle that leads to accumulation. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, apacayagāmī dhammo? ",
      "english": "And what is the principle that leads to dispersal? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, apacayagāmī dhammo”ti. ",
      "english": "This is called the principle that leads to dispersal.” "
    },
    {
      "number": 14,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}