{
  "sutta_id": "DHP36",
  "verses": [
    {
      "number": 1,
      "pali": "Aññataraukkaṇṭhitabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sududdasaṁ sunipuṇaṁ, ",
      "english": "So hard to see, so subtle, "
    },
    {
      "number": 3,
      "pali": "yatthakāmanipātinaṁ; ",
      "english": "alighting where it will; "
    },
    {
      "number": 4,
      "pali": "Cittaṁ rakkhetha medhāvī, ",
      "english": "the discerning protect the mind, "
    },
    {
      "number": 5,
      "pali": "cittaṁ guttaṁ sukhāvahaṁ. ",
      "english": "a guarded mind leads to bliss. "
    }
  ]
}