{
  "sutta_id": "DHP143",
  "verses": [
    {
      "number": 1,
      "pali": "Pilotikatissattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Hirīnisedho puriso, ",
      "english": "Can a person constrained by conscience "
    },
    {
      "number": 3,
      "pali": "koci lokasmi vijjati; ",
      "english": "be found in the world? "
    },
    {
      "number": 4,
      "pali": "Yo niddaṁ apabodheti, ",
      "english": "Who shies away from blame, "
    },
    {
      "number": 5,
      "pali": "asso bhadro kasāmiva. ",
      "english": "like a fine horse from the whip? "
    }
  ]
}