{
  "sutta_id": "DHP99",
  "verses": [
    {
      "number": 1,
      "pali": "Aññataraitthivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ramaṇīyāni araññāni, ",
      "english": "Delightful are the wildernesses "
    },
    {
      "number": 3,
      "pali": "yattha na ramatī jano; ",
      "english": "where no people delight. "
    },
    {
      "number": 4,
      "pali": "Vītarāgā ramissanti, ",
      "english": "Those free of greed will delight there, "
    },
    {
      "number": 5,
      "pali": "na te kāmagavesino. ",
      "english": "not those who seek sensual pleasures. "
    },
    {
      "number": 6,
      "pali": "Arahantavaggo sattamo. ",
      "english": ""
    }
  ]
}