{
  "sutta_id": "DHP275",
  "verses": [
    {
      "number": 1,
      "pali": "Etañhi tumhe paṭipannā, ",
      "english": "When you all are practicing this, "
    },
    {
      "number": 2,
      "pali": "dukkhassantaṁ karissatha; ",
      "english": "you will make an end of suffering. "
    },
    {
      "number": 3,
      "pali": "Akkhāto vo mayā maggo, ",
      "english": "I have explained the path to you "
    },
    {
      "number": 4,
      "pali": "aññāya sallakantanaṁ. ",
      "english": "for extracting the thorn with wisdom. "
    }
  ]
}