{
  "sutta_id": "DHP242",
  "verses": [
    {
      "number": 1,
      "pali": "Aññatarakulaputtavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Malitthiyā duccaritaṁ, ",
      "english": "Misconduct is a woman’s stain. "
    },
    {
      "number": 3,
      "pali": "maccheraṁ dadato malaṁ; ",
      "english": "A giver’s stain is stinginess. "
    },
    {
      "number": 4,
      "pali": "Malā ve pāpakā dhammā, ",
      "english": "Bad qualities are a stain "
    },
    {
      "number": 5,
      "pali": "asmiṁ loke paramhi ca. ",
      "english": "in this world and the next. "
    }
  ]
}