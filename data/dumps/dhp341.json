{
  "sutta_id": "DHP341",
  "verses": [
    {
      "number": 1,
      "pali": "Saritāni sinehitāni ca, ",
      "english": "A personage’s joys "
    },
    {
      "number": 2,
      "pali": "Somanassāni bhavanti jantuno; ",
      "english": "flow from senses and cravings. "
    },
    {
      "number": 3,
      "pali": "Te sātasitā sukhesino, ",
      "english": "Seekers of happiness, bent on pleasure, "
    },
    {
      "number": 4,
      "pali": "Te ve jātijarūpagā narā. ",
      "english": "continue to be reborn and grow old. "
    }
  ]
}