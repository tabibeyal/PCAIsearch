{
  "sutta_id": "SN36.2",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 36.2 ",
      "english": "Linked Discourses 36.2 "
    },
    {
      "number": 2,
      "pali": "1. Sagāthāvagga ",
      "english": "1. With Verses "
    },
    {
      "number": 3,
      "pali": "Sukhasutta ",
      "english": "Pleasure "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, vedanā. ",
      "english": "“Mendicants, there are these three feelings. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—",
      "english": "Pleasant, painful, and neutral feeling. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso vedanāti. ",
      "english": "These are the three feelings. "
    },
    {
      "number": 8,
      "pali": "Sukhaṁ vā yadi vā dukkhaṁ, ",
      "english": "Whatever is felt "
    },
    {
      "number": 9,
      "pali": "adukkhamasukhaṁ saha; ",
      "english": "internally and externally—"
    },
    {
      "number": 10,
      "pali": "Ajjhattañca bahiddhā ca, ",
      "english": "whether pleasure or pain "
    },
    {
      "number": 11,
      "pali": "yaṁ kiñci atthi veditaṁ. ",
      "english": "as well as what’s neutral—"
    },
    {
      "number": 12,
      "pali": "Etaṁ dukkhanti ñatvāna, ",
      "english": "having known this as suffering, "
    },
    {
      "number": 13,
      "pali": "mosadhammaṁ palokinaṁ; ",
      "english": "deceptive, breaking apart, "
    },
    {
      "number": 14,
      "pali": "Phussa phussa vayaṁ passaṁ, ",
      "english": "one sees them vanish <j>as they’re experienced again and again: "
    },
    {
      "number": 15,
      "pali": "evaṁ tattha virajjatī”ti. ",
      "english": "that’s how to be free of desire for them.” "
    },
    {
      "number": 16,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}