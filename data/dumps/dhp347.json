{
  "sutta_id": "DHP347",
  "verses": [
    {
      "number": 1,
      "pali": "Khemātherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ye rāgarattānupatanti sotaṁ, ",
      "english": "Besotted by lust they fall into the stream, "
    },
    {
      "number": 3,
      "pali": "Sayaṅkataṁ makkaṭakova jālaṁ; ",
      "english": "like a spider caught in the web she wove. "
    },
    {
      "number": 4,
      "pali": "Etampi chetvāna vajanti dhīrā, ",
      "english": "The attentive proceed, having cut this one too, "
    },
    {
      "number": 5,
      "pali": "Anapekkhino sabbadukkhaṁ pahāya. ",
      "english": "unconcerned, having given up all suffering. "
    }
  ]
}