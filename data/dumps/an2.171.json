    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Satibalañca samādhibalañca. ",
      "english": "The power of mindfulness and the power of immersion. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”. ",
      "english": "These are the two things.” "
    }
  ]
}