{
  "sutta_id": "DHP326",
  "verses": [
    {
      "number": 1,
      "pali": "Sānusāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idaṁ pure cittamacāri cārikaṁ, ",
      "english": "In the past my mind wandered "
    },
    {
      "number": 3,
      "pali": "Yenicchakaṁ yatthakāmaṁ yathāsukhaṁ; ",
      "english": "how it wished, where it liked, as it pleased. "
    },
    {
      "number": 4,
      "pali": "Tadajjahaṁ niggahessāmi yoniso, ",
      "english": "Now I’ll carefully guide it, "
    },
    {
      "number": 5,
      "pali": "Hatthippabhinnaṁ viya aṅkusaggaho. ",
      "english": "as a trainer with a hook guides a rutting elephant. "
    }
  ]
}