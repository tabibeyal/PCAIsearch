      "number": 1,
      "pali": "Saṁyutta Nikāya 22.15 ",
      "english": "Linked Discourses 22.15 "
    },
    {
      "number": 2,
      "pali": "2. Aniccavagga ",
      "english": "2. Impermanence "
    },
    {
      "number": 3,
      "pali": "Yadaniccasutta ",
      "english": "That Which is Impermanent "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Rūpaṁ, bhikkhave, aniccaṁ. ",
      "english": "“Mendicants, form is impermanent. "
    },
    {
      "number": 6,
      "pali": "Yadaniccaṁ taṁ dukkhaṁ; ",
      "english": "What’s impermanent is suffering. "
    },
    {
      "number": 7,
      "pali": "yaṁ dukkhaṁ tadanattā; ",
      "english": "What’s suffering is not-self. "
    },
    {
      "number": 8,
      "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 9,
      "pali": "Vedanā aniccā. ",
      "english": "Feeling is impermanent … "
    },
    {
      "number": 10,
      "pali": "Yadaniccaṁ taṁ dukkhaṁ; ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "yaṁ dukkhaṁ tadanattā; ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Saññā aniccā …pe… ",
      "english": "Perception is impermanent … "
    },
    {
      "number": 14,
      "pali": "saṅkhārā aniccā … ",
      "english": "Choices are impermanent … "
    },
    {
      "number": 15,
      "pali": "viññāṇaṁ aniccaṁ. ",
      "english": "Consciousness is impermanent. "
    },
    {
      "number": 16,
      "pali": "Yadaniccaṁ taṁ dukkhaṁ; ",
      "english": "What’s impermanent is suffering. "
    },
    {
      "number": 17,
      "pali": "yaṁ dukkhaṁ tadanattā; ",
      "english": "What’s suffering is not-self. "
    },
    {
      "number": 18,
      "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ. ",
      "english": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ "
    },
    {
      "number": 19,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 20,
      "pali": "nāparaṁ itthattāyā’ti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
