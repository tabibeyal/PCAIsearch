{
  "sutta_id": "AN10.191",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.191 ",
      "english": "Numbered Discourses 10.191 "
    },
    {
      "number": 2,
      "pali": "19. Ariyamaggavagga ",
      "english": "19. The Noble Path "
    },
    {
      "number": 3,
      "pali": "Saddhammasutta ",
      "english": "The True Teaching "
    },
    {
      "number": 4,
      "pali": "“Saddhammañca vo, bhikkhave, desessāmi asaddhammañca. ",
      "english": "“I will teach you what is the true teaching and what is not the true teaching. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, asaddhammo? ",
      "english": "And what is not the true teaching? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, asaddhammo. ",
      "english": "This is called what is not the true teaching. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, saddhammo? ",
      "english": "And what is the true teaching? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, saddhammo”ti. ",
      "english": "This is called the true teaching.” "
    },
    {
      "number": 14,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}