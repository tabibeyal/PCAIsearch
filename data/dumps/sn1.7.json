{
  "sutta_id": "SN1.7",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.7",
      "english": "Linked Discourses 1.7"
    },
    {
      "number": 2,
      "pali": "Appaṭividitā Sutta",
      "english": "Unpenetrated"
    },
    {
      "number": 3,
      "pali": "",
      "english": "In light of the question as to how best to translate Buddha, this sutta offers evidence in support of the translation, “awakened.” The verses draw a direct connection between two words derived from the same root: the adjective sambuddha, a variant of buddha, and the verb pābujjhati, which in context clearly means to awaken from sleep."
    },
    {
      "number": 4,
      "pali": "",
      "english": "Standing to one side, a devatā addressed the Blessed One with a verse:"
    },
    {
      "number": 5,
      "pali": "",
      "english": "“Those in whom"
    },
    {
      "number": 6,
      "pali": "",
      "english": "phenomena are unpenetrated,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "who may be led"
    },
    {
      "number": 8,
      "pali": "",
      "english": "by the teachings of others:"
    },
    {
      "number": 9,
      "pali": "",
      "english": "Asleep are they;"
    },
    {
      "number": 10,
      "pali": "",
      "english": "they haven’t awakened."
    },
    {
      "number": 11,
      "pali": "",
      "english": "It’s time for them"
    },
    {
      "number": 12,
      "pali": "",
      "english": "to awaken.”"
    },
    {
      "number": 13,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 14,
      "pali": "",
      "english": "“Those in whom"
    },
    {
      "number": 15,
      "pali": "",
      "english": "phenomena are well-penetrated,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "may not be led"
    },
    {
      "number": 17,
      "pali": "",
      "english": "by the teachings of others."
    },
    {
      "number": 18,
      "pali": "",
      "english": "Awakened"
    },
    {
      "number": 19,
      "pali": "",
      "english": "through right knowing,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "they go among the discordant"
    },
    {
      "number": 21,
      "pali": "",
      "english": "harmoniously.”"
    }
  ]
}