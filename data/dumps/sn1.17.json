{
  "sutta_id": "SN1.17",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.17 ",
      "english": "Linked Discourses 1.17 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Dukkarasutta ",
      "english": "Hard to Do "
    },
    {
      "number": 4,
      "pali": "“Dukkaraṁ duttitikkhañca, ",
      "english": "“Hard to do, hard to endure, "
    },
    {
      "number": 5,
      "pali": "abyattena ca sāmaññaṁ; ",
      "english": "is the ascetic life for the inept, "
    },
    {
      "number": 6,
      "pali": "Bahūhi tattha sambādhā, ",
      "english": "for it has many narrow passes "
    },
    {
      "number": 7,
      "pali": "yattha bālo visīdatī”ti. ",
      "english": "where the fool founders.” "
    },
    {
      "number": 8,
      "pali": "“Katihaṁ careyya sāmaññaṁ, ",
      "english": "“How many days could an ascetic live "
    },
    {
      "number": 9,
      "pali": "cittañce na nivāraye; ",
      "english": "without controlling the mind? "
    },
    {
      "number": 10,
      "pali": "Pade pade visīdeyya, ",
      "english": "They’d founder with each step, "
    },
    {
      "number": 11,
      "pali": "saṅkappānaṁ vasānugoti. ",
      "english": "under the sway of thoughts. "
    },
    {
      "number": 12,
      "pali": "Kummova aṅgāni sake kapāle, ",
      "english": "A mendicant should collect their thoughts "
    },
    {
      "number": 13,
      "pali": "Samodahaṁ bhikkhu manovitakke; ",
      "english": "as a tortoise draws its limbs into its shell. "
    },
    {
      "number": 14,
      "pali": "Anissito aññamaheṭhayāno, ",
      "english": "Independent, not disturbing others, "
    },
    {
      "number": 15,
      "pali": "Parinibbuto nūpavadeyya kañcī”ti. ",
      "english": "quenched: they wouldn’t blame anyone.” "
    }
  ]
}