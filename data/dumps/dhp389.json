{
  "sutta_id": "DHP389",
  "verses": [
    {
      "number": 1,
      "pali": "Sāriputtattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na brāhmaṇassa pahareyya, ",
      "english": "One should never strike a brahmin, "
    },
    {
      "number": 3,
      "pali": "nāssa muñcetha brāhmaṇo; ",
      "english": "nor should a brahmin retaliate. "
    },
    {
      "number": 4,
      "pali": "Dhī brāhmaṇassa hantāraṁ, ",
      "english": "Woe to the one who hurts a brahmin, "
    },
    {
      "number": 5,
      "pali": "tato dhī yassa muñcati. ",
      "english": "and woe for the one who retaliates. "
    }
  ]
}