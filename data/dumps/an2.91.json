{
  "sutta_id": "AN2.91",
  "verses": [
    {
      "number": 1,
      "pali": "91 ",
      "english": "91 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Bhavadiṭṭhi ca vibhavadiṭṭhi ca. ",
      "english": "Views favoring existence and views favoring nonexistence. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}