{
  "sutta_id": "ITI76",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 76 ",
      "english": "So It Was Said 76 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 4,
      "pali": "Sukhapatthanāsutta ",
      "english": "Wishing for Happiness "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, sukhāni patthayamāno sīlaṁ rakkheyya paṇḍito. ",
      "english": "“Mendicants, an astute person who wishes for three kinds of happiness should take care of their ethics. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Pasaṁsā me āgacchatūti sīlaṁ rakkheyya paṇḍito, bhogā me uppajjantūti sīlaṁ rakkheyya paṇḍito, kāyassa bhedā paraṁ maraṇā sugatiṁ saggaṁ lokaṁ upapajjissāmīti sīlaṁ rakkheyya paṇḍito. ",
      "english": "‘May I be be praised!’ ‘May I become rich!’ ‘When my body breaks up, after death, may I be reborn in a good place, a heavenly realm!’ "
    },
    {
      "number": 9,
      "pali": "Imāni kho, bhikkhave, tīṇi sukhāni patthayamāno sīlaṁ rakkheyya paṇḍito”ti. ",
      "english": "An astute person who wishes for these three kinds of happiness should protect their precepts.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Sīlaṁ rakkheyya medhāvī, ",
      "english": "“Wishing for three kinds of happiness—"
    },
    {
      "number": 13,
      "pali": "patthayāno tayo sukhe; ",
      "english": "praise, prosperity, "
    },
    {
      "number": 14,
      "pali": "Pasaṁsaṁ vittalābhañca, ",
      "english": "and to delight in heaven after passing away—"
    },
    {
      "number": 15,
      "pali": "pecca sagge pamodanaṁ. ",
      "english": "the wise would take care of their ethics. "
    },
    {
      "number": 16,
      "pali": "Akarontopi ce pāpaṁ, ",
      "english": "Though you do no wrong, "
    },
    {
      "number": 17,
      "pali": "karontamupasevati; ",
      "english": "if you associate with one who does, "
    },
    {
      "number": 18,
      "pali": "Saṅkiyo hoti pāpasmiṁ, ",
      "english": "you’re suspected of wrong, "
    },
    {
      "number": 19,
      "pali": "avaṇṇo cassa rūhati. ",
      "english": "and your disrepute grows. "
    },
    {
      "number": 20,
      "pali": "Yādisaṁ kurute mittaṁ, ",
      "english": "Whatever kind of friend you make, "
    },
    {
      "number": 21,
      "pali": "yādisaṁ cūpasevati; ",
      "english": "with whom you associate, "
    },
    {
      "number": 22,
      "pali": "Sa ve tādisako hoti, ",
      "english": "that’s how you become, "
    },
    {
      "number": 23,
      "pali": "sahavāso hi tādiso. ",
      "english": "for so it is when you share your life. "
    },
    {
      "number": 24,
      "pali": "Sevamāno sevamānaṁ, ",
      "english": "The one who associates and the one associated with, "
    },
    {
      "number": 25,
      "pali": "samphuṭṭho samphusaṁ paraṁ; ",
      "english": "the one contacted and the one who contacts another, "
    },
    {
      "number": 26,
      "pali": "Saro diddho kalāpaṁva, ",
      "english": "are like an arrow smeared with poison "
    },
    {
      "number": 27,
      "pali": "alittamupalimpati; ",
      "english": "that contaminates the quiver. "
    },
    {
      "number": 28,
      "pali": "Upalepabhayā dhīro, ",
      "english": "The attentive, fearing contamination, "
    },
    {
      "number": 29,
      "pali": "neva pāpasakhā siyā. ",
      "english": "would never have wicked comrades. "
    },
    {
      "number": 30,
      "pali": "Pūtimacchaṁ kusaggena, ",
      "english": "A man who wraps "
    },
    {
      "number": 31,
      "pali": "yo naro upanayhati; ",
      "english": "putrid fish in blades of grass "
    },
    {
      "number": 32,
      "pali": "Kusāpi pūti vāyanti, ",
      "english": "makes the grass stink—"
    },
    {
      "number": 33,
      "pali": "evaṁ bālūpasevanā. ",
      "english": "so it is when associating with fools. "
    },
    {
      "number": 34,
      "pali": "Tagarañca palāsena, ",
      "english": "But one who wraps "
    },
    {
      "number": 35,
      "pali": "yo naro upanayhati; ",
      "english": "sandalwood incense in leaves "
    },
    {
      "number": 36,
      "pali": "Pattāpi surabhi vāyanti, ",
      "english": "makes the leaves fragrant—"
    },
    {
      "number": 37,
      "pali": "evaṁ dhīrūpasevanā. ",
      "english": "so it is when associating with the attentive. "
    },
    {
      "number": 38,
      "pali": "Tasmā pattapuṭasseva, ",
      "english": "So, knowing they’ll end up "
    },
    {
      "number": 39,
      "pali": "ñatvā sampākamattano; ",
      "english": "like the wrapping, the astute "
    },
    {
      "number": 40,
      "pali": "Asante nupaseveyya, ",
      "english": "would shun the wicked, "
    },
    {
      "number": 41,
      "pali": "sante seveyya paṇḍito; ",
      "english": "and befriend the good. "
    },
    {
      "number": 42,
      "pali": "Asanto nirayaṁ nenti, ",
      "english": "The wicked lead you to hell, "
    },
    {
      "number": 43,
      "pali": "santo pāpenti suggatin”ti. ",
      "english": "the good help you to a good place.” "
    },
    {
      "number": 44,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 45,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}