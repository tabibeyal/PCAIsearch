{
  "sutta_id": "ITI76",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 76",
      "english": "Itivuttaka 76"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Aspiring to these three forms of bliss, monks, a wise person should guard his virtue. Which three? [Thinking,] ‘May praise come to me,’ a wise person should guard his virtue. [Thinking,] ‘May wealth come to me,’ a wise person should guard his virtue. [Thinking,] ‘At the break-up of the body, after death, may I reappear in a good destination, a heavenly world,’ a wise person should guard his virtue. Aspiring to these three forms of bliss, a wise person should guard his virtue.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Intelligent,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "you should guard your virtue,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "aspiring to three forms of bliss:"
    },
    {
      "number": 7,
      "pali": "",
      "english": "praise;"
    },
    {
      "number": 8,
      "pali": "",
      "english": "the obtaining of wealth;"
    },
    {
      "number": 9,
      "pali": "",
      "english": "and, after death, rejoicing"
    },
    {
      "number": 10,
      "pali": "",
      "english": "in heaven."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Even if you do no evil"
    },
    {
      "number": 12,
      "pali": "",
      "english": "but seek out one who does,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "you’re suspected of evil."
    },
    {
      "number": 14,
      "pali": "",
      "english": "Your bad reputation"
    },
    {
      "number": 15,
      "pali": "",
      "english": "grows."
    },
    {
      "number": 16,
      "pali": "",
      "english": "The sort of person you make a friend,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "the sort you seek out,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "that’s the sort you yourself become–"
    },
    {
      "number": 19,
      "pali": "",
      "english": "for your living together is of"
    },
    {
      "number": 20,
      "pali": "",
      "english": "that sort."
    },
    {
      "number": 21,
      "pali": "",
      "english": "The one associated with,"
    },
    {
      "number": 22,
      "pali": "",
      "english": "the one who associates,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "the one who’s touched,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "the one who touches another"
    },
    {
      "number": 25,
      "pali": "",
      "english": "–like an arrow smeared with poison–"
    },
    {
      "number": 26,
      "pali": "",
      "english": "contaminates the quiver."
    },
    {
      "number": 27,
      "pali": "",
      "english": "So, fearing contamination, the enlightened"
    },
    {
      "number": 28,
      "pali": "",
      "english": "should not be comrades"
    },
    {
      "number": 29,
      "pali": "",
      "english": "with evil people."
    },
    {
      "number": 30,
      "pali": "",
      "english": "A man who wraps rotting fish"
    },
    {
      "number": 31,
      "pali": "",
      "english": "in a blade of kusa grass"
    },
    {
      "number": 32,
      "pali": "",
      "english": "makes the grass smelly:"
    },
    {
      "number": 33,
      "pali": "",
      "english": "so it is"
    },
    {
      "number": 34,
      "pali": "",
      "english": "if you seek out fools."
    },
    {
      "number": 35,
      "pali": "",
      "english": "But a man who wraps powdered incense"
    },
    {
      "number": 36,
      "pali": "",
      "english": "in the leaf of a tree"
    },
    {
      "number": 37,
      "pali": "",
      "english": "makes the leaf fragrant:"
    },
    {
      "number": 38,
      "pali": "",
      "english": "so it is"
    },
    {
      "number": 39,
      "pali": "",
      "english": "if you seek out"
    },
    {
      "number": 40,
      "pali": "",
      "english": "the enlightened."
    },
    {
      "number": 41,
      "pali": "",
      "english": "So,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "knowing your own outcome"
    },
    {
      "number": 43,
      "pali": "",
      "english": "as like the leaf-wrapper’s,"
    },
    {
      "number": 44,
      "pali": "",
      "english": "you shouldn’t seek out"
    },
    {
      "number": 45,
      "pali": "",
      "english": "those who aren’t good."
    },
    {
      "number": 46,
      "pali": "",
      "english": "The wise would associate"
    },
    {
      "number": 47,
      "pali": "",
      "english": "with those who are."
    },
    {
      "number": 48,
      "pali": "",
      "english": "Those who aren’t good"
    },
    {
      "number": 49,
      "pali": "",
      "english": "lead you to hell."
    },
    {
      "number": 50,
      "pali": "",
      "english": "The good help you reach"
    },
    {
      "number": 51,
      "pali": "",
      "english": "a good destination."
    }
  ]
}