{
  "sutta_id": "SN2.11",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.11 ",
      "english": "Linked Discourses 2.11 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Candimasasutta ",
      "english": "With Candimasa "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Atha kho candimaso devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ",
      "english": "Then, late at night, the glorious godling Candimasa, lighting up the entire Jeta’s Grove, went up to the Buddha, bowed, stood to one side, "
    },
    {
      "number": 6,
      "pali": "Ekamantaṁ ṭhito kho candimaso devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "and spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 7,
      "pali": "“Te hi sotthiṁ gamissanti, ",
      "english": "“Like deer in a mosquito-free marsh, "
    },
    {
      "number": 8,
      "pali": "kacchevāmakase magā; ",
      "english": "they will reach a safe place "
    },
    {
      "number": 9,
      "pali": "Jhānāni upasampajja, ",
      "english": "having entered the absorptions, "
    },
    {
      "number": 10,
      "pali": "ekodi nipakā satā”ti. ",
      "english": "unified, alert, and mindful.” "
    },
    {
      "number": 11,
      "pali": "“Te hi pāraṁ gamissanti, ",
      "english": "“Like fish when the net is cut, "
    },
    {
      "number": 12,
      "pali": "chetvā jālaṁva ambujo; ",
      "english": "they will reach the far shore "
    },
    {
      "number": 13,
      "pali": "Jhānāni upasampajja, ",
      "english": "having entered the absorptions, "
    },
    {
      "number": 14,
      "pali": "appamattā raṇañjahā”ti. ",
      "english": "diligent, with strife discarded.” "
    }
  ]
}