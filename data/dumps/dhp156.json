{
  "sutta_id": "DHP156",
  "verses": [
    {
      "number": 1,
      "pali": "Acaritvā brahmacariyaṁ, ",
      "english": "When young they spurned the spiritual path "
    },
    {
      "number": 2,
      "pali": "aladdhā yobbane dhanaṁ; ",
      "english": "and failed to earn any wealth. "
    },
    {
      "number": 3,
      "pali": "Senti cāpātikhīṇāva, ",
      "english": "Now they lie like spent arrows, "
    },
    {
      "number": 4,
      "pali": "purāṇāni anutthunaṁ. ",
      "english": "bemoaning over things past. "
    },
    {
      "number": 5,
      "pali": "Jarāvaggo ekādasamo. ",
      "english": ""
    }
  ]
}