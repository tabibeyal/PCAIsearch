{
  "sutta_id": "AN7.35",
  "verses": [
    {
      "number": 1,
      "pali": "Numerical Discourses 7.35",
      "english": "Numerical Discourses 7.35"
    },
    {
      "number": 2,
      "pali": "Mitta Sutta",
      "english": "A Friend"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“Monks, a friend endowed with seven qualities is worth associating with. Which seven? He gives what is hard to give. He does what is hard to do. He endures what is hard to endure. He reveals his secrets to you. He keeps your secrets. When misfortunes strike, he doesn’t abandon you. When you’re down & out, he doesn’t look down on you. A friend endowed with these seven qualities is worth associating with."
    },
    {
      "number": 4,
      "pali": "",
      "english": "“He gives what is beautiful,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "hard to give;"
    },
    {
      "number": 6,
      "pali": "",
      "english": "does what is hard to do;"
    },
    {
      "number": 7,
      "pali": "",
      "english": "endures painful, ill-spoken words."
    },
    {
      "number": 8,
      "pali": "",
      "english": "His secrets he tells you;"
    },
    {
      "number": 9,
      "pali": "",
      "english": "your secrets he keeps."
    },
    {
      "number": 10,
      "pali": "",
      "english": "When misfortunes strike,"
    },
    {
      "number": 11,
      "pali": "",
      "english": "he doesn’t abandon you;"
    },
    {
      "number": 12,
      "pali": "",
      "english": "when you’re down & out,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "doesn’t look down on you."
    },
    {
      "number": 14,
      "pali": "",
      "english": "A person in whom these traits are found,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "is a friend to be cultivated"
    },
    {
      "number": 16,
      "pali": "",
      "english": "by anyone wanting a friend.”"
    }
  ]
}