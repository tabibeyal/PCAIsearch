{
  "sutta_id": "DHP308",
  "verses": [
    {
      "number": 1,
      "pali": "Vaggumudātīriyabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Seyyo ayoguḷo bhutto, ",
      "english": "It’d be better for the immoral and unrestrained "
    },
    {
      "number": 3,
      "pali": "tatto aggisikhūpamo; ",
      "english": "to eat an iron ball, "
    },
    {
      "number": 4,
      "pali": "Yañce bhuñjeyya dussīlo, ",
      "english": "scorching, like a burning flame, "
    },
    {
      "number": 5,
      "pali": "raṭṭhapiṇḍamasaññato. ",
      "english": "than to eat the nation’s alms. "
    }
  ]
}