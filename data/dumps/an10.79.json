{
  "sutta_id": "AN10.79",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.79 ",
      "english": "Numbered Discourses 10.79 "
    },
    {
      "number": 2,
      "pali": "8. Ākaṅkhavagga ",
      "english": "8. If You Want "
    },
    {
      "number": 3,
      "pali": "Āghātavatthusutta ",
      "english": "Grounds for Resentment "
    },
    {
      "number": 4,
      "pali": "“Dasayimāni, bhikkhave, āghātavatthūni. ",
      "english": "“Mendicants, there are ten grounds for resentment. "
    },
    {
      "number": 5,
      "pali": "Katamāni dasa? ",
      "english": "What ten? "
    },
    {
      "number": 6,
      "pali": "‘Anatthaṁ me acarī’ti āghātaṁ bandhati; ",
      "english": "Thinking: ‘They did wrong to me,’ you harbor resentment. "
    },
    {
      "number": 7,
      "pali": "‘anatthaṁ me caratī’ti āghātaṁ bandhati; ",
      "english": "Thinking: ‘They are doing wrong to me’ … "
    },
    {
      "number": 8,
      "pali": "‘anatthaṁ me carissatī’ti āghātaṁ bandhati; ",
      "english": "‘They will do wrong to me’ … "
    },
    {
      "number": 9,
      "pali": "‘piyassa me manāpassa anatthaṁ acarī’ti …pe… ",
      "english": "‘They did wrong by someone I love’ … "
    },
    {
      "number": 10,
      "pali": "‘anatthaṁ caratī’ti …pe… ",
      "english": "‘They are doing wrong by someone I love’ … "
    },
    {
      "number": 11,
      "pali": "‘anatthaṁ carissatī’ti āghātaṁ bandhati, ",
      "english": "‘They will do wrong by someone I love’ … "
    },
    {
      "number": 12,
      "pali": "‘appiyassa me amanāpassa atthaṁ acarī’ti …pe… ",
      "english": "‘They helped someone I dislike’ … "
    },
    {
      "number": 13,
      "pali": "‘atthaṁ caratī’ti …pe… ",
      "english": "‘They are helping someone I dislike’ … "
    },
    {
      "number": 14,
      "pali": "‘atthaṁ carissatī’ti āghātaṁ bandhati; ",
      "english": "Thinking: ‘They will help someone I dislike,’ you harbor resentment. "
    },
    {
      "number": 15,
      "pali": "aṭṭhāne ca kuppati—",
      "english": "You get angry for no reason. "
    },
    {
      "number": 16,
      "pali": "imāni kho, bhikkhave, dasa āghātavatthūnī”ti. ",
      "english": "These are the ten grounds for resentment.” "
    },
    {
      "number": 17,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
}