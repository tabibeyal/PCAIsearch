{
  "sutta_id": "AN4.143",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.143 ",
      "english": "Numbered Discourses 4.143 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Ālokasutta ",
      "english": "Light "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, ālokā. ",
      "english": "“Mendicants, there are these four lights. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Candāloko, sūriyāloko, aggāloko, paññāloko—",
      "english": "The lights of the moon, sun, fire, and wisdom. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro ālokā. ",
      "english": "These are the four lights. "
    },
    {
      "number": 8,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ catunnaṁ ālokānaṁ yadidaṁ paññāloko”ti. ",
      "english": "The best of these four lights is the light of wisdom.” "
    },
    {
      "number": 9,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}