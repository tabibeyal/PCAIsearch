{
  "sutta_id": "DHP264",
  "verses": [
    {
      "number": 1,
      "pali": "Hatthakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na muṇḍakena samaṇo, ",
      "english": "A liar and breaker of vows is no ascetic "
    },
    {
      "number": 3,
      "pali": "abbato alikaṁ bhaṇaṁ; ",
      "english": "just because they shave their head. "
    },
    {
      "number": 4,
      "pali": "Icchālobhasamāpanno, ",
      "english": "How on earth can one be an ascetic "
    },
    {
      "number": 5,
      "pali": "samaṇo kiṁ bhavissati. ",
      "english": "who’s full of desire and greed? "
    }
  ]
}