  "sutta_id": "SN23.17",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 23.17 ",
      "english": "Linked Discourses 23.17 "
    },
    {
      "number": 2,
      "pali": "2. Dutiyamāravagga ",
      "english": "2. About Māra (2nd) "
    },
    {
      "number": 3,
      "pali": "Anattasutta ",
      "english": "Not-Self "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ nisinno kho āyasmā rādho bhagavantaṁ etadavoca: ",
      "english": "Seated to one side, Venerable Rādha said to the Buddha: "
    },
    {
      "number": 6,
      "pali": "“‘anattā, anattā’ti, bhante, vuccati. ",
      "english": "“Sir, they speak of ‘not-self’. "
    },
    {
      "number": 7,
      "pali": "Katamo nu kho, bhante, anattā”ti? ",
      "english": "What is not-self?” "
    },
    {
      "number": 8,
      "pali": "“Rūpaṁ kho, rādha, anattā, vedanā anattā, saññā anattā, saṅkhārā anattā, viññāṇaṁ anattā. ",
      "english": "“Rādha, form, feeling, perception, choices, and consciousness are not-self. "
    },
    {
      "number": 9,
      "pali": "Evaṁ passaṁ …pe… ",
      "english": "Seeing this … "
    },
    {
      "number": 10,
      "pali": "nāparaṁ itthattāyāti pajānātī”ti. ",
      "english": "They understand: ‘… there is nothing further for this place.’” "
    },
    {
      "number": 11,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}