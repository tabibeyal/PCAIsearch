{
  "sutta_id": "AN4.65",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.65 ",
      "english": "Numbered Discourses 4.65 "
    },
    {
      "number": 2,
      "pali": "7. Pattakammavagga ",
      "english": "7. Fitting Deeds "
    },
    {
      "number": 3,
      "pali": "Rūpasutta ",
      "english": "Appearance "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“Mendicants, these four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Rūpappamāṇo rūpappasanno, ghosappamāṇo ghosappasanno, lūkhappamāṇo lūkhappasanno, dhammappamāṇo dhammappasanno—",
      "english": "There are those whose estimation of and confidence in others is based on their appearance, on their voice, on their mortification, and on principle. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasminti. ",
      "english": "These are the four individuals found in the world. "
    },
    {
      "number": 8,
      "pali": "Ye ca rūpe pamāṇiṁsu, ",
      "english": "Those who judge on appearance, "
    },
    {
      "number": 9,
      "pali": "ye ca ghosena anvagū; ",
      "english": "and those swayed by a voice, "
    },
    {
      "number": 10,
      "pali": "Chandarāgavasūpetā, ",
      "english": "are full of desire and greed; "
    },
    {
      "number": 11,
      "pali": "nābhijānanti te janā. ",
      "english": "those people just don’t understand. "
    },
    {
      "number": 12,
      "pali": "Ajjhattañca na jānāti, ",
      "english": "Not knowing what’s inside, "
    },
    {
      "number": 13,
      "pali": "bahiddhā ca na passati; ",
      "english": "nor seeing what’s outside, "
    },
    {
      "number": 14,
      "pali": "Samantāvaraṇo bālo, ",
      "english": "the fool shut in on every side, "
    },
    {
      "number": 15,
      "pali": "sa ve ghosena vuyhati. ",
      "english": "gets carried away by a voice. "
    },
    {
      "number": 16,
      "pali": "Ajjhattañca na jānāti, ",
      "english": "Not knowing what’s inside, "
    },
    {
      "number": 17,
      "pali": "bahiddhā ca vipassati; ",
      "english": "but discerning what’s outside, "
    },
    {
      "number": 18,
      "pali": "Bahiddhā phaladassāvī, ",
      "english": "seeing the fruit outside, "
    },
    {
      "number": 19,
      "pali": "sopi ghosena vuyhati. ",
      "english": "they’re also carried away by a voice. "
    },
    {
      "number": 20,
      "pali": "Ajjhattañca pajānāti, ",
      "english": "Understanding what’s inside, "
    },
    {
      "number": 21,
      "pali": "bahiddhā ca vipassati; ",
      "english": "and discerning what’s outside, "
    },
    {
      "number": 22,
      "pali": "Vinīvaraṇadassāvī, ",
      "english": "seeing without hindrances, "
    },
    {
      "number": 23,
      "pali": "na so ghosena vuyhatī”ti. ",
      "english": "they don’t get carried away by a voice.” "
    },
    {
      "number": 24,
      "pali": "Pañcamaṁ. ",
      "english": ""
    }
  ]
}