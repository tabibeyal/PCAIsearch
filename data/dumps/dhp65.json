{
  "sutta_id": "DHP65",
  "verses": [
    {
      "number": 1,
      "pali": "Tiṁsapāveyyakabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Muhuttamapi ce viññū, ",
      "english": "If a clever person attends to the wise "
    },
    {
      "number": 3,
      "pali": "paṇḍitaṁ payirupāsati; ",
      "english": "even just for an hour or so, "
    },
    {
      "number": 4,
      "pali": "Khippaṁ dhammaṁ vijānāti, ",
      "english": "they swiftly understand the teaching, "
    },
    {
      "number": 5,
      "pali": "jivhā sūparasaṁ yathā. ",
      "english": "like a tongue the taste of the soup. "
    }
  ]
}