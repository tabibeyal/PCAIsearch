{
  "sutta_id": "AN10.101",
  "verses": [
    {
      "number": 1,
      "pali": "Numerical Discourses 10.101",
      "english": "Numerical Discourses 10.101"
    },
    {
      "number": 2,
      "pali": "Samaṇasaññā Sutta",
      "english": "Contemplative Perceptions"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“Monks, three contemplative perceptions, when developed & pursued, bring seven things to completion. Which three?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“‘I have become casteless."
    },
    {
      "number": 5,
      "pali": "",
      "english": "“‘My life is dependent on others."
    },
    {
      "number": 6,
      "pali": "",
      "english": "“‘My behavior should be different (from that of householders).’"
    },
    {
      "number": 7,
      "pali": "",
      "english": "“These three contemplative perceptions, when developed & pursued, bring seven things to completion. Which seven?"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“One acts & behaves consistently with the virtues."
    },
    {
      "number": 9,
      "pali": "",
      "english": "“One isn’t greedy."
    },
    {
      "number": 10,
      "pali": "",
      "english": "“One is devoid of ill will."
    },
    {
      "number": 11,
      "pali": "",
      "english": "“One is devoid of arrogance."
    },
    {
      "number": 12,
      "pali": "",
      "english": "“One desires training."
    },
    {
      "number": 13,
      "pali": "",
      "english": "“One thinks, ‘They have this purpose,’ with regard to the requisites of life."
    },
    {
      "number": 14,
      "pali": "",
      "english": "“One remains with one’s persistence aroused."
    },
    {
      "number": 15,
      "pali": "",
      "english": "“Monks, these three contemplative perceptions, when developed & pursued, bring these seven things to completion.”"
    }
  ]
}