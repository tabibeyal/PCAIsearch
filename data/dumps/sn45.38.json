{
  "sutta_id": "SN45.38",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 45.38 ",
      "english": "Linked Discourses 45.38 "
    },
    {
      "number": 2,
      "pali": "4. Paṭipattivagga ",
      "english": "4. Practice "
    },
    {
      "number": 3,
      "pali": "Dutiyabrahmaññasutta ",
      "english": "The Brahmin Life (2nd) "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Brahmaññañca vo, bhikkhave, desessāmi, brahmaññatthañca. ",
      "english": "“Mendicants, I will teach you life as a brahmin and the goal of life as a brahmin. "
    },
    {
      "number": 6,
      "pali": "Taṁ suṇātha. ",
      "english": "Listen … "
    },
    {
      "number": 7,
      "pali": "Katamañca, bhikkhave, brahmaññaṁ? ",
      "english": "And what is life as a brahmin? "
    },
    {
      "number": 8,
      "pali": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṁ—",
      "english": "It is simply this noble eightfold path, that is: "
    },
    {
      "number": 9,
      "pali": "sammādiṭṭhi …pe… sammāsamādhi. ",
      "english": "right view, right purpose, right speech, right action, right livelihood, right effort, right mindfulness, and right immersion. "
    },
    {
      "number": 10,
      "pali": "Idaṁ vuccati, bhikkhave, brahmaññaṁ. ",
      "english": "This is called life as a brahmin. "
    },
    {
      "number": 11,
      "pali": "Katamo ca, bhikkhave, brahmaññattho? ",
      "english": "And what is the goal of life as a brahmin? "
    },
    {
      "number": 12,
      "pali": "Yo kho, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—",
      "english": "The ending of greed, hate, and delusion. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, brahmaññattho”ti. ",
      "english": "This is called the goal of life as a brahmin.” "
    },
    {
      "number": 14,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}