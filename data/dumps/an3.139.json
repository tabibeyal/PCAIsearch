    {
      "number": 3,
      "pali": "Vuddhisutta ",
      "english": "Growth "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, vuddhiyo. ",
      "english": "“Mendicants, there are three kinds of growth. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Saddhāvuddhi, sīlavuddhi, paññāvuddhi—",
      "english": "Growth in faith, ethics, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso vuddhiyo”ti. ",
      "english": "These are the three kinds of growth.” "
    },
    {
      "number": 8,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
