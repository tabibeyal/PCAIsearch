{
  "sutta_id": "DHP182",
  "verses": [
    {
      "number": 1,
      "pali": "Erakapattanāgarājavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kiccho manussapaṭilābho, ",
      "english": "It’s hard to gain a human birth; "
    },
    {
      "number": 3,
      "pali": "kicchaṁ maccāna jīvitaṁ; ",
      "english": "the life of mortals is hard; "
    },
    {
      "number": 4,
      "pali": "Kicchaṁ saddhammassavanaṁ, ",
      "english": "it’s hard to hear the true teaching; "
    },
    {
      "number": 5,
      "pali": "kiccho buddhānamuppādo. ",
      "english": "the arising of Buddhas is hard. "
    }
  ]
}