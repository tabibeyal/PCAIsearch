{
  "sutta_id": "DHP148",
  "verses": [
    {
      "number": 1,
      "pali": "Uttarātherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Parijiṇṇamidaṁ rūpaṁ, ",
      "english": "This body is decrepit and frail, "
    },
    {
      "number": 3,
      "pali": "roganīḷaṁ pabhaṅguraṁ; ",
      "english": "a nest of disease. "
    },
    {
      "number": 4,
      "pali": "Bhijjati pūtisandeho, ",
      "english": "This foul carcass falls apart, "
    },
    {
      "number": 5,
      "pali": "maraṇantañhi jīvitaṁ. ",
      "english": "for life ends in death. "
    }
  ]
}