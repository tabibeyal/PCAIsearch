{
  "sutta_id": "AN4.148",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.148 ",
      "english": "Numbered Discourses 4.148 "
    },
    {
      "number": 2,
      "pali": "15. Ābhāvagga ",
      "english": "15. Brightness "
    },
    {
      "number": 3,
      "pali": "Duccaritasutta ",
      "english": "Bad Conduct "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, vacīduccaritāni. ",
      "english": "“Mendicants, there are these four kinds of bad conduct by way of speech. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Musāvādo, pisuṇā vācā, pharusā vācā, samphappalāpo—",
      "english": "Speech that’s false, backbiting, harsh, or nonsensical. "
    },
    {
      "number": 7,
      "pali": "Imāni kho, bhikkhave, cattāri vacīduccaritānī”ti. ",
      "english": "These are the four kinds of bad conduct by way of speech.” "
    },
    {
      "number": 8,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}