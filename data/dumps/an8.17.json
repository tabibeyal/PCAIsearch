{
  "sutta_id": "AN8.17",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.17 ",
      "english": "Numbered Discourses 8.17 "
    },
    {
      "number": 2,
      "pali": "2. Mahāvagga ",
      "english": "2. The Great Chapter "
    },
    {
      "number": 3,
      "pali": "Paṭhamabandhanasutta ",
      "english": "Catching (1st) "
    },
    {
      "number": 4,
      "pali": "“Aṭṭhahi, bhikkhave, ākārehi itthī purisaṁ bandhati. ",
      "english": "“Mendicants, a woman catches a man using eight features. "
    },
    {
      "number": 5,
      "pali": "Katamehi aṭṭhahi? ",
      "english": "What eight? "
    },
    {
      "number": 6,
      "pali": "Ruṇṇena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "With weeping, "
    },
    {
      "number": 7,
      "pali": "hasitena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "laughing, "
    },
    {
      "number": 8,
      "pali": "bhaṇitena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "speaking, "
    },
    {
      "number": 9,
      "pali": "ākappena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "appearance, "
    },
    {
      "number": 10,
      "pali": "vanabhaṅgena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "gifts of wildflowers, "
    },
    {
      "number": 11,
      "pali": "gandhena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "scents, "
    },
    {
      "number": 12,
      "pali": "rasena, bhikkhave, itthī purisaṁ bandhati; ",
      "english": "tastes, "
    },
    {
      "number": 13,
      "pali": "phassena, bhikkhave, itthī purisaṁ bandhati. ",
      "english": "and touches. "
    },
    {
      "number": 14,
      "pali": "Imehi kho, bhikkhave, aṭṭhahākārehi itthī purisaṁ bandhati. ",
      "english": "A woman catches a man using these eight features. "
    },
    {
      "number": 15,
      "pali": "Te, bhikkhave, sattā subaddhā, ye phassena baddhā”ti. ",
      "english": "But those beings who are caught by touch are well and truly caught.” "
    },
    {
      "number": 16,
      "pali": "Sattamaṁ. ",
      "english": ""
    }
  ]
}