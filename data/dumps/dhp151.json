{
  "sutta_id": "DHP151",
  "verses": [
    {
      "number": 1,
      "pali": "Mallikādevīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Jīranti ve rājarathā sucittā, ",
      "english": "Fancy chariots of kings wear out, "
    },
    {
      "number": 3,
      "pali": "Atho sarīrampi jaraṁ upeti; ",
      "english": "and even this body gets old. "
    },
    {
      "number": 4,
      "pali": "Satañca dhammo na jaraṁ upeti, ",
      "english": "But the truth of the good never gets old—"
    },
    {
      "number": 5,
      "pali": "Santo have sabbhi pavedayanti. ",
      "english": "so the good proclaim to the good. "
    }
  ]
}