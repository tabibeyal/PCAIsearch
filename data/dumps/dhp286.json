{
  "sutta_id": "DHP286",
  "verses": [
    {
      "number": 1,
      "pali": "Mahādhanavāṇijavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Idha vassaṁ vasissāmi, ",
      "english": "“Here I will stay for the rains; "
    },
    {
      "number": 3,
      "pali": "idha hemantagimhisu; ",
      "english": "here for winter, here the summer”; "
    },
    {
      "number": 4,
      "pali": "Iti bālo vicinteti, ",
      "english": "thus the fool thinks, "
    },
    {
      "number": 5,
      "pali": "antarāyaṁ na bujjhati. ",
      "english": "not realizing the danger. "
    }
  ]
}