{
  "sutta_id": "AN1.51",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 1 ",
      "english": "Numbered Discourses 1.51–60 "
    },
    {
      "number": 2,
      "pali": "6. Accharāsaṅghātavagga ",
      "english": "The Chapter on a Finger-Snap "
    },
    {
      "number": 3,
      "pali": "51 ",
      "english": "51 "
    },
    {
      "number": 4,
      "pali": "“Pabhassaramidaṁ, bhikkhave, cittaṁ. ",
      "english": "“This mind, mendicants, is radiant. "
    },
    {
      "number": 5,
      "pali": "Tañca kho āgantukehi upakkilesehi upakkiliṭṭhaṁ. ",
      "english": "But it is corrupted by passing corruptions. "
    },
    {
      "number": 6,
      "pali": "Taṁ assutavā puthujjano yathābhūtaṁ nappajānāti. ",
      "english": "An unlearned ordinary person does not truly understand this. "
    },
    {
      "number": 7,
      "pali": "Tasmā ‘assutavato puthujjanassa cittabhāvanā natthī’ti vadāmī”ti. ",
      "english": "So I say that the unlearned ordinary person has no development of the mind.” "
    },
    {
      "number": 8,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}