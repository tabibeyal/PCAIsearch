{
  "sutta_id": "DHP387",
  "verses": [
    {
      "number": 1,
      "pali": "Ānandattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Divā tapati ādicco, ",
      "english": "The sun blazes by day, "
    },
    {
      "number": 3,
      "pali": "rattimābhāti candimā; ",
      "english": "the moon radiates at night, "
    },
    {
      "number": 4,
      "pali": "Sannaddho khattiyo tapati, ",
      "english": "the aristocrat shines in armor, "
    },
    {
      "number": 5,
      "pali": "jhāyī tapati brāhmaṇo; ",
      "english": "and the brahmin shines in absorption. "
    },
    {
      "number": 6,
      "pali": "Atha sabbamahorattiṁ, ",
      "english": "But all day and all night, "
    },
    {
      "number": 7,
      "pali": "buddho tapati tejasā. ",
      "english": "the Buddha blazes with glory. "
    }
  ]
}