  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 35",
      "english": "Itivuttaka 35"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, this holy life is lived, not for the sake of deceiving people, not for the sake of inveigling people, not for the sake of the rewards of gain, offerings, & tribute, nor with the thought, ‘Thus may people know me.’ This holy life is lived for the sake of restraint & abandoning.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "For the sake of restraint,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "for the sake of abandoning,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "he, the Blessed One, taught"
    },
    {
      "number": 7,
      "pali": "",
      "english": "a holy life not handed down,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "coming ashore"
    },
    {
      "number": 9,
      "pali": "",
      "english": "in Unbinding."
    },
    {
      "number": 10,
      "pali": "",
      "english": "This path is pursued"
    },
    {
      "number": 11,
      "pali": "",
      "english": "by those great in purpose,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "great seers."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Those who follow it,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "as taught by the One Awakened,"
    },
    {
      "number": 15,
      "pali": "",
      "english": "heeding the Teacher’s message,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "will put an end"
    },
    {
      "number": 17,
      "pali": "",
      "english": "to suffering & stress."
    }
  ]
}