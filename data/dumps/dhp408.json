{
  "sutta_id": "DHP408",
  "verses": [
    {
      "number": 1,
      "pali": "Pilindavacchattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Akakkasaṁ viññāpaniṁ, ",
      "english": "The words they utter "
    },
    {
      "number": 3,
      "pali": "giraṁ saccamudīraye; ",
      "english": "are polished, informative, and true, "
    },
    {
      "number": 4,
      "pali": "Yāya nābhisaje kañci, ",
      "english": "and don’t offend anyone: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}