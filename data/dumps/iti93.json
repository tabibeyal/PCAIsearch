{
  "sutta_id": "ITI93",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 93 ",
      "english": "So It Was Said 93 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Pañcamavagga ",
      "english": "Chapter Five "
    },
    {
      "number": 4,
      "pali": "Aggisutta ",
      "english": "Fire "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tayome, bhikkhave, aggī. ",
      "english": "“Mendicants, there are these three fires. "
    },
    {
      "number": 7,
      "pali": "Katame tayo? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Rāgaggi, dosaggi, mohaggi—",
      "english": "The fires of greed, hate, and delusion. "
    },
    {
      "number": 9,
      "pali": "ime kho, bhikkhave, tayo aggī”ti. ",
      "english": "These are the three fires.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Rāgaggi dahati macce, ",
      "english": "“The fire of greed burns a mortal, "
    },
    {
      "number": 13,
      "pali": "ratte kāmesu mucchite; ",
      "english": "lustful, infatuated by sensual pleasures; "
    },
    {
      "number": 14,
      "pali": "Dosaggi pana byāpanne, ",
      "english": "while, fallen in the fire of hate, "
    },
    {
      "number": 15,
      "pali": "nare pāṇātipātino. ",
      "english": "a person kills living creatures; "
    },
    {
      "number": 16,
      "pali": "Mohaggi pana sammūḷhe, ",
      "english": "and, bewildered by the fire of delusion, "
    },
    {
      "number": 17,
      "pali": "ariyadhamme akovide; ",
      "english": "they miss the teaching of the noble ones. "
    },
    {
      "number": 18,
      "pali": "Ete aggī ajānantā, ",
      "english": "Not recognizing these three fires, "
    },
    {
      "number": 19,
      "pali": "sakkāyābhiratā pajā. ",
      "english": "people are caught up in substantial reality. "
    },
    {
      "number": 20,
      "pali": "Te vaḍḍhayanti nirayaṁ, ",
      "english": "They fill the ranks of hell, "
    },
    {
      "number": 21,
      "pali": "tiracchānañca yoniyo; ",
      "english": "of birth as an animal, "
    },
    {
      "number": 22,
      "pali": "Asuraṁ pettivisayaṁ, ",
      "english": "or of titans and ghosts, "
    },
    {
      "number": 23,
      "pali": "amuttā mārabandhanā. ",
      "english": "not freed from Māra’s bonds. "
    },
    {
      "number": 24,
      "pali": "Ye ca rattindivā yuttā, ",
      "english": "But as to those committed day and night "
    },
    {
      "number": 25,
      "pali": "sammāsambuddhasāsane; ",
      "english": "to the teaching of the Buddha: "
    },
    {
      "number": 26,
      "pali": "Te nibbāpenti rāgaggiṁ, ",
      "english": "they extinguish the fire of greed, "
    },
    {
      "number": 27,
      "pali": "niccaṁ asubhasaññino. ",
      "english": "always perceiving ugliness; "
    },
    {
      "number": 28,
      "pali": "Dosaggiṁ pana mettāya, ",
      "english": "while those supreme men "
    },
    {
      "number": 29,
      "pali": "nibbāpenti naruttamā; ",
      "english": "extinguish the fire of hate with love; "
    },
    {
      "number": 30,
      "pali": "Mohaggiṁ pana paññāya, ",
      "english": "and the fire of delusion with the wisdom "
    },
    {
      "number": 31,
      "pali": "yāyaṁ nibbedhagāminī. ",
      "english": "that leads to penetration. "
    },
    {
      "number": 32,
      "pali": "Te nibbāpetvā nipakā, ",
      "english": "Having extinguished these fires, alert, "
    },
    {
      "number": 33,
      "pali": "rattindivamatanditā; ",
      "english": "tireless all day and night, "
    },
    {
      "number": 34,
      "pali": "Asesaṁ parinibbanti, ",
      "english": "they become fully extinguished, "
    },
    {
      "number": 35,
      "pali": "asesaṁ dukkhamaccaguṁ. ",
      "english": "completely transcending suffering. "
    },
    {
      "number": 36,
      "pali": "Ariyaddasā vedaguno, ",
      "english": "Seers of the noble truths, knowledge masters, "
    },
    {
      "number": 37,
      "pali": "sammadaññāya paṇḍitā; ",
      "english": "the astute, understanding rightly, "
    },
    {
      "number": 38,
      "pali": "Jātikkhayamabhiññāya, ",
      "english": "directly know the ending of rebirth, "
    },
    {
      "number": 39,
      "pali": "nāgacchanti punabbhavan”ti. ",
      "english": "they come not back to future lives.” "
    },
    {
      "number": 40,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 41,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}