{
  "sutta_id": "ITI93",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 93",
      "english": "Itivuttaka 93"
    },
    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Monks, there are these three fires. Which three? The fire of passion, the fire of aversion, the fire of delusion. These are the three fires.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "The fire of passion burns in a mortal"
    },
    {
      "number": 5,
      "pali": "",
      "english": "delighting in,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "smitten with"
    },
    {
      "number": 7,
      "pali": "",
      "english": "sensual desires;"
    },
    {
      "number": 8,
      "pali": "",
      "english": "the fire of aversion, in a malevolent person"
    },
    {
      "number": 9,
      "pali": "",
      "english": "taking life;"
    },
    {
      "number": 10,
      "pali": "",
      "english": "the fire of delusion, in a bewildered person"
    },
    {
      "number": 11,
      "pali": "",
      "english": "ignorant"
    },
    {
      "number": 12,
      "pali": "",
      "english": "of the noble teaching."
    },
    {
      "number": 13,
      "pali": "",
      "english": "Not understanding these fires, people"
    },
    {
      "number": 14,
      "pali": "",
      "english": "–fond of self-identity–"
    },
    {
      "number": 15,
      "pali": "",
      "english": "unreleased from Māra’s shackles,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "swell the ranks of hell,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "the wombs of common animals, demons,"
    },
    {
      "number": 18,
      "pali": "",
      "english": "the realm of the hungry ghosts."
    },
    {
      "number": 19,
      "pali": "",
      "english": "While those who, day & night,"
    },
    {
      "number": 20,
      "pali": "",
      "english": "are devoted"
    },
    {
      "number": 21,
      "pali": "",
      "english": "to the message"
    },
    {
      "number": 22,
      "pali": "",
      "english": "of the rightly self-awakened,"
    },
    {
      "number": 23,
      "pali": "",
      "english": "put out the fire of passion,"
    },
    {
      "number": 24,
      "pali": "",
      "english": "constantly perceiving the foul."
    },
    {
      "number": 25,
      "pali": "",
      "english": "They, superlative people,"
    },
    {
      "number": 26,
      "pali": "",
      "english": "put out the fire of aversion"
    },
    {
      "number": 27,
      "pali": "",
      "english": "with good will,"
    },
    {
      "number": 28,
      "pali": "",
      "english": "and the fire of delusion"
    },
    {
      "number": 29,
      "pali": "",
      "english": "with the discernment leading"
    },
    {
      "number": 30,
      "pali": "",
      "english": "to penetration."
    },
    {
      "number": 31,
      "pali": "",
      "english": "They, the masterful, untiring by night & day,"
    },
    {
      "number": 32,
      "pali": "",
      "english": "having put out [the fires],"
    },
    {
      "number": 33,
      "pali": "",
      "english": "having, without remainder,"
    },
    {
      "number": 34,
      "pali": "",
      "english": "comprehended stress,"
    },
    {
      "number": 35,
      "pali": "",
      "english": "are, without remainder,"
    },
    {
      "number": 36,
      "pali": "",
      "english": "totally unbound."
    },
    {
      "number": 37,
      "pali": "",
      "english": "They, the wise, with an attainer-of-wisdom’s"
    },
    {
      "number": 38,
      "pali": "",
      "english": "noble vision,"
    },
    {
      "number": 39,
      "pali": "",
      "english": "right gnosis,"
    },
    {
      "number": 40,
      "pali": "",
      "english": "directly knowing"
    },
    {
      "number": 41,
      "pali": "",
      "english": "the ending of birth,"
    },
    {
      "number": 42,
      "pali": "",
      "english": "come to no further becoming."
    }
  ]
}