{
  "sutta_id": "DHP4",
  "verses": [
    {
      "number": 1,
      "pali": "Akkocchi maṁ avadhi maṁ, ",
      "english": "“They abused me, they hit me! "
    },
    {
      "number": 2,
      "pali": "ajini maṁ ahāsi me; ",
      "english": "They beat me, they robbed me!” "
    },
    {
      "number": 3,
      "pali": "Ye ca taṁ nupanayhanti, ",
      "english": "For those who bear no such grudge, "
    },
    {
      "number": 4,
      "pali": "veraṁ tesūpasammati. ",
      "english": "hatred is laid to rest. "
    }
  ]
}