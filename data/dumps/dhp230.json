{
  "sutta_id": "DHP230",
  "verses": [
    {
      "number": 1,
      "pali": "Nikkhaṁ jambonadasseva, ",
      "english": "like a pendant of Black Plum River gold, "
    },
    {
      "number": 2,
      "pali": "ko taṁ ninditumarahati; ",
      "english": "who is worthy to criticize them? "
    },
    {
      "number": 3,
      "pali": "Devāpi naṁ pasaṁsanti, ",
      "english": "Even the gods praise them, "
    },
    {
      "number": 4,
      "pali": "brahmunāpi pasaṁsito. ",
      "english": "and by the Divinity, too, they’re praised. "
    }
  ]
}