{
  "sutta_id": "DHP224",
  "verses": [
    {
      "number": 1,
      "pali": "Mahāmoggallānapañhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Saccaṁ bhaṇe na kujjheyya, ",
      "english": "Speak the truth, do not be angry, "
    },
    {
      "number": 3,
      "pali": "dajjā appampi yācito; ",
      "english": "and give when asked, if only a little. "
    },
    {
      "number": 4,
      "pali": "Etehi tīhi ṭhānehi, ",
      "english": "By these three means, "
    },
    {
      "number": 5,
      "pali": "gacche devāna santike. ",
      "english": "you may enter the presence of the gods. "
    }
  ]
}