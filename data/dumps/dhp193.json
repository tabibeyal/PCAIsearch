{
  "sutta_id": "DHP193",
  "verses": [
    {
      "number": 1,
      "pali": "Ānandattherapañhavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dullabho purisājañño, ",
      "english": "It’s hard to find a thoroughbred man: "
    },
    {
      "number": 3,
      "pali": "na so sabbattha jāyati; ",
      "english": "they’re not born just anywhere. "
    },
    {
      "number": 4,
      "pali": "Yattha so jāyati dhīro, ",
      "english": "A family where that attentive one is born "
    },
    {
      "number": 5,
      "pali": "taṁ kulaṁ sukhamedhati. ",
      "english": "prospers in happiness. "
    }
  ]
}