      "pali": "Khuddakanikāya ",
      "english": "Minor Collection "
    },
    {
      "number": 2,
      "pali": "Dhammapada ",
      "english": "Sayings of the Dhamma 306–319 "
    },
    {
      "number": 3,
      "pali": "Nirayavagga ",
      "english": "22. Hell "
    },
    {
      "number": 4,
      "pali": "Sundarīparibbājikāvatthu ",
      "english": ""
    },
    {
      "number": 5,
      "pali": "Abhūtavādī nirayaṁ upeti, ",
      "english": "A liar goes to hell, "
    },
    {
      "number": 6,
      "pali": "Yo vāpi katvā na karomi cāha; ",
      "english": "as does one who denies what they did. "
    },
    {
      "number": 7,
      "pali": "Ubhopi te pecca samā bhavanti, ",
      "english": "Both are equal in the hereafter, "
    },
    {
      "number": 8,
      "pali": "Nihīnakammā manujā parattha. ",
      "english": "those men of base deeds. "
    }
  ]
}