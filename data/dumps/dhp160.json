{
  "sutta_id": "DHP160",
  "verses": [
    {
      "number": 1,
      "pali": "Kumārakassapamātuttherivatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attā hi attano nātho, ",
      "english": "One is indeed the lord of oneself, "
    },
    {
      "number": 3,
      "pali": "ko hi nātho paro siyā; ",
      "english": "for who else would be one’s lord? "
    },
    {
      "number": 4,
      "pali": "Attanā hi sudantena, ",
      "english": "By means of a well-tamed self, "
    },
    {
      "number": 5,
      "pali": "nāthaṁ labhati dullabhaṁ. ",
      "english": "one gains a lord that’s rare indeed. "
    }
  ]
}