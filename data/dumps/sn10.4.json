{
  "sutta_id": "SN10.4",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 10.4",
      "english": "Linked Discourses 10.4"
    },
    {
      "number": 2,
      "pali": "Maṇibhadda Sutta",
      "english": "With Maṇibhadda"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Mindfulness is not a cure-all."
    },
    {
      "number": 4,
      "pali": "",
      "english": "On one occasion the Blessed One was staying among the Magadhans at the Jewel-stand Shrine, the haunt of the yakkha-spirit, Maṇibhadda [Auspicious Jewel]."
    },
    {
      "number": 5,
      "pali": "",
      "english": "Then Maṇibhadda the yakkha-spirit went to the Blessed One and, on arrival, recited this verse:"
    },
    {
      "number": 6,
      "pali": "",
      "english": "“It’s always auspicious for one who is mindful."
    },
    {
      "number": 7,
      "pali": "",
      "english": "The mindful one prospers happily—always."
    },
    {
      "number": 8,
      "pali": "",
      "english": "The mindful one grows better each day"
    },
    {
      "number": 9,
      "pali": "",
      "english": "and is totally freed from animosity.”"
    },
    {
      "number": 10,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 11,
      "pali": "",
      "english": "“It’s always auspicious for one who is mindful."
    },
    {
      "number": 12,
      "pali": "",
      "english": "The mindful one prospers happily always."
    },
    {
      "number": 13,
      "pali": "",
      "english": "The mindful one grows better each day"
    },
    {
      "number": 14,
      "pali": "",
      "english": "but isn’t totally freed from animosity."
    },
    {
      "number": 15,
      "pali": "",
      "english": "Whoever’s heart, all day, all night,"
    },
    {
      "number": 16,
      "pali": "",
      "english": "delights in harmlessness"
    },
    {
      "number": 17,
      "pali": "",
      "english": "with goodwill for all beings"
    },
    {
      "number": 18,
      "pali": "",
      "english": "has no animosity with anyone at all."
    }
  ]
}