{
  "sutta_id": "DHP245",
  "verses": [
    {
      "number": 1,
      "pali": "Hirīmatā ca dujjīvaṁ, ",
      "english": "Life is hard for the conscientious, "
    },
    {
      "number": 2,
      "pali": "niccaṁ sucigavesinā; ",
      "english": "always seeking purity, "
    },
    {
      "number": 3,
      "pali": "Alīnenāppagabbhena, ",
      "english": "neither clinging nor rude, "
    },
    {
      "number": 4,
      "pali": "suddhājīvena passatā. ",
      "english": "pure of livelihood and discerning. "
    }
  ]
}