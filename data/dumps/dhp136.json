{
  "sutta_id": "DHP136",
  "verses": [
    {
      "number": 1,
      "pali": "Ajagarapetavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Atha pāpāni kammāni, ",
      "english": "The fool does not understand "
    },
    {
      "number": 3,
      "pali": "karaṁ bālo na bujjhati; ",
      "english": "the evil that they do. "
    },
    {
      "number": 4,
      "pali": "Sehi kammehi dummedho, ",
      "english": "But because of those deeds, that simpleton "
    },
    {
      "number": 5,
      "pali": "aggidaḍḍhova tappati. ",
      "english": "is tormented as if burnt by fire. "
    }
  ]
}