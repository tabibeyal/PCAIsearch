{
  "sutta_id": "DHP336",
  "verses": [
    {
      "number": 1,
      "pali": "Yo cetaṁ sahate jammiṁ, ",
      "english": "But whoever prevails over this wretched craving, "
    },
    {
      "number": 2,
      "pali": "taṇhaṁ loke duraccayaṁ; ",
      "english": "so hard to get over in the world, "
    },
    {
      "number": 3,
      "pali": "Sokā tamhā papatanti, ",
      "english": "their sorrows fall from them, "
    },
    {
      "number": 4,
      "pali": "udabinduva pokkharā. ",
      "english": "like a drop from a lotus-leaf. "
    }
  ]
}