{
  "sutta_id": "DHP172",
  "verses": [
    {
      "number": 1,
      "pali": "Sammajjanattheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo ca pubbe pamajjitvā, ",
      "english": "He who once was heedless, "
    },
    {
      "number": 3,
      "pali": "pacchā so nappamajjati; ",
      "english": "but turned to heedfulness, "
    },
    {
      "number": 4,
      "pali": "Somaṁ lokaṁ pabhāseti, ",
      "english": "lights up the world "
    },
    {
      "number": 5,
      "pali": "abbhā muttova candimā. ",
      "english": "like the moon freed from clouds. "
    }
  ]
}