{
  "sutta_id": "AN4.98",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.98 ",
      "english": "Numbered Discourses 4.98 "
    },
    {
      "number": 2,
      "pali": "10. Asuravagga ",
      "english": "10. Titans "
    },
    {
      "number": 3,
      "pali": "Attahitasutta ",
      "english": "To Benefit Oneself "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“Mendicants, these four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Attahitāya paṭipanno no parahitāya, ",
      "english": "One who practices to benefit themselves, but not others; "
    },
    {
      "number": 7,
      "pali": "parahitāya paṭipanno no attahitāya, ",
      "english": "one who practices to benefit others, but not themselves; "
    },
    {
      "number": 8,
      "pali": "nevattahitāya paṭipanno no parahitāya, ",
      "english": "one who practices to benefit neither themselves nor others; and "
    },
    {
      "number": 9,
      "pali": "attahitāya ceva paṭipanno parahitāya ca. ",
      "english": "one who practices to benefit both themselves and others. "
    },
    {
      "number": 10,
      "pali": "Ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasmin”ti. ",
      "english": "These are the four individuals found in the world.” "
    },
    {
      "number": 11,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}