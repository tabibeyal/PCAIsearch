{
  "sutta_id": "DHP251",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Natthi rāgasamo aggi, ",
      "english": "There is no fire like greed, "
    },
    {
      "number": 3,
      "pali": "natthi dosasamo gaho; ",
      "english": "no crime like hate, "
    },
    {
      "number": 4,
      "pali": "Natthi mohasamaṁ jālaṁ, ",
      "english": "no net like delusion, "
    },
    {
      "number": 5,
      "pali": "natthi taṇhāsamā nadī. ",
      "english": "no river like craving. "
    }
  ]
}