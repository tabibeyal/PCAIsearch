{
  "sutta_id": "SN11.21",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 11.21 ",
      "english": "Linked Discourses 11.21 "
    },
    {
      "number": 2,
      "pali": "3. Tatiyavagga ",
      "english": "Chapter Three "
    },
    {
      "number": 3,
      "pali": "Chetvāsutta ",
      "english": "Slain "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ jetavane. ",
      "english": "Near Sāvatthī in Jeta’s Grove. "
    },
    {
      "number": 5,
      "pali": "Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi. ",
      "english": "And then Sakka, lord of gods, went up to the Buddha, bowed, stood to one side, "
    },
    {
      "number": 6,
      "pali": "Ekamantaṁ ṭhito kho sakko devānamindo bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "and addressed him in verse: "
    },
    {
      "number": 7,
      "pali": "“Kiṁsu chetvā sukhaṁ seti, ",
      "english": "“When what is slain do you sleep at ease? "
    },
    {
      "number": 8,
      "pali": "kiṁsu chetvā na socati; ",
      "english": "When what is slain is there no sorrow? "
    },
    {
      "number": 9,
      "pali": "Kissassu ekadhammassa, ",
      "english": "What is the one thing "
    },
    {
      "number": 10,
      "pali": "vadhaṁ rocesi gotamā”ti. ",
      "english": "whose killing you approve?” "
    },
    {
      "number": 11,
      "pali": "“Kodhaṁ chetvā sukhaṁ seti, ",
      "english": "“When anger’s slain you sleep at ease. "
    },
    {
      "number": 12,
      "pali": "kodhaṁ chetvā na socati; ",
      "english": "When anger’s slain there is no sorrow. "
    },
    {
      "number": 13,
      "pali": "Kodhassa visamūlassa, ",
      "english": "Anger has a poisonous root, "
    },
    {
      "number": 14,
      "pali": "madhuraggassa vāsava; ",
      "english": "and a sweet tip, O Vāsava. "
    },
    {
      "number": 15,
      "pali": "Vadhaṁ ariyā pasaṁsanti, ",
      "english": "The noble ones praise its killing, "
    },
    {
      "number": 16,
      "pali": "tañhi chetvā na socatī”ti. ",
      "english": "for when it’s slain there is no sorrow.” "
    }
  ]
}