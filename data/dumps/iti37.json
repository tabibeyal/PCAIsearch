    {
      "number": 2,
      "pali": "",
      "english": "Itivuttaka"
    },
    {
      "number": 3,
      "pali": "",
      "english": "This was said by the Blessed One, said by the Arahant, so I have heard: “Endowed with two things, monks, a monk lives full of ease in the here-&-now and is appropriately aroused for the ending of the effluents. Which two? A sense of urgency toward things that should inspire urgency and, feeling urgency, appropriate exertion. Endowed with these two things, a monk lives full of ease in the here-&-now and is appropriately aroused for the ending of the effluents.”"
    },
    {
      "number": 4,
      "pali": "",
      "english": "Feeling urgency right here"
    },
    {
      "number": 5,
      "pali": "",
      "english": "toward what should inspire urgency,"
    },
    {
      "number": 6,
      "pali": "",
      "english": "the wise,"
    },
    {
      "number": 7,
      "pali": "",
      "english": "masterful,"
    },
    {
      "number": 8,
      "pali": "",
      "english": "ardent monk"
    },
    {
      "number": 9,
      "pali": "",
      "english": "should investigate"
    },
    {
      "number": 10,
      "pali": "",
      "english": "with discernment."
    },
    {
      "number": 11,
      "pali": "",
      "english": "One who lives thus ardently,"
    },
    {
      "number": 12,
      "pali": "",
      "english": "not restlessly, at peace,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "committed to awareness-tranquility,"
    },
    {
      "number": 14,
      "pali": "",
      "english": "would attain the ending"
    },
    {
      "number": 15,
      "pali": "",
      "english": "of suffering & stress."
    }
  ]
}