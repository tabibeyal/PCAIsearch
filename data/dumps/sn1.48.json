{
  "sutta_id": "SN1.48",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.48 ",
      "english": "Linked Discourses 1.48 "
    },
    {
      "number": 2,
      "pali": "5. Ādittavagga ",
      "english": "5. On Fire "
    },
    {
      "number": 3,
      "pali": "Jetavanasutta ",
      "english": "Jeta’s Grove "
    },
    {
      "number": 4,
      "pali": "“Idañhi taṁ jetavanaṁ, ",
      "english": "“This is indeed that Jeta’s Grove, "
    },
    {
      "number": 5,
      "pali": "isisaṅghanisevitaṁ; ",
      "english": "frequented by the Saṅgha of seers, "
    },
    {
      "number": 6,
      "pali": "Āvutthaṁ dhammarājena, ",
      "english": "where the King of Dhamma stayed: "
    },
    {
      "number": 7,
      "pali": "pītisañjananaṁ mama. ",
      "english": "it brings me joy! "
    },
    {
      "number": 8,
      "pali": "Kammaṁ vijjā ca dhammo ca, ",
      "english": "Deeds, knowledge, and principle; "
    },
    {
      "number": 9,
      "pali": "sīlaṁ jīvitamuttamaṁ; ",
      "english": "ethical conduct, an excellent livelihood; "
    },
    {
      "number": 10,
      "pali": "Etena maccā sujjhanti, ",
      "english": "by these are mortals purified, "
    },
    {
      "number": 11,
      "pali": "na gottena dhanena vā. ",
      "english": "not by clan or wealth. "
    },
    {
      "number": 12,
      "pali": "Tasmā hi paṇḍito poso, ",
      "english": "That’s why an astute person, "
    },
    {
      "number": 13,
      "pali": "sampassaṁ atthamattano; ",
      "english": "seeing what’s good for themselves, "
    },
    {
      "number": 14,
      "pali": "Yoniso vicine dhammaṁ, ",
      "english": "would examine the teaching rationally, "
    },
    {
      "number": 15,
      "pali": "evaṁ tattha visujjhati. ",
      "english": "and thus be purified in it. "
    },
    {
      "number": 16,
      "pali": "Sāriputtova paññāya, ",
      "english": "Sāriputta is full of wisdom, "
    },
    {
      "number": 17,
      "pali": "sīlena upasamena ca; ",
      "english": "ethics, and peace. "
    },
    {
      "number": 18,
      "pali": "Yopi pāraṅgato bhikkhu, ",
      "english": "Even a mendicant who has crossed over "
    },
    {
      "number": 19,
      "pali": "etāvaparamo siyā”ti. ",
      "english": "might at best equal him.” "
    }
  ]
}