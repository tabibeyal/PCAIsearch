{
  "sutta_id": "AN10.13",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.13 ",
      "english": "Numbered Discourses 10.13 "
    },
    {
      "number": 2,
      "pali": "2. Nāthavagga ",
      "english": "2. A Protector "
    },
    {
      "number": 3,
      "pali": "Saṁyojanasutta ",
      "english": "Fetters "
    },
    {
      "number": 4,
      "pali": "“Dasayimāni, bhikkhave, saṁyojanāni. ",
      "english": "“Mendicants, there are ten fetters. "
    },
    {
      "number": 5,
      "pali": "Katamāni dasa? ",
      "english": "What ten? "
    },
    {
      "number": 6,
      "pali": "Pañcorambhāgiyāni saṁyojanāni, pañcuddhambhāgiyāni saṁyojanāni. ",
      "english": "The five lower fetters and the five higher fetters. "
    },
    {
      "number": 7,
      "pali": "Katamāni pañcorambhāgiyāni saṁyojanāni? ",
      "english": "What are the five lower fetters? "
    },
    {
      "number": 8,
      "pali": "Sakkāyadiṭṭhi, vicikicchā, sīlabbataparāmāso, kāmacchando, byāpādo—",
      "english": "Substantialist view, doubt, misapprehension of precepts and observances, sensual desire, and ill will. "
    },
    {
      "number": 9,
      "pali": "imāni pañcorambhāgiyāni saṁyojanāni. ",
      "english": "These are the five lower fetters. "
    },
    {
      "number": 10,
      "pali": "Katamāni pañcuddhambhāgiyāni saṁyojanāni? ",
      "english": "What are the five higher fetters? "
    },
    {
      "number": 11,
      "pali": "Rūparāgo, arūparāgo, māno, uddhaccaṁ, avijjā—",
      "english": "Desire for rebirth in the realm of luminous form, desire for rebirth in the formless realm, conceit, restlessness, and ignorance. "
    },
    {
      "number": 12,
      "pali": "imāni pañcuddhambhāgiyāni saṁyojanāni. ",
      "english": "These are the five higher fetters. "
    },
    {
      "number": 13,
      "pali": "Imāni kho, bhikkhave, dasa saṁyojanānī”ti. ",
      "english": "These are the ten fetters.” "
    },
    {
      "number": 14,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}