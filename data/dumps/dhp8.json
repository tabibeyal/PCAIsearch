{
  "sutta_id": "DHP8",
  "verses": [
    {
      "number": 1,
      "pali": "Asubhānupassiṁ viharantaṁ, ",
      "english": "Those who contemplate the ugly, "
    },
    {
      "number": 2,
      "pali": "Indriyesu susaṁvutaṁ; ",
      "english": "their faculties well-restrained, "
    },
    {
      "number": 3,
      "pali": "Bhojanamhi ca mattaññuṁ, ",
      "english": "eating in moderation, "
    },
    {
      "number": 4,
      "pali": "Saddhaṁ āraddhavīriyaṁ; ",
      "english": "faithful and energetic: "
    },
    {
      "number": 5,
      "pali": "Taṁ ve nappasahati māro, ",
      "english": "Māra cannot strike them down, "
    },
    {
      "number": 6,
      "pali": "Vāto selaṁva pabbataṁ. ",
      "english": "like the wind, a rocky mountain. "
    }
  ]
}