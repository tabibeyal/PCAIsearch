{
  "sutta_id": "SN2.19",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.19 ",
      "english": "Linked Discourses 2.19 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Uttarasutta ",
      "english": "With Uttara "
    },
    {
      "number": 4,
      "pali": "Rājagahanidānaṁ. ",
      "english": "At Rājagaha. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhito kho uttaro devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Uttara spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Upanīyati jīvitamappamāyu, ",
      "english": "“This life, so very short, is led onward. "
    },
    {
      "number": 7,
      "pali": "Jarūpanītassa na santi tāṇā; ",
      "english": "One led on to old age has no shelter. "
    },
    {
      "number": 8,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 9,
      "pali": "Puññāni kayirātha sukhāvahānī”ti. ",
      "english": "do good deeds that bring you joy.” "
    },
    {
      "number": 10,
      "pali": "“Upanīyati jīvitamappamāyu, ",
      "english": "“This life, so very short, is led onward. "
    },
    {
      "number": 11,
      "pali": "Jarūpanītassa na santi tāṇā; ",
      "english": "One led on to old age has no shelter. "
    },
    {
      "number": 12,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 13,
      "pali": "Lokāmisaṁ pajahe santipekkho”ti. ",
      "english": "a seeker of peace would drop the world’s bait.” "
    }
  ]
}