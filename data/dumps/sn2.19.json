{
  "sutta_id": "SN2.19",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 2.19",
      "english": "Linked Discourses 2.19"
    },
    {
      "number": 2,
      "pali": "Uttara Sutta",
      "english": "Uttara the Deva’s Son"
    },
    {
      "number": 3,
      "pali": "",
      "english": "Near Rājagaha. As he was standing to one side, Uttara the deva’s son recited this verse in the Blessed One’s presence:"
    },
    {
      "number": 4,
      "pali": "",
      "english": "“Life is swept along,"
    },
    {
      "number": 5,
      "pali": "",
      "english": "next-to-nothing its span."
    },
    {
      "number": 6,
      "pali": "",
      "english": "For one swept on by aging"
    },
    {
      "number": 7,
      "pali": "",
      "english": "no shelters exist."
    },
    {
      "number": 8,
      "pali": "",
      "english": "Perceiving this danger in death,"
    },
    {
      "number": 9,
      "pali": "",
      "english": "one should do deeds of merit"
    },
    {
      "number": 10,
      "pali": "",
      "english": "that bring about bliss.”"
    },
    {
      "number": 11,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 12,
      "pali": "",
      "english": "“Life is swept along,"
    },
    {
      "number": 13,
      "pali": "",
      "english": "next-to-nothing its span."
    },
    {
      "number": 14,
      "pali": "",
      "english": "For one swept to old age"
    },
    {
      "number": 15,
      "pali": "",
      "english": "no shelters exist."
    },
    {
      "number": 16,
      "pali": "",
      "english": "Perceiving this danger in death,"
    },
    {
      "number": 17,
      "pali": "",
      "english": "one should drop the world’s bait"
    },
    {
      "number": 18,
      "pali": "",
      "english": "and look for peace.”"
    }
  ]
}