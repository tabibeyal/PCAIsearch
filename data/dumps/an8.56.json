{
  "sutta_id": "AN8.56",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 8.56 ",
      "english": "Numbered Discourses 8.56 "
    },
    {
      "number": 2,
      "pali": "6. Gotamīvagga ",
      "english": "6. Gotamī "
    },
    {
      "number": 3,
      "pali": "Bhayasutta ",
      "english": "Danger "
    },
    {
      "number": 4,
      "pali": "“‘Bhayan’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "“Mendicants, ‘danger’ is a term for sensual pleasures. "
    },
    {
      "number": 5,
      "pali": "‘Dukkhan’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘Suffering’, "
    },
    {
      "number": 6,
      "pali": "‘Rogo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘disease’, "
    },
    {
      "number": 7,
      "pali": "‘Gaṇḍo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘boil’, "
    },
    {
      "number": 8,
      "pali": "‘Sallan’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘dart’, "
    },
    {
      "number": 9,
      "pali": "‘Saṅgo’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘chain’, "
    },
    {
      "number": 10,
      "pali": "‘Paṅko’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "‘bog’, "
    },
    {
      "number": 11,
      "pali": "‘Gabbho’ti, bhikkhave, kāmānametaṁ adhivacanaṁ. ",
      "english": "and ‘womb’ are terms for sensual pleasures. "
    },
    {
      "number": 12,
      "pali": "Kasmā ca, bhikkhave, ‘bhayan’ti kāmānametaṁ adhivacanaṁ? ",
      "english": "And why is ‘danger’ a term for sensual pleasures? "
    },
    {
      "number": 13,
      "pali": "Yasmā ca kāmarāgarattāyaṁ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati, samparāyikāpi bhayā na parimuccati, tasmā ‘bhayan’ti kāmānametaṁ adhivacanaṁ. ",
      "english": "Someone who is besotted by sensual greed and shackled by lustful desire is not freed from dangers in this life or in lives to come. That is why ‘danger’ is a term for sensual pleasures. "
    },
    {
      "number": 14,
      "pali": "Kasmā ca, bhikkhave, ‘dukkhan’ti …pe… ",
      "english": "And why are ‘suffering’, "
    },
    {
      "number": 15,
      "pali": "‘rogo’ti … ",
      "english": "‘disease’, "
    },
    {
      "number": 16,
      "pali": "‘gaṇḍo’ti … ",
      "english": "‘boil’, "
    },
    {
      "number": 17,
      "pali": "‘sallan’ti … ",
      "english": "‘dart’, "
    },
    {
      "number": 18,
      "pali": "‘saṅgo’ti … ",
      "english": "‘chain’, "
    },
    {
      "number": 19,
      "pali": "‘paṅko’ti … ",
      "english": "‘bog’, "
    },
    {
      "number": 20,
      "pali": "‘gabbho’ti kāmānametaṁ adhivacanaṁ? ",
      "english": "and ‘womb’ terms for sensual pleasures? "
    },
    {
      "number": 21,
      "pali": "Yasmā ca kāmarāgarattāyaṁ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi gabbhā na parimuccati, samparāyikāpi gabbhā na parimuccati, tasmā ‘gabbho’ti kāmānametaṁ adhivacanaṁ. ",
      "english": "Someone who is besotted by sensual greed and shackled by lustful desire is not freed from wombs in this life or in lives to come. That is why ‘womb’ is a term for sensual pleasures. "
    },
    {
      "number": 22,
      "pali": "Bhayaṁ dukkhañca rogo ca, ",
      "english": "Danger, suffering, and disease, "
    },
    {
      "number": 23,
      "pali": "gaṇḍo sallañca saṅgo ca; ",
      "english": "boil, dart, and chain, "
    },
    {
      "number": 24,
      "pali": "Paṅko gabbho ca ubhayaṁ, ",
      "english": "and bogs and wombs both. "
    },
    {
      "number": 25,
      "pali": "ete kāmā pavuccanti; ",
      "english": "These describe the sensual pleasures "
    },
    {
      "number": 26,
      "pali": "Yattha satto puthujjano. ",
      "english": "to which ordinary people are attached. "
    },
    {
      "number": 27,
      "pali": "Otiṇṇo sātarūpena, ",
      "english": "Swamped by things that seem pleasant, "
    },
    {
      "number": 28,
      "pali": "puna gabbhāya gacchati; ",
      "english": "you go to another womb. "
    },
    {
      "number": 29,
      "pali": "Yato ca bhikkhu ātāpī, ",
      "english": "But when a mendicant is keen, "
    },
    {
      "number": 30,
      "pali": "sampajaññaṁ na riccati. ",
      "english": "and doesn’t forget awareness, "
    },
    {
      "number": 31,
      "pali": "So imaṁ palipathaṁ duggaṁ, ",
      "english": "in this way that sort transcend "
    },
    {
      "number": 32,
      "pali": "atikkamma tathāvidho; ",
      "english": "this grueling swamp. "
    },
    {
      "number": 33,
      "pali": "Pajaṁ jātijarūpetaṁ, ",
      "english": "They watch this population flounder, "
    },
    {
      "number": 34,
      "pali": "phandamānaṁ avekkhatī”ti. ",
      "english": "fallen into rebirth and old age.” "
    },
    {
      "number": 35,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}