  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 46.111–120 ",
      "english": "Linked Discourses 46.111–120 "
    },
    {
      "number": 2,
      "pali": "12. Esanāvagga ",
      "english": "12. Searches "
    },
    {
      "number": 3,
      "pali": "Esanādisutta ",
      "english": "Searches, Etc. "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, esanā. ",
      "english": "“Mendicants, there are these three searches. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Kāmesanā, bhavesanā, brahmacariyesanā”ti vitthāretabbaṁ. ",
      "english": "The search for sensual pleasures, the search for continued existence, and the search for a spiritual path. …” "
    },
    {
      "number": 7,
      "pali": "Esanāvaggo dvādasamo. ",
      "english": ""
    },
    {
      "number": 8,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Esanā vidhā āsavo, ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Bhavo ca dukkhatā tisso; ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Khilaṁ malañca nīgho ca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Vedanā taṇhā tasināya cāti. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "(Bojjhaṅgasaṁyuttassa esanāpeyyālaṁ vivekanissitato vitthāretabbaṁ.) ",
      "english": "(Tell in full as in SN 45.161–170.) "
    }
  ]
}