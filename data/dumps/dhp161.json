{
  "sutta_id": "DHP161",
  "verses": [
    {
      "number": 1,
      "pali": "Mahākālaupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Attanā hi kataṁ pāpaṁ, ",
      "english": "For the evil that is done by oneself, "
    },
    {
      "number": 3,
      "pali": "Attajaṁ attasambhavaṁ; ",
      "english": "born and produced in oneself, "
    },
    {
      "number": 4,
      "pali": "Abhimatthati dummedhaṁ, ",
      "english": "grinds down a simpleton, "
    },
    {
      "number": 5,
      "pali": "Vajiraṁvasmamayaṁ maṇiṁ. ",
      "english": "as diamond grinds a lesser gem. "
    }
  ]
}