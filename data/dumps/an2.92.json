{
  "sutta_id": "AN2.92",
  "verses": [
    {
      "number": 1,
      "pali": "92 ",
      "english": "92 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Ahirikañca anottappañca. ",
      "english": "Lack of conscience and prudence. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}