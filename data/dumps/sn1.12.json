{
  "sutta_id": "SN1.12",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.12 ",
      "english": "Linked Discourses 1.12 "
    },
    {
      "number": 2,
      "pali": "2. Nandanavagga ",
      "english": "2. The Garden of Delight "
    },
    {
      "number": 3,
      "pali": "Nandatisutta ",
      "english": "Delight "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Nandati puttehi puttimā, ",
      "english": "“Children bring you delight! "
    },
    {
      "number": 7,
      "pali": "Gomā gohi tatheva nandati; ",
      "english": "Cattle also bring you delight! "
    },
    {
      "number": 8,
      "pali": "Upadhīhi narassa nandanā, ",
      "english": "For attachments are a man’s delight; "
    },
    {
      "number": 9,
      "pali": "Na hi so nandati yo nirūpadhī”ti. ",
      "english": "without attachments there’s no delight.” "
    },
    {
      "number": 10,
      "pali": "“Socati puttehi puttimā, ",
      "english": "“Children bring you sorrow. "
    },
    {
      "number": 11,
      "pali": "Gomā gohi tatheva socati; ",
      "english": "Cattle also bring you sorrow. "
    },
    {
      "number": 12,
      "pali": "Upadhīhi narassa socanā, ",
      "english": "For attachments are a man’s sorrow; "
    },
    {
      "number": 13,
      "pali": "Na hi so socati yo nirūpadhī”ti. ",
      "english": "without attachments there are no sorrows.” "
    }
  ]
}