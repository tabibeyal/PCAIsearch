{
  "sutta_id": "DHP304",
  "verses": [
    {
      "number": 1,
      "pali": "Cūḷasubhaddāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Dūre santo pakāsenti, ",
      "english": "The good shine from afar, "
    },
    {
      "number": 3,
      "pali": "himavantova pabbato; ",
      "english": "like the Himalayan peaks, "
    },
    {
      "number": 4,
      "pali": "Asantettha na dissanti, ",
      "english": "but the wicked are not seen, "
    },
    {
      "number": 5,
      "pali": "rattiṁ khittā yathā sarā. ",
      "english": "like arrows scattered in the night. "
    }
  ]
}