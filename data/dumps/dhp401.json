{
  "sutta_id": "DHP401",
  "verses": [
    {
      "number": 1,
      "pali": "Uppalavaṇṇāttherīvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Vāri pokkharapatteva, ",
      "english": "Like water from a lotus leaf, "
    },
    {
      "number": 3,
      "pali": "āraggeriva sāsapo; ",
      "english": "like a mustard seed off a pin-point, "
    },
    {
      "number": 4,
      "pali": "Yo na limpati kāmesu, ",
      "english": "sensual pleasures slip off them: "
    },
    {
      "number": 5,
      "pali": "tamahaṁ brūmi brāhmaṇaṁ. ",
      "english": "that’s who I declare a brahmin. "
    }
  ]
}