{
  "sutta_id": "AN4.231",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.231 ",
      "english": "Numbered Discourses 4.231 "
    },
    {
      "number": 2,
      "pali": "23. Duccaritavagga ",
      "english": "23. Bad Conduct "
    },
    {
      "number": 3,
      "pali": "Kavisutta ",
      "english": "Poets "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, kavī. ",
      "english": "“Mendicants, there are these four poets. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Cintākavi, sutakavi, atthakavi, paṭibhānakavi—",
      "english": "A poet who thoughtfully composes their own work, a poet who repeats the oral transmission, a poet who educates, and a poet who improvises. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro kavī”ti. ",
      "english": "These are the four poets.” "
    },
    {
      "number": 8,
      "pali": "Ekādasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Duccaritavaggo tatiyo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Duccaritaṁ diṭṭhi akataññū ca, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "Pāṇātipātāpi dve maggā; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Dve vohārapathā vuttā, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Ahirikaṁ duppaññakavinā cāti. ",
      "english": ""
    }
  ]
}