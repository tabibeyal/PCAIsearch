{
  "sutta_id": "SN1.51",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.51 ",
      "english": "Linked Discourses 1.51 "
    },
    {
      "number": 2,
      "pali": "6. Jarāvagga ",
      "english": "6. Old Age "
    },
    {
      "number": 3,
      "pali": "Jarāsutta ",
      "english": "Old Age "
    },
    {
      "number": 4,
      "pali": "“Kiṁsu yāva jarā sādhu, ",
      "english": "“What’s still good in old age? "
    },
    {
      "number": 5,
      "pali": "kiṁsu sādhu patiṭṭhitaṁ; ",
      "english": "What’s good when grounded? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu narānaṁ ratanaṁ, ",
      "english": "What is people’s treasure? "
    },
    {
      "number": 7,
      "pali": "kiṁsu corehi dūharan”ti. ",
      "english": "What’s hard for thieves to take?” "
    },
    {
      "number": 8,
      "pali": "“Sīlaṁ yāva jarā sādhu, ",
      "english": "“Ethics are still good in old age. "
    },
    {
      "number": 9,
      "pali": "saddhā sādhu patiṭṭhitā; ",
      "english": "Faith is good when grounded. "
    },
    {
      "number": 10,
      "pali": "Paññā narānaṁ ratanaṁ, ",
      "english": "Wisdom is people’s treasure. "
    },
    {
      "number": 11,
      "pali": "puññaṁ corehi dūharan”ti. ",
      "english": "Merit’s hard for thieves to take.” "
    }
  ]
}