  "sutta_id": "SN1.51",
  "verses": [
    {
      "number": 1,
      "pali": "Linked Discourses 1.51",
      "english": "Linked Discourses 1.51"
    },
    {
      "number": 2,
      "pali": "Jarā Sutta",
      "english": "Old Age"
    },
    {
      "number": 3,
      "pali": "",
      "english": "“What is good all the way through old age?"
    },
    {
      "number": 4,
      "pali": "",
      "english": "What is good when established?"
    },
    {
      "number": 5,
      "pali": "",
      "english": "What is the treasure of human beings?"
    },
    {
      "number": 6,
      "pali": "",
      "english": "What can’t be stolen by thieves?”"
    },
    {
      "number": 7,
      "pali": "",
      "english": "The Buddha:"
    },
    {
      "number": 8,
      "pali": "",
      "english": "“Virtue is good all the way through old age."
    },
    {
      "number": 9,
      "pali": "",
      "english": "Conviction is good when established."
    },
    {
      "number": 10,
      "pali": "",
      "english": "Discernment is the treasure of human beings."
    },
    {
      "number": 11,
      "pali": "",
      "english": "Merit can’t be stolen by thieves.”"
    }
  ]
}