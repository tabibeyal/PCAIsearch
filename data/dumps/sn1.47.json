    {
      "number": 3,
      "pali": "Vanaropasutta ",
      "english": "Planters "
    },
    {
      "number": 4,
      "pali": "“Kesaṁ divā ca ratto ca, ",
      "english": "“Whose merit always grows "
    },
    {
      "number": 5,
      "pali": "sadā puññaṁ pavaḍḍhati; ",
      "english": "by day and by night? "
    },
    {
      "number": 6,
      "pali": "Dhammaṭṭhā sīlasampannā, ",
      "english": "What people—firm in principle, <j>accomplished in conduct—"
    },
    {
      "number": 7,
      "pali": "ke janā saggagāmino”ti. ",
      "english": "are going to heaven?” "
    },
    {
      "number": 8,
      "pali": "“Ārāmaropā vanaropā, ",
      "english": "“Planters of parks or groves, "
    },
    {
      "number": 9,
      "pali": "ye janā setukārakā; ",
      "english": "those who build a bridge, "
    },
    {
      "number": 10,
      "pali": "Papañca udapānañca, ",
      "english": "a drinking place and well, "
    },
    {
      "number": 11,
      "pali": "ye dadanti upassayaṁ. ",
      "english": "and those who give monastic quarters. "
    },
    {
      "number": 12,
      "pali": "Tesaṁ divā ca ratto ca, ",
      "english": "Their merit always grows "
    },
    {
      "number": 13,
      "pali": "sadā puññaṁ pavaḍḍhati; ",
      "english": "by day and by night. "
    },
    {
      "number": 14,
      "pali": "Dhammaṭṭhā sīlasampannā, ",
      "english": "Those people—firm in principle, <j>accomplished in conduct—"
    },
    {
      "number": 15,
      "pali": "te janā saggagāmino”ti. ",
      "english": "are going to heaven.” "
    }
  ]
