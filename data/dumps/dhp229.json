{
  "sutta_id": "DHP229",
  "verses": [
    {
      "number": 1,
      "pali": "Yañce viññū pasaṁsanti, ",
      "english": "If, after watching them day in day out, "
    },
    {
      "number": 2,
      "pali": "anuvicca suve suve; ",
      "english": "discerning people praise "
    },
    {
      "number": 3,
      "pali": "Acchiddavuttiṁ medhāviṁ, ",
      "english": "that sage of impeccable conduct, "
    },
    {
      "number": 4,
      "pali": "paññāsīlasamāhitaṁ. ",
      "english": "endowed with ethics and wisdom; "
    }
  ]
}