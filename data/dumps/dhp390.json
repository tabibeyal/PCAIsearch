{
  "sutta_id": "DHP390",
  "verses": [
    {
      "number": 1,
      "pali": "Na brāhmaṇassetadakiñci seyyo, ",
      "english": "Nothing is better for a brahmin "
    },
    {
      "number": 2,
      "pali": "Yadā nisedho manaso piyehi; ",
      "english": "than to hold their mind back from attachment. "
    },
    {
      "number": 3,
      "pali": "Yato yato hiṁsamano nivattati, ",
      "english": "From wherever a cruel wish recoils, "
    },
    {
      "number": 4,
      "pali": "Tato tato sammatimeva dukkhaṁ. ",
      "english": "right there suffering subsides. "
    }
  ]
}