    },
    {
      "number": 4,
      "pali": "“Rāgassa, bhikkhave, abhiññāya pañca dhammā bhāvetabbā. ",
      "english": "“For insight into greed, five things should be developed. "
    },
    {
      "number": 5,
      "pali": "Katame pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhābalaṁ, vīriyabalaṁ, satibalaṁ, samādhibalaṁ, paññābalaṁ—",
      "english": "The powers of faith, energy, mindfulness, immersion, and wisdom. "
    },
    {
      "number": 7,
      "pali": "rāgassa, bhikkhave, abhiññāya ime pañca dhammā bhāvetabbā”ti. ",
      "english": "For insight into greed, these five things should be developed.” "
    }
  ]
