{
  "sutta_id": "DHP67",
  "verses": [
    {
      "number": 1,
      "pali": "Kassakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Na taṁ kammaṁ kataṁ sādhu, ",
      "english": "It’s not good to do a deed "
    },
    {
      "number": 3,
      "pali": "yaṁ katvā anutappati; ",
      "english": "that plagues you later on, "
    },
    {
      "number": 4,
      "pali": "Yassa assumukho rodaṁ, ",
      "english": "for which you weep and wail, "
    },
    {
      "number": 5,
      "pali": "vipākaṁ paṭisevati. ",
      "english": "as its effect stays with you. "
    }
  ]
}