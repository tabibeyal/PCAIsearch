{
  "sutta_id": "DHP357",
  "verses": [
    {
      "number": 1,
      "pali": "Tiṇadosāni khettāni, ",
      "english": "Weeds are the bane of crops, "
    },
    {
      "number": 2,
      "pali": "dosadosā ayaṁ pajā; ",
      "english": "but hate is these folk’s bane. "
    },
    {
      "number": 3,
      "pali": "Tasmā hi vītadosesu, ",
      "english": "That’s why a gift to one rid of hate "
    },
    {
      "number": 4,
      "pali": "dinnaṁ hoti mahapphalaṁ. ",
      "english": "is so very fruitful. "
    }
  ]
}