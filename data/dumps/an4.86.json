{
  "sutta_id": "AN4.86",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.86 ",
      "english": "Numbered Discourses 4.86 "
    },
    {
      "number": 2,
      "pali": "9. Macalavagga ",
      "english": "9. Confirmed "
    },
    {
      "number": 3,
      "pali": "Oṇatoṇatasutta ",
      "english": "Sunk Low "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“These four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Oṇatoṇato, ",
      "english": "One sunk low who sinks lower, "
    },
    {
      "number": 7,
      "pali": "oṇatuṇṇato, ",
      "english": "one sunk low who rises high, "
    },
    {
      "number": 8,
      "pali": "uṇṇatoṇato, ",
      "english": "one risen high who sinks low, and "
    },
    {
      "number": 9,
      "pali": "uṇṇatuṇṇato. ",
      "english": "one risen high who rises higher. "
    },
    {
      "number": 10,
      "pali": "… Ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasmin”ti. ",
      "english": "… These are the four individuals found in the world.” "
    },
    {
      "number": 11,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}