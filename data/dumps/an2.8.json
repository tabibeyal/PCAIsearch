{
  "sutta_id": "AN2.8",
  "verses": [
    {
      "number": 1,
      "pali": "8. Sukkasutta ",
      "english": "8. Bright "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā sukkā. ",
      "english": "“These two things, mendicants, are bright. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Hirī ca ottappañca. ",
      "english": "Conscience and prudence. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā sukkā”ti. ",
      "english": "These are the two things that are bright.” "
    },
    {
      "number": 6,
      "pali": "Aṭṭhamaṁ. ",
      "english": ""
    }
  ]
}