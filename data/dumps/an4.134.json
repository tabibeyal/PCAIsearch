{
  "sutta_id": "AN4.134",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 4.134 ",
      "english": "Numbered Discourses 4.134 "
    },
    {
      "number": 2,
      "pali": "14. Puggalavagga ",
      "english": "14. Individuals "
    },
    {
      "number": 3,
      "pali": "Uṭṭhānaphalasutta ",
      "english": "The Fruits of Initiative "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
      "english": "“These four individuals are found in the world. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Uṭṭhānaphalūpajīvī na kammaphalūpajīvī, ",
      "english": "One who lives off the fruit of initiative, but not deeds; "
    },
    {
      "number": 7,
      "pali": "kammaphalūpajīvī na uṭṭhānaphalūpajīvī, ",
      "english": "one who lives off the fruit of deeds, but not initiative; "
    },
    {
      "number": 8,
      "pali": "uṭṭhānaphalūpajīvī ceva kammaphalūpajīvī ca, ",
      "english": "one who lives off the fruit of both deeds and initiative; "
    },
    {
      "number": 9,
      "pali": "neva uṭṭhānaphalūpajīvī na kammaphalūpajīvī—",
      "english": "one who lives off the fruit of neither initiative nor deeds. "
    },
    {
      "number": 10,
      "pali": "Ime kho, bhikkhave, cattāro puggalā santo saṁvijjamānā lokasmin”ti. ",
      "english": "These are the four individuals found in the world.” "
    },
    {
      "number": 11,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}