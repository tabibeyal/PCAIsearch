{
  "sutta_id": "DHP208",
  "verses": [
    {
      "number": 1,
      "pali": "Tasmā hi—",
      "english": "Therefore: "
    },
    {
      "number": 2,
      "pali": "Dhīrañca paññañca bahussutañca, ",
      "english": "An attentive one, wise and learned, "
    },
    {
      "number": 3,
      "pali": "Dhorayhasīlaṁ vatavantamariyaṁ; ",
      "english": "a behemoth of virtue, true to their vows, noble: "
    },
    {
      "number": 4,
      "pali": "Taṁ tādisaṁ sappurisaṁ sumedhaṁ, ",
      "english": "follow a true and intelligent person such as this, "
    },
    {
      "number": 5,
      "pali": "Bhajetha nakkhattapathaṁva candimā. ",
      "english": "as the moon tracks the path of the stars. "
    },
    {
      "number": 6,
      "pali": "Sukhavaggo pannarasamo. ",
      "english": ""
    }
  ]
}