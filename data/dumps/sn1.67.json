{
  "sutta_id": "SN1.67",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.67 ",
      "english": "Linked Discourses 1.67 "
    },
    {
      "number": 2,
      "pali": "7. Addhavagga ",
      "english": "7. Overcome "
    },
    {
      "number": 3,
      "pali": "Uḍḍitasutta ",
      "english": "Ensnared "
    },
    {
      "number": 4,
      "pali": "“Kenassu uḍḍito loko, ",
      "english": "“By what is the world ensnared? "
    },
    {
      "number": 5,
      "pali": "kenassu parivārito; ",
      "english": "By what is it surrounded? "
    },
    {
      "number": 6,
      "pali": "Kenassu pihito loko, ",
      "english": "By what is the world fastened shut? "
    },
    {
      "number": 7,
      "pali": "kismiṁ loko patiṭṭhito”ti. ",
      "english": "On what is the world grounded?” "
    },
    {
      "number": 8,
      "pali": "“Taṇhāya uḍḍito loko, ",
      "english": "“Craving has ensnared the world. "
    },
    {
      "number": 9,
      "pali": "jarāya parivārito; ",
      "english": "It’s surrounded by old age. "
    },
    {
      "number": 10,
      "pali": "Maccunā pihito loko, ",
      "english": "The world is fastened shut by mortality. "
    },
    {
      "number": 11,
      "pali": "dukkhe loko patiṭṭhito”ti. ",
      "english": "The world is grounded on suffering.” "
    }
  ]
}