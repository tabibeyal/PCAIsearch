{
  "sutta_id": "DHP149",
  "verses": [
    {
      "number": 1,
      "pali": "Sambahulaadhimānikabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yānimāni apatthāni, ",
      "english": "These dove-grey bones "
    },
    {
      "number": 3,
      "pali": "alābūneva sārade; ",
      "english": "are tossed away like "
    },
    {
      "number": 4,
      "pali": "Kāpotakāni aṭṭhīni, ",
      "english": "dried gourds in the autumn—"
    },
    {
      "number": 5,
      "pali": "tāni disvāna kā rati. ",
      "english": "what joy is there in such a sight? "
    }
  ]
}