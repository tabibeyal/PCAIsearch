    {
      "number": 3,
      "pali": "Vandanāsutta ",
      "english": "Homage "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, vandanā. ",
      "english": "“Mendicants, there are three kinds of homage. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Kāyena, vācāya, manasā—",
      "english": "By way of body, speech, and mind. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso vandanā”ti. ",
      "english": "These are the three kinds of homage.” "
    },
    {
      "number": 8,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
