{
  "sutta_id": "DHP301",
  "verses": [
    {
      "number": 1,
      "pali": "Suppabuddhaṁ pabujjhanti, ",
      "english": "The disciples of Gotama "
    },
    {
      "number": 2,
      "pali": "sadā gotamasāvakā; ",
      "english": "always wake up refreshed, "
    },
    {
      "number": 3,
      "pali": "Yesaṁ divā ca ratto ca, ",
      "english": "whose minds day and night "
    },
    {
      "number": 4,
      "pali": "bhāvanāya rato mano. ",
      "english": "delight in meditation. "
    }
  ]
}