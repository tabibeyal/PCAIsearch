    },
    {
      "number": 5,
      "pali": "Cakkhunā saṁvaro sādhu, ",
      "english": "Restraint of the eye is good; "
    },
    {
      "number": 6,
      "pali": "sādhu sotena saṁvaro; ",
      "english": "good is restraint of the ear; "
    },
    {
      "number": 7,
      "pali": "Ghānena saṁvaro sādhu, ",
      "english": "restraint of the nose is good; "
    },
    {
      "number": 8,
      "pali": "sādhu jivhāya saṁvaro. ",
      "english": "good is restraint of the tongue. "
    }
