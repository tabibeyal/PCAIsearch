{
  "sutta_id": "AN7.94",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 7.94 ",
      "english": "Numbered Discourses 7.94 "
    },
    {
      "number": 2,
      "pali": "9. Samaṇavagga ",
      "english": "9. An Ascetic "
    },
    {
      "number": 3,
      "pali": "Saddhammasutta ",
      "english": "Good Qualities "
    },
    {
      "number": 4,
      "pali": "“Sattime, bhikkhave, saddhammā. ",
      "english": "“Mendicants, there are these seven good qualities. "
    },
    {
      "number": 5,
      "pali": "Katame satta? ",
      "english": "What seven? "
    },
    {
      "number": 6,
      "pali": "Saddho hoti, hirīmā hoti, ottappī hoti, bahussuto hoti, āraddhavīriyo hoti, satimā hoti, paññavā hoti. ",
      "english": "Someone is faithful, conscientious, prudent, learned, energetic, mindful, and wise. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, satta saddhammā”ti. ",
      "english": "These are the seven good qualities.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 9,
      "pali": "Samaṇavaggo navamo. ",
      "english": ""
    },
    {
      "number": 10,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 11,
      "pali": "Bhikkhuṁ samaṇo brāhmaṇo, ",
      "english": ""
    },
    {
      "number": 12,
      "pali": "sottiyo ceva nhātako; ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Vedagū ariyo arahā, ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "asaddhammā ca saddhammāti. ",
      "english": ""
    }
  ]
}