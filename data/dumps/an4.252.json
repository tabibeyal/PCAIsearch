      "number": 1,
      "pali": "Aṅguttara Nikāya 4.252 ",
      "english": "Numbered Discourses 4.252 "
    },
    {
      "number": 2,
      "pali": "25. Āpattibhayavagga ",
      "english": "25. Perils of Offenses "
    },
    {
      "number": 3,
      "pali": "Tatiyavohārasutta ",
      "english": "Expressions (3rd) "
    },
    {
      "number": 4,
      "pali": "“Cattārome, bhikkhave, anariyavohārā. ",
      "english": "“Mendicants, there are these four ignoble expressions. "
    },
    {
      "number": 5,
      "pali": "Katame cattāro? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "Diṭṭhe adiṭṭhavāditā, sute asutavāditā, mute amutavāditā, viññāte aviññātavāditā—",
      "english": "Saying you haven’t seen, heard, thought, or known something, and you have. "
    },
    {
      "number": 7,
      "pali": "Ime kho, bhikkhave, cattāro anariyavohārā”ti. ",
      "english": "These are the four ignoble expressions.” "
    },
    {
      "number": 8,
      "pali": "Dasamaṁ. ",
      "english": ""
    }
  ]
}