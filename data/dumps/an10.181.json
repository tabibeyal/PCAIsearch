{
  "sutta_id": "AN10.181",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.181 ",
      "english": "Numbered Discourses 10.181 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Atthasutta ",
      "english": "Beneficial "
    },
    {
      "number": 4,
      "pali": "“Atthañca vo, bhikkhave, desessāmi anatthañca. ",
      "english": "“I will teach you the beneficial and the harmful. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, anattho? ",
      "english": "And what is the harmful? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, anattho. ",
      "english": "This is called the harmful. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, attho? ",
      "english": "And what is the beneficial? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, attho”ti. ",
      "english": "This is called the beneficial.” "
    },
    {
      "number": 14,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
}