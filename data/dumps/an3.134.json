    {
      "number": 2,
      "pali": "14. Yodhājīvavagga ",
      "english": "14. A Warrior "
    },
    {
      "number": 3,
      "pali": "Parisāsutta ",
      "english": "Assemblies "
    },
    {
      "number": 4,
      "pali": "“Tisso imā, bhikkhave, parisā. ",
      "english": "“Mendicants, there are these three assemblies. "
    },
    {
      "number": 5,
      "pali": "Katamā tisso? ",
      "english": "What three? "
    },
    {
      "number": 6,
      "pali": "Ukkācitavinītā parisā, paṭipucchāvinītā parisā, yāvatāvinītā parisā—",
      "english": "An assembly educated in fancy talk, an assembly educated in questioning, and an assembly educated to the fullest extent. "
    },
    {
      "number": 7,
      "pali": "imā kho, bhikkhave, tisso parisā”ti. ",
      "english": "These are the three assemblies.” "
    },
    {
      "number": 8,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}