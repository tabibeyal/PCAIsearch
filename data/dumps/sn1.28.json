{
  "sutta_id": "SN1.28",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.28 ",
      "english": "Linked Discourses 1.28 "
    },
    {
      "number": 2,
      "pali": "3. Sattivagga ",
      "english": "3. A Sword "
    },
    {
      "number": 3,
      "pali": "Mahaddhanasutta ",
      "english": "Affluent "
    },
    {
      "number": 4,
      "pali": "“Mahaddhanā mahābhogā, ",
      "english": "“The affluent and the wealthy, "
    },
    {
      "number": 5,
      "pali": "raṭṭhavantopi khattiyā; ",
      "english": "even the aristocrats who rule the land, "
    },
    {
      "number": 6,
      "pali": "Aññamaññābhigijjhanti, ",
      "english": "are jealous of each other, "
    },
    {
      "number": 7,
      "pali": "kāmesu analaṅkatā. ",
      "english": "insatiable in sensual pleasures. "
    },
    {
      "number": 8,
      "pali": "Tesu ussukkajātesu, ",
      "english": "Among those of such an avid nature, "
    },
    {
      "number": 9,
      "pali": "bhavasotānusārisu; ",
      "english": "flowing along the stream of lives, "
    },
    {
      "number": 10,
      "pali": "Kedha taṇhaṁ pajahiṁsu, ",
      "english": "who here has given up craving? "
    },
    {
      "number": 11,
      "pali": "ke lokasmiṁ anussukā”ti. ",
      "english": "Who in the world is not avid?” "
    },
    {
      "number": 12,
      "pali": "“Hitvā agāraṁ pabbajitā, ",
      "english": "“Having given up their home, their child, their cattle, "
    },
    {
      "number": 13,
      "pali": "hitvā puttaṁ pasuṁ piyaṁ; ",
      "english": "and all that they love, they went forth. "
    },
    {
      "number": 14,
      "pali": "Hitvā rāgañca dosañca, ",
      "english": "Having given up desire and hate, "
    },
    {
      "number": 15,
      "pali": "avijjañca virājiya; ",
      "english": "having dispelled ignorance, "
    },
    {
      "number": 16,
      "pali": "Khīṇāsavā arahanto, ",
      "english": "the perfected ones with defilements ended—"
    },
    {
      "number": 17,
      "pali": "te lokasmiṁ anussukā”ti. ",
      "english": "they in the world are not avid.” "
    }
  ]
}