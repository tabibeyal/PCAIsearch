{
  "sutta_id": "SN56.20",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 56.20 ",
      "english": "Linked Discourses 56.20 "
    },
    {
      "number": 2,
      "pali": "2. Dhammacakkappavattanavagga ",
      "english": "2. Rolling Forth the Wheel of Dhamma "
    },
    {
      "number": 3,
      "pali": "Tathasutta ",
      "english": "Real "
    },
    {
      "number": 4,
      "pali": "“Cattārimāni, bhikkhave, tathāni avitathāni anaññathāni. ",
      "english": "“Mendicants, these four things are real, not unreal, not otherwise. "
    },
    {
      "number": 5,
      "pali": "Katamāni cattāri? ",
      "english": "What four? "
    },
    {
      "number": 6,
      "pali": "‘Idaṁ dukkhan’ti, bhikkhave, tathametaṁ avitathametaṁ anaññathametaṁ; ",
      "english": "‘This is suffering’ … "
    },
    {
      "number": 7,
      "pali": "‘ayaṁ dukkhasamudayo’ti tathametaṁ avitathametaṁ anaññathametaṁ; ",
      "english": "‘This is the origin of suffering’ … "
    },
    {
      "number": 8,
      "pali": "‘ayaṁ dukkhanirodho’ti tathametaṁ avitathametaṁ anaññathametaṁ; ",
      "english": "‘This is the cessation of suffering’ … "
    },
    {
      "number": 9,
      "pali": "‘ayaṁ dukkhanirodhagāminī paṭipadā’ti tathametaṁ avitathametaṁ anaññathametaṁ—",
      "english": "‘This is the practice that leads to the cessation of suffering’ … "
    },
    {
      "number": 10,
      "pali": "imāni kho, bhikkhave, cattāri tathāni avitathāni anaññathāni. ",
      "english": "These four things are real, not unreal, not otherwise. "
    },
    {
      "number": 11,
      "pali": "Tasmātiha, bhikkhave, ‘idaṁ dukkhan’ti yogo karaṇīyo …pe… ‘ayaṁ dukkhanirodhagāminī paṭipadā’ti yogo karaṇīyo”ti. ",
      "english": "That’s why you should practice meditation …” "
    },
    {
      "number": 12,
      "pali": "Dasamaṁ. ",
      "english": ""
    },
    {
      "number": 13,
      "pali": "Dhammacakkappavattanavaggo dutiyo. ",
      "english": ""
    },
    {
      "number": 14,
      "pali": "Tassuddānaṁ ",
      "english": ""
    },
    {
      "number": 15,
      "pali": "Dhammacakkaṁ tathāgataṁ, ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "khandhā āyatanena ca; ",
      "english": ""
    },
    {
      "number": 17,
      "pali": "Dhāraṇā ca dve avijjā, ",
      "english": ""
    },
    {
      "number": 18,
      "pali": "vijjā saṅkāsanā tathāti. ",
      "english": ""
    }
  ]
}