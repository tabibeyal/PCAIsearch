{
  "sutta_id": "ITI60",
  "verses": [
    {
      "number": 1,
      "pali": "Itivuttaka 60 ",
      "english": "So It Was Said 60 "
    },
    {
      "number": 2,
      "pali": "Tikanipāta ",
      "english": "The Book of the Threes "
    },
    {
      "number": 3,
      "pali": "Dutiyavagga ",
      "english": "Chapter Two "
    },
    {
      "number": 4,
      "pali": "Puññakiriyavatthusutta ",
      "english": "Grounds for Making Merit "
    },
    {
      "number": 5,
      "pali": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ: ",
      "english": "This was said by the Buddha, the Perfected One: that is what I heard. "
    },
    {
      "number": 6,
      "pali": "“Tīṇimāni, bhikkhave, puññakiriyavatthūni. ",
      "english": "“Mendicants, there are these three grounds for making merit. "
    },
    {
      "number": 7,
      "pali": "Katamāni tīṇi? ",
      "english": "What three? "
    },
    {
      "number": 8,
      "pali": "Dānamayaṁ puññakiriyavatthu, sīlamayaṁ puññakiriyavatthu, bhāvanāmayaṁ puññakiriyavatthu—",
      "english": "Giving, ethical conduct, and meditation are all grounds for making merit. "
    },
    {
      "number": 9,
      "pali": "imāni kho, bhikkhave, tīṇi puññakiriyavatthūnī”ti. ",
      "english": "These are the three grounds for making merit.” "
    },
    {
      "number": 10,
      "pali": "Etamatthaṁ bhagavā avoca. ",
      "english": "The Buddha spoke this matter. "
    },
    {
      "number": 11,
      "pali": "Tatthetaṁ iti vuccati: ",
      "english": "On this it is said: "
    },
    {
      "number": 12,
      "pali": "“Puññameva so sikkheyya, ",
      "english": "“One should practice only good deeds, "
    },
    {
      "number": 13,
      "pali": "āyataggaṁ sukhudrayaṁ; ",
      "english": "whose happy outcome stretches ahead. "
    },
    {
      "number": 14,
      "pali": "Dānañca samacariyañca, ",
      "english": "Giving and moral conduct, "
    },
    {
      "number": 15,
      "pali": "mettacittañca bhāvaye. ",
      "english": "developing a mind of love: "
    },
    {
      "number": 16,
      "pali": "Ete dhamme bhāvayitvā, ",
      "english": "having developed these "
    },
    {
      "number": 17,
      "pali": "tayo sukhasamuddaye; ",
      "english": "three things yielding happiness, "
    },
    {
      "number": 18,
      "pali": "Abyābajjhaṁ sukhaṁ lokaṁ, ",
      "english": "that astute one is reborn "
    },
    {
      "number": 19,
      "pali": "paṇḍito upapajjatī”ti. ",
      "english": "in a happy, pleasing world.” "
    },
    {
      "number": 20,
      "pali": "Ayampi attho vutto bhagavatā, iti me sutanti. ",
      "english": "This too is a matter that was spoken by the Blessed One: that is what I heard. "
    },
    {
      "number": 21,
      "pali": "Paṭhamaṁ. ",
      "english": ""
    }
  ]
}