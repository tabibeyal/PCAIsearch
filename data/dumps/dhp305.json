{
  "sutta_id": "DHP305",
  "verses": [
    {
      "number": 1,
      "pali": "Ekavihārittheravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ekāsanaṁ ekaseyyaṁ, ",
      "english": "Sitting alone, sleeping alone, "
    },
    {
      "number": 3,
      "pali": "eko caramatandito; ",
      "english": "tirelessly wandering alone; "
    },
    {
      "number": 4,
      "pali": "Eko damayamattānaṁ, ",
      "english": "one who tames themselves alone "
    },
    {
      "number": 5,
      "pali": "vanante ramito siyā. ",
      "english": "would delight within a forest. "
    },
    {
      "number": 6,
      "pali": "Pakiṇṇakavaggo ekavīsatimo. ",
      "english": ""
    }
  ]
}