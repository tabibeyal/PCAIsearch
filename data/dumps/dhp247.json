{
  "sutta_id": "DHP247",
  "verses": [
    {
      "number": 1,
      "pali": "Surāmerayapānañca, ",
      "english": "and indulges in drinking "
    },
    {
      "number": 2,
      "pali": "yo naro anuyuñjati; ",
      "english": "beer and wine. "
    },
    {
      "number": 3,
      "pali": "Idheva meso lokasmiṁ, ",
      "english": "Right here they dig up "
    },
    {
      "number": 4,
      "pali": "mūlaṁ khaṇati attano. ",
      "english": "the root of their own self. "
    }
  ]
}