{
  "sutta_id": "AN10.180",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.180 ",
      "english": "Numbered Discourses 10.180 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Kusalasutta ",
      "english": "Skillful "
    },
    {
      "number": 4,
      "pali": "“Kusalañca vo, bhikkhave, desessāmi akusalañca. ",
      "english": "“I will teach you the skillful and the unskillful … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamañca, bhikkhave, akusalaṁ? ",
      "english": "And what is the unskillful? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "idaṁ vuccati, bhikkhave, akusalaṁ. ",
      "english": "This is called the unskillful. "
    },
    {
      "number": 10,
      "pali": "Katamañca, bhikkhave, kusalaṁ? ",
      "english": "And what is the skillful? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "idaṁ vuccati, bhikkhave, kusalan”ti. ",
      "english": "This is called the skillful.” "
    },
    {
      "number": 14,
      "pali": "Tatiyaṁ. ",
      "english": ""
    }
  ]
}