{
  "sutta_id": "AN2.104",
  "verses": [
    {
      "number": 1,
      "pali": "104 ",
      "english": "104 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, bālā. ",
      "english": "“Mendicants, there are two fools. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Yo ca adhamme dhammasaññī, yo ca dhamme adhammasaññī. ",
      "english": "One who perceives what is not the teaching as the teaching, and one who perceives the teaching as not the teaching. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve bālā”ti. ",
      "english": "These are the two fools.” "
    }
  ]
}