{
  "sutta_id": "SN1.76",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.76 ",
      "english": "Linked Discourses 1.76 "
    },
    {
      "number": 2,
      "pali": "8. Chetvāvagga ",
      "english": "8. Slain "
    },
    {
      "number": 3,
      "pali": "Najīratisutta ",
      "english": "Getting Old "
    },
    {
      "number": 4,
      "pali": "“Kiṁ jīrati kiṁ na jīrati, ",
      "english": "“What ages, what does not age? "
    },
    {
      "number": 5,
      "pali": "kiṁsu uppathoti vuccati; ",
      "english": "What’s called a deviation? "
    },
    {
      "number": 6,
      "pali": "Kiṁsu dhammānaṁ paripantho, ",
      "english": "What’s a roadblock for skillful qualities? "
    },
    {
      "number": 7,
      "pali": "kiṁsu rattindivakkhayo; ",
      "english": "What is ending day and night? "
    },
    {
      "number": 8,
      "pali": "Kiṁ malaṁ brahmacariyassa, ",
      "english": "What’s the stain of celibacy? "
    },
    {
      "number": 9,
      "pali": "kiṁ sinānamanodakaṁ. ",
      "english": "What’s the waterless bath? "
    },
    {
      "number": 10,
      "pali": "Kati lokasmiṁ chiddāni, ",
      "english": "How many holes are there in the world, "
    },
    {
      "number": 11,
      "pali": "yattha vittaṁ na tiṭṭhati; ",
      "english": "where one’s wealth leaks out? "
    },
    {
      "number": 12,
      "pali": "Bhagavantaṁ puṭṭhumāgamma, ",
      "english": "We’ve come to ask you, worthy sir: "
    },
    {
      "number": 13,
      "pali": "kathaṁ jānemu taṁ mayan”ti. ",
      "english": "how are we to understand this?” "
    },
    {
      "number": 14,
      "pali": "“Rūpaṁ jīrati maccānaṁ, ",
      "english": "“The physical form of mortals gets old, "
    },
    {
      "number": 15,
      "pali": "nāmagottaṁ na jīrati; ",
      "english": "but their name and clan don’t. "
    },
    {
      "number": 16,
      "pali": "Rāgo uppathoti vuccati. ",
      "english": "Lust is called a deviation, "
    },
    {
      "number": 17,
      "pali": "Lobho dhammānaṁ paripantho, ",
      "english": "and greed is a roadblock for skillful qualities. "
    },
    {
      "number": 18,
      "pali": "Vayo rattindivakkhayo; ",
      "english": "Youth is ending day and night. "
    },
    {
      "number": 19,
      "pali": "Itthī malaṁ brahmacariyassa, ",
      "english": "Women are the stain of chastity, "
    },
    {
      "number": 20,
      "pali": "Etthāyaṁ sajjate pajā; ",
      "english": "to which this generation clings. "
    },
    {
      "number": 21,
      "pali": "Tapo ca brahmacariyañca, ",
      "english": "Fervor and chastity "
    },
    {
      "number": 22,
      "pali": "Taṁ sinānamanodakaṁ. ",
      "english": "are the waterless bath. "
    },
    {
      "number": 23,
      "pali": "Cha lokasmiṁ chiddāni, ",
      "english": "There are six holes in the world, "
    },
    {
      "number": 24,
      "pali": "yattha vittaṁ na tiṭṭhati; ",
      "english": "where one’s wealth leaks out: "
    },
    {
      "number": 25,
      "pali": "Ālasyañca pamādo ca, ",
      "english": "laziness and negligence, "
    },
    {
      "number": 26,
      "pali": "anuṭṭhānaṁ asaṁyamo; ",
      "english": "lack of initiative and lack of restraint, "
    },
    {
      "number": 27,
      "pali": "Niddā tandī ca te chidde, ",
      "english": "sleepiness and sloth. "
    },
    {
      "number": 28,
      "pali": "sabbaso taṁ vivajjaye”ti. ",
      "english": "You should completely get rid of these holes!” "
    }
  ]
}