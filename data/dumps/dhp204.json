{
  "sutta_id": "DHP204",
  "verses": [
    {
      "number": 1,
      "pali": "Pasenadikosalavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Ārogyaparamā lābhā, ",
      "english": "Health is the ultimate blessing; "
    },
    {
      "number": 3,
      "pali": "Santuṭṭhiparamaṁ dhanaṁ; ",
      "english": "contentment, the ultimate wealth; "
    },
    {
      "number": 4,
      "pali": "Vissāsaparamā ñāti, ",
      "english": "trust is the ultimate family; "
    },
    {
      "number": 5,
      "pali": "Nibbānaṁ paramaṁ sukhaṁ. ",
      "english": "extinguishment, the ultimate happiness. "
    }
  ]
}