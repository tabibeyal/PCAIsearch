{
  "sutta_id": "DHP344",
  "verses": [
    {
      "number": 1,
      "pali": "Vibbhantabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yo nibbanatho vanādhimutto, ",
      "english": "Unsnarled, they set out for the jungle, "
    },
    {
      "number": 3,
      "pali": "Vanamutto vanameva dhāvati; ",
      "english": "then they run right back to the jungle they left behind. "
    },
    {
      "number": 4,
      "pali": "Taṁ puggalametha passatha, ",
      "english": "Just look at this individual! "
    },
    {
      "number": 5,
      "pali": "Mutto bandhanameva dhāvati. ",
      "english": "Freed, they run to bondage. "
    }
  ]
}