{
  "sutta_id": "SN1.8",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 1.8 ",
      "english": "Linked Discourses 1.8 "
    },
    {
      "number": 2,
      "pali": "1. Naḷavagga ",
      "english": "1. A Reed "
    },
    {
      "number": 3,
      "pali": "Susammuṭṭhasutta ",
      "english": "Very Confused "
    },
    {
      "number": 4,
      "pali": "Sāvatthinidānaṁ. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "Ekamantaṁ ṭhitā kho sā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, that deity spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 6,
      "pali": "“Yesaṁ dhammā susammuṭṭhā, ",
      "english": "“Those who are very confused about the teachings "
    },
    {
      "number": 7,
      "pali": "paravādesu nīyare; ",
      "english": "may be led astray by the doctrines of others. "
    },
    {
      "number": 8,
      "pali": "Suttā te nappabujjhanti, ",
      "english": "Asleep, they have not woken up: "
    },
    {
      "number": 9,
      "pali": "kālo tesaṁ pabujjhitun”ti. ",
      "english": "it is time for them to wake!” "
    },
    {
      "number": 10,
      "pali": "“Yesaṁ dhammā asammuṭṭhā, ",
      "english": "“Those who are unconfused about the teachings, "
    },
    {
      "number": 11,
      "pali": "paravādesu na nīyare; ",
      "english": "won’t be led astray by the doctrines of others. "
    },
    {
      "number": 12,
      "pali": "Te sambuddhā sammadaññā, ",
      "english": "They have woken up, they rightly know, "
    },
    {
      "number": 13,
      "pali": "caranti visame saman”ti. ",
      "english": "smoothly they walk in the rough.” "
    }
  ]
}