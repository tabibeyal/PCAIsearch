{
  "sutta_id": "AN2.160",
  "verses": [
    {
      "number": 1,
      "pali": "160 ",
      "english": "160 "
    },
    {
      "number": 2,
      "pali": "“Dvemāni, bhikkhave, ratanāni. ",
      "english": "“There are these two treasures. "
    },
    {
      "number": 3,
      "pali": "Katamāni dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Āmisaratanañca dhammaratanañca. ",
      "english": "The treasure of things of the flesh and the treasure of the teaching. "
    },
    {
      "number": 5,
      "pali": "Imāni kho, bhikkhave, dve ratanāni. ",
      "english": "These are the two treasures. "
    },
    {
      "number": 6,
      "pali": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ ratanānaṁ yadidaṁ dhammaratanan”ti. ",
      "english": "The better of these two treasures is the treasure of the teaching.” "
    }
  ]
}