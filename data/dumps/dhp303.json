{
  "sutta_id": "DHP303",
  "verses": [
    {
      "number": 1,
      "pali": "Cittagahapativatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Saddho sīlena sampanno, ",
      "english": "One who is faithful, accomplished in ethics, "
    },
    {
      "number": 3,
      "pali": "yasobhogasamappito; ",
      "english": "blessed with fame and wealth, "
    },
    {
      "number": 4,
      "pali": "Yaṁ yaṁ padesaṁ bhajati, ",
      "english": "is honored in whatever place "
    },
    {
      "number": 5,
      "pali": "tattha tattheva pūjito. ",
      "english": "they frequent. "
    }
  ]
}