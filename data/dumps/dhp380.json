{
  "sutta_id": "DHP380",
  "verses": [
    {
      "number": 1,
      "pali": "Attā hi attano nātho, ",
      "english": "Self is indeed the lord of self, "
    },
    {
      "number": 2,
      "pali": "ko hi nātho paro siyā; ",
      "english": "for who else would be one’s lord? "
    },
    {
      "number": 3,
      "pali": "Attā hi attano gati, ",
      "english": "Self is indeed the home of self, "
    },
    {
      "number": 4,
      "pali": "tasmā saṁyamamattānaṁ; ",
      "english": "so restrain yourself, "
    },
    {
      "number": 5,
      "pali": "Assaṁ bhadraṁva vāṇijo. ",
      "english": "as a merchant his thoroughbred steed. "
    }
  ]
}