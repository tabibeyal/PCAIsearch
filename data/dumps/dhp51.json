{
  "sutta_id": "DHP51",
  "verses": [
    {
      "number": 1,
      "pali": "Chattapāṇiupāsakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathāpi ruciraṁ pupphaṁ, ",
      "english": "Just like a glorious flower "
    },
    {
      "number": 3,
      "pali": "vaṇṇavantaṁ agandhakaṁ; ",
      "english": "that’s colorful but lacks fragrance; "
    },
    {
      "number": 4,
      "pali": "Evaṁ subhāsitā vācā, ",
      "english": "eloquent speech is fruitless "
    },
    {
      "number": 5,
      "pali": "aphalā hoti akubbato. ",
      "english": "for one who does not act on it. "
    }
  ]
}