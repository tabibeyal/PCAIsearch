{
  "sutta_id": "DHP20",
  "verses": [
    {
      "number": 1,
      "pali": "Appampi ce saṁhita bhāsamāno, ",
      "english": "Little though they may recite scripture, "
    },
    {
      "number": 2,
      "pali": "Dhammassa hoti anudhammacārī; ",
      "english": "if they live in line with the teaching, "
    },
    {
      "number": 3,
      "pali": "Rāgañca dosañca pahāya mohaṁ, ",
      "english": "having given up greed, hate, and delusion, "
    },
    {
      "number": 4,
      "pali": "Sammappajāno suvimuttacitto; ",
      "english": "with deep understanding and heart well freed, "
    },
    {
      "number": 5,
      "pali": "Anupādiyāno idha vā huraṁ vā, ",
      "english": "not grasping to this life or the next, "
    },
    {
      "number": 6,
      "pali": "Sa bhāgavā sāmaññassa hoti. ",
      "english": "they share in the blessings of the ascetic life. "
    },
    {
      "number": 7,
      "pali": "Yamakavaggo paṭhamo. ",
      "english": ""
    }
  ]
}