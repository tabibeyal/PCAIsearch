{
  "sutta_id": "AN10.168",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.168 ",
      "english": "Numbered Discourses 10.168 "
    },
    {
      "number": 2,
      "pali": "17. Jāṇussoṇivagga ",
      "english": "17. With Jānussoṇi "
    },
    {
      "number": 3,
      "pali": "Ariyapaccorohaṇīsutta ",
      "english": "The Noble Descent "
    },
    {
      "number": 4,
      "pali": "“Ariyaṁ vo, bhikkhave, paccorohaṇiṁ desessāmi. ",
      "english": "“Mendicants, I will teach you the noble descent. "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha, sādhukaṁ manasi karotha, bhāsissāmī”ti. ",
      "english": "Listen and apply your mind well, I will speak.” "
    },
    {
      "number": 6,
      "pali": "“Evaṁ, bhante”ti kho te bhikkhū bhagavato paccassosuṁ. ",
      "english": "“Yes, sir,” they replied. "
    },
    {
      "number": 7,
      "pali": "Bhagavā etadavoca: ",
      "english": "The Buddha said this: "
    },
    {
      "number": 8,
      "pali": "“Katamā ca, bhikkhave, ariyā paccorohaṇī? ",
      "english": "“And what, mendicants, is the noble descent? "
    },
    {
      "number": 9,
      "pali": "Idha, bhikkhave, ariyasāvako iti paṭisañcikkhati: ",
      "english": "It’s when a noble disciple reflects: "
    },
    {
      "number": 10,
      "pali": "‘pāṇātipātassa kho pāpako vipāko—",
      "english": "‘Killing living creatures has a bad result "
    },
    {
      "number": 11,
      "pali": "diṭṭhe ceva dhamme abhisamparāyañcā’ti. ",
      "english": "in the present life and in lives to come.’ "
    },
    {
      "number": 12,
      "pali": "So iti paṭisaṅkhāya pāṇātipātaṁ pajahati; ",
      "english": "Reflecting like this, they give up killing living creatures, "
    },
    {
      "number": 13,
      "pali": "pāṇātipātā paccorohati. ",
      "english": "they descend from killing living creatures. "
    },
    {
      "number": 14,
      "pali": "… ‘Adinnādānassa kho pāpako vipāko—",
      "english": "… ‘Stealing has a bad result "
    },
    {
      "number": 15,
      "pali": "diṭṭhe ceva dhamme abhisamparāyañcā’ti. ",
      "english": "in the present life and in lives to come.’ "
    },
    {
      "number": 16,
      "pali": "So iti paṭisaṅkhāya adinnādānaṁ pajahati; ",
      "english": "Reflecting like this, they give up stealing, "
    },
    {
      "number": 17,
      "pali": "adinnādānā paccorohati. ",
      "english": "they descend from stealing. "
    },
    {
      "number": 18,
      "pali": "… ‘Kāmesumicchācārassa kho pāpako vipāko …pe… ",
      "english": "… ‘Sexual misconduct has a bad result …’ … "
    },
    {
      "number": 19,
      "pali": "kāmesumicchācārā paccorohati. ",
      "english": "they descend from sexual misconduct. "
    },
    {
      "number": 20,
      "pali": "… ‘Musāvādassa kho pāpako vipāko …pe… ",
      "english": "… ‘Lying has a bad result …’ … "
    },
    {
      "number": 21,
      "pali": "musāvādā paccorohati. ",
      "english": "they descend from lying. "
    },
    {
      "number": 22,
      "pali": "… ‘Pisuṇāya vācāya kho pāpako vipāko …pe… ",
      "english": "… ‘Backbiting has a bad result …’ … "
    },
    {
      "number": 23,
      "pali": "pisuṇāya vācāya paccorohati. ",
      "english": "they descend from backbiting. "
    },
    {
      "number": 24,
      "pali": "… ‘Pharusāya vācāya kho pāpako vipāko …pe… ",
      "english": "… ‘Harsh speech has a bad result …’ … "
    },
    {
      "number": 25,
      "pali": "pharusāya vācāya paccorohati. ",
      "english": "they descend from harsh speech. "
    },
    {
      "number": 26,
      "pali": "… ‘Samphappalāpassa kho pāpako vipāko …pe… ",
      "english": "… ‘Talking nonsense has a bad result …’ … "
    },
    {
      "number": 27,
      "pali": "samphappalāpā paccorohati. ",
      "english": "they descend from talking nonsense. "
    },
    {
      "number": 28,
      "pali": "… ‘Abhijjhāya kho pāpako vipāko …pe… ",
      "english": "… ‘Covetousness has a bad result …’ … "
    },
    {
      "number": 29,
      "pali": "abhijjhāya paccorohati. ",
      "english": "they descend from covetousness. "
    },
    {
      "number": 30,
      "pali": "… ‘Byāpādassa kho pāpako vipāko …pe… ",
      "english": "… ‘Ill will has a bad result …’ … "
    },
    {
      "number": 31,
      "pali": "byāpādā paccorohati. ",
      "english": "they descend from ill will. "
    },
    {
      "number": 32,
      "pali": "… ‘Micchādiṭṭhiyā kho pāpako vipāko diṭṭhe ceva dhamme abhisamparāyañcā’ti. ",
      "english": "… ‘Wrong view has a bad result both in the present life and in lives to come.’ "
    },
    {
      "number": 33,
      "pali": "So iti paṭisaṅkhāya micchādiṭṭhiṁ pajahati; ",
      "english": "Reflecting like this, they give up wrong view, "
    },
    {
      "number": 34,
      "pali": "micchādiṭṭhiyā paccorohati. ",
      "english": "they descend from wrong view. "
    },
    {
      "number": 35,
      "pali": "Ayaṁ vuccati, bhikkhave, ariyā paccorohaṇī”ti. ",
      "english": "This is called the noble descent.” "
    },
    {
      "number": 36,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}