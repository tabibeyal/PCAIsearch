{
  "sutta_id": "AN1.52",
  "verses": [
    {
      "number": 1,
      "pali": "52 ",
      "english": "52 "
    },
    {
      "number": 2,
      "pali": "“Pabhassaramidaṁ, bhikkhave, cittaṁ. ",
      "english": "“This mind, mendicants, is radiant. "
    },
    {
      "number": 3,
      "pali": "Tañca kho āgantukehi upakkilesehi vippamuttaṁ. ",
      "english": "And it is freed from passing corruptions. "
    },
    {
      "number": 4,
      "pali": "Taṁ sutavā ariyasāvako yathābhūtaṁ pajānāti. ",
      "english": "A learned noble disciple truly understands this. "
    },
    {
      "number": 5,
      "pali": "Tasmā ‘sutavato ariyasāvakassa cittabhāvanā atthī’ti vadāmī”ti. ",
      "english": "So I say that the learned noble disciple has development of the mind.” "
    },
    {
      "number": 6,
      "pali": "Dutiyaṁ. ",
      "english": ""
    }
  ]
}