{
  "sutta_id": "DHP45",
  "verses": [
    {
      "number": 1,
      "pali": "Sekho pathaviṁ vicessati, ",
      "english": "A trainee bestirs this earth, "
    },
    {
      "number": 2,
      "pali": "Yamalokañca imaṁ sadevakaṁ; ",
      "english": "and the Yama realm with its gods. "
    },
    {
      "number": 3,
      "pali": "Sekho dhammapadaṁ sudesitaṁ, ",
      "english": "A trainee sets out the well-taught word of truth, "
    },
    {
      "number": 4,
      "pali": "Kusalo pupphamiva pacessati. ",
      "english": "as an expert a flower. "
    }
  ]
}