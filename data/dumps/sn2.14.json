{
  "sutta_id": "SN2.14",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.14 ",
      "english": "Linked Discourses 2.14 "
    },
    {
      "number": 2,
      "pali": "2. Anāthapiṇḍikavagga ",
      "english": "2. With Anāthapiṇḍika "
    },
    {
      "number": 3,
      "pali": "Nandanasutta ",
      "english": "With Nandana "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho nandano devaputto bhagavantaṁ gāthāya ajjhabhāsi: ",
      "english": "Standing to one side, the godling Nandana addressed the Buddha in verse: "
    },
    {
      "number": 5,
      "pali": "“Pucchāmi taṁ gotama bhūripañña, ",
      "english": "“I ask you, Gotama, whose wisdom is vast, "
    },
    {
      "number": 6,
      "pali": "Anāvaṭaṁ bhagavato ñāṇadassanaṁ; ",
      "english": "the Blessed One <j>of unhindered knowledge and vision. "
    },
    {
      "number": 7,
      "pali": "Kathaṁvidhaṁ sīlavantaṁ vadanti, ",
      "english": "What sort do they call ethical? "
    },
    {
      "number": 8,
      "pali": "Kathaṁvidhaṁ paññavantaṁ vadanti; ",
      "english": "What sort do they call wise? "
    },
    {
      "number": 9,
      "pali": "Kathaṁvidho dukkhamaticca iriyati, ",
      "english": "What sort lives on after transcending suffering? "
    },
    {
      "number": 10,
      "pali": "Kathaṁvidhaṁ devatā pūjayantī”ti. ",
      "english": "What sort is worshipped by the deities?” "
    },
    {
      "number": 11,
      "pali": "“Yo sīlavā paññavā bhāvitatto, ",
      "english": "“Someone who is ethical, wise, evolved, "
    },
    {
      "number": 12,
      "pali": "Samāhito jhānarato satīmā; ",
      "english": "becomes serene, loving absorption, mindful, "
    },
    {
      "number": 13,
      "pali": "Sabbassa sokā vigatā pahīnā, ",
      "english": "who’s gotten rid of and given up all sorrows, "
    },
    {
      "number": 14,
      "pali": "Khīṇāsavo antimadehadhārī. ",
      "english": "with defilements ended, they bear their final body. "
    },
    {
      "number": 15,
      "pali": "Tathāvidhaṁ sīlavantaṁ vadanti, ",
      "english": "That sort they call ethical. "
    },
    {
      "number": 16,
      "pali": "Tathāvidhaṁ paññavantaṁ vadanti; ",
      "english": "That sort they call wise. "
    },
    {
      "number": 17,
      "pali": "Tathāvidho dukkhamaticca iriyati, ",
      "english": "That sort lives on after transcending suffering. "
    },
    {
      "number": 18,
      "pali": "Tathāvidhaṁ devatā pūjayantī”ti. ",
      "english": "That sort is worshipped by the deities.” "
    }
  ]
}