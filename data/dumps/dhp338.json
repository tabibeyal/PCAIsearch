{
  "sutta_id": "DHP338",
  "verses": [
    {
      "number": 1,
      "pali": "Sūkarapotikāvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Yathāpi mūle anupaddave daḷhe, ",
      "english": "A tree grows back even when cut down, "
    },
    {
      "number": 3,
      "pali": "Chinnopi rukkho punareva rūhati; ",
      "english": "so long as its roots are strong and undamaged; "
    },
    {
      "number": 4,
      "pali": "Evampi taṇhānusaye anūhate, ",
      "english": "suffering springs up again and again, "
    },
    {
      "number": 5,
      "pali": "Nibbattatī dukkhamidaṁ punappunaṁ. ",
      "english": "so long as the tendency to craving is not pulled out. "
    }
  ]
}