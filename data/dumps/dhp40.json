{
  "sutta_id": "DHP40",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcasatabhikkhuvatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Kumbhūpamaṁ kāyamimaṁ viditvā, ",
      "english": "Knowing this body breaks like a pot, "
    },
    {
      "number": 3,
      "pali": "Nagarūpamaṁ cittamidaṁ ṭhapetvā; ",
      "english": "and fortifying the mind like a citadel, "
    },
    {
      "number": 4,
      "pali": "Yodhetha māraṁ paññāvudhena, ",
      "english": "attack Māra with the sword of wisdom, "
    },
    {
      "number": 5,
      "pali": "Jitañca rakkhe anivesano siyā. ",
      "english": "guard your conquest, and never settle. "
    }
  ]
}