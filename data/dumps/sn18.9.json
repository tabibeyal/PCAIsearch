      "number": 2,
      "pali": "1. Paṭhamavagga ",
      "english": "Chapter One "
    },
    {
      "number": 3,
      "pali": "Dhātusutta ",
      "english": "Elements "
    },
    {
      "number": 4,
      "pali": "Sāvatthiyaṁ viharati. ",
      "english": "At Sāvatthī. "
    },
    {
      "number": 5,
      "pali": "“Taṁ kiṁ maññasi, rāhula, ",
      "english": "“What do you think, Rāhula? "
    },
    {
      "number": 6,
      "pali": "pathavīdhātu niccā vā aniccā vā”ti? ",
      "english": "Is the earth element permanent or impermanent?” "
    },
    {
      "number": 7,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 8,
      "pali": "“āpodhātu …pe… ",
      "english": "“… the water element … "
    },
    {
      "number": 9,
      "pali": "tejodhātu … ",
      "english": "the fire element … "
    },
    {
      "number": 10,
      "pali": "vāyodhātu … ",
      "english": "the air element … "
    },
    {
      "number": 11,
      "pali": "ākāsadhātu … ",
      "english": "the space element … "
    },
    {
      "number": 12,
      "pali": "viññāṇadhātu niccā vā aniccā vā”ti? ",
      "english": "Is the consciousness element permanent or impermanent?” "
    },
    {
      "number": 13,
      "pali": "“Aniccā, bhante” … ",
      "english": "“Impermanent, sir.” … "
    },
    {
      "number": 14,
      "pali": "“evaṁ passaṁ, rāhula, sutavā ariyasāvako pathavīdhātuyāpi nibbindati …pe… āpodhātuyāpi nibbindati … tejodhātuyāpi nibbindati … vāyodhātuyāpi nibbindati … ākāsadhātuyāpi nibbindati … viññāṇadhātuyāpi nibbindati …pe… ",
      "english": "“Seeing this, a learned noble disciple grows disillusioned with the earth element, water element, fire element, air element, space element, and consciousness element …” "
    },
    {
      "number": 15,
      "pali": "pajānātī”ti. ",
      "english": ""
    },
    {
      "number": 16,
      "pali": "Navamaṁ. ",
      "english": ""
    }
  ]
