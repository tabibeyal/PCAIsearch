{
  "sutta_id": "AN2.95",
  "verses": [
    {
      "number": 1,
      "pali": "95 ",
      "english": "95 "
    },
    {
      "number": 2,
      "pali": "“Dveme, bhikkhave, dhammā. ",
      "english": "“There are, mendicants, these two things. "
    },
    {
      "number": 3,
      "pali": "Katame dve? ",
      "english": "What two? "
    },
    {
      "number": 4,
      "pali": "Sovacassatā ca kalyāṇamittatā ca. ",
      "english": "Being easy to admonish and having good friends. "
    },
    {
      "number": 5,
      "pali": "Ime kho, bhikkhave, dve dhammā”ti. ",
      "english": "These are the two things.” "
    }
  ]
}