  "sutta_id": "AN10.183",
  "verses": [
    {
      "number": 1,
      "pali": "Aṅguttara Nikāya 10.183 ",
      "english": "Numbered Discourses 10.183 "
    },
    {
      "number": 2,
      "pali": "18. Sādhuvagga ",
      "english": "18. Good "
    },
    {
      "number": 3,
      "pali": "Āsavasutta ",
      "english": "Defiled "
    },
    {
      "number": 4,
      "pali": "“Sāsavañca vo, bhikkhave, dhammaṁ desessāmi anāsavañca. ",
      "english": "“I will teach you the defiled principle and the undefiled. … "
    },
    {
      "number": 5,
      "pali": "Taṁ suṇātha …pe… ",
      "english": ""
    },
    {
      "number": 6,
      "pali": "katamo ca, bhikkhave, sāsavo dhammo? ",
      "english": "And what is the defiled principle? "
    },
    {
      "number": 7,
      "pali": "Pāṇātipāto …pe… ",
      "english": "Killing living creatures … "
    },
    {
      "number": 8,
      "pali": "micchādiṭṭhi—",
      "english": "wrong view. "
    },
    {
      "number": 9,
      "pali": "ayaṁ vuccati, bhikkhave, sāsavo dhammo. ",
      "english": "This is called the defiled principle. "
    },
    {
      "number": 10,
      "pali": "Katamo ca, bhikkhave, anāsavo dhammo? ",
      "english": "And what is the undefiled principle? "
    },
    {
      "number": 11,
      "pali": "Pāṇātipātā veramaṇī …pe… ",
      "english": "Not killing living creatures … "
    },
    {
      "number": 12,
      "pali": "sammādiṭṭhi—",
      "english": "right view. "
    },
    {
      "number": 13,
      "pali": "ayaṁ vuccati, bhikkhave, anāsavo dhammo”ti. ",
      "english": "This is called the undefiled principle.” "
    },
    {
      "number": 14,
      "pali": "Chaṭṭhaṁ. ",
      "english": ""
    }
  ]
}