{
  "sutta_id": "DHP96",
  "verses": [
    {
      "number": 1,
      "pali": "Kosambivāsitissattherasāmaṇeravatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Santaṁ tassa manaṁ hoti, ",
      "english": "Their mind is peaceful, "
    },
    {
      "number": 3,
      "pali": "santā vācā ca kamma ca; ",
      "english": "peaceful are their speech and deeds. "
    },
    {
      "number": 4,
      "pali": "Sammadaññāvimuttassa, ",
      "english": "Such a one is at peace, "
    },
    {
      "number": 5,
      "pali": "upasantassa tādino. ",
      "english": "rightly freed through enlightenment. "
    }
  ]
}