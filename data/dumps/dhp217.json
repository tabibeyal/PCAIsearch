{
  "sutta_id": "DHP217",
  "verses": [
    {
      "number": 1,
      "pali": "Pañcasatadārakavatthu ",
      "english": ""
    },
    {
      "number": 2,
      "pali": "Sīladassanasampannaṁ, ",
      "english": "One accomplished in virtue and vision, "
    },
    {
      "number": 3,
      "pali": "dhammaṭṭhaṁ saccavedinaṁ; ",
      "english": "firmly principled, and truthful, "
    },
    {
      "number": 4,
      "pali": "Attano kamma kubbānaṁ, ",
      "english": "doing oneself what ought be done: "
    },
    {
      "number": 5,
      "pali": "taṁ jano kurute piyaṁ. ",
      "english": "that’s who the people love. "
    }
  ]
}