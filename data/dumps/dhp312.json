{
  "sutta_id": "DHP312",
  "verses": [
    {
      "number": 1,
      "pali": "Yaṁ kiñci sithilaṁ kammaṁ, ",
      "english": "Any lax act, "
    },
    {
      "number": 2,
      "pali": "saṅkiliṭṭhañca yaṁ vataṁ; ",
      "english": "any corrupt observance, "
    },
    {
      "number": 3,
      "pali": "Saṅkassaraṁ brahmacariyaṁ, ",
      "english": "or suspicious spiritual life, "
    },
    {
      "number": 4,
      "pali": "na taṁ hoti mahapphalaṁ. ",
      "english": "is not very fruitful. "
    }
  ]
}