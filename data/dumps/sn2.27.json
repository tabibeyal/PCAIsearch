{
  "sutta_id": "SN2.27",
  "verses": [
    {
      "number": 1,
      "pali": "Saṁyutta Nikāya 2.27 ",
      "english": "Linked Discourses 2.27 "
    },
    {
      "number": 2,
      "pali": "3. Nānātitthiyavagga ",
      "english": "3. Various Sectarians "
    },
    {
      "number": 3,
      "pali": "Nandasutta ",
      "english": "With Nanda "
    },
    {
      "number": 4,
      "pali": "Ekamantaṁ ṭhito kho nando devaputto bhagavato santike imaṁ gāthaṁ abhāsi: ",
      "english": "Standing to one side, the godling Nanda spoke this verse in the Buddha’s presence: "
    },
    {
      "number": 5,
      "pali": "“Accenti kālā tarayanti rattiyo, ",
      "english": "“Time flies, nights pass by, "
    },
    {
      "number": 6,
      "pali": "Vayoguṇā anupubbaṁ jahanti; ",
      "english": "the stages of life leave us one by one. "
    },
    {
      "number": 7,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 8,
      "pali": "Puññāni kayirātha sukhāvahānī”ti. ",
      "english": "do good deeds that bring you joy.” "
    },
    {
      "number": 9,
      "pali": "“Accenti kālā tarayanti rattiyo, ",
      "english": "“Time flies, nights pass by, "
    },
    {
      "number": 10,
      "pali": "Vayoguṇā anupubbaṁ jahanti; ",
      "english": "the stages of life leave us one by one. "
    },
    {
      "number": 11,
      "pali": "Etaṁ bhayaṁ maraṇe pekkhamāno, ",
      "english": "Seeing this peril in death, "
    },
    {
      "number": 12,
      "pali": "Lokāmisaṁ pajahe santipekkho”ti. ",
      "english": "a seeker of peace would drop the world’s bait.” "
    }
  ]
}