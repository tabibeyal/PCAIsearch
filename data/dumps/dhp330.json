{
  "sutta_id": "DHP330",
  "verses": [
    {
      "number": 1,
      "pali": "Ekassa caritaṁ seyyo, ",
      "english": "It’s better to wander alone, "
    },
    {
      "number": 2,
      "pali": "Natthi bāle sahāyatā; ",
      "english": "there’s no fellowship with fools. "
    },
    {
      "number": 3,
      "pali": "Eko care na ca pāpāni kayirā, ",
      "english": "Wander alone and do no wrong, "
    },
    {
      "number": 4,
      "pali": "Appossukko mātaṅgaraññeva nāgo. ",
      "english": "at ease like a tusker in the wilds. "
    }
  ]
}