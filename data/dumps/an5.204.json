    {
      "number": 2,
      "pali": "21. Kimilavagga ",
      "english": "21. With Kimbila "
    },
    {
      "number": 3,
      "pali": "Balasutta ",
      "english": "Powers "
    },
    {
      "number": 4,
      "pali": "“Pañcimāni, bhikkhave, balāni. ",
      "english": "“Mendicants, there are these five powers. "
    },
    {
      "number": 5,
      "pali": "Katamāni pañca? ",
      "english": "What five? "
    },
    {
      "number": 6,
      "pali": "Saddhābalaṁ, hiribalaṁ, ottappabalaṁ, vīriyabalaṁ, paññābalaṁ—",
      "english": "Faith, conscience, prudence, energy, and wisdom. "
    },
    {
      "number": 7,
      "pali": "imāni kho, bhikkhave, pañca balānī”ti. ",
      "english": "These are the five powers.” "
    },
    {
      "number": 8,
      "pali": "Catutthaṁ. ",
      "english": ""
    }
  ]
